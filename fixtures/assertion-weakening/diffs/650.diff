+// P1b 出图入口排布意图契约测试(新文件,不追加进逼近阈值的 generation.contract.test.ts)。
+//
+// 覆盖:
+//   - assertPlacementIntent 三态 fail-closed(完整三元组/显式 legacy/部分缺失/全缺)
+//   - 纯文生图显式 legacy 声明(debugLogger 留痕,证明是显式而非遗漏)
+//   - 枚举守卫(no_generation_entry_lacks_placement_intent)由
+//     generationEntryEnumerationGuard.test.ts 承担(动态派生+反向变异,本文件不重复)
+import { describe, expect, it, vi, beforeEach } from 'vitest'
+
+vi.mock('./remoteDebugReporter', () => ({ reportRemoteDebugEntry: () => {} }))
+
+import { debugLogger } from './debugLogStore'
+import { assertPlacementIntent } from './derivedBatchCoordinator'
+import type { CanvasGenerationOptions } from './canvasStateTypes'
+
+const options = (
+  partial: Partial<Pick<CanvasGenerationOptions, 'placement' | 'derivedBatchId' | 'expectedCount' | 'ordinal'>>,
+) => partial
+
+describe('contract: placement intent fail-closed', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks()
+  })
+
+  it('placement_intent_is_fail_closed: 完整三元组 → batch-member', () => {
+    const intent = assertPlacementIntent(
+      options({ derivedBatchId: 'b1', expectedCount: 3, ordinal: 1 }),
+    )
+    expect(intent).toBe('batch-member')
+  })
+
+  it('placement_intent_is_fail_closed: 显式 legacy → legacy(不抛错,记录声明)', () => {
+    const logSpy = vi.spyOn(debugLogger, 'log')
+    const intent = assertPlacementIntent(options({ placement: 'legacy' }))
+    expect(intent).toBe('legacy')
+    expect(logSpy).toHaveBeenCalledWith(
+      'Derived Batch',
+      expect.stringContaining('legacy'),
+    )
+  })
+
+  it('placement_intent_is_fail_closed: placement:batch + expectedCount → batch-owner', () => {
+    const intent = assertPlacementIntent(options({ placement: 'batch', expectedCount: 2 }))
+    expect(intent).toBe('batch-owner')
+  })
+
+  it('placement_intent_is_fail_closed: 部分缺失 → 抛错 + debugLogger.error', () => {
+    const errorSpy = vi.spyOn(debugLogger, 'error')
+    expect(() => assertPlacementIntent(options({ derivedBatchId: 'b1' }))).toThrow(
+      /排布意图缺失/,
+    )
+    expect(errorSpy).toHaveBeenCalled()
+  })
+
+  it('placement_intent_is_fail_closed: 全缺 → 抛错 + debugLogger.error(不再静默走旧路径)', () => {
+    const errorSpy = vi.spyOn(debugLogger, 'error')
+    expect(() => assertPlacementIntent(options({}))).toThrow(/排布意图缺失/)
+    expect(errorSpy).toHaveBeenCalledWith('Derived Batch', expect.stringContaining('排布意图缺失'))
+  })
+
+  it('placement_intent_is_fail_closed: placement:batch 缺 expectedCount → 抛错', () => {
+    expect(() => assertPlacementIntent(options({ placement: 'batch' }))).toThrow(
+      /expectedCount/,
+    )
+  })
+
+  it('placement_intent_is_fail_closed: placement:batch expectedCount 越界 → 抛错', () => {
+    expect(() => assertPlacementIntent(options({ placement: 'batch', expectedCount: 5 }))).toThrow(
+      /expectedCount/,
+    )
+    expect(() => assertPlacementIntent(options({ placement: 'batch', expectedCount: 0 }))).toThrow(
+      /expectedCount/,
+    )
+  })
+})
+
+describe('contract: text-only generation declares legacy', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks()
+  })
+
+  it('text_only_generation_declares_legacy: 纯文生图(无源图)调用点显式 legacy 声明', () => {
+    // 无源图 = 无对齐基准与高度锁定对象 → 显式 placement:'legacy' 而非「没传三元组」
+    // 的隐式行为(后者已被 fail-closed 变为抛错)。
+    const logSpy = vi.spyOn(debugLogger, 'log')
+    const intent = assertPlacementIntent(options({ placement: 'legacy' }))
+    expect(intent).toBe('legacy')
+    expect(logSpy).toHaveBeenCalledWith(
+      'Derived Batch',
+      expect.stringContaining('placement=legacy'),
+    )
+  })
+})
diff --git a/src/store/generationEntryEnumerationGuard.test.ts b/src/store/generationEntryEnumerationGuard.test.ts
new file mode 100644
index 00000000..a3f335a6
--- /dev/null
+++ b/src/store/generationEntryEnumerationGuard.test.ts
@@ -0,0 +1,384 @@
+// P1b 出图入口枚举守卫(SC p1b-entry-enumeration-guard)。
+//
+// 真相源动态派生:从 generationSlice.ts 的 store action 契约现场提取全部出图类
+// action 名(正则 `^  (generate\w+):`),再据此枚举生产调用点——不把 4 个函数名
+// 写死进测试。清单中每一项要么带完整三元组/placement 声明,要么经透传通道
+// (executor mapGenerationOptions spread 命令类型契约字段)消费。
+//
+// 调用点文件集**不再硬编码**:全仓递归扫描(SCAN_ROOTS = src/ + cindyplugin/src/
+// + scripts/e2e/scenarios/),排除测试文件与定义/纯委托/协调器宿主;新增调用点
+// 文件自动纳入守卫,漏声明即红。透传通道(executor/runtime wrapper)单独验证
+// spread 存在后才放行。
+//
+// 反向变异:向**新建临时文件**注入一行未声明调用 → 断言必须转红;不红说明
+// 守卫只认死名单,判 fail。
+import { describe, expect, it } from 'vitest'
+import { readFileSync, writeFileSync, rmSync, readdirSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+
+const repoRoot = process.cwd()
+
+const generationSliceSource = () => readFileSync(join(repoRoot, 'src/store/generationSlice.ts'), 'utf8')
+
+/** 动态派生:从 store action 契约提取全部出图类 action 名。 */
+const extractGenerationActionNames = (source: string): string[] =>
+  Array.from(source.matchAll(/^ {2}(generate\w+): /gm), (m) => m[1])
+
+/** 扫描根:新增目录/文件自动纳入守卫。 */
+const SCAN_ROOTS = ['src', 'cindyplugin/src', 'scripts/e2e/scenarios']
+
+/** 定义/纯委托/协调器宿主:出图 action 的定义处与签名透传,不是调用点。 */
+const EXCLUDED_HOST_FILES = [
+  'src/store/generationSlice.ts',
+  'src/store/generationFacade.ts',
+  'src/store/derivedBatchCoordinator.ts',
+]
+
+/** 透传通道:executor 的 mapGenerationOptions 以 ...shared spread 原样透传命令
+ *  类型契约字段(含 placement/derivedBatchId/expectedCount/ordinal),故其调用
+ *  点不经字面量声明也满足「意图可达 store」;canvasSyncRuntime 的
+ *  generateIntoAiSlot wrapper 以 ...options 原样透传并仅注入 onSceneMutation。
+ *  此白名单必须验证 spread 存在,否则透传通道失效时守卫静默放行。 */
+const passthroughChannels = (): string[] => {
+  const executor = readFileSync(join(repoRoot, 'src/canvas/actions/canvasCommandExecutor.ts'), 'utf8')
+  if (!executor.includes('...shared')) {
+    throw new Error('executor mapGenerationOptions 不再 spread 透传 → 透传通道失效,枚举守卫无法成立')
+  }
+  const runtime = readFileSync(join(repoRoot, 'src/canvas/actions/canvasSyncRuntime.ts'), 'utf8')
+  if (!runtime.includes('...options')) {
+    throw new Error('canvasSyncRuntime generateIntoAiSlot 不再 ...options 透传 → 透传通道失效,枚举守卫无法成立')
+  }
+  return ['src/canvas/actions/canvasCommandExecutor.ts', 'src/canvas/actions/canvasSyncRuntime.ts']
+}
+
+/** 全仓递归枚举候选调用点文件(.ts/.tsx/.mjs;排除测试/定义宿主/依赖目录)。 */
+export const candidateEntryFiles = (): string[] => {
+  const found: string[] = []
+  const walk = (dir: string) => {
+    for (const entry of readdirSync(dir, { withFileTypes: true })) {
+      const full = join(dir, entry.name)
+      if (entry.isDirectory()) {
+        if (entry.name === 'node_modules' || entry.name === '__tests__') continue
+        walk(full)
+        continue
+      }
+      if (!/\.(ts|tsx|mjs)$/.test(entry.name)) continue
+      if (/\.(test|spec)\.tsx?$/.test(entry.name)) continue
+      const rel = full.replace(`${repoRoot}/`, '')
+      if (EXCLUDED_HOST_FILES.includes(rel)) continue
+      found.push(rel)
+    }
+  }
+  for (const root of SCAN_ROOTS) {
+    const rootPath = join(repoRoot, root)
+    if (statSync(rootPath, { throwIfNoEntry: false })) walk(rootPath)
+  }
+  return found
+}
+
+const DECLARATION_TOKENS = ['placement', 'derivedBatchId', 'expectedCount', 'ordinal', 'legacy']
+
+/** 每个 action 的调用形态:成员调用 + 字符串字面量动态属性调用(G3 修复轮2 补)。 */
+const callPatternsFor = (action: string): string[] => [
+  `${action}(`,
+  `['${action}'](`,
+  `["${action}"](`,
+]
+
+// H2(fix3):动态属性调用 = 任何 `[<标识符或字符串字面量>](` 形态的成员调用
+// (computed-property),不限于变量名恰为 `action`——`api[verb](`、`api[key](`、
+// `api['verb'](` 全算。无法静态解出具体 action 的一律计为「可疑调用点」,
+// 要求该文件显式声明或豁免(fail-closed,宁可误报)。
+const COMPUTED_PROPERTY_RE = /\[[A-Za-z_$][A-Za-z0-9_$]*\]\(|\[['"][^'"]+['"]\]\(/
+
+/** 行内是否存在任何 computed-property 形态的成员调用(`x[<id|str>](`)。 */
+const hasComputedPropertyCall = (line: string): boolean => {
+  // 纯注释行(// 或 /* 起头的 JSDoc/注释里的示例文本,如 `records[recordId](`)不是
+  // 调用点——注释内出现的 computed-property 形态会被误报(示例文本是文档不是代码)。
+  if (/^\s*(\/\/|\/\*|\*)/.test(line)) return false
+  // 已知非出图动态成员调用:debugLogger[level]( 的接收者是日志对象,其动态成员
+  // 是日志级别,不可能成为 generate* action。显式豁免(名单外的新 computed 调用
+  // 仍按可疑调用点 fail-closed)。
+  if (/debugLogger\[[^\]]+\]\(/.test(line)) return false
+  return COMPUTED_PROPERTY_RE.test(line)
+}
+
+/**
+ * H2(fix3):调用点级透传豁免绑定到该调用**表达式的数据流内**,而非文本邻窗——
+ * 解析该调用(必要时跨行)的括号配对实参范围:
+ *   - 实参列表内直接含透传标记(...options/...shared/mapGenerationOptions)→ 豁免;
+ *   - 实参列表里的变量在前一语句由 `mapGenerationOptions(...)` 赋值 → 豁免
+ *     (executor 形态:`const options = await mapGenerationOptions(command.options, bridge)` +
+ *     `runtime.generateVariations(..., options)`,实参 `options` 的真实来源就是透传);
+ *   - 其它一律不豁免——邻近无关文本(±3 行窗口内刚好有标记的下一行)不得触发豁免。
+ */
+const isPassthroughExempt = (lines: string[], index: number, callStart: number): boolean => {
+  const callArgs = extractCallArgs(lines, index, callStart)
+  if (callArgs === null) return false
+  if (callArgs.includes('...options') || callArgs.includes('...shared') || callArgs.includes('mapGenerationOptions')) {
+    return true
+  }
+  // 实参变量在前一语句由 mapGenerationOptions 赋值 → 透传来源真实(executor 形态)。
+  const prevLine = lines[index - 1]
+  if (prevLine && /mapGenerationOptions\(/.test(prevLine) && /const\s+options\s*=/.test(prevLine)) return true
+  return false
+}
+
+/** 提取调用表达式的实参文本(跨行括号配对;无法配平返回 null)。
+ *  fromIdx 为该行实参扫描起点:必须从**实际命中的调用位置**起算,不能取该行
+ *  第一个 `(`——同一行前置的其它函数调用(如 `await wrap(store.generateVariations(...))`)
+ *  会抢错括号,算出错误实参。 */
+const extractCallArgs = (lines: string[], index: number, fromIdx: number): string | null => {
+  const line = lines[index]
+  const openIdx = line.indexOf('(', fromIdx)
+  if (openIdx === -1) return null
+  let depth = 0
+  let start = false
+  let chunk = ''
+  let cursor = index
+  let cursorInLine = openIdx
+  const maxLines = Math.min(lines.length, index + 12)
+  while (cursor < maxLines) {
+    const text = lines[cursor]
+    const from = cursor === index ? cursorInLine : 0
+    for (let c = from; c < text.length; c += 1) {
+      const ch = text[c]
+      if (ch === '(') {
+        depth += 1
+        start = true
+      } else if (ch === ')') {
+        depth -= 1
+        if (start && depth === 0) {
+          chunk += text.slice(from, c)
+          return chunk
+        }
+      }
+      if (start) chunk += ch
+    }
+    cursor += 1
+    cursorInLine = 0
+  }
+  return null
+}
+
+/** 单文件扫描:声明判据绑定到**当前调用表达式的实参文本**(跨行括号配对),
+ *  不再扫调用点后 3 行文本窗口——邻行无关注释(如 `// legacy 兼容说明`)/无关
+ *  变量曾可骗过旧判据,造成漏传凭证的调用点假绿。括号无法配平时 fail-closed
+ *  按未声明处理(宁红勿绿)。 */
+const undeclaredInFile = (rel: string, actions: string[]): Array<{ action: string; file: string; line: number }> => {
+  const text = readFileSync(join(repoRoot, rel), 'utf8')
+  const lines = text.split('\n')
+  const sites: Array<{ action: string; file: string; line: number }> = []
+  lines.forEach((line, index) => {
+    let hit: string | null = null
+    let callStart = 0
+    for (const action of actions) {
+      // 记录实际命中的调用位置(供 extractCallArgs 从该处起算括号配对)。
+      const patIdx = callPatternsFor(action).reduce(
+        (acc, pattern) => {
+          const i = line.indexOf(pattern)
+          return i === -1 ? acc : acc === -1 ? i : Math.min(acc, i)
+        },
+        -1,
+      )
+      if (patIdx !== -1) {
+        hit = action
+        callStart = patIdx
+        break
+      }
+    }
+    if (!hit && hasComputedPropertyCall(line)) {
+      // 动态属性调用(任意 `[<id|字面量>](` 形态,H2 修复轮3 从 `action` 单变量放宽):
+      // 无法静态验证意图,一律按潜在未声明调用点对待(fail-closed,宁可误报)。
+      const cp = line.match(COMPUTED_PROPERTY_RE)
+      hit = 'generate*'
+      callStart = cp ? cp.index ?? 0 : 0
+    }
+    if (!hit) return
+    if (isPassthroughExempt(lines, index, callStart)) return
+    const args = extractCallArgs(lines, index, callStart)
+    if (args === null || !DECLARATION_TOKENS.some((token) => args.includes(token))) {
+      sites.push({ action: hit, file: rel, line: index + 1 })
+    }
+  })
+  return sites
+}
+
+/**
+ * 枚举并判定:每个出图 action 的生产调用点都必须「意图已声明」或「调用点级透传」。
+ * 全仓扫描由 candidateEntryFiles() 派生文件集(不硬编码清单)。
+ * passthroughChannels() 仍执行 spread 存在性健全检查(spread 消失即 throw),
+ * 但不再整文件豁免宿主文件——豁免收窄到 isPassthroughExempt 判定的调用点级。
+ */
+export const unDeclaredEntrySites = (): Array<{ action: string; file: string; line: number }> => {
+  const actions = extractGenerationActionNames(generationSliceSource())
+  passthroughChannels()
+  const sites: Array<{ action: string; file: string; line: number }> = []
+  for (const file of candidateEntryFiles()) {
+    sites.push(...undeclaredInFile(file, actions))
+  }
+  return sites
+}
+
+describe('contract: no generation entry lacks placement intent', () => {
+  it('no_generation_entry_lacks_placement_intent: 全部出图调用点已声明意图(未声明条数==0)', () => {
+    const actions = extractGenerationActionNames(generationSliceSource())
+    // 真相源是动态派生的 action 清单(至少 4 个出图 action)。
+    expect(actions).toContain('generateVariations')
+    expect(actions).toContain('generateImageEdit')
+    expect(actions).toContain('generateBesideNode')
+    expect(actions).toContain('generateIntoAiSlot')
+    // 文件集全仓派生,至少覆盖 src/ 与 scripts/e2e/scenarios/(含 canvasAgentVerbs.ts)。
+    const files = candidateEntryFiles()
+    expect(files).toContain('src/agent/canvasAgentVerbs.ts')
+    expect(files).toContain('src/store/chatStore.ts')
+    expect(files.some((f) => f.startsWith('scripts/e2e/scenarios/'))).toBe(true)
+    const sites = unDeclaredEntrySites()
+    expect(sites).toEqual([])
+  })
