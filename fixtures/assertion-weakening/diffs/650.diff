+++ b/src/store/resolvedSourceNodeType.test.ts
@@ -0,0 +1,36 @@
+// F5:chat 有源判定兜底——resolvedSourceNodeType 纯函数测试。
+// 独立文件:canvasDocumentModel.test.ts 逼近 900 行 structure-guard 红线,
+// F5 用例外提至此(行为契约见 canvasDocumentModel.ts 内的实现注释)。
+import { describe, expect, it } from 'vitest'
+import { resolvedSourceNodeType } from './canvasDocumentModel'
+
+describe('resolvedSourceNodeType (F5 chat 有源判定兜底)', () => {
+  const image = { id: 'img1', type: 'image', hidden: false }
+  const text = { id: 'txt1', type: 'text', hidden: false }
+  const hidden = { id: 'h1', type: 'image', hidden: true }
+
+  it('sourceNodeId 在场且是 image → 现场解析为 image(不依赖传入布尔)', () => {
+    expect(resolvedSourceNodeType('img1', 'text', [image, text])).toBe('image')
+  })
+
+  it('sourceNodeId 缺失 → 退回传入的 sourceNodeType', () => {
+    expect(resolvedSourceNodeType(undefined, 'image', [image])).toBe('image')
+    expect(resolvedSourceNodeType(undefined, undefined, [image])).toBeUndefined()
+  })
+
+  // G4(修复轮2):节点已删/被隐藏 → 一律无源(undefined),不回退陈旧 sourceNodeType。
+  // 此前「退回传入值」把已删源的 retry 误判成有源(走批次),实际应按无源→legacy。
+  it('sourceNodeId 对应节点已删 → 无源(undefined,不回退陈旧布尔)', () => {
+    expect(resolvedSourceNodeType('gone', 'image', [image, text])).toBeUndefined()
+    expect(resolvedSourceNodeType('gone', undefined, [image, text])).toBeUndefined()
+  })
+
+  it('sourceNodeId 对应节点被隐藏 → 无源(undefined,不回退陈旧布尔)', () => {
+    expect(resolvedSourceNodeType('h1', 'image', [image, text, hidden])).toBeUndefined()
+    expect(resolvedSourceNodeType('h1', undefined, [image, text, hidden])).toBeUndefined()
+  })
+
+  it('sourceNodeId 对应节点是 text → 现场解析为 text(UI 布尔陈旧时纠正)', () => {
+    expect(resolvedSourceNodeType('txt1', 'image', [image, text])).toBe('text')
+  })
+})
