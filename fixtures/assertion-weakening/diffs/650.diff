diff --git a/src/canvas/actions/canvasActionModel.slotFill.test.ts b/src/canvas/actions/canvasActionModel.slotFill.test.ts
new file mode 100644
index 00000000..289c1d0c
--- /dev/null
+++ b/src/canvas/actions/canvasActionModel.slotFill.test.ts
@@ -0,0 +1,90 @@
+/**
+ * F4:生成中/批次占位槽禁二次填充——contextMenu + quickbar 双面正反测试。
+ * 独立文件:canvasActionModel.characterization.test.ts / .quickbar.test.ts 均已
+ * 逼近 900 行 structure-guard 红线,F4 用例提至此(行为契约见
+ * canvasSelectionModel.slotAcceptingFill 实现注释)。
+ */
+import { describe, expect, it, vi } from 'vitest'
+import { contextMenuGroupsFor, quickToolbarGroupsFor } from './canvasActionModel'
+import { createCanvasSelectionContext } from './canvasSelectionModel'
+import type { CanvasActionGroup, CanvasActionItem, CanvasActionRuntime } from './canvasActionTypes'
+import type { CanvasNodeType, MivoCanvasNode } from '../../types/mivoCanvas'
+
+type NodeSeed = Partial<MivoCanvasNode> & { id: string; type: CanvasNodeType }
+
+const node = (seed: NodeSeed): MivoCanvasNode =>
+  ({ title: seed.id, x: 0, y: 0, width: 100, height: 100, status: 'ready', ...seed }) as MivoCanvasNode
+
+const aiSlotNode = (id: string, over: Partial<MivoCanvasNode> = {}) => node({ id, type: 'ai-slot', ...over })
+
+const ctx = (nodes: MivoCanvasNode[]) => createCanvasSelectionContext(nodes)
+
+const createRuntime = (context: ReturnType<typeof ctx>): CanvasActionRuntime =>
+  ({
+    context,
+    clipboardCount: 0,
+    hiddenCount: 0,
+    allNodeIds: context.nodes.map((n) => n.id),
+    setActiveTool: vi.fn(),
+    generateVariations: vi.fn(async () => []),
+    generateImageEdit: vi.fn(async () => []),
+    generateBesideNode: vi.fn(async () => []),
+    generateIntoAiSlot: vi.fn(async () => []),
+  }) as unknown as CanvasActionRuntime
+
+const hasAction = (groups: CanvasActionGroup[], id: string) =>
+  groups.some((g) => g.actions.some((a) => a.id === id || a.children?.some((c) => c.id === id)))
+const groupIds = (groups: CanvasActionGroup[]) => groups.map((g) => g.id).sort()
+const deepActionIds = (groups: CanvasActionGroup[]): string[] =>
+  groups.flatMap((g) => g.actions.flatMap((a) => [a.id, ...(a.children?.map((c) => c.id) ?? [])]))
+const fire = (groups: CanvasActionGroup[], id: string) => {
+  const action: CanvasActionItem | undefined = groups
+    .flatMap((g) => g.actions.flatMap((a) => [a, ...(a.children ?? [])]))
+    .find((a) => a.id === id)
+  if (!action?.onClick) throw new Error(`action not found or no onClick: ${id}`)
+  action.onClick()
+}
+
+describe('F4 ai-slot 禁二次填充(contextMenu)', () => {
+  it('ai-slot generating → 无 generate-into-slot(生成中禁二次填充)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([aiSlotNode('s1', { status: 'generating', aiWorkflow: { status: 'generating' } as never })])),
+    )
+    expect(hasAction(groups, 'generate-into-slot')).toBe(false)
+    expect(groupIds(groups)).not.toContain('generate')
+  })
+
+  it('ai-slot 批次占位 → 无 generate-into-slot(批次槽由协调器按 ordinal 填充)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([aiSlotNode('s1', { aiWorkflow: { batchId: 'b1', expectedCount: 2, ordinal: 1 } as never })])),
+    )
+    expect(hasAction(groups, 'generate-into-slot')).toBe(false)
+  })
+
+  it('ai-slot 空闲(ready)→ generate-into-slot 可用且触发 legacy', () => {
+    const rt = createRuntime(ctx([aiSlotNode('s1')]))
+    fire(contextMenuGroupsFor(rt), 'generate-into-slot')
+    expect(vi.mocked(rt.generateIntoAiSlot)).toHaveBeenCalledWith('s1', undefined, { placement: 'legacy' })
+  })
+})
+
+describe('F4 ai-slot 禁二次填充(quickbar)', () => {
+  it('ai-slot generating → 无 fill-slot,bring-front 保留', () => {
+    const groups = quickToolbarGroupsFor(
+      createRuntime(ctx([aiSlotNode('s1', { status: 'generating', aiWorkflow: { status: 'generating' } as never })])),
+    )
+    expect(deepActionIds(groups)).toEqual(['bring-front'])
+  })
+
+  it('ai-slot 批次占位 → 无 fill-slot', () => {
+    const groups = quickToolbarGroupsFor(
+      createRuntime(ctx([aiSlotNode('s1', { aiWorkflow: { batchId: 'b1', expectedCount: 2, ordinal: 1 } as never })])),
+    )
+    expect(deepActionIds(groups)).toEqual(['bring-front'])
+  })
+
+  it('ai-slot 空闲(ready)→ fill-slot / bring-front 齐全', () => {
+    const groups = quickToolbarGroupsFor(createRuntime(ctx([aiSlotNode('s1')])))
+    expect(deepActionIds(groups)).toEqual(['fill-slot', 'bring-front'])
+  })
+})
