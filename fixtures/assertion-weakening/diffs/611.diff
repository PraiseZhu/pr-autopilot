+// leaferEdgeHoverFx — derivation edge glow overlay animation controller.
+//
+// Glow = N layered Paths with same dash cycle [GLOW_LEN+GAP_LEN], decreasing
+// segment length per layer, opacity per layer, and offset-aligned heads.
+// All layers share the same dashOffset delta per frame — the group translates
+// together, creating a "comet tail" (head solid, tail fading) per segment.
+//
+// Three states: Normal (thin), Hovered/Selected (thick + glow).
+// Four guard rails: single-edge animation, LOD stop, reduced-motion static,
+//   dispose cleanups.
+// Architecture: module-level singleton via getEdgeHoverFx(); no window global
+//   in production; DEV probe for e2e debugging.
+
+import { Path, type Group, type Line } from 'leafer-ui'
+import { DERIVATION_EDGE_GLOW_LAYER_TABLE } from '../model/derivationEdgeGlowLayerTable'
+import { EDGE_GLOW_COLOR_CSS_VAR, EDGE_GLOW_COLOR_FALLBACK } from '../model/edgeGlowColorDefaults'
+import { debugLogger } from '../store/debugLogStore'
+
+const SRC = 'Leafer EdgeHoverFx'
+
+// ── layered dash config ──────────────────────────────────────────────────────
+// 数值单一来源已收到 model/derivationEdgeGlowLayerTable.ts(DOM 侧
+// canvas/derivationEdgeGlowLayers.ts 从同一个数组派生)——这里只做形状派生
+// (对象 → 元组,给下面按下标 for 循环 + 数组解构用),不再手写一份数字。
+// relOffset = GLOW_LEN − dashLen → all layer heads aligned at position
+// GLOW_LEN(offset semantics: see tick)。长层淡、短层浓 —— 方向配反会退化成
+// 平坦实心段(2026-08-08 踩过)。Composited alpha head→tail: 0.87 → 0.71 →
+// 0.53 → 0.37 → 0.23 → 0.10(衰减 88%)。
+const LAYER_TABLE: Array<[number, number, number]> = DERIVATION_EDGE_GLOW_LAYER_TABLE.map(
+  ({ len, relOff, alpha }): [number, number, number] => [len, relOff, alpha],
+)
+const CYCLE_LEN = 260
+const FLOW_SPEED_PX_PER_MS = 0.24
+// hover/选中加粗到 6(用户 2026-08-08:再粗一点;常态 2 → 3 倍);glow 与加粗
+// 主线同宽,光段完整盖住线体。
+const WIDE_STROKE = 6
+const NORMAL_STROKE = 2
+const GLOW_STROKE = 6  // glow overlay width(与 WIDE_STROKE 同宽)
+
+const glowColor = (): string => {
+  if (typeof document === 'undefined') return EDGE_GLOW_COLOR_FALLBACK
+  return getComputedStyle(document.documentElement)
+    .getPropertyValue(EDGE_GLOW_COLOR_CSS_VAR).trim() || EDGE_GLOW_COLOR_FALLBACK
+}
+
+// ── types ────────────────────────────────────────────────────────────────────
+type EntryRef = { nodeId: string; group: Group; main: Line | Path }
+type ActiveAnim = {
+  nodeId: string
+  glows: Path[]    // N layers, [0] = base layer
+  raf: number
+  startedAt: number
+  /** 已应用到 glow 层的路径缓存,用于变更检测——tick() 每帧都要重设 dashOffset
+   *  (那个本来就逐帧变),但 path 只在与这份缓存不同时才重设 6 层 + 更新缓存。
+   *  path 赋值要做路径数据解析/几何重建,连线静止时(绝大多数帧)不能白付这个
+   *  代价——「每帧现读」不等于「每帧无条件写」,这是同一枚硬币的另一面
+   *  (对照:refreshThemeColor 不放进 tick() 逐帧 getComputedStyle,是同一条
+   *  「触发源可以是高频循环,但赋值必须先判断变没变」的原则)。 */
+  pathD: string
+}
+// Glow lifecycle = hovered ∪ selected: hover-leave must not kill a selected
+// edge's glow, deselect must not kill a still-hovered one. Both sets feed
+// syncGlowState which is the ONLY place that starts/stops the animation.
+
+type Probe = {
+  getActive: () => Array<{ nodeId: string; progress: number }>
+  getRegistered: () => string[]
+  simulateHover: (nodeId: string) => void
+  simulateLeave: (nodeId: string) => void
+}
+declare global { interface Window { __MIVO_EDGE_HOVER_FX__?: Probe } }
+
+export type LeaferEdgeHoverFx = {
+  registerEntry(nodeId: string): void
+  unregisterEntry(nodeId: string): void
+  updateLod(nodeId: string, isLod: boolean): void
+  attachMain(nodeId: string, group: Group, main: Line | Path): void
+  dispose(): void
+  enterHover(nodeId: string): void
+  leaveHover(nodeId: string): void
+  updateSelection(nodeId: string, selected: boolean): void
+  /** 主题切换触发源(由已经把 theme 接进依赖数组的渲染 effect 调用,见
+   *  useLeaferSpikeRenderer):重读 --edge-glow-color 并应用到当前所有活跃 glow
+   *  层——glowColor() 只在 createGlows() 里定色一次,glow 层存活期间(hover 中,
+   *  或选中期间,可以无限长)不会自己跟着主题变;这个方法补上那条触发链,而不是
+   *  在 tick() 里逐帧 getComputedStyle(6 层 × 60fps 的样式重算是性能坑)。 */
+  refreshThemeColor(): void
+}
+
+export type LeaferEdgeHoverFxOptions = {
+  now?: () => number; raf?: (cb: FrameRequestCallback) => number; cancelRaf?: (handle: number) => void
+}
+
+let activeInstance: LeaferEdgeHoverFx | null = null
+export const getEdgeHoverFx = (): LeaferEdgeHoverFx | null => activeInstance
+
+// ── helpers ──────────────────────────────────────────────────────────────────
+const pathDOf = (m: Line | Path): string => {
+  const p = m as unknown as Record<string, unknown>
+  return (p.path as string) || `M${(p.points as number[])?.join(' ') || ''}`
+}
+
+// ── factory ──────────────────────────────────────────────────────────────────
+export const createLeaferEdgeHoverFx = (
+  options: LeaferEdgeHoverFxOptions = {},
+): LeaferEdgeHoverFx => {
+  const nowFn = options.now ?? (() => (typeof performance !== 'undefined' ? performance.now() : Date.now()))
+  const rafFn = options.raf ?? ((cb) => (typeof requestAnimationFrame !== 'undefined' ? requestAnimationFrame(cb) : 0))
+  const cancelRafFn = options.cancelRaf ?? ((h) => { if (typeof cancelAnimationFrame !== 'undefined') cancelAnimationFrame(h) })
+
+  const entries = new Map<string, EntryRef>()
+  const active = new Map<string, ActiveAnim>()
+
+  // reduced-motion。具名 handler(而不是内联匿名闭包)——dispose() 需要拿同一个
+  // 函数引用才能配对 removeEventListener,匿名闭包做不到,是本类监听器泄漏的
+  // 通病(同 PR 内 pointermove/pointerdown 都是具名配对,只这处漏)。
+  //
+  // reducedMotion 是门控,不是销毁指令——与 lodIds 同一套形状(SC-B1 的教训:
+  // 进入分支删状态、退出分支什么都不做,是"漏了对称的另一半")。两个方向都只
+  // 更新这个布尔,再对当前所有意图 id(hoveredIds ∪ selectedIds)重跑
+  // syncGlowState——可见性判定本身(见 syncGlowState)已经把 reducedMotion
+  // 算进去,这里不需要、也不允许分方向写专属逻辑(禁止 if (e.matches) 旁加
+  // else { restore } ,那是第三次犯同一个错)。
+  const mq = typeof window !== 'undefined' ? window.matchMedia('(prefers-reduced-motion: reduce)') : null
+  let reducedMotion = mq?.matches ?? false
+  const onReducedMotionChange = (e: MediaQueryListEvent) => {
+    reducedMotion = e.matches
+    const intentIds = new Set<string>([...hoveredIds, ...selectedIds])
+    for (const id of intentIds) syncGlowState(id)
+    debugLogger.log(SRC, `reduced-motion: ${e.matches ? 'enabled' : 'disabled'}, resynced ${intentIds.size} intent id(s)`)
+  }
+  mq?.addEventListener('change', onReducedMotionChange)
+
+  // DEV probe
+  const publishProbe = () => {
+    if (typeof window === 'undefined') return
+    if (!import.meta.env.DEV) { delete window.__MIVO_EDGE_HOVER_FX__; return }
+    window.__MIVO_EDGE_HOVER_FX__ = {
+      getActive: () => [...active.values()].map(a => ({ nodeId: a.nodeId, progress: nowFn() - a.startedAt })),
+      getRegistered: () => [...entries.keys()],
+      simulateHover: (id) => activeInstance?.enterHover(id),
+      simulateLeave: (id) => activeInstance?.leaveHover(id),
+    }
+  }
+
+  // ── tick: dashOffset = (CYCLE_LEN − relOff − baseOffset) mod CYCLE_LEN ──
+  // canvas2d/SVG dash semantics: a dash [L, gap] with offset O is visible at
+  // arc distance s where (s + O) mod CYCLE < L  ⟹  coverage starts at −O.
+  // Layer k gets O_k = −relOff_k − base (mod CYCLE) ⟹ covers
+  //   s ∈ [relOff_k + base, relOff_k + base + len_k).
+  // All layers END at base + GLOW_LEN → heads aligned at the leading edge.
+  // Direction proof: base grows ⟹ coverage start GROWS ⟹ segments move
+  // toward p1. markupPoints[0] is ALWAYS the source anchor
+  // (normalizeConnectorMarkupNodes: absolutePoints[0] = startBindingPoint),
+  // so p0=source, p1=target ⟹ flow is source → derived image on every edge.
+  // Flipping this sign reverses the flow — the direction test pins it.
+  const layerOffsetAt = (relOff: number, base: number): number =>
+    ((CYCLE_LEN - relOff - base) % CYCLE_LEN + CYCLE_LEN) % CYCLE_LEN
+  const tick = (nodeId: string) => {
+    const a = active.get(nodeId)
+    if (!a) return
+    const baseOffset = ((nowFn() - a.startedAt) * FLOW_SPEED_PX_PER_MS) % CYCLE_LEN
+    // 路径绑定,不是创建时拷贝:每帧从 entries 现读主线当前 path,而不是只信
+    // createGlows() 建层那一刻拷进 glow 对象的静态字符串。reconcile 对同一个
+    // main 对象原地 setProps(几何变了但对象引用不变)不会经过任何"重建 glow"
+    // 的调用点——如果 glow 的 path 只在建层时定一次,主线动了 glow 会画在旧
+    // 位置上。复用这个已经每帧在跑的 tick 循环当触发源,不新增机制;entry.main
+    // 的 path/points 只是普通对象属性读取,不是 getComputedStyle,逐帧读不是
+    // 性能坑。
+    //
+    // 但"现读"不等于"无条件写":path 赋值要走 Leafer 的路径数据解析/几何重建,
+    // 而实际几何只在拖动那几帧真的变——与 a.pathD 缓存比对,只在真的不同时才
+    // set 6 层 + 更新缓存,否则每秒 360 次(6 层 × 60fps)全是空转的重解析。
+    // dashOffset 没有这个问题,本来就是逐帧都要变的量,照旧每帧 set。
+    const entry = entries.get(nodeId)
+    const currentPathD = entry?.main ? pathDOf(entry.main) : undefined
+    const pathChanged = currentPathD !== undefined && currentPathD !== a.pathD
+    if (pathChanged) a.pathD = currentPathD as string
+    for (let k = 0; k < LAYER_TABLE.length; k++) {
+      const [, relOff] = LAYER_TABLE[k]
+      a.glows[k].set({
+        dashOffset: layerOffsetAt(relOff, baseOffset),
+        ...(pathChanged ? { path: currentPathD } : {}),
+      })
+    }
+    a.raf = rafFn(() => tick(nodeId))
+  }
+
+  // ── create N-layer glow ─────────────────────────────────────────────────
+  const createGlows = (entry: EntryRef): Path[] => {
+    const d = pathDOf(entry.main)
+    const c = glowColor()
+    // Leafer has NO strokeOpacity property (only element-level `opacity`,
+    // @leafer-ui/interface ICommonAttr) — using strokeOpacity renders every
+    // layer fully opaque and the comet tail degenerates into a solid bar.
+    // 用 opacity；此处退回 strokeOpacity 会让尾巴消失(见 opacity 判别测试)。
+    return LAYER_TABLE.map(([len, relOff, alpha]) => new Path({
+      path: d,
+      fill: undefined,
+      stroke: c,
+      strokeWidth: GLOW_STROKE,
+      strokeCap: 'round',
+      strokeJoin: 'round',
+      opacity: alpha,
+      dashPattern: [len, CYCLE_LEN - len],
+      dashOffset: layerOffsetAt(relOff, 0),  // heads aligned at GLOW_LEN (see tick)
+      visible: true,
+      zIndex: 998,
+      hitStroke: 'none',
+    }))
+  }
+
+  const widenLine = (e: EntryRef) => e.main.set({ strokeWidth: WIDE_STROKE })
+  const restoreLine = (e: EntryRef) => e.main.set({ strokeWidth: NORMAL_STROKE })
+
+  // ── hovered ∪ selected → glow state ─────────────────────────────────────
+  // hoveredIds/selectedIds = 用户意图(还 hover 着 / 已选中),只由真实用户事件
+  // 增删。lodIds = 可见性门控(当前几何太小,画不了 glow),只由 updateLod 增删。
+  // 两者分离——之前的 bug 是 LOD 进入分支把节点从 hoveredIds/selectedIds 里删,
+  // 把"门控"和"意图"焊死在同一个集合里,退出分支就没有意图可恢复了。现在
+  // syncGlowState 每次都从三个集合重新算,进/出 LOD 天然对称,不需要在退出
+  // 分支补 restore。
+  const hoveredIds = new Set<string>()
+  const selectedIds = new Set<string>()
+  const lodIds = new Set<string>()
+
+  /** 只停动画(cancel raf + 移除 glow 层 + 退出 active),不碰线宽——静态加粗
+   *  态(reduced-motion 下 wanted 但不动画)与"完全不 wanted"态共享这一步,
+   *  区别只在于调用方之后要不要接着 restoreLine。 */
+  const stopAnimation = (nodeId: string): boolean => {
+    const a = active.get(nodeId)
+    if (!a) return false
+    cancelRafFn(a.raf)
+    a.glows.forEach(g => g.remove())
+    active.delete(nodeId)
+    return true
+  }
+
+  /** 三态可见性判定的唯一落地点:off(不 wanted,细线无 glow)/ static(wanted
+   *  但 reducedMotion,粗线无 glow)/ animated(wanted 且非 reducedMotion,粗线
+   *  +跑动画)。三个态之间怎么切都从这一个函数走,不区分"从哪个态来的"——
+   *  hover/selection/LOD/reduced-motion 四个触发源全部只改各自的门控集合再
+   *  调用这一个函数,不写方向专属的进入/退出逻辑(SC-B1 的教训)。 */
+  const syncGlowState = (nodeId: string) => {
+    const wanted = (hoveredIds.has(nodeId) || selectedIds.has(nodeId)) && !lodIds.has(nodeId)
+    const entry = entries.get(nodeId)
+
+    if (!wanted) {
+      stopAnimation(nodeId)
+      if (entry && entry.main) restoreLine(entry)
+      debugLogger.log(SRC, `glow stopped on ${nodeId}`)
+      publishProbe()
+      return
+    }
+
+    if (!entry || !entry.main) { debugLogger.warn(SRC, `glow: ${nodeId} not registered — skipped`); return }
+    widenLine(entry)
+
+    if (reducedMotion) {
+      if (stopAnimation(nodeId)) {
+        debugLogger.log(SRC, `glow: reduced-motion, static highlight ${nodeId}`)
+        publishProbe()
+      }
+      return
+    }
+
+    if (active.has(nodeId)) return // 已经在跑,不重建
+
+    const glows = createGlows(entry)
+    glows.forEach(g => entry.group.add(g))
+    // pathD 缓存起点 = createGlows 里刚烘进 6 层的那个值,与它们实际同步——
+    // 第一个 tick 现读到同一个值,不会误判成"变了"而白 set 一次。
+    const anim: ActiveAnim = { nodeId, glows, raf: 0, startedAt: nowFn(), pathD: pathDOf(entry.main) }
+    active.set(nodeId, anim)
+    anim.raf = rafFn(() => tick(nodeId))
+    debugLogger.log(SRC, `glow started on ${nodeId} (${glows.length} layers)`)
+    publishProbe()
+  }
+
+  const enterHover: LeaferEdgeHoverFx['enterHover'] = (nodeId) => {
+    hoveredIds.add(nodeId)
+    syncGlowState(nodeId)
+  }
+
+  const leaveHover: LeaferEdgeHoverFx['leaveHover'] = (nodeId) => {
+    hoveredIds.delete(nodeId)
+    syncGlowState(nodeId)
+  }
+
+  const updateSelection: LeaferEdgeHoverFx['updateSelection'] = (nodeId, selected) => {
+    if (selected) selectedIds.add(nodeId)
+    else selectedIds.delete(nodeId)
+    syncGlowState(nodeId)
+  }
+
+  // ── management ──────────────────────────────────────────────────────────
+  const registerEntry: LeaferEdgeHoverFx['registerEntry'] = (id) => { entries.set(id, { nodeId: id, group: null as unknown as Group, main: null as unknown as Line }); publishProbe() }
+  const unregisterEntry: LeaferEdgeHoverFx['unregisterEntry'] = (id) => { hoveredIds.delete(id); selectedIds.delete(id); lodIds.delete(id); syncGlowState(id); entries.delete(id); publishProbe() }
+  // 门控集,不动用户意图:进 LOD 只加进 lodIds,出 LOD 只从 lodIds 删——
+  // hoveredIds/selectedIds 全程不变,syncGlowState 重算即可自然恢复。
+  const updateLod: LeaferEdgeHoverFx['updateLod'] = (id, isLod) => {
+    if (isLod) {
+      if (lodIds.has(id)) return
+      lodIds.add(id)
+      debugLogger.log(SRC, `updateLod: entered LOD, gating ${id}`)
+    } else {
+      if (!lodIds.has(id)) return
+      lodIds.delete(id)
+      debugLogger.log(SRC, `updateLod: exited LOD, ungating ${id}`)
+    }
+    syncGlowState(id)
+  }
+  const attachMain: LeaferEdgeHoverFx['attachMain'] = (id, g, m) => {
+    const e = entries.get(id)
+    if (e) { e.group = g; e.main = m } else entries.set(id, { nodeId: id, group: g, main: m })
+    publishProbe()
+  }
+  const dispose: LeaferEdgeHoverFx['dispose'] = () => {
+    for (const [,a] of active) { cancelRafFn(a.raf); a.glows.forEach(g => g.remove()) }
+    active.clear(); entries.clear(); activeInstance = null
+    mq?.removeEventListener('change', onReducedMotionChange)
+    if (typeof window !== 'undefined') delete window.__MIVO_EDGE_HOVER_FX__
+    debugLogger.log(SRC, 'disposed')
+  }
+
+  const refreshThemeColor: LeaferEdgeHoverFx['refreshThemeColor'] = () => {
+    if (active.size === 0) return
+    const c = glowColor()
+    for (const [, a] of active) {
+      a.glows.forEach((g) => g.set({ stroke: c }))
+    }
+  }
+
+  const fx = {
+    registerEntry, unregisterEntry, updateLod, attachMain, dispose,
+    enterHover, leaveHover, updateSelection, refreshThemeColor,
+  }
+  activeInstance = fx
+  return fx
+}
