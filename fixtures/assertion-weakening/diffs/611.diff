+    mockMatchMedia(true)
+    const html = renderMarkup(derivationEdgeNode(), true)
+    expect(html).not.toContain('markup-glow-overlay')
+    expect(html).toContain('stroke-width="6"')
+  })
+
+  it('对照:非 reduced-motion 下选中态仍照常跑流光动画(证明上一条不是把动画整体关掉)', () => {
+    mockMatchMedia(false)
+    const html = renderMarkup(derivationEdgeNode(), true)
+    expect(html).toContain('markup-glow-overlay')
+  })
