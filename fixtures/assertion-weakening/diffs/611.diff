@@ -0,0 +1,193 @@
+// useDerivationEdgeHover — React hook: pointermove → hitTest → edgeHoverFx glow,
+// plus selection → fx.updateSelection sync (选中的连线保持加粗+流光).
+//
+// Leafer is hittable:false + pointer-events:none, so hover detection runs on
+// the React event path: window pointermove → screenToCanvas → pointInMarkupStroke
+// against derivation edge nodes → getEdgeHoverFx().enterHover / leaveHover.
+//
+// 几何必须按 nodes 引用现算(缓存按引用失效):节点拖动/normalize 重写锚点后
+// markupPoints 会变,启动时投影一次的旧几何会让 hover 在移动过的线上永远
+// 命不中(2026-08-08 真机"有些连线 hover 不触发"的另一半根因;第一半是
+// hitTest 漏传锚点方向,见 hitTest.ts pointInMarkupStroke)。
+//
+// rAF 循环只在指针真的移动过时才跑 hitTest(同一点跳过),避免静止时 60fps
+// 空转全量命中计算。
+//
+// DOM renderer handles its own hover via MarkupNodeView's onPointerEnter.
+
+import { useEffect, useLayoutEffect, useRef } from 'react'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+import { isDerivationEdgeNode } from '../store/nodeFactory'
+import { pointInMarkupStroke, sortForHitTest } from './hitTest'
+import { projectNode, type RenderNode } from './projection'
+import { debugLogger } from '../store/debugLogStore'
+import { getEdgeHoverFx } from './leaferEdgeHoverFx'
+
+const SRC = 'DerivationEdgeHover'
+const HIT_TOLERANCE = 10
+
+export type DerivationEdgeHoverOptions = {
+  screenToCanvas: (clientX: number, clientY: number) => { x: number; y: number }
+  nodes: MivoCanvasNode[]
+  selectedNodeIds: string[]
+  rendererMode: 'dom' | 'leafer' | 'pixi'
+}
+
+export function useDerivationEdgeHover(options: DerivationEdgeHoverOptions): void {
+  const { selectedNodeIds, rendererMode } = options
+
+  const rafRef = useRef(0)
+  const lastHoveredRef = useRef<string | null>(null)
+  const pendingPointRef = useRef<{ x: number; y: number } | null>(null)
+  const processedPointRef = useRef<{ x: number; y: number } | null>(null)
+  const optsRef = useRef(options)
+  // latest-ref:写入放 layout effect(render 期写 ref 违反 react-hooks/refs);
+  // 读方都在 rAF/事件回调里,commit 后才跑,layout effect 时序足够新。
+  useLayoutEffect(() => {
+    optsRef.current = options
+  })
+
+  // 投影缓存:按 nodes 数组引用 + 选中集合失效。store 每次变更产出新数组引用,
+  // 引用没变 ⟹ 节点没动 ⟹ 缓存有效;引用变了才重投影。selectedNodeIds 单独
+  // 入键:选中态活在独立的 store slice,选中/取消选中一条连线不会让 nodes 换新
+  // 引用——只按 nodes 失效会让下面的 selected 提升读到选中变化前的旧快照。
+  const projCacheRef = useRef<{ src: MivoCanvasNode[] | null; selectedKey: string; edges: RenderNode[] }>({
+    src: null,
+    selectedKey: '',
+    edges: [],
+  })
+  const edgesForCurrentNodes = (): RenderNode[] => {
+    const ns = optsRef.current.nodes
+    const selectedIds = optsRef.current.selectedNodeIds
+    const selectedKey = selectedIds.join(',')
+    if (projCacheRef.current.src !== ns || projCacheRef.current.selectedKey !== selectedKey) {
+      const selectedSet = new Set(selectedIds)
+      // SC-1:命中层级必须跟随 selected 提升,与 interactionDispatch.ts 的主指针
+      // 命中路径同一套规则(defaultZOrderCompare)——否则两条重叠连线中文档顺序
+      // 靠前但已选中的那条会丢失第一命中,流光落到视觉下层的连线上。projectNode
+      // 不传 ctx 时 RenderNode.selected 恒为 false(见 projection.ts),所以必须
+      // 显式喂 selectedNodeIds;再用 sortForHitTest(而非裸 reverse)拿到应用了
+      // selected 提升的 back-to-front 顺序,最后 reverse 成 front-to-back 供下方
+      // for 循环首个命中即返回(与 hitTest.ts topmostNodeHit 的两步顺序一致)。
+      const edges = sortForHitTest(
+        ns
+          .filter((n) => isDerivationEdgeNode(n))
+          .map((n) => projectNode(n, { selectedNodeIds: selectedSet }))
+          .filter((r) => r.markupKind === 'arrow' || r.markupKind === 'line'),
+      ).reverse()
+      projCacheRef.current = { src: ns, selectedKey, edges }
+    }
+    return projCacheRef.current.edges
+  }
+
+  // ── hover: pointermove → hitTest → enter/leave ──────────────────────────
+  useEffect(() => {
+    if (rendererMode !== 'leafer') return
+
+    const processPending = () => {
+      const pt = pendingPointRef.current
+      // 同一点已处理过 → 跳过本帧(指针静止时不空转 hitTest)。
+      if (!pt || pt === processedPointRef.current) {
+        rafRef.current = requestAnimationFrame(processPending)
+        return
+      }
+      processedPointRef.current = pt
+
+      let hitId: string | null = null
+      for (const r of edgesForCurrentNodes()) {
+        if (pointInMarkupStroke(r, pt, HIT_TOLERANCE)) {
+          hitId = r.id
+          break
+        }
+      }
+
+      const fx = getEdgeHoverFx()
+      if (fx && hitId !== lastHoveredRef.current) {
+        if (lastHoveredRef.current) fx.leaveHover(lastHoveredRef.current)
+        if (hitId) fx.enterHover(hitId)
+        lastHoveredRef.current = hitId
+      }
+
+      rafRef.current = requestAnimationFrame(processPending)
+    }
+
+    const onPointerMove = (event: PointerEvent) => {
+      const canvasPt = optsRef.current.screenToCanvas(event.clientX, event.clientY)
+      pendingPointRef.current = { x: canvasPt.x, y: canvasPt.y }
+    }
+
+    // SC-B3:指针离窗/失焦/页面隐藏后不再有 pointermove 事件驱动 hitTest——
+    // hover 着一条未选中的连线时,hover 态会永远卡在那条线上、rAF 持续烧帧
+    // (2026-08-09 三审:指针移出浏览器窗口后 hover 卡死)。这里主动清 hover
+    // (fx.leaveHover);选中态不动——leaferEdgeHoverFx.syncGlowState 是
+    // hoveredIds∪selectedIds,清 hover 不会清掉已选中连线的发光(见该文件同一
+    // 并行修复批次)。
+    const clearHoverOnWindowExit = () => {
+      pendingPointRef.current = null
+      processedPointRef.current = null
+      if (!lastHoveredRef.current) return
+      getEdgeHoverFx()?.leaveHover(lastHoveredRef.current)
+      lastHoveredRef.current = null
+      debugLogger.log(SRC, 'hover cleared: pointer left window / lost focus / page hidden')
+    }
+    // relatedTarget === null → 指针真的离开了整个文档(不是在子元素间切换,
+    // 那种情况下一帧的 pointermove 会立刻重算命中,不需要特殊处理)。
+    const onPointerOut = (event: PointerEvent) => {
+      if (event.relatedTarget === null) clearHoverOnWindowExit()
+    }
+    const onVisibilityChange = () => {
+      if (document.visibilityState === 'hidden') clearHoverOnWindowExit()
+    }
+
+    window.addEventListener('pointermove', onPointerMove, { passive: true })
+    window.addEventListener('pointerout', onPointerOut)
+    window.addEventListener('blur', clearHoverOnWindowExit)
+    document.addEventListener('visibilitychange', onVisibilityChange)
+    rafRef.current = requestAnimationFrame(processPending)
+    debugLogger.log(SRC, 'hover detection active (projection follows node changes)')
+
+    return () => {
+      window.removeEventListener('pointermove', onPointerMove)
+      window.removeEventListener('pointerout', onPointerOut)
+      window.removeEventListener('blur', clearHoverOnWindowExit)
+      document.removeEventListener('visibilitychange', onVisibilityChange)
+      cancelAnimationFrame(rafRef.current)
+      if (lastHoveredRef.current) {
+        getEdgeHoverFx()?.leaveHover(lastHoveredRef.current)
+        lastHoveredRef.current = null
+      }
+      debugLogger.log(SRC, 'hover detection stopped')
+    }
+  }, [rendererMode])
+
+  // ── selection → fx.updateSelection(选中保持流光;点选连线 → Delete 可删) ──
+  const prevSelectedRef = useRef<Set<string>>(new Set())
+  useEffect(() => {
+    if (rendererMode !== 'leafer') return
+    const fx = getEdgeHoverFx()
+    if (!fx) return
+    const selectedSet = new Set(selectedNodeIds)
+    const current = new Set(
+      optsRef.current.nodes
+        .filter((n) => isDerivationEdgeNode(n) && selectedSet.has(n.id))
+        .map((n) => n.id),
+    )
+    for (const id of prevSelectedRef.current) {
+      if (!current.has(id)) fx.updateSelection(id, false)
+    }
+    for (const id of current) {
+      if (!prevSelectedRef.current.has(id)) fx.updateSelection(id, true)
+    }
+    prevSelectedRef.current = current
+  }, [rendererMode, selectedNodeIds])
+
+  // 卸载时清掉仍在选中态的流光(不放上面的 effect cleanup:那会在每次
+  // selectedNodeIds 变化时先全清再重建,造成闪烁)。
+  useEffect(() => {
+    return () => {
+      const fx = getEdgeHoverFx()
+      for (const id of prevSelectedRef.current) fx?.updateSelection(id, false)
+      prevSelectedRef.current = new Set()
+    }
+  }, [])
+}
