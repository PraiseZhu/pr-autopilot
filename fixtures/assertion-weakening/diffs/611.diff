+    if (!svg) throw new Error('fixture: derivation edge svg not found')
+    act(() => {
+      svg.dispatchEvent(new PointerEvent('pointerover', { bubbles: true }))
+    })
+  }
+
+  const hasGlow = () => Boolean(container.querySelector('.markup-glow-overlay'))
+
+  it('失焦或页面隐藏后未选中流光停止:blur 后 hover 产生的流光消失', () => {
+    mount(false)
+    hoverOn()
+    expect(hasGlow()).toBe(true) // 前提:真的先进入了 hover 态(否则下面的"停止"无判别力)
+
+    act(() => {
+      window.dispatchEvent(new Event('blur'))
+    })
+    expect(hasGlow()).toBe(false)
+  })
+
+  it('失焦或页面隐藏后未选中流光停止:页面隐藏(visibilitychange → hidden)同样让流光消失', () => {
+    mount(false)
+    hoverOn()
+    expect(hasGlow()).toBe(true)
+
+    vi.spyOn(document, 'visibilityState', 'get').mockReturnValue('hidden')
+    act(() => {
+      document.dispatchEvent(new Event('visibilitychange'))
+    })
+    expect(hasGlow()).toBe(false)
+  })
+
+  it('对照:选中态连线在失焦后仍保持流光(不外溢——只清 hover,不清选中态)', () => {
+    mount(true)
+    expect(hasGlow()).toBe(true) // 选中态本身就该发光,不需要先 hover
+
+    act(() => {
+      window.dispatchEvent(new Event('blur'))
+    })
+    expect(hasGlow()).toBe(true) // 失焦后选中态兜底,仍然发光
+  })
+
+  it('对照:选中态连线在页面隐藏后仍保持流光', () => {
+    mount(true)
+    expect(hasGlow()).toBe(true)
+
+    vi.spyOn(document, 'visibilityState', 'get').mockReturnValue('hidden')
+    act(() => {
+      document.dispatchEvent(new Event('visibilitychange'))
+    })
+    expect(hasGlow()).toBe(true)
+  })
+})
+
+describe('MarkupNodeView DOM glow 可观测性 — debugLogger 三态日志(SC-2)', () => {
+  // SC-2(Greptile review #3747828109):DOM 回退通道流光状态变化必须写 Debug Log,
+  // 与 Leafer 通道(leaferEdgeHoverFx)可观测性一致。源码级断言(与本文件"层表跨
+  // 渲染器防漂移"同手段):hover 清理 / reduced-motion 降级 / 流光动画启停 三处
+  // transition 各有 debugLogger.log 落点——删任一处即红。
+  it('hover 清理 / reduced-motion 降级 / 流光启停均经 debugLogger 记录', () => {
+    expect(markupNodeViewSource).toContain("debugLogger.log(SRC, 'glow: hover cleared")
+    expect(markupNodeViewSource).toContain('debugLogger.log(SRC, `reduced-motion:')
+    expect(markupNodeViewSource).toContain('debugLogger.log(SRC, `glow started on')
+    expect(markupNodeViewSource).toContain('debugLogger.log(SRC, `glow stopped on')
+  })
+})
