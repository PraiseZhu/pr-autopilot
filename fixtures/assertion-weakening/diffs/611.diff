+// @vitest-environment happy-dom
+// SC-B6/B7/B8(PR-B 三审共识 g2 组):DOM 渲染器(?renderer=dom 回退通道,亦可由
+// Leafer init 失败自动降级触达)下派生连线的 hover∪选中视觉反馈,必须与 Leafer
+// 侧同表同式——修复前 DOM 侧只响应 hover(从未接收选中态)、从不退化 reduced-motion。
+//
+// renderToStaticMarkup 静态渲染即足够:"选中未 hover"正是静态渲染天然覆盖的场景
+// (glowHovered 是初始 useState(false),不需要模拟指针交互);reduced-motion 通过
+// mock window.matchMedia 的初值控制,同样在首次静态渲染里就能读到。
+// SC-C2 的用例(下方第二个 describe)例外:必须先让 glowHovered 真的变 true 再
+// 触发失焦/隐藏,静态渲染做不到这一步,改用 react-dom/client + React 19 act 的
+// 真实挂载(沿用 useDocumentThemeAttribute.test.ts 的先例)——dispatch 真实
+// PointerEvent('pointerover', {bubbles:true}) 触发 React 的 onPointerEnter
+// 合成事件(React 对 pointerenter/pointerleave 走 capture 委托,从 pointerover/
+// pointerout 派生;已用探针验证 dispatch 'pointerover' 确实能触发 onPointerEnter)。
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act, createElement as h } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { renderToStaticMarkup } from 'react-dom/server'
+import { MarkupNodeView } from './MarkupNodeView'
+import { DOM_GLOW_LAYERS } from './derivationEdgeGlowLayers'
+import { DERIVATION_EDGE_GLOW_LAYER_TABLE } from '../model/derivationEdgeGlowLayerTable'
+import leaferEdgeHoverFxSource from '../render/leaferEdgeHoverFx.ts?raw'
+import markupNodeViewSource from './MarkupNodeView.tsx?raw'
+import { createDerivationEdgeNode } from '../store/nodeFactory'
+import type { CanvasEdge, MivoCanvasNode } from '../types/mivoCanvas'
+
+;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+
+const image = (id: string, x: number): MivoCanvasNode =>
+  ({
+    id,
+    type: 'image',
+    title: id,
+    x,
+    y: 0,
+    width: 100,
+    height: 100,
+    status: 'ready',
+  }) as MivoCanvasNode
+
+const derivationEdgeNode = (): MivoCanvasNode => {
+  const src = image('src', 0)
+  const tgt = image('tgt', 300)
+  const edge: CanvasEdge = { id: 'e1', from: 'src', to: 'tgt', type: 'edit', prompt: '', createdAt: 0 }
+  const node = createDerivationEdgeNode(edge, [src, tgt])
+  if (!node) throw new Error('fixture: derivation edge node not created')
+  return node
+}
+
+const mockMatchMedia = (matches: boolean) => {
+  window.matchMedia = vi.fn().mockImplementation((query: string) => ({
+    matches,
+    media: query,
+    addEventListener: vi.fn(),
+    removeEventListener: vi.fn(),
+  })) as unknown as typeof window.matchMedia
+}
+
+const renderMarkup = (node: MivoCanvasNode, selected: boolean) =>
+  renderToStaticMarkup(
+    h(MarkupNodeView, {
+      node,
+      editing: false,
+      selected,
+      onUpdateText: () => {},
+      onFinishTextEdit: () => {},
+    }),
+  )
+
+describe('MarkupNodeView 派生连线 DOM 渲染 — 选中态/reduced-motion/层表同源(SC-B6/B7/B8)', () => {
+  beforeEach(() => {
+    mockMatchMedia(false)
+  })
+  afterEach(() => {
+    vi.restoreAllMocks()
+  })
+
+  it('选中未 hover 也有流光:DOM 侧选中态必须与 hover 同样驱动加粗+流光', () => {
+    const html = renderMarkup(derivationEdgeNode(), true)
+    expect(html).toContain('markup-glow-overlay')
+    expect(html).toContain('stroke-width="6"') // DERIVATION_WIDE_STROKE:选中也加粗主线
+  })
+
+  it('对照:未选中且未 hover 不显示流光(证明上一条不是恒真渲染)', () => {
+    const html = renderMarkup(derivationEdgeNode(), false)
+    expect(html).not.toContain('markup-glow-overlay')
+  })
