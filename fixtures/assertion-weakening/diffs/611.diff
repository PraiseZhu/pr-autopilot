--- /dev/null
+++ b/src/render/useDerivationEdgeHover.test.ts
@@ -0,0 +1,220 @@
+// @vitest-environment happy-dom
+// SC-B3(PR-B 三审共识 g2 组):useDerivationEdgeHover 的窗口级 pointermove hover
+// 此前只在卸载时清理——指针离开浏览器窗口(或页面失焦/隐藏)后不再有 pointermove
+// 事件驱动 hitTest,hover 着一条**未选中**的连线时,hover 态会永远卡在那条线上、
+// rAF 持续烧帧(2026-08-09 三审同批同族问题)。本测试钉住:window pointerout
+// (relatedTarget 为 null,即真的离开文档,不是子元素间切换)/ blur / 页面隐藏
+// 三个信号都必须让未选中连线的动效停下来(fx.leaveHover),且不触碰选中态
+// (fx.updateSelection 从不被调;假 fx 用 hoveredIds∪selectedIds 的最小复刻验证
+// "选中的连线在指针离窗后仍然活跃",不只是断言"调对了函数名")。
+//
+// harness 沿用 useDocumentThemeAttribute.test.ts 的先例:react-dom/client +
+// React 19 act,不引入 @testing-library。mock 掉 leaferEdgeHoverFx 整个模块
+// (最小复刻其 hoveredIds∪selectedIds 语义)——真实动画机制由
+// leaferEdgeHoverFx.test.ts 单独覆盖,本测试只关心 hook 在正确时机调用了正确的
+// fx 方法。
+import { act, createElement } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+// React 19 act() 环境标记(本仓既有惯例,见 useRegionEditArmed.test.tsx 等)。
+;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+
+const hoveredIds = new Set<string>()
+const selectedIds = new Set<string>()
+const activeIds = () => new Set([...hoveredIds, ...selectedIds])
+
+const fxSpies = {
+  enterHover: vi.fn((id: string) => {
+    hoveredIds.add(id)
+  }),
+  leaveHover: vi.fn((id: string) => {
+    hoveredIds.delete(id)
+  }),
+  updateSelection: vi.fn((id: string, selected: boolean) => {
+    if (selected) selectedIds.add(id)
+    else selectedIds.delete(id)
+  }),
+}
+
+vi.mock('./leaferEdgeHoverFx', () => ({
+  getEdgeHoverFx: () => fxSpies,
+}))
+
+let container: HTMLDivElement
+let root: Root
+let rafQueue: FrameRequestCallback[]
+
+const flushRaf = () => {
+  const cbs = [...rafQueue]
+  rafQueue = []
+  cbs.forEach((cb) => cb(performance.now()))
+}
+
+beforeEach(() => {
+  rafQueue = []
+  vi.stubGlobal('requestAnimationFrame', (cb: FrameRequestCallback) => {
+    rafQueue.push(cb)
+    return rafQueue.length
+  })
+  vi.stubGlobal('cancelAnimationFrame', () => {})
+  hoveredIds.clear()
+  selectedIds.clear()
+  fxSpies.enterHover.mockClear()
+  fxSpies.leaveHover.mockClear()
+  fxSpies.updateSelection.mockClear()
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+})
+
+afterEach(() => {
+  act(() => {
+    root.unmount()
+  })
+  container.remove()
+  vi.unstubAllGlobals()
+  vi.resetModules()
+})
+
+// 直线路由(不是 createDerivationEdgeNode 出厂的 smooth):命中判定退回简单
+// distToSegment,构造一个可预测的命中点不依赖贝塞尔弯曲几何。
+const derivationEdgeNode = (id = 'derivation-e1'): MivoCanvasNode =>
+  ({
+    id,
+    type: 'markup',
+    title: 'Derivation',
+    x: 0,
+    y: 0,
+    width: 200,
+    height: 1,
+    status: 'ready',
+    locked: true,
+    markupKind: 'arrow',
+    markupLineRoute: 'straight',
+    markupStartArrow: false,
+    markupEndArrow: false,
+    markupPoints: [
+      { x: 0, y: 0 },
+      { x: 200, y: 0 },
+    ],
+    generation: { prompt: '', model: 'Mivo Derivation Edge', createdAt: 0 },
+  }) as unknown as MivoCanvasNode
+
+const mountHarness = async (nodes: MivoCanvasNode[], selectedNodeIds: string[] = []) => {
+  const { useDerivationEdgeHover } = await import('./useDerivationEdgeHover')
+  function Harness() {
+    useDerivationEdgeHover({
+      screenToCanvas: (x, y) => ({ x, y }),
+      nodes,
+      selectedNodeIds,
+      rendererMode: 'leafer',
+    })
+    return null
+  }
+  act(() => {
+    root.render(createElement(Harness))
+  })
+}
+
+const dispatchPointerMove = (x: number, y: number) => {
+  act(() => {
+    window.dispatchEvent(new PointerEvent('pointermove', { clientX: x, clientY: y }))
+  })
+}
+
+/** 命中派生连线正中点(node 是水平直线路由,(100, 0) 落在描边容差内)。 */
+const hoverOnto = (id = 'derivation-e1') => {
+  dispatchPointerMove(100, 0)
+  act(() => {
+    flushRaf()
+  })
+  expect(fxSpies.enterHover).toHaveBeenCalledWith(id)
+}
+
+describe('useDerivationEdgeHover — 指针离窗/失焦/页面隐藏后清 hover(SC-B3)', () => {
