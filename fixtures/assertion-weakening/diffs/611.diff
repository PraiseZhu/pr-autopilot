+    expect(leaferEdgeHoverFxSource).not.toMatch(/\[\s*100\s*,\s*0\s*,\s*0\.1\d*\s*\]/)
+  })
+})
+
+describe('MarkupNodeView 派生连线 DOM 渲染 — 窗口失焦/页面隐藏后清 hover(SC-C2)', () => {
+  let container: HTMLDivElement
