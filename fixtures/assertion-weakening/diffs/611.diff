+  it('层表跨渲染器防漂移(同一来源派生,非数值转录)', () => {
+    // DOM 侧:derivationEdgeGlowLayers.ts 的 DOM_GLOW_LAYERS 就是这个共享数组
+    // 本身(re-export),不是另起一份拷贝——同一个对象引用,不会"看起来一样
+    // 但其实是两份"。
+    expect(DOM_GLOW_LAYERS).toBe(DERIVATION_EDGE_GLOW_LAYER_TABLE)
+
+    // Leafer 侧:源码文本核实它也从同一个共享模块 import 并用 .map 派生,不再
+    // 手写数字字面量——防止有人在这边改了共享源,那边却悄悄加回一份"临时"表。
+    expect(leaferEdgeHoverFxSource).toMatch(
+      /import\s*\{\s*DERIVATION_EDGE_GLOW_LAYER_TABLE\s*\}\s*from\s*['"]\.\.\/model\/derivationEdgeGlowLayerTable['"]/,
