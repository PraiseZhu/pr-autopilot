+    expect((main as unknown as TFakeUI).props.strokeWidth).toBe(6) // 加粗保留(静态高亮,不是熄灭)
+
+    // 关掉——同样只派发 change 事件。选中意图全程没变,必须自动恢复动画,
+    // 不需要用户再 hover/点选一次。
+    mql.dispatch(false)
