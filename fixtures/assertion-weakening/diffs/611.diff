+// Derivation edge DOM glow:6 层 dash 彗星尾(长层淡短层浓,头部对齐)。独立
+// 成文(而不是留在 MarkupNodeView.tsx 里)是因为 react-refresh/only-export-components
+// 不允许组件文件里混出非组件常量。
+//
+// PR-B R2:数值单一来源已收到 model/derivationEdgeGlowLayerTable.ts,Leafer 侧
+// (render/leaferEdgeHoverFx.ts)从同一个数组派生。这里直接复用该来源,不再自己
+// 手写一份数字——两侧的"同值同序"从此是结构保证(同一个数组引用),不是靠测试
+// 转录背书。
+export { DERIVATION_EDGE_GLOW_LAYER_TABLE as DOM_GLOW_LAYERS } from '../model/derivationEdgeGlowLayerTable'
+
+// hover∪选中激活时的加粗宽度(与 leaferEdgeHoverFx.WIDE_STROKE 同值,理由同上
+// 不 import)。派生连线常态描边宽度读 --edge-derivation-width,默认 2
+// (canvasRenderAdapter.markupRenderStyleFor),与 leaferEdgeHoverFx.NORMAL_STROKE
+// 同值,加粗后两侧视觉一致。
+export const DERIVATION_WIDE_STROKE = 6
diff --git a/src/model/derivationEdgeGlowLayerTable.ts b/src/model/derivationEdgeGlowLayerTable.ts
