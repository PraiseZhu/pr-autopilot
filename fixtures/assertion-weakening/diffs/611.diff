+++ b/src/model/derivationEdgeGlowLayerTable.ts
@@ -0,0 +1,26 @@
+// derivation edge glow overlay 的 6 层 dash 表 —— 单一物理来源。
+//
+// PR-B R2 复核(席③ major / 席① suggestion,两席都判该做):Leafer 侧
+// (render/leaferEdgeHoverFx.ts 的私有 LAYER_TABLE 元组)与 DOM 侧
+// (canvas/derivationEdgeGlowLayers.ts 的 DOM_GLOW_LAYERS 对象数组)此前各写
+//了一份,靠测试转录逐项比对背书"同值同序"——但转录本身就是"两份字面量"
+// 的证据,任一侧改了数值/顺序,漂移只会在下一次跑测试时被动发现,不是结构上
+// 不可能发生。收到这一处后,两侧从同一个数组派生,形状差异(元组 vs 对象)
+// 用映射解决,不再各写一份数字。
+//
+// 数值含义:[len, relOff, alpha] —— len=dash 段长度,relOff=相对偏移(GLOW_LEN
+// − len,让所有层头部对齐在同一位置),alpha=该层不透明度。长层淡、短层浓——
+// 方向配反会退化成平坦实心段(2026-08-08 踩过,见 leaferEdgeHoverFx.ts 头部
+// 注释)。Composited alpha 头→尾:0.87 → 0.71 → 0.53 → 0.37 → 0.23 → 0.10
+// (衰减 88%)。
+
+export type DerivationEdgeGlowLayer = { len: number; relOff: number; alpha: number }
+
+export const DERIVATION_EDGE_GLOW_LAYER_TABLE: readonly DerivationEdgeGlowLayer[] = [
+  { len: 100, relOff: 0, alpha: 0.10 },
+  { len: 78, relOff: 22, alpha: 0.14 },
+  { len: 58, relOff: 42, alpha: 0.18 },
+  { len: 40, relOff: 60, alpha: 0.26 },
+  { len: 24, relOff: 76, alpha: 0.38 },
+  { len: 11, relOff: 89, alpha: 0.55 },
+]
