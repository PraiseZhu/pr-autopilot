+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+import { EDGE_GLOW_COLOR_FALLBACK } from '../model/edgeGlowColorDefaults'
+import { DERIVATION_EDGE_GLOW_LAYER_TABLE } from '../model/derivationEdgeGlowLayerTable'
+import moduleSource from './leaferEdgeHoverFx.ts?raw'
+
+vi.mock('../store/debugLogStore', () => ({
+  debugLogger: { log: () => {}, warn: () => {}, error: () => {} },
+}))
+
+vi.mock('leafer-ui', () => {
+  class FakeUI {
+    props: Record<string, unknown>
+    _listeners: Record<string, Array<(...args: unknown[]) => void>>
+    _children: FakeUI[] = []
+    removed = false
+    constructor(props: Record<string, unknown> = {}) { this.props = { ...props }; this._listeners = {} }
+    // 真实 Leafer 的 Line/Path 把 points/path 暴露成实例级属性(直接 this.points,
+    // 不是 this.props.points——见 leafer-ui 源码 Line.isPointsMode getter)。
+    // pathDOf() 按真实形状读取,这里的 getter 代理回 props,让 fake 与真实实例
+    // 同一种读法(否则 pathDOf 在测试里永远读到 undefined,现读绑定测不出来)。
+    get points() { return this.props.points }
+    get path() { return this.props.path }
+    set(props: Record<string, unknown>) { Object.assign(this.props, props) }
+    remove() { this.removed = true }
+    on() { return this }
+  }
+  class FakeGroup extends FakeUI { add(child: FakeUI) { this._children.push(child) } }
+  class FakePath extends FakeUI {}
+  return { Group: FakeGroup, Path: FakePath, Line: FakePath, Ellipse: FakeUI, Polygon: FakeUI, Rect: FakeUI }
+})
+
+import { createLeaferEdgeHoverFx, type LeaferEdgeHoverFx } from './leaferEdgeHoverFx'
+import { Line, type Group } from 'leafer-ui'
+
+type TFakeUI = { props: Record<string, unknown>; _children: TFakeUI[]; removed: boolean }
+
+let fakeNow = 0
+let rafCbs: Array<FrameRequestCallback> = []
+let nextId = 1
+const fakeRaf = (cb: FrameRequestCallback): number => { const id = nextId++; rafCbs.push(cb); return id }
+const fakeCancelRaf = () => {}
+const flushRaf = (ms: number) => { fakeNow += ms; const cbs = [...rafCbs]; rafCbs = []; for (const cb of cbs) cb(0) }
+
+let MockGroup: new (p?: Record<string, unknown>) => Group
+let MockLine: new (p?: Record<string, unknown>) => Line
+beforeAll(async () => {
+  const m = await import('leafer-ui')
+  MockGroup = m.Group as unknown as new (p?: Record<string, unknown>) => Group
+  MockLine = m.Line as unknown as new (p?: Record<string, unknown>) => Line
+})
+
+const makeEdge = (nodeId: string) => {
+  const group = new MockGroup({})
+  const main = new MockLine({ points: [0, 0, 100, 0], stroke: '#5f6976', strokeWidth: 2 })
+  group.add(main as unknown as TFakeUI)
+  return { group, main, nodeId }
+}
+
+const glowLayers = (group: Group): TFakeUI[] =>
+  (group as unknown as TFakeUI)._children.filter((c) => c.props?.dashPattern !== undefined)
+const activeGlowLayers = (group: Group): TFakeUI[] =>
+  glowLayers(group).filter((c) => !c.removed)
+
+describe('leaferEdgeHoverFx — 6-layer comet dash overlay', () => {
+  let fx: LeaferEdgeHoverFx
+
+  beforeEach(() => { fakeNow = 0; rafCbs = []; nextId = 1; fx = createLeaferEdgeHoverFx({ now: () => fakeNow, raf: fakeRaf, cancelRaf: fakeCancelRaf }) })
+  afterEach(() => { fx.dispose(); vi.unstubAllGlobals() })
+
+  it('enterHover: widens line + creates 6-layer glow', () => {
+    const { group, main, nodeId } = makeEdge('e1')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+
+    expect(rafCbs.length).toBeGreaterThan(0)
+    flushRaf(16)
+    const layers = glowLayers(group)
+    expect(layers.length).toBe(6)
+    const dp = layers[0].props.dashPattern as number[]
+    expect(dp[0]).toBe(100)
+    expect(dp[1]).toBe(160)
+    // Line widened
+    expect((main as unknown as TFakeUI).props.strokeWidth).toBe(6)
+  })
+
+  it('leaveHover: all 6 glow layers removed (no leak)', () => {
+    const { group, main, nodeId } = makeEdge('e2')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    flushRaf(16)
+    expect(activeGlowLayers(group).length).toBe(6)
+    fx.leaveHover(nodeId)
+    expect(activeGlowLayers(group).length).toBe(0)  // all removed
+    expect((main as unknown as TFakeUI).props.strokeWidth).toBe(2)
+  })
+
+  it('LOD entry stops running animation', () => {
+    const { group, main, nodeId } = makeEdge('e3')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    flushRaf(16)
+    const layers = glowLayers(group)
+    fx.updateLod(nodeId, true)
+    expect(layers.every(l => l.removed)).toBe(true)
+  })
+
+  it('dispose cleans up', () => {
+    const { group, main, nodeId } = makeEdge('e4')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    flushRaf(16)
+    expect(() => fx.dispose()).not.toThrow()
+  })
+
+  it('enterHover is idempotent', () => {
+    const { group, main, nodeId } = makeEdge('e5')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    const before = (group as unknown as TFakeUI)._children.length
+    fx.enterHover(nodeId)
+    expect((group as unknown as TFakeUI)._children.length).toBe(before)
+  })
+
+  it('updateSelection starts glow', () => {
+    const { group, main, nodeId } = makeEdge('e6')
+    fx.attachMain(nodeId, group, main)
+    fx.updateSelection(nodeId, true)
+    flushRaf(16)
+    expect(activeGlowLayers(group).length).toBe(6)
+    expect((main as unknown as TFakeUI).props.strokeWidth).toBe(6)
+  })
+
+  // ── 判别钉 1(2026-08-08"两头实心"根因):alpha 必须走元素级 opacity ──
+  // Leafer 没有 strokeOpacity,写了会被静默忽略 → 六层全实心,彗星尾消失。
+  it('层透明度走元素级 opacity(长层淡短层浓),绝不携带 strokeOpacity', () => {
+    const { group, main, nodeId } = makeEdge('e7')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    const layers = glowLayers(group)
+    expect(layers.map((l) => l.props.opacity)).toEqual([0.10, 0.14, 0.18, 0.26, 0.38, 0.55])
+    // 退回 strokeOpacity(被 Leafer 忽略)即红:
+    expect(layers.every((l) => !('strokeOpacity' in l.props))).toBe(true)
+    // 长层淡、短层浓 —— 方向反了会退化成平坦段:
+    const lens = layers.map((l) => (l.props.dashPattern as number[])[0])
+    for (let k = 1; k < lens.length; k++) {
+      expect(lens[k]).toBeLessThan(lens[k - 1])
+      expect(layers[k].props.opacity as number).toBeGreaterThan(layers[k - 1].props.opacity as number)
+    }
+  })
+
+  // ── 判别钉 2(2026-08-08"流向反了"根因):dashOffset 必须随时间递减 ──
+  // canvas2d 语义:offset 增大 = 图案朝路径起点(源图)滑。要源 → 目标流动,
+  // offset 必须递减;符号反了本测试当场红。
+  it('流向:dashOffset 随时间递减(光段向路径终点=目标图移动),各层头部对齐', () => {
+    const { group, main, nodeId } = makeEdge('e8')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    flushRaf(16) // base = 16 × 0.24 = 3.84px
+    const layers = glowLayers(group)
+    const at1 = layers.map((l) => l.props.dashOffset as number)
+    flushRaf(16) // base = 7.68px
+    const at2 = layers.map((l) => l.props.dashOffset as number)
+    for (let k = 0; k < layers.length; k++) {
+      expect(at2[k]).toBeLessThan(at1[k]) // 递减 = 向目标流动(小步进无回绕)
+    }
+    // 头部对齐:同一帧内 (offset + relOff) 对全层同值 → 段头在同一路径位置
+    const relOffs = [0, 22, 42, 60, 76, 89]
+    const heads1 = at1.map((o, k) => Math.round((o + relOffs[k]) * 100) / 100)
+    expect(new Set(heads1).size).toBe(1)
+  })
+
+  // ── 判别钉 3(2026-08-08"点选不中/选中态缺失"):hover ∪ 选中 ──
+  it('选中保持流光:hover 离开不熄灭已选中的边,取消选中才熄灭', () => {
+    const { group, main, nodeId } = makeEdge('e9')
+    fx.attachMain(nodeId, group, main)
+    fx.enterHover(nodeId)
+    fx.updateSelection(nodeId, true)
+    fx.leaveHover(nodeId) // 仍选中 → 不熄灭
+    expect(activeGlowLayers(group).length).toBe(6)
+    expect((main as unknown as TFakeUI).props.strokeWidth).toBe(6)
+    fx.updateSelection(nodeId, false) // 取消选中 → 熄灭
+    expect(activeGlowLayers(group).length).toBe(0)
+    expect((main as unknown as TFakeUI).props.strokeWidth).toBe(2)
+  })
+
+  // ── PR-B 判别钉:glowColor() 只在 createGlows() 里定色一次(:149) ──
+  // glow 层存活期间(hover 中,或选中期间——可以无限长)不会自己跟着主题变;
+  // refreshThemeColor() 是补上的触发链出口,由已经把 theme 接进依赖数组的
+  // useLeaferSpikeRenderer 渲染 effect 调用(不是 tick() 里逐帧 getComputedStyle)。
+  it('refreshThemeColor():重读 --edge-glow-color 并应用到当前活跃 glow 层', () => {
+    const { group, main, nodeId } = makeEdge('e10')
+    fx.attachMain(nodeId, group, main)
+
+    vi.stubGlobal('document', { documentElement: { getAttribute: () => null } })
+    vi.stubGlobal('getComputedStyle', () => ({
+      getPropertyValue: (name: string) => (name === '--edge-glow-color' ? '#111111' : ''),
+    }))
+
+    fx.enterHover(nodeId)
+    flushRaf(16)
+    const before = activeGlowLayers(group)
+    expect(before.length).toBe(6)
+    expect(before.every((l) => l.props.stroke === '#111111')).toBe(true)
+
+    // 主题切换的可观测后果:CSS 变量的计算值变了(真实级联由 App.css 的
+    // [data-mivo-theme='dark'] 选择器完成;这里直接改级联后的最终值,断言的是
+    // "触发路径把新色应用到活跃层"这条链路,不是 CSS 级联本身)。
+    vi.stubGlobal('getComputedStyle', () => ({
+      getPropertyValue: (name: string) => (name === '--edge-glow-color' ? '#222222' : ''),
+    }))
+    fx.refreshThemeColor()
+
+    const after = activeGlowLayers(group)
+    expect(after.length).toBe(6) // 同一批层原地改色,不是销毁重建
+    expect(after.every((l) => l.props.stroke === '#222222')).toBe(true)
+  })
+
+  it('refreshThemeColor():没有活跃 glow 时是 no-op(不抛错)', () => {
+    const { group, main, nodeId } = makeEdge('e11')
+    fx.attachMain(nodeId, group, main)
+    expect(() => fx.refreshThemeColor()).not.toThrow()
+    expect(activeGlowLayers(group).length).toBe(0)
+  })
+
+  // ── SC-B1(blocker):LOD 门控与用户意图分离,进出天然对称 ──
+  // 旧 bug:进 LOD 分支直接把节点从 hoveredIds/selectedIds 里删,退出分支没有
+  // 对应的 restore——选中一条连线、缩小穿过 LOD 门限、再放大回来,流光永久
+  // 消失(useDerivationEdgeHover 只在 selectedNodeIds prop 变化时 diff 通知
+  // fx.updateSelection,选区本身没变就永不重新调用,fx 内部丢的状态没人补)。
+  // 现在 lodIds 是独立的门控集,hoveredIds/selectedIds 全程不受 LOD 影响。
+  it('选中后进出 LOD:流光恢复(不变量:选中态在 LOD 期间必须保持,退出后自动恢复,不经过 updateSelection)', () => {
+    const { group, main, nodeId } = makeEdge('e12')
+    fx.attachMain(nodeId, group, main)
+    fx.updateSelection(nodeId, true)
+    flushRaf(16)
+    expect(activeGlowLayers(group).length).toBe(6)
+
