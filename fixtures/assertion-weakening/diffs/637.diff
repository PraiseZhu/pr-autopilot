+// @vitest-environment happy-dom
+// App 上层协调接线(升级阶梯② / SC-3)——相机 deferred 池生命周期移交 App。
+//
+// 为什么拆两层验证:
+// 1. 纯函数层:selectLiveCanvasIds 是可测的确定性纯函数(live 判据与 UI
+//    matchesView 同源:`status !== 'archived'` 为 active,缺省/undefined 视为 active,
+//    删除的画布键不在集合里)。
+// 2. 接线层:渲染整个 <App /> 会拉起 useStoreHydration 的 IDB persist 水合
+//    (fake-indexeddb 不在测试依赖里),成本高且与接线本身无关。沿用
+//    main.e2eBridge.test.ts 的源码级门禁先例(`?raw` + 去注释后断言源码形状),
+//    锁住「App 的 effect 真的调用 reconcile(selectLiveCanvasIds(canvases)),
+//    且依赖数组含 canvases」——删掉接线(变异 1)或改依赖数组,本文件必红。
+import { describe, expect, it } from 'vitest'
+import AppSource from './App.tsx?raw'
+import { selectLiveCanvasIds } from './app/sidebar/projectSidebarModel'
+import type { CanvasDocument } from './types/mivoCanvas'
+
+// 纯函数来自 projectSidebarModel(纯 TS,无 leafer 模块图),静态 import 安全。
+// 接线层不渲染 <App />(会拉起 useStoreHydration 的 IDB persist 水合,且 App 模块图
+// 顶层 import leafer-ui——leafer 模块顶层执行 canvasPatch(CanvasRenderingContext2D/
+// Path2D.prototype),happy-dom 没有这些全局)——用 `?raw` 源码做静态断言,与
+// main.e2eBridge.test.ts 的源码级门禁同一先例。
+
+const doc = (overrides: Partial<CanvasDocument> = {}): CanvasDocument => ({
+  title: 't',
+  createdAt: '2026-01-01T00:00:00.000Z',
+  updatedAt: '2026-01-01T00:00:00.000Z',
+  nodes: [],
+  edges: [],
+  tasks: [],
+  ...overrides,
+})
+
+describe('selectLiveCanvasIds(纯函数,SC-3)', () => {
+  it('archived 排除;active 与缺省 status(undefined)保留(与 UI matchesView 同判据)', () => {
+    const canvases: Record<string, CanvasDocument> = {
+      'live-active': doc({ status: 'active' }),
+      'live-default': doc({}),
+      'archived-c': doc({ status: 'archived' }),
+      'live-again': doc({ status: 'active' }),
+    }
+    expect(selectLiveCanvasIds(canvases).sort()).toEqual(['live-active', 'live-again', 'live-default'])
+  })
+
+  it('空对象 → 空数组', () => {
+    expect(selectLiveCanvasIds({})).toEqual([])
+  })
+
+  it('返回只含 id,不含文档本体;不依赖对象键序(乱序对象输出等价的 id 集合)', () => {
+    const canvases: Record<string, CanvasDocument> = {
+      '10': doc({ status: 'active' }),
+      '2': doc({ status: 'active' }),
+      '7': doc({ status: 'archived' }),
+    }
+    const ids = selectLiveCanvasIds(canvases)
+    expect(ids).toHaveLength(2)
+    expect(ids.every((id) => typeof id === 'string' && id.length > 0)).toBe(true)
+    expect([...ids].sort()).toEqual(['10', '2'])
+  })
+})
+
+// ── 接线层(静态):effect 必须真的调用 reconcile,不能只有纯函数没人消费 ──
+//
+// 为什么不用正则:旧门禁 /useEffect\(\(\)\s*=>\s*\{[\s\S]*?reconcile...[\s\S]*?\},\s*\[([^\]]*)\]\)/
+// 的 [\s\S]*? 可以跨任意 useEffect 边界——把真实调用移进一个未调用 callback、另留
+// 空 useEffect(() => {}, [canvases]),正则仍可从更早 effect 的开头跨到调用、再跨到
+// 空 effect 的依赖数组,测试假绿:它只证明文件里同时出现了几个 token,不证明生产接线。
+// 本门禁用 TypeScript AST 解析(与 menuOverlayStack.contract.test.ts 同一先例),
+// 节点边界由语法树决定:要求「同一个 useEffect 调用」的 callback 体内含
+// reconcile(selectLiveCanvasIds(canvases)) 调用,且「同一个调用节点」的第二参数
+// 数组字面量含 canvases 标识符——跨块借 token 在 AST 上不可达。
+import ts from 'typescript'
+
+// ── 精确 AST 谓词 + 词法绑定解析(拒绝四类假绿) ──
+//
+// 门禁语义:App 组件函数体顶层可执行路径上,存在一条 useEffect 调用,其 callback
+// 顶层可执行路径上恰好有一条 useCameraFocusStore.getState().
+// reconcileDeferredFocusScenes(selectLiveCanvasIds(canvases)) 精确语句,且同一调用
+// 节点的依赖数组含绑定到 App 顶层 canvases 的标识符。
+//
+// 三条 P1 修复(相对于上一版):
+// 1. 收集范围 App 化:collectUseEffects 不再无条件递归 sourceFile 所有后代——整个
+//    useEffect 移进「从未调用」的嵌套函数时 React 永不注册/执行,全树收集仍会收到
+//    它并放行。现改为只定位顶层 function App,对其 body 走 walkExecutable(进入
+//    if/for/try 等控制流容器,但永远不跨嵌套函数/class 边界),收集阶段即跳过
+//    嵌套作用域,App 自身是唯一 root 例外。
+// 2. 标识符词法绑定:receiver/selector/deps 不再只比 identifier.text——App body
+//    块内可声明同名局部 shadow(fake store/selector/canvases),精确文本形状仍假绿。
+//    现沿 identifier 祖先链由内向外找「最近同名声明」(Block/函数参数/循环变量/
+//    catch/模块级 import 均覆盖),要求:store 标识符绑定到顶层
+//    import { useCameraFocusStore } from './store/cameraFocusStore';selector 标识符
+//    绑定到顶层 import { selectLiveCanvasIds } from './app/sidebar/projectSidebarModel';
+//    canvases(参数与 deps)绑定到 App body 顶层的 const canvases = useCanvasStore(...)
+//    VariableDeclaration。任何作用域内的同名重声明(变量/参数/function/import
+//    alias/块内 const)都是最近声明 → 拒绝。
+// 3. 根声明本身的来源/初始化器校验(P1-3):词法绑定只保证「最近同名声明」,不保证
+//    该声明是真的。假绿 #1:App body const useEffect = () => {} shadow React,收集
+//    只看 callee 文本;假绿 #2/#3:import { fakeStore as useCameraFocusStore } 的
+//    local 名与真导入相同,resolveBindings 只看 local 名 + module path;假绿 #4:
+//    let canvases = {} as never 与真声明同名。修复:ImportSpecifier 一律按原
+//    export 名(propertyName ?? name)匹配(useEffect→react / useCameraFocusStore→
+//    ./store/cameraFocusStore / selectLiveCanvasIds→./app/sidebar/projectSidebarModel /
+//    useCanvasStore→./store/canvasStore);canvases 要求 const + 精确
+//    useCanvasStore((state) => state.canvases) 初始化器(callee 再经 bindingFor
+//    回链到 useCanvasStore 导入);effect 收集要求 callee 词法绑定到 react 导入的
+//    useEffect ImportSpecifier。任一期望绑定缺失,下游短路比较 fail-closed。
+//
+// 结构性重构(裹函数/换 receiver/套容器/删 deps/块内 shadow/fake 根声明)全部显式红,
+// 维护者同步更新测试,而不是门退化成 token 搜索。
+
+// 嵌套函数/类型边界:进入这些节点 = 进入一段不会在 effect 顶层直接执行的作用域,
+// 必须跳过(否则「定义但从不调用」的函数、class 方法里的调用会被认成接线)。
+const isFunctionBoundary = (node: ts.Node): boolean =>
+  ts.isArrowFunction(node) ||
+  ts.isFunctionExpression(node) ||
+  ts.isFunctionDeclaration(node) ||
+  ts.isMethodDeclaration(node) ||
+  ts.isConstructorDeclaration(node) ||
+  ts.isGetAccessorDeclaration(node) ||
+  ts.isSetAccessorDeclaration(node) ||
+  ts.isClassDeclaration(node) ||
+  ts.isClassExpression(node)
+
+// 遍历「顶层可执行路径」:visit 每个节点,但 forEachChild 下钻时跳过函数边界。
+// if/else/try/catch 等控制流容器照常进入(块内直接执行算接线),嵌套函数体不可达。
+const walkExecutable = (node: ts.Node, visit: (n: ts.Node) => void): void => {
+  visit(node)
+  ts.forEachChild(node, (child) => {
+    if (!isFunctionBoundary(child)) walkExecutable(child, visit)
+  })
+}
+
+// ── 词法绑定解析(P1-2):identifier → 最近同名声明的声明节点 ──
+//
+// 作用域容器与其中的声明:
+// - Block(含函数体):块内 VariableStatement/FunctionDeclaration/ClassDeclaration;
+//   若该块是函数体,函数参数(可能 shadow 外层名字)也算此作用域。
+// - SourceFile:顶层 VariableStatement/FunctionDeclaration/ClassDeclaration +
+//   命名导入 ImportSpecifier(import { a as b } 时局部名是 b)。
+// - For/ForOf:循环变量声明列表;CatchClause:catch 绑定。ForIn 不解构(TS2491),
+//   declaredInScope 不认 ForIn 为声明容器。
+// 查找从 identifier 沿 parent 向上,对每个作用域容器检查同名声明;命中即返回
+// (最近者优先),无则继续上一层。TDZ(声明在引用之后)不豁免——静态上同作用域
+// 同名声明就是 shadow,对「拒绝重声明」的判据取更严格侧。
+// P1-4(binding pattern):声明名不止 Identifier——VariableDeclaration/Parameter/
+// Catch/For 的 name 可以是解构 BindingName。旧实现只认 Identifier,`const { useEffect }
+// = ...` 类的解构 shadow 找不到最近声明,identifier 错误回落模块 import/App 外层
+// 变量,countWiredEffects 仍 1 假绿。统一走 bindingNameContains 递归查局部绑定名。
+
+// 递归 binding-name 查找:一个 ts.BindingName(标识符/对象/数组解构 pattern)是否
+// 声明了局部名 name。覆盖:
+// - 标识符:const x / (x) / catch (x) → 直接比文本
+// - 对象解构:const {x: useEffect} / {useEffect} / {...rest} → 局部绑定名是
+//   element.name——与 propertyName 无关,别名 {fake: useEffect} 的局部名仍是
+//   useEffect,而 {useEffect: fake} 局部名是 fake;rest 元素的局部名也是
+//   element.name。
+// - 数组解构:const [useEffect] / [, useEffect] / [...rest] → 对应 element.name;
+//   OmittedExpression(空位)跳过。
+// - 嵌套:{a: {b: [x]}} → element.name 本身可以是嵌套 pattern,递归进入。
+// 命中只回答「是否声明」;返回的声明容器(节点 identity)由调用方决定,保持与
+// 旧 Identifier-only 路径一致(VariableDeclaration / ParameterDeclaration /
+// CatchVariableDeclaration),resolveBindings 的 `===` 绑定比较不受影响。
+const bindingNameContains = (bindingName: ts.BindingName, name: string): boolean => {
+  if (ts.isIdentifier(bindingName)) return bindingName.text === name
+  for (const el of bindingName.elements) {
+    if (ts.isOmittedExpression(el)) continue
+    if (bindingNameContains(el.name, name)) return true
+  }
+  return false
+}
+
+// statements 中声明了局部名 name 的语句:变量声明(含解构 BindingName)、函数
+// 声明、类声明。Block 与 SourceFile 两个作用域分支共用同一扫描(/simplify 收敛
+// 出的重复);import 不在此列——SourceFile 的 import 扫描留在 declaredInScope,
+// 按语句顺序与块内声明竞争「最近声明」(见下)。
+const findStatementDeclaration = (
+  statements: readonly ts.Statement[],
+  name: string,
+): ts.Declaration | undefined => {
+  for (const stmt of statements) {
+    if (ts.isVariableStatement(stmt)) {
+      for (const d of stmt.declarationList.declarations) {
+        if (bindingNameContains(d.name, name)) return d
+      }
+    } else if (ts.isFunctionDeclaration(stmt) && stmt.name?.text === name) {
+      return stmt
+    } else if (ts.isClassDeclaration(stmt) && stmt.name?.text === name) {
+      return stmt
+    }
+  }
+  return undefined
+}
+
+const declaredInScope = (node: ts.Node, name: string): ts.Declaration | undefined => {
+  if (ts.isBlock(node)) {
+    const found = findStatementDeclaration(node.statements, name)
+    if (found) return found
+    // 函数体块:参数与块内声明同一函数作用域,参数也可 shadow 外层。
+    if (ts.isFunctionLike(node.parent)) {
+      for (const p of node.parent.parameters) {
+        if (bindingNameContains(p.name, name)) return p
+      }
+    }
+    return undefined
+  }
+  if (ts.isSourceFile(node)) {
+    // import 与块内声明同属模块作用域,按语句顺序竞争「最近声明」:逐句先查
+    // 声明再查 import,保持原单趟按序语义(先扫声明后扫 import 会把排在同名
+    // 声明之前的 import 错序)。
+    for (const stmt of node.statements) {
+      const found = findStatementDeclaration([stmt], name)
+      if (found) return found
+      if (ts.isImportDeclaration(stmt) && ts.isStringLiteral(stmt.moduleSpecifier)) {
+        const named = stmt.importClause?.namedBindings
+        if (named && ts.isNamedImports(named)) {
+          for (const el of named.elements) {
+            if (el.name.text === name) return el
+          }
+        }
+      }
+    }
+    return undefined
+  }
+  if (ts.isForStatement(node) && node.initializer && ts.isVariableDeclarationList(node.initializer)) {
+    for (const d of node.initializer.declarations) {
+      if (bindingNameContains(d.name, name)) return d
+    }
+    return undefined
+  }
+  if (ts.isForOfStatement(node) && ts.isVariableDeclarationList(node.initializer)) {
+    for (const d of node.initializer.declarations) {
+      if (bindingNameContains(d.name, name)) return d
+    }
+    return undefined
+  }
+  if (ts.isCatchClause(node) && node.variableDeclaration) {
+    return bindingNameContains(node.variableDeclaration.name, name) ? node.variableDeclaration : undefined
+  }
+  return undefined
+}
+
+const bindingFor = (id: ts.Identifier): ts.Declaration | undefined => {
+  let current: ts.Node | undefined = id.parent
+  while (current) {
+    const decl = declaredInScope(current, id.text)
+    if (decl) return decl
+    current = current.parent
+  }
+  return undefined
+}
+
+// 期望绑定的真相源(每次解析新 sourceFile 重取,变异文件与真源各自独立):
+// store/selector 必须是模块级指定路径的命名导入,且按「原 export 名」匹配——
+// import { fakeStore as useCameraFocusStore } 的 local 名再像也不是真 store
+// (propertyName 才是原 export 名);useEffect 必须是 react 模块的命名导入(支持
+// import { useEffect as e } + 调用 e(),原 export 名 useEffect 即真);useCanvasStore
+// 必须是 ./store/canvasStore 的命名导入;canvases 必须是 App body 顶层的
+// const canvases = useCanvasStore((state) => state.canvases) VariableDeclaration
+// (非 const / 非该初始化器的同名声明一律不认)。任一期望绑定缺失时,下游所有
+// 短路比较以 undefined 侧 fail-closed,不允许 undefined === undefined 碰巧通过。
+interface AppBindings {
+  useEffect: ts.ImportSpecifier | undefined
+  store: ts.ImportSpecifier | undefined
+  selector: ts.ImportSpecifier | undefined
+  useCanvasStore: ts.ImportSpecifier | undefined
+  canvases: ts.VariableDeclaration | undefined
+}
+
+// canvases 初始化器必须精确 useCanvasStore((state) => state.canvases):callee 词法
+// 绑定到 ./store/canvasStore 的 useCanvasStore 导入;恰好一个参数,参数名 state,
+// body 是 state.canvases 属性访问。useCanvasStore 绑定缺失即 fail-closed(false)。
+const isExactCanvasInit = (init: ts.Expression | undefined, useCanvasStore: ts.ImportSpecifier | undefined): boolean => {
+  if (!init || !useCanvasStore) return false
+  if (!ts.isCallExpression(init)) return false
+  if (!ts.isIdentifier(init.expression) || init.expression.text !== 'useCanvasStore') return false
+  if (bindingFor(init.expression) !== useCanvasStore) return false
+  if (init.arguments.length !== 1) return false
+  const arg = init.arguments[0]
+  if (!ts.isArrowFunction(arg) || arg.parameters.length !== 1) return false
+  const p = arg.parameters[0]
+  if (!ts.isIdentifier(p.name) || p.name.text !== 'state') return false
+  if (!ts.isPropertyAccessExpression(arg.body) || arg.body.name.text !== 'canvases') return false
+  const stateId = arg.body.expression
+  return ts.isIdentifier(stateId) && stateId.text === 'state'
+}
+
+const resolveBindings = (sf: ts.SourceFile): AppBindings => {
+  let useEffect: ts.ImportSpecifier | undefined
+  let store: ts.ImportSpecifier | undefined
+  let selector: ts.ImportSpecifier | undefined
+  let useCanvasStore: ts.ImportSpecifier | undefined
+  let canvases: ts.VariableDeclaration | undefined
+  for (const stmt of sf.statements) {
+    if (ts.isImportDeclaration(stmt) && ts.isStringLiteral(stmt.moduleSpecifier)) {
+      const mod = stmt.moduleSpecifier.text
+      const named = stmt.importClause?.namedBindings
+      if (named && ts.isNamedImports(named)) {
+        for (const el of named.elements) {
+          // 只认原 export 名(propertyName ?? name):fake export alias 成真实 local
+          // 名(假绿 #2/#3)在此被排除,绑定保持 undefined → 下游 fail-closed。
+          const exported = el.propertyName?.text ?? el.name.text
+          if (exported === 'useEffect' && mod === 'react') useEffect = el
+          if (exported === 'useCameraFocusStore' && mod === './store/cameraFocusStore') store = el
+          if (exported === 'selectLiveCanvasIds' && mod === './app/sidebar/projectSidebarModel') selector = el
+          if (exported === 'useCanvasStore' && mod === './store/canvasStore') useCanvasStore = el
+        }
+      }
+    }
+  }
+  const app = sf.statements.find(
+    (s): s is ts.FunctionDeclaration => ts.isFunctionDeclaration(s) && s.name?.text === 'App',
+  )
+  for (const stmt of app?.body?.statements ?? []) {
+    // canvases 必须 const + 精确 useCanvasStore((state) => state.canvases) 初始化
+    // (假绿 #4:let canvases = {} as never 名称相同但声明语义全错,不认)。
+    if (ts.isVariableStatement(stmt) && (stmt.declarationList.flags & ts.NodeFlags.Const) !== 0) {
+      for (const d of stmt.declarationList.declarations) {
+        if (ts.isIdentifier(d.name) && d.name.text === 'canvases' && isExactCanvasInit(d.initializer, useCanvasStore)) {
+          canvases = d
+        }
+      }
+    }
+  }
+  return { useEffect, store, selector, useCanvasStore, canvases }
+}
+
+// receiver 精确绑定:useCameraFocusStore.getState().reconcileDeferredFocusScenes。
+// TS 语法树里 `a.b().c` 是 PropertyAccess(Call(PropertyAccess(a, b)), c)——外层
+// .reconcileDeferredFocusScenes 的表达式是「调用 getState() 的 CallExpression」,
+// 不是属性访问。逐层比对:方法名 → getState() 调用 → getState 属性 → store
+// 标识符(且必须词法绑定到顶层 cameraFocusStore 导入),缺一层或形状不符(如 fake
+// 对象直接 .reconcileDeferredFocusScenes)都拒绝。
+const isExactReconcileReceiver = (expr: ts.Expression, bindings: AppBindings): boolean => {
+  if (!ts.isPropertyAccessExpression(expr) || expr.name.text !== 'reconcileDeferredFocusScenes') return false
+  const getStateCall = expr.expression
+  if (!ts.isCallExpression(getStateCall)) return false
+  const getStateAccess = getStateCall.expression
+  if (!ts.isPropertyAccessExpression(getStateAccess) || getStateAccess.name.text !== 'getState') return false
+  const storeId = getStateAccess.expression
+  return !!bindings.store && ts.isIdentifier(storeId) && bindingFor(storeId) === bindings.store
+}
+
+// firstArg 精确绑定:selectLiveCanvasIds(canvases)——调用名(词法绑定到顶层
+// projectSidebarModel 导入)+ 恰好一个 Identifier(词法绑定到 App 顶层 canvases)。
+// 不做子树搜索,后代里的同名 token(decoy 容器)一律拒绝;块内同名 shadow 拒绝。
+const isExactSelectorArg = (arg: ts.Expression, bindings: AppBindings): boolean => {
+  if (!ts.isCallExpression(arg)) return false
+  if (!ts.isIdentifier(arg.expression) || arg.expression.text !== 'selectLiveCanvasIds') return false
+  if (!bindings.selector || bindingFor(arg.expression) !== bindings.selector) return false
+  if (arg.arguments.length !== 1) return false
+  const only = arg.arguments[0]
+  return !!bindings.canvases && ts.isIdentifier(only) && only.text === 'canvases' && bindingFor(only) === bindings.canvases
+}
+
+// 精确接线语句:顶层可执行路径上的 ExpressionStatement,其表达式必须整棵精确
+// 等于 useCameraFocusStore.getState().reconcileDeferredFocusScenes(selectLiveCanvasIds(canvases)),
+// 且三个标识符都词法绑定到期望声明。
+const isExactWiringStatement = (node: ts.Node, bindings: AppBindings): boolean => {
+  if (!ts.isExpressionStatement(node)) return false
+  const call = node.expression
+  if (!ts.isCallExpression(call)) return false
+  if (!isExactReconcileReceiver(call.expression, bindings)) return false
+  if (call.arguments.length !== 1) return false
+  return isExactSelectorArg(call.arguments[0], bindings)
+}
+
+// 判定一个 useEffect 调用是否携带完整接线:callback body 顶层可执行路径上存在
+// 精确接线语句,且同一调用节点的依赖数组含绑定到 App 顶层 canvases 的标识符。
+const isWiredEffect = (call: ts.CallExpression, bindings: AppBindings): boolean => {
+  const callback = call.arguments[0]
+  if (!callback || (!ts.isArrowFunction(callback) && !ts.isFunctionExpression(callback))) return false
+  if (!callback.body) return false
+  let wired = false
+  walkExecutable(callback.body, (node) => {
+    if (!wired && isExactWiringStatement(node, bindings)) wired = true
+  })
+  if (!wired) return false
+  const deps = call.arguments[1]
+  return (
+    !!deps &&
+    ts.isArrayLiteralExpression(deps) &&
+    !!bindings.canvases &&
+    deps.elements.some((el) => ts.isIdentifier(el) && el.text === 'canvases' && bindingFor(el) === bindings.canvases)
+  )
+}
+
+// 只收集「App 组件函数体顶层可执行路径」上的 useEffect(P1-1):先定位顶层
+// function App,再对其 body 走 walkExecutable——嵌套函数/class 边界在收集阶段就
+// 跳过(整个 effect 移进未调用嵌套函数时 React 永不注册,不得计入),App 自身是
+// 唯一 root 例外。找不到 App 函数 = fail-closed(返回空,不猜)。
+// P1-3(根绑定 exact):callee 标识符必须词法绑定到 SourceFile 顶层 react 导入的
+// useEffect ImportSpecifier——App body 里 const useEffect = () => {} shadow(假绿 #1)
+// 后最近同名声明是局部变量,文本相同也不收集;bindings.useEffect 缺失即
+// fail-closed(空绑定不收集任何调用)。原 export 名校验在 resolveBindings,
+// local 名不限:import { useEffect as e } + 调用 e() 的真实形态照常收集。
+const collectAppUseEffects = (sourceFile: ts.SourceFile, out: ts.CallExpression[], bindings: AppBindings): void => {
+  const app = sourceFile.statements.find(
+    (s): s is ts.FunctionDeclaration => ts.isFunctionDeclaration(s) && s.name?.text === 'App',
+  )
+  if (!app?.body) return
+  walkExecutable(app.body, (node) => {
+    if (ts.isCallExpression(node) && ts.isIdentifier(node.expression)) {
+      if (bindings.useEffect && bindingFor(node.expression) === bindings.useEffect) out.push(node)
+    }
+  })
+}
