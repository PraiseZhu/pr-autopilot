+// 变异反例与真源共用入口:喂任意 App.tsx 源码字符串,返回被认作完整接线的
+// useEffect 数量。变异测试断言 = 0(新门必须拒绝),真源断言 > 0。
+const countWiredEffects = (source: string): number => {
+  const sourceFile = ts.createSourceFile('App.tsx', source, ts.ScriptTarget.Latest, /* setParentNodes */ true)
+  const bindings = resolveBindings(sourceFile)
+  const effects: ts.CallExpression[] = []
+  collectAppUseEffects(sourceFile, effects, bindings)
+  return effects.filter((call) => isWiredEffect(call, bindings)).length
+}
