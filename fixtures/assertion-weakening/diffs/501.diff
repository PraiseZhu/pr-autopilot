--- /dev/null
+++ b/scripts/loops/bug-doctor/reconcile-merged.mjs
@@ -0,0 +1,306 @@
+#!/usr/bin/env node
+// reconcile-merged.mjs — loop PR 合并后对账器(缴械配套,owner 2026-08-04 决策;三审 R1-R9 修订)。
+// bug-doctor 不再自动合并(mergeAuthority=review-pr-only),loop PR 由 review-pr 巡审合并;本脚本
+// 接替旧「6.5 T1 合并后兜底」,做与合并主体无关的确定性对账。职责(全部幂等):
+//   1. 带 pr 号且未收敛的簇查 gh 终态:MERGED→fixed(记 mergeSha/mergedBy='review-pr',合并主体
+//      语义非 GitHub actor);CLOSED→closed-unmerged(可重开);OPEN→不动。
+//   2. 新 mergeOID 在「本地干净树已含该 OID」时核验 main 健康并落终态(green/red);HEAD 未含/树脏/期间 HEAD 变/
+//      配额用尽(MAX_PREFLIGHT_PER_RUN)→ pending-tree 挂账重试,**仅「HEAD 未含」这类滞留超 24h 才发一次性 T0**(另三类静默挂账不告警);红 → revert-required + T0。
+//      终态按 RESULT_RANK 单调:已落盘的强结论不被弱结论覆盖(red 为吸收态)。
+//   3. 并发:持 gate 同一把 gate.lock(占用即让路);锁内只做同步事务(运行时强制;实测量级毫秒,同步 IO 无硬上界),慢工全在锁外 → 常态下活锁不被当陈锁收尸(极端:同步 IO 长时停顿致持锁超 TTL 仍可被接管,见 PR 残余登记)。
+//   4. SLA:patrol 每小时调用(gate 成功后串行,best-effort);对账与核验都按 backlog 逐轮消化(每轮上限
+//      分别为 MAX_PR_QUERIES_PER_RUN / MAX_PREFLIGHT_PER_RUN),**均不承诺固定时限**(撞锁/gate 占用/gh
+//      失败都会延后)。无饥饿的机制两侧不同:对账侧靠持久游标环绕轮转(未收敛 PR 保持 OPEN 时不会离开
+//      待查集,故必须有游标);核验侧不需要游标——跑过的项 preflight 落 green/red 即离开 pending-tree
+//      队列,而 HEAD 未含的项根本不消耗配额。**改动 queue 的 filter 前请先想清这条**。
+// 退出码:0=完成/无事可做/锁占用跳过;1=对账出错(gh 全挂/锁被接管/sidecar 损坏);2=参数错误
+
+import { spawnSync } from 'node:child_process'
+import { existsSync, readFileSync, writeFileSync, renameSync } from 'node:fs'
+import { join, resolve, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { loadNotifyConfig, sendAlert, appendPendingAlert } from './notify.mjs'
+import { loadState, saveState, acquireLock, releaseLock, STATE_FILE } from './state.mjs'
+import { FINGERPRINT_VERSION } from './fingerprint.mjs'
+
+const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url))
+const REPO_ROOT = resolve(SCRIPT_DIR, '..', '..', '..')
+export const RECONCILE_STATE_FILE = 'reconcile-state.json' // 与 state.json 解耦(SC-BD1-R2-N01:对账器记账不能危及主台账)
+// TTL 取权威源 rules.json loop.lockTtlMinutes(gate/intake 同一值):本地写死会在权威值调小后让 gate 提前收尸本进程活锁
+const lockTtlMinutes = () => {
+  try {
+    const t = JSON.parse(readFileSync(join(SCRIPT_DIR, 'rules.json'), 'utf8'))?.loop?.lockTtlMinutes
+    return Number.isFinite(t) && t > 0 ? t : 60
+  } catch { return 60 }
+}
+// 结果单调性:red 是吸收态,已落盘结论不得被并发旧队列的弱结论降级(R10 CX-R1-016:并发时 green 会抹掉 red)
+const RESULT_RANK = { 'pending-tree': 0, skipped: 1, green: 2, red: 3 }
+const PENDING_TREE_ALERT_HOURS = 24 // 滞留超此未核验 → 一次性 T0(监控 git pull 停摆)
+// 慢工的挂死上限(与锁无关——慢工全在锁外,见 withLock):只兜单轮墙钟与 API 用量
+export const GH_TIMEOUT_MS = 60_000
+export const MAX_PR_QUERIES_PER_RUN = 10
+export const MAX_PREFLIGHT_PER_RUN = 2
+export const PREFLIGHT_TIMEOUT_MS = 1_800_000
+
+const log = (msg) => process.stderr.write(`[mivo:reconcile] ${msg}\n`)
+
+const parseArgs = (argv) => {
+  const args = {}
+  for (let i = 0; i < argv.length; i += 1) {
+    const a = argv[i]
+    if (a === '--state-dir') args['state-dir'] = argv[++i]
+    else if (a === '--input-prs') args['input-prs'] = argv[++i]
+    else if (a === '--no-gh') args['no-gh'] = true
+    else if (a === '--no-preflight') args['no-preflight'] = true
+    else if (a === '--json-out') args['json-out'] = true
+    else {
+      process.stderr.write(`未知参数: ${a}\n`)
+      process.exit(2)
+    }
+  }
+  return args
+}
+
+// 临界区闸:回调必须同步(运行时强制)。R6-R8 三轮枚举「持锁上界=子阶段之和」每轮都漏项
+// (preflight→gh→pending queue/告警),根因是持锁时干慢活;改为慢工全在锁外,不再算上界。
+export const withLock = (stateDir, fn) => {
+  const lock = acquireLock(stateDir, { ttlMinutes: lockTtlMinutes(), owner: 'reconcile' })
+  if (!lock.acquired) return { acquired: false, holder: lock.holder }
+  try {
+    const value = fn()
+    // 惯例不够,运行时强制(R9 席① F16):返回 thenable 说明锁内有异步慢工,直接炸
+    if (value && typeof value.then === 'function') throw new Error('withLock 回调必须同步:锁内禁止 await 慢工')
+    return { acquired: true, value }
+  } finally {
+    const release = releaseLock(stateDir, { token: lock.token })
+    if (!release.ok) log(`releaseLock 失败(${release.reason}),锁将由 TTL 自愈`)
+  }
+}
+
+// 仅 tracked:脏树验证的不是 HEAD 内容,不得绑定 OID(CX-R1-001)
+const treeDirty = () => (spawnSync('git', ['status', '--porcelain', '-uno'], { encoding: 'utf8', cwd: REPO_ROOT }).stdout || '').trim() !== ''
+
+export const loadReconcileState = (stateDir) => {
+  const p = join(stateDir, RECONCILE_STATE_FILE)
+  if (!existsSync(p)) return { schemaVersion: 1, verifiedMergeOids: {}, queryCursorPr: 0 }
+  try {
+    const parsed = JSON.parse(readFileSync(p, 'utf8'))
+    if (parsed.schemaVersion !== 1) throw new Error(`reconcile-state schemaVersion=${parsed.schemaVersion} 不识别`)
+    // queryCursorPr 必须显式带出:本函数只返回白名单字段,漏列即每轮读回 0、游标形同不存在
+    return { schemaVersion: 1, verifiedMergeOids: parsed.verifiedMergeOids || {}, queryCursorPr: Number.isInteger(parsed.queryCursorPr) ? parsed.queryCursorPr : 0 }
+  } catch (err) {
+    // fail-visible:不静默重建(会丢 revert-required 未决记录),抛给调用方
+    throw new Error(`reconcile-state.json 损坏: ${err.message}`)
+  }
+}
+
+const saveReconcileState = (stateDir, st) => {
+  const p = join(stateDir, RECONCILE_STATE_FILE)
+  const tmp = `${p}.tmp-${process.pid}`
+  writeFileSync(tmp, `${JSON.stringify(st, null, 2)}\n`)
+  renameSync(tmp, p)
+}
+
+/** 纯函数:pending-tree 记录滞留超阈值返回滞留毫秒数,否则 null(可单测)。 */
+export const stalePendingAgeMs = (rec, nowMs, thresholdHours = PENDING_TREE_ALERT_HOURS) => {
+  if (!rec || rec.preflight !== 'pending-tree') return null
+  const t = Date.parse(rec.at)
+  if (!Number.isFinite(t)) return null
+  const age = nowMs - t
+  return age > thresholdHours * 3_600_000 ? age : null
+}
+
+/** 纯函数:给定簇集合与 PR 终态查询结果,算出台账变更集(不落盘,可单测)。 */
+export const planReconciliation = (clusters, prStates) => {
+  const changes = []
+  for (const [fp, c] of Object.entries(clusters ?? {})) {
+    const pr = Number(c.pr)
+    if (!pr || Number.isNaN(pr)) continue
+    if (c.status === 'fixed' || c.status === 'closed-unmerged') continue
+    const ps = prStates[pr]
+    if (!ps) continue // 查不到 = 本轮不动(gh 失败按失败计,不当 closed 处理)
+    if (ps.state === 'MERGED' && ps.mergeSha) {
+      changes.push({ fp, pr, to: 'fixed', mergeSha: ps.mergeSha, mergedAt: ps.mergedAt || null })
+    } else if (ps.state === 'CLOSED') {
+      changes.push({ fp, pr, to: 'closed-unmerged' })
+    }
+  }
+  return changes
+}
+
+const ghPrState = (pr) => {
+  const run = spawnSync('gh', ['pr', 'view', String(pr), '--json', 'state,mergeCommit,mergedAt'], {
+    encoding: 'utf8', cwd: REPO_ROOT, timeout: GH_TIMEOUT_MS,
+  })
+  if (run.status !== 0) return null
+  try {
+    const d = JSON.parse(run.stdout)
+    return { state: d.state, mergeSha: d.mergeCommit?.oid || null, mergedAt: d.mergedAt || null }
+  } catch { return null }
+}
+
+// OID 绑定:HEAD 是否已含该 mergeSha(exit 0=含;1=不含;128=本地无此对象,同按"树未跟上"等 pull)
+const headContainsOid = (oid) => {
+  const run = spawnSync('git', ['merge-base', '--is-ancestor', oid, 'HEAD'], { cwd: REPO_ROOT })
+  return run.status === 0
+}
+
+const runPreflight = () => {
+  const run = spawnSync('npm', ['run', 'preflight'], { encoding: 'utf8', cwd: REPO_ROOT, stdio: ['ignore', 'pipe', 'pipe'], timeout: PREFLIGHT_TIMEOUT_MS })
+  return { ok: run.status === 0, exit: run.status }
+}
+
+/** 锁外核验:树检查 + preflight + 告警;每项结果用一次短锁写回 sidecar。deps 可注入以便单测。 */
+export const verifyPending = async ({ stateDir, queue, skipPreflight = false, maxPreflight = MAX_PREFLIGHT_PER_RUN, deps = {} }) => {
+  const d = {
+    headContains: headContainsOid, treeDirty, preflight: runPreflight, notify: sendAlert,
+    headSha: () => spawnSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8', cwd: REPO_ROOT }).stdout?.trim() || null,
+    ...deps,
+  }
+  const verified = []
+  let runs = 0
+  for (const item of queue) {
+    const rec = { pr: item.pr, preflight: 'pending-tree', lastCheckedAt: new Date().toISOString() }
+    let alert = null
+    if (skipPreflight) rec.preflight = 'skipped'
+    else if (!d.headContains(item.mergeSha)) {
+      if (stalePendingAgeMs(item.prev, Date.now()) !== null && !item.prev?.pendingAlertedAt) {
+        rec.pendingAlertedAt = new Date().toISOString()
+        alert = {
+          title: '⏳ [mivo] mergeOID 健康核验滞留超24h(本地树未跟上)',
+          text: `PR #${item.pr} 的 mergeOID ${item.mergeSha.slice(0, 8)} 挂账 pending-tree 已超 ${PENDING_TREE_ALERT_HOURS}h——本地 checkout 一直未包含该合并,git pull 链路可能停摆。核验在树跟上前不会发生,请人工检查 mini 的 pull(凭证/磁盘/调度)。台账:${stateDir}/${RECONCILE_STATE_FILE}`,
+        }
+      }
+    } else if (runs >= maxPreflight) log(`本轮 preflight 已达上限 ${maxPreflight},${item.mergeSha.slice(0, 8)} 挂账下轮`)
+    else if (d.treeDirty()) log('工作树有 tracked 改动,核验挂账重试(脏树的绿不算数)')
+    else {
+      const before = d.headSha()
+      runs += 1
+      const res = d.preflight()
+      if (!before || before !== d.headSha() || d.treeDirty()) log('HEAD/工作树在核验期间变化,结果作废挂账重试')
+      else {
+        rec.preflight = res.ok ? 'green' : 'red'
+        rec.verifiedOnHead = before
+        if (!res.ok) {
+          alert = {
+            title: '🛑 [mivo] loop PR 合并后 main preflight 红',
+            text: [
+              `PR #${item.pr} 合并(${item.mergeSha.slice(0, 8)})后本地 main 全套 preflight 失败(exit=${res.exit},核验树 HEAD=${(before || '').slice(0, 8)})。`,
+              'revert-required:请人工执行 `gh pr create` 开 revert PR(revert 同样走 review-pr 审查合并,本对账器不代开)。',
+              `台账:${stateDir}/${RECONCILE_STATE_FILE}`,
+            ].join('\n'),
+          }
+        }
+      }
+    }
+    verified.push({ mergeSha: item.mergeSha, preflight: rec.preflight })
+    // 告警在锁外发(网络等待不进临界区);await 到底,失败落 pending-alerts(CX-R1-004)
+    if (alert) {
+      try { await d.notify({ stateDir, config: loadNotifyConfig(stateDir), ...alert }) } catch { appendPendingAlert(stateDir, alert.title, alert.text) }
+    }
+    const w = withLock(stateDir, () => { // 短锁:合并进最新盘面,不覆盖并发 writer
+      const cur = loadReconcileState(stateDir)
+      const prev = cur.verifiedMergeOids[item.mergeSha] || {}
+      if ((RESULT_RANK[rec.preflight] ?? 0) < (RESULT_RANK[prev.preflight] ?? 0)) return `拒绝降级 ${prev.preflight}→${rec.preflight}`
+      cur.verifiedMergeOids[item.mergeSha] = { ...prev, ...rec, at: prev.at || rec.lastCheckedAt }
+      saveReconcileState(stateDir, cur)
+    })
+    // 撞锁或降级被拒 → 本项结果没落盘;不静默丢弃(R9 席① F15 / R10 CX-R1-016)
+    if (!w.acquired) log(`${item.mergeSha.slice(0, 8)} 结果未落盘(锁被 ${w.holder?.owner ?? '未知'} 持有),下轮重核`)
+    else if (w.value) log(`${item.mergeSha.slice(0, 8)} ${w.value}(并发旧队列)`)
+  }
+  return verified
+}
+
+const main = async () => {
+  const args = parseArgs(process.argv.slice(2))
+  const stateDir = resolve(args['state-dir'] || process.env.MIVO_BUG_DOCTOR_STATE_DIR || join(REPO_ROOT, 'history', 'loops', 'bug-doctor'))
+  const statePath = join(stateDir, STATE_FILE)
+  if (!existsSync(statePath)) { log('state.json 不存在,无事可做'); return 0 }
+
+  // A(锁外):查 PR 终态。快照只用来决定查哪些 PR;变更集在 B 用锁内新鲜 state 重算
+  const snap = loadState(stateDir, FINGERPRINT_VERSION)
+  const allPrNums = [...new Set(Object.values(snap.clusters ?? {})
+    .filter((c) => c.pr && c.status !== 'fixed' && c.status !== 'closed-unmerged')
+    .map((c) => Number(c.pr)))]
+  // 公平轮转。R17 席② 证伪了原来的「固定前缀 + 余下下轮」:未收敛 PR 只要保持 OPEN 就不会离开
+  // allPrNums(filter 只排除 fixed/closed-unmerged),所以固定取前缀会让后缀**永久饥饿**——已合并的
+  // PR 永不被对账、其 mergeOID 永不进核验队列、红 main 永不被发现。游标记「本轮查过的最大 PR 号」,
+  // 按号排序后从它之后取起、环绕回头:列表增删对该语义无害(新 PR 号更大会先被取到,已收敛的消失
+  // 不影响游标),且不需要与 allPrNums 的下标对齐。
+  const sortedPrNums = [...allPrNums].sort((a, b) => a - b)
+  const afterPr = loadReconcileState(stateDir).queryCursorPr // 损坏即抛(此时 state 未动,比 B 阶段更早失败)
+  const prNums = [...sortedPrNums.filter((n) => n > afterPr), ...sortedPrNums.filter((n) => n <= afterPr)]
+    .slice(0, MAX_PR_QUERIES_PER_RUN)
+  if (allPrNums.length > prNums.length) log(`PR 查询数超上界,本轮查 ${prNums.length}/${allPrNums.length}(游标 >${afterPr} 起,环绕轮转,其余下轮轮到)`)
+  const nextCursorPr = prNums.length ? prNums[prNums.length - 1] : afterPr
+  const prStates = {}
+  let ghFailures = 0
+  if (args['no-gh']) {
+    // 测试口必须经过同一条截断/轮转路径。原实现 Object.assign 吃全量输入,使 MAX_PR_QUERIES_PER_RUN
+    // 在整个测试套件零覆盖——上面那个饥饿缺陷正因此 10 轮无人测出(R17 席① 踩坑后核实)。
+    if (args['input-prs']) {
+      const all = JSON.parse(readFileSync(args['input-prs'], 'utf8'))
+      for (const n of prNums) if (all[n] !== undefined) prStates[n] = all[n]
+    }
+  } else {
+    for (const n of prNums) { const ps = ghPrState(n); if (ps) prStates[n] = ps; else ghFailures += 1 }
+  }
+
+  // B(锁内,同步事务;实测量级毫秒):新鲜读 → 算变更 → 新 OID 先入 sidecar 待核验(写序不变量 CX-R1-003:
+  //   入队先于簇标 fixed,否则中途 kill 会让核验永久丢失)→ 写台账
+  const b = withLock(stateDir, () => {
+    const rawHadLegacyT1 = /"tCap":\s*"T1"/.test(readFileSync(statePath, 'utf8')) // 迁移落盘探测(CX-R1-008)
+    const state = loadState(stateDir, FINGERPRINT_VERSION) // 走 schema/fingerprint 守卫与稳定序列化(CX-R1-010)
+    const clusters = state.clusters ?? {}
+    const rst = loadReconcileState(stateDir) // 损坏即抛:此时 state 未动,核验不会丢
+    const changes = planReconciliation(clusters, prStates)
+    let sidecarDirty = false
+    for (const ch of changes) {
+      if (ch.to !== 'fixed' || !ch.mergeSha || rst.verifiedMergeOids[ch.mergeSha]) continue // 按 mergeSha 去重(CX-R2-011)
+      rst.verifiedMergeOids[ch.mergeSha] = { pr: ch.pr, preflight: 'pending-tree', at: new Date().toISOString() }
+      sidecarDirty = true
+    }
+    if (nextCursorPr !== rst.queryCursorPr) { rst.queryCursorPr = nextCursorPr; sidecarDirty = true }
+    if (sidecarDirty) saveReconcileState(stateDir, rst)
+    for (const ch of changes) {
+      const c = clusters[ch.fp]
+      if (ch.to === 'fixed') {
+        c.status = 'fixed'
+        c.fixedAt = ch.mergedAt ? new Date(ch.mergedAt).toISOString() : new Date().toISOString()
+        c.mergeSha = ch.mergeSha
+        c.mergedBy = 'review-pr'
+      } else {
+        c.status = 'closed-unmerged'
+        c.closedAt = new Date().toISOString()
+      }
+    }
+    if (changes.length > 0 || rawHadLegacyT1) saveState(stateDir, state)
+    const queue = Object.entries(rst.verifiedMergeOids)
+      .filter(([, r]) => r.preflight === 'pending-tree')
+      .map(([mergeSha, r]) => ({ mergeSha, pr: r.pr, prev: r }))
+    return { changes, queue }
+  })
+  if (!b.acquired) { log(`gate.lock 被占用(holder=${b.holder?.owner ?? '未知'}),本轮跳过`); return 0 }
+  const { changes, queue } = b.value
+
+  const verified = await verifyPending({ stateDir, queue, skipPreflight: !!args['no-preflight'] }) // C:锁外慢工
+
+  const summary = {
+    status: 'ok', reconciled: changes.length,
+    fixed: changes.filter((c) => c.to === 'fixed').length,
+    closedUnmerged: changes.filter((c) => c.to === 'closed-unmerged').length,
+    verified, ghFailures,
+  }
+  if (args['json-out']) process.stdout.write(`${JSON.stringify(summary)}\n`)
+  log(`对账完成: fixed=${summary.fixed} closed-unmerged=${summary.closedUnmerged} 核验动作=${verified.length} gh失败=${ghFailures}`)
+  return ghFailures > 0 && changes.length === 0 && prNums.length > 0 ? 1 : 0
+}
+
+const isDirectRun = process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)
+if (isDirectRun) {
+  main().then((code) => process.exit(code ?? 0)).catch((err) => {
+    process.stderr.write(`${err.message}\n`)
+    process.exit(1)
+  })
+}
