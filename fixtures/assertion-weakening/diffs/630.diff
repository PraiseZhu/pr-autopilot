new file mode 100644
index 00000000..e6fc7059
--- /dev/null
+++ b/src/canvas/useRegionEditParams.ts
@@ -0,0 +1,98 @@
+// src/canvas/useRegionEditParams.ts
+// 「更多参数」的状态与日志。与 useRegionEditModelChoice 并列:那个管模型,这个管
+// 画质/比例/张数,两者通过 model 联动 —— 换模型时参数要收敛到新模型的合法域。
+//
+// 日志按 docs/development-logging.md:参数变更是「会改变后续出图结果」的用户动作,
+// 逐次记 debugLogger.log;收敛(用户没主动改却被系统改掉的档)记 warn,因为那是
+// 跳过/降级路径,用户看到的选中态会变,必须留痕。
+import { useCallback, useEffect, useRef, useState } from 'react'
+
+import { debugLogger } from '../store/debugLogStore'
+import { regionEditModelName } from './regionEditModel'
+import {
+  REGION_EDIT_RATIO_SOURCE,
+  clampRegionEditParams,
+  isSameRegionEditQuality,
+  regionEditDefaultParams,
+  regionEditParamsSummary,
+  type RegionEditParams,
+} from './regionEditParams'
+import type { MaskEditModelId } from './imageMaskGeometry'
+
+const ratioText = (params: RegionEditParams): string =>
+  params.ratio === REGION_EDIT_RATIO_SOURCE ? '保持原比例' : params.ratio
+
+/** 只报真正变了的那一项,避免每次点击刷三条无差别日志。 */
+const diffText = (prev: RegionEditParams, next: RegionEditParams, model: MaskEditModelId): string | null => {
+  if (!isSameRegionEditQuality(prev.quality, next.quality)) {
+    const label = regionEditParamsSummary(next, model).split(' · ')[1]
+    return `画质:${label}`
+  }
+  if (prev.ratio !== next.ratio) return `比例:${ratioText(next)}`
+  if (prev.count !== next.count) return `生成数量:${next.count}张`
+  return null
+}
+
+export function useRegionEditParams(model: MaskEditModelId, initial?: RegionEditParams): {
+  params: RegionEditParams
+  setParams: (next: RegionEditParams) => void
+} {
+  // 草稿恢复入口(PR #630 P1):浮层重开时把用户上次选过的非默认参数原样带回来,
+  // 不回落模型默认值;无草稿时走模型默认。**初始化器里先 clamp 一次**(Greptile P1 追加):
+  // 草稿可能是为别的模型存的/被写进脏值(非法 ratio/kind/value),首帧就必须收敛到当前
+  // 模型合法域 —— 同模型重开不触发「切模型 effect」,不在这里收敛脏值会原样进提交。
+  // 收敛是纯函数,不写日志;收敛留痕由下方 mounted effect 一次性记(不在 render 期写 logger)。
+  const [params, setParamsState] = useState<RegionEditParams>(() => {
+    const base = initial ?? regionEditDefaultParams(model)
+    return clampRegionEditParams(base, model)
+  })
+  // 初挂载时 initial 被收敛过 → 记一次 warn(跳过/降级路径留痕;用户没主动改但选中态变了)。
+  // 放 effect 而不是初始化器/updater:渲染期写 debugLogStore 会触发「渲染 A 时更新 B」
+  // 的 React 报错(#489 实测),且 StrictMode dev 双调不会重复记。
+  const initialClampedRef = useRef<RegionEditParams>(initial ? clampRegionEditParams(initial, model) : initial)
+  useEffect(() => {
+    const clamped = initialClampedRef.current
+    if (clamped && clamped !== initial) {
+      debugLogger.warn('Region Edit', '草稿参数不在当前模型合法域,已收敛回落默认')
+    }
+  }, [])
+  // 与 useRegionEditModelChoice 同款:日志写在事件回调/effect 里,不在 setState updater
+  // 里 —— updater 跑在渲染阶段,写 debugLogStore 会触发「渲染 A 时更新 B」的 React 报错
+  // (#489 实测,e2e 的 console-error 门当场判红)。
+  const paramsRef = useRef(params)
+
+  const setParams = useCallback(
+    (next: RegionEditParams) => {
+      const prev = paramsRef.current
+      const changed = diffText(prev, next, model)
+      if (!changed) return
+      paramsRef.current = next
+      debugLogger.log('Region Edit', `出图参数调整:${changed}`)
+      setParamsState(next)
+    },
+    [model],
+  )
+
+  // 模型变了 → 收敛参数。画质档在两模型间是两套参数(resolution vs quality),比例域
+  // 也不同,不收敛会把非法档发给平台。被改掉的项记 warn(用户没主动改,但选中态变了)。
+  useEffect(() => {
+    const current = paramsRef.current
+    const clamped = clampRegionEditParams(current, model)
+    if (clamped === current) return
+    const qualityChanged = !isSameRegionEditQuality(clamped.quality, current.quality)
+    const ratioChanged = clamped.ratio !== current.ratio
+    if (!qualityChanged && !ratioChanged) return
+    paramsRef.current = clamped
+    setParamsState(clamped)
+    const parts = [
+      qualityChanged ? '画质档' : '',
+      ratioChanged ? `比例(${ratioText(current)} 该模型不支持)` : '',
+    ].filter(Boolean)
+    debugLogger.warn(
+      'Region Edit',
+      `出图参数随模型收敛:${regionEditModelName(model)} → ${parts.join('、')}回落默认`,
+    )
+  }, [model])
+
+  return { params, setParams }
+}
