--- a/docs/design-previews/region-edit/assets/product.css
+++ b/docs/design-previews/region-edit/assets/product.css
@@ -6874,6 +6874,243 @@ button:disabled {
   opacity: 0.85;
 }
 
+/* ── 「更多参数」入口(画质/比例/张数)──────────────────────────────────
+   位置:底部提交行里,模型下拉与发送键之间那段空白(实测该行是 flex + gap:8px,
+   左侧下拉 width:fit-content、右侧发送键 margin-left:auto,中间本来就空着,
+   插入本入口**不需要加宽面板**,--ai-panel-w 保持 340px 不动)。
+   浮层定位复用模型下拉那套 --flip-* 契约:JS 侧 useRegionEditFlip 现读这些变量算
+   容纳与越界修正,**变量名与语义必须与 .region-edit-model-menu 同源**,不能只写死值。 */
+.region-edit-params-field {
+  position: relative;
+  display: inline-flex;
+  flex: none;
+}
+
+/* 下拉箭头:与 .region-edit-model-field::after 同一套几何(4.5px 方角旋转 45°),
+   两个入口并排时必须看起来是同族控件 —— owner 实测反馈「样式要和选模型一样」。 */
+.region-edit-params-field::after {
+  content: '';
+  position: absolute;
+  top: 50%;
+  right: 7px;
+  width: 4.5px;
+  height: 4.5px;
+  border-right: 1.25px solid currentColor;
+  border-bottom: 1.25px solid currentColor;
+  transform: translateY(-65%) rotate(45deg);
+  opacity: 0.7;
+  pointer-events: none;
+}
+
+/* 触发器与模型下拉逐条对齐:同 min-height、同字号、**同为透明底无描边**
+   (原来的胶囊描边 + --muted 弱化色让它看起来像禁用态,owner 实测指出)。
+   右内边距 20px 给箭头让位,左 8px 容纳比例图标。 */
+.region-edit-params-trigger {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  min-height: 30px;
+  padding: 0 20px 0 8px;
+  color: var(--ink);
+  font-size: var(--text-md);
+  background: none;
+  border: 1px solid transparent;
+  border-radius: var(--radius-md);
+  cursor: pointer;
+}
+
+.region-edit-params-trigger:hover:not(:disabled) {
+  background: var(--region-btn-hover);
+}
+
+.region-edit-params-trigger:disabled {
+  opacity: 0.45;
+  cursor: default;
+}
+
+.region-edit-params-trigger:focus-visible {
+  outline: 2px solid var(--line-strong);
+  outline-offset: -2px;
+}
+
+/* 摘要文案随所选档变长(「原比例 · 标准画质 · 1张」最长约 14 字),极窄壳下省略而不是
+   把发送键挤出行外 —— 完整值仍在 aria-label 里,读屏器不受影响。
+   浮层最小宽已从 400 抬到 460(见 maskEditFloatingControls),常态不会触发省略。 */
+.region-edit-params-summary {
+  overflow: hidden;
+  max-width: 16ch;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.region-edit-params-menu {
+  /* 与 .region-edit-model-menu 逐枚同源:JS 现读 --flip-gap 算容纳、写 --flip-cap
+     与 --flip-offset-x。参数面板比模型菜单宽(比例组一行放 3 枚图标项),
+     故设计上限单独给 300px 而不是沿用 420 —— 但**语义与消费方式完全一致**。 */
+  --flip-gap: 4px;
+  /* 380(owner 2026-08-11 两轮反馈「按钮窄」):3 列等分下每列净宽 ~112,
+     「原比例」四字加内边距也不顶边。上限仍小于模型菜单的 420。 */
+  --flip-max-width: 380px;
+  --flip-cap: var(--flip-max-width);
+  --flip-align: left;
+  position: absolute;
+  top: calc(100% + var(--flip-gap));
+  left: 0;
+  transform: translateX(var(--flip-offset-x, 0px));
+  /* 工具条浮层(.region-edit-tool-panel)与提交行是**无 z-index 的兄弟节点**,纯按
+     DOM 顺序层叠,而它排在提交行之后 → 会盖住本浮层(owner 实测截图)。给一个高于
+     兄弟浮层的层级把它压回去;12 远低于抽屉侧栏(80),不会反过来盖住宿主 UI。 */
+  z-index: 12;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  width: max-content;
+  max-width: var(--flip-cap);
+  padding: 12px;
+  background: var(--panel-surface);
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  box-shadow: var(--shadow);
+}
+
+/* 同 model-menu:贴画布底边时向上开,否则被 .canvas-shell 的 overflow:clip 裁掉。 */
+.region-edit-params-menu.is-flipped {
+  top: auto;
+  bottom: calc(100% + var(--flip-gap));
+}
+
+/* 首帧隐形,避免「先向下展开被工具条压住、再跳到上方」的闪动(owner 2026-08-11 实测)。
+   useRegionEditFlip 是「先按向下渲染 → rAF 里量 → 需要则翻上」的两帧机制,本面板比
+   模型下拉高得多,中间那帧很扎眼。
+   用**纯 CSS 动画**而不是 React 状态:项目 lint 禁止 effect 里 setState;而 placement
+   的字段全是可选的(maxHeight/maxWidth/offsetX 只在需要钳制时才写),拿它们当「已测量」
+   判据会让不越界的常见情形永远隐形(实测点了没反应)。
+   visibility 而非 opacity:必须保留盒子参与布局,否则 hook 量不到自然高度。 */
+@keyframes region-edit-params-reveal {
+  from {
+    visibility: hidden;
+  }
+  to {
+    visibility: visible;
+  }
+}
+
+.region-edit-params-menu {
+  animation: region-edit-params-reveal 0.06s step-end;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .region-edit-params-menu {
+    animation-duration: 0.01s;
+  }
+}
+
+/* 高度装不下时内部滚动(JS 写 max-height 到内联 style)。 */
+.region-edit-params-menu.is-clamped {
+  overflow-y: auto;
+}
+
+.region-edit-param-group {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.region-edit-param-title {
+  color: var(--quiet);
+  font-size: var(--text-sm);
+}
+
+/* 一组按钮横向铺开、超宽换行。**等分列宽**而不是各自内容宽:参照图里比例组是
+   规整网格,一行 3 枚等宽;文字组(画质/张数)同理等分,避免「1K」比「标准画质」窄
+   一半的参差感(owner 实测要求「宽度自适应」= 同组等宽铺满,不是各管各)。 */
+.region-edit-param-row {
+  display: grid;
+  grid-template-columns: repeat(3, 1fr);
+  gap: 6px;
+}
+
+.region-edit-param-option {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  min-height: 30px;
+  padding: 6px 8px;
+  color: var(--ink);
+  font-size: var(--text-md);
+  /* 常态 = **描边式**(owner 2026-08-11 定):给按钮铺底会把面板整体压深一级,
+     与模型下拉菜单的观感对不齐。透明底 + 细描边既能看出可点,又不改变面板明度。 */
+  background: transparent;
+  border: 1px solid var(--line);
+  border-radius: var(--radius-md);
+  cursor: pointer;
+}
+
+/* 带图标的项(比例组):图标在上、文字在下,与参照图一致。 */
+.region-edit-param-option.has-icon {
+  flex-direction: column;
+  gap: 5px;
+  padding: 8px 6px;
+}
+
+/* hover = 轻水洗(与工具坞按钮、模型选项同一枚变量)。
+   **不能**用 --region-cta-bg-hover:那是「强调实底的 hover」,网页版直接等于 --ink
+   深色实底,盖在未选中项上会变成深块 + 深字(owner 实测截图)。 */
+.region-edit-param-option:hover:not(.is-active) {
+  background: var(--region-btn-hover);
+  border-color: var(--line-strong);
+}
+
+/* 选中 = 强调块实底(与工具坞 active、提交钮同一套品牌药丸语义):
+   Dark 档 --region-cta-bg 是亮底 + 深字,Light 档反之 —— 全局既有约定,
+   不再自创「描边 + 水洗」那套弱选中(owner 实测指出暗色下选中应是白底)。 */
+.region-edit-param-option.is-active {
+  color: var(--region-cta-fg);
+  background: var(--region-cta-bg);
+}
+
+.region-edit-param-option:focus-visible {
+  outline: 2px solid var(--line-strong);
+  outline-offset: -2px;
+}
+
+/* 比例形状图标:空心矩形,尺寸由组件按比例内联给。选中态跟随文字色(currentColor)
+   才能在强调实底上翻转,不能写死。 */
+/* 图标等高框:所有比例项的图标都占同样的 16×16,形状只在框内变化 —— 这样一行里
+   竖图(2:3)、横图(3:2)、方图的**文字基线才对齐**(owner 2026-08-11 实测错位)。 */
+.region-edit-ratio-icon-box {
+  display: flex;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+}
+
+.region-edit-ratio-icon {
+  flex: none;
+  border: 1.25px solid currentColor;
+  border-radius: 2px;
+  opacity: 0.85;
+}
+
+/* 「原比例」的四角取景框(SVG):线色跟随 currentColor,选中态自动翻转。 */
+.region-edit-ratio-corners {
+  display: block;
+  opacity: 0.85;
+}
+
+.region-edit-param-label {
+  line-height: 1.1;
+}
+
+/* 4K 的「较慢」角标:实测该档轮询时长约为 1K 的数倍,给一枚视��提示,
+   文案走 data-tooltip(悬停可读),不占按钮宽度。 */
+/* 4K 的「生成较慢」只走 data-tooltip 文案提示,**不画角标**
+   (owner 2026-08-11:小红点像报错,不要)。 */
+
 /* 工具面板(K8 ①):输入面板下方**居中悬浮**的独立小卡(参考图形态)。定位:内联 style
    给 left = 输入面板中线 + top,这里用 translateX(-50%) 把自己拉回中心,宽度随内容。
    中和共享工具条骨架的「纵向堆叠 + 自己的浮卡视觉」,只留按钮排布;卡片外观走浮层壳。 */
@@ -7366,6 +7603,14 @@ button:disabled {
   backdrop-filter: blur(12px);
 }
 
+/* 输入面板里弹出二级浮层(出图参数)时,把整块抬到工具条之上。
+   **必须抬这一层**:输入面板自己是 z-index:1 的定位元素 = 独立层叠上下文,
+   浮层无论写多高的 z-index 都只在这个「1」的盒子内部生效,压不过同为 1 但 DOM
+   靠后的工具条(owner 2026-08-11 连续两轮实测仍被遮挡,前一次只抬浮层没用)。 */
+.image-mask-edit-prompt.has-open-popover {
+  z-index: 3;
+}
+
 /* 工具条两排：第一排工具靠左 + 关闭靠最右；第二排撤销/重复/删除。 */
 .image-mask-edit-toolbar {
   display: flex;
@@ -11855,7 +12100,8 @@ button:disabled {
    @ 引用下拉与自绘的出图模型下拉(L2 ③)同底同描边 —— 两者都是这块面板里弹出的
    第二层,视觉必须同源(App.css 那边也是共用一套 token)。 */
 .region-edit-suggest,
-.region-edit-model-menu {
+.region-edit-model-menu,
+.region-edit-params-menu {
   background: color-mix(in srgb, var(--surface-elevated, #fffaf0) 94%, var(--text-primary, #232323) 6%);
   border-color: color-mix(in srgb, var(--text-primary, #232323) 14%, var(--border-default, #d6d0c6));
 }
