+  flex: none;
+  align-items: center;
+  justify-content: center;
+  width: 16px;
+  height: 16px;
+}
+
+.region-edit-ratio-icon {
+  flex: none;
+  border: 1.25px solid currentColor;
+  border-radius: 2px;
+  opacity: 0.85;
