+// PR #630 P1:草稿恢复入口 —— initial 只在首次挂载生效,之后由 setParams / 模型收敛
+// effect 接管;无 initial 时回落模型默认值;草稿参数与新模型不兼容时收敛不豁免。
+describe('useRegionEditParams — 草稿恢复入口(PR #630 P1)', () => {
+  it('有 initial 时初始 params 取草稿值而非模型默认', () => {
+    const fromDraft: RegionEditParams = { quality: { kind: 'resolution', value: '4K' }, ratio: '4:3', count: 4 }
+    render('gemini-3-pro-image', fromDraft)
+    expect(api.params).toEqual(fromDraft)
+  })
+
+  it('无 initial 时回落模型默认值(回归)', () => {
+    render('gemini-3-pro-image')
+    expect(api.params).toEqual(regionEditDefaultParams('gemini-3-pro-image'))
+  })
+
+  it('草稿参数与新模型不兼容 → 模型收敛 effect 收敛 + warn(initial 不豁免收敛)', () => {
+    render('gemini-3-pro-image', { quality: { kind: 'resolution', value: '4K' }, ratio: '4:3', count: 4 })
+    vi.mocked(debugLogger.warn).mockClear()
+    render('gpt-image-2')
+    expect(api.params).toEqual({ quality: { kind: 'quality', value: 'medium' }, ratio: 'source', count: 4 })
+    expect(debugLogger.warn).toHaveBeenCalledTimes(1)
+    expect(String(vi.mocked(debugLogger.warn).mock.calls[0][1])).toContain('出图参数随模型收敛')
+  })
+
+  it('草稿参数与新模型比例域兼容时比例/张数不被覆盖(仅 quality kind 随模型收敛)', () => {
+    render('gemini-3-pro-image', { quality: { kind: 'resolution', value: '2K' }, ratio: '16:9', count: 2 })
+    vi.mocked(debugLogger.warn).mockClear()
+    render('gpt-image-2')
+    expect(api.params.ratio).toBe('16:9')
+    expect(api.params.count).toBe(2)
+    expect(api.params.quality).toEqual({ kind: 'quality', value: 'medium' })
+    expect(debugLogger.warn).toHaveBeenCalledTimes(1)
+  })
