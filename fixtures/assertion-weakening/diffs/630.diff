@@ -0,0 +1,168 @@
+// @vitest-environment happy-dom
+// A2 R2 席③ UP-1-reuse:clampRegionEditParams 纯函数有测试 ≠ hook 接线已测。
+// 本文件真挂载 hook，覆盖 model effect / paramsRef / 日志与用户 setParams 路径。
+import { act, useEffect, useRef } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('../store/debugLogStore', () => ({ debugLogger: { log: vi.fn(), warn: vi.fn(), error: vi.fn() } }))
+
+import { debugLogger } from '../store/debugLogStore'
+import { regionEditDefaultParams, type RegionEditParams } from './regionEditParams'
+import { useRegionEditParams } from './useRegionEditParams'
+import type { MaskEditModelId } from './imageMaskGeometry'
+
+let api: ReturnType<typeof useRegionEditParams>
+let firstRenderParams: RegionEditParams | null
+let container: HTMLDivElement
+let root: Root
+
+function Harness({ model, initial }: { model: MaskEditModelId; initial?: RegionEditParams }) {
+  const value = useRegionEditParams(model, initial)
+  // **渲染期**捕获首次渲染的 params(模型 effect 跑之前)——锁定「初始化器已 clamp」,
+  // 不被模型 effect 首挂载的兜底收敛掩盖(那会让变异 B 假绿)。写 ref 是 render 期允许的
+  // 缓存模式;外部断言变量只在 effect 里赋值(render 期写外部变量会触发 eslint 违规)。
+  const firstRenderRef = useRef<RegionEditParams | null>(null)
+  if (firstRenderRef.current === null) firstRenderRef.current = value.params
+  useEffect(() => {
+    api = value
+    firstRenderParams = firstRenderRef.current
+  }, [value])
+  return null
+}
+
+const render = (model: MaskEditModelId, initial?: RegionEditParams) =>
+  act(() => root.render(<Harness model={model} initial={initial} />))
+
+beforeEach(() => {
+  ;(globalThis as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+  vi.mocked(debugLogger.log).mockClear()
+  vi.mocked(debugLogger.warn).mockClear()
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+})
+afterEach(() => {
+  act(() => root.unmount())
+  container.remove()
+})
+
+describe('useRegionEditParams — 模型切换收敛接线', () => {
+  it('NANO 4:3 + 4K → 切 GPT 后比例回 source、画质回 medium，并 warn 一次', () => {
+    render('gemini-3-pro-image')
+    act(() => api.setParams({ quality: { kind: 'resolution', value: '4K' }, ratio: '4:3', count: 4 }))
+    vi.mocked(debugLogger.warn).mockClear()
+
+    render('gpt-image-2')
+    expect(api.params).toEqual({ quality: { kind: 'quality', value: 'medium' }, ratio: 'source', count: 4 })
+    expect(debugLogger.warn).toHaveBeenCalledTimes(1)
+    expect(String(vi.mocked(debugLogger.warn).mock.calls[0][1])).toContain('出图参数随模型收敛')
+  })
+
+  it('两模型都支持的比例不被覆盖；只收敛 quality kind', () => {
+    render('gemini-3-pro-image')
+    act(() => api.setParams({ quality: { kind: 'resolution', value: '2K' }, ratio: '16:9', count: 2 }))
+    render('gpt-image-2')
+    expect(api.params.ratio).toBe('16:9')
+    expect(api.params.quality).toEqual({ kind: 'quality', value: 'medium' })
+    expect(api.params.count).toBe(2)
+  })
+
+  it('同模型重复渲染无需收敛，不改状态、不误报 warn', () => {
+    render('gemini-3-pro-image')
+    const before = api.params
+    vi.mocked(debugLogger.warn).mockClear()
+    render('gemini-3-pro-image')
+    expect(api.params).toBe(before)
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+  })
+})
+
+describe('useRegionEditParams — 同模型脏 initial 初挂载收敛(Greptile P1 追加)', () => {
+  it('同模型脏 initial(非法 ratio/kind/value)→ 首帧即 clamp 到合法域,不直发平台', () => {
+    // NANO 模型塞 GPT 的 quality kind + NANO 白名单外的比例:挂载期就要收敛,
+    // 不能等「切模型 effect」——同模型重开不切模型,脏值会原样进提交。
+    // count 是合法值(张数与模型无关,clamp 不改它),只收敛 ratio/quality。
+    // 断言**首帧渲染值**(firstRenderParams,模型 effect 跑之前):去掉初始化器 clamp,
+    // 首帧就是脏值,本条转红 —— 模型 effect 首挂载的兜底收敛不会让这条假绿。
+    // ratio 用 '7:9'(非白名单档)模拟脏值,类型上以 unknown 断言绕过合法类型。
+    const dirty = { quality: { kind: 'quality', value: 'high' }, ratio: '7:9', count: 2 } as unknown as RegionEditParams
+    render('gemini-3-pro-image', dirty)
+    expect(firstRenderParams).toEqual({ quality: { kind: 'resolution', value: '2K' }, ratio: 'source', count: 2 })
+  })
+
+  it('初挂载被收敛 → mounted effect 一次性 warn,不在 render 期写 logger', () => {
+    const dirty = { quality: { kind: 'quality', value: 'high' }, ratio: '7:9', count: 2 } as unknown as RegionEditParams
+    render('gemini-3-pro-image', dirty)
+    expect(debugLogger.warn).toHaveBeenCalledTimes(1)
+    expect(String(vi.mocked(debugLogger.warn).mock.calls[0][1])).toContain('草稿参数不在当前模型合法域,已收敛回落默认')
+    // 不重复:同模型再渲染不刷第二条
+    vi.mocked(debugLogger.warn).mockClear()
+    render('gemini-3-pro-image')
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+  })
+
+  it('合法 initial 初挂载不收敛 → 不 warn', () => {
+    const ok: RegionEditParams = { quality: { kind: 'resolution', value: '4K' }, ratio: '4:3', count: 4 }
+    render('gemini-3-pro-image', ok)
+    expect(api.params).toEqual(ok)
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+  })
+
+  it('无 initial(旧 draft 无 params)→ 默认值,不 warn', () => {
+    render('gemini-3-pro-image')
+    expect(api.params).toEqual(regionEditDefaultParams('gemini-3-pro-image'))
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+  })
+})
+
+describe('useRegionEditParams — 用户 setParams 日志', () => {
+  it('只记录实际变化项；相同值不写日志也不更新引用', () => {
+    render('gemini-3-pro-image')
+    const before = api.params
+    act(() => api.setParams(before))
+    expect(debugLogger.log).not.toHaveBeenCalled()
+    expect(api.params).toBe(before)
