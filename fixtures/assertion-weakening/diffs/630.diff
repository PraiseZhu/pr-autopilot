+++ b/src/canvas/regionEditRatioIcon.tsx
@@ -0,0 +1,51 @@
+// src/canvas/regionEditRatioIcon.tsx
+// 比例选项的形状图标:一枚按目标宽高比缩放的空心矩形(参考 Cindy 生图面板的比例组)。
+// 纯几何,不引图标库 —— lucide 没有「任意比例矩形」这种按数据变形的图标。
+//
+// 尺寸策略:长边固定 14px,短边按比例推算,最小 5px(21:9 的短边算出来才 6px,
+// 再小就看不出是矩形了)。这样一排图标视觉重量一致,又能一眼看出横竖与胖瘦。
+
+type RatioIconProps = {
+  /** 形如 '16:9' / '1:1';解析失败按 1:1 画(不抛错,UI 不因脏值崩)。 */
+  ratio: string
+  /** 「原比例」专用:四角取景框 = 跟随源图、形状不定(owner 2026-08-11 指定造型)。 */
+  dashed?: boolean
+}
+
+const LONG = 14
+const MIN_SHORT = 5
+
+export function RegionEditRatioIcon({ ratio, dashed }: RatioIconProps) {
+  const [rawW, rawH] = ratio.split(':').map((part) => Number(part))
+  const w = Number.isFinite(rawW) && rawW > 0 ? rawW : 1
+  const h = Number.isFinite(rawH) && rawH > 0 ? rawH : 1
+  const landscape = w >= h
+  const short = Math.max(MIN_SHORT, Math.round((LONG * Math.min(w, h)) / Math.max(w, h)))
+  const width = landscape ? LONG : short
+  const height = landscape ? short : LONG
+
+  // 外层是**固定 16×16 的等高框**,形状只在框内变化:各项图标占位一致,下面的文字
+  // 才能对齐(owner 2026-08-11 实测:图标高度不一 → 2:3 / 3:2 / 4:5 的文字错位)。
+  if (dashed) {
+    // 「原比例」= 四角取景框(owner 指定):只画四个角,表达「按源图取景、形状不定」,
+    // 比虚线矩形干净得多。用 SVG 而不是 CSS 拼边,线端与圆角才可控。
+    return (
+      <span className="region-edit-ratio-icon-box" aria-hidden="true">
+        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" className="region-edit-ratio-corners">
+          <path
+            d="M1 5V2.5A1.5 1.5 0 0 1 2.5 1H5M9 1h2.5A1.5 1.5 0 0 1 13 2.5V5M13 9v2.5a1.5 1.5 0 0 1-1.5 1.5H9M5 13H2.5A1.5 1.5 0 0 1 1 11.5V9"
+            stroke="currentColor"
+            strokeWidth="1.4"
+            strokeLinecap="round"
+          />
+        </svg>
+      </span>
+    )
+  }
+
+  return (
+    <span className="region-edit-ratio-icon-box" aria-hidden="true">
+      <span className="region-edit-ratio-icon" style={{ width: `${width}px`, height: `${height}px` }} />
+    </span>
+  )
+}
