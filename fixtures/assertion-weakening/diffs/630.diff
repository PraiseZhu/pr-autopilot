+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { RegionEditParamsSelect } from './RegionEditParamsSelect'
+import { regionEditDefaultParams, type RegionEditParams } from './regionEditParams'
+import { isRegionEditControlMenuOpen } from '../lib/menuOverlayStack'
+
+let container: HTMLDivElement
+let root: Root
+const onChange = vi.fn()
+const onOpenChange = vi.fn()
+
+const mount = (props: { params?: RegionEditParams; disabled?: boolean } = {}) => {
+  act(() => {
+    root.render(
+      <RegionEditParamsSelect
+        model="gemini-3-pro-image"
+        params={props.params ?? regionEditDefaultParams('gemini-3-pro-image')}
+        disabled={props.disabled ?? false}
+        onChange={onChange}
+        onOpenChange={onOpenChange}
+      />,
+    )
+  })
+}
+const trigger = () => container.querySelector<HTMLButtonElement>('.region-edit-params-trigger')!
+const menu = () => container.querySelector<HTMLDivElement>('.region-edit-params-menu')
+const options = () => [...container.querySelectorAll<HTMLButtonElement>('[role="option"]')]
+const click = (node: HTMLElement) => act(() => node.click())
+const keydown = (key: string, target: EventTarget = window) =>
+  act(() => target.dispatchEvent(new KeyboardEvent('keydown', { key, bubbles: true, cancelable: true })))
+
+beforeEach(() => {
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+  onChange.mockClear()
+  onOpenChange.mockClear()
+})
+afterEach(() => {
+  act(() => root.unmount())
+  container.remove()
+})
+
+describe('RegionEditParamsSelect — 行为契约', () => {
+  it('展开→冻结→解冻不复开、不夺焦点(F-A2-1/ADV-A2-1)', () => {
+    const elsewhere = document.createElement('input')
+    document.body.appendChild(elsewhere)
+    mount()
+    click(trigger())
+    expect(menu()).not.toBeNull()
+    mount({ disabled: true })
+    expect(menu()).toBeNull()
+    elsewhere.focus()
+    mount({ disabled: false })
+    expect(menu()).toBeNull()
+    expect(document.activeElement).toBe(elsewhere)
+    elsewhere.remove()
+  })
+
+  it('ArrowDown 打开并聚焦当前项,上下箭头环绕漫游', () => {
+    mount()
+    keydown('ArrowDown', trigger())
+    expect(menu()).not.toBeNull()
+    expect(document.activeElement).toBe(options()[1]) // 默认 2K
+    keydown('ArrowDown', options()[1])
+    expect(document.activeElement).toBe(options()[2])
+    keydown('ArrowUp', options()[2])
+    expect(document.activeElement).toBe(options()[1])
+  })
+
+  it('Esc 只关本层并把焦点还给触发器', () => {
+    mount()
+    click(trigger())
+    const event = new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true })
+    act(() => window.dispatchEvent(event))
+    expect(menu()).toBeNull()
+    expect(event.defaultPrevented).toBe(true)
+    expect(document.activeElement).toBe(trigger())
+  })
+
+  it('点外关闭;Tab 焦点离开整个控件也关闭', () => {
+    mount()
+    click(trigger())
+    act(() => document.body.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true })))
+    expect(menu()).toBeNull()
+
+    click(trigger())
+    const outside = document.createElement('button')
+    document.body.appendChild(outside)
+    act(() => outside.focus())
+    expect(menu()).toBeNull()
+    outside.remove()
+  })
+
+  it('选择参数保持面板打开、回调新值并把焦点还给触发器', () => {
+    mount()
+    click(trigger())
+    const fourK = options().find((option) => option.textContent === '4K')!
+    click(fourK)
+    expect(onChange).toHaveBeenCalledWith(expect.objectContaining({
+      quality: { kind: 'resolution', value: '4K' },
+    }))
+    expect(menu()).not.toBeNull()
+    expect(document.activeElement).toBe(trigger())
+  })
+
+  it('选择→回焦触发器→真实 Tab 顺序先关菜单,且不阻止浏览器默认移动(ADV-A2-2)', () => {
+    mount()
+    click(trigger())
+    click(options()[2])
+    expect(document.activeElement).toBe(trigger())
+    // 旧测试直接 outside.focus() 跳过了浏览器真实 Tab 顺序 —— trigger 后面紧跟菜单
+    // options,Tab 的下一站仍在 root 内,onBlur 不会关。这里直接派发 trigger 的 Tab。
+    const tab = new KeyboardEvent('keydown', { key: 'Tab', bubbles: true, cancelable: true })
+    act(() => trigger().dispatchEvent(tab))
+    expect(menu()).toBeNull()
+    expect(tab.defaultPrevented, '关闭菜单但必须让浏览器继续默认 Tab 移焦').toBe(false)
+    expect(isRegionEditControlMenuOpen(document)).toBe(false)
+  })
+
+  it('触发器 aria-haspopup 与实际 listbox role 一致', () => {
+    mount()
+    expect(trigger().getAttribute('aria-haspopup')).toBe('listbox')
+    click(trigger())
+    expect(menu()?.getAttribute('role')).toBe('listbox')
+  })
+
+  it('英文 locale 下摘要和 GPT 画质选项不混入中文(ADV-E2-3)', async () => {
+    const { default: i18n } = await import('../i18n')
+    await act(async () => i18n.changeLanguage('en'))
+    const gpt = regionEditDefaultParams('gpt-image-2')
+    act(() => {
+      root.render(
+        <RegionEditParamsSelect
+          model="gpt-image-2"
+          params={gpt}
+          disabled={false}
+          onChange={onChange}
+        />,
+      )
+    })
+    expect(trigger().textContent).toContain('Original · Medium · 1')
+    click(trigger())
+    expect(options().map((option) => option.textContent)).toEqual(expect.arrayContaining(['Low', 'Medium', 'High']))
+    expect(container.textContent).not.toMatch(/[低中高张]/)
+    await act(async () => i18n.changeLanguage('zh-CN'))
+  })
+
+  it('参数菜单真实类名进入画布快捷键让行选择器', () => {
+    mount()
+    expect(isRegionEditControlMenuOpen(document)).toBe(false)
+    click(trigger())
+    expect(isRegionEditControlMenuOpen(document)).toBe(true)
+  })
+})
