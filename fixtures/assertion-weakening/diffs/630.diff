+// src/canvas/RegionEditParamsSelect.tsx
+// 区域编辑底部工具条的「更多参数」入口:触发器显示当前档摘要,点开是分组面板
+// (画质 / 比例 / 张数,每组一行按钮),交互与 RegionEditModelSelect 逐条对齐 ——
+// 贴边翻转(useRegionEditFlip)、捕获相 pointerdown 点外关闭、捕获相 Escape 只关本层、
+// data-canvas-ui 豁免「点画布空白关面板」。刻意**不复用** .canvas-tool-flyout:
+// 那套锚在工具坞按钮下方展开,受 .canvas-shell 裁切约束与本面板不同。
+//
+// 档位取值全部来自 regionEditParams(实测口径),本组件只负责渲染与选中态,不判定
+// 哪些档合法 —— 模型切换后的收敛由 clampRegionEditParams 在上层做。
+import {
+  useEffect,
+  useLayoutEffect,
+  useRef,
+  useState,
+  type KeyboardEvent as ReactKeyboardEvent,
+  type ReactNode,
+} from 'react'
+
+import { t } from '../i18n'
+import { handleOverlayEscape } from '../lib/menuOverlayStack'
+import { debugLogger } from '../store/debugLogStore'
+import { RegionEditRatioIcon } from './regionEditRatioIcon'
+import { flipStyle } from './regionEditFlip'
+import { useRegionEditFlip } from './useRegionEditFlip'
+import {
+  REGION_EDIT_RATIO_SOURCE,
+  isSameRegionEditQuality,
+  regionEditCounts,
+  regionEditQualityOptions,
+  regionEditRatioOptions,
+  type RegionEditCount,
+  type RegionEditParams,
+  type RegionEditQuality,
+  type RegionEditRatio,
+} from './regionEditParams'
+import type { MaskEditModelId } from './imageMaskGeometry'
+
+type RegionEditParamsSelectProps = {
+  model: MaskEditModelId
+  params: RegionEditParams
+  /** 冻结(提交中/装配中)时不许改参数,与模型下拉同语义。 */
+  disabled: boolean
+  onChange: (next: RegionEditParams) => void
+  /** 浮层开合回传:输入面板据此临时抬高 z-index,否则二级浮层会被工具条压住
+   *  (输入面板自身 z-index:1 形成层叠上下文,子层再高也翻不出去)。 */
+  onOpenChange?: (open: boolean) => void
+}
+
+export function RegionEditParamsSelect({
+  model,
+  params,
+  disabled,
+  onChange,
+  onOpenChange,
+}: RegionEditParamsSelectProps) {
+  const [open, setOpen] = useState(false)
+  const openRef = useRef(open)
+  const rootRef = useRef<HTMLSpanElement | null>(null)
+  const menuRef = useRef<HTMLDivElement | null>(null)
+  const triggerRef = useRef<HTMLButtonElement | null>(null)
+
+  // 冻结时**真实清零**内部 open 与父层抬层状态,不能只用 open&&!disabled 派生隐藏。
+  // 否则提交失败解冻后菜单会无操作复开、重新抬高父层并可能夺焦点(F-A2-1/ADV-A2-1)。
+  // 与 RegionEditModelSelect 的同族修复一致,渲染期同步调整避免中间帧。
+  if (open && disabled) setOpen(false)
+  const menuOpen = open && !disabled
+  // 父层抬层与日志是外部副作用,不能放 render 里。render 期只同步收起 state；layout
+  // effect 在浏览器绘制前完成通知,不会露出「面板已隐藏但父层仍抬高」的一帧。
+  useLayoutEffect(() => {
+    const wasOpen = openRef.current
+    openRef.current = open
+    if (!disabled || !wasOpen) return
+    onOpenChange?.(false)
+    debugLogger.log('Region Edit', '出图参数面板因提交冻结而关闭')
+  }, [disabled, onOpenChange, open])
+  // 签名与模型下拉一致:(浮层 ref, 锚 ref, 是否启用)。
+  const placement = useRegionEditFlip(menuRef, rootRef, menuOpen)
+
+  // 开合的出口有四个(点触发器/点外/Esc/禁用),统一走这里回传,免得逐个改漏。
+  // 回调**不能**写在 setState 的 updater 里:updater 跑在渲染阶段,那里调用父层
+  // setState 会触发 React 的「渲染 A 时更新 B」报错(#489 实测,e2e console-error
+  // 门当场判红)。这里用 openRef 现读当前值,回调留在事件回调里。
+  const setOpenAndNotify = (value: boolean, reason: 'trigger' | 'outside' | 'escape' | 'blur' = 'trigger') => {
+    if (openRef.current === value) return
+    openRef.current = value
+    setOpen(value)
+    onOpenChange?.(value && !disabled)
+    debugLogger.log('Region Edit', `出图参数面板${value ? '打开' : '关闭'}:${reason}`)
+  }
+
+  // 打开后焦点落到当前画质项(若无匹配则首项),与模型下拉的真焦点漫游一致。
+  useEffect(() => {
+    if (!menuOpen) return
+    const options = menuRef.current?.querySelectorAll<HTMLButtonElement>('[role="option"]')
+    const active = [...(options ?? [])].find((option) => option.getAttribute('aria-selected') === 'true')
+    ;(active ?? options?.[0])?.focus()
+  }, [menuOpen])
+
+  useEffect(() => {
+    if (!menuOpen) return undefined
+    const closeOnOutside = (event: PointerEvent) => {
+      if (rootRef.current?.contains(event.target as Node)) return
+      setOpenAndNotify(false, 'outside')
+    }
+    // 与模型下拉同款:捕获相注册,抢在画布全局 Escape(→ onCancelMaskEdit)之前,
+    // 让 Esc 只关本层浮层而不是整个重绘面板。
+    const closeOnEscape = (event: KeyboardEvent) => {
+      handleOverlayEscape(event, () => {
+        setOpenAndNotify(false, 'escape')
+        triggerRef.current?.focus()
+      })
+    }
+    window.addEventListener('pointerdown', closeOnOutside, { capture: true })
+    window.addEventListener('keydown', closeOnEscape, { capture: true })
+    return () => {
+      window.removeEventListener('pointerdown', closeOnOutside, { capture: true })
+      window.removeEventListener('keydown', closeOnEscape, { capture: true })
+    }
+    // setOpenAndNotify 每次渲染都是新函数,进依赖会让监听每帧重挂;它内部只读 ref
+    // 与最新 props,不存在闭包过期问题,故刻意只依赖开合态。
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [menuOpen])
+
+  // 改一个维度不关面板:用户通常连着调两三项(与截图里 Cindy 的参数面板一致)。
+  const patch = (next: Partial<RegionEditParams>) => onChange({ ...params, ...next })
+
+  const onTriggerKeyDown = (event: ReactKeyboardEvent<HTMLButtonElement>) => {
+    // 选项选择后焦点会回触发器,菜单仍保持展开。此时真实 Tab 顺序的下一站是 DOM 中
+    // 紧跟触发器的第一个 option(仍在 root 内),root onBlur 因 relatedTarget 仍在内部
+    // 不会关闭 —— 菜单持续存在、画布快捷键也持续让行(ADV-A2-2 R3 实证)。
+    // 触发器在菜单展开时收到 Tab，先收起但**不 preventDefault**，让浏览器照常把焦点
+    // 移到控件外的下一个可聚焦元素。
+    if (menuOpen && event.key === 'Tab') {
+      setOpenAndNotify(false, 'blur')
+      return
+    }
+    if (menuOpen || (event.key !== 'ArrowDown' && event.key !== 'ArrowUp')) return
+    event.preventDefault()
+    setOpenAndNotify(true)
+  }
+
+  const onMenuKeyDown = (event: ReactKeyboardEvent<HTMLDivElement>) => {
+    if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return
+    event.preventDefault()
+    const options = [...(menuRef.current?.querySelectorAll<HTMLButtonElement>('[role="option"]') ?? [])]
+    if (!options.length) return
+    const from = options.findIndex((option) => option === event.target)
+    const step = event.key === 'ArrowDown' ? 1 : -1
+    options[(Math.max(0, from) + step + options.length) % options.length].focus()
+  }
+
+  const qualityOptions = regionEditQualityOptions(model).map((option) => ({
+    ...option,
+    label:
+      option.value.kind === 'quality'
+        ? t(`chat.quality.${option.value.value}`)
+        : option.label,
+  }))
+  const ratioOptions = regionEditRatioOptions(model)
+  // regionEditParamsSummary 是领域层的中文/debug 摘要；UI/ARIA 必须在组件层按 locale 组装。
+  const qualitySummary =
+    qualityOptions.find((option) => isSameRegionEditQuality(option.value, params.quality))?.label ??
+    params.quality.value
+  const ratioSummary = params.ratio === REGION_EDIT_RATIO_SOURCE ? t('menu.maskEdit.sourceRatio') : params.ratio
+  const summary = [ratioSummary, qualitySummary, t('menu.maskEdit.countValue', { count: String(params.count) })].join(' · ')
+  const paramsLabel = t('menu.maskEdit.paramsLabel')
+  const qualityLabel = t('menu.maskEdit.qualityLabel')
+  const ratioLabel = t('menu.maskEdit.ratioLabel')
+  const countLabel = t('menu.maskEdit.countLabel')
+
+  const groupButton = (
+    key: string,
+    label: string,
+    selected: boolean,
+    onPick: () => void,
+    opts?: { slow?: boolean; icon?: ReactNode },
+  ) => (
+    <button
+      key={key}
+      type="button"
+      className={['region-edit-param-option', opts?.icon ? 'has-icon' : '', selected ? 'is-active' : '']
+        .filter(Boolean)
+        .join(' ')}
+      role="option"
+      aria-selected={selected}
+      onClick={() => {
+        onPick()
+        // 面板保持展开以便连续调项；把焦点还给触发器，避免选项列表随模型收敛重建时
+        // 焦点掉到 body。此处是真事件回调，读取 ref 不触发 react-hooks/refs。
+        triggerRef.current?.focus()
+      }}
+      // 4K 明显更慢(实测轮询时长翻倍),给个可读提示而不是只靠角标。
+      {...(opts?.slow ? { 'data-tooltip': t('menu.maskEdit.slowGeneration') } : {})}
+    >
+      {opts?.icon}
+      <span className="region-edit-param-label">{label}</span>
+    </button>
+  )
+
+  return (
+    <span
+      className="region-edit-params-field"
+      ref={rootRef}
+      onBlur={(event) => {
+        if (rootRef.current?.contains(event.relatedTarget as Node | null)) return
+        setOpenAndNotify(false, 'blur')
+      }}
+    >
+      <button
+        ref={triggerRef}
+        type="button"
+        className="region-edit-params-trigger"
+        disabled={disabled}
+        aria-haspopup="listbox"
+        aria-expanded={menuOpen}
+        aria-label={t('menu.maskEdit.paramsWithValue', { value: summary })}
+        onClick={() => setOpenAndNotify(!open)}
+        onKeyDown={onTriggerKeyDown}
+      >
+        {/* 前缀 = 当前比例的形状图标(与比例组同一枚组件),比抽象滑块图标更快读出
+            「这里管画幅」;保持原比例时与面板内选项同款四角取景框(owner 2026-08-11:
+            触发器与选项造型必须一致,不得用 1:1 实心占位冒充)。 */}
+        <RegionEditRatioIcon
+          ratio={params.ratio === REGION_EDIT_RATIO_SOURCE ? '1:1' : params.ratio}
+          dashed={params.ratio === REGION_EDIT_RATIO_SOURCE}
+        />
+        <span className="region-edit-params-summary">{summary}</span>
+      </button>
+      {menuOpen ? (
+        <div
+          ref={menuRef}
+          className={[
+            'region-edit-params-menu',
+            placement.flipped ? 'is-flipped' : '',
+            // maxHeight 非空 = 该侧装不下自然高度,需内部滚动(与模型下拉同判据)。
+            placement.maxHeight != null ? 'is-clamped' : '',
+          ]
+            .filter(Boolean)
+            .join(' ')}
+          style={flipStyle(placement)}
+          role="listbox"
+          aria-label={paramsLabel}
+          data-canvas-ui="true"
+          onKeyDown={onMenuKeyDown}
+        >
+          <div className="region-edit-param-group" role="group" aria-label={qualityLabel}>
+            <span className="region-edit-param-title">{qualityLabel}</span>
+            <div className="region-edit-param-row">
+              {qualityOptions.map((option) =>
+                groupButton(
+                  `${option.value.kind}-${option.value.value}`,
+                  option.label,
+                  isSameRegionEditQuality(option.value, params.quality),
+                  () => patch({ quality: option.value as RegionEditQuality }),
+                  { slow: option.slow },
+                ),
+              )}
+            </div>
+          </div>
+
+          <div className="region-edit-param-group" role="group" aria-label={ratioLabel}>
+            <span className="region-edit-param-title">{ratioLabel}</span>
+            <div className="region-edit-param-row">
+              {/* 「保持原比例」恒排首位:它是默认档,也是区域编辑的语义本位
+                  (在原图上改一块,不动画幅)。选了别的比例才会让 AI 补画适配。 */}
+              {groupButton(
+                'ratio-source',
+                t('menu.maskEdit.sourceRatio'),
+                params.ratio === REGION_EDIT_RATIO_SOURCE,
+                () => patch({ ratio: REGION_EDIT_RATIO_SOURCE }),
+                // 「跟随源图」没有确定形状,用虚线框表达「按原样」,与实线的具体比例区分开。
+                { icon: <RegionEditRatioIcon ratio="1:1" dashed /> },
+              )}
+              {ratioOptions.map((ratio) =>
+                groupButton(
+                  `ratio-${ratio}`,
+                  ratio,
+                  params.ratio === (ratio as RegionEditRatio),
+                  () => patch({ ratio }),
+                  { icon: <RegionEditRatioIcon ratio={ratio} /> },
+                ),
+              )}
+            </div>
+          </div>
+
+          <div className="region-edit-param-group" role="group" aria-label={countLabel}>
+            <span className="region-edit-param-title">{countLabel}</span>
+            <div className="region-edit-param-row">
+              {regionEditCounts.map((count) =>
+                groupButton(`count-${count}`, t('menu.maskEdit.countValue', { count: String(count) }), params.count === count, () =>
+                  patch({ count: count as RegionEditCount }),
+                ),
+              )}
+            </div>
+          </div>
+        </div>
+      ) : null}
+    </span>
+  )
+}
