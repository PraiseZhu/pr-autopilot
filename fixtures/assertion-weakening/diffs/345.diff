+/**
+ * 对抗测试(oracle,不是实现):钉「有界取证 + 第三态 + 身份正证据」契约。
+ *
+ * 背景(main.js:1204-1265 §6.2 注释,主要看 ④⑤):当前实现只认两种终态 ——
+ * commit.committed===true(accepted)与 committed===false(一律 WRITE_DEFER_UNAVAILABLE,
+ * 并尝试补偿删除 `deferBodyPath(intentId)`)。这条测试文件钉的是**尚不存在**的第三条路:
+ * 写回执不可信(ok:false / 抛错)时,不能直接假定「没落盘」就去删 —— 必须先看一眼磁盘上
+ * 到底有没有东西、是不是我们刚才写的那份内容,再决定 WRITE_DEFERRED / WRITE_DEFER_INDETERMINATE
+ * / 保持现状。当前实现完全没有这一步(deferCommitBody / deferEnqueue 里没有任何 fsRead /
+ * fsReadResult / pendingProbe 调用),所以本文件的红是「缺一整段行为」,不是「一行判断写反了」。
+ *
+ * 每条断言拆成独立 `it`,这样每一行差异在测试报告里都单独可见,不会被前一条 throw 掩盖。
+ * 只读,不改动任何既有文件;只新增本文件。全部对**真实 main.js** 求值(brainHarness)。
+ */
+import { describe, expect, it } from 'vitest'
+import { flushMicrotasks, loadBrain, type LoadBrainOptions, type LoadedBrain } from './brainHarness'
+
+const BINDING_FILE = 'canvases/binding.json'
+const BINDING = JSON.stringify({ version: 1, bindingId: 'local-single', epoch: 0, sceneId: 'character-flow' })
+const DIR = 'pending-writes'
+
+const brainWith = (options: LoadBrainOptions = {}): LoadedBrain =>
+  loadBrain({ files: { [BINDING_FILE]: BINDING }, panelPresent: () => false, ...options })
+
+const bodyPaths = (brain: LoadedBrain): string[] =>
+  [...brain.files.keys()].filter((path) => path.startsWith(`${DIR}/i-`))
+
+const seedForeignBody = (over: { intentId: string; seq: number; text?: string }): string =>
+  JSON.stringify({
+    schemaVersion: 1,
+    intentId: over.intentId,
+    seq: over.seq,
+    verb: 'add-note',
+    params: { text: over.text ?? 'not ours' },
+    target: { bindingId: 'local-single', epoch: 0, sceneId: 'character-flow' },
+    createdAt: over.seq,
+    expiresAt: 9_999_999_999_999,
+    origin: { source: 'tool-call' },
+  })
+
+/** 场景①的公共 fixture:宿主谎报 ok:false,字节其实逐字节落盘。每个 it 独立跑一遍求干净状态。 */
+const landedButRejected = async (): Promise<{ brain: LoadedBrain; landedPath: string; result: Record<string, unknown> }> => {
+  let landedPath: string | undefined
+  const brain: LoadedBrain = brainWith({
+    writeOutcome: (request) => {
+      if (!request.path.startsWith(`${DIR}/i-`)) return undefined
+      landedPath = request.path
+      brain.files.set(request.path, request.content ?? '')
+      return 'reject'
+    },
+  })
+  const result = (await brain.handles.defer.enqueue('add-note', { text: 'ok bytes landed' })) as Record<
+    string,
+    unknown
+  >
+  if (!landedPath) throw new Error('fixture 没有触发到 pending-writes 的写请求,fixture 本身坏了')
+  return { brain, landedPath, result }
+}
+
+describe('①正证据: write 回执 ok:false 但字节实际落盘且内容全匹配 → 必须是 WRITE_DEFERRED,不是 UNAVAILABLE', () => {
