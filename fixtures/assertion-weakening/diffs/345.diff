+const BINDING = JSON.stringify({ version: 1, bindingId: 'local-single', epoch: 0, sceneId: 'character-flow' })
+const DIR = 'pending-writes'
+const PERSIST_CHANNEL = 'mivo-canvas-persist'
+const QUEUE_MAX = 64
+
+const brainWith = (options: LoadBrainOptions = {}): LoadedBrain =>
+  loadBrain({ files: { [BINDING_FILE]: BINDING }, panelPresent: () => false, ...options })
+
+const seedQueue = (count: number): Record<string, string> => {
+  const files: Record<string, string> = { [BINDING_FILE]: BINDING }
+  for (let i = 0; i < count; i += 1) {
+    const intentId = `intent-${i + 1}-seed-${i}`
+    files[`${DIR}/i-${intentId}.json`] = JSON.stringify({
+      schemaVersion: 1,
+      intentId,
+      seq: i + 1,
+      verb: 'add-note',
+      params: { text: `seed-${i}` },
+      target: { bindingId: 'local-single', epoch: 0, sceneId: 'character-flow' },
+      createdAt: 1,
+      expiresAt: 9_999_999_999_999,
+      origin: { source: 'tool-call' },
+    })
+  }
+  return files
+}
+
+const bodyKeys = (brain: LoadedBrain): string[] =>
+  [...brain.files.keys()].filter((path) => path.startsWith(`${DIR}/i-`))
+
+const bodyIntentIds = (brain: LoadedBrain): string[] =>
+  bodyKeys(brain).map((path) => (JSON.parse(brain.files.get(path)!) as { intentId: string }).intentId)
+
+/** 面板侧持久化桥替身(与 deferTransportReplay.test.ts 同形状):按 reqId 发请求、收回执。 */
+const openPersistBridge = (brain: LoadedBrain) => {
+  const channel = brain.bus.open(PERSIST_CHANNEL)
+  const replies: Array<Record<string, unknown>> = []
+  channel.onmessage = (event) => {
+    const data = event.data as Record<string, unknown> | undefined
+    if (data && data.reply === true) replies.push(data)
+  }
+  return {
+    replies,
+    send: async (reqId: string, payload: Record<string, unknown>) => {
+      const before = replies.filter((reply) => reply.reqId === reqId).length
+      channel.postMessage({ reqId, ...payload })
+      // 队列里可能有 60+ 条正文,pending-list/pending-ack 的 deferScan() 要逐条 await
+      // fsRead,默认预算(24 轮 × 8 跳)不够,调大而不是缩小种子队列掩盖真实 await 深度。
+      await flushUntil(() => replies.filter((reply) => reply.reqId === reqId).length > before, {
+        label: `persist 请求 ${reqId}(${String(payload.kind)})的回执`,
+        rounds: 400,
+        perRound: 20,
+      })
+      return replies.filter((reply) => reply.reqId === reqId).slice(-1)[0] as Record<string, unknown>
+    },
+  }
+}
+
+describe('①确定性并发: 63 条预置正文 + 2 个同时到达的入队请求,直调内部 enqueue', () => {
+  it('红: 过程与最终正文数不许突破 64,现实现两个都通过容量检查,最终落到 65 条', async () => {
+    const brain = brainWith({ files: seedQueue(63) })
+    expect(bodyKeys(brain)).toHaveLength(63) // 起始基线:确实是 63,不是别的数
+
+    // 不串行 await —— 两次调用几乎同时发起,分别走各自的「读→判→写」序列。
+    const [ra, rb] = await Promise.all([
+      brain.handles.defer.enqueue('add-note', { text: 'concurrent-A' }),
+      brain.handles.defer.enqueue('add-note', { text: 'concurrent-B' }),
+    ])
+    const resultA = ra as Record<string, unknown>
+    const resultB = rb as Record<string, unknown>
+
+    // 红:设计稿 §3.3 的硬上限是 64,现实现在这里落到 65。
+    expect(bodyKeys(brain).length).toBeLessThanOrEqual(QUEUE_MAX)
+    // 附带证据(供报告使用,不是本条的断言点):真实落地数。
+    console.info('[oracle] 并发 2 入队后正文总数 =', bodyKeys(brain).length, '结果 =', [resultA.ok, resultB.ok])
+  })
+
+  it('红: 恰好一个该收到 WRITE_QUEUE_FULL(容量检查若真的互斥,后到的那个应该被拒),现实现两个都 ok:true', async () => {
+    const brain = brainWith({ files: seedQueue(63) })
+    const [ra, rb] = await Promise.all([
+      brain.handles.defer.enqueue('add-note', { text: 'concurrent-A' }),
+      brain.handles.defer.enqueue('add-note', { text: 'concurrent-B' }),
+    ])
+    const codes = [ra, rb].map((r) => (r as Record<string, unknown>).code).filter(Boolean)
+    expect(codes.filter((code) => code === 'WRITE_QUEUE_FULL')).toHaveLength(1)
+  })
+
+  it('锁定(非红,防回归): 无论互斥修好与否,已经落盘的 intentId 都不许重复/覆盖', async () => {
+    const brain = brainWith({ files: seedQueue(63) })
+    await Promise.all([
+      brain.handles.defer.enqueue('add-note', { text: 'concurrent-A' }),
+      brain.handles.defer.enqueue('add-note', { text: 'concurrent-B' }),
+    ])
+    const ids = bodyIntentIds(brain)
+    expect(new Set(ids).size).toBe(ids.length)
+  })
+})
+
+describe('②真实接线: 2 个并发 canvas_add_note 工具调用(emitHostMessage)不受 mivo-canvas-persist 的 chain 保护', () => {
+  it('红: 面板侧权威视图(真实 pending-list 往返)最终看到的正文数突破 64,违反设计稿 §3.3 的硬上限承诺', async () => {
+    const brain = brainWith({ files: seedQueue(63) })
+    const persist = openPersistBridge(brain)
+
+    // 两次真实工具调用入口(不直调内部 enqueue):走 cindy.onHostMessage → handleToolCall
+    // → panelWriteReadiness()(1500ms panel-ping 超时)→ deferSubmit → deferEnqueue。
+    brain.emitHostMessage({ type: 'tool-call', tool: 'canvas_add_note', callId: 'call-A', args: { text: 'via tool call A' } })
+    brain.emitHostMessage({ type: 'tool-call', tool: 'canvas_add_note', callId: 'call-B', args: { text: 'via tool call B' } })
+
+    const settled = () => brain.cindySent.filter((item) => (item as { type?: string }).type === 'tool-result').length
+    const before = settled()
+    brain.clock.advance(2_000) // 两个 panel-ping 都超时,退回入队路径
+    // 63 条预置正文意味着每次 deferScan() 要串行 await 63 次 fsRead,两次并发调用合计
+    // 上百个微任务跳数,默认预算(24 轮 × 8 跳)远远不够 —— 调大预算,而不是缩小种子队列
+    // 掩盖真实的 await 深度。
+    await flushUntil(() => settled() >= before + 2, {
+      label: '两次 canvas_add_note 工具调用都交卷',
+      rounds: 400,
+      perRound: 20,
+    })
+
+    // 面板权威视图:通过真实 mivo-canvas-persist 频道(经 chain 串行化)读一次 pending-list。
+    const listReply = await persist.send('req-list-1', { kind: 'pending-list' })
+    const pendingWrites = listReply.pendingWrites as unknown[]
+
+    // 红:面板看到的权威队列长度超过 64 —— chain 串行化的 pending-list 本身没做错任何事,
+    // 但它权威呈现的目录实况已经被两条未经互斥保护的工具调用写坏了。
+    expect(pendingWrites.length).toBeLessThanOrEqual(QUEUE_MAX)
+  })
+
+  it('红: 两次工具调用都应该"恰一个被拒"(容量互斥),现实现两次都 tool-result ok:true(都被接受)', async () => {
+    const brain = brainWith({ files: seedQueue(63) })
+
+    brain.emitHostMessage({ type: 'tool-call', tool: 'canvas_add_note', callId: 'call-A', args: { text: 'via tool call A' } })
+    brain.emitHostMessage({ type: 'tool-call', tool: 'canvas_add_note', callId: 'call-B', args: { text: 'via tool call B' } })
+
+    const settled = () => brain.cindySent.filter((item) => (item as { type?: string }).type === 'tool-result').length
+    const before = settled()
+    brain.clock.advance(2_000)
+    await flushUntil(() => settled() >= before + 2, {
+      label: '两次 canvas_add_note 工具调用都交卷',
+      rounds: 400,
+      perRound: 20,
+    })
+
+    const results = brain.cindySent.filter(
+      (item) => (item as { type?: string }).type === 'tool-result',
+    ) as Array<{ callId: string; ok: boolean; errorCode?: string }>
+    const rejected = results.filter((r) => r.errorCode === 'WRITE_QUEUE_FULL')
+    expect(rejected).toHaveLength(1)
+  })
+})
