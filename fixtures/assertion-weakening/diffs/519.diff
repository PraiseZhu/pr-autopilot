+/**
+ * Mivo 分流契约测试的共享脚手架(SC v6 §3 PR-A 拆分列车 ②/③ 共用)。
+ *
+ * 背景(2026-08-04 事故):key 失效时上游 401 文案命中旧「未配置」正则,被静默改走
+ * Cindy 代办配额。修复后的契约测试分两个文件(mivoRouteConfig / mivoRouteSafety),
+ * 本文件提供共用的假上游、阶段分桶与 runOnce 驱动,断言都跑在真实 main.js 上。
+ */
+import { flushMicrotasks, flushUntil, loadBrain } from './brainHarness'
+import type { LoadBrainOptions, LoadedBrain } from './brainHarness'
+
+export const HASH = '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
+export const IMAGE_URL = `cindy-media://blobs/${HASH}.png`
+export const MEDIA = { url: IMAGE_URL, hash: HASH, ext: '.png', bytes: 4096 }
+export const SOURCE_HASH = 'fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210'
+export const FILE_ID = 'img0000000001'
+export const SIGNED_URL = 'https://mivo-oss.example.com/blobs/x.png?sig=abc'
+
+// 高熵合成 canary(32 位十六进制):不与任何安全文案共享 ≥8 字符子串。
+export const CANARY = 'f3a9c1e7b2d84065a1f0c9e3d7b5a482'
+
+export type FetchRequest = Record<string, unknown>
+export type FetchReply = { ok: boolean; status?: number; body?: string; media?: unknown; message?: string }
+
+export const jsonOk = (value: unknown): FetchReply => ({ ok: true, status: 200, body: JSON.stringify(value) })
+
+/** 直连假上游:全部端点按真实形状应答,override 注入单点故障。 */
+export const upstream = (override?: (request: FetchRequest) => FetchReply | null) => {
+  return (request: FetchRequest): FetchReply => {
+    const forced = override?.(request)
+    if (forced) return forced
+    const url = String(request.url ?? '')
+    if (request.upload) return jsonOk([{ object_id: 'upload-1' }])
+    if (url.endsWith('/message/chat')) return jsonOk({ object_id: 'chat-1' })
+    if (url.endsWith('/api/v1/message')) return jsonOk({ object_id: 'job-1' })
+    if (url.includes('/api/v1/message/job-')) return jsonOk({ content: { status: 'completed', images: [`/file/image/${FILE_ID}`] } })
+    if (url.includes('/api/v1/file/download/')) return { ok: true, status: 200, media: MEDIA }
+    if (url.includes('/api/v1/file/signUrl/')) return { ok: true, status: 200, body: `"${SIGNED_URL}"` }
+    if (url === SIGNED_URL) return { ok: true, status: 200, media: MEDIA }
+    return { ok: false, message: `假上游未覆盖: ${url}` }
+  }
+}
+
+/** 出站请求分桶(证明「到达了哪个阶段、没到哪个阶段」的判据)。 */
+export const stageCounts = (fetches: FetchRequest[]) => {
+  const urls = fetches.map((r) => String(r.url ?? ''))
+  return {
+    chat: urls.filter((u) => u.endsWith('/message/chat')).length,
+    upload: fetches.filter((r) => Boolean(r.upload)).length,
+    submit: urls.filter((u) => u.endsWith('/api/v1/message')).length,
+    poll: urls.filter((u) => u.includes('/api/v1/message/job-')).length,
+    download: urls.filter((u) => u.includes('/file/download/') || u === SIGNED_URL || u.includes('/file/signUrl/')).length,
+  }
+}
+
+export type RunOptions = {
+  kind?: 'gen' | 'edit'
+  fetch?: LoadBrainOptions['fetch']
+  localFetch?: LoadBrainOptions['localFetch']
+  secretSaved?: boolean
+  hostReply?: Record<string, unknown> | (() => unknown)
+  reqId?: string
+  advanceMs?: number
+  /** 复用已有 brain(测「同一 brain 连续多单」时用);缺省新建。 */
+  brain?: BrainRun
+}
+
+export type BrainRun = {
+  brain: LoadedBrain
+  cindyRequests: Array<Record<string, unknown>>
+  replies: Array<Record<string, unknown>>
+}
+
+export const makeBrain = (options: RunOptions): BrainRun => {
+  const cindyRequests: Array<Record<string, unknown>> = []
+  const brain = loadBrain({
+    panelPresent: () => false,
+    locale: 'zh-CN',
+    fetch: options.fetch,
+    localFetch: options.localFetch,
+    secretSaved: options.secretSaved,
+    send: (payload) => {
+      const message = (payload ?? {}) as Record<string, unknown>
+      if (message.type === 'cindy-request') {
+        cindyRequests.push(message)
+        const reply = options.hostReply
+        if (typeof reply === 'function') return reply()
+        return reply ?? { ok: true, hash: HASH, ext: '.png', url: IMAGE_URL, width: 1024, height: 1024, modelLabel: 'Cindy 代办模型' }
+      }
+      return { ok: true }
+    },
+  })
+  const replies: Array<Record<string, unknown>> = []
+  const persist = brain.bus.open('mivo-canvas-persist')
+  persist.onmessage = (event) => {
+    const data = event.data as Record<string, unknown>
+    if (data && data.reply === true) replies.push(data)
+  }
+  return { brain, cindyRequests, replies }
+}
+
+export const runOnce = async (options: RunOptions = {}): Promise<BrainRun & { reply: Record<string, unknown> }> => {
+  const run = options.brain ?? makeBrain(options)
+  if (!options.brain) await flushMicrotasks()
+  const before = run.replies.length
+  const reqId = options.reqId ?? `req-${Math.random().toString(36).slice(2)}`
+  const msg =
+    options.kind === 'edit'
+      ? { reqId, kind: 'edit-image', prompt: '改一下', hashes: [SOURCE_HASH], callId: 'call-e' }
+      : { reqId, kind: 'gen-image', prompt: '一只柴犬', callId: 'call-g' }
+  run.brain.handles.handleGenImage(msg)
+  await flushMicrotasks()
+  await flushUntil(() => run.replies.length > before, {
+    label: 'handleGenImage 回执',
+    rounds: 64,
+    advanceEachRound: () => run.brain.clock.advance(options.advanceMs ?? 0),
+  })
+  return { ...run, reply: run.replies[run.replies.length - 1] }
+}
+
