+describe('CLI 端到端(consume/mark-fixed 子命令,取锁 + 落盘 + appendLog)', () => {
+  const runCli = (args) => {
+    const stdout = execFileSync(process.execPath, [CLI, ...args], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] })
+    return JSON.parse(stdout.trim().split('\n').at(-1))
+  }
+
+  it('consume 子命令:取锁、消费、落 state、appendLog(含 sentry=<status>)', () => {
+    const dateStr = '2026-08-02'
+    writeFindings(dateStr, [finding({ fingerprint: fp('cli1') })])
+    const r = runCli(['consume', '--date', dateStr, '--state-dir', stateDir, '--findings-dir', dir])
+    expect(r.status).toBe('consumed')
+    const logs = readFileSync(join(stateDir, 'logs.md'), 'utf8')
+    expect(logs).toContain('sentry=consumed')
+    const state = JSON.parse(readFileSync(join(stateDir, 'state.json'), 'utf8'))
+    expect(state.clusters[fp('cli1')]).toBeTruthy()
+  })
+
+  it('mark-fixed 子命令:经 --pr-view-json 注入 gh 结果,跳过真实 gh 调用', () => {
+    const dateStr = '2026-08-02'
+    writeFindings(dateStr, [finding({ fingerprint: fp('cli2') })])
+    runCli(['consume', '--date', dateStr, '--state-dir', stateDir, '--findings-dir', dir])
+    const prViewPath = join(dir, 'pr-view.json')
+    writeFileSync(prViewPath, JSON.stringify({ number: 7, mergedAt: '2026-08-02T12:00:00.000Z', mergeCommit: { oid: 'abc123' } }))
+    const r = runCli(['mark-fixed', '--fp', fp('cli2'), '--pr', '7', '--state-dir', stateDir, '--pr-view-json', prViewPath])
+    expect(r.ok).toBe(true)
+    const state = JSON.parse(readFileSync(join(stateDir, 'state.json'), 'utf8'))
+    expect(state.clusters[fp('cli2')].status).toBe('fixed')
