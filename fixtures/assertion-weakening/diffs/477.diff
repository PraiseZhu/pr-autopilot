+  it('成功路径:mergedAt≠null 且号匹配 → 写 fixed/fixedAt/pr/mergeSha;之后同文件重跑不复发,新日期晚于 fixedAt 转 recurrent', () => {
+    const state = defaultState(FINGERPRINT_VERSION)
+    seedCluster(state)
+    const r = applyMarkFixed(state, { fp: fp('mf1'), prNumber: 42, prView: { number: 42, mergedAt: '2026-08-02T00:00:00.000Z', mergeCommit: { oid: 'deadbeef' } } })
+    expect(r.ok).toBe(true)
+    expect(state.clusters[fp('mf1')].status).toBe('fixed')
