+    const schemaBefore = state.schemaVersion
+    saveState(stateDir, state)
+    const reloaded = loadState(stateDir, FINGERPRINT_VERSION)
+    expect('sentryIntake' in reloaded && reloaded.sentryIntake !== undefined).toBe(false)
+    expect(reloaded.schemaVersion).toBe(schemaBefore)
+    // 再走一轮往返,仍不长出
