+describe('SC-B2V2-04 sentryIntake 节持久化往返(stableState 未知节保留 + 旧台账兼容)', () => {
+  it('consume 产生的 sentryIntake 节经 saveState/loadState 往返不丢、内容等值', () => {
+    const dateStr = '2026-08-02'
