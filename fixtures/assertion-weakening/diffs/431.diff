+        if (rebuilt !== undefined) {
+          scanStringAsCss(rel, sourceFile, node.getStart(sourceFile), rebuilt)
+        }
+      }
+      ts.forEachChild(node, (child) => {
+        visit(child)
+      })
+    }
+    visit(sourceFile)
+  }
+}
