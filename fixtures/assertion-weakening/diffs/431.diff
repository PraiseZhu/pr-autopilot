+      if (hits !== entry.expectedCount) {
+        failures.push(`豁免账本失配:${rel}(${kind})命中 ${hits} 次,登记 expectedCount=${entry.expectedCount}——多出的是蹭豁免的新违规,少了说明豁免已 stale,两者都必须处理`)
