+          const { line } = sourceFile.getLineAndCharacterOfPosition(node.getStart(sourceFile))
+          failures.push(`${rel}:${line + 1} ${target} 自增/自减无法静态断言在白名单内,禁止`)
+        }
+      }
+      // 类字段:class Style { fontWeight = 600 }(第七轮审查建议1)
+      if (ts.isPropertyDeclaration(node) && node.initializer && (ts.isIdentifier(node.name) || ts.isStringLiteralLike(node.name))) {
+        const classProp = canonicalStyleProp(node.name.text)
+        if (classProp === 'fontWeight' || classProp === 'fontSize') {
+          for (const entry of styleValuesIn(node.initializer, sourceFile)) {
+            checkAstValue(classProp === 'fontWeight' ? 'weight' : 'size', rel, sourceFile, entry)
+          }
+        }
+      }
+      // setProperty / setAttribute('font-weight'|'font-size', value);方法名兼收
+      // PropertyAccess(style.setProperty)与 ElementAccess(style['setProperty'])
+      if (ts.isCallExpression(node) && node.arguments.length >= 2) {
+        const methodName = ts.isPropertyAccessExpression(node.expression)
+          ? node.expression.name.text
+          : ts.isElementAccessExpression(node.expression)
+            ? staticStringValueOf(node.expression.argumentExpression, sourceFile)
+            : undefined
