+const checkAstInlineStyles = () => {
+  for (const file of allFiles) {
+    if (!/\.(ts|tsx|jsx|js|mjs|cjs)$/i.test(file)) continue
+    const rel = relOf(file)
+    if (isTestFile(rel)) continue
+    const lower = file.toLowerCase()
+    const scriptKind = lower.endsWith('.tsx') ? ts.ScriptKind.TSX : lower.endsWith('.jsx') ? ts.ScriptKind.JSX : /\.(js|mjs|cjs)$/.test(lower) ? ts.ScriptKind.JS : ts.ScriptKind.TS
