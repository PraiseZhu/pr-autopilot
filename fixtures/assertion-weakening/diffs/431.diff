+const tsSourceOf = (rel) => {
+  const lowerRel = rel.toLowerCase()
+  const scriptKind = lowerRel.endsWith('.tsx') ? ts.ScriptKind.TSX : lowerRel.endsWith('.ts') ? ts.ScriptKind.TS : ts.ScriptKind.JS
+  return ts.createSourceFile(rel, readRaw(rel), ts.ScriptTarget.Latest, true, scriptKind)
+}
