+#!/usr/bin/env node
+// MivoCanvas 设计 token 镜像守卫 (Design Token Mirror) v9 — issue #425
+//
+// docs/design.md 的 YAML front matter 是 src/App.css 设计 token 的机器可读镜像。
+// 本脚本给镜像装牙齿,三件事(v9 = 第九轮终盘枚举后的版本;v8 修复见 fixture 对应 describe):
+//
+//  ① token 镜像 diff — front matter 的 colors/rounded/spacing 逐项对照代码:
+//     - cssProp:选择器级绑定,**不建模 cascade**。目标选择器(prelude 逗号拆分后
+//       精确相等)在任何上下文、任意 importance 的每一条该属性声明都必须命中 token;
+//       声明只取规则体深度 0;零声明红。contains 匹配的 hex 按完整 token 边界
+//       (/#[\w-]+/ 全等,#159bff00/#159bffg 这类前缀伪装不命中);
+//     - var:变量**全索引**(任意选择器、任意上下文)三分类——目标 scope 顶层 →
+//       canonical(非空且唯一);命中 variants 白名单(scope + 完整 at-rule 栈精确
+//       相等 + 值,三元组)→ 点名放行;其余一律红。另有"原始文本声明数 ≡ 解析归属数"
+//       一致性门,CSS nesting 里逃出解析的声明 fail-closed;
+//     - notePreset / tsConst:TS AST,只认 SourceFile 顶层声明且全文件同名计数 =1
+//       (嵌套诱饵红);preset 的 label 集合与 MIRROR_MAP 双向核对(多/少/缺 value/
+//       paleYellow 未绑定 defaultNoteFillColor 均红);
+//     - 反向:front matter 出现但未登记的 key → FAIL。
+//     front matter 是严格子集校验(裸 #/单引号/重复键/Tab 一律 FAIL)。
+//  ② font-weight 白名单 {400,500,700,800} ③ font-size 白名单
+//     UI {9-14} + 内容 {15,16,18,20,22,24,28,30}。扫描面 = 仓根整树,排除表是
+//     仓根相对前缀逐条带理由(EXCLUDED_PREFIXES),不泛化跳隐藏目录:
+//     - css/html/svg/xml **raw 文本**:大小写不敏感;font-weight 只收梯内整数;
+//       font-size 抽取值内全部带符号 px 字面量;`font:` 声明只允许 inherit;
+//       html/svg/xml 另扫 presentation attribute(属性名带左边界防误伤 data-*,
+//       值兼收双引号/单引号/合法无引号);
+//     - ts/tsx/jsx/js/mjs/cjs **只走 AST**(不对 raw 源码做注释剥离——那会把字符串
+//       内容里的 " // " 误当注释吞掉后半行):字符串/模板字面量内容提取后喂同一个
+//       CSS 扫描器;PropertyAssignment(identifier/字符串键/computed 键/kebab 键
+//       归一)、ShorthandPropertyAssignment(同名声明溯源;{font} 同样)、赋值
+//       (设值集 {=, ||=, ??=, &&=} 校验右侧;FirstAssignment..LastAssignment 区间
+//       其余复合赋值与 ++/-- 一律红)、解构默认值、JSX attribute(camel+kebab)、
+//       defaultTextWeight 声明、setProperty/setAttribute(Property/ElementAccess
+//       双形态)。`.font = '静态串'` 是 Canvas 2D 合法 shorthand:提取 leading 字重
+//       与全部 px 逐一校验,解析不出即红;对象样式 { font: ... } 仍只许 'inherit'。
+//       Identifier 溯源仅限值位置根标识符(变量/参数默认值/解构默认值 initializer,
+//       递归+环守卫);纯数字算术常量折叠(600*1 红),含动态项算术(r*1.1)放行。
+//     豁免是值级+账本登记(文件+允许值+expectedCount+理由):命中逐条输出,命中数
+//     ≠ expectedCount 即红(蹭豁免的新违规与 stale 豁免都关不掉)。
+//
+// 登记在案的可审计盲区(不是静默漏扫;第九轮终盘枚举定稿——本守卫的口径是
+// "fail-closed 覆盖仓内现实写法 + 显式登记静态分析不可完备求解的开放集合",
+// 不宣称"全入口"):
+//   1. **跨文件常量引用**(import 后用作样式值/属性名):标识符溯源只在单文件内;
+//      跨文件需 TS Program/TypeChecker,成本收益不成比例,由 review 兜底。
+//   2. **运行时纯动态值**(参数透传、网络数据、用户内容):静态守卫天然不覆盖;
+//      字重在持久化节点入口有 normalizeFontWeight 向下吸附兜底,字号无等价兜底。
+//   3. **反射/元编程 API**(Reflect.set、Object.defineProperty、Proxy)与**运行时
+//      拼接的动态属性名**(静态不可求值的 computed key):不在治理面;仓内样式
+//      写入无此惯用法,新增此类写法属 review 必拦项。
+//   4. **同文件成员访问/访问器间接层**(const o={w:600}; fontWeight:o.w、
+//      get fontWeight(){return 600}):标识符溯源只解析"值位置根标识符"的直接
+//      声明 initializer,不做成员级数据流;深一层的静态值由 review 兜底。
+//   5. **转义/实体绕过**(CSS escaped ident 如 font-\77 eight、HTML entity 如
+//      font&#45;weight、JS escaped identifier):守卫不做规范化解码;App.css 的
+//      自定义属性名含反斜杠已 fail-closed,其余登记不治理。
+//   6. **JSON/资源文件内的样式数据**:非样式源码载体,不扫描。
+//
+// fixture 测试:scripts/ci/design-token-mirror.test.mjs(MIVO_GUARD_ROOT + spawn 真脚本)。
+// 退出码:0=通过(允许豁免提示),1=有 FAIL。
+
+import { existsSync, readFileSync, readdirSync, lstatSync } from 'node:fs'
+import { join, relative, resolve, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import ts from 'typescript'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+const REPO_ROOT = process.env.MIVO_GUARD_ROOT ? resolve(process.env.MIVO_GUARD_ROOT) : resolve(__dirname, '..', '..')
+
+const DESIGN_MD = join(REPO_ROOT, 'docs', 'design.md')
+const APP_CSS = join(REPO_ROOT, 'src', 'App.css')
+
+const FONT_WEIGHT_LADDER = new Set([400, 500, 700, 800])
+const FONT_SIZE_WHITELIST = new Set([9, 10, 11, 12, 13, 14, 15, 16, 18, 20, 22, 24, 28, 30])
+
+// 仓根相对前缀排除表(精确前缀,逐条理由;不按 basename、不泛化跳隐藏目录)。
+const EXCLUDED_PREFIXES = [
+  ['.git', 'VCS 内部数据'],
+  ['.claude', 'agent 会话配置/工作树'],
+  ['node_modules', '第三方依赖'],
+  ['cindyplugin/node_modules', '第三方依赖(插件侧,若存在)'],
+  ['dist', '构建产物(镜像自源码,源码已扫)'],
+  ['cindyplugin/dist', '插件构建产物(同上)'],
+  ['history', 'ECC 会话数据,不入 git'],
+  ['test-artifacts', '测试运行产物'],
+  ['_tmp', '临时目录'],
+  ['references', '外部参考材料,非本仓源码'],
+  ['data', '数据文件目录'],
+  ['bench/fixtures', '基准夹具数据(画布文档 JSON,用户内容路径)'],
+  ['bench/baselines', '基准基线产物'],
+  // 注意:bench/pixi-probe 与 scripts/bench 的**源码**在扫描面内(第五轮审查项1:
+  // 目录级排除曾漏掉 pixi-probe/index.html 的真实 font shorthand);fixture-lib 往画布
+  // 节点数据写的 600 走值级豁免(见 FONT_WEIGHT_EXEMPT),不整目录放行。
+  ['.cindy-worktrees', 'agent 并行工作树(本仓副本,主树已扫,副本可能停在任意历史版本)'],
+  ['docs/design-previews/region-edit/assets', '组件模式构建产物(esbuild bundle + 机械生成的 product.css;源码已扫,product.css 另有 gate X 逐字节比对)'],
+]
+
+// 值级豁免:文件 → { values, expectedCount, reason }。命中逐条输出;values 之外的
+// 新违规照样 FAIL;且**命中次数必须精确等于 expectedCount**(第六轮审查项3:同值
+// 整文件通行证会放过同文件同值的新 UI 违规,登记语义消失也不会红)——多命中(新增
+// 同值违规)红、少命中(豁免 stale,原语义已删)也红。文件不存在时跳过账本
+// (fixture 最小根没有这些文件)。
+const FONT_SIZE_EXEMPT = {
+  'src/app/InspectorPanel.tsx': {
+    values: new Set([17, 42]),
+    expectedCount: 2,
+    marker: 'Math.min(42, Math.max(17,',
+    reason: 'Inspector 预览是用户文本内容的等比镜像,Math.min(42, Math.max(17, ...)) 夹取值非 UI 字号',
+  },
+}
+const FONT_WEIGHT_EXEMPT = {
+  'scripts/bench/fixture-lib.mjs': {
+    values: new Set([600]),
+    expectedCount: 1,
+    marker: 'textIndex % 4 === 0 ? 600 : 500',
+    reason: 'bench fixture 生成器往画布**节点数据**写字重(用户内容路径,#425 不治理);600 是刻意的历史值样本',
+  },
+}
+const exemptHitCounts = new Map()
+
+// front matter key → 代码侧对照方式。cssProp.match:exact=归一化等值(单值属性),
+// contains=包含(outline/border-color 这类复合值或 var() fallback)。
+const MIRROR_MAP = {
+  colors: {
+    ink: { kind: 'var', cssVar: '--ink', scope: ':root' },
+    muted: { kind: 'var', cssVar: '--muted', scope: ':root' },
+    quiet: { kind: 'var', cssVar: '--quiet', scope: ':root' },
+    line: { kind: 'var', cssVar: '--line', scope: ':root' },
+    'line-strong': { kind: 'var', cssVar: '--line-strong', scope: ':root' },
+    panel: { kind: 'var', cssVar: '--panel', scope: ':root' },
+    'panel-2': { kind: 'var', cssVar: '--panel-2', scope: ':root' },
+    canvas: { kind: 'var', cssVar: '--canvas', scope: ':root' },
+    charcoal: { kind: 'var', cssVar: '--charcoal', scope: ':root' },
+    moss: { kind: 'var', cssVar: '--moss', scope: ':root' },
+    rust: { kind: 'var', cssVar: '--rust', scope: ':root' },
+    ochre: { kind: 'var', cssVar: '--ochre', scope: ':root' },
+    blue: { kind: 'var', cssVar: '--blue', scope: ':root' },
+    violet: { kind: 'var', cssVar: '--violet', scope: ':root' },
+    'region-mark': { kind: 'var', cssVar: '--region-mark', scope: ':root' },
+    'region-rect-mark': { kind: 'var', cssVar: '--region-rect-mark', scope: ':root' },
+    'region-point-mark': { kind: 'var', cssVar: '--region-point-mark', scope: ':root' },
+    'region-remove-bg': { kind: 'var', cssVar: '--region-remove-bg', scope: ':root' },
+    'region-error-mark': { kind: 'var', cssVar: '--region-error-mark', scope: ':root' },
+    selection: { kind: 'var', cssVar: '--violet', scope: ':root' }, // 选中态主色 = violet,语义别名
+    'section-selection': { kind: 'cssProp', file: 'src/App.css', selector: '.dom-node.frame-node.selected', property: 'outline', match: 'component' },
+    'section-border-default': {
+      kind: 'cssProp',
+      file: 'src/App.css',
+      selector: '.dom-frame-node',
+      property: 'border-color',
+      match: 'varFallback',
+      varName: '--section-border-color',
+      // 登记的合法上下文覆盖:拖放目标态高亮(边框变 violet 是刻意的交互反馈,
+      // 值按登记校验;新增其他上下文覆盖仍红)
+      allowedContextual: [{ selector: '.dom-node.frame-node.section-drop-target .dom-frame-node', value: 'var(--violet)' }],
+    },
+    'quickbar-bg': { kind: 'cssProp', file: 'src/App.css', selector: '.selection-quick-toolbar', property: 'background', match: 'exact' },
+    'quickbar-ink': { kind: 'cssProp', file: 'src/App.css', selector: '.selection-quick-toolbar', property: 'color', match: 'exact' },
+    'note-pink': { kind: 'notePreset', label: 'menu.color.palePink' },
+    'note-yellow': { kind: 'tsConst', file: 'src/model/markupStyleDefaults.ts', constName: 'defaultNoteFillColor' },
+    'note-blue': { kind: 'notePreset', label: 'menu.color.paleBlue' },
+    'note-green': { kind: 'notePreset', label: 'menu.color.paleGreen' },
