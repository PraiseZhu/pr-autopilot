+// 变量**全索引**(第五轮审查项2:只看目标 scope 会漏异 scope 重声明,条件覆盖一律
+// note 会把 320→999 也当响应式假绿):收集该变量在 App.css **任意选择器、任意上下文**
+// 的全部声明,逐条分类:
+//   a) 目标 scope + 顶层 → canonical(要求非空且值全一致);
+//   b) 命中 rule.variants 显式白名单(scope+at-rule 前缀+值 三元组全对)→ 点名放行;
+//   c) 其余(异 scope、未登记的条件覆盖、值不符的"响应式"改动)→ 红。
+const cssVarDeclarations = (cssVar) => {
+  const decls = []
+  for (const rule of cssRulesOf('src/App.css')) {
+    for (const m of stripNestedBlocks(rule.body).matchAll(new RegExp(`(?:^|;)\\s*${cssVar}\\s*:\\s*([^;]+)`, 'g'))) {
+      decls.push({
+        selectors: rule.selectors,
+        context: rule.context,
+        value: m[1].trim().replace(/\s*!important\s*$/i, ''),
+      })
+    }
+  }
+  return decls
+}
