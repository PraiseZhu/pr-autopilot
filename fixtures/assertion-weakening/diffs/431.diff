+          for (const decl of declarationsByName(sourceFile, node.name.text)) {
+            for (const entry of styleValuesIn(decl, sourceFile)) checkAstValue(kind, rel, sourceFile, entry)
+          }
+        }
+        if (shortProp === 'font') {
+          for (const decl of declarationsByName(sourceFile, node.name.text)) {
