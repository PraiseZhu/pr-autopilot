+  // 纯"文件+值+次数"可被等量替换把豁免搬给任意违规)+ 账本 expectedCount
+  if (exempt && exempt.values.has(value) && (!exempt.marker || String(snippet || '').includes(exempt.marker))) {
+    const ledgerKey = `${kind}:${rel}`
