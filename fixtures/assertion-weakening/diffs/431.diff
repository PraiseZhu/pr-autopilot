+        if (methodName === 'setProperty' || methodName === 'setAttribute' || methodName === 'setAttributeNS') {
+          const nsShift = methodName === 'setAttributeNS' ? 1 : 0
+          const propNode = node.arguments[nsShift]
+          const valueNode = node.arguments[nsShift + 1]
+          const resolvedProp = staticStringValueOf(propNode, sourceFile)
+          if (propNode && valueNode && resolvedProp !== undefined) {
+            const propArg = resolvedProp.toLowerCase()
+            if (propArg === 'font-weight' || propArg === 'font-size') {
+              const kind = propArg === 'font-weight' ? 'weight' : 'size'
+              for (const entry of styleValuesIn(valueNode, sourceFile)) checkAstValue(kind, rel, sourceFile, entry)
