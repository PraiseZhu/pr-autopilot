+  for (const file of allFiles) {
+    if (!/\.(html|svg|xml)$/i.test(file)) continue
+    const rel = relOf(file)
+    if (isTestFile(rel)) continue
+    const text = readFileSync(file, 'utf8')
+    for (const m of text.matchAll(/<script\b([^>]*)>([\s\S]*?)<\/script>/gi)) {
+      const typeMatch = (m[1] || '').match(/type\s*=\s*["']?([\w/+.-]+)/i)
+      if (typeMatch && !/(javascript|module|ecmascript|jsx?)$/i.test(typeMatch[1])) continue
+      const content = m[2]
+      if (!content.trim()) continue
+      const startLine = lineOf(text, m.index + m[0].indexOf(content))
+      scanJsAst(rel, '\n'.repeat(Math.max(0, startLine - 1)) + content, ts.ScriptKind.JS, `${file}#inline-script`)
+    }
+  }
