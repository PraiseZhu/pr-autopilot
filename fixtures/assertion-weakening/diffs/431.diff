+const checkExemptionLedger = () => {
+  for (const [kind, table] of [['size', FONT_SIZE_EXEMPT], ['weight', FONT_WEIGHT_EXEMPT]]) {
+    for (const [rel, entry] of Object.entries(table)) {
+      if (!existsSync(join(REPO_ROOT, rel))) continue
