+const underStringish = (node) => {
+  const parent = node.parent
+  return !!parent && (isStringish(parent) || ts.isTemplateSpan(parent))
+}
+const DYN_PLACEHOLDER = '\x00DYN\x00'
+const staticStringOf = (node, sourceFile) => {
+  if (ts.isStringLiteralLike(node)) return node.text
+  if (ts.isNumericLiteral(node)) return node.text
+  if (ts.isParenthesizedExpression(node)) return staticStringOf(node.expression, sourceFile)
+  if (ts.isTemplateExpression(node)) {
+    let out = node.head.text
+    for (const span of node.templateSpans) {
+      const part = staticStringOf(span.expression, sourceFile)
+      out += (part === undefined ? DYN_PLACEHOLDER : part) + span.literal.text
+    }
+    return out
+  }
+  if (ts.isBinaryExpression(node)) {
+    if (node.operatorToken.kind === ts.SyntaxKind.PlusToken) {
+      const left = staticStringOf(node.left, sourceFile)
+      const right = staticStringOf(node.right, sourceFile)
+      // 任一侧含字符串语义即按拼接;两侧都解析不出时给占位
+      return `${left === undefined ? DYN_PLACEHOLDER : left}${right === undefined ? DYN_PLACEHOLDER : right}`
+    }
+    const folded = evalStaticNumber(node)
+    return folded === undefined ? undefined : String(folded)
+  }
+  const folded = evalStaticNumber(node)
+  return folded === undefined ? undefined : String(folded)
