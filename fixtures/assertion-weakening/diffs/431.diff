+  if (topLevelCount !== 1 || totalCount !== 1) {
+    failures.push(`${context}:${rel} 中 ${constName} 声明数异常(顶层 ${topLevelCount} / 全文件 ${totalCount},要求各为 1)——嵌套同名诱饵或重复声明,fail-closed`)
