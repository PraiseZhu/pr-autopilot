+// 字符串族节点判定与静态重建。TemplateExpression 的静态插值(数字/字符串/纯数字算术)
+// 内联为文本;动态插值以 \x00DYN\x00 占位(不会拼出伪造的 CSS 数值);字符串 + 拼接
+// 同规则递归折叠。
+const isStringish = (node) =>
+  node && (ts.isStringLiteralLike(node) || ts.isTemplateExpression(node) || (ts.isBinaryExpression(node) && node.operatorToken.kind === ts.SyntaxKind.PlusToken))
