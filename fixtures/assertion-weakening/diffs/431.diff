+    addFile(root, 'src/app/InspectorPanel.tsx', 'export const s = { fontSize: 24 }\nexport const rogueUi = { fontSize: Math.min(42, 17) }\n')
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toMatch(/17|42|豁免账本失配/)
+  })
+
+  it('fixture-lib 等量替换(节点数据 600→500 + CSS 字符串 600)→ FAIL', () => {
+    const root = makeFixture()
+    addFile(root, 'scripts/bench/fixture-lib.mjs', "export const rogueCss = '.rogue-ui{font-weight:600}'\n")
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toMatch(/600|豁免账本失配/)
+  })
+})
+
+describe('design-token-mirror v8 红测 — AST 补漏与 escape(第七轮审查建议1/3)', () => {
+  it('class 字段(fontWeight=600)、静态 computed key(s[k]=600)、setAttributeNS → 全部 FAIL', () => {
+    const root = makeFixture()
+    addFile(
+      root,
+      'src/canvas/rogue.ts',
+      [
+        'export class Style { fontWeight = 600; fontSize = 17 }',
+        "const k = 'fontWeight'",
+        'export const f = (s: Record<string, number>) => { s[k] = 600 }',
+        "export const g = (el: SVGElement) => el.setAttributeNS(null, 'font-weight', '600')",
+      ].join('\n') + '\n',
+    )
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toContain('600')
+    expect(output).toContain('17')
+  })
+
+  it('CSS escape 变量名(--vio\\00006cet)→ FAIL(fail-closed 不解码)', () => {
+    const root = makeFixture()
+    const abs = join(root, 'src/App.css')
+    writeFileSync(abs, readFileSync(abs, 'utf8') + '\n:root {\n  --vio\\00006cet: #123456;\n}\n')
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toContain('escape')
+  })
+})
+
+describe('design-token-mirror v9 红测 — 终盘 P1(第九轮)', () => {
+  it('P1-A:注释里伪造 marker 蹭豁免 → FAIL(marker 匹配前剥注释)', () => {
+    const root = makeFixture()
+    addFile(
+      root,
+      'src/app/InspectorPanel.tsx',
+      'export const a = { fontSize: 17 } // Math.min(42, Math.max(17,\nexport const b = { fontSize: 42 } // Math.min(42, Math.max(17,\n',
+    )
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toMatch(/17|42|豁免账本失配/)
+  })
+
+  it('P1-B:登记 contextual 选择器里"登记值+漂移值"双声明 → FAIL(恰好 1 条且值一致)', () => {
+    const root = makeFixture()
+    poison(
+      root,
+      'src/App.css',
+      '.dom-node.frame-node.section-drop-target .dom-frame-node {\n  border-color: var(--violet);',
+      '.dom-node.frame-node.section-drop-target .dom-frame-node {\n  border-color: var(--violet);\n  border-color: #123456;',
+    )
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toContain('section-border-default')
+  })
+
+  it('P1-C:大写扩展名(src/Rogue.TSX / src/Rogue.CSS)→ FAIL(扩展判定不区分大小写)', () => {
+    const root = makeFixture()
+    addFile(root, 'src/Rogue.TSX', 'export const S = () => <span style={{ fontWeight: 600 }}>x</span>\n')
+    addFile(root, 'src/Rogue.CSS', '.x { font-weight: 600; }\n')
+    const { code, output } = runGuard(root)
+    expect(code).toBe(1)
+    expect(output).toContain('600')
+  })
+
+  it('P1-D:静态属性名间接/拼接(setProperty(k,..)、setAttribute("font-"+"weight")、[k2]:600、setAttributeNS)→ 全部 FAIL', () => {
+    const root = makeFixture()
+    addFile(
+      root,
+      'src/canvas/rogue.ts',
+      [
+        "const k = 'font-weight'",
+        "export const a = (style: CSSStyleDeclaration) => style.setProperty(k, '600')",
+        "export const b = (el: SVGElement) => el.setAttribute('font-' + 'weight', '600')",
+        "export const c = { ['font' + 'Weight']: 600 }",
+        "export const d = (s: Record<string, number>) => { s['font' + 'Weight'] = 600 }",
+      ].join('\n') + '\n',
+    )
+    const bad = runGuard(root)
+    expect(bad.code).toBe(1)
+    expect(bad.output).toContain('600')
+    const root2 = makeFixture()
+    addFile(root2, 'src/canvas/rogue2.ts', "export const g = (el: SVGElement) => el.setAttributeNS(null, 'font-weight', '600')\n")
+    const bad2 = runGuard(root2)
+    expect(bad2.code).toBe(1)
+    expect(bad2.output).toContain('600')
+  })
+})
+
+describe('design-token-mirror v9 补丁 — symlink 遍历边界(PR #431 review)', () => {
+  it('指向祖先目录的符号链接不跟随:不挂死、不越界扫描,正常完成', () => {
+    const root = makeFixture()
+    const { symlinkSync } = require('node:fs')
+    symlinkSync(root, join(root, 'src', 'loop-link'))
+    const { code, output } = runGuard(root)
+    expect(output).toContain('OK')
+    expect(code).toBe(0)
+  })
+})
