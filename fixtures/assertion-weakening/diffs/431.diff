+    'sidebar-width': { kind: 'var', cssVar: '--project-sidebar-w', scope: '.mivo-app' },
+    'ai-panel-width': {
+      kind: 'var',
+      cssVar: '--ai-panel-w',
+      scope: '.mivo-app',
+      // 唯一登记的响应式变体:窄屏 340→320(design.md Known Gaps 有对应事实)。改动
+      // 这个值或新增其他条件覆盖都必须先回到这里登记,否则红。
+      variants: [{ scope: '.mivo-app', context: '@media (max-width: 980px)', value: '320px' }],
+    },
+    'ai-panel-collapsed': { kind: 'var', cssVar: '--ai-panel-collapsed-w', scope: '.mivo-app' },
+  },
+}
+const NOTE_PRESETS_FILE = 'src/canvas/actions/markupStylePresets.ts'
+
+const failures = []
+const notes = []
+
+const normalizeValue = (value) => value.toLowerCase().replace(/\s+/g, '').replace(/;$/, '')
+// 剥注释时保留换行与字符位(注释体非换行字符置空格):file:line 报告必须可信
+// (第五轮审查建议2:直接删注释会让行号漂移)
+const blankNonNewline = (m) => m.replace(/[^\n]/g, ' ')
+const stripBlockComments = (text) => text.replace(/\/\*[\s\S]*?\*\//g, blankNonNewline).replace(/<!--[\s\S]*?-->/g, blankNonNewline)
+const stripLineComments = (text) => text.replace(/^\s*\/\/.*$/gm, blankNonNewline).replace(/\s\/\/\s.*$/gm, blankNonNewline)
+const lineOf = (text, index) => text.slice(0, index).split('\n').length
+
+// ---------------------------------------------------------------------------
+// front matter 严格子集解析(解析失败一律 FAIL,不宽容;仓内无 YAML 依赖)
+// ---------------------------------------------------------------------------
+const parseFrontMatter = () => {
+  const text = readFileSync(DESIGN_MD, 'utf8')
+  const match = text.match(/^---\n([\s\S]*?)\n---/)
+  if (!match) {
+    failures.push('design.md 缺少 YAML front matter(--- 包裹块)')
+    return {}
+  }
+  const body = match[1]
+  if (/\t/.test(body)) failures.push('front matter 含 Tab 缩进(YAML 禁止),FAIL')
+  const sections = {}
+  const seenTopKeys = new Set()
+  let currentSection = null
+  const lines = body.split('\n')
+  for (let i = 0; i < lines.length; i += 1) {
+    const line = lines[i]
+    if (/^\s*#/.test(line) || !line.trim()) continue
+    const topLevel = line.match(/^([A-Za-z][\w-]*):\s*(.*)$/)
+    if (topLevel && !line.startsWith(' ')) {
+      if (seenTopKeys.has(topLevel[1])) failures.push(`front matter 顶层键重复:${topLevel[1]}`)
+      seenTopKeys.add(topLevel[1])
+      currentSection = topLevel[2].trim() === '' ? topLevel[1] : null
+      if (currentSection && MIRROR_MAP[currentSection]) sections[currentSection] = {}
+      continue
+    }
+    if (!currentSection || !MIRROR_MAP[currentSection]) continue
+    const entry = line.match(/^  ([\w-]+):\s*(.*)$/)
+    if (!entry) {
+      failures.push(`front matter ${currentSection} 节第 ${i + 1} 行不符合"两空格缩进 key: value"严格子集:${line.trim()}`)
+      continue
+    }
+    const key = entry[1]
+    if (key in sections[currentSection]) failures.push(`front matter ${currentSection}.${key} 重复定义`)
+    const rawValue = entry[2].trim()
+    const quoted = rawValue.match(/^"([^"]*)"\s*(?:#.*)?$/)
+    if (quoted) {
+      sections[currentSection][key] = quoted[1]
+      continue
+    }
+    if (rawValue.startsWith("'")) {
+      failures.push(`front matter ${currentSection}.${key} 使用单引号——严格子集只接受双引号(机器校验口径统一)`)
+      continue
+    }
+    if (rawValue.includes('#')) {
+      failures.push(`front matter ${currentSection}.${key} 的值含未加引号的 #(真 YAML 会当注释截断):${rawValue}——hex 必须双引号包裹`)
+      continue
+    }
+    if (!/^[\w.%-]+$/.test(rawValue)) {
