+              }
+            }
+          }
+        }
+      }
+      if (ts.isBinaryExpression(node)) {
+        const assignName = canonicalStyleProp(accessTargetNameOf(node.left, sourceFile) || '')
+        if (assignName === 'fontWeight' || assignName === 'fontSize') {
+          const kind = assignName === 'fontWeight' ? 'weight' : 'size'
+          if (VALUE_ASSIGN_OPERATORS.has(node.operatorToken.kind)) {
+            for (const entry of styleValuesIn(node.right, sourceFile)) checkAstValue(kind, rel, sourceFile, entry)
+          } else if (isAssignmentOperator(node.operatorToken.kind)) {
+            const { line } = sourceFile.getLineAndCharacterOfPosition(node.getStart(sourceFile))
+            failures.push(`${rel}:${line + 1} ${assignName} 复合赋值(${node.operatorToken.getText(sourceFile)})结果无法静态断言在白名单内,禁止(请直接赋白名单值)`)
+          }
+        }
+        // `.font = '...'` 直接赋值:Canvas 2D 的 ctx.font 合法使用 shorthand 字符串,
+        // 按 font shorthand 语法解析 size 前的全部前缀 token(style/variant/stretch
+        // 关键字放行、数字按梯校验、bold/bolder/lighter 等字重 keyword 一律红——
+        // 第七轮审查项3:'italic 600 18px' 与 'bold 18px' 曾漏);模板串静态重建后
+        // 同样解析(动态 px 用占位符标记 size 存在)。
+        if (assignName === 'font') {
