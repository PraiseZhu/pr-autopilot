+/* 媒体详情 lightbox(双击图片/视频入口,App.tsx 按 renderKind 与 .details-dialog 分流)。
+   与 .details-dialog-backdrop 同层 z-index:100;toast-viewport(220)必须保持在弹层之上。
+   刻意深色沉浸,不随主站浅色主题。 */
+/* ── 媒体详情 Lightbox(二期:信息浮层)──────────────────────────
+   形态不变式(2026-08-02 定稿):信息直接浮在压暗遮罩上(无容器底色)、
+   任何状态不遮挡媒体本体、窄容器降级底部抽屉(带底色)、固定深色不随主题
+   (与选区快捷条同族,插件皮肤层不得覆写)。字重走 400/500/700/800 梯(#425)。 */
+.media-lightbox-backdrop {
+  /* 浮层宽度单一变量:让位 padding 由 calc 派生,改宽度不会静默破
+     「信息不遮挡媒体」硬不变式(对抗审 R4-B2)。 */
+  --lightbox-info-w: 300px;
+  position: fixed;
+  inset: 0;
+  z-index: 100;
+  background: rgba(18, 16, 14, 0.86);
+  backdrop-filter: blur(4px);
+}
+
+/* 媒体区吃满全层;信息浮层打开时右侧让位(padding 过渡)。 */
+.media-lightbox-stage {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 32px;
+  transition: padding 0.28s ease;
+}
+
+.media-lightbox-backdrop.info-open:not(.narrow) .media-lightbox-stage {
+  padding-right: calc(16px + var(--lightbox-info-w) + 32px); /* 边距 + 浮层 + 留白 */
+}
+
+.media-lightbox-media {
+  display: block;
+  max-width: 100%;
+  max-height: calc(100svh - 64px);
+  object-fit: contain;
+  box-shadow: 0 28px 88px rgba(0, 0, 0, 0.5);
+}
+
+/* ── 右上按钮簇(信息浮层正上方,右对齐同列) ── */
+.media-lightbox-actions {
+  position: absolute;
+  top: 16px;
+  right: 16px;
+  z-index: 30;
+  display: flex;
+  gap: 8px;
+}
+
+.media-lightbox-chip {
+  min-height: 34px;
+  padding: 7px 13px;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  color: rgba(255, 250, 240, 0.92);
+  background: rgba(28, 28, 27, 0.88);
+  border: 1px solid rgba(255, 250, 240, 0.25);
+  border-radius: var(--radius-md);
+  font-size: var(--text-sm);
+  font-weight: 700;
+  line-height: 1;
+  cursor: pointer;
+  transition: background 0.15s ease, border-color 0.15s ease;
+}
+
+.media-lightbox-chip:hover {
+  background: rgba(40, 38, 35, 0.94);
+  border-color: rgba(255, 250, 240, 0.45);
+}
+
+.media-lightbox-chip.active {
+  border-color: rgba(255, 250, 240, 0.65);
+  background: rgba(48, 45, 40, 0.95);
+}
+
+.media-lightbox-chip-ico {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+  font-style: italic;
+  font-weight: 700;
+}
+
+/* ── 信息浮层:无容器,文字直接浮在遮罩上(桌面) ── */
+.media-lightbox-info {
+  position: absolute;
+  top: 62px;
+  right: 16px;
+  bottom: 16px;
+  width: var(--lightbox-info-w);
+  z-index: 25;
+  display: flex;
+  flex-direction: column;
+  color: #fffaf0;
+  overflow: hidden;
+  transition: opacity 0.22s ease, transform 0.22s ease;
+}
+
+.media-lightbox-backdrop:not(.info-open):not(.narrow) .media-lightbox-info {
+  opacity: 0;
+  pointer-events: none;
+  transform: translateX(12px);
+}
+
+/* 信息主体包一层:收起时整块 inert(把手留在外面保持可交互)。 */
+.media-lightbox-info-body {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+}
+
+.media-lightbox-info-head {
+  flex: none;
+  padding: 16px 16px 12px;
+  border-bottom: 1px solid rgba(255, 250, 240, 0.08);
+}
+
+.media-lightbox-file-name {
+  font-size: var(--text-lg);
+  font-weight: 800;
+  line-height: 1.4;
+  word-break: break-all;
+}
+
+.media-lightbox-file-sub {
+  margin-top: 4px;
+  font-size: var(--text-xs);
+  color: rgba(255, 250, 240, 0.45);
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+}
+
+.media-lightbox-info-scroll {
+  flex: 1;
+  overflow-y: auto;
+  padding: 2px 16px 12px;
+  scrollbar-width: thin;
+  scrollbar-color: rgba(255, 250, 240, 0.2) transparent;
+}
+
+.media-lightbox-info-foot {
+  flex: none;
+  padding: 12px 16px;
+  border-top: 1px solid rgba(255, 250, 240, 0.08);
+}
+
+/* 下载 = 强按钮:全站唯一交互驱动紫(与快捷条开启态同源),固定深色形态专用 hover 深一档。 */
+.media-lightbox-download {
+  width: 100%;
+  font-size: var(--text-lg);
+  font-weight: 700;
+  color: #fffaf0;
+  background: var(--violet);
+  border: none;
+  border-radius: var(--radius-md);
+  padding: 9px 0;
+  cursor: pointer;
+  transition: background 0.15s ease;
+}
+
+.media-lightbox-download:hover {
+  background: #5b49d6;
+}
+
+.media-lightbox-sec {
+  padding: 13px 0;
+  border-bottom: 1px solid rgba(255, 250, 240, 0.08);
+}
+
+.media-lightbox-sec:last-child {
+  border-bottom: none;
+}
+
+.media-lightbox-sec h3 {
+  margin: 0 0 9px;
+  font-size: var(--text-xs);
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  color: rgba(255, 250, 240, 0.45);
+}
+
+.media-lightbox-kv {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 4px 0;
+  font-size: var(--text-md);
+}
+
+.media-lightbox-kv-key {
+  color: rgba(255, 250, 240, 0.45);
+  flex: none;
+  font-weight: 500;
+}
+
+.media-lightbox-kv-value {
+  color: #fffaf0;
+  text-align: right;
+  word-break: break-all;
+  font-weight: 700;
+}
+
+.media-lightbox-kv-value.mono {
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+  font-size: var(--text-sm);
+  font-weight: 400;
+}
+
+.media-lightbox-prompt {
+  font-size: var(--text-sm);
+  line-height: 1.65;
+  color: rgba(255, 250, 240, 0.88);
+  background: rgba(255, 250, 240, 0.08);
+  border: 1px solid rgba(255, 250, 240, 0.08);
+  border-radius: var(--radius-md);
+  padding: 9px 11px;
+  margin-bottom: 9px;
+}
+
+.media-lightbox-derive {
+  display: block;
+  width: 100%;
+  margin-top: 8px;
+  padding: 8px;
+  font-size: var(--text-xs);
+  text-align: left;
+  line-height: 1.5;
+  color: rgba(255, 250, 240, 0.7);
+  background: transparent;
+  border: 1px solid rgba(255, 250, 240, 0.08);
+  border-radius: var(--radius-md);
+  cursor: pointer;
+  transition: border-color 0.15s ease;
+}
+
+.media-lightbox-derive:hover {
+  border-color: rgba(255, 250, 240, 0.45);
+}
+
+.media-lightbox-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+
+.media-lightbox-tag {
+  display: inline-flex;
+  align-items: center;
+  gap: 5px;
+  font-size: var(--text-xs);
+  font-weight: 700;
+  color: rgba(255, 250, 240, 0.88);
+  background: rgba(255, 250, 240, 0.08);
+  border: 1px solid rgba(255, 250, 240, 0.08);
+  border-radius: var(--radius-pill);
+  padding: 4px 10px;
+}
+
+.media-lightbox-tag-remove {
+  padding: 0;
+  border: none;
+  background: none;
+  cursor: pointer;
+  color: rgba(255, 250, 240, 0.45);
+  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
+  font-size: 10px;
+}
+
+.media-lightbox-tag-remove:hover {
+  color: #fffaf0;
+}
+
+.media-lightbox-tag-add {
+  font-size: var(--text-xs);
+  font-weight: 700;
+  color: rgba(255, 250, 240, 0.45);
+  background: transparent;
+  border: 1px dashed rgba(255, 250, 240, 0.25);
+  border-radius: var(--radius-pill);
+  padding: 4px 10px;
+  cursor: pointer;
+}
+
+.media-lightbox-tag-add:hover {
+  color: #fffaf0;
+  border-color: rgba(255, 250, 240, 0.45);
+}
+
+.media-lightbox-tag-input {
+  width: 92px;
+  font-size: var(--text-xs);
+  color: #fffaf0;
+  background: rgba(255, 250, 240, 0.08);
+  border: 1px solid rgba(255, 250, 240, 0.25);
+  border-radius: var(--radius-pill);
+  padding: 4px 10px;
+  outline: none;
+}
+
+.media-lightbox-note {
+  width: 100%;
+  min-height: 60px;
+  resize: vertical;
+  font-family: inherit;
+  font-size: var(--text-sm);
+  line-height: 1.6;
+  color: #fffaf0;
+  background: rgba(255, 250, 240, 0.08);
+  border: 1px solid rgba(255, 250, 240, 0.08);
+  border-radius: var(--radius-md);
+  padding: 8px 10px;
+}
+
+.media-lightbox-note::placeholder,
+.media-lightbox-tag-input::placeholder {
+  color: rgba(255, 250, 240, 0.45);
+}
+
+.media-lightbox-note:focus,
+.media-lightbox-tag-input:focus {
+  outline: none;
+  border-color: rgba(255, 250, 240, 0.45);
+}
+
+/* 桌面形态不渲染抽屉把手视觉。 */
+.media-lightbox-sheet-grip {
+  display: none;
+}
+
+/* ── 窄容器(< 720px,插件面板/窄窗口):信息浮层 → 底部抽屉 ── */
+.media-lightbox-backdrop.narrow .media-lightbox-stage {
+  padding: 20px 20px 64px;
+}
+
+/* 抽屉展开时媒体区上让位:信息永不遮挡媒体本体(硬约束)。 */
+.media-lightbox-backdrop.narrow.info-open .media-lightbox-stage {
+  bottom: auto;
+  height: 54%;
+  padding-bottom: 16px;
+}
+
+.media-lightbox-backdrop.narrow.info-open .media-lightbox-media {
+  max-height: 100%;
+}
+
+.media-lightbox-backdrop.narrow .media-lightbox-info {
+  top: auto;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  width: auto;
+  height: 46%;
+  border-radius: 14px 14px 0 0;
+  /* 抽屉盖在媒体上方,保留一层底色保可读(与桌面无容器形态刻意不同)。 */
+  background: rgba(28, 28, 27, 0.88);
+  backdrop-filter: blur(14px);
+  -webkit-backdrop-filter: blur(14px);
+  border-top: 1px solid rgba(255, 250, 240, 0.08);
+  transition: transform 0.3s ease;
+}
+
+.media-lightbox-backdrop.narrow:not(.info-open) .media-lightbox-info {
+  transform: translateY(calc(100% - 44px));
+}
+
+.media-lightbox-backdrop.narrow .media-lightbox-sheet-grip {
+  display: block;
+  flex: none;
+  width: 100%;
+  padding: 8px 0 2px;
+  background: none;
+  border: none;
+  cursor: pointer;
+  text-align: center;
+}
+
+.media-lightbox-backdrop.narrow .media-lightbox-sheet-grip::before {
+  content: "";
+  display: inline-block;
+  width: 40px;
+  height: 4px;
+  border-radius: 2px;
+  background: rgba(255, 250, 240, 0.25);
+}
+
+/* 资产解析 pending 期间的最小加载指示(IndexedDB/服务端资产是异步取回的)。 */
+.media-lightbox-loading {
+  width: 28px;
+  height: 28px;
+  border: 3px solid rgba(255, 250, 240, 0.25);
+  border-top-color: rgba(255, 250, 240, 0.85);
+  border-radius: 50%;
+  animation: media-lightbox-spin 0.9s linear infinite;
+}
+
+@keyframes media-lightbox-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
