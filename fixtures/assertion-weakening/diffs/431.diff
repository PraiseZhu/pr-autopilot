+// ---------------------------------------------------------------------------
+// CSS 规则解析(供 cssProp 语义绑定):拆出全部 { selectors[], body },@media 等
+// 条件组规则递归展开;prelude 按逗号拆并规范化空白。
+// ---------------------------------------------------------------------------
+const parseCssRules = (text) => {
+  const rules = []
+  const scan = (chunk, offset, context) => {
+    let i = 0
+    let preludeStart = 0
+    while (i < chunk.length) {
+      const ch = chunk[i]
+      if (ch === '{') {
+        const prelude = chunk.slice(preludeStart, i).trim()
+        let depth = 1
+        let j = i + 1
+        while (j < chunk.length && depth > 0) {
+          if (chunk[j] === '{') depth += 1
+          else if (chunk[j] === '}') depth -= 1
+          j += 1
+        }
+        const body = chunk.slice(i + 1, j - 1)
+        if (prelude.startsWith('@')) {
+          if (/^@(media|supports|layer|container)/i.test(prelude)) {
+            const normalizedPrelude = prelude.replace(/\s+/g, ' ').trim()
+            scan(body, offset + i + 1, context ? `${context} > ${normalizedPrelude}` : normalizedPrelude)
+          }
+          // @keyframes/@font-face 等的 body 不是选择器规则,跳过
+        } else if (prelude) {
+          rules.push({
+            selectors: prelude.split(',').map((s) => s.replace(/\s+/g, ' ').trim()),
+            body,
+            context: context || null, // 所处 at-rule 条件组的 prelude(顶层为 null)
+            conditional: !!context,
+            order: offset + i,
+          })
+        }
+        i = j
+        preludeStart = j
+      } else if (ch === '}') {
+        i += 1
+        preludeStart = i
+      } else {
+        i += 1
+      }
+    }
+  }
+  scan(text, 0, null)
+  return rules.sort((a, b) => a.order - b.order)
+}
+
+// 规则体只保留深度 0 声明:剥掉 CSS nesting 的子规则块(&:hover { ... } 等),
+// 嵌套声明属于别的选择器上下文,混进外层会把 nested color 当外层后置声明(第四轮审查项2-3)
+const stripNestedBlocks = (body) => {
+  let out = ''
+  let depth = 0
+  for (const ch of body) {
+    if (ch === '{') depth += 1
+    else if (ch === '}') depth = Math.max(0, depth - 1)
+    else if (depth === 0) out += ch
+  }
+  return out
+}
+
+// 目标选择器精确匹配规则里,某属性的全部深度 0 声明(含条件组;带 !important 剥离后的值)
+const cssPropDecls = (rulesOf, rel, selector, property) => {
+  const target = selector.replace(/\s+/g, ' ').trim()
+  const decls = []
+  for (const rule of rulesOf(rel)) {
+    if (!rule.selectors.includes(target)) continue
+    for (const m of stripNestedBlocks(rule.body).matchAll(new RegExp(`(?:^|;)\\s*${property}\\s*:\\s*([^;]+)`, 'gi'))) {
+      decls.push({ value: m[1].trim().replace(/\s*!important\s*$/i, ''), conditional: rule.conditional })
+    }
+  }
+  return decls
+}
+
+const fileCache = new Map()
+const readRaw = (rel) => {
+  if (!fileCache.has(rel)) fileCache.set(rel, readFileSync(join(REPO_ROOT, rel), 'utf8'))
+  return fileCache.get(rel)
+}
+const cssRulesCache = new Map()
+const cssRulesOf = (rel) => {
+  if (!cssRulesCache.has(rel)) cssRulesCache.set(rel, parseCssRules(stripBlockComments(readRaw(rel))))
+  return cssRulesCache.get(rel)
+}
