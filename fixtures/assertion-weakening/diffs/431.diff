+  const stripped = content.replace(/\/\*[\s\S]*?\*\//g, blankNonNewline)
+  const startLine = sourceFile.getLineAndCharacterOfPosition(startPos).line + 1
+  scanCssText(rel, stripped, (idx) => startLine + (stripped.slice(0, idx).split('\n').length - 1))
+}
