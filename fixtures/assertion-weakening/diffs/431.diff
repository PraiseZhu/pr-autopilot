+// ---------------------------------------------------------------------------
+// 扫描面:仓根整树(仓根相对前缀排除,不泛化跳隐藏路径;损坏 symlink 忽略)
+// ---------------------------------------------------------------------------
+const isExcluded = (rel) => EXCLUDED_PREFIXES.some(([prefix]) => rel === prefix || rel.startsWith(`${prefix}/`))
+const walk = (dir, out = []) => {
+  for (const name of readdirSync(dir)) {
+    const full = join(dir, name)
+    const rel = relative(REPO_ROOT, full).split('\\').join('/')
+    if (isExcluded(rel)) continue
+    let stat
+    try {
+      stat = lstatSync(full)
+    } catch {
+      continue
+    }
+    // 不跟随符号链接(PR #431 review):指向自身/祖先/仓外的链接会造成无界递归或
+    // 越界扫描;仓内样式源码不经 symlink 组织,跳过即 fail-closed
+    if (stat.isSymbolicLink()) continue
+    if (stat.isDirectory()) walk(full, out)
+    else out.push(full)
+  }
+  return out
+}
+const isTestFile = (rel) => /\.test\.|__tests__|\.spec\./.test(rel)
