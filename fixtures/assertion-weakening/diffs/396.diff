+// menuShortcuts — 右键菜单快捷键提示文案(context-menu-standard R19,2026-07-31 拍板)。
+// 只登记 useGlobalCanvasEvents / 原生 copy/paste 里真实生效的快捷键:菜单上的
+// 提示必须句句为真。文案按平台分 mac(符号)
+// 与其它(Ctrl+ 前缀)。
+const isMacLike =
+  typeof navigator !== 'undefined' && /Mac|iPhone|iPad|iPod/.test(navigator.platform || '')
+
+const mod = (key: string) => (isMacLike ? `⌘${key}` : `Ctrl+${key}`)
+const shiftMod = (key: string) => (isMacLike ? `⇧⌘${key}` : `Ctrl+Shift+${key}`)
+
+export const menuShortcuts = {
+  copy: mod('C'),
+  paste: mod('V'),
+  group: mod('G'),
+  ungroup: shiftMod('G'),
+  lock: shiftMod('L'),
+  delete: isMacLike ? '⌫' : 'Del',
+  selectAll: mod('A'),
+  fitAll: isMacLike ? '⇧1' : 'Shift+1',
+  fitSelection: isMacLike ? '⇧2' : 'Shift+2',
+  bringForward: ']',
+  sendBackward: '[',
+  bringToFront: isMacLike ? '⇧]' : 'Shift+]',
+  sendToBack: isMacLike ? '⇧[' : 'Shift+[',
+} as const
