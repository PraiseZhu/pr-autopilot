+// - 无选区 → ignore,连 preventDefault 都不做(把 Cmd+Shift+L 留给浏览器/系统);
+// - 单选 Section → 显式走 canonical 的 setSectionLockMode,钉死 Lock all ↔ 解锁
+//   的产品语义(与菜单排除单选 Section 的 generic toggle-lock 保持一致);
+// - 其余选区(含混入 Section 的多选)→ 与菜单 toggle-lock 同源的 generic 翻转;
+//   generic 对 frame 已由 store 双写 locked + sectionLockMode(nodeMutationSlice
+//   阶段 2 根因修复),两字段不会再出现矛盾态。
+export type LockShortcutDecision =
+  | { kind: 'ignore' }
+  | { kind: 'section'; nodeId: string; nextMode: 'all' | undefined }
+  | { kind: 'generic' }
+
+export const resolveLockShortcut = (selectedNodes: MivoCanvasNode[]): LockShortcutDecision => {
+  if (!selectedNodes.length) return { kind: 'ignore' }
+  const single = selectedNodes.length === 1 ? selectedNodes[0] : undefined
+  if (single?.type === 'frame') {
+    return { kind: 'section', nodeId: single.id, nextMode: single.sectionLockMode ? undefined : 'all' }
+  }
+  // 混选含 Section 也走 generic(store 已对 frame 双写,安全,见顶部注释)。
+  return { kind: 'generic' }
+}
+
+/** ⇧⌘L 的完整接线(依赖全部注入、可直接单测的接线函数——它会调用
+ *  event.preventDefault 与 dispatch,有副作用,不是纯函数):从"是否
+ *  preventDefault"到"分发哪个动作"整段可测。selectedNodes 由调用方用 selectedNodesFromState 解析
+ *  (selectedNodeIds 空时回退 selectedNodeId、过滤 hidden 的仓内标准语义)。
+ *  返回是否消费了本次按键(false = 留给浏览器)。 */
+export const handleLockShortcut = (
+  event: Pick<Event, 'preventDefault'>,
+  selectedNodes: MivoCanvasNode[],
+  dispatch: {
+    setSectionLockMode: (nodeId: string, mode?: SectionLockMode) => void
+    toggleSelectedNodesLocked: () => void
+  },
+): boolean => {
+  const decision = resolveLockShortcut(selectedNodes)
+  if (decision.kind === 'ignore') return false
+  event.preventDefault()
+  if (decision.kind === 'section') dispatch.setSectionLockMode(decision.nodeId, decision.nextMode)
+  else dispatch.toggleSelectedNodesLocked()
+  return true
+}
