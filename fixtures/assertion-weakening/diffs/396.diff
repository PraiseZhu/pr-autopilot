+// menuOverlayLayout — 右键菜单/浮层视口夹取的单一来源(context-menu-standard R8)。
+// 此前画布菜单(canvasInteraction/CanvasContextMenu)与侧栏菜单(sidebar/ContextMenu)
+// 各写一份 clamp 常量(12/12/8 三种边距):统一为本模块的 12px 边距与同一夹取
+// 语义。各菜单的宽高是自己的形态参数,由调用方传入,不在这里集中。
+export const menuViewportMargin = 12
+
+// R10:子菜单 hover 意图延迟(全站统一手感)——划过不误开,停留才展开。
+export const submenuHoverDelayMs = 150
+
+export const clampMenuPosition = (
+  clientX: number,
+  clientY: number,
+  size: { width: number; maxHeight: number },
+  margin: number = menuViewportMargin,
+): { x: number; y: number } => ({
+  x: Math.min(Math.max(margin, clientX), Math.max(margin, window.innerWidth - size.width - margin)),
+  y: Math.min(Math.max(margin, clientY), Math.max(margin, window.innerHeight - size.maxHeight - margin)),
+})
