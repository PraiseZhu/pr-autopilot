+export const migrateRecentLevels = (state) => {
+  for (const cluster of Object.values(state?.clusters || {})) {
+    if (!Array.isArray(cluster?.recent)) continue
+    const levels = cluster?.levels || []
+    const distinctLevels = new Set(levels)
+    const fallbackLevel = distinctLevels.size === 1 ? [...distinctLevels][0] : 'unknown'
+    cluster.recent = cluster.recent.filter((entry) => entry && typeof entry === 'object')
+    const samplesByKey = new Map()
+    for (const sample of cluster?.samples || []) {
+      if (sample && sample.receivedAt !== undefined) {
+        samplesByKey.set(`${sample.receivedAt}|${sample.clientId || 'unknown'}`, sample)
+      }
+    }
+    for (const entry of cluster.recent) {
+      if (entry.level) continue
+      const matched = samplesByKey.get(`${entry.t}|${entry.c}`)
+      entry.level = matched?.level || fallbackLevel
+    }
+  }
+  return state
