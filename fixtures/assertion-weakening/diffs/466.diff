+// - (SC-BD1-R8-T02/T06 补丁,同族缺陷第八次复发)R7 新增了上面的处数比对
+//   机制(S04),却没把自己那一轮新增的六条 SC(S01–S06)登记进
+//   REQUIRED_SC_IDS_SNAPSHOT——新机制忘记覆盖引入它的那一轮自己,S04 连
+//   S04 都没登记。R8 做了两件事把这个洞堵死而不是再挖深一层:① 把 R7 的
+//   S01–S06(连同本轮 T01/T05,见各自条目旁的说明)补登记进快照,处数按
+//   扩域后(见下条 SC-BD1-R8-T03/T04 补丁)实测填入,不沿用扩域前的参考值;
+//   ② 新增一条反向断言:出现在 describe 标题里的任何 SC id,必须在
+//   REQUIRED_SC_IDS_SNAPSHOT 或 LEGACY_UNREGISTERED_SC_IDS 白名单里有条目,
+//   否则判红——这条断言堵的正是"从未登记"这条此前完全不设防的通道,
+//   而不是"已登记但处数不对"(那是 S04 管的另一件事)。
+// - (SC-BD1-R8-T03/T04 补丁)本文件原来的 readdirSync(__dirname) 把扫描
+//   范围钉死在 scripts/loops/bug-doctor/ 一个目录,而
+//   scripts/loops/dashboard/render.test.mjs 里同样有带 SC id 的 describe
+//   (SC-BD1-R6-Q01、SC-BD1-R7-S01),完全在扫描集之外——摘掉那两处绑定,
+//   本文件的任何断言都不会响,而在本轮之前这正是全量 318/318 全绿、净增
+//   红 0 的实测结果。R8 把扫描域改成显式的目录名清单 SCANNED_DIR_NAMES
+//   (bug-doctor + dashboard),不用递归遍历(递归会把未来任何新目录悄悄
+//   纳入,扫描域应当是有意声明的),并用一条断言校验"文件头声明的目录名"
+//   与"实际扫描的目录"逐项一致。扫描域外的 SC 绑定仍然不受本文件任何
+//   保护——这条边界写在 SCANNED_DIR_NAMES 上方,若将来其它目录出现 SC
+//   绑定,需要显式把该目录名加进这个清单。
+//
+// 两条断言刻意不做的事(避免误伤既有形态,详见各断言前的说明):
+// - 不要求"一个 SC id 只能归属一个 describe"——同一条 SC 天然可能同时在
+//   单元层(state.test.mjs)与 gate 层(gate.test.mjs)各留一个 describe;
+// - 不要求"一个 describe 只能声明一个 SC id"——本轮 SC-BD1-R4-N10 的
+//   describe 被重新绑定后同时携带 SC-BD1-R5-P02,是正当的重绑形态;
+// - 不回溯改写既有用 prose(如"已知局限")做过滤词的历史 SC(K01-K13 那批),
+//   代价与本轮范围不成比例。
+
+import { readdirSync, readFileSync } from 'node:fs'
+import { basename, dirname, join, relative } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+
+// 扫描口径声明(唯一真相源;与实际扫描目录的一致性由下方
+// SC-BD1-R8-T04 断言机器校验,不靠人读注释):当前扫描两个目录——
+// scripts/loops/bug-doctor/(本目录,SC 的主交付域)与
+// scripts/loops/dashboard/(本 PR 内唯一另有 SC 绑定的目录)——下的所有
+// *.test.mjs。扫描域外的 SC 绑定不受本守卫任何保护;若将来其它目录出现
+// SC 绑定,必须显式把该目录名加进 SCANNED_DIR_NAMES,否则下面 T04 的
+// 一致性断言会因为实际扫描目录数/名与声明数/名不符而变红。
+const SCANNED_DIR_NAMES = ['bug-doctor', 'dashboard']
+
+const SCANNED_DIRS = [
+  __dirname, // scripts/loops/bug-doctor(本文件所在目录)
+  join(__dirname, '..', 'dashboard'), // scripts/loops/dashboard
+]
+
+const TEST_FILES = SCANNED_DIRS.flatMap((dir) =>
+  readdirSync(dir)
+    .filter((name) => name.endsWith('.test.mjs'))
+    .map((name) => ({ dir, name })),
+).sort((a, b) => `${basename(a.dir)}/${a.name}`.localeCompare(`${basename(b.dir)}/${b.name}`))
+
+const DESCRIBE_TITLE_RE = /^describe\(\s*'([^']*)'/
+
+// 两个扫描目录下所有 describe 均为顶层、不嵌套(已用 `grep -n "describe("`
+// 逐文件核对过,不存在缩进 >2 空格的 describe;dashboard/render.test.mjs
+// 同样逐一核对过,7 处 describe 全部顶层)。按"下一个顶层 describe(" 的
+// 行号切分文件即可拿到每个 describe 的标题 + 块内正文,不需要完整 JS
+// 语法解析。
+function extractDescribeBlocks(source) {
+  const lines = source.split('\n')
+  const starts = []
+  lines.forEach((line, idx) => {
+    if (/^describe\(|^ {2}describe\(/.test(line)) starts.push(idx)
+  })
+  return starts
+    .map((startIdx, i) => {
+      const endIdx = i + 1 < starts.length ? starts[i + 1] : lines.length
+      const titleMatch = DESCRIBE_TITLE_RE.exec(lines[startIdx].trim())
+      return {
+        title: titleMatch ? titleMatch[1] : null,
+        body: lines.slice(startIdx, endIdx).join('\n'),
+      }
+    })
+    .filter((block) => block.title !== null)
+}
+
+const ALL_BLOCKS = TEST_FILES.flatMap(({ dir, name }) => {
+  const source = readFileSync(join(dir, name), 'utf8')
+  const label = relative(join(__dirname, '..'), join(dir, name))
+  return extractDescribeBlocks(source).map((block) => ({ ...block, file: label }))
+})
+
+// 提取形如 "SC-BD1-R4-N10"/"SC-BD1-R1b"/"SC-BD1-R2-N01/N02" 的 id token。
+// 组合斜杠形态(同一 R+字母前缀共享,只在第二段省略字母)算作一个 token,
+// 交给下面的形状校验去判断是否合法——本函数只负责"抓出候选串",不判合法性。
+const SC_ID_RE = /SC-BD1-([A-Za-z0-9/-]+)/g
+
+function extractScIds(title) {
+  return [...title.matchAll(SC_ID_RE)].map((m) => `SC-BD1-${m[1]}`)
+}
