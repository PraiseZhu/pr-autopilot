+const CREDENTIAL_ASSIGNMENT_RE = /\b(?:password|passwd|pwd|secret|token|api[_-]?key|client[_-]?secret|access[_-]?key|private[_-]?key)["']?\s*[:=]\s*["'][^"'\s]{8,}["']/i
+const SENSITIVE_PLACEHOLDER_RE = /\$\{|\$\(|process\.env|<[^>]*>|xxx|your[-_]|placeholder|change[-_]?me|example|sample|dummy|test|fake|mock|stub|redacted|\*{3,}/i
+
+/**
+ * 扫描一段文本,返回未豁免的 credential-assignment 命中列表(纯函数,便于单测,
+ * 与上游 scanSensitiveLine() 对 credential-assignment 这一 kind 的判定逻辑等价)。
+ */
+export function findUnexemptedCredentialLiterals(text) {
+  const hits = []
+  const lines = text.split('\n')
+  for (let i = 0; i < lines.length; i++) {
+    const m = lines[i].match(CREDENTIAL_ASSIGNMENT_RE)
+    if (m && !SENSITIVE_PLACEHOLDER_RE.test(m[0])) {
+      hits.push({ line: i + 1, text: m[0] })
+    }
+  }
+  return hits
+}
