+// ── SC-BD1-R6-Q01:gate.mjs 的"锁释放失败"日志行改用 "· lock-release ·" 标记
+// (不带 "mode="),不得被 parseLogs 的 run 正则误认成一轮真实产出——此前用
+// "· mode=${mode} ·" 时,`工作包 (\d+) 簇` 匹配不上会让 wp=null、workpacket
+// 落 0、idle 落 null,污染"最近一轮"展示。──
+describe('parseLogs 不误认锁释放失败行(SC-BD1-R6-Q01)', () => {
+  it('"· lock-release ·" 标记的释放失败行不命中 run 正则,runs.length 不增加', () => {
+    const md = [
+      '# Mivo logs(只增,每轮一行;零也记)',
+      '- 2026-08-03T10:00:00+08:00 · mode=full · 新记录 3 · 新簇 1 · 活跃簇 2 · S0 1 · 工作包 2 簇',
+      '- 2026-08-03T10:00:01+08:00 · lock-release · 锁释放失败(stateDir=/tmp/bug-doctor-state-abc123)',
+    ].join('\n')
+    const runs = parseLogs(md)
+    // 只有真实的 "· mode=" 行算一轮,释放失败行不参与计数
+    expect(runs.length).toBe(1)
+    expect(runs[0].workpacket).toBe(2)
+    expect(runs[0].idle).toBe(false)
+  })
+
+  it('正向对照:真实成功行本身仍被正常认成 1 轮 run(证明不是把正则改坏了)', () => {
+    const md = '- 2026-08-03T10:00:00+08:00 · mode=full · 新记录 3 · 新簇 1 · 活跃簇 2 · S0 1 · 工作包 2 簇\n'
+    const runs = parseLogs(md)
+    expect(runs.length).toBe(1)
+    expect(runs[0].mode).toBe('full')
+    expect(runs[0].workpacket).toBe(2)
+  })
+
+  // 反向变异记录(硬要求):把释放失败行的标记改回 "· mode=${mode} ·" 形状
+  // (旧格式)→ 第一条用例的 `runs.length` 从 1 变 2、`workpacket` 从 2 落到
+  // 0(`工作包 (\d+) 簇` 在旧行里匹配不上)、`idle` 从 false 变 null,三处断言
+  // 均转红,-t SC-BD1-R6-Q01 必红。
+})
