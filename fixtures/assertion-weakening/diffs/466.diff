+// 组合斜杠形态(如 "SC-BD1-R2-N01/N02")在 extractScIds 里被抓成单个字符串
+// token,不代表 N01 和 N02 各自没有独立身份——这里展开成各自完整的 id,
+// 否则快照里单独登记的一个 id 会因为它在标题里以组合形态出现而被误判缺失。
+function expandComboId(idText) {
+  const m = /^(SC-BD1-R\d+)-([A-Z]\d+)((?:\/[A-Z]\d+)*)$/.exec(idText)
+  if (!m) return [idText]
+  const [, prefix, first, restSlashes] = m
+  const rest = restSlashes ? restSlashes.slice(1).split('/') : []
+  return [`${prefix}-${first}`, ...rest.map((r) => `${prefix}-${r}`)]
+}
