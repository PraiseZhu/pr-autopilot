+// 一次"判据用 .has() 即可,Map 天然支持,不需要再额外维护一份 Set。
+const BOUND_SC_ID_COUNTS = new Map()
+for (const block of ALL_BLOCKS) {
+  for (const idText of extractScIds(block.title)) {
+    for (const id of expandComboId(idText)) {
+      BOUND_SC_ID_COUNTS.set(id, (BOUND_SC_ID_COUNTS.get(id) || 0) + 1)
+    }
+  }
+}
