+    // 契约:showInput=false 或 inputDisabled=true 时接线层清空 input(settings.js);
+    // failed 态输入框可编辑,但那是用户重贴新 key 的空框——保存成功后立刻进 validating(禁用)。
+    for (const v of views) {
