+/**
+ * Mivo API Key 设置卡控制器(PR-C,D4 五态状态机)。
+ *
+ * 为什么把逻辑抽成这个纯模块:设置页是宿主沙箱页(手册 §4.8),真实环境里只有 DOM 与
+ * `fetch`。把「状态迁移」与「怎么画」切开之后,迁移表可以被逐格断言(SC-C1),而 settings.js
+ * 只剩一层照 view model 刷 DOM 的搬运——没有判断逻辑,也就没有需要靠截图才能验的分支。
+ *
+ * 五态(D4):loading / unconfigured / validating / connected / failed。
+ * `loading` 与 `validating` 共用同款转圈徽标(文字分别「读取中」/「校验中」),所以视觉上
+ * 仍是 owner 确认的 R3 四种外观。
+ *
+ * 红线(手册 §4.7/§4.8,与改动前一致):key 只经 `PUT /secrets/<key>` 一次性交给宿主保险库,
+ * 绝不落 /kv、BroadcastChannel、日志或任何自存路径;`/secrets` 只查回 {key,saved,tail?},
+ * 永远拿不回明文。校验也不碰明文——它只是让电子脑按门铃(见 mivoKeyValidateSender)。
+ *
+ * 「已连接」的语义(R3 根因):**校验通过**才算连上。只凭 `/secrets.saved===true` 显示
+ * 「直连生效」是虚假确认(key 入库 ≠ 通道走通),这是本轮要修掉的东西。所以开页时
+ * saved=true 也要真打一次校验,状态先落 validating。
+ */
+import type { MivoKeyValidateOutcome, MivoKeyValidateSender } from './mivoKeyValidateSender'
+
+export type CardState = 'loading' | 'unconfigured' | 'validating' | 'connected' | 'failed'
+
+export type CardView = {
+  state: CardState
+  /** 右上角徽标文字(R3:未配置 / 读取中 / 校验中 / 已连接 / 连接失败)。 */
+  badgeText: string
+  /** 徽标前缀符号;spinner 态与未配置态都没有符号(R3 反馈⑤去掉了「○」)。 */
+  badgeIcon: '' | '✓' | '✕'
+  /** 转圈动画只出现在徽标里,按钮上永不出现(R3 反馈①)。 */
+  badgeSpinner: boolean
+  showInput: boolean
+  inputDisabled: boolean
+  inputError: boolean
+  /** 保存 / 校验 / 重试 —— 同一个按钮,只换文案与禁用态(R3:四按钮同尺寸同圆角)。 */
+  primaryLabel: string
+  primaryDisabled: boolean
+  showPrimary: boolean
+  showDisconnect: boolean
+  /** 二次确认:第一次点「断开」只换文案,不发 DELETE(SC-C5 的 confirm=false 分支)。 */
+  disconnectLabel: string
+  /** 已连接态的单行状态文字(含尾号);其余态为空。 */
+  statusText: string
+  /** 失败态的错误提示;固定渲染在链接行之后(R3 骨架顺序)。 */
+  errorText: string
+  /** 断开成功后要把焦点交回输入框(SC-C7:换 key = 先断开再输入)。 */
+  focusInput: boolean
+}
+
+export type SecretRow = { key: string; saved?: boolean; tail?: string }
+
+export type SettingsCardDeps = {
+  /** GET /secrets → 数组;抛错/形状不符都当「读不出来」。 */
+  readSecrets: () => Promise<unknown>
+  /** PUT /secrets/<key> → HTTP 状态码。 */
+  putSecret: (value: string) => Promise<number>
+  /** DELETE /secrets/<key> → HTTP 状态码。 */
+  deleteSecret: () => Promise<number>
+  sender: Pick<MivoKeyValidateSender, 'validate' | 'cancel'>
+  render: (view: CardView) => void
+}
+
+export const SECRET_KEY = 'mivo_api_key'
+
+/** verdict/超时 → 失败文案(闭集;自由文本进不来)。 */
+const FAILURE_TEXT: Record<Exclude<MivoKeyValidateOutcome, 'valid' | 'cancelled'>, string> = {
+  'auth-invalid': 'Key 无效或已过期,请到 Mivo 平台重新获取后再保存',
+  'auth-forbidden': '这个 Key 没有访问权限,请在 Mivo 平台确认账号权限',
+  unavailable: '暂时连不上 Mivo 平台(网络或服务波动),可稍后重试',
+  timeout: '校验超时,可稍后重试;期间出图会回落 Cindy 代办',
+}
+
+const EMPTY: CardView = {
+  state: 'loading',
+  badgeText: '读取中',
+  badgeIcon: '',
+  badgeSpinner: true,
+  showInput: false,
+  inputDisabled: true,
+  inputError: false,
+  primaryLabel: '保存',
+  primaryDisabled: true,
+  showPrimary: false,
+  showDisconnect: false,
+  disconnectLabel: '断开',
+  statusText: '',
+  errorText: '',
+  focusInput: false,
+}
+
+const findRow = (list: unknown): SecretRow | null => {
+  if (!Array.isArray(list)) return null
+  for (const item of list) {
+    if (item && typeof item === 'object' && (item as SecretRow).key === SECRET_KEY) return item as SecretRow
+  }
+  return null
+}
+
+export const createSettingsCard = (deps: SettingsCardDeps) => {
+  let view: CardView = { ...EMPTY }
+  /** 断开的二次确认闸门:false 时点「断开」只推进它,不发 DELETE。 */
+  let disconnectArmed = false
+
+  const show = (patch: Partial<CardView>) => {
+    view = { ...EMPTY, ...patch }
+    deps.render(view)
+  }
+
+  const toUnconfigured = (options: { errorText?: string; focusInput?: boolean } = {}) => {
+    disconnectArmed = false
+    show({
+      state: 'unconfigured',
+      badgeText: '未配置',
+      badgeSpinner: false,
+      showInput: true,
+      inputDisabled: false,
+      showPrimary: true,
+      primaryLabel: '保存',
+      primaryDisabled: false,
+      errorText: options.errorText ?? '',
+      focusInput: options.focusInput ?? false,
+    })
+  }
+
+  const toFailed = (errorText: string) => {
+    disconnectArmed = false
+    show({
+      state: 'failed',
+      badgeText: '连接失败',
+      badgeIcon: '✕',
+      badgeSpinner: false,
+      showInput: true,
+      inputDisabled: false,
+      inputError: true,
+      showPrimary: true,
+      primaryLabel: '重试',
+      primaryDisabled: false,
+      errorText,
+    })
+  }
+
+  const toConnected = (tail?: string) => {
+    disconnectArmed = false
+    show({
+      state: 'connected',
+      badgeText: '已连接',
+      badgeIcon: '✓',
+      badgeSpinner: false,
+      showDisconnect: true,
+      statusText: tail ? '已连接(尾号 …' + tail + '),出图走 Mivo 直连' : '已连接,出图走 Mivo 直连',
+    })
+  }
+
+  const toValidating = () => {
+    disconnectArmed = false
+    show({
+      state: 'validating',
+      badgeText: '校验中',
+      badgeSpinner: true,
+      showInput: true,
+      inputDisabled: true,
+      showPrimary: true,
+      // R3 反馈③:校验态按钮文案是「校验」(owner 逐字指定),不是「校验中…」。
+      primaryLabel: '校验',
+      primaryDisabled: true,
+    })
+  }
+
+  /** 读一次 /secrets,只为拿尾号;读不到就退化成不带尾号的文案,不影响已连接结论。 */
+  const tailOf = async (): Promise<string | undefined> => {
+    try {
+      return findRow(await deps.readSecrets())?.tail
+    } catch {
+      return undefined
+    }
+  }
+
+  const runValidate = async () => {
+    toValidating()
+    const outcome = await deps.sender.validate()
+    if (outcome === 'cancelled') return // 新一轮已接管,旧轮不许改 UI
+    if (outcome === 'valid') {
+      toConnected(await tailOf())
+      return
+    }
+    toFailed(FAILURE_TEXT[outcome])
+  }
+
+  return {
+    get view() {
+      return view
+    },
+
+    /** 开页:读 /secrets → 有 key 就真校验一次,没有就未配置。 */
+    async start() {
+      show({ ...EMPTY })
+      let row: SecretRow | null
+      try {
+        row = findRow(await deps.readSecrets())
+      } catch {
+        // 读不出配置状态时不敢猜「未配置」(会误导用户重新贴 key),也不敢猜「已连接」。
+        toFailed('读取配置状态失败,可关掉设置页重开一次')
+        return
+      }
+      if (!row || !row.saved) {
+        toUnconfigured()
+        return
+      }
+      await runValidate()
+    },
+
+    /** 保存:仅 HTTP 204 才推进到校验;非 204 一律留在原地并报错(SC-C5)。 */
+    async save(rawValue: string) {
+      const value = rawValue.trim()
+      if (!value) {
+        // 空值不发请求。停在当前可输入态(unconfigured / failed 都可能),只换提示。
+        if (view.state === 'failed') toFailed('请先粘贴 Key')
+        else toUnconfigured({ errorText: '请先粘贴 Key' })
+        return
+      }
+      deps.sender.cancel() // 代际推进:旧校验轮的迟到回执不许落到这一轮的 UI 上
+      let status: number
+      try {
+        status = await deps.putSecret(value)
+      } catch {
+        toFailed('保存失败,请重试')
+        return
+      }
+      if (status !== 204) {
+        toFailed('保存失败(HTTP ' + status + '),Key 未入库')
+        return
+      }
+      await runValidate()
+    },
+
+    /**
+     * 断开:两段式。第一次点只把按钮换成「确认断开」(零 DELETE);第二次才真删。
+     * 只有 204 才退回未配置,其余保持已连接不动(SC-C5)。
+     */
+    async disconnect() {
+      if (view.state !== 'connected') return
+      if (!disconnectArmed) {
+        disconnectArmed = true
+        view = { ...view, disconnectLabel: '确认断开' }
+        deps.render(view)
+        return
+      }
+      deps.sender.cancel()
+      const connectedBefore = view
+      /** 删除失败要「保持原状态」(SC-C5),所以原样留住这份已连接视图,只叠一条错误。 */
+      const keepConnected = (errorText: string) => {
+        disconnectArmed = false
+        view = { ...connectedBefore, disconnectLabel: '断开', errorText }
+        deps.render(view)
+      }
+      let status: number
+      try {
+        status = await deps.deleteSecret()
+      } catch {
+        keepConnected('清除失败,请重试')
+        return
+      }
+      if (status !== 204) {
+        keepConnected('清除失败(HTTP ' + status + '),Key 仍在库中')
+        return
+      }
+      toUnconfigured({ focusInput: true }) // SC-C7:断开成功后焦点回输入框
+    },
+  }
+}
+
+export type SettingsCard = ReturnType<typeof createSettingsCard>
