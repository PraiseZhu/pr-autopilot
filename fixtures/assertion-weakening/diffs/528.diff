+    await card.save('mivo_abc')
+    expect(calls.validate).toBe(0)
+    expect(card.view.state).toBe('failed')
+  })
+
+  it('PUT 204 → 推进校验;保存前先 cancel 旧轮(代际推进,防迟到回执落到新 key 上)', async () => {
+    const { card, calls } = makeCard({ secrets: async () => savedRow(TAIL), outcome: 'valid' })
+    await card.start()
+    const cancelsBefore = calls.cancel
+    await card.save('  mivo_new  ')
+    expect(calls.put).toEqual(['mivo_new']) // trim 后提交
+    expect(calls.cancel).toBe(cancelsBefore + 1)
