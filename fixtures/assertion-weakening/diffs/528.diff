+    expect(card.view.state).toBe('failed')
+    expect(card.view.errorText).toContain('未入库')
+  })
+
+  it('PUT 抛错 → 同样零校验,落 failed', async () => {
+    const { card, calls } = makeCard({
+      secrets: async () => [],
+      putStatus: async () => {
+        throw new Error('offline')
