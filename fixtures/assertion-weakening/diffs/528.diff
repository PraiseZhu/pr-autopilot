+
+// ── R3 视觉不变量:断言在 settings.html **源文本**上 ───────────────────────────
+//
+// 为什么不是 computed-style(SC-C2/C13 原文要求):本仓单测环境的 `getComputedStyle`
+// 对外链 <style> 里的类选择器返回空串(jsdom 不做级联求值),据它写的"四按钮 padding 相等"
+// 会变成"空串 === 空串"的恒真断言 —— 那正是本轮一直在清的假绿。所以这里改成对源文本
+// 的结构性断言:R3 真正要保的不变量是「同一套 .btn 基类只定义一次尺寸」「骨架顺序固定」
+// 「spinner 只在徽标内」「零蓝紫」,这些在源文本层是可判定的。真机双主题四态截图
+// (SC-C8)仍需 owner 过目,不作机器门 —— 在 PR 描述里如实标 not_run。
+const HTML = readFileSync(fileURLToPath(new URL('../../settings.html', import.meta.url)), 'utf8')
+
+describe('SC-C2 R3 骨架与尺寸(源文本断言)', () => {
+  it('骨架顺序固定 head-row → action-row → link-row → error-row', () => {
+    const order = ['class="head-row"', 'class="action-row"', 'class="link-row"', 'id="error-row"'].map((needle) =>
+      HTML.indexOf(needle),
+    )
+    expect(order.every((i) => i > 0)).toBe(true)
+    expect(order).toEqual([...order].sort((a, b) => a - b)) // 错误提示在链接之后
+  })
+
+  it('四按钮共用 .btn 基类:padding / border-radius / border 宽度只定义一次', () => {
+    // 四个按钮元素(保存·校验·重试 是同一个 #primary,断开是 #disconnect)都带 class="btn "
+    const buttons = HTML.match(/<button[^>]*>/g) ?? []
+    expect(buttons).toHaveLength(2)
+    for (const tag of buttons) expect(tag).toContain('class="btn ')
+    // 尺寸只在 .btn 里出现一次:变体类(.btn-primary/.btn-pill)不许再写 padding/border-radius
+    for (const variant of ['.btn-primary {', '.btn-pill {']) {
+      const body = HTML.slice(HTML.indexOf(variant), HTML.indexOf('}', HTML.indexOf(variant)))
+      expect(body).not.toMatch(/padding|border-radius/)
+    }
+  })
+
+  it('spinner 只存在于徽标内,按钮上没有(R3 反馈①)', () => {
+    const badge = HTML.slice(HTML.indexOf('id="badge"'), HTML.indexOf('</span>\n    </div>'))
+    expect(badge).toContain('id="badge-spinner"')
+    expect((HTML.match(/badge-spinner/g) ?? []).length).toBe(3) // CSS 类 + keyframes 归属 + DOM 节点
+    for (const tag of HTML.match(/<button[^>]*>/g) ?? []) expect(tag).not.toContain('spinner')
+  })
+
+  it('无障碍:徽标 aria-live、错误 role=alert、spinner aria-hidden', () => {
+    expect(HTML).toMatch(/id="badge"[^>]*aria-live="polite"/)
+    expect(HTML).toMatch(/id="error-row"[^>]*role="alert"/)
+    expect(HTML).toMatch(/id="badge-spinner"[^>]*aria-hidden="true"/)
+  })
+})
+
+describe('SC-C3 零蓝紫:hex/rgb/hsl 三种写法都扫', () => {
+  /** 判定色相落在蓝紫区间(190°–290°),覆盖 violet #6957e8 与 Focus Blue #417CDD 及其等价表示。 */
+  const hueOf = (r: number, g: number, b: number) => {
+    const [rr, gg, bb] = [r / 255, g / 255, b / 255]
+    const max = Math.max(rr, gg, bb)
+    const min = Math.min(rr, gg, bb)
+    if (max === min) return null // 灰,无色相
+    const d = max - min
+    let h = max === rr ? ((gg - bb) / d) % 6 : max === gg ? (bb - rr) / d + 2 : (rr - gg) / d + 4
+    h *= 60
+    return h < 0 ? h + 360 : h
+  }
+  const isBlueViolet = (h: number | null, sat: number) => h !== null && sat > 0.12 && h >= 190 && h <= 290
+
+  it('settings.html / settings.js / settingsCard.ts 里没有蓝紫色相字面量(含 var() 回退值)', () => {
+    const sources = ['../../settings.html', '../../settings.js', '../settings/settingsCard.ts'].map((rel) =>
+      readFileSync(fileURLToPath(new URL(rel, import.meta.url)), 'utf8'),
+    )
+    const offenders: string[] = []
+    for (const text of sources) {
+      for (const m of text.matchAll(/#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})\b/g)) {
+        const hex = m[1].length === 3 ? m[1].replace(/./g, (c) => c + c) : m[1]
+        const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16))
+        const max = Math.max(r, g, b) / 255
+        const min = Math.min(r, g, b) / 255
+        const sat = max === 0 ? 0 : (max - min) / max
+        if (isBlueViolet(hueOf(r, g, b), sat)) offenders.push(m[0])
+      }
+      for (const m of text.matchAll(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/g)) {
+        const [r, g, b] = [1, 2, 3].map((i) => Number(m[i]))
+        const max = Math.max(r, g, b) / 255
+        const min = Math.min(r, g, b) / 255
+        const sat = max === 0 ? 0 : (max - min) / max
+        if (isBlueViolet(hueOf(r, g, b), sat)) offenders.push(m[0])
+      }
+      for (const m of text.matchAll(/hsla?\(\s*(\d+(?:\.\d+)?)\s*(?:deg)?\s*[, ]\s*(\d+(?:\.\d+)?)%/g)) {
+        if (isBlueViolet(Number(m[1]), Number(m[2]) / 100)) offenders.push(m[0])
+      }
+    }
+    expect(offenders).toEqual([])
+  })
+
+  it('自检:探测器认得出 violet 与 Focus Blue(否则上一条是恒真的)', () => {
+    for (const hex of ['#6957e8', '#417CDD']) {
+      const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16))
+      const max = Math.max(r, g, b) / 255
+      const min = Math.min(r, g, b) / 255
+      expect(isBlueViolet(hueOf(r, g, b), (max - min) / max)).toBe(true)
+    }
+  })
+})
+
+describe('SC-C4 字号门:UI 字号全部落在 9..14px', () => {
+  it('settings.html 的每个 font-size 都在区间内(反向变异:改成 18px 必须红)', () => {
+    const sizes = [...HTML.matchAll(/font-size:\s*(\d+(?:\.\d+)?)px/g)].map((m) => Number(m[1]))
+    expect(sizes.length).toBeGreaterThan(3)
+    for (const size of sizes) expect(size).toBeGreaterThanOrEqual(9)
+    for (const size of sizes) expect(size).toBeLessThanOrEqual(14)
+  })
+})
+
+describe('SC-C6 外链 href 与 ghost.json 声明逐字相等', () => {
+  it('href 原样等于 network.secrets[0].url(宿主按逐字比对放行外链,不等就点了没反应)', () => {
+    const ghost = JSON.parse(readFileSync(fileURLToPath(new URL('../../ghost.json', import.meta.url)), 'utf8'))
+    const declared = ghost.network.secrets.find((s: { key: string }) => s.key === SECRET_KEY).url
+    const hrefs = [...HTML.matchAll(/href="([^"]+)"/g)].map((m) => m[1])
+    expect(hrefs).toEqual([declared])
+  })
+})
