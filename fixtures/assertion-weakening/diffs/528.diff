@@ -0,0 +1,351 @@
+/**
+ * Mivo API Key 设置卡(PR-C)· 五态状态机 + 保存/断开矩阵 + R3 视觉不变量。
+ * SC 对照:_tmp/debug/mivo-key-sc.md §5(SC-C1..C9)+ §2 的 D4。
+ *
+ * 状态机断言跑在真实 `createSettingsCard` 上(注入 fetch 三档与假 sender);视觉断言跑在
+ * **真实 settings.html 源文本**上 —— 见文件末尾那组测试的注释,那里说明了为什么不是
+ * computed-style。
+ */
+import { describe, expect, it } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { createSettingsCard, SECRET_KEY } from '../settings/settingsCard'
+import type { CardView } from '../settings/settingsCard'
+import type { MivoKeyValidateOutcome } from '../settings/mivoKeyValidateSender'
+
+const TAIL = 'a1b2'
+const savedRow = (tail?: string) => [{ key: SECRET_KEY, saved: true, ...(tail ? { tail } : {}) }]
+
+type Calls = { put: string[]; del: number; validate: number; cancel: number; reads: number }
+
+const makeCard = (options: {
+  secrets?: () => Promise<unknown>
+  putStatus?: number | (() => Promise<number>)
+  deleteStatus?: number | (() => Promise<number>)
+  outcome?: MivoKeyValidateOutcome | (() => Promise<MivoKeyValidateOutcome>)
+}) => {
+  const calls: Calls = { put: [], del: 0, validate: 0, cancel: 0, reads: 0 }
+  const views: CardView[] = []
+  const card = createSettingsCard({
+    readSecrets: async () => {
+      calls.reads += 1
+      return options.secrets ? options.secrets() : []
+    },
+    putSecret: async (value) => {
+      calls.put.push(value)
+      const s = options.putStatus ?? 204
+      return typeof s === 'number' ? s : s()
+    },
+    deleteSecret: async () => {
+      calls.del += 1
+      const s = options.deleteStatus ?? 204
+      return typeof s === 'number' ? s : s()
+    },
+    sender: {
+      validate: async () => {
+        calls.validate += 1
+        const o = options.outcome ?? 'valid'
+        return typeof o === 'string' ? o : o()
+      },
+      cancel: () => {
+        calls.cancel += 1
+      },
+    },
+    render: (view) => views.push({ ...view }),
+  })
+  return { card, calls, views }
+}
+
+// ── SC-C1:/secrets × 校验结果 × in-flight → 唯一 UI 输出(逐格)────────────────
+describe('SC-C1 迁移表:开页路径', () => {
+  it('/secrets 无该 key → unconfigured(输入框可编辑 + 保存,零校验)', async () => {
+    const { card, calls } = makeCard({ secrets: async () => [] })
+    await card.start()
+    expect(card.view.state).toBe('unconfigured')
+    expect(card.view.badgeText).toBe('未配置')
+    expect(card.view).toMatchObject({ showInput: true, inputDisabled: false, primaryLabel: '保存', primaryDisabled: false })
+    expect(card.view.badgeIcon).toBe('') // R3 反馈⑤:未配置徽标没有前缀符号
+    expect(calls.validate).toBe(0) // 没 key 不打校验
+  })
+
+  it('/secrets saved=true → 先 validating(读取中→校验中都是转圈徽标)→ valid → connected 带尾号', async () => {
+    const { card, views, calls } = makeCard({ secrets: async () => savedRow(TAIL), outcome: 'valid' })
+    await card.start()
+    // R3 骨架:loading 与 validating 共用同款转圈徽标,文字分别「读取中」/「校验中」。
+    expect(views[0]).toMatchObject({ state: 'loading', badgeText: '读取中', badgeSpinner: true })
+    const validating = views.find((v) => v.state === 'validating')
+    expect(validating).toMatchObject({ badgeText: '校验中', badgeSpinner: true, inputDisabled: true, primaryLabel: '校验', primaryDisabled: true })
+    expect(calls.validate).toBe(1) // 「已连接」= 真校验过,不是 saved=true 就吹(R3 根因)
+    expect(card.view.state).toBe('connected')
+    expect(card.view.badgeText).toBe('已连接')
+    expect(card.view.badgeIcon).toBe('✓')
+    expect(card.view.statusText).toContain('尾号 …' + TAIL) // SC-C2:tail 唯一来源是 /secrets.tail
+    expect(card.view.showInput).toBe(false) // 已连接态无输入框(SC-C7:改 key 必须先断开)
+    expect(card.view.showDisconnect).toBe(true)
+  })
+
+  it('/secrets 抛错 → 不猜未配置也不猜已连接,落 failed 并说清是读取失败', async () => {
+    const { card, calls } = makeCard({
+      secrets: async () => {
+        throw new Error('boom')
+      },
+    })
+    await card.start()
+    expect(card.view.state).toBe('failed')
+    expect(card.view.errorText).toContain('读取配置状态失败')
+    expect(calls.validate).toBe(0)
+  })
+
+  const FAILURES: Array<[Exclude<MivoKeyValidateOutcome, 'valid' | 'cancelled'>, string]> = [
+    ['auth-invalid', 'Key 无效'],
+    ['auth-forbidden', '没有访问权限'],
+    ['unavailable', '暂时连不上'],
+    ['timeout', '校验超时'],
+  ]
+  for (const [outcome, fragment] of FAILURES) {
+    it(`校验 ${outcome} → failed(红徽标 + 重试 + 输入框红边),文案区分得开`, async () => {
+      const { card } = makeCard({ secrets: async () => savedRow(), outcome })
+      await card.start()
+      expect(card.view.state).toBe('failed')
+      expect(card.view).toMatchObject({ badgeText: '连接失败', badgeIcon: '✕', badgeSpinner: false, inputError: true, primaryLabel: '重试' })
+      expect(card.view.errorText).toContain(fragment)
+    })
+  }
+
+  it('校验 cancelled(新一轮已接管)→ 旧轮不许改 UI,停在 validating', async () => {
+    const { card } = makeCard({ secrets: async () => savedRow(), outcome: 'cancelled' })
+    await card.start()
+    expect(card.view.state).toBe('validating') // 旧轮既不判成功也不判失败
+  })
+})
+
+// ── SC-C5:保存/删除失败矩阵 ───────────────────────────────────────────────────
+describe('SC-C5 保存矩阵:只有 204 才推进到校验', () => {
+  it('空值 → 零 PUT 零校验,只提示', async () => {
+    const { card, calls } = makeCard({ secrets: async () => [] })
+    await card.start()
+    await card.save('   ')
+    expect(calls.put).toHaveLength(0)
+    expect(calls.validate).toBe(0)
