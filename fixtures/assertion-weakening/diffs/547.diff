diff --git a/src/canvas/screenToCanvasExport.contract.test.ts b/src/canvas/screenToCanvasExport.contract.test.ts
new file mode 100644
index 00000000..dccd7e18
--- /dev/null
+++ b/src/canvas/screenToCanvasExport.contract.test.ts
@@ -0,0 +1,140 @@
+// src/canvas/screenToCanvasExport.contract.test.ts
+// #536 P1-4b rev-verify guard: useCanvasInteractionController must forward
+// useViewport's screenToCanvas (ref-correct by construction, see
+// useViewport.ts:195-201 — default param `sourceViewport = viewportRef.current`
+// resolves fresh on every call) instead of MivoCanvas.tsx re-implementing its
+// own copy that reads the closure-captured `viewport` state (stale in the
+// mid-pan right-click-interrupt scenario: handleCanvasContextMenu calls
+// resetPan() then immediately reads coordinates in the SAME closure — see
+// viewportPostPanStaleRead.audit.test.tsx for the behavioral repro of that bug).
+//
+// Why a source contract, not a runtime render test: this repo has no React hook
+// render harness for the FULL controller (heavy zustand-store + many sub-hook
+// dependency chain — mounting it is high-cost/high-risk for what is fundamentally
+// a "are these two return values wired through" question). A source-text check
+// is the lightweight guard used elsewhere in this file's directory for exactly
+// this kind of wiring contract (see scene-reset.contract.test.ts's own rationale).
+// The BEHAVIORAL correctness of screenToCanvas itself (does it read the ref
+// fresh in the mid-pan-interrupt scenario) is covered separately by
+// viewportPostPanStaleRead.audit.test.tsx, which mounts useViewport directly —
+// that test cannot detect whether MivoCanvas.tsx actually consumes the export
+// (it never touches MivoCanvas.tsx or the controller), which is exactly the gap
+// this contract closes.
+
+import { describe, expect, it } from 'vitest'
+// `?raw` import (typed by vite/client) reads the source as a string — same
+// technique as scene-reset.contract.test.ts.
+import controllerSource from './useCanvasInteractionController.ts?raw'
+import canvasSource from './MivoCanvas.tsx?raw'
+
+describe('contract: useCanvasInteractionController exports screenToCanvas; MivoCanvas.tsx consumes it instead of a local duplicate (#536 P1-4b)', () => {
+  it('controller destructures screenToCanvas from its useViewport(...) call', () => {
+    const useViewportCallIdx = controllerSource.indexOf('} = useViewport(')
+    expect(useViewportCallIdx, 'useViewport(...) call site not found — controller structure changed, update this test').toBeGreaterThan(-1)
+    const destructureBlock = controllerSource.slice(0, useViewportCallIdx)
+    expect(destructureBlock).toMatch(/\bscreenToCanvas\b/)
+  })
+
+  it('controller forwards screenToCanvas in its own return object', () => {
+    const returnIdx = controllerSource.lastIndexOf('return {')
+    expect(returnIdx, 'return statement not found — controller structure changed, update this test').toBeGreaterThan(-1)
+    const returnBlock = controllerSource.slice(returnIdx)
+    expect(returnBlock).toMatch(/\bscreenToCanvas\b/)
+  })
+
+  it('MivoCanvas.tsx no longer defines a local screenToCanvasPoint duplicate (the P1-4b bug source)', () => {
+    expect(canvasSource).not.toMatch(/\bconst screenToCanvasPoint\s*=/)
+  })
+
+  it('MivoCanvas.tsx destructures screenToCanvas from useCanvasInteractionController(...)', () => {
+    const controllerCallIdx = canvasSource.indexOf('} = useCanvasInteractionController(')
+    expect(controllerCallIdx, 'useCanvasInteractionController(...) call site not found — MivoCanvas.tsx structure changed, update this test').toBeGreaterThan(-1)
+    const destructureBlock = canvasSource.slice(0, controllerCallIdx)
+    expect(destructureBlock).toMatch(/\bscreenToCanvas\b/)
+  })
+
+  // CDX-R1-C6-001 修正:此前这里是单条 matchAll(...).length >= 4 的存在性计数
+  // 校验,注释声称"足以拦住漏改"——三审 M7 变异实测证伪:把某一个真实消费点
+  // 改回 screenToCanvasPoint(...),同时在文件里任意无关处补一个诱饵调用
+  // screenToCanvas(0, 0),总数不变,计数校验仍然绿,但语义已经错了。
+  // 改为逐消费点绑定断言:每个消费点用其"前一条语句"和"后一条语句"的唯一
+  // 字符串界定出一个不重叠的代码窗口,分别断言窗口内调用的是 screenToCanvas(
+  // 而不是 screenToCanvasPoint。窗口边界与下一条语句相邻,不依赖行号。
+  //
+  // CDX-R2-C6-001 二次修正:上一版负向断言锚的是 /\bscreenToCanvasPoint\(/
+  // ——"标识符后紧跟左括号"的调用语法形态。三审第②席对抗实测证伪:诱饵放进
+  // 语义窗口内部(喂饱正向断言)+ 属性式调用 `legacyViewport.screenToCanvasPoint)(...)`
+  // 逃过"调用语法"正则(标识符后面跟的是 `)`,不是 `(`),9/9 照绿。
+  // 改为 token 级零出现:/\bscreenToCanvasPoint\b/,不再要求紧跟左括号,命中
+  // 普通属性访问、别名解构(`const { screenToCanvasPoint: f } = ...`)、
+  // import 重命名、字符串字面量提及。
+  //
+  // 边界(收窄口径,如实声明,不夸大):本文件是源码文本静态检查,只能拦住
+  // "标识符 screenToCanvasPoint 以某种 token 形式出现在源码文本里"这一类
+  // 绕法(上面列的四种普通变体)。**不防**:Unicode 转义标识符(如
+  // `screenToCanvasPoint`)、字符串拼接构名(如 `'screenToCanvas' + 'Point'`
+  // 再动态取值)、以及完全匿名的内联坐标数学重实现(不出现这个标识符,直接
+  // 手写等价公式)——文本静态检查对这三类在原理上无解,已登记进 README「残余
+  // 风险」区,不在本文件内声称覆盖。
+  it('node right-click canvasPosition (openNodeContextMenu) binds to screenToCanvas, not a screenToCanvasPoint token in any form', () => {
+    const startAnchor = 'const openNodeContextMenu = useCallback('
+    const endAnchor = 'const handleOpenNodeDetails = useOpenNodeDetails('
+    const start = canvasSource.indexOf(startAnchor)
+    expect(start, `start anchor not found — MivoCanvas.tsx structure changed: "${startAnchor}"`).toBeGreaterThan(-1)
+    const end = canvasSource.indexOf(endAnchor, start)
+    expect(end, `end anchor not found — MivoCanvas.tsx structure changed: "${endAnchor}"`).toBeGreaterThan(start)
+    const consumerWindow = canvasSource.slice(start, end)
+    expect(consumerWindow).toMatch(/\bscreenToCanvas\(/)
+    // token 级(不要求紧跟左括号):同时挡"调用语法"绕法(属性式调用
+    // `.screenToCanvasPoint)(...)`)和"诱饵塞进窗口内部"绕法——诱饵加的是
+    // screenToCanvas(0, 0),不含 screenToCanvasPoint 这个 token,不受影响。
+    expect(consumerWindow).not.toMatch(/\bscreenToCanvasPoint\b/)
+  })
+
+  it('local-asset drag-drop landing point (importLocalAssetAtClientPoint) binds to screenToCanvas, not a screenToCanvasPoint token in any form', () => {
+    const startAnchor = 'const importLocalAssetAtClientPoint = useCallback('
+    const endAnchor = 'const handleCanvasDragOver = useCallback('
+    const start = canvasSource.indexOf(startAnchor)
+    expect(start, `start anchor not found — MivoCanvas.tsx structure changed: "${startAnchor}"`).toBeGreaterThan(-1)
+    const end = canvasSource.indexOf(endAnchor, start)
+    expect(end, `end anchor not found — MivoCanvas.tsx structure changed: "${endAnchor}"`).toBeGreaterThan(start)
+    const consumerWindow = canvasSource.slice(start, end)
+    expect(consumerWindow).toMatch(/\bscreenToCanvas\(/)
+    expect(consumerWindow).not.toMatch(/\bscreenToCanvasPoint\b/)
+  })
+
+  it('file drag-drop landing point (handleCanvasDrop) binds to screenToCanvas, not a screenToCanvasPoint token in any form', () => {
+    const startAnchor = 'const handleCanvasDrop = useCallback('
+    const endAnchor = 'onRegisterExternalAssetDrop?.(importLocalAssetAtClientPoint)'
+    const start = canvasSource.indexOf(startAnchor)
+    expect(start, `start anchor not found — MivoCanvas.tsx structure changed: "${startAnchor}"`).toBeGreaterThan(-1)
+    const end = canvasSource.indexOf(endAnchor, start)
+    expect(end, `end anchor not found — MivoCanvas.tsx structure changed: "${endAnchor}"`).toBeGreaterThan(start)
+    const consumerWindow = canvasSource.slice(start, end)
+    expect(consumerWindow).toMatch(/\bscreenToCanvas\(/)
+    expect(consumerWindow).not.toMatch(/\bscreenToCanvasPoint\b/)
+  })
+
+  it('blank right-click canvasPosition (handleCanvasContextMenu) binds to screenToCanvas, not a screenToCanvasPoint token in any form', () => {
+    const startAnchor = 'const handleCanvasContextMenu = useCallback((event: ReactMouseEvent<HTMLElement>) => {'
+    const endAnchor = 'const handleCanvasDoubleClick = useCallback((event: ReactMouseEvent<HTMLElement>) => {'
+    const start = canvasSource.indexOf(startAnchor)
+    expect(start, `start anchor not found — MivoCanvas.tsx structure changed: "${startAnchor}"`).toBeGreaterThan(-1)
+    const end = canvasSource.indexOf(endAnchor, start)
+    expect(end, `end anchor not found — MivoCanvas.tsx structure changed: "${endAnchor}"`).toBeGreaterThan(start)
+    const consumerWindow = canvasSource.slice(start, end)
+    expect(consumerWindow).toMatch(/\bscreenToCanvas\(/)
+    expect(consumerWindow).not.toMatch(/\bscreenToCanvasPoint\b/)
+  })
+
+  it('MivoCanvas.tsx never mentions the screenToCanvasPoint token anywhere (token-level, decoy- and call-syntax-immune whole-file guard)', () => {
+    // 与上面 4 条逐点绑定断言互补,不是重复:这条不依赖窗口边界,覆盖整份
+    // 源码文本。升级为 token 级(而非"标识符后紧跟左括号"的调用语法级)后,
+    // 属性式调用 `obj.screenToCanvasPoint)(...)`、别名解构
+    // `const { screenToCanvasPoint: f } = ...`、import 重命名
+    // `import { screenToCanvasPoint as x }`、字符串字面量提及,全部命中。
+    // 只对 canvasSource(MivoCanvas.tsx)生效,不扫本文件自己的注释/controllerSource。
+    const staleTokenSites = [...canvasSource.matchAll(/\bscreenToCanvasPoint\b/g)]
+    expect(staleTokenSites.length, 'expected zero screenToCanvasPoint token occurrences (any syntactic form) in MivoCanvas.tsx').toBe(0)
+  })
+})
