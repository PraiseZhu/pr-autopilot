diff --git a/src/canvas/useViewport.panCommitRace.test.tsx b/src/canvas/useViewport.panCommitRace.test.tsx
new file mode 100644
index 00000000..fecdc4aa
--- /dev/null
+++ b/src/canvas/useViewport.panCommitRace.test.tsx
@@ -0,0 +1,327 @@
+// @vitest-environment happy-dom
+//
+// Issue #536 根因回归钉子:freeze-pan(virtualize+culling 默认 on)拖拽松手后,
+// 旧实现用 window.setTimeout 延迟 120ms 才把 viewportRef 汇入 React state。这段
+// 窗口内 viewportRef 已经是拖拽终点,但任何经 setViewport(current => ...) 起算的
+// 紧随操作(zoomTo/handleWheel)仍会拿 React state 的旧 current 计算,产生「屏幕
+// 已经在新位置,一操作却按旧位置跳」的错误结果——真机 nightly zoom-tool 断言即
+// 由此产生(PR #524 把 virtualize 默认值从 off 翻成 on 后激活了这条早已存在的
