+  startNodes: string[],
+  bannedTarget: string,
+  excludeSubtreeRoots: string[],
+  getDirectDeps: (node: string) => string[],
+): string[] | null {
+  const excluded = new Set(excludeSubtreeRoots)
+  const visited = new Set<string>()
+  const queue: Array<{ node: string; path: string[] }> = startNodes
+    .filter((n) => !excluded.has(n))
+    .map((n) => ({ node: n, path: [n] }))
+  while (queue.length) {
+    const current = queue.shift() as { node: string; path: string[] }
+    if (current.node === bannedTarget) return current.path
+    if (visited.has(current.node)) continue
+    visited.add(current.node)
+    for (const dep of getDirectDeps(current.node)) {
+      if (excluded.has(dep)) continue
+      queue.push({ node: dep, path: [...current.path, dep] })
+    }
+  }
+  return null
+}
+
+/** 生产用:某个仓相对路径文件的直接相对依赖(已用 resolveImport 解析为仓相对路径)。 */
+function directRelativeDeps(posix: string): string[] {
+  let text: string
+  try {
+    text = readFileSync(join(process.cwd(), posix), 'utf8')
+  } catch {
+    return []
+  }
+  const { bindings, dynamicSpecs } = collectImportBindings(text, posix)
+  const specs = new Set<string>()
+  for (const b of bindings) specs.add(b.specifierText)
+  for (const s of dynamicSpecs) specs.add(s)
+  const out: string[] = []
+  for (const spec of specs) {
+    if (!RELATIVE_SPEC_RE.test(spec)) continue
+    const resolved = resolveImport(spec, posix)
+    if (resolved) out.push(resolved)
+  }
+  return out
+}
+
+type BindingLockResult = { ok: boolean; violations: string[] }
+
+/** R1~R5 汇总判定。`fromFilePosix` 默认为 agentBridge.ts 自身,可传别的仓相对
+ * 路径以便对 fixture 字符串复用同一套 specifier 解析基准目录。 */
+function validateDepositBindingLock(sourceText: string, fromFilePosix: string = AGENT_BRIDGE_PATH): BindingLockResult {
+  const violations: string[] = []
+  const { bindings, dynamicSpecs } = collectImportBindings(sourceText, fromFilePosix)
+
+  let resolvesDepositEntryFromPort = false
+  for (const b of bindings) {
+    if (b.importedName === 'depositBlob') {
+      violations.push(`R2 违规:导入名为 depositBlob(specifier=${b.specifierText})`)
+    }
+    if (!RELATIVE_SPEC_RE.test(b.specifierText)) continue
+    const resolved = resolveImport(b.specifierText, fromFilePosix)
+    if (resolved === DEPOSIT_STORE_PATH) {
+      violations.push(`R3 违规:导入名「${b.importedName}」解析自 depositStore(specifier=${b.specifierText})`)
+    }
+    if (resolved === DEPOSIT_PORT_PATH && b.importedName === 'resolveDepositEntry') {
+      resolvesDepositEntryFromPort = true
+    }
+    // R6(r2-vision 二轮审 MAJOR 4):depositPort 的 namespace/default 导入一律拒绝。
+    //
+    // 为什么必须单独立一条:R2 只按**导入名**禁 `depositBlob`,而 `import * as rawPort
+    // from './depositPort'` 的导入名是 `'*'`——它一次性拿到该模块的全部导出(含
+    // depositBlob),随后 `rawPort.depositBlob(...)` 就绕开了缓存/single-flight/失败提交
+    // 补偿。R3 只看 depositStore、R5 又把 depositPort 排除在起点之外,于是这条路径在
+    // R1~R5 下判 gateWouldPass:true,而「每次点名都新寄存」已经复活。
+    //
+    // 换句话说:R2 锁的是「你导入了哪个名字」,锁不住「你导入了一个能取到所有名字的
+    // 容器」。按名字做白/黑名单时,namespace 导入是必须单独处理的逃逸口。
+    if (resolved === DEPOSIT_PORT_PATH && (b.importedName === '*' || b.importedName === 'default')) {
+      violations.push(
+        `R6 违规:depositPort 的 namespace/default 导入(导入名「${b.importedName}」,specifier=${b.specifierText})` +
+          '——它绕过 R2 的具名黑名单,可直取 depositBlob',
+      )
+    }
+  }
+  for (const spec of dynamicSpecs) {
+    if (!RELATIVE_SPEC_RE.test(spec)) continue
+    if (resolveImport(spec, fromFilePosix) === DEPOSIT_STORE_PATH) {
+      violations.push(`R3 违规:动态 import 解析自 depositStore(specifier=${spec})`)
+    }
+  }
+  if (!resolvesDepositEntryFromPort) {
+    violations.push('R1 违规:未找到从 ./depositPort 导入的、导入名为 resolveDepositEntry 的具名导入')
+  }
+  const localRedeclarations = countLocalNameDeclarations(sourceText, fromFilePosix, 'resolveDepositEntry')
+  if (localRedeclarations > 0) {
+    violations.push(`R4 违规:文件内存在 ${localRedeclarations} 处对 resolveDepositEntry 的本地重新声明(应只有导入绑定)`)
+  }
+
+  const directTargets = new Set<string>()
+  for (const b of bindings) {
+    if (!RELATIVE_SPEC_RE.test(b.specifierText)) continue
+    const resolved = resolveImport(b.specifierText, fromFilePosix)
+    if (resolved) directTargets.add(resolved)
+  }
+  const startNodes = [...directTargets].filter((p) => p !== DEPOSIT_PORT_PATH)
+  const indirectHit = findIndirectDependency(startNodes, DEPOSIT_STORE_PATH, [DEPOSIT_PORT_PATH], directRelativeDeps)
+  if (indirectHit) {
+    violations.push(`R5 违规:间接依赖 depositStore,路径=${indirectHit.join(' -> ')}`)
+  }
+
+  return { ok: violations.length === 0, violations }
+}
+
+describe('SC-T3b.1 / SC-T3b1-fix.1 唯一业务链:AST 接线锁(替换可绕过的字符串扫描)', () => {
+  it('复现 judge 绕过:别名 depositBlob + 双引号 depositStore + 本地重实现同名 resolveDepositEntry —— 旧字符串扫描全绿,新 AST 门禁必须报错', () => {
+    const bypassSource = `
+import { depositBlob as rawDeposit } from './depositPort'
+import { lookupDeposit, recordDeposit } from "./depositStore"
+
+// 手搓 happy path,故意省掉 SC1b.11 的 failed-commit 补偿
+async function resolveDepositEntry(input) {
+  const cached = await lookupDeposit(input.assetUrl)
+  if (cached) return cached
+  const receipt = await rawDeposit(input.blob, input.label)
+  const entry = { hash: receipt.hash, ext: receipt.ext, bytes: receipt.bytes, depositedAt: Date.now(), from: 'deposit' }
+  await recordDeposit(input.assetUrl, entry)
+  return entry
+}
+
+export async function useIt(input) {
+  return resolveDepositEntry(input)
+}
+`
+    // 旧字符串扫描门禁(本文件曾用的判据)对这份绕过全绿——证明「字符串扫描」
+    // 本身是假绿,不是给新门禁立的稻草人。
+    expect(bypassSource).toContain('resolveDepositEntry(')
+    expect(bypassSource).not.toMatch(/\bdepositBlob\(/)
+    expect(bypassSource).not.toMatch(/from '\.\/depositStore'/)
+
+    // 新 AST 门禁必须拓住它:R1(未从 depositPort 导入 resolveDepositEntry)、
+    // R2(depositBlob 按导入名而非本地别名判定,别名 rawDeposit 逃不掉)、
+    // R3(直接依赖 depositStore,不论引号风格)、R4(本地重新声明同名函数)
+    // 四条应同时命中。
+    const result = validateDepositBindingLock(bypassSource, AGENT_BRIDGE_PATH)
+    expect(result.ok).toBe(false)
+    const joined = result.violations.join('\n')
+    expect(joined).toMatch(/R1 违规/)
+    expect(joined).toMatch(/R2 违规/)
+    expect(joined).toMatch(/R3 违规/)
+    expect(joined).toMatch(/R4 违规/)
+  })
+
+  it('R6:namespace import 逃逸口——合法具名导入齐全,却经 `import * as` 直取 depositBlob', () => {
+    // r2-vision 二轮审 MAJOR 4 的实跑反例:R1~R5 对这份**全绿**(gateWouldPass:true),
+    // 而它已经绕开缓存/single-flight/失败提交补偿,恢复了「每次点名都新寄存」。
+    //
+    // 它为什么能过 R1~R5:R1 要求的具名导入确实在(下面第一行);R2 只按导入名禁
+    // `depositBlob`,而 namespace 导入的导入名是 `'*'`;R3/R5 只盯 depositStore,而这里
+    // 一步都没碰 depositStore。**R2 锁的是「导入了哪个名字」,锁不住「导入了一个能取到
+    // 所有名字的容器」。**
+    const namespaceBypass = `
+import { resolveDepositEntry } from './depositPort'
+import * as rawPort from './depositPort'
+
+export async function resolveRequestedMedia(input: { blob: Blob; label: string }) {
+  void resolveDepositEntry
+  return rawPort.depositBlob(input.blob, input.label)
+}
+`
+    // 先证明这份绕过对旧的四条规则确实无害(否则就是给 R6 立稻草人):它既没有
+    // `depositBlob` 具名导入,也没碰 depositStore,还带着合法的 resolveDepositEntry 导入。
+    expect(namespaceBypass).toContain("import { resolveDepositEntry } from './depositPort'")
+    expect(namespaceBypass).not.toMatch(/import \{[^}]*depositBlob[^}]*\}/)
+    expect(namespaceBypass).not.toMatch(/depositStore/)
+
+    const result = validateDepositBindingLock(namespaceBypass, AGENT_BRIDGE_PATH)
+    expect(result.ok).toBe(false)
+    const joined = result.violations.join('\n')
+    // 必须**恰好**命中 R6 —— 若同时冒出 R1/R3/R5,说明这份夹具没有真的隔离出 R6
+    // 要拦的那条路径(那就退化成"随便哪条规则拦住了就算过")。
+    expect(joined).toMatch(/R6 违规/)
+    expect(joined).not.toMatch(/R1 违规/)
+    expect(joined).not.toMatch(/R3 违规/)
+    expect(joined).not.toMatch(/R5 违规/)
+  })
+
+  it('R6 不误伤:其它模块的 namespace import 照常放行(只锁 depositPort)', () => {
+    const benign = `
+import { resolveDepositEntry } from './depositPort'
+import * as ts from 'typescript'
+
+export async function resolveRequestedMedia(input: { blob: Blob; label: string }) {
+  void ts
+  return resolveDepositEntry(input.blob, input.label)
+}
+`
+    expect(validateDepositBindingLock(benign, AGENT_BRIDGE_PATH).violations).toEqual([])
+  })
+
+  it('真实 agentBridge.ts 源码通过 AST 门禁(R1~R6 全部满足,零 violation)', () => {
+    const source = readFileSync(join(process.cwd(), AGENT_BRIDGE_PATH), 'utf8')
+    const result = validateDepositBindingLock(source, AGENT_BRIDGE_PATH)
+    expect(result.violations).toEqual([])
+    expect(result.ok).toBe(true)
+  })
+
+  it('R5 图遍历算法本身:能穿透多跳发现间接依赖,且排除子树内的节点不误判(纯函数单测,不依赖磁盘)', () => {
+    const graph: Record<string, string[]> = {
+      helperA: ['helperB'],
+      helperB: ['depositStore'], // 间接:agentBridge → helperA → helperB → depositStore
+      depositPort: ['depositStore'], // 合法:depositPort 自己依赖 depositStore,应被排除子树
+    }
+    const getDeps = (n: string) => graph[n] ?? []
+
+    const hit = findIndirectDependency(['helperA', 'depositPort'], 'depositStore', ['depositPort'], getDeps)
+    expect(hit).toEqual(['helperA', 'helperB', 'depositStore'])
+
+    const clean = findIndirectDependency(['depositPort'], 'depositStore', ['depositPort'], getDeps)
+    expect(clean).toBeNull()
+  })
+})
