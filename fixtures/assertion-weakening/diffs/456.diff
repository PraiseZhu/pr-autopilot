+/** R4:文件内任何位置重新声明一个字面名为 `targetName` 的函数/变量/类(import 语句本身不算)。 */
+function countLocalNameDeclarations(sourceText: string, fromFilePosix: string, targetName: string): number {
+  const sf = ts.createSourceFile(fromFilePosix, sourceText, ts.ScriptTarget.Latest, true)
+  let count = 0
+  function visit(node: ts.Node) {
+    if (ts.isImportDeclaration(node) || ts.isImportEqualsDeclaration(node)) return
+    if ((ts.isFunctionDeclaration(node) || ts.isClassDeclaration(node)) && node.name?.text === targetName) {
+      count += 1
+    } else if (ts.isVariableDeclaration(node) && ts.isIdentifier(node.name) && node.name.text === targetName) {
+      count += 1
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(sf)
+  return count
+}
