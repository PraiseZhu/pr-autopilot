diff --git a/cindyplugin/src/i18n/translator.test.ts b/cindyplugin/src/i18n/translator.test.ts
new file mode 100644
index 00000000..a342144d
--- /dev/null
+++ b/cindyplugin/src/i18n/translator.test.ts
@@ -0,0 +1,150 @@
+/**
+ * @vitest-environment happy-dom
+ *
+ * P1c 返修 finding 3(minor):补两类此前缺失的契约测试。
+ *
+ * ①i18n 完整性:`cindyGenerationPort.ts` 导出的降级文案常量在 en/ja/ko 三份字典
+ *  里都有翻译,且译文与中文原文不同(不是"没翻译、原样落回字典"的假通过)。
+ * ②作用域收窄回归:finding 1 判回的正是"把整个 `.anchor-instruction-panel` 加
+ *  进白名单会连带误翻用户自己的节点标题"。这里用真实 DOM(happy-dom,非手写替身
+ *  ——CSS 选择器 `closest()`/`TreeWalker` 语义只有真 DOM 才不会跑偏)复现
+ *  AnchorOverlay 的最小结构,证明:
+ *   - 面板内、但不在 `.anchor-degrade-hint` 里的文本(模拟用户把节点命名为字典
+ *     key "Cancel")在非中文 locale 下**保持原文**;
+ *   - `.anchor-degrade-hint` 本身的降级提示文本**被正确翻译**。
+ *
+ * 本仓 unit 默认跑在 node env(未装 jsdom/happy-dom 全局),本文件用
+ * `@vitest-environment happy-dom` 单文件覆盖,不影响其余测试的默认环境。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { SOURCE_NOT_RECOGNIZED_MESSAGE } from '../agent/cindyGenerationPort'
+import { DICT_EN, DICT_JA, DICT_KO } from './dict'
+import { installLocaleTranslator } from './translator'
+
+describe('i18n 完整性(finding 3①)——降级文案的三语译文', () => {
+  it('en/ja/ko 均有该 key 的翻译,且译文与中文原文不同', () => {
+    for (const [label, dict] of [['en', DICT_EN], ['ja', DICT_JA], ['ko', DICT_KO]] as const) {
+      const translated = dict[SOURCE_NOT_RECOGNIZED_MESSAGE]
+      expect(translated, `${label} 字典缺少该 key 的译文`).toBeTypeOf('string')
+      expect(translated, `${label} 译文不能为空`).not.toHaveLength(0)
+      expect(translated, `${label} 译文与中文原文相同,像是没真的翻译`).not.toBe(SOURCE_NOT_RECOGNIZED_MESSAGE)
+    }
+  })
+
+  it('未知 locale 回落英文兜底——DICT_EN 的这条译文即回落时用户看到的文案', () => {
+    // dictForLocale 对非 zh/ja/ko 的 locale 固定回落 DICT_EN(手册规则);这里只
+    // 断言 DICT_EN 确有该 key,回落路径本身由 dict.ts 的 dictForLocale 保证,
+    // 不在本测试重复断言其分支逻辑。
+    expect(DICT_EN[SOURCE_NOT_RECOGNIZED_MESSAGE]).toBeTypeOf('string')
+  })
+})
+
+describe('作用域收窄回归(finding 1)——用户节点标题永远不动,降级提示才翻译', () => {
+  class FakeBroadcastChannel {
+    addEventListener() {}
+    removeEventListener() {}
+    postMessage() {}
+    close() {}
+  }
+
+  // installLocaleTranslator 每次调用都会新装一个 MutationObserver 观察
+  // document.body,且不对外暴露句柄。生产环境这不是问题(它只会被调一次,
+  // 换语言靠整页 reload);但本文件要在同一个 document.body 上反复调用它验证
+  // 不同 locale,若不追踪并在每个 it() 之后 disconnect,上一条用例装的 observer
+  // 会在下一条用例往 body 里插新节点时被动触发、用**已经过期的模块内 dict 闭包**
+  // 二次翻译,产出跟 locale 对不上的假结果(已实测踩过这个坑)。
+  const RealMutationObserver = globalThis.MutationObserver
+  let activeObservers: MutationObserver[] = []
+  class TrackingMutationObserver extends RealMutationObserver {
+    constructor(callback: MutationCallback) {
+      super(callback)
+      activeObservers.push(this)
+    }
+  }
+
+  beforeEach(() => {
+    vi.stubGlobal('BroadcastChannel', FakeBroadcastChannel)
+    vi.stubGlobal('MutationObserver', TrackingMutationObserver)
+    activeObservers = []
+  })
+
+  afterEach(() => {
+    for (const observer of activeObservers) observer.disconnect()
+    activeObservers = []
+    vi.unstubAllGlobals()
+    document.body.innerHTML = ''
+  })
+
+  /** 复现 AnchorOverlay.tsx 渲染出的最小 DOM 形状(不经 React,直接搭 DOM)。 */
+  const renderAnchorPanelFixture = (): { panel: HTMLElement; titleProbe: Text; hint: HTMLElement } => {
+    const panel = document.createElement('div')
+    panel.className = 'anchor-instruction-panel'
+
+    const label = document.createElement('label')
+    // 模拟 selected.node.title:用户自己起的节点名。故意取一个真实存在于字典里的
+    // 英文串("Cancel",裁剪工具条按钮名)——这正是 finding 1 描述的碰撞场景:
+    // 用户节点碰巧同名时,只有它被误翻才说明作用域收窄失败。
+    const titleProbe = document.createTextNode('Cancel')
+    label.appendChild(document.createTextNode('point anchor → '))
+    label.appendChild(titleProbe)
+    panel.appendChild(label)
+
+    const hint = document.createElement('span')
+    hint.className = 'anchor-degrade-hint'
+    hint.appendChild(document.createTextNode(SOURCE_NOT_RECOGNIZED_MESSAGE))
+    panel.appendChild(hint)
+
+    document.body.appendChild(panel)
+    return { panel, titleProbe, hint }
+  }
+
+  const withHostLocale = async (locale: string, run: () => Promise<void> | void) => {
+    vi.stubGlobal(
+      'fetch',
+      vi.fn(async (input: unknown) => {
+        if (String(input) === '/app-context') {
+          return { ok: true, json: async () => ({ context: { locale } }) } as Response
+        }
+        return { ok: true, json: async () => ({}) } as Response
+      }),
+    )
+    await run()
+  }
+
+  it('ja locale:用户节点标题 "Cancel" 不被翻译,降级提示被翻译成日语', async () => {
+    const { titleProbe, hint } = renderAnchorPanelFixture()
+    expect(DICT_JA.Cancel, '本测试假设的碰撞前提失效:字典里已经没有 Cancel 这个 key 了').toBe('キャンセル')
+
+    await withHostLocale('ja', () => installLocaleTranslator())
+
+    // 用户内容永远不动:即使 "Cancel" 是字典 key,它不在 .anchor-degrade-hint 里,
+    // closest(CHROME_SCOPE) 找不到匹配容器,inScope() 为 false,原样保留。
+    expect(titleProbe.textContent).toBe('Cancel')
+    // 降级提示本身在作用域内,按 ja 字典替换。
+    expect(hint.textContent).toBe(DICT_JA[SOURCE_NOT_RECOGNIZED_MESSAGE])
+    expect(hint.textContent).not.toBe(SOURCE_NOT_RECOGNIZED_MESSAGE)
+  })
+
+  it('en locale(未知 locale 回落场景的等价路径):同样只翻降级提示,不动用户标题', async () => {
+    const { titleProbe, hint } = renderAnchorPanelFixture()
+
+    await withHostLocale('en', () => installLocaleTranslator())
+
+    expect(titleProbe.textContent).toBe('Cancel')
+    expect(hint.textContent).toBe(DICT_EN[SOURCE_NOT_RECOGNIZED_MESSAGE])
+  })
+
+  it('回归护栏:若整个 .anchor-instruction-panel(而不是 .anchor-degrade-hint)在白名单里,用户标题会被误翻——证明这条判据本身是可证伪的', async () => {
+    // 这条不是测生产代码,是自证上面两条测试"真的在测作用域收窄"而不是碰巧通过。
+    // 直接用真实 DOM 复刻 finding 1 判回的那个错误版本:整个面板在 CHROME_SCOPE 里。
+    const panel = document.createElement('div')
+    panel.className = 'anchor-instruction-panel-legacy-repro'
+    const titleProbe = document.createTextNode('Cancel')
+    panel.appendChild(titleProbe)
+    document.body.appendChild(panel)
+
+    const scoped = panel.closest('.anchor-instruction-panel-legacy-repro, .anchor-degrade-hint')
+    expect(scoped, '把整个面板 class 塞进白名单时,面板内任意文本都会被判定为「在作用域内」——这正是 finding 1 的病因').not.toBeNull()
+  })
+})
