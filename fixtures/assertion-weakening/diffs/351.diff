+// src/store/demoScenes.test.ts
+// #284 同族(demo-canvas-server-leak):isDemoSeedCanvasId 是 demo seed 判定的单一真相源,
+//   下沉在纯数据模块 demoScenes(同 DEMO_SCENE_ID_SET / DEMO_PROJECT_ID_SET 先例),供
+//   documentSlice(document 级 mutation guard)与 canvasSyncRuntime(节点级同步 guard)复用,
+//   不得各自重新派生。本文件钉死其语义与既有 documentSlice.isDemoSeedCanvas 完全一致。
+import { describe, expect, it, vi } from 'vitest'
+import { isDemoSeedCanvasId, DEMO_SCENE_ID_SET, DEMO_PROJECT_ID_SET } from './demoScenes'
+
+vi.mock('../lib/demoImages', () => ({ createDemoImage: () => 'data:image/png;base64,mock-demo' }))
+
+describe('demoScenes — isDemoSeedCanvasId (#284 单一真相源)', () => {
+  it('canvas id 命中 DEMO_SCENE_ID_SET → true(projectId 缺省或任意均拦,scene id 是全局稳定 demo id)', () => {
+    expect(isDemoSeedCanvasId('variants')).toBe(true)
+    expect(isDemoSeedCanvasId('character-flow')).toBe(true)
+    expect(isDemoSeedCanvasId('asset-handoff')).toBe(true)
+    expect(isDemoSeedCanvasId('task-states')).toBe(true)
+    expect(isDemoSeedCanvasId('stress-test')).toBe(true)
+    expect(isDemoSeedCanvasId('empty')).toBe(true)
+    // projectId 缺省仍拦:demo scene id 不归任何真实项目,仅靠 scene id 命中即可
+    expect(isDemoSeedCanvasId('variants', undefined)).toBe(true)
+    // 即便 projectId 是非 demo 的真实项目,scene id 命中仍拦(demo scene id 全局稳定)
+    expect(isDemoSeedCanvasId('variants', 'real-project-xyz')).toBe(true)
+  })
+
+  it('canvas id 非 demo 且 projectId 缺省 → false(普通画布不拦,回归护栏)', () => {
+    expect(isDemoSeedCanvasId('c1')).toBe(false)
+    expect(isDemoSeedCanvasId('c1', undefined)).toBe(false)
+    expect(isDemoSeedCanvasId('uuid-not-a-demo', undefined)).toBe(false)
+  })
+
+  it('canvas id 非 demo 但 projectId 命中 DEMO_PROJECT_ID_SET → true(demo project 下画布同拦)', () => {
+    // 两集合各命中一次:concept-battlepass 与 product-direction
+    const [firstProjectId] = DEMO_PROJECT_ID_SET
+    const projectIds = [...DEMO_PROJECT_ID_SET]
+    expect(projectIds.length).toBeGreaterThanOrEqual(2)
+    expect(isDemoSeedCanvasId('c1', projectIds[0])).toBe(true)
+    expect(isDemoSeedCanvasId('c1', projectIds[1])).toBe(true)
+    expect(isDemoSeedCanvasId('uuid-123', firstProjectId)).toBe(true)
+  })
+
+  it('canvas id 非 demo 且 projectId 非 demo → false', () => {
+    expect(isDemoSeedCanvasId('c1', 'real-project')).toBe(false)
+  })
+
+  it('穷举:DEMO_SCENE_ID_SET 全员命中、DEMO_PROJECT_ID_SET 全员命中(防漏成员)', () => {
+    for (const sceneId of DEMO_SCENE_ID_SET) {
+      expect(isDemoSeedCanvasId(sceneId)).toBe(true)
+    }
+    for (const projectId of DEMO_PROJECT_ID_SET) {
+      // 非 demo canvas id + demo projectId → 拦
+      expect(isDemoSeedCanvasId('non-demo-canvas', projectId)).toBe(true)
+    }
+  })
+})
