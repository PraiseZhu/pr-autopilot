+    const localX = Math.min(canvas.width - 1, Math.max(0, Math.round(((left + right) / 2 - canvasRect.left) * scaleX)))
+    const localY = Math.min(canvas.height - 1, Math.max(0, Math.round(((top + bottom) / 2 - canvasRect.top) * scaleY)))
+    try {
+      const context = canvas.getContext('2d', { willReadFrequently: true })
