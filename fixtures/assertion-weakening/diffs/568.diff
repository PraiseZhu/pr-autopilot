+ * 白名单是唯一防线(hardening-checklist 第 6 类:exact,不是 subset)——不逐项排查黑名单,
+ * 因为黑名单测不完 Slack 控制语法的全集(2026-08-06 review 实测:`<!channel>`/`<!here>`/
+ * `*粗体*`/裸 CR 全部绕过了纯黑名单版本,`<!channel>`/`<!here>` 会真的 @ 全频道,不是
+ * 无害的格式问题)。剥掉本 tone 允许的表情后,剩余字符必须**全部**落在纯中文字符区间——
+ * 凡不在允许集里的字符,不论是什么,一律拒绝,不猜它是否安全。
+ */
+export function validateShellLine(line, tone) {
+  if (typeof line !== 'string') return { ok: false, reason: 'not-a-string' }
+  const trimmed = line.trim()
+  if (!trimmed) return { ok: false, reason: 'empty' }
+  if (/[\r\n]/.test(trimmed)) return { ok: false, reason: 'multi-line' }
+  if (trimmed.length > MAX_SHELL_LENGTH) return { ok: false, reason: `too-long(${trimmed.length})` }
+  if (/\d/.test(trimmed)) return { ok: false, reason: 'contains-digit' }
+  const numeralHit = CHINESE_NUMERAL_CHARS.find((c) => trimmed.includes(c))
+  if (numeralHit) return { ok: false, reason: `contains-chinese-numeral(${numeralHit})` }
+  const ordinalMarkerHit = ORDINAL_MARKER_CHARS.find((c) => trimmed.includes(c))
+  if (ordinalMarkerHit) return { ok: false, reason: `contains-ordinal-marker(${ordinalMarkerHit})` }
+  const factClaimHit = FACT_CLAIM_MARKERS.find((c) => trimmed.includes(c))
+  if (factClaimHit) return { ok: false, reason: `contains-fact-claim-marker(${factClaimHit})` }
+  // 「一」+ 任意单个 CJK 字符的两字组合,不在安全短语豁免表里 → 视为量词组合一律拒绝
+  // (不把命中的具体字符带进 reason——同 disallowed-char 的纪律,只报分类)。
+  const oneCharCombos = trimmed.match(/一[一-鿿]/gu) ?? []
+  if (oneCharCombos.some((combo) => !ONE_CHAR_SAFE_PHRASES.includes(combo))) {
+    return { ok: false, reason: 'contains-chinese-ordinal' }
+  }
+  if (trimmed.includes('#')) return { ok: false, reason: 'contains-hash' }
+  if (trimmed.includes('`')) return { ok: false, reason: 'contains-backtick' }
+  if (/https?:\/\//i.test(trimmed)) return { ok: false, reason: 'contains-url' }
+
+  const forbiddenHit = FORBIDDEN_EMOJI.find((e) => trimmed.includes(e))
+  if (forbiddenHit) return { ok: false, reason: `forbidden-emoji(${forbiddenHit})` }
+
+  const allowed = ALLOWED_EMOJI_BY_TONE[tone] ?? []
+  let rest = trimmed
+  for (const e of allowed) rest = rest.split(e).join('')
+  if (!/^[一-鿿]+$/u.test(rest)) {
+    // R2-CX-001(codex-adversarial R2):`rest` 是剥掉允许表情后剩下的原始 LLM 输出——不论
+    // 校验拒绝的是什么,reason 都不得把它原样带出去(同 chat() 里"只抛固定分类错误消息"的
+    // 纪律,理由一致:这条 reason 会经 buildPersonaShell 的 `invalid-output: ${v.reason}`
+    // 一路传到 patrol.mjs 的 appendLog/broadcast.mjs 的 printResult,落进 logs.md/stdout。
+    // 只报长度,不报内容。
+    return { ok: false, reason: `disallowed-char(len=${rest.length})` }
+  }
+
+  // 允许集里的表情最多出现 1 次(同 SKILL.md「同一条不堆叠」的纪律)。
+  const allowedCount = allowed.reduce((sum, e) => sum + trimmed.split(e).length - 1, 0)
+  if (allowedCount > 1) return { ok: false, reason: 'too-many-emoji' }
+
+  // suggestion(codex-adversarial R2):system prompt 明确要求表情"句尾",但此前只校验数量
+  // 不校验位置,"😌挺好的呢"这类表情在句首的输出会被放行。壳只有一个允许表情名额,直接判它
+  // 是否在结尾即可,不必解析整句结构。
+  if (allowedCount === 1) {
+    const usedEmoji = allowed.find((e) => trimmed.includes(e))
+    if (!trimmed.endsWith(usedEmoji)) return { ok: false, reason: 'emoji-not-at-end' }
+  }
+
+  return { ok: true }
+}
+
+/**
+ * 按字节数上限读取响应体,超限时立即 cancel 底层流并抛出,不等整段读完。
+ *
+ * F16(claude-adversarial R8):原实现是"先 `res.text()` 读完整个响应体,再判断长度"——
+ * 这个顺序本身就是漏洞所在:`res.text()` 会无条件把底层 stream 完整读进内存,不管读了
+ * 多少字节都不会中途停下。Content-Length 早退检查只在网关**诚实上报**该 header 时有效;
+ * 一个不发/发错该 header 的网关(不管是故意的还是单纯 bug),这层检查形同不存在——已用
+ * 50MB mock 响应实测复现:`res.text()` 2ms 内把 50MB 全部读进内存,读完之后才轮到长度
+ * 判断,而内存早已经分配出去了。改成边读边数字节,一旦超限立刻 `cancel()` 底层 reader,
+ * 从根上不让超限的字节进内存,不是"读完再后悔"。
+ *
+ * 测试 mock 若不提供 `res.body`(WHATWG ReadableStream,原生 fetch 的 Response 总会有,
+ * 只有手写 mock 才可能没有)——退回直接调用 `res.text()`,不做流式截断;这类 mock 场景
+ * 靠上面的 Content-Length 早退 + 下面兜底的整段长度判断(仍然保留,覆盖不了流式场景但
+ * 覆盖 mock 场景)。
+ */
+async function readBoundedText(res, maxBytes) {
+  if (!res.body || typeof res.body.getReader !== 'function') {
+    // 没有 stream 可读(手写 mock 未提供 res.body)——退回 text() 一次性读完,读完后仍要
+    // 补一次字节数判断:不能因为走的是兜底分支就放弃"响应体过大直接拒绝"这条防线。
+    const raw = await res.text()
+    if (Buffer.byteLength(raw, 'utf8') > maxBytes) {
+      throw new Error('llm-response-too-large')
+    }
+    return raw
+  }
+  const reader = res.body.getReader()
+  const chunks = []
+  let total = 0
+  while (true) {
+    const { done, value } = await reader.read()
+    if (done) break
+    total += value.byteLength ?? value.length ?? 0
+    if (total > maxBytes) {
+      await reader.cancel().catch(() => {})
+      throw new Error('llm-response-too-large')
+    }
+    chunks.push(value)
+  }
+  return Buffer.concat(chunks.map((c) => Buffer.from(c))).toString('utf8')
+}
+
+/**
+ * 打网关。失败抛错,由调用方决定回退原文。不重试、不换模型。
+ *
+ * **只抛固定分类的错误消息,绝不把远端响应正文原样带进 Error**(2026-08-06 review 实测:
+ * HTTP 非 200 时原实现把 `raw.slice(0,200)` 拼进 `Error.message`,而这条消息经
+ * `buildPersonaShell` 的 `reason` 字段一路传到 `patrol.mjs` 的 `appendLog`(落盘 logs.md)
+ * 与 `broadcast.mjs` 的 `printResult`(打到 stdout)——若网关端(或中间人)在错误响应体里
+ * 回显了请求内容的片段,凭证就可能借这条链路间接回显进持久化日志/公开输出。分类错误
+ * 消息本身不含任何来自响应体的原文,这条回显路径从根上不存在。
+ */
+async function chat({ model, key, messages, timeoutMs }) {
+  const controller = new AbortController()
+  const timer = setTimeout(() => controller.abort(), timeoutMs)
+  try {
+    let raw
+    let res
+    try {
+      res = await fetch(`${LLM_BASE_DEFAULT}/chat/completions`, {
+        method: 'POST',
+        headers: { Authorization: `Bearer ${key}`, 'content-type': 'application/json' },
+        // 只发 model + messages + temperature —— 与 merge-thanks 同一套请求形状。
+        // 不加 max_tokens:该网关对带 max_tokens 的请求会 404(见
+        // scripts/loops/merge-thanks/from-github-event.mjs 的同一条踩坑记录)。
+        body: JSON.stringify({ model, messages, temperature: 0.4 }),
+        signal: controller.signal,
+      })
+      // R6-CX-001(codex-adversarial R6):真实成功响应最多是"系统提示词回执 + 一行 ≤44 字的
+      // 壳"包在 JSON 里,量级顶多几 KB——一个正常网关不该也不需要返回超大响应体。这里先看
+      // Content-Length,超出直接拒绝,不必先把整个响应体读进内存再判断(64KB 已远超正常量级
+      // 的安全余量)。没有该 header(如 chunked encoding)时下面读完 raw 后还有兜底判断。
+      const contentLength = Number(res.headers?.get?.('content-length'))
+      if (Number.isFinite(contentLength) && contentLength > MAX_RESPONSE_BYTES) {
+        throw new Error('llm-response-too-large')
+      }
+      // R4-CX-001(codex-adversarial R4):上一轮只包住了 fetch() 本身,响应体读取错误(如
+      // 连接中途断开)仍会带着原始 message 直接抛出——同一条"reason 只允许固定分类字符串"
+      // 的纪律必须覆盖到读取响应体这一步,不能只包一半。F16(claude-adversarial R8):
+      // readBoundedText 边读边数字节,超限立即 cancel 底层流,不再是"读完整段再判断长度"。
+      raw = await readBoundedText(res, MAX_RESPONSE_BYTES)
+    } catch (networkErr) {
+      // R2-CX-001(codex-adversarial R2 补充):fetch 本身抛出的错误(超时 abort/DNS 失败/
+      // 连接被拒)未经分类就会被 buildPersonaShell 的 catch 块原样截取 message 拼进
+      // reason——虽然这类错误通常只是连接层诊断信息,不像 HTTP 错误体那样可能回显请求内容,
+      // 但同一条"reason 只允许固定分类字符串"的纪律理应无差别覆盖,不留"这条路径大概安全"
+      // 的例外。统一归类为固定字符串,不透传 networkErr.message。llm-response-too-large 是
+      // 我们自己抛的分类错误(不含原始内容),原样透传是安全的,单独放行不重新归类。
+      if (networkErr.message === 'llm-response-too-large') throw networkErr
+      throw new Error(controller.signal.aborted ? 'llm-timeout' : 'llm-network-error')
+    }
+    if (!res.ok) throw new Error(`llm-http-${res.status}`)
+    let data
+    try {
+      data = JSON.parse(raw)
+    } catch {
+      throw new Error('llm-invalid-json')
+    }
+    const content = data?.choices?.[0]?.message?.content
+    if (!content) throw new Error('llm-no-content')
+    return String(content).trim()
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+/**
+ * 尝试给一条播报追加人格壳。title 永远原样返回,不做任何修改。
+ * 全程 fail-open:任何失败都返回 applied:false 与原始 text,不抛异常。
+ *
+ * @param {{tone: 'p0-alert'|'daily-report', title: string, text: string, key?: string,
+ *   env?: NodeJS.ProcessEnv}} params
+ */
+export async function buildPersonaShell({ tone, title, text, key, env = process.env }) {
+  const base = { title, text, model: null, latencyMs: null }
+  let model = null
+  let t0 = null
+
+  // 结构性兜底(单审提出,2026-08-07 lead 拍板):本文件头把"绝不抛异常"写成核心契约,但此前
+  // 只靠函数体内逐处 try/catch 的控制流保证,没有一层顶层兜底。同一类"未捕获异常违反
+  // never-throws 契约"的缺陷已在本 PR 审查里独立复现 4 次(broadcast.mjs 的
+  // runBroadcast(undefined) 解构、stateDir: null、stateDir 其余畸形值、这里的
+  // res.text() 响应体读取路径),每次都是点状修一处。这里补上顶层 try/catch:函数体内任何
+  // 未来新增的同步操作,即使漏加局部 try/catch,也会被这层接住,不会让"绝不抛异常"的核心
+  // 契约悄悄破功。
+  try {
+    if (env.MIVO_PERSONA_SHELL_DISABLE === '1') {
+      return { ...base, attempted: false, applied: false, reason: 'disabled-by-env' }
+    }
+    if (env.MIVO_PERSONA_SHELL_ENABLE !== '1') {
+      return { ...base, attempted: false, applied: false, reason: 'disabled-by-default' }
+    }
+    if (!key) {
+      return { ...base, attempted: false, applied: false, reason: 'llm-key-missing' }
+    }
+
+    model = env.MIVO_PERSONA_SHELL_MODEL || MODEL_DEFAULT
+    const timeoutMs = TIMEOUT_MS_BY_TONE[tone] ?? TIMEOUT_MS_BY_TONE['daily-report']
+    const systemPrompt = SYSTEM_PROMPT_BY_TONE[tone] ?? SYSTEM_PROMPT_BY_TONE['daily-report']
+
+    t0 = Date.now()
+    let raw
+    try {
+      raw = await chat({
+        model,
+        key,
+        timeoutMs,
+        messages: [
+          { role: 'system', content: systemPrompt },
+          { role: 'user', content: `标题:${title}\n\n正文:\n${text}` },
+        ],
+      })
+    } catch (e) {
+      return {
+        ...base,
+        attempted: true,
+        applied: false,
+        model,
+        latencyMs: Date.now() - t0,
+        reason: `llm-error: ${String(e?.message ?? e).slice(0, 200)}`,
+      }
+    }
+
+    const latencyMs = Date.now() - t0
+    const v = validateShellLine(raw, tone)
+    if (!v.ok) {
+      return { ...base, attempted: true, applied: false, model, latencyMs, reason: `invalid-output: ${v.reason}` }
+    }
+
+    return {
+      title,
+      text: `${text}\n${raw.trim()}`,
+      attempted: true,
+      applied: true,
+      model,
+      latencyMs,
+      reason: null,
+    }
+  } catch {
+    // 兜底层本身不能是新的抛出点:不透传 catch 到的原始异常文本(同全文件"reason 只允许
+    // 固定分类字符串"的纪律),latencyMs 尽力取已知的 t0 重新计算一次,若这一步本身也抛出
+    // (如触发本次兜底的异常源就是 Date.now() 被 mock 成抛异常)则保持 null,不让兜底代码
+    // 自己再制造一次 uncaught throw。
+    let latencyMs = null
+    try {
+      latencyMs = t0 === null ? null : Date.now() - t0
+    } catch {
+      /* 保持 null */
+    }
+    return { ...base, attempted: true, applied: false, model, latencyMs, reason: 'unexpected-error' }
+  }
+}
