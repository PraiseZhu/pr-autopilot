+  '🟢', '🟡', '🔴', '📦', '⏳', '⚠️', '📌', '🔍', '✨', '⏸️',
+  '😡', '🤬', '😭', '😱', '🥺', '💀', '🔥', '🎉', '😍',
+  '🙄',
+]
+
+const MAX_SHELL_LENGTH = 44
+
