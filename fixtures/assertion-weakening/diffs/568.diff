+// persona-shell.mjs — Mivo 播报「人格壳」润色(P0 告警 / 每日战报共用)
+//
+// 定位:不改一个字的事实。原始 title/text 逐字不变,只在 text 末尾追加一行经黑名单
+// 校验的极短收尾句,失败(禁用/缺 key/超时/网络错误/校验不过)统一回落"完全不加壳"的
+// 原始文案——绝不抛异常,绝不让调用方的告警/播报因为这一层而延迟到不可接受、或干脆发不出去。
+//
+// 与 scripts/loops/merge-thanks/from-github-event.mjs 的差异(故意,不是遗漏):
+//   - 那边让模型改写整段"改动要点"(长文本、多信息点),这里模型只产出一行不含任何事实的
+//     态度收尾句——事实校验因此从"正则猜测哪些字符串是事实"简化为"壳本身是否守规矩",
+//     不会有事实被模型悄悄改掉的风险。
+//   - 那边失败会换一个回退模型再试一次;这里**单次尝试,不换模型**——P0 告警是 hourly
+//     critical alert,多试一次模型意味着多等一轮超时,不值得为了润色多拖延一次。
+//
+// 默认关闭:MIVO_PERSONA_SHELL_ENABLE!=='1' 时直接跳过,不发任何请求。
+// 熄火开关:MIVO_PERSONA_SHELL_DISABLE==='1' 优先级最高,网关抽风时不用改代码/重新部署。
+//
+// 网关地址**不接受环境变量覆盖**(2026-08-06 review 实测:曾提供 MIVO_PERSONA_SHELL_LLM_BASE
+// 覆盖开关,但请求会带着真实 key 打向该地址——若该变量被意外/恶意改写,等于把凭证连同
+// 完整告警正文一起发到任意主机,构成 SSRF/凭证外泄口子;且该开关在本文件的测试里从未被
+// 用到,纯属没有真实需要的 speculative 灵活性,直接删掉)。要切换网关只能改这个常量。
+//
+// 跑单测:npx vitest run scripts/loops/bug-doctor/persona-shell.test.mjs
+
+const LLM_BASE_DEFAULT = 'https://llm-proxy.tapsvc.com/v1'
+const MODEL_DEFAULT = 'deepseek/deepseek-v4-flash'
+
+// R6-CX-001(codex-adversarial R6):正常成功响应顶多几 KB(系统提示词回执 + 一行 ≤44 字的
+// 壳),64KB 是留了大量安全余量后的硬上限,超出即视为网关异常行为,见 chat() 里的用法。
+const MAX_RESPONSE_BYTES = 64 * 1024
+
+// tone → 单次请求超时(ms)。P0 是 hourly critical alert,超时必须短;每日战报不那么紧急,
+// 给多一点余量,但也不能长到让"主轮收尾"卡住太久。
+export const TIMEOUT_MS_BY_TONE = {
+  'p0-alert': 5_000,
+  'daily-report': 15_000,
+}
+
+// 表情配额(对齐 review-pr SKILL.md「对外话术与人格边界」的分级 + 禁用集):
+//   - p0-alert 比模板 E 还淡一档:只允许「从容」的 😌,不允许带得意/傲气的 😏/😤——
+//     故障告警不该显得云淡风轻。
+//   - daily-report 对齐模板 F 的允许集,但排除仅限私聊通道的 👀。
+const ALLOWED_EMOJI_BY_TONE = {
+  'p0-alert': ['😌'],
+  'daily-report': ['😏', '😤', '🤨', '😌', '🙃'],
+}
