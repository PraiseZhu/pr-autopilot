+// SC-7(用户截图「两个合并被合并进同一条播报」的调查结论):本脚本对每个
+// pull_request:closed 事件各自独立跑一次 main(),不落地任何跨调用共享状态(不像
+// notify-merge-ack.mjs 那样有去重台账文件)——两次不同 PR 号的独立进程调用之间物理上不
+// 可能互相感知。这里子进程分别喂两个不同 PR 号的 merged 事件(同仓、无 Slack 配置,走
+// slack-not-configured 分支),断言各自输出正确对应的 pr/url,证明"一次合并一条播报"这条
+// 契约在本脚本层面成立(截图里的"挤在一起"是 Slack 客户端对连续消息的展示折叠,不是本
+// 脚本把两条合并揽成一条)。
+describe('SC-7:两次独立 merge 事件互不干扰(各自恰产生一条独立结果,无共享去重/批量状态)', () => {
+  let dir
+
+  beforeEach(() => { dir = mkdtempSync(join(tmpdir(), 'merge-thanks-independence-')) })
+  afterEach(() => { rmSync(dir, { recursive: true, force: true }) })
+
+  const runScript = (env) =>
+    execFileSync(process.execPath, [SCRIPT_PATH], {
+      encoding: 'utf8',
+      env: { PATH: process.env.PATH, ...env },
+    })
+
+  // 同仓 PR 缺 Slack 配置属于真故障(需要 ::error:: 注解,见 formatAnnotation),stdout 里
+  // JSON 结果之后会紧跟这一行——同 line 70-75 的既有裁法,只取前半段 JSON 块。
+  const parseResult = (stdout) => {
+    const idx = stdout.indexOf('\n::error')
+    return JSON.parse(idx === -1 ? stdout : stdout.slice(0, idx))
+  }
+
+  const mergedEvent = (number, htmlUrl) => ({
+    pull_request: {
+      number,
+      merged: true,
+      title: `t${number}`,
+      body: `b${number}`,
+      html_url: htmlUrl,
+      user: { login: 'someone', type: 'User' },
+      head: { repo: { full_name: 'xindong/mivo-canvas' } },
+      base: { repo: { full_name: 'xindong/mivo-canvas' } },
+    },
+  })
+
+  it('两个不同 PR 号的合并事件,各自独立子进程调用,各自输出正确对应的 pr/url,互不混淆', () => {
+    const eventA = join(dir, 'a.json')
+    const eventB = join(dir, 'b.json')
+    writeFileSync(eventA, JSON.stringify(mergedEvent(533, 'https://github.com/xindong/mivo-canvas/pull/533')))
+    writeFileSync(eventB, JSON.stringify(mergedEvent(524, 'https://github.com/xindong/mivo-canvas/pull/524')))
+
+    const resultA = parseResult(runScript({ GITHUB_EVENT_NAME: 'pull_request', GITHUB_EVENT_PATH: eventA }))
+    const resultB = parseResult(runScript({ GITHUB_EVENT_NAME: 'pull_request', GITHUB_EVENT_PATH: eventB }))
+
+    expect(resultA).toMatchObject({ pr: 533, url: 'https://github.com/xindong/mivo-canvas/pull/533' })
+    expect(resultB).toMatchObject({ pr: 524, url: 'https://github.com/xindong/mivo-canvas/pull/524' })
+    // 未配置 Slack 时两者都不会真的 posted,但各自的 reason 都是同仓缺配置(告警),而不是
+    // 因为"上一次调用已经处理过"之类的互相感知导致的异常分支。
+    expect(resultA.posted).toBe(false)
+    expect(resultB.posted).toBe(false)
+    expect(resultA.reason).toBe('slack-not-configured(需 SLACK_BOT_TOKEN + SLACK_CHANNEL_ID)')
+    expect(resultB.reason).toBe(resultA.reason)
+  })
+
+  it('本脚本目录内不存在任何去重/批量台账文件(结构性佐证:没有可以把两条合并"揽成一条"的共享状态)', () => {
+    const src = readFileSync(SCRIPT_PATH, 'utf8')
+    expect(src).not.toMatch(/dedup|DEDUP/i)
+    expect(src).not.toContain('writeFileSync')
+  })
+})
