index 00000000..57402c91
--- /dev/null
+++ b/scripts/changelog/test-publish-gate-isolation.sh
@@ -0,0 +1,121 @@
+#!/usr/bin/env bash
+# 鉴别性回归:证明 test-publish-gate.sh 的 repo-local env 剥离**真的在挡污染**。
+#
+# 为什么需要(2026-08-04 三审 C-03,major):原先给的证据是「干净环境 34/34 + 注入
+# GIT_DIR 环境 34/34」——两侧都绿,零鉴别力:把剥离行整段删掉,两侧照样 34/34,因为
+# 那 34 个用例断言的是 publish 门的业务行为,压根不看「污染有没有发生」。
+#
+# 构造(每轮一对):
+#   (a) 真脚本(带剥离)  → victim 仓必须毫发无伤
+#   (b) mutant(剥离行被删)→ victim 仓必须被污染
+# (b) 是**反证**:若 (b) 也毫发无伤,说明注入没生效或 mutant 构造失效,(a) 的绿就毫无
+# 意义 → 判 FAIL,不许静默通过(加固清单第 8 类:新测试必须反证非空转)。
+#
+# 覆盖范围如实声明——只测**已实测复现**的那条穿透路径:
+#   GIT_CONFIG → fixture 的 `git -C "$sandbox" config user.email/user.name` 写进
+#                GIT_CONFIG 所指文件,而非 sandbox 自己的 config。脚本仍 34/34、
+#                退出码 0,污染完全静默(最阴的形态)。
+# **未覆盖** GIT_DIR:git 语义上 GIT_DIR 确实覆盖 `-C`(单命令实测:
+#   `GIT_DIR=<v>/.git git -C <s> branch -M x` 改的是 v),但在本 fixture 的完整序列里
+#   实测**复现不出** victim 被改动 —— 未定位原因,故不写进本测试假装覆盖。
+#   2026-08-04 那次真实事故观察到的 core.bare=true 同样**未能复现**:带路径参数的
+#   `git init` 与 `git init --bare` 在 GIT_DIR 注入下都不改写被注入仓的 core.bare
+#   (实测)。事故症状为真,成因至今未定位,不在此冒称已归因。
+#
+# ⚠ 本环境陷阱(mutant 构造必须避开):这台机器的 `grep` 被包装,`grep -v P f > out`
+# 的 out 会变成一行摘要文本而非过滤结果,导致 mutant 不是脚本副本(exit 127)。
+# 故用 python 造 mutant,并对产物做三重构造自检。
+
+set -u
+
+# 本脚本自己也可能从 git hook 环境被调起——先剥干净,否则「干净基线」不成立
+_lev=$(git rev-parse --local-env-vars 2>/dev/null) && [ -n "$_lev" ] && unset $_lev
+unset _lev
+
+REPO_ROOT=$(git rev-parse --show-toplevel)
+TARGET="$REPO_ROOT/scripts/changelog/test-publish-gate.sh"
+PASS=0
+FAIL=0
+
+pass() { echo "PASS: $1"; PASS=$((PASS + 1)); }
+fail() { echo "FAIL: $1"; FAIL=$((FAIL + 1)); }
+
+# victim 仓:非 bare、已知 config、1 个 commit
+make_victim() {
+  local dir="$1"
+  git init -q "$dir"
+  git -C "$dir" config core.bare false
+  git -C "$dir" config user.email victim@local
+  git -C "$dir" config user.name victim
+  : > "$dir/seed.txt"
+  git -C "$dir" add seed.txt
+  git -C "$dir" commit -q -m "victim seed"
+}
+
+# mutant = 删掉剥离行的副本。用 python 而非 grep(见文件头的环境陷阱)。
+make_mutant() {
+  local out="$1"
+  python3 - "$TARGET" "$out" <<'PY'
+import sys, pathlib
+src, dst = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
+lines = src.read_text().splitlines(keepends=True)
+kept = [l for l in lines if '_local_env_vars' not in l]
+dst.write_text(''.join(kept))
+print(f"{len(lines)} -> {len(kept)}")
+PY
+  chmod +x "$out"
+
+  # 构造自检三重:① 剥离行确实没了 ② 只少了极少几行(不是被整体替换)③ 仍是合法 shell
+  if python3 -c "import sys;sys.exit(0 if '_local_env_vars' not in open(sys.argv[1]).read() else 1)" "$out"; then :; else
+    fail "mutant 构造失败:剥离行仍在副本里"; return 1
+  fi
+  local src_n dst_n
+  src_n=$(wc -l < "$TARGET"); dst_n=$(wc -l < "$out")
+  if [ "$dst_n" -ge "$src_n" ] || [ "$dst_n" -lt $((src_n - 5)) ]; then
+    fail "mutant 构造失败:行数 $src_n -> $dst_n 不在预期区间(应只少 1~5 行)"; return 1
+  fi
+  if ! bash -n "$out" 2>/dev/null; then
+    fail "mutant 构造失败:副本不是合法 shell 脚本"; return 1
+  fi
+  return 0
+}
+
+# GIT_CONFIG 注入:唯一已复现的静默穿透路径
+probe_git_config() {
+  local label="$1" script="$2" expect="$3"   # expect: clean | polluted
+  local work; work=$(mktemp -d)
+  make_victim "$work/victim" > /dev/null 2>&1
+  ( cd "$REPO_ROOT" && GIT_CONFIG="$work/victim/.git/config" bash "$script" ) > /dev/null 2>&1
+  local rc=$?
+  local email name
+  email=$(git config -f "$work/victim/.git/config" --get user.email 2>/dev/null || echo "<gone>")
+  name=$(git config -f "$work/victim/.git/config" --get user.name 2>/dev/null || echo "<gone>")
+  rm -rf "$work"
+
+  if [ "$expect" = "clean" ]; then
+    if [ "$email" = "victim@local" ] && [ "$name" = "victim" ]; then
+      pass "$label: GIT_CONFIG 注入下 victim config 未被改写(email=$email, rc=$rc)"
+    else
+      fail "$label: GIT_CONFIG 注入下 victim config 被改写(email=$email name=$name)"
+    fi
+  else
+    if [ "$email" != "victim@local" ] || [ "$name" != "victim" ]; then
+      pass "$label【反证】: 删掉剥离行后 victim config 确实被改写(email=$email name=$name)—— 注入有效,上一条的绿有鉴别力"
+    else
+      fail "$label【反证失效】: 删掉剥离行后 victim config 仍未被改写 —— 注入没生效或 mutant 失效,本测试对真脚本的绿无鉴别力"
+    fi
+  fi
+}
+
+echo "=== repo-local env 剥离的鉴别性回归(GIT_CONFIG 路径,带反证)==="
+
+MUTANT=$(mktemp)
+if make_mutant "$MUTANT" > /dev/null; then
+  probe_git_config "真脚本" "$TARGET" clean
+  probe_git_config "mutant" "$MUTANT" polluted
+fi
+rm -f "$MUTANT"
+
+echo "----------------"
+echo "PASS=$PASS FAIL=$FAIL"
+[ "$FAIL" -eq 0 ] || exit 1
