+          onClick={() => toggleInfo('button')}
+        >
+          <span className="media-lightbox-chip-ico" aria-hidden="true">i</span>
+          {t('inspector.lightboxInfo.toggle')}
+        </button>
+        <button
+          type="button"
+          className="media-lightbox-chip"
+          aria-label={t('inspector.closeDetails')}
+          onClick={() => closeWith('close-button')}
+        >
+          ✕
+        </button>
+      </div>
+
+      <aside id={infoPanelId} className="media-lightbox-info" aria-hidden={!infoOpen && !narrow}>
+        {/* 窄容器抽屉的拖拽把手;桌面形态不渲染视觉(CSS 隐藏)。 */}
+        <button
+          type="button"
+          className="media-lightbox-sheet-grip"
+          aria-label={t('inspector.lightboxInfo.toggle')}
+          aria-expanded={infoOpen}
+          onClick={() => toggleInfo('sheet-grip')}
         />
-      ) : (
-        <img className="media-lightbox-media" src={assetState.url} alt={node.title} onError={handleMediaError} />
-      )}
+        {/* 收起时主体 inert:移出 Tab 序与辅助树(仅把手保持可交互,窄态 peek 用)。 */}
+        <div className="media-lightbox-info-body" inert={!infoOpen} aria-hidden={narrow ? !infoOpen : undefined}>
+        <header className="media-lightbox-info-head">
+          <div className="media-lightbox-file-name">{node.assetOriginalName || node.title}</div>
+          <div className="media-lightbox-file-sub">
+            {node.type} · {node.generation ? t('inspector.lightboxInfo.sourceGenerated') : t('inspector.lightboxInfo.sourceImported')}
+          </div>
+        </header>
+        <div className="media-lightbox-info-scroll">
+          <section className="media-lightbox-sec">
+            <h3>{t('inspector.lightboxInfo.basic')}</h3>
+            {basicRows.map((row) => (
+              <div key={row.label} className="media-lightbox-kv">
+                <span className="media-lightbox-kv-key">{row.label}</span>
+                <span className={`media-lightbox-kv-value${row.mono ? ' mono' : ''}`}>{row.value}</span>
+              </div>
+            ))}
+          </section>
+
+          {node.generation ? (
+            <section className="media-lightbox-sec">
+              <h3>{t('inspector.lightboxInfo.aiContext')}</h3>
+              {node.generation.prompt ? (
+                <div className="media-lightbox-prompt">{node.generation.prompt}</div>
+              ) : null}
+              <div className="media-lightbox-kv">
+                <span className="media-lightbox-kv-key">{t('inspector.meta.model')}</span>
+                <span className="media-lightbox-kv-value">{node.generation.model || 'Mivo'}</span>
+              </div>
+              {node.generation.seed !== undefined ? (
+                <div className="media-lightbox-kv">
+                  <span className="media-lightbox-kv-key">{t('inspector.meta.seed')}</span>
+                  <span className="media-lightbox-kv-value mono">{String(node.generation.seed)}</span>
+                </div>
+              ) : null}
+              {node.sourceNodeId ? (
+                <button type="button" className="media-lightbox-derive" onClick={handleLocateSource}>
+                  {t('inspector.lightboxInfo.derivedFrom', {
+                    name: sourceNode?.assetOriginalName || sourceNode?.title || t('inspector.lightboxInfo.sourceGone'),
+                  })}
+                </button>
+              ) : null}
+            </section>
+          ) : null}
+
+          {videoRows.length ? (
+            <section className="media-lightbox-sec">
+              <h3>{t('inspector.lightboxInfo.videoSection')}</h3>
+              {videoRows.map((row) => (
+                <div key={row.label} className="media-lightbox-kv">
+                  <span className="media-lightbox-kv-key">{row.label}</span>
+                  <span className="media-lightbox-kv-value mono">{row.value}</span>
+                </div>
+              ))}
+            </section>
+          ) : null}
+
+          <section className="media-lightbox-sec">
+            <h3>{t('inspector.lightboxInfo.tags')}</h3>
+            <div className="media-lightbox-tags">
+              {(node.tags ?? []).map((tag) => (
+                <span key={tag} className="media-lightbox-tag">
+                  {tag}
+                  <button
+                    type="button"
+                    className="media-lightbox-tag-remove"
+                    aria-label={t('inspector.lightboxInfo.removeTag', { name: tag })}
+                    onClick={() => removeTag(tag)}
+                  >
+                    ✕
+                  </button>
+                </span>
+              ))}
+              {tagDraft !== undefined ? (
+                <input
+                  className="media-lightbox-tag-input"
+                  value={tagDraft}
+                  placeholder={t('inspector.lightboxInfo.tagInputPlaceholder')}
+                  maxLength={NODE_TAG_MAX_LENGTH}
+                  autoFocus
+                  onChange={(event) => setTagDraft(event.target.value)}
+                  onBlur={commitTagDraft}
+                  onKeyDown={(event) => {
+                    // IME 合成态的 Enter/Esc 是输入法在选字/关候选窗,归编辑器
+                    // (ime-safe-input 约定;Esc 不守卫会连带丢整段草稿——R4-A1)。
+                    if (isImeComposing(event)) return
+                    if (event.key === 'Enter') {
+                      event.preventDefault()
+                      commitTagDraft()
+                      // 提交后 input 卸载,焦点会掉到 body(位置感丢失,R4-A3):
+                      // 下一帧还给「添加标签」入口(达限隐藏时退回对话框)。
+                      restoreTagFocus()
+                    }
+                    if (event.key === 'Escape') {
+                      event.stopPropagation()
+                      cancelTagDraft()
+                    }
+                  }}
+                />
+              ) : (node.tags?.length ?? 0) >= NODE_TAGS_MAX_COUNT ? null : (
+                <button type="button" className="media-lightbox-tag-add" onClick={() => setTagDraft('')}>
+                  + {t('inspector.lightboxInfo.addTag')}
+                </button>
+              )}
+            </div>
+          </section>
+
+          <section className="media-lightbox-sec">
+            <h3>{t('inspector.lightboxInfo.note')}</h3>
+            <textarea
+              className="media-lightbox-note"
+              value={noteDraft ?? node.note ?? ''}
+              placeholder={t('inspector.lightboxInfo.notePlaceholder')}
+              maxLength={NODE_NOTE_MAX_LENGTH}
+              onChange={(event) => setNoteDraft(event.target.value)}
+              onBlur={commitNote}
+              onKeyDown={(event) => {
+                // IME 合成态的 Esc 是关候选窗,归编辑器(R4-A1,与标签输入同形)。
+                if (isImeComposing(event)) return
+                // Esc = 放弃草稿并退出编辑;capture 层对输入态让行,这里必须自己收,
+                // 否则焦点在注释框时键盘永远关不掉 lightbox(对抗审 R3-A1)。
+                if (event.key === 'Escape') {
+                  event.stopPropagation()
+                  cancelNoteDraft(event.currentTarget)
+                }
+              }}
+            />
+          </section>
+        </div>
+        <footer className="media-lightbox-info-foot">
+          <button type="button" className="media-lightbox-download" onClick={handleDownload}>
+            {t('inspector.downloadOriginal')}
+          </button>
+        </footer>
+        </div>
+      </aside>
     </div>
   )
 }
