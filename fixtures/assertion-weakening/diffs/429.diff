diff --git a/src/store/nodeMutationSlice.meta.test.ts b/src/store/nodeMutationSlice.meta.test.ts
new file mode 100644
index 00000000..00c935b7
--- /dev/null
+++ b/src/store/nodeMutationSlice.meta.test.ts
@@ -0,0 +1,149 @@
+// @vitest-environment happy-dom
+// setNodeTags / setNodeNote(媒体详情页信息浮层,2026-08-02):归一化语义钉死——
+// tags 走 trim + 去重 + 去空、空数组收敛为 undefined(不落盘);note 走 trim 判空、
+// 空串收敛为 undefined。真 store 测试,不 mock slice;undo 走 patchWithHistory,
+// 与其它节点字段编辑同一撤销通道。
+import { beforeEach, describe, expect, it } from 'vitest'
+import { useCanvasStore } from './canvasStore'
+import { cloneNode } from './nodeFactory'
+import { fromRecord, toRecord } from '../kernel/mapping'
+import { validateFieldIntent } from '../lib/canvasSyncPort'
+import {
+  NODE_NOTE_MAX_LENGTH,
+  NODE_TAG_MAX_LENGTH,
+  NODE_TAGS_MAX_COUNT,
+  classifyFieldPathBySchema,
+  decodeNodeTags,
+  isNodeTagsWire,
+} from '../../shared/persist-contract'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+const node = (seed: Partial<MivoCanvasNode> & { id: string }): MivoCanvasNode =>
+  ({
+    type: 'image',
+    title: seed.id,
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 100,
+    status: 'ready',
+    ...seed,
+  }) as MivoCanvasNode
+
+const nodeById = (id: string) => useCanvasStore.getState().nodes.find((item) => item.id === id)
+
+describe('setNodeTags — trim/去重/去空 + 空数组收敛 undefined', () => {
+  beforeEach(() => {
+    useCanvasStore.setState({ nodes: [node({ id: 'img' }), node({ id: 'other', tags: ['keep'] })] })
+  })
+
+  it('trim + 去重 + 去空:["  参考图 ", "参考图", "", "角色"] → ["参考图", "角色"]', () => {
+    useCanvasStore.getState().setNodeTags('img', ['  参考图 ', '参考图', '', '角色'])
+    expect(nodeById('img')?.tags).toEqual(['参考图', '角色'])
+  })
+
+  it('清空到空数组 → 字段收敛为 undefined(不落盘空数组)', () => {
+    useCanvasStore.getState().setNodeTags('img', ['a'])
+    useCanvasStore.getState().setNodeTags('img', [])
+    expect(nodeById('img')?.tags).toBeUndefined()
+  })
+
+  it('全空白输入同样收敛为 undefined', () => {
+    useCanvasStore.getState().setNodeTags('img', ['   ', ''])
+    expect(nodeById('img')?.tags).toBeUndefined()
+  })
+
+  it('只改目标节点,不碰其它节点的标签', () => {
+    useCanvasStore.getState().setNodeTags('img', ['x'])
+    expect(nodeById('other')?.tags).toEqual(['keep'])
+  })
+})
+
+describe('setNodeTags — undo 走标准历史通道', () => {
+  it('设标签后 undo 恢复原值(patchWithHistory 单撤销单元)', () => {
+    useCanvasStore.setState({ nodes: [node({ id: 'img', tags: ['旧'] })] })
+    useCanvasStore.getState().setNodeTags('img', ['新'])
+    expect(nodeById('img')?.tags).toEqual(['新'])
+    useCanvasStore.getState().undo()
+    expect(nodeById('img')?.tags).toEqual(['旧'])
+  })
+})
+
+describe('tags 跨层契约 — wire 单标量编码 + 克隆隔离 + intent 合法性', () => {
+  it('cloneNode 隔离:改源节点 tags 数组不影响克隆(history/clipboard/persist 共用前提)', () => {
+    const source = node({ id: 'img', tags: ['a'] })
+    const clone = cloneNode(source)
+    source.tags!.push('b')
+    expect(clone.tags).toEqual(['a'])
+  })
+
+  it('mapping 往返:string[] ↔ JSON 单标量无损;note 原样', () => {
+    const source = node({ id: 'img', tags: ['参考图', '角色'], note: '备注' })
+    const record = toRecord(source)
+    expect(record.tags).toBe(JSON.stringify(['参考图', '角色']))
+    const back = fromRecord(record)
+    expect(back.tags).toEqual(['参考图', '角色'])
+    expect(back.note).toBe('备注')
+  })
+
+  it('codec 对抗往返:含分隔符/引号/反斜杠的标签文本无损(JSON 编码不存在碰撞)', () => {
+    const hostile = ['a\u001fb', '引"号', 'back\\slash']
+    const back = fromRecord(toRecord(node({ id: 'img', tags: hostile })))
+    expect(back.tags).toEqual(hostile)
+  })
+
+  it('decode 防御:非法 wire → undefined;空串成员剔除', () => {
+    expect(decodeNodeTags('not-json')).toBeUndefined()
+    expect(decodeNodeTags('{"a":1}')).toBeUndefined()
+    expect(decodeNodeTags(JSON.stringify(['', 'x', 3]))).toEqual(['x'])
+    expect(decodeNodeTags(JSON.stringify(['']))).toBeUndefined()
+  })
+
+  it('wire 严格校验:超上限拒收(条数/单条长度),合法值放行', () => {
+    expect(isNodeTagsWire(JSON.stringify(['x']))).toBe(true)
+    expect(isNodeTagsWire(JSON.stringify(Array.from({ length: NODE_TAGS_MAX_COUNT + 1 }, (_, i) => `t${i}`)))).toBe(false)
+    expect(isNodeTagsWire(JSON.stringify(['x'.repeat(NODE_TAG_MAX_LENGTH + 1)]))).toBe(false)
+    expect(isNodeTagsWire(JSON.stringify([]))).toBe(false)
+  })
+
+  it('store 上限:单条截断到 NODE_TAG_MAX_LENGTH,条数截断到 NODE_TAGS_MAX_COUNT,note 截断到 NODE_NOTE_MAX_LENGTH', () => {
+    useCanvasStore.setState({ nodes: [node({ id: 'img' })] })
+    useCanvasStore.getState().setNodeTags('img', ['x'.repeat(NODE_TAG_MAX_LENGTH + 40)])
+    expect(nodeById('img')?.tags?.[0]?.length).toBe(NODE_TAG_MAX_LENGTH)
+    useCanvasStore.getState().setNodeTags('img', Array.from({ length: NODE_TAGS_MAX_COUNT + 8 }, (_, i) => `t${i}`))
+    expect(nodeById('img')?.tags?.length).toBe(NODE_TAGS_MAX_COUNT)
+    useCanvasStore.getState().setNodeNote('img', 'n'.repeat(NODE_NOTE_MAX_LENGTH + 50))
+    expect(nodeById('img')?.note?.length).toBe(NODE_NOTE_MAX_LENGTH)
+  })
+
+  it('归一化剔除 U+001F 等控制字符:分隔符不可能进标签文本', () => {
+    useCanvasStore.setState({ nodes: [node({ id: 'img' })] })
+    useCanvasStore.getState().setNodeTags('img', ['a\u001fb', 'c'])
+    expect(nodeById('img')?.tags).toEqual(['ab', 'c'])
+  })
+
+  it('FieldIntent:set tags(单标量)与 set note 都是合法叶子操作,不会被同步层丢弃', () => {
+    const classify = (fieldPath: readonly (string | number)[]) => classifyFieldPathBySchema('node', fieldPath)
+    expect(() =>
+      validateFieldIntent({ op: 'set', fieldPath: ['tags'], value: JSON.stringify(['a', 'b']) }, classify),
+    ).not.toThrow()
+    expect(() => validateFieldIntent({ op: 'set', fieldPath: ['note'], value: 'n' }, classify)).not.toThrow()
+    expect(() => validateFieldIntent({ op: 'delete-field', fieldPath: ['tags'] }, classify)).not.toThrow()
+  })
+})
+
+describe('setNodeNote — trim 判空 + 空串收敛 undefined', () => {
+  beforeEach(() => {
+    useCanvasStore.setState({ nodes: [node({ id: 'img', note: '旧注释' })] })
+  })
+
+  it('非空注释原样保存(不 trim 内容本身,只用 trim 判空)', () => {
+    useCanvasStore.getState().setNodeNote('img', '  新注释  ')
+    expect(nodeById('img')?.note).toBe('  新注释  ')
+  })
+
+  it('清空(纯空白)→ 字段收敛为 undefined', () => {
+    useCanvasStore.getState().setNodeNote('img', '   ')
+    expect(nodeById('img')?.note).toBeUndefined()
+  })
+})
