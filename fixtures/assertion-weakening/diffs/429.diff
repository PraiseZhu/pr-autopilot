+// ── 节点标签/注释:wire codec 与上限的单一入口(client mapping 与 server decoder 共用)──
+// wire 形态 = JSON string array(单标量叶子,FieldIntent 可 set;并发语义 = 整组 LWW 替换)。
+// JSON 编码任意标签文本无损往返,无分隔符碰撞;上限在 encode 入口(store 归一化)与
+// decode 校验(isNodeTagsWire)两端同源生效,超限 payload 服务端拒收,不产生本地/服务端分叉。
+export const NODE_TAG_MAX_LENGTH = 64
+export const NODE_TAGS_MAX_COUNT = 32
+export const NODE_NOTE_MAX_LENGTH = 2000
+
+export const encodeNodeTags = (tags: readonly string[] | undefined): string | undefined =>
+  tags && tags.length ? JSON.stringify(tags) : undefined
+
+/** 宽容解码(hydrate/snapshot 用):非法 wire → undefined(字段整体缺失),空串成员剔除。 */
+export const decodeNodeTags = (wire: string | undefined): string[] | undefined => {
+  if (!wire) return undefined
+  try {
+    const parsed: unknown = JSON.parse(wire)
+    if (!Array.isArray(parsed)) return undefined
+    const tags = parsed.filter((item): item is string => typeof item === 'string' && item.length > 0)
+    return tags.length ? tags : undefined
+  } catch {
+    return undefined
+  }
+}
+
+/** 严格校验(payload decoder 用):JSON string array + 非空 + 条数/单条长度上限。 */
+export const isNodeTagsWire = (value: unknown): boolean => {
+  if (typeof value !== 'string') return false
+  try {
+    const parsed: unknown = JSON.parse(value)
+    return (
+      Array.isArray(parsed) &&
+      parsed.length > 0 &&
+      parsed.length <= NODE_TAGS_MAX_COUNT &&
+      parsed.every((item) => typeof item === 'string' && item.length > 0 && item.length <= NODE_TAG_MAX_LENGTH)
+    )
+  } catch {
+    return false
+  }
+}
+
+export const isNodeNoteWire = (value: unknown): boolean =>
+  typeof value === 'string' && value.length > 0 && value.length <= NODE_NOTE_MAX_LENGTH
+
+/** app 层(string[])标签校验:snapshot import 与 wire 校验同源上限——上限"三端同源"
+ *  的第四个入口(store 归一化 / UI maxLength / wire decoder / snapshot import)。 */
+export const isNodeTagsApp = (value: unknown): value is string[] =>
+  Array.isArray(value) &&
+  value.length > 0 &&
+  value.length <= NODE_TAGS_MAX_COUNT &&
+  value.every((item) => typeof item === 'string' && item.length > 0 && item.length <= NODE_TAG_MAX_LENGTH)
+
+export const isNodeNoteApp = (value: unknown): value is string =>
+  typeof value === 'string' && value.length > 0 && value.length <= NODE_NOTE_MAX_LENGTH
+
