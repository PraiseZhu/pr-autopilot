 import { persistRequest, type PersistReply } from '../persist/bridge'
 import { refingerprintDepositEntry, resolveDepositEntry } from './depositPort'
 import { recordArtifactDeposit } from './depositOwned'
 
 const SOURCE = 'Cindy Plugin Generation'
 
+/**
+ * 电子脑生图回执的结局码 → 用户提示(2026-08-05,配合 main.js 的 GEN_CODE 闭集)。
+ *
+ * 为什么按**码**选文案而不是读回执里的 message:message 那一侧曾经透传过宿主/上游
+ * 原文,正是"Key 失效却悄悄改走 Cindy 配额、用户毫无感知"事故的一部分。码是闭集、
+ * 文案在四语 catalog 里写死,谁也夹带不了私货。**判定通道也绝不看 modelLabel**——
+ * 模型名是展示字段,拿它推断走了哪条通道等于把契约建在文案上。
+ *
+ * 特别注意 fallbackQuota 是**成功**回执上的码:没配 Key、代办出图成功。它必须有
+ * info 提示——事故的要害正是"回落成功却一声不吭",用户以为花的是自己的 Mivo 额度。
+ */
+const GEN_OUTCOME_TOAST: Record<string, { level: 'info' | 'error'; key: string }> = {
+  MIVO_FALLBACK_QUOTA: { level: 'info', key: 'toast.mivoGen.fallbackQuota' },
+  MIVO_CONFIG_UNKNOWN: { level: 'error', key: 'toast.mivoGen.configUnknown' },
+  MIVO_AUTH_INVALID: { level: 'error', key: 'toast.mivoGen.authInvalid' },
+  MIVO_AUTH_FORBIDDEN: { level: 'error', key: 'toast.mivoGen.authForbidden' },
+  MIVO_UPSTREAM_BUSY: { level: 'error', key: 'toast.mivoGen.upstreamBusy' },
+  MIVO_UPSTREAM_ERROR: { level: 'error', key: 'toast.mivoGen.upstreamError' },
+  MIVO_TRANSPORT_UNKNOWN: { level: 'error', key: 'toast.mivoGen.transportUnknown' },
+  MIVO_INTERNAL: { level: 'error', key: 'toast.mivoGen.internal' },
+  CINDY_FALLBACK_FAILED: { level: 'error', key: 'toast.mivoGen.cindyFallbackFailed' },
+}
+
+/**
+ * 按回执结局码给用户反馈(toast + Debug Log)。
+ *
+ * `seen` 是**每任务/每 batch 一个**的去重集,由各 submit*Task 闭包自建自传——
+ * 刻意不做模块级全局集:全局集会让"同一个码全进程只提示一次",第二次生图照样
+ * 回落时用户又什么都看不到,事故原样重演(收口审反例)。变体 batch 内多单同码
+ * 失败共享一个集 = 一个 batch 至多一条;两个先后任务各自的集独立 = 各提示一次。
+ */
+const notifyGenOutcome = (seen: Set<string>, reply: { ok?: boolean; code?: unknown }): void => {
+  const code = typeof reply.code === 'string' && reply.code ? reply.code : ''
+  if (!code) {
+    // 成功且无码 = Mivo 直连正常出图,无需打扰;失败却无码 = 契约破损,要留痕。
+    if (!reply.ok) debugLogger.warn(SOURCE, '失败回执缺结局码(契约破损),按内部错误提示')
+    if (!reply.ok && !seen.has('MIVO_INTERNAL')) {
+      seen.add('MIVO_INTERNAL')
+      toastFeedback.error(t('toast.mivoGen.internal'))
+    }
+    return
+  }
+  if (seen.has(code)) return
+  seen.add(code)
+  const spec = GEN_OUTCOME_TOAST[code]
+  if (!spec) {
+    // 闭集外的码不该存在;不静默吞(fail visibly),记警告并给通用错误提示。
+    debugLogger.warn(SOURCE, `未知结局码 code=${code},按内部错误提示`)
+    toastFeedback.error(t('toast.mivoGen.internal'))
+    return
+  }
+  if (spec.level === 'info') {
+    debugLogger.log(SOURCE, `生图走 Cindy 代办成功(未配 Mivo Key) code=${code}`)
+    toastFeedback.info(t(spec.key))
+  } else {
+    debugLogger.error(SOURCE, `生图失败 code=${code}`)
+    toastFeedback.error(t(spec.key))
+  }
+}
