+/**
+ * consumer 显码链路测试(SC v6 §3 A4.2/A4.3/A4.4/A4.7)。
+ *
+ * 断言穿过**真实** cindyGenerationPort + 真实 toastStore + 真实 i18n:回执上的结局码
+ * 必须变成用户看得见的 toast(级别、文案都对),且去重作用域是「每任务/每 batch」——
+ * 不是进程全局(全局集会让第二次回落静默,事故重演;收口审反例)。
+ * persistRequest 与 deposit 层 mock 掉:这里测的是消费链,不是传输层。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const persistRequestMock = vi.hoisted(() => vi.fn())
+vi.mock('../persist/bridge', () => ({
+  persistRequest: persistRequestMock,
+}))
+vi.mock('../agent/depositPort', () => ({
+  resolveDepositEntry: vi.fn(async () => ({ hash: 'a'.repeat(64), ext: '.png' })),
+  refingerprintDepositEntry: vi.fn(async () => ({ hash: 'a'.repeat(64), ext: '.png' })),
+}))
+vi.mock('../agent/depositOwned', () => ({
+  recordArtifactDeposit: vi.fn(async () => ({ ledgerWritten: true })),
+}))
+vi.mock('../../../src/store/canvasStore', () => ({
+  useCanvasStore: { getState: () => ({ nodes: [] }) },
+}))
+
+import { cindyImageGenerationPort } from '../agent/cindyGenerationPort'
+import { useToastStore } from '../../../src/store/toastStore'
+import { t } from '../../../src/i18n'
+
+const HASH = '0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
+
+const toasts = () => useToastStore.getState().entries
+
+const pollUntilTerminal = async (taskId: string) => {
+  for (let i = 0; i < 400; i += 1) {
+    const view = await cindyImageGenerationPort.pollTask(taskId) // 每轮现拉,不能闭包捕获快照
+    if (view.status !== 'running') return view
+    await new Promise((resolve) => setTimeout(resolve, 5))
+  }
+  throw new Error(`任务 ${taskId} 未在预算内到达终态`)
+}
+
+// 成功路径需要 /media 取回与 FileReader;node 环境补最小 shim。
+const installMediaShims = () => {
+  vi.stubGlobal('fetch', vi.fn(async () => ({ ok: true, blob: async () => new Blob(['x']) })))
+  class FakeReader {
+    result: string | null = null
+    onload: (() => void) | null = null
+    onerror: (() => void) | null = null
+    readAsDataURL() {
+      this.result = 'data:image/png;base64,eHg='
+      queueMicrotask(() => this.onload?.())
+    }
+  }
+  vi.stubGlobal('FileReader', FakeReader)
+  vi.stubGlobal('window', { setInterval, clearInterval } as unknown as Window)
+}
+
+beforeEach(() => {
+  persistRequestMock.mockReset()
+  useToastStore.getState().clearToasts()
+  installMediaShims()
+})
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+const FAIL_CODES: Array<[string, string]> = [
+  ['MIVO_CONFIG_UNKNOWN', 'toast.mivoGen.configUnknown'],
+  ['MIVO_AUTH_INVALID', 'toast.mivoGen.authInvalid'],
+  ['MIVO_AUTH_FORBIDDEN', 'toast.mivoGen.authForbidden'],
+  ['MIVO_UPSTREAM_BUSY', 'toast.mivoGen.upstreamBusy'],
+  ['MIVO_UPSTREAM_ERROR', 'toast.mivoGen.upstreamError'],
+  ['MIVO_TRANSPORT_UNKNOWN', 'toast.mivoGen.transportUnknown'],
+  ['MIVO_INTERNAL', 'toast.mivoGen.internal'],
+  ['CINDY_FALLBACK_FAILED', 'toast.mivoGen.cindyFallbackFailed'],
+]
+
+describe('SC-A4.2 失败码 → error toast(真实 store、真实 i18n 文案)× gen/edit', () => {
+  for (const [code, key] of FAIL_CODES) {
+    it(`gen · ${code}`, async () => {
+      persistRequestMock.mockResolvedValue({ ok: false, code, message: '出了点问题' })
+      const taskId = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p', idempotencyKey: 'ik' } as never)
+      const view = await pollUntilTerminal(taskId)
+      expect(view.status).toBe('failed')
+      expect(toasts()).toHaveLength(1)
+      expect(toasts()[0].level).toBe('error')
+      expect(toasts()[0].message).toBe(t(key))
+    })
+  }
+  // edit 同样逐码全覆盖(SC-A4.2 明定 9 码 × {gen,edit},不抽样)
+  for (const [code, key] of FAIL_CODES) {
+    it(`edit · ${code}`, async () => {
+      persistRequestMock.mockResolvedValue({ ok: false, code, message: '出了点问题' })
+      const taskId = await cindyImageGenerationPort.submitEditTask({ prompt: 'p', sourceAssetUrl: 'asset://x', image: new Blob(['s']), idempotencyKey: 'ik-e' } as never)
+      const view = await pollUntilTerminal(taskId)
+      expect(view.status).toBe('failed')
+      expect(toasts()).toHaveLength(1)
+      expect(toasts()[0].level).toBe('error') // 与 gen 同格:级别也逐格锁死
+      expect(toasts()[0].message).toBe(t(key))
+    })
+  }
+})
+
+describe('SC-A4.3 关键闸门:回落成功必须有 info 提示(每任务恰一次)', () => {
+  it('gen · ok + MIVO_FALLBACK_QUOTA → TaskView done + info toast === 1', async () => {
+    persistRequestMock.mockResolvedValue({ ok: true, code: 'MIVO_FALLBACK_QUOTA', hash: HASH, ext: '.png' })
+    const taskId = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p', idempotencyKey: 'ik' } as never)
+    const view = await pollUntilTerminal(taskId)
+    expect(view.status).toBe('done')
+    expect(toasts()).toHaveLength(1)
+    expect(toasts()[0].level).toBe('info')
+    expect(toasts()[0].message).toBe(t('toast.mivoGen.fallbackQuota'))
+  })
+
+  it('直连成功(无码)→ 零 toast(不打扰)', async () => {
+    persistRequestMock.mockResolvedValue({ ok: true, hash: HASH, ext: '.png', modelLabel: 'Nano Banana Pro' })
+    const taskId = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p', idempotencyKey: 'ik' } as never)
+    const view = await pollUntilTerminal(taskId)
+    expect(view.status).toBe('done')
+    expect(toasts()).toHaveLength(0)
+  })
+})
+
+describe('SC-A4.3 关键闸门(edit 侧)+ 跨层单次提交(收口审阻断 1 的回归锁)', () => {
+  it('edit · ok + MIVO_FALLBACK_QUOTA → done + info toast === 1 + 额度语义文案', async () => {
+    persistRequestMock.mockResolvedValue({ ok: true, code: 'MIVO_FALLBACK_QUOTA', hash: HASH, ext: '.png' })
+    const taskId = await cindyImageGenerationPort.submitEditTask({ prompt: 'p', sourceAssetUrl: 'asset://x', image: new Blob(['s']), idempotencyKey: 'ik-eg' } as never)
+    const view = await pollUntilTerminal(taskId)
+    expect(view.status).toBe('done')
+    expect(toasts()).toHaveLength(1)
+    expect(toasts()[0].level).toBe('info')
+    expect(toasts()[0].message).toBe(t('toast.mivoGen.fallbackQuota')) // 解析后文案
+    expect(toasts()[0].message).toMatch(/quota|Key/i) // 额度语义:说清花的是共享额度、配 Key 可用自己的
+  })
+
+  it('edit · 首次 TRANSPORT_UNKNOWN → persist 恰好 1 次(消费层零自动重发,防双扣费)', async () => {
+    // 事故语义:平台可能已收单、只是回执丢了——消费层若自动换指纹重发,就是第二单。
+    persistRequestMock.mockResolvedValue({ ok: false, code: 'MIVO_TRANSPORT_UNKNOWN', message: 'x' })
+    const taskId = await cindyImageGenerationPort.submitEditTask({ prompt: 'p', sourceAssetUrl: 'asset://x', image: new Blob(['s']), idempotencyKey: 'ik-e1' } as never)
+    const view = await pollUntilTerminal(taskId)
+    expect(view.status).toBe('failed')
+    expect(persistRequestMock).toHaveBeenCalledTimes(1)
+  })
+
+  it('variations · 3 单全部 TRANSPORT_UNKNOWN → persist 恰好 3 次(每变体 1 次,零重发)', async () => {
+    persistRequestMock.mockResolvedValue({ ok: false, code: 'MIVO_TRANSPORT_UNKNOWN', message: 'x' })
+    const { taskId } = await cindyImageGenerationPort.submitVariationsTask({
+      sourceAssetUrl: 'asset://x',
+      image: new Blob(['s']),
+      idempotencyKey: 'ik-v1',
+      variations: [{ prompt: 'v1' }, { prompt: 'v2' }, { prompt: 'v3' }],
+    } as never)
+    const view = await pollUntilTerminal(taskId)
+    expect(view.status).toBe('failed')
+    expect(persistRequestMock).toHaveBeenCalledTimes(3)
+  })
+})
+
+describe('SC-A4.4 动作指引:只有 401/403 指向设置页', () => {
+  // 默认 locale = en(node 无 navigator):settings 措辞只允许出现在 auth 两码。
+  it('文案分界(en catalog)', () => {
+    const pointing = ['toast.mivoGen.authInvalid', 'toast.mivoGen.authForbidden']
+    const notPointing = [
+      'toast.mivoGen.fallbackQuota',
+      'toast.mivoGen.configUnknown',
+      'toast.mivoGen.upstreamBusy',
+      'toast.mivoGen.upstreamError',
+      'toast.mivoGen.transportUnknown',
+      'toast.mivoGen.internal',
+      'toast.mivoGen.cindyFallbackFailed',
+    ]
+    for (const key of pointing) expect(t(key)).toMatch(/settings/i)
+    for (const key of notPointing) expect(t(key)).not.toMatch(/settings/i)
+    // busy/transport 不得暗示 key 坏了
+    expect(t('toast.mivoGen.upstreamBusy')).not.toMatch(/key/i)
+    expect(t('toast.mivoGen.transportUnknown')).not.toMatch(/key/i)
+  })
+})
+
+describe('SC-A4.7 去重作用域 = 每任务/每 batch,不是进程全局', () => {
+  it('两个先后任务、同一个码 → toast 累计 2(进程级 Set 的错误实现在此变红)', async () => {
+    persistRequestMock.mockResolvedValue({ ok: false, code: 'MIVO_TRANSPORT_UNKNOWN', message: 'x' })
+    const first = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p1', idempotencyKey: 'ik1' } as never)
+    await pollUntilTerminal(first)
+    const second = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p2', idempotencyKey: 'ik2' } as never)
+    await pollUntilTerminal(second)
+    expect(toasts()).toHaveLength(2)
+  })
+
+  it('两个先后任务的回落成功 info 同样各提示一次(A4.3 闸门的跨任务延伸)', async () => {
+    persistRequestMock.mockResolvedValue({ ok: true, code: 'MIVO_FALLBACK_QUOTA', hash: HASH, ext: '.png' })
+    const first = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p1', idempotencyKey: 'ik1' } as never)
+    await pollUntilTerminal(first)
+    const second = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p2', idempotencyKey: 'ik2' } as never)
+    await pollUntilTerminal(second)
+    expect(toasts()).toHaveLength(2)
+    expect(toasts().every((entry) => entry.level === 'info')).toBe(true)
+  })
+
+  it('variations 一个 batch 内 3 单同码失败 → toast === 1', async () => {
+    persistRequestMock.mockResolvedValue({ ok: false, code: 'MIVO_UPSTREAM_BUSY', message: 'x' })
+    const { taskId } = await cindyImageGenerationPort.submitVariationsTask({
+      sourceAssetUrl: 'asset://x',
+      image: new Blob(['s']),
+      idempotencyKey: 'ik-v',
+      variations: [{ prompt: 'v1' }, { prompt: 'v2' }, { prompt: 'v3' }],
+    } as never)
+    const view = await pollUntilTerminal(taskId)
+    expect(view.status).toBe('failed')
+    expect(toasts()).toHaveLength(1)
+    expect(toasts()[0].message).toBe(t('toast.mivoGen.upstreamBusy'))
+  })
+})
+
+describe('SC-A4.5(运行时侧):toast 决策只看 code,不看 modelLabel', () => {
+  it('同一失败码在不同 modelLabel 下给同一条 toast', async () => {
+    persistRequestMock.mockResolvedValue({ ok: false, code: 'MIVO_UPSTREAM_BUSY', message: 'x', modelLabel: 'GPT Image 2.0' })
+    const a = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p1', idempotencyKey: 'ik1' } as never)
+    await pollUntilTerminal(a)
+    const firstMessage = toasts()[0].message
+    useToastStore.getState().clearToasts()
+    persistRequestMock.mockResolvedValue({ ok: false, code: 'MIVO_UPSTREAM_BUSY', message: 'x', modelLabel: 'Nano Banana Pro' })
+    const b = await cindyImageGenerationPort.submitGenerationTask({ prompt: 'p2', idempotencyKey: 'ik2' } as never)
+    await pollUntilTerminal(b)
+    expect(toasts()[0].message).toBe(firstMessage)
+  })
+})
