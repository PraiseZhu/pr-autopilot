+/**
+ * deposit 失败矩阵——用户可见四语文案映射表(T1d,设计稿 §4.9,SC1b.3 末条)。
+ *
+ * 现状(depositPort.ts:53-90 `DepositFailureCode`/`FAILURE_MESSAGE`)是纯中文硬
+ * 编码 `Record`,depositPort.ts:73-79 的注释已经写明"这些文案一条都到不了用户
+ * 眼前;切流段翻开关前必须先定四语落地机制"——本文件就是那套机制,复用面板侧
+ * 既有的 i18next catalog(`src/i18n`,四语 zh-CN/en/ja/ko,`fallbackLng: 'en'`
+ * 已经是未知 locale 的英文兜底,不需要另写一套 locale 归一化)。
+ *
+ * 【T1d-wire 接线指引】本模块目前**未被任何生产代码调用**——depositPort.ts 的
+ * `FAILURE_MESSAGE`/`DepositError` 构造仍在用它自己的硬编码中文串。接线时把
+ * `depositBlob`(depositPort.ts:182-228)里 `FAILURE_MESSAGE[code]` 的引用换成
+ * `describeDepositFailure(code, { usedBytes: reply.quotaUsedBytes, limitBytes: reply.quotaLimitBytes })`,
+ * `TOO_LARGE`/`HOST_UNSUPPORTED` 两处硬编码调用(depositPort.ts:186,190)同样
+ * 改调本函数(不传 `usedBytes`/`limitBytes` 即可,非 `QUOTA_FULL` 分支不消费它们)。
+ */
+import type { DepositFailureCode } from './depositPort'
+import { formatBytes } from '../../../src/app/assetLibraryModel'
+import { t } from '../../../src/i18n'
+
+/** `DepositFailureCode` → i18next key(均落在 `toast.deposit.*`,见四语 `toast.json`)。 */
+const DEPOSIT_FAILURE_I18N_KEY: Record<DepositFailureCode, string> = {
+  TOO_LARGE: 'toast.deposit.tooLarge',
+  UNSUPPORTED_MIME: 'toast.deposit.unsupportedMime',
+  QUOTA_FULL: 'toast.deposit.quotaFull',
+  RATE_LIMITED: 'toast.deposit.rateLimited',
+  HOST_UNSUPPORTED: 'toast.deposit.hostUnsupported',
+  BRAIN_TIMEOUT: 'toast.deposit.brainTimeout',
+  BAD_RECEIPT: 'toast.deposit.badReceipt',
+  DEPOSIT_FAILED: 'toast.deposit.failed',
+}
+
+export type DepositFailureCopyParams = {
+  /** 仅 `QUOTA_FULL` 用得到:结构化配额两数,插值成"用了 X / 共 Y"(设计稿 §4.7)。 */
+  usedBytes?: number
+  limitBytes?: number
+}
+
+/**
+ * 把失败码转成当前语言的用户可见文案。当前语言取 i18next 的活动语言
+ * (面板启动时由宿主 locale 桥 `changeLanguage` 设置,见 `cindyplugin/src/i18n/hostLocale.ts`);
+ * 未知/不支持的语言由 `src/i18n` 的 `fallbackLng: 'en'` 兜底,本函数不用重复判断。
+ *
+ * `usedBytes`/`limitBytes` 缺失(非 finite number)时 `QUOTA_FULL` 文案退化为不带
+ * 具体数字的版本(catalog 里对应词条本身不含 `{{used}}`/`{{limit}}` 占位符时,
+ * 插值参数被 i18next 忽略,不会报错、也不会残留字面量占位符)。
+ */
+export const describeDepositFailure = (code: DepositFailureCode, params: DepositFailureCopyParams = {}): string => {
+  const key = DEPOSIT_FAILURE_I18N_KEY[code]
+  if (code !== 'QUOTA_FULL') return t(key)
+  const { usedBytes, limitBytes } = params
+  const hasUsage = typeof usedBytes === 'number' && Number.isFinite(usedBytes) && typeof limitBytes === 'number' && Number.isFinite(limitBytes)
+  if (!hasUsage) return t('toast.deposit.quotaFullUnknownUsage')
+  return t(key, { used: formatBytes(usedBytes as number), limit: formatBytes(limitBytes as number) })
+}
