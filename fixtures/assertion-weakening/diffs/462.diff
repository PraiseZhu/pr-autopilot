new file mode 100644
index 00000000..8149a03c
--- /dev/null
+++ b/src/__tests__/depositFailureClassifiers.test.ts
@@ -0,0 +1,111 @@
+/**
+ * T1d 纯判定逻辑契约(SC1b.3 quota 两支 / kind 分桶负缓存)。
+ *
+ * 本文件只 import `depositFailureClassifiers.ts`(新文件,T1d 交付)——不 import
+ * 也不修改 `depositPort.ts`/`depositStore.ts` 任何一行(并行文件所有权边界)。
+ */
+import { describe, expect, it } from 'vitest'
+import {
+  isKindCapabilityBlocked,
+  isQuotaExceededConsideringThisRequest,
+  nextKindCapabilityMark,
+  type DepositKindCapabilityMark,
+} from '../agent/depositFailureClassifiers'
+import { DEPOSIT_CAPABILITY_TTL_MS } from '../agent/depositPort'
+
+describe('isQuotaExceededConsideringThisRequest — SC1b.3 quota 两支', () => {
+  it('支1:已经满了(used >= limit)→ true,不需要 decodedBytes', () => {
+    expect(isQuotaExceededConsideringThisRequest(100, 100)).toBe(true)
+    expect(isQuotaExceededConsideringThisRequest(150, 100)).toBe(true)
+  })
+
+  it('支2:未满但加上这次解码字节会顶穿 → true', () => {
+    expect(isQuotaExceededConsideringThisRequest(50, 100, 60)).toBe(true) // 50+60=110>100
+  })
+
+  it('未满且加上这次也不会顶穿 → false', () => {
+    expect(isQuotaExceededConsideringThisRequest(50, 100, 40)).toBe(false) // 50+40=90<=100
+  })
+
+  it('边界:恰好等于上限(不严格大于)→ false(与"冻结值整→发出"同一口径,不误杀)', () => {
+    expect(isQuotaExceededConsideringThisRequest(50, 100, 50)).toBe(false) // 50+50=100,不 > 100
+  })
+
+  it('缺 decodedBytes 且未满 → 只判支1,不误判 false 为 true', () => {
+    expect(isQuotaExceededConsideringThisRequest(50, 100)).toBe(false)
+    expect(isQuotaExceededConsideringThisRequest(50, 100, undefined)).toBe(false)
+  })
+
+  it('结构化两数缺失或非 finite → 不判定(false),交给上层 message 兜底', () => {
+    expect(isQuotaExceededConsideringThisRequest(undefined, 100, 60)).toBe(false)
+    expect(isQuotaExceededConsideringThisRequest(50, undefined, 60)).toBe(false)
+    expect(isQuotaExceededConsideringThisRequest(Number.NaN, 100, 60)).toBe(false)
+    expect(isQuotaExceededConsideringThisRequest(50, Number.POSITIVE_INFINITY, 60)).toBe(false)
+  })
+})
+
+describe('isKindCapabilityBlocked — SC1b.3 kind 分桶负缓存', () => {
+  const NOW = 1_700_000_000_000
+  const VERSION = '0.9.4'
+
+  const blockedMark: DepositKindCapabilityMark = { supported: false, at: NOW, pluginVersion: VERSION }
+
+  it('无标记 → 不阻塞', () => {
+    expect(isKindCapabilityBlocked(undefined, NOW, VERSION)).toBe(false)
+  })
+
+  it('标记为支持 → 永不阻塞(即使 at 很旧)', () => {
+    const supportedMark: DepositKindCapabilityMark = { supported: true, at: NOW - 10, pluginVersion: VERSION }
+    expect(isKindCapabilityBlocked(supportedMark, NOW, VERSION)).toBe(false)
+  })
+
+  it('不支持 + 同版本 + 仍在 TTL 内 → 阻塞', () => {
+    expect(isKindCapabilityBlocked(blockedMark, NOW + DEPOSIT_CAPABILITY_TTL_MS - 1, VERSION)).toBe(true)
+  })
+
+  it('不支持 + 同版本 + TTL 已过 → 不阻塞(到期重探)', () => {
+    expect(isKindCapabilityBlocked(blockedMark, NOW + DEPOSIT_CAPABILITY_TTL_MS + 1, VERSION)).toBe(false)
+  })
+
+  it('不支持但插件版本已变化 → 不阻塞(即使仍在 TTL 内;版本变化视为该 kind 缓存已清)', () => {
+    expect(isKindCapabilityBlocked(blockedMark, NOW + 1, '0.9.5')).toBe(false)
+  })
+
+  it('禁止全局锁死:一个 kind 的标记不影响调用方对另一个 kind 的判定(按 kind 传入各自的 mark,天然隔离)', () => {
+    const imageMark: DepositKindCapabilityMark | undefined = undefined // image 从未写过负缓存
+    const videoMark: DepositKindCapabilityMark = { supported: false, at: NOW, pluginVersion: VERSION } // video 刚被判不支持
+    expect(isKindCapabilityBlocked(videoMark, NOW + 1, VERSION)).toBe(true)
+    expect(isKindCapabilityBlocked(imageMark, NOW + 1, VERSION)).toBe(false)
+  })
+})
+
+describe('nextKindCapabilityMark — 无变化不写盘纪律', () => {
+  const NOW = 1_700_000_000_000
+  const VERSION = '0.9.4'
+
+  it('从无到有 → 返回新标记', () => {
+    expect(nextKindCapabilityMark(undefined, false, NOW, VERSION, 'unknown kind')).toEqual({
+      supported: false,
+      at: NOW,
+      pluginVersion: VERSION,
+      reason: 'unknown kind',
+    })
+  })
+
+  it('supported 与 pluginVersion 均未变 → 返回 null(跳过一次持久化提交)', () => {
+    const previous: DepositKindCapabilityMark = { supported: false, at: NOW - 1000, pluginVersion: VERSION }
+    expect(nextKindCapabilityMark(previous, false, NOW, VERSION)).toBeNull()
+  })
+
+  it('supported 未变但插件版本变了 → 仍返回新标记(版本变化本身触发重新盖戳)', () => {
+    const previous: DepositKindCapabilityMark = { supported: false, at: NOW - 1000, pluginVersion: VERSION }
+    const next = nextKindCapabilityMark(previous, false, NOW, '0.9.5')
+    expect(next).toEqual({ supported: false, at: NOW, pluginVersion: '0.9.5', reason: undefined })
+  })
+
+  it('supported 值变了(如宿主升级后恢复支持)→ 返回新标记', () => {
+    const previous: DepositKindCapabilityMark = { supported: false, at: NOW - 1000, pluginVersion: VERSION }
+    const next = nextKindCapabilityMark(previous, true, NOW, VERSION)
+    expect(next).toEqual({ supported: true, at: NOW, pluginVersion: VERSION, reason: undefined })
+  })
+})
diff --git a/src/__tests__/depositFailureCopy.test.ts b/src/__tests__/depositFailureCopy.test.ts
