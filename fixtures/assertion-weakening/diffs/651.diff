@@ -0,0 +1,500 @@
+// scripts/e2e/scenarios/p1b-batch-column.mjs
+// P1b — 批次占位列真实渲染验收(SC p1b-e2e-fullchain-column)。
+// 覆盖两条链路:
+//   A) 批次入口(startDerivedImageBatch expectedCount=3):网络提交前 3 个预建占位
+//      逐项渲染可见、同列左缘 x 相等、高度=源图;乱序完成(ordinal 1 先回)后节点位置不变。
+//   B) chat 旁生成(expectedCount=1):占位与源图边缘对齐,完成后原位替换高度锁定。
+// 页面内测试桥(route mock 任务 API)+ store 直读断言 bounds。
+
+import { waitForNodeRendered } from '../renderer-evidence.mjs'
+
+const resolveCanvasStoreSpec = async (page) => {
+  return page.evaluate(() => {
+    const resource = performance
+      .getEntriesByType('resource')
+      .map((entry) => entry.name)
+      .find((name) => name.includes('/src/store/canvasStore.ts'))
+    return resource ? new URL(resource).pathname + new URL(resource).search : '/src/store/canvasStore.ts'
+  })
+}
+
+/** 把批次中心平移到视口中心(space+drag,与 archive-assets 既有 pan 手法同式)。
+ *  预建列按 SC11 垂直居中于源图,3×源高 + gap 超过视口高度时首/尾 slot 落在
+ *  视口外;virtualize/lod 默认 on 时视口外节点不材料化(无 DOM 壳)——「占位
+ *  渲染可见」的证据必须先让用户看得见它们。内容跟随光标:
+ *  viewportFromPan 下 viewport.{x,y} += 鼠标位移,故拖 dx/dy 后批次中心进视口中心。 */
+const panBatchIntoView = async (page, slots) => {
+  const shell = page.locator('.canvas-shell')
+  const shellBox = await shell.boundingBox()
+  if (!shellBox) throw new Error('panBatchIntoView: canvas-shell 无 boundingBox')
+  const vp = await page.evaluate(() => {
+    const shell = document.querySelector('.canvas-shell')
+    return {
+      x: Number(shell?.getAttribute('data-viewport-x') || 0),
+      y: Number(shell?.getAttribute('data-viewport-y') || 0),
+      scale: Number(shell?.getAttribute('data-viewport-scale') || 1),
+    }
+  })
+  const centerX = slots.reduce((sum, slot) => sum + slot.x, 0) / slots.length
+  const centerY = slots.reduce((sum, slot) => sum + slot.y, 0) / slots.length
+  const dx = shellBox.x + shellBox.width / 2 - (vp.x + centerX * vp.scale)
+  const dy = shellBox.y + shellBox.height / 2 - (vp.y + centerY * vp.scale)
+  const startX = shellBox.x + shellBox.width / 2
+  const startY = shellBox.y + shellBox.height / 2
+  await page.keyboard.down('Space')
+  await page.mouse.move(startX, startY)
+  await page.mouse.down()
+  await page.mouse.move(startX + dx, startY + dy, { steps: 12 })
+  await page.mouse.up()
+  await page.keyboard.up('Space')
+}
+
+export const runP1bBatchColumnScenario = async (context) => {
+  const { page, generatedImageB64, rendererMode } = context
+  const spec = await resolveCanvasStoreSpec(page)
+
+  // G7(修复轮2)重做:乱序段不再「await 整个 generateVariations 才断中态」——
+  // 生产轮询(generationTaskHelpers runTaskPollLoop)只在终态提交结果,单任务
+  // 的中态在干净树上不可达,旧断言是假象。改为**两个独立任务共享 batchId**
+  // (ordinal 0/1/2 各自经 generateIntoAiSlot 分任务路径提交,各自在自身终态
+  // 提交)——mock 让 ordinal 1 先终态完成、ordinal 0 暂缓、ordinal 2 失败,
+  // 此时可观测真实中态:ordinal 1 已替换、ordinal 0 仍占位、列位置不变。
+  // chat 旁生成走 submitEditTask(POST /tasks/edit)→ 202(BFF 无 key 会 500,必须拦)。
+  let releaseOrdinal0 = false
+  const handler = async (route) => {
+    const req = route.request()
+    const method = req.method()
+    const url = req.url()
+    if (method === 'POST' && url.includes('/api/mivo/tasks/edit')) {
+      await route.fulfill({
+        status: 202,
+        contentType: 'application/json',
+        body: JSON.stringify({ taskId: 'task-beside' }),
+      })
+      return
+    }
+    if (method === 'GET' && url.includes('/task-beside')) {
+      await route.fulfill({
+        status: 200,
+        contentType: 'application/json',
+        body: JSON.stringify({
+          id: 'task-beside',
+          kind: 'edit',
+          status: 'done',
+          progress: 100,
+          stage: 'done',
+          requestId: 'r-beside',
+          model: 'gpt-image-2',
+          result: { images: [{ b64: generatedImageB64, variationIndex: 0 }] },
+        }),
+      })
+      return
+    }
+    // 独立任务分任务路径:POST /tasks/generate 按 prompt 路由到 ordinal 专属 taskId,
+    // 每个 ordinal 的轮询互不干扰(G7:两个独立任务共享 batchId 的真实中态)。
+    if (method === 'POST' && url.includes('/api/mivo/tasks/generate')) {
+      const body = req.postDataJSON?.() ?? {}
+      const prompt = String(body.prompt ?? '')
+      const taskId = prompt.includes('ordinal-1')
+        ? 'task-g7-1'
+        : prompt.includes('ordinal-2')
+          ? 'task-g7-2'
+          : 'task-g7-0'
+      await route.fulfill({
+        status: 202,
+        contentType: 'application/json',
+        body: JSON.stringify({ taskId }),
+      })
+      return
+    }
+    if (method === 'GET' && url.includes('/task-g7-1')) {
+      // ordinal 1 先终态完成(首 poll 即 done)。
+      await route.fulfill({
+        status: 200,
+        contentType: 'application/json',
+        body: JSON.stringify({
+          id: 'task-g7-1',
+          kind: 'generate',
+          status: 'done',
+          progress: 100,
+          stage: 'done',
+          requestId: 'r-g7-1',
+          model: 'gpt-image-2',
+          result: { images: [{ b64: generatedImageB64, variationIndex: 0 }] },
+        }),
+      })
+      return
+    }
+    if (method === 'GET' && url.includes('/task-g7-2')) {
+      // ordinal 2 失败:槽位原位转 failed(留列位)。
+      await route.fulfill({
+        status: 200,
+        contentType: 'application/json',
+        body: JSON.stringify({
+          id: 'task-g7-2',
+          kind: 'generate',
+          status: 'failed',
+          progress: 0,
+          stage: 'failed',
+          requestId: 'r-g7-2',
+          model: 'gpt-image-2',
+          error: 'Upstream error (500)',
+        }),
+      })
+      return
+    }
+    if (method === 'GET' && url.includes('/task-g7-0')) {
+      // ordinal 0 暂缓:releaseOrdinal0=false 前保持 running(真实中态窗口),
+      // 放行后首 poll 即 done。
+      if (!releaseOrdinal0) {
+        await route.fulfill({
+          status: 200,
+          contentType: 'application/json',
+          body: JSON.stringify({
+            id: 'task-g7-0',
+            kind: 'generate',
+            status: 'running',
+            progress: 30,
+            stage: 'running',
+            requestId: 'r-g7-0',
+            model: 'gpt-image-2',
+            result: { images: [] },
+          }),
+        })
+      } else {
+        await route.fulfill({
+          status: 200,
+          contentType: 'application/json',
+          body: JSON.stringify({
+            id: 'task-g7-0',
+            kind: 'generate',
+            status: 'done',
+            progress: 100,
+            stage: 'done',
+            requestId: 'r-g7-0',
+            model: 'gpt-image-2',
+            result: { images: [{ b64: generatedImageB64, variationIndex: 0 }] },
+          }),
+        })
+      }
+      return
+    }
+    // 其它 API 请求(asset 保存等)放行默认 mock。
+    await route.continue()
+  }
+  await page.route('**/api/mivo/tasks/**', handler)
+
+  // A) 预建列:startDerivedImageBatch(expectedCount=3)→ 3 个占位 slot,记录列位。
+  const prebuilt = await page.evaluate(
+    async ({ moduleSpec }) => {
+      const { useCanvasStore } = await import(moduleSpec)
+      const { nodes } = useCanvasStore.getState()
+      const source = nodes.find((n) => n.type === 'image' && !n.hidden)
+      if (!source) throw new Error('no source image')
+      const slotIds = await useCanvasStore.getState().startDerivedImageBatch({
+        sceneId: useCanvasStore.getState().sceneId,
+        sourceNodeId: source.id,
+        batchId: 'b-g7',
+        expectedCount: 3,
+      })
+      const s = useCanvasStore.getState()
+      const doc = s.canvases[s.sceneId] ?? s
+      return slotIds.map((id) => {
+        const node = doc.nodes.find((n) => n.id === id)
+        if (!node) throw new Error(`prebuilt slot missing: ${id}`)
+        return { id, ordinal: node.aiWorkflow?.ordinal, x: node.x, y: node.y }
+      })
+    },
+    { moduleSpec: spec },
+  )
+  if (prebuilt.length !== 3) {
+    throw new Error(`批次预建列异常:slotIds=${JSON.stringify(prebuilt)}`)
+  }
+
+  // 网络提交前:先把整列平移进视口(预建列可能超出视口,见 panBatchIntoView),
+  // 再对 3 个预建 slot **逐项**等渲染(renderer-aware waitForNodeRendered:
+  // dom 等 [data-node-id] 壳;leafer 等 DOM 壳 / leafer sync 追平)。旧「总数 ≥4」
+  // 断言是总数替代逐项证据——单个 slot 缺失会被总数抹平,已废弃;任一个 slot
+  // 缺失必须 fail-visible(waitForNodeRendered 超时抛错并点名缺失的 slot id)。
+  await panBatchIntoView(page, prebuilt)
+  for (const slot of prebuilt) {
+    await waitForNodeRendered(page, rendererMode, slot.id)
+  }
+
+  // B) 三个独立任务并行发起(不 await 聚合):ordinal 1 先终态、ordinal 2 失败、
+  // ordinal 0 暂缓。每个任务各自提交/轮询,谁先终态谁先提交——真实中态窗口。
+  await page.evaluate(
+    async ({ moduleSpec, slots }) => {
+      const { useCanvasStore } = await import(moduleSpec)
+      slots.forEach((slot) => {
+        const prompt = `g7 ${slot.ordinal === 1 ? 'ordinal-1' : slot.ordinal === 2 ? 'ordinal-2' : 'ordinal-0'} probe`
+        void useCanvasStore
+          .getState()
+          .generateIntoAiSlot(slot.id, prompt, {
+            derivedBatchId: 'b-g7',
+            expectedCount: 3,
+            ordinal: slot.ordinal,
+          })
+          .catch(() => {})
+      })
+    },
+    { moduleSpec: spec, slots: prebuilt },
+  )
+
+  // 中态断言(真实可观测):ordinal 1 已原位替换成 image(带 assetUrl、列位置
+  // 不变),ordinal 0 仍是 ai-slot 占位;ordinal 2 已原位转 failed(终态)。
+  // 手动轮询(不用 waitForFunction——它在本 prod 页面恒即时返回,断言会被跳过)。
+  const midStartedAt = Date.now()
+  let midOk = false
+  while (Date.now() - midStartedAt < 15000) {
+    const obs = await page.evaluate(
+      ({ moduleSpec, prebuilt }) => {
+        return import(moduleSpec).then(({ useCanvasStore }) => {
+          const s = useCanvasStore.getState()
+          const { nodes } = s.canvases[s.sceneId] ?? s
+          const read = (ordinal) => {
+            const n = nodes.find((x) => x.aiWorkflow?.batchId === 'b-g7' && x.aiWorkflow?.ordinal === ordinal)
+            if (!n) return null
+            return { type: n.type, status: n.status, x: n.x, y: n.y, hasAsset: Boolean(n.assetUrl) }
+          }
+          const slot1 = read(1)
+          const slot0 = read(0)
+          const p1 = prebuilt.find((p) => p.ordinal === 1)
+          return {
+            midOk:
+              slot1?.type === 'image' &&
+              Boolean(slot1?.hasAsset) &&
+              slot1.x === p1.x &&
+              slot1.y === p1.y &&
+              slot0?.type === 'ai-slot',
+          }
+        })
+      },
+      { moduleSpec: spec, prebuilt },
+    )
+    if (obs.midOk) {
+      midOk = true
+      break
+    }
+    await new Promise((resolve) => setTimeout(resolve, 200))
+  }
+  if (!midOk) {
+    throw new Error('中态 15s 内未出现:ordinal 1 应已替换成 image 且 ordinal 0 仍为占位')
+  }
+
+  // 显式中态快照(evidence 用):ordinal 1 已替换、ordinal 0 仍占位、列位置不变。
+  const midSnapshot = await page.evaluate(
+    ({ moduleSpec, prebuilt }) => {
+      return import(moduleSpec).then(({ useCanvasStore }) => {
+        const s = useCanvasStore.getState()
+        const { nodes } = s.canvases[s.sceneId] ?? s
+        const read = (ordinal) => {
+          const n = nodes.find((x) => x.aiWorkflow?.batchId === 'b-g7' && x.aiWorkflow?.ordinal === ordinal)
+          if (!n) return null
+          return { type: n.type, status: n.status, x: n.x, y: n.y, hasAsset: Boolean(n.assetUrl), ordinal: n.aiWorkflow?.ordinal }
+        }
+        return { slot0: read(0), slot1: read(1), slot2: read(2), prebuilt }
+      })
+    },
+    { moduleSpec: spec, prebuilt },
+  )
+  const p1 = prebuilt.find((p) => p.ordinal === 1)
+  // H4(fix3):中态观测的 elapsed 落日志进 evidence——「中态窗口实测成立」要有
+  // 可审计的实测值(此前 delivery 里 ~206ms 无证据支撑,已删精确数字)。
+  console.log(
+    `[p1b-batch-column] 中态窗口实测成立:ordinal1 已替换/ordinal0 仍占位,elapsed=${Date.now() - midStartedAt}ms`,
+  )
+  if (midSnapshot.slot1?.type !== 'image' || !midSnapshot.slot1?.hasAsset) {
+    throw new Error(`中态 ordinal 1 未替换:${JSON.stringify(midSnapshot.slot1)}`)
+  }
+  if (midSnapshot.slot1.x !== p1.x || midSnapshot.slot1.y !== p1.y) {
+    throw new Error(`中态列位置漂移:${JSON.stringify(midSnapshot.slot1)} vs prebuilt ${JSON.stringify(p1)}`)
+  }
+  if (midSnapshot.slot0?.type !== 'ai-slot') {
+    throw new Error(`中态 ordinal 0 提前替换:${JSON.stringify(midSnapshot.slot0)}`)
+  }
+
+  // 放行 ordinal 0 → 等它终态完成(全部提交)。手动轮询(与中态同一套:
+  // waitForFunction 在本仓 prod 页面上恒即时返回,断言会被跳过,必须自己轮询)。
+  releaseOrdinal0 = true
+  const releaseStartedAt = Date.now()
+  let slot0Done = false
+  // H4(fix3):st 必须声明在 while 外——块内 let 在超时分支外引用会 ReferenceError,
+  // 让「未终态」诊断本身崩掉,超时信息打不出来。
+  let st
+  while (Date.now() - releaseStartedAt < 15000) {
+    st = await page.evaluate(
+      ({ moduleSpec }) => {
+        return import(moduleSpec).then(({ useCanvasStore }) => {
+          const s = useCanvasStore.getState()
+          const { nodes } = s.canvases[s.sceneId] ?? s
+          const slot0 = nodes.find((n) => n.aiWorkflow?.batchId === 'b-g7' && n.aiWorkflow?.ordinal === 0)
+          return { type: slot0?.type ?? null, hasAsset: Boolean(slot0?.assetUrl) }
+        })
+      },
+      { moduleSpec: spec },
+    )
+    if (st.type === 'image' && st.hasAsset) {
+      slot0Done = true
+      break
+    }
+    await new Promise((resolve) => setTimeout(resolve, 200))
+  }
+  if (!slot0Done) {
+    throw new Error(`放行后 ordinal 0 未终态完成(type=${st?.type},hasAsset=${st?.hasAsset},elapsed=${Date.now() - releaseStartedAt}ms)`)
+  }
+
+  // B) chat 旁生成(expectedCount=1):**真走 chatStore.sendMessage**(F10:不直调
+  // store action)——有源图(选中 image)→ prepareChatSlot beside → generateBesideNode
+  // 批次:1。chat 与 canvas 是同一 store 树,import chatStore 后 sendMessage 内部
+  // 经 generationFacade 命中同一 mock 的 POST /tasks/edit。
+  await page.evaluate(
+    async ({ moduleSpec }) => {
+      const { useCanvasStore } = await import(moduleSpec)
+      // chatStore 与 canvasStore 同策略动态解析(performance resource entries 找
+      // 真实模块 URL,兜底裸路径;dev 由 vite 直接服务、prod 由 installE2EStoreBridge
+      // route 拦截返回 bridge 模块,两者都可导入)——禁止硬编码裸路径,与
+      // chat-generation/migration/chat-copy 等场景的既有模式一致。
+      const chatResource = performance
+        .getEntriesByType('resource')
+        .map((entry) => entry.name)
+        .find((name) => name.includes('/src/store/chatStore.ts'))
+      const chatSpec = chatResource
+        ? new URL(chatResource).pathname + new URL(chatResource).search
+        : '/src/store/chatStore.ts'
+      const { useChatStore } = await import(chatSpec)
+      const { nodes } = useCanvasStore.getState()
+      const source = nodes.find((n) => n.type === 'image' && !n.hidden)
+      if (!source) throw new Error('no source image')
+      // sendMessage:选中源图 + 显式 selectedNodeType=image → chat 有源旁生成。
+      await useChatStore.getState().sendMessage({
+        sceneId: useCanvasStore.getState().sceneId,
+        text: 'a cat beside',
+        selectedNodeId: source.id,
+        selectedNodeType: 'image',
+      })
+    },
+    { moduleSpec: spec },
+  )
+  // 等待 chat 生成任务 done(手动轮询,同上——waitForFunction 恒即时返回不可用)。
+  const chatWaitStartedAt = Date.now()
+  let chatDone = false
+  while (Date.now() - chatWaitStartedAt < 15000) {
+    const chatState = await page.evaluate(
+      ({ moduleSpec }) => {
+        return import(moduleSpec).then(({ useCanvasStore }) => {
+          const s = useCanvasStore.getState()
+          const tasks = s.canvases[s.sceneId]?.tasks ?? s.tasks
+          return tasks.some((t) => t.status === 'done' && t.label.includes('旁边生成'))
+        })
+      },
+      { moduleSpec: spec },
+    )
+    if (chatState) {
+      chatDone = true
+      break
+    }
+    await new Promise((resolve) => setTimeout(resolve, 200))
+  }
+  if (!chatDone) {
+    throw new Error('chat 旁生成任务 15s 内未 done')
+  }
+
+  // 断言:变体结果乱序完成后 ordinal 位置不变(store 直读 bounds)。
+  const bounds = await page.evaluate(
+    ({ moduleSpec }) => {
+      return import(moduleSpec).then(({ useCanvasStore }) => {
+        const s = useCanvasStore.getState()
+        const { nodes } = s.canvases[s.sceneId] ?? s
+        const source = nodes.find((n) => n.type === 'image' && !n.hidden)
+        if (!source) return { error: 'no source' }
+        // 结果节点批次身份继承自被替换 slot 的 batchId(makeNode 展开进 aiWorkflow)。
+        const results = nodes.filter(
+          (n) => n.aiWorkflow?.batchId && n.type === 'image' && n.id !== source.id,
+        )
+        const failedSlots = nodes
+          .filter((n) => n.type === 'ai-slot' && n.status === 'failed')
+          .map((n) => ({
+            id: n.id,
+            x: n.x,
+            y: n.y,
+            ordinal: n.aiWorkflow?.ordinal,
+            batchId: n.aiWorkflow?.batchId,
+          }))
+        const tasks = s.canvases[s.sceneId]?.tasks ?? s.tasks
+        return {
+          sourceX: source.x,
+          sourceY: source.y,
+          sourceH: Math.round(source.height),
+          results: results.map((n) => ({
+            id: n.id,
+            x: n.x,
+            y: n.y,
+            width: n.width,
+            height: n.height,
+            ordinal: n.aiWorkflow?.ordinal,
+            batchId: n.aiWorkflow?.batchId,
+          })),
+          failedSlots,
+          taskStatuses: tasks.map((t) => ({ id: t.id, status: t.status, label: t.label })),
+          allNodes: nodes.map((n) => ({
+            id: n.id,
+            type: n.type,
+            status: n.status,
+            batchId: n.aiWorkflow?.batchId,
+            metaBatchId: n.batchMetadata?.batchId,
+          })),
+          beside: nodes
+            .filter((n) => n.aiWorkflow?.batchId?.includes('batch-beside'))
+            .map((n) => ({ x: n.x, y: n.y, width: n.width, height: n.height })),
+        }
+      })
+    },
+    { moduleSpec: spec },
+  )
+  if (bounds.error) throw new Error(`bounds 采集失败:${bounds.error}`)
+  // A) 共享 batchId b-g7 的独立任务批:N=3 中 2 成功——同列左缘 x 相等、
+  //    高度=源图高度、ordinal 0/1 完整;失败槽**绑定该批次 ordinal 2**(不是
+  //    全局 failedCount):原位转 failed 且留列位(位置=预建列位)。
+  const g7Results = bounds.results.filter((r) => r.batchId === 'b-g7')
+  if (g7Results.length < 2) {
+    throw new Error(`b-g7 列结果不足:${JSON.stringify(bounds.results)}`)
+  }
+  const g7Ordinals = g7Results.map((r) => r.ordinal).sort()
+  if (JSON.stringify(g7Ordinals) !== JSON.stringify([0, 1])) {
+    throw new Error(`独立任务乱序完成后 b-g7 ordinal 丢失:${JSON.stringify(g7Ordinals)}`)
+  }
+  // G7+H3(fix3):失败槽必须绑定具体 **batchId+ordinal 双条件**——ordinal 2 且属于
+  // b-g7 批次的 slot 转 failed 且留在预建列位。只按 ordinal 找可能误中其它批次
+  // (如 batch-beside)同名 ordinal 的失败槽,削弱绑定。
+  const failedSlot2 = bounds.failedSlots.find((f) => f.batchId === 'b-g7' && f.ordinal === 2)
+  if (!failedSlot2) {
+    throw new Error(
+      `b-g7 ordinal 2 失败槽缺失(双条件 batchId=b-g7 && ordinal=2):${JSON.stringify(bounds.failedSlots)};g7slots=${JSON.stringify(
+        bounds.allNodes.filter((n) => n.batchId === 'b-g7'),
+      )}`,
+    )
+  }
+  const p2 = prebuilt.find((p) => p.ordinal === 2)
+  if (failedSlot2.x !== p2.x || failedSlot2.y !== p2.y) {
+    throw new Error(`ordinal 2 失败槽列位漂移:${JSON.stringify(failedSlot2)} vs prebuilt ${JSON.stringify(p2)}`)
+  }
+  // b-g7 结果同列左缘 x 相等、高度锁定。
+  const g7Xs = new Set(g7Results.map((r) => r.x))
+  if (g7Xs.size !== 1) {
+    throw new Error(`b-g7 结果左缘 x 不一致:${JSON.stringify(g7Results)}`)
+  }
+  for (const r of g7Results) {
+    if (r.height !== bounds.sourceH) {
+      throw new Error(`b-g7 结果高度未锁定:${JSON.stringify(r)} vs 源高 ${bounds.sourceH}`)
+    }
+  }
+  // B) chat 旁生成:占位 y === 源 y、高度锁定。
+  if (bounds.beside.length < 1) {
+    throw new Error('chat 旁生成结果缺失')
+  }
+  const beside = bounds.beside[0]
+  if (beside.y !== bounds.sourceY || beside.height !== bounds.sourceH) {
+    throw new Error(`chat 旁生成未边缘对齐:${JSON.stringify(beside)} vs 源 y=${bounds.sourceY} h=${bounds.sourceH}`)
+  }
+}
