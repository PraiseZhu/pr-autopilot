+/**
+ * P1b:变体批次结果收敛(generateVariations 批次模式共用,职责在批次协调边界内)。
+ * 逐 ordinal:失败变体把对应预建 slot 原位转 failed(不删除、不压缩列、不重排);
+ * 成功变体按 variationIndex(缺省按序)取结果图原位替换其 ordinal slot。
+ * 返回成功替换的节点 id 列表。
+ *
+ * M2:收敛前先做 ordinal 分区校验——images+failures 必须构成 0..count-1 的完整、
+ * 无重复、无越界、互斥 partition。违规时 fail-visible:可靠 accounted 的 ordinal
+ * 照常收敛(已成功结果保留),未 accounted(缺失/互斥冲突)的 ordinal 原位转 failed,
+ * 最后抛错让父任务失败——绝不在槽位仍 generating 时把父任务记为 done。
+ */
+export const commitVariationsBatch = async (
+  set: StoreApi<CanvasState>['setState'],
+  get: StoreApi<CanvasState>['getState'],
+  params: VariationsBatchCommitParams,
+): Promise<string[]> => {
+  const successIds: string[] = []
+  const violations: string[] = []
+
+  // 分区校验(单一终态 transition 前置):重复保留首项,越界项只记违规。
+  const imageByIndex = new Map<number, TaskResultImage>()
+  for (const [index, image] of params.images.entries()) {
+    const key = image.variationIndex !== undefined ? image.variationIndex : index
+    if (!Number.isInteger(key) || key < 0 || key >= params.count) {
+      violations.push(`结果图 variationIndex=${key} 越界(count=${params.count})`)
+      continue
+    }
+    if (imageByIndex.has(key)) {
+      violations.push(`结果图 variationIndex=${key} 重复`)
+      continue
+    }
+    imageByIndex.set(key, image)
+  }
+  const failureByIndex = new Map<number, TaskFailure>()
+  for (const failure of params.failures ?? []) {
+    const key = failure.variationIndex
+    if (!Number.isInteger(key) || key < 0 || key >= params.count) {
+      violations.push(`失败项 variationIndex=${key} 越界(count=${params.count})`)
+      continue
+    }
+    if (failureByIndex.has(key)) {
+      violations.push(`失败项 variationIndex=${key} 重复`)
+      continue
+    }
+    failureByIndex.set(key, failure)
+  }
+  // 互斥:同一 ordinal 同时有结果与失败 → 两义,该 ordinal 按未 accounted 收敛。
+  const conflictedOrdinals = [...imageByIndex.keys()].filter((ordinal) => failureByIndex.has(ordinal))
+  for (const ordinal of conflictedOrdinals) {
+    violations.push(`ordinal ${ordinal} 同时存在结果图与失败项(互斥分区违规)`)
+  }
+  // 缺失:0..count-1 里既无结果也无失败的 ordinal。
+  const accounted = new Set<number>([...imageByIndex.keys(), ...failureByIndex.keys()])
+  const unaccountedOrdinals: number[] = []
+  for (let ordinal = 0; ordinal < params.count; ordinal += 1) {
+    if (!accounted.has(ordinal)) {
+      unaccountedOrdinals.push(ordinal)
+      violations.push(`ordinal ${ordinal} 缺失结果或失败(count=${params.count})`)
+    }
+  }
+
+  const settleOrdinalFailed = (ordinal: number, reasonText: string) => {
+    getSceneWrap()(params.sceneId, () => set((current) => {
+      // 先 settle(原位转 failed),再基于 settle 结果补 text/title——不得用未
+      // settle 的 current 重新 patch nodes(会把 failed 状态覆盖回 generating)。
+      const patch = settleBatchSlotState(current, params.sceneId, {
+        slotId: params.slotIds[ordinal],
+        batchId: params.batchId,
+        status: 'failed',
+        settleWholeBatch: false,
+      })
+      const settledDoc = patch.canvases?.[params.sceneId]
+      if (!settledDoc) return patch
+      // settle 的 patch 含顶层 nodes(活跃画布同步),必须一并返回——只给
+      // canvases 会让 store 顶层 nodes 停留 generating(测试/UI 读顶层)。
+      // 非活跃画布只写 canonical,不碰顶层镜像。
+      const annotatedNodes = (settledDoc.nodes || []).map((node) =>
+        node.id === params.slotIds[ordinal]
+          ? { ...node, text: reasonText, title: `Variation ${ordinal + 1} 失败` }
+          : node,
+      )
+      return {
+        ...patch,
+        ...(params.sceneId === current.sceneId ? { nodes: annotatedNodes } : {}),
+        canvases: {
+          ...patch.canvases,
+          [params.sceneId]: { ...settledDoc, nodes: annotatedNodes },
+        },
+      }
+    }))
+  }
+
+  for (let ordinal = 0; ordinal < params.count; ordinal += 1) {
+    if (conflictedOrdinals.includes(ordinal) || unaccountedOrdinals.includes(ordinal)) {
+      // 未 accounted(缺失/互斥冲突)→ 原位转 failed,fail-visible。
+      settleOrdinalFailed(
+        ordinal,
+        conflictedOrdinals.includes(ordinal)
+          ? `批次结果互斥冲突:ordinal ${ordinal} 同时有结果图与失败项`
+          : `批次结果缺失:ordinal ${ordinal} 无结果图或失败项`,
+      )
+      debugLogger.error(
+        'Derived Batch',
+        `变体 ordinal ${ordinal} 结果载荷违规,slot ${params.slotIds[ordinal]} 原位转 failed(batchId=${params.batchId})`,
+      )
+      continue
+    }
+    const failure = failureByIndex.get(ordinal)
+    if (failure) {
+      settleOrdinalFailed(ordinal, failure.error)
+      debugLogger.warn(
+        'Derived Batch',
+        `变体 ordinal ${ordinal} 失败,slot ${params.slotIds[ordinal]} 原位转 failed(batchId=${params.batchId})`,
+      )
+      continue
+    }
+    const imageForOrdinal = imageByIndex.get(ordinal)
+    if (!imageForOrdinal) continue
+    const committed = await get().commitGenerationResult({
+      sceneId: params.sceneId,
+      sourceNodeId: params.sourceNodeId,
+      replaceSlotId: params.slotIds[ordinal],
+      resultImages: [imageForOrdinal],
+      prompt: params.prompt,
+      model: params.model,
+      kind: 'generate',
+      taskId: params.taskId,
+    })
+    successIds.push(...committed)
+    debugLogger.log(
+      'Derived Batch',
+      `变体 ordinal ${ordinal} 原位替换 slot ${params.slotIds[ordinal]}(batchId=${params.batchId})`,
+    )
+  }
+
+  if (violations.length > 0) {
+    // 分区违规 fail-visible:已成功结果保留、未 accounted 槽位已转 failed,
+    // 但父任务必须失败(不得误 done)。
+    const message = `批次结果分区违规(count=${params.count}):${violations.join(';')}`
+    debugLogger.error('Derived Batch', message)
+    throw new Error(message)
+  }
+  return successIds
+}
