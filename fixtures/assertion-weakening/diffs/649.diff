+export type VariationsBatchCommitParams = {
+  sceneId: CanvasId
+  sourceNodeId: string
+  batchId: string
+  slotIds: string[]
+  count: number
+  images: TaskResultImage[]
+  failures?: TaskFailure[]
+  prompt: string
+  model: string
