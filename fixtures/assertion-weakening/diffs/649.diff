+export const settleBatchSlotsTerminal = (
+  current: CanvasState,
+  targetSceneId: CanvasId,
+  options: { batchId: string; slotIds: string[]; status: 'failed' | 'canceled' },
+): Partial<CanvasState> => {
+  let document = current.canvases[targetSceneId]
+  if (!document) return {}
+  let accumulated: Partial<CanvasState> = {}
+  for (const slotId of options.slotIds) {
+    const step = settleBatchSlotState(
+      { ...current, canvases: { ...current.canvases, [targetSceneId]: document } },
+      targetSceneId,
+      {
+        slotId,
+        batchId: options.batchId,
+        status: options.status,
+        settleWholeBatch: false,
+      },
+    )
+    const stepDoc = step.canvases?.[targetSceneId]
+    if (!stepDoc) return accumulated
+    document = stepDoc
+    accumulated = { ...accumulated, ...step }
+  }
+  return accumulated
+}
