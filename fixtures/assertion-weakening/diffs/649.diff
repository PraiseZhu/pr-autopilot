+export const resolveBatchBinding = (
+  intent: PlacementIntent,
+  document: { nodes: MivoCanvasNode[] },
+  options: Pick<CanvasGenerationOptions, 'placement' | 'derivedBatchId' | 'expectedCount' | 'ordinal'>,
+  set: StoreApi<CanvasState>['setState'],
+  get: StoreApi<CanvasState>['getState'],
+  ownerParams: { sceneId: CanvasId; sourceNodeId: string; batchPrefix: string },
+): BatchBinding => {
+  if (intent === 'legacy') return {}
+  if (intent === 'batch-owner') {
+    const batchId = createNodeId(ownerParams.batchPrefix)
+    const slotIds = startDerivedImageBatchImpl(set, get, {
+      sceneId: ownerParams.sceneId,
+      sourceNodeId: ownerParams.sourceNodeId,
+      batchId,
+      expectedCount: options.expectedCount as number,
+    })
+    const doc = get().canvases[ownerParams.sceneId]
+    const slot = doc.nodes.find((node) => node.id === slotIds[0] && node.type === 'ai-slot')
+    if (!slot) throw new Error(`批次 ${batchId} 预建后找不到 ordinal 0 slot`)
+    return { batchId, slot }
+  }
+  const slot = bindBatchOrdinal(document, {
+    derivedBatchId: options.derivedBatchId,
+    expectedCount: options.expectedCount,
+    ordinal: options.ordinal,
+  })
