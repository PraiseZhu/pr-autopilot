+ * 原位转 failed/canceled 终态(不删除、不压缩列)+ 任务状态收敛 + debugLogger.warn。
+ */
+export const settleBatchCatch = (
+  set: StoreApi<CanvasState>['setState'],
+  params: SettleBatchCatchParams,
+): void => {
+  if (params.isUserDeletedSlot) {
+    // SC3:用户已删 skip——用户删掉了批次 slot,收敛跳过(不重建、不删同批)。
+    debugLogger.warn('Derived Batch', `用户已删除 slot ${params.slotId},批次收敛跳过(batchId=${params.batchId})`)
+  }
+  getSceneWrap()(params.sceneId, () => set((current) => {
+    const patch = settleBatchSlotState(current, params.sceneId, {
+      slotId: params.slotId,
+      batchId: params.batchId,
+      status: params.canceled ? 'canceled' : 'failed',
+      settleWholeBatch: params.settleWholeBatch,
+    })
+    // M3:任务 patch 必须基于 settled doc——拿 pre-settle current 重新
+    // patchCanvasDocument 会把 canonical 画布节点覆盖回 generating(顶层镜像
+    // 说 failed 而 persisted 的 canonical 说 generating,reload 复活 zombie)。
+    const settledDoc = patch.canvases?.[params.sceneId]
+    if (!settledDoc) return patch
+    const liveTask = settledDoc.tasks.find((t) => t.id === params.runningTask.id) ?? params.runningTask
+    const nextTasks = upsertTask(
+      settledDoc.tasks,
+      params.canceled ? { ...liveTask, label: params.canceledLabel, status: 'canceled' as const }
+        : { ...liveTask, label: params.failedLabel, status: 'failed' as const },
+    )
+    return {
+      ...patch,
+      // 顶层 tasks 镜像只随活跃画布更新;非活跃画布只写 canonical。
+      ...(params.sceneId === current.sceneId ? { tasks: nextTasks } : {}),
+      canvases: {
+        ...patch.canvases,
+        [params.sceneId]: { ...settledDoc, tasks: nextTasks },
+      },
+    }
+  }))
+  debugLogger.warn(
+    'Derived Batch',
+    `ordinal ${params.ordinalLabel} ${params.canceled ? '取消' : '失败'}${params.settleWholeBatch ? '(源图已删,同批收敛)' : ''},slot ${params.slotId} 原位转终态`,
+  )
+}
