+export const assertPlacementIntent = (
+  options: Pick<CanvasGenerationOptions, 'placement' | 'derivedBatchId' | 'expectedCount' | 'ordinal'>,
+): PlacementIntent => {
+  const tripletPresent = [options.derivedBatchId, options.expectedCount, options.ordinal].filter(
+    (value) => value !== undefined,
+  ).length
+  if (options.placement === 'legacy') {
+    // 三态互斥:legacy 与批次凭证互斥,携带任一批次字段即 fail-closed(不静默忽略)。
+    const stray = [options.derivedBatchId, options.expectedCount, options.ordinal].filter((v) => v !== undefined)
+    if (stray.length > 0) {
+      const message = `排布意图互斥冲突:placement=legacy 不得携带批次字段(derivedBatchId=${options.derivedBatchId},expectedCount=${options.expectedCount},ordinal=${options.ordinal})`
+      debugLogger.error('Derived Batch', message)
+      throw new Error(message)
+    }
+    debugLogger.log('Derived Batch', '排布意图:placement=legacy(无批次列,走旧路径)')
+    return 'legacy'
+  }
+  if (options.placement === 'batch') {
+    if (!Number.isInteger(options.expectedCount) || (options.expectedCount as number) < 1 || (options.expectedCount as number) > 4) {
+      const message = `批次发起必须带 1-4 的整数 expectedCount,收到 ${options.expectedCount}`
+      debugLogger.error('Derived Batch', message)
+      throw new Error(message)
+    }
+    // 三态互斥:batch-owner 不得携带成员侧凭证(derivedBatchId/ordinal 属批次成员)。
+    const ownerStray = [options.derivedBatchId, options.ordinal].filter((v) => v !== undefined)
+    if (ownerStray.length > 0) {
+      const message = `排布意图互斥冲突:批次发起(placement=batch)不得携带成员侧凭证(derivedBatchId=${options.derivedBatchId},ordinal=${options.ordinal})`
+      debugLogger.error('Derived Batch', message)
+      throw new Error(message)
+    }
+    debugLogger.log('Derived Batch', `排布意图:批次发起 expectedCount=${options.expectedCount}`)
+    return 'batch-owner'
+  }
+  const tripletComplete =
+    tripletPresent === 3 &&
+    options.derivedBatchId !== undefined &&
+    options.expectedCount !== undefined &&
+    options.ordinal !== undefined
+  if (tripletComplete) {
+    debugLogger.log(
+      'Derived Batch',
+      `排布意图:批次成员 batchId=${options.derivedBatchId} ordinal=${options.ordinal}`,
+    )
+    return 'batch-member'
+  }
+  if (tripletPresent === 0) {
+    // β1(store-contract 节):全部缺失 → legacy 静默(旧行为,调用点未接线时
+    // 保持发布级兼容)。β2(entry-wiring 节)把此处改为 fail-closed 抛错。
+    debugLogger.log('Derived Batch', '排布意图:未显式声明,按 legacy 静默(旧路径)')
+    return 'legacy'
+  }
+  // 部分缺失(1-2 个字段)→ fail-closed 抛错:与 α 基线 generationSlice 语义一致
+  // (齐全/全缺二选一,部分缺失抛错),修复 β1 把部分缺失静默 legacy 的回归。
+  const message = `排布意图部分缺失:必须提供完整三元组(derivedBatchId/expectedCount/ordinal)或全缺走 legacy,收到 placement=${options.placement},derivedBatchId=${options.derivedBatchId},expectedCount=${options.expectedCount},ordinal=${options.ordinal}`
+  debugLogger.error('Derived Batch', message)
+  throw new Error(message)
+}
