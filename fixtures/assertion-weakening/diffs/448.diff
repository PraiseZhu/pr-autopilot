+/**
+ * 选中观测组的三态归一化(SC-T2b.1,设计稿 §2.11-②):main.js egress 是唯一权威,
+ * 面板在线/离线两条路径的最终交卷对象都经过这一处,不得在别处自行拼
+ * `selectionObservation`。
+ *
+ * - offline:数值字段一律不出现(即使共享层等价性测试用的离线首页函数算出了候选值
+ *   ——那是给「两形态输出逐字段一致」用的中间态,不是最终交卷形态),`selectionObservation:'unavailable'`。
+ * - live 且三类校验(形状/关系不变量/本页语义)全部通过 → `'available'`,数值字段保留。
+ * - live 但任一校验失败(含字段整组缺失——真实面板经共享层派生后必存在,缺失本身
+ *   就是形状违规)→ `'invalid'`,数值字段整组剔除 + diag 留痕(fail-visible,不静默
+ *   放过协议混淆)。
+ *
+ * 只挡协议混淆与形状污染、保证交卷对象内部自洽——不复核「id 是否真的来自用户选中」
+ * (信任边界见设计稿:能伪造选中字段的对手同样能伪造整份快照)。
+ */
+function normalizeSelectionObservation(snapshot, offline) {
+  if (!snapshot || typeof snapshot !== 'object') return snapshot
+
+  const withoutSelectionFields = (source) => {
+    const next = Object.assign({}, source)
+    delete next.selectedImageNodeIds
+    delete next.selectedNodeCount
+    delete next.selectedImageNodesTruncated
+    return next
+  }
+
+  if (offline) {
+    return Object.assign(withoutSelectionFields(snapshot), { selectionObservation: 'unavailable' })
+  }
+
+  const markInvalid = (reason) => {
+    diagSkip(DIAG_SOURCE.tool, 'snapshot 选中观测组校验失败,已按 invalid 归一化并剔除数值字段: ' + reason)
+    return Object.assign(withoutSelectionFields(snapshot), { selectionObservation: 'invalid' })
+  }
+
+  const ids = snapshot.selectedImageNodeIds
+  const count = snapshot.selectedNodeCount
+  const truncatedFlag = snapshot.selectedImageNodesTruncated
+
+  // ①形状
+  if (
+    !Array.isArray(ids) ||
+    ids.some((id) => typeof id !== 'string' || !id) ||
+    new Set(ids).size !== ids.length ||
+    ids.length > SNAPSHOT_MAX_SELECTED_IMAGE_NODE_IDS
+  ) {
+    return markInvalid('selectedImageNodeIds 不是合法的字符串数组(逐项非空/无重复/长度≤64)')
+  }
+  if (typeof count !== 'number' || !Number.isInteger(count) || count < 0) {
+    return markInvalid('selectedNodeCount 不是非负安全整数')
+  }
+  if (truncatedFlag !== undefined && truncatedFlag !== true) {
+    return markInvalid('selectedImageNodesTruncated 只允许 true 或缺省')
+  }
+  // ②关系不变量
+  if (count < ids.length) return markInvalid('selectedNodeCount 小于 selectedImageNodeIds 长度')
+  if (truncatedFlag === true && ids.length !== SNAPSHOT_MAX_SELECTED_IMAGE_NODE_IDS) {
+    return markInvalid('selectedImageNodesTruncated 为 true 但长度不等于上限')
+  }
+  if (truncatedFlag === true && count < SNAPSHOT_MAX_SELECTED_IMAGE_NODE_IDS) {
+    return markInvalid('selectedImageNodesTruncated 为 true 但 selectedNodeCount 小于上限')
+  }
+  // ③本页可验证语义:本页 nodes 里出现的选中图片 id,其节点 type 必须是 'image'
+  // (不在本页的 id 无法本地复核,不算违规——信任边界,见函数顶注)。
+  const nodesInPage = Array.isArray(snapshot.nodes) ? snapshot.nodes : []
+  const typeById = new Map(nodesInPage.map((node) => [node && node.id, node && node.type]))
+  for (const id of ids) {
+    const type = typeById.get(id)
+    if (type !== undefined && type !== 'image') {
+      return markInvalid('selectedImageNodeIds 命中本页里 type 不是 image 的节点: ' + id)
+    }
+  }
+
+  return Object.assign({}, snapshot, { selectionObservation: 'available' })
+}
