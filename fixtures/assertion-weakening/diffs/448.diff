 /** 统一交卷形状:面板首页与离线首页共用,字段名与共享层 SnapshotPage 一致。 */
 function snapshotResult(source, reply, offline) {
-  const result = { source, snapshot: reply.snapshot }
+  const result = { source, snapshot: normalizeSelectionObservation(reply.snapshot, offline) }
   if (reply.filter) result.filter = reply.filter
   if (reply.page) result.page = reply.page
   if (reply.omittedRefs) result.omittedRefs = reply.omittedRefs
