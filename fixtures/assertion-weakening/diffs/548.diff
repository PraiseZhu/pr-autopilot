+        // i.e. the exact race we're guarding against. Fail loudly instead of reloading.
+        if (outcome !== 'settled') {
+          throw new Error(`flushCanvasPersistWrite outcome=${outcome} — persist barrier did not settle before reload`)
+        }
+        return outcome
+      })
+    })
