+// ── debug log 回传 relay(v3)─────────────────────────────────────────────────
+//
+// 面板把 warning/error 级 debug log 交给这里,经 network 槽代发到生产 BFF。
+// 完整设计:docs/plans/2026-08-06-cindyplugin-silent-debug-log.md
+//
+// 三条与本仓其它 handler **刻意不同**的地方,每条都有非风格性的理由:
+//
+// ① **不进 chain**:relay 会挂到网络超时(20s 级)。占用 chain 就等于让一次网络悬挂
+//    卡住画布 save/load —— 诊断功能拖垮主功能是不可接受的。与 gen-image / deposit /
+//    release 同款处理(各自独立 single-flight)。
+//
+// ② **不调 diagOk / diagSkip / diagFail**:diag 事件经 mivo-canvas-diag 回流到面板的
+//    debugLogger,而 warn/error 会被 reporter 再次上报 —— "上报失败 → 记一条 error →
+//    又去上报 → 又失败" 是个自激励死循环。src/store/remoteDebugReporter.ts 的 `logLocal`
+//    是同一问题的既有先例(直写 store、绕开 debugLogger)。这里连 diag 都不发,只用
+//    宿主侧 console(归宿主日志,不进面板、不进上报链)。
+//    docs/development-logging.md 的强制范围是"user-facing feature flows"与按钮/菜单/
+//    画布动作等,本路径零 UI、纯诊断基建,不在其内;可观测面是面板侧计数器 + 这里的
+//    console + reporter 自己的 drop 计数(三者都不成环)。
+//
+// ③ **端点与请求头写死在这里**:面板只递 payload,不传 URL / header。面板侧被注入也
+//    改不了目标地址,也塞不进第二个凭证。
+const DEBUG_RELAY_ENDPOINT = 'https://mivo-canvas.dsworks.cn/api/mivo/debug-logs'
+// 摄取 token(半公开,owner 已接受该边界:随插件包分发,只换来"可写日志",不授予读能力,
+// 且仍受服务端 60/min/IP 限流 + 1MB body + 磁盘 quota 约束)。
+// ⚠️ 发布构建注入点(2026-08-10 #591 P1 返修):`DEBUG_INGEST_TOKEN_FROM_BUILD` 是
+// **唯一**会被替换的一行 —— cindyplugin/build.sh 从环境变量 `MIVO_DEBUG_INGEST_TOKEN`
+// 把真实值替换进 dist 副本,不配置则保持空串。**不要人手改这一行**:替换动作由构建
+// 脚本机械执行;token 请配进生产构建环境,与 .env.example 的 `MIVO_DEBUG_INGEST_TOKEN`
+// 保持一致(两边不一致 = 全部 403 → reporter 退避到重试上限后计入 drop 计数,
+// 面板计数器可查,非静默丢失)。
+//
+// 「未配置」判定是下面的**空串判定**,与被替换的这一行内容解耦 —— 旧版是
+// "占位常量 + `===` 与占位常量比较":生产没有 seam,`DEBUG_INGEST_TOKEN` 恒等于
+// 占位值,而"发布前替换那一行"会同时改掉比较的两边,等式永远成立 → 正式包永久
+// 零出网(审查者 zhongxingtai-ai 的 P1,relay 在发布路径上恒被守卫拦下)。
+const DEBUG_INGEST_TOKEN_FROM_BUILD = ''
+// seam 只在协议测试里存在(生产 globalThis.__mivoBrainSeam 不存在)→ 生产恒取
+// 构建注入值。测试经 seam 注入真实形态的 token,行使真正的出网路径。
+const DEBUG_INGEST_TOKEN = (seam && seam.debugIngestToken) || DEBUG_INGEST_TOKEN_FROM_BUILD
+// 比面板侧桥超时(30s)短:让电子脑有机会先回执,而不是让面板超时自己合成回执。
+const DEBUG_RELAY_FETCH_TIMEOUT_MS = 20_000
+// 兜底保险丝(面板侧同样有一道,这里防"面板那道被绕过/被改坏")。
+const DEBUG_RELAY_FUSE_WINDOW_MS = 10 * 60_000
+const DEBUG_RELAY_FUSE_MAX = 30
+
+// ── coarse backstop(2026-08-09 relay 审计 relay-1)──────────────────────────
+// 面板侧 debugLogRedact 是**唯一完整脱敏点**(规则层)。这里只在出网前补三类最常见
+// 的明文敏感形态(token 形态 / URL / 邮箱),接"面板脱敏漏了"的场景。
+// **刻意不是同构实现**:未过 tsc 的 JS 里复制 590 行规则层必然漂移、给人虚假信心,
+// 所以只做极简兜底 —— 保持短、可读,新增形态先加进规则层而不是这里。
+const DEBUG_RELAY_COARSE_REDACTORS = [
+  // 已知前缀 + 分隔符(-/_) + ≥8 位 body。body 字符类**含 `-_`**:多段密钥
+  // (sk-proj-… / sk-ant-api03-… / xoxb-<id>-<secret>)整体命中,不留残段
+  // (旧版 body 只吃单段,xoxb 半抹留尾段,2026-08-09 返工)。
+  // 末尾 `\b` 收:不吃相邻文本。
+  // **不含 `mivo`**:它是本产品命名空间前缀,纳入会误伤 `mivo-canvas-persist`
+  // (bridge 频道常量)等标识符、损害诊断价值(2026-08-09 二轮返工,见
+  // debugLogRedact.ts 头注);`mivo_` 形态密钥由面板规则层的前缀规则覆盖,但该规则
+  // **不区分密钥与标识符**(小写 mivo 前缀串一律被抹,仅全大写结局码豁免) —— 那是
+  // 刻意保留的过度脱敏,完整理由与钉住测试见 debugLogRedact.ts 头注。
+  { re: /\b(?:sk|ghp|gho|ghu|ghs|xox[baprs])[-_][A-Za-z0-9_-]{8,}\b/g, mark: '[secret]' },
+  // AKIA 无分隔符,单独一条(AWS access key 形态)。
+  { re: /\bAKIA[A-Z0-9]{12,}\b/g, mark: '[secret]' },
+  // URL / data: URI。排除引号与反斜杠,避免匹配越出 JSON 字符串边界。
+  { re: /\b(?:https?|ftp|data):[^\s"'\\]{4,}/g, mark: '[url]' },
+  // 邮箱(粗粒度:可能误伤 `160@2x.png` 这类 DPI 引用 —— 面板规则层会先行处理文件名,
+  // 这里只兜规则层漏掉的情况,接受这个误伤面)。
+  { re: /\b[A-Za-z0-9._%+-]{2,}@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b/g, mark: '[email]' },
+]
+
+/** 在字符串化的出网 body 上做替换。标记不含引号/反斜杠,替换后 JSON 仍合法。 */
+function debugRelayCoarseRedact(text) {
+  let out = String(text)
+  for (const r of DEBUG_RELAY_COARSE_REDACTORS) out = out.replace(r.re, r.mark)
+  return out
+}
+
+const debugRelayInflight = new Set()
+let debugRelayStarts = []
+let debugRelayPlaceholderNoted = false
+let debugRelayFuseNoted = false
+
+/** 宿主侧 console 留痕。只记结构化计数与状态码,永不记日志正文(那正是要保护的内容)。 */
+function debugRelayNote(text) {
+  if (typeof console === 'object' && console && typeof console.warn === 'function') console.warn('[mivo-debug-relay] ' + text)
+}
+
+function debugRelayFuseTripped(at) {
+  debugRelayStarts = debugRelayStarts.filter((t) => at - t < DEBUG_RELAY_FUSE_WINDOW_MS)
+  return debugRelayStarts.length >= DEBUG_RELAY_FUSE_MAX
+}
+
+/**
+ * 回执形状(面板侧 debugLogRelay.ts 按此映射,两边必须同步改):
+ *   `{ok:true,  status:<HTTP 状态码>}` —— 拿到了 HTTP 响应(2xx 与否由 status 定)
+ *   `{ok:false}`(无 status)          —— 传输层就没成(cindy.fetch 失败 / 本函数异常)
+ * `ok` **不表示** HTTP 成功。把"消息送达"当 2xx 会让 reporter 删掉其实没落库的批次。
+ */
+function handleDebugLogRelay(msg) {
+  if (completed.has(msg.reqId)) {
+    channel.postMessage(completed.get(msg.reqId))
+    return
+  }
+  // 面板每 800ms 重发同一 reqId 直到收到回执;不去重就会变成一批日志被 POST 几十次。
+  if (debugRelayInflight.has(msg.reqId)) return
+  debugRelayInflight.add(msg.reqId)
+
+  void (async () => {
+    let reply
+    try {
+      const at = clock.now()
+      if (!DEBUG_INGEST_TOKEN) {
+        // fail-closed:零请求、不吃限流额度。回 403 而不是传输错误,是为了让面板侧走
+        // "HTTP 失败"分支 → reporter 退避到重试上限后计入既有 drop 计数(有界、可查),
+        // 不会无限重投。此 403 是本地判定,不是服务端给的,措辞上不假装它来自服务端。
+        // 判定条件是空串(未配置/未注入),与注入来源解耦 —— 见上方
+        // DEBUG_INGEST_TOKEN_FROM_BUILD 注释(2026-08-10 #591 P1 返修)。
+        if (!debugRelayPlaceholderNoted) {
+          debugRelayPlaceholderNoted = true
+          debugRelayNote('ingest token 未配置(发布构建未注入 MIVO_DEBUG_INGEST_TOKEN),已停止回传')
+        }
+        reply = { reqId: msg.reqId, reply: true, ok: true, status: 403 }
+      } else if (debugRelayFuseTripped(at)) {
+        if (!debugRelayFuseNoted) {
+          debugRelayFuseNoted = true
+          debugRelayNote('保险丝触发: 10 分钟窗口内已发起 ' + DEBUG_RELAY_FUSE_MAX + ' 次,本窗口停止回传')
+        }
+        reply = { reqId: msg.reqId, reply: true, ok: true, status: 429 }
+      } else {
+        const payload = msg && typeof msg.payload === 'object' && msg.payload ? msg.payload : null
+        if (!payload) throw new Error('缺少上报载荷')
+        debugRelayStarts.push(at)
+        // coarse backstop:面板侧已脱敏,这里再抹掉三类最常见明文敏感形态
+        // (见 DEBUG_RELAY_COARSE_REDACTORS 注释 —— 刻意不是规则层同构)。
+        const body = debugRelayCoarseRedact(JSON.stringify(payload))
+        const r = await hostFetch({
+          url: DEBUG_RELAY_ENDPOINT,
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            'X-Mivo-Debug-Ingest-Token': DEBUG_INGEST_TOKEN,
+          },
+          body,
+          timeoutMs: DEBUG_RELAY_FETCH_TIMEOUT_MS,
+        })
+        if (r && r.ok === true && Number.isFinite(Number(r.status))) {
+          reply = { reqId: msg.reqId, reply: true, ok: true, status: Number(r.status) }
+        } else {
+          // 宿主 cindy.fetch 自身失败(含域名未放行、超时、凭证注入失败)→ 传输错误。
+          // 不带 status:面板据此 reject,走"等价网络错误"分支。r.message 不出这道门
+          // (宿主自由文本可能回显内容),只记一个不含正文的判定。
+          reply = { reqId: msg.reqId, reply: true, ok: false }
+        }
+      }
+    } catch (error) {
+      // 异常同样只回结构化失败,不把 error.message 带给面板 —— 它可能含载荷片段,
+      // 而面板拿到后会进本地 Debug Log,等于把刚脱敏的内容又漏回去。
+      reply = { reqId: msg.reqId, reply: true, ok: false }
+    }
+    debugRelayInflight.delete(msg.reqId)
+    completed.set(msg.reqId, reply)
+    if (completed.size > 64) completed.delete(completed.keys().next().value)
+    channel.postMessage(reply)
+  })()
+}
+
