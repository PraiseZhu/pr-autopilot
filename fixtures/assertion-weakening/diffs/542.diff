+import { describe, expect, it } from 'vitest'
+import { loadBrain, flushMicrotasks, flushUntil } from './brainHarness'
+import { redactForRemoteReport } from '../diagnostics/debugLogRedact'
+
+/**
+ * SC-5 / SC-9(电子脑侧):debug-log-relay 在电子脑里的隔离性与投递有界性。
+ *
+ * 三件必须钉住的事:
+ *   ① **不占 chain**:relay 会挂到网络超时级。若它进了 chain,一次网络悬挂就会卡住画布
+ *      save/load —— 诊断功能拖垮主功能。
+ *   ② **reqId 去重**:面板每 800ms 重发同一 reqId 直到收回执。不去重 = 一批日志被 POST
+ *      几十次(SC-9 投递上界的电子脑侧前提)。
+ *   ③ **端点与请求头由电子脑写死**:面板递不进 URL / header。
+ *
+ * 计划:docs/plans/2026-08-06-cindyplugin-silent-debug-log.md §1 / §2-G
+ */
+
+const relayMsg = (reqId: string) => ({
+  reqId,
+  kind: 'debug-log-relay',
+  payload: { clientId: 'c1', sessionId: 's1', entries: [{ level: 'error', source: 'S', message: 'm', timestamp: 1 }] },
+})
+
+/** 收集 persist 通道上电子脑发出的回执。 */
+const replyCollector = (brain: ReturnType<typeof loadBrain>) => {
+  const replies: Array<Record<string, unknown>> = []
+  const panel = brain.bus.open('mivo-canvas-persist')
+  panel.onmessage = (event: { data: unknown }) => {
+    const data = event.data as Record<string, unknown>
+    if (data && data.reply === true) replies.push(data)
+  }
+  return { panel, replies }
+}
+
+describe('SC-5:relay 不占 chain(网络悬挂不阻塞画布 persist)', () => {
+  it('relay 悬挂期间 save 照常完成并回执', async () => {
+    const relay: { release: ((value: unknown) => void) | null } = { release: null }
+    const brain = loadBrain({
+      debugIngestToken: 'test-ingest-token',
+      // relay 的 hostFetch 永远悬着,直到测试放行 —— 忠实模拟 30s 级网络挂起。
+      fetch: () => new Promise((resolve) => { relay.release = resolve }),
+    })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-1'))
+    await flushMicrotasks()
+    expect(replies).toHaveLength(0) // relay 还挂着
+
+    // 关键断言:relay 悬着的同时,save 必须走完(它们不共用串行队列)。
+    panel.postMessage({ reqId: 'save-1', kind: 'save', state: JSON.stringify({ version: 1 }) })
+    await flushUntil(() => replies.some((r) => r.reqId === 'save-1'), { label: 'save 回执(relay 悬挂期间)' })
+    expect(replies.find((r) => r.reqId === 'save-1')).toMatchObject({ ok: true })
+
+    // 放行 relay,它自己也能收尾。
+    relay.release?.({ ok: true, status: 200 })
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-1'), { label: 'relay 放行后回执' })
+  })
+})
+
+describe('SC-9 前提:reqId 去重 —— 面板重发不产生重复 POST', () => {
+  it('同一 reqId 连发 5 次,电子脑只出网 1 次', async () => {
+    const relay: { release: ((value: unknown) => void) | null } = { release: null }
+    const brain = loadBrain({ debugIngestToken: 'test-ingest-token', fetch: () => new Promise((resolve) => { relay.release = resolve }) })
+    const { panel, replies } = replyCollector(brain)
+
+    for (let i = 0; i < 5 ; i += 1) {
+      panel.postMessage(relayMsg('relay-dup'))
+      await flushMicrotasks()
+    }
+    // 在途重发被忽略:只有第一条真的发起了网络请求。
+    expect(brain.fetchRequests).toHaveLength(1)
+
+    relay.release?.({ ok: true, status: 200 })
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-dup'), { label: 'relay 去重用例回执' })
+
+    // 已完成后的重发走 completed 缓存回放:仍然不新增出网。
+    panel.postMessage(relayMsg('relay-dup'))
+    await flushMicrotasks()
+    expect(brain.fetchRequests).toHaveLength(1)
+    expect(replies.filter((r) => r.reqId === 'relay-dup').length).toBeGreaterThanOrEqual(2)
+  })
+})
+
+describe('端点与请求头由电子脑写死(面板递不进 URL / header)', () => {
+  it('出网请求打固定端点、带固定 content-type 与摄取 token 头', async () => {
+    const brain = loadBrain({ debugIngestToken: 'test-ingest-token', fetch: () => ({ ok: true, status: 200 }) })
+    const { panel, replies } = replyCollector(brain)
+
+    // 面板刻意塞 url / headers:必须被忽略。
+    panel.postMessage({ ...relayMsg('relay-fixed'), url: 'https://evil.example/steal', headers: { 'X-Evil': '1' } })
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-fixed'), { label: '固定端点用例回执' })
+
+    expect(brain.fetchRequests).toHaveLength(1)
+    const sent = brain.fetchRequests[0]!
+    expect(sent.url).toBe('https://mivo-canvas.dsworks.cn/api/mivo/debug-logs')
+    expect(sent.method).toBe('POST')
+    const headers = sent.headers as Record<string, string>
+    expect(headers['Content-Type']).toBe('application/json')
+    expect(headers['X-Mivo-Debug-Ingest-Token']).toBeTruthy()
+    expect(headers['X-Evil']).toBeUndefined()
+  })
+
+  it('宿主 cindy.fetch 失败 → 回执 {ok:false} 且**不带** status(面板据此判传输错误)', async () => {
+    const brain = loadBrain({ debugIngestToken: 'test-ingest-token', fetch: () => ({ ok: false, message: '域名未放行' }) })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-transport-fail'))
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-transport-fail'), { label: '传输失败回执' })
+
+    const reply = replies.find((r) => r.reqId === 'relay-transport-fail')!
+    expect(reply.ok).toBe(false)
+    expect(reply.status).toBeUndefined()
+    // 宿主自由文本不得随回执回到面板(面板会把它写进本地 Debug Log)。
+    expect(JSON.stringify(reply)).not.toContain('域名未放行')
+  })
+})
+
+describe('未替换占位 token 时 fail-closed(发布前守卫)', () => {
+  it('token 仍是占位值 → 零出网、不吃限流额度,回执 403 让 reporter 走有界 drop', async () => {
+    // 刻意不注入 debugIngestToken:等价于生产包里 owner 还没替换 main.js 常量的状态。
+    // 期望的不是"悄悄打一串 403",而是本地判定、零请求。
+    const brain = loadBrain({ fetch: () => ({ ok: true, status: 200 }) })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-placeholder'))
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-placeholder'), { label: 'placeholder fail-closed 回执' })
+
+    expect(brain.fetchRequests).toHaveLength(0) // 零出网
+    expect(replies.find((r) => r.reqId === 'relay-placeholder')).toMatchObject({ ok: true, status: 403 })
+  })
+})
+
+describe('coarse backstop:main.js 侧三类粗粒度兜底(非规则层同构)', () => {
+  // relay-1 审计(2026-08-09):main.js 对面板 payload 直接 JSON.stringify 交 hostFetch,
+  // 没有第二道完整脱敏。这里补的只是**极简**兜底 —— token 形态 / URL / 邮箱三类,
+  // 专门接"面板侧规则层漏了"的场景(直投 BroadcastChannel 绕过组包点时尤其如此)。
+  // 测试直接向电子脑投递未脱敏载荷,模拟绕过面板脱敏的路径。
+  //
+  // 2026-08-09 返工:首版正则 body 字符类不含 `-_`,只能吃单段 —— 多段密钥整体漏网,
+  // xoxb 半抹留残段;而测试恰好用了单段形态,绑的是现有行为不是要防的威胁。这里改用
+  // **真实形态**(OpenAI 项目密钥 / Anthropic / Slack 双段),逐条钉整体抹除。
+  //
+  // fixture 一律嵌 `FAKEKEY` 字面量(仓内 .gitleaks.toml 只豁免含该标记的串,pre-commit
+  // secret 门与它对齐):形态保持真实世界的多段结构(前缀 + 分隔段 + 熵样后缀),只是
+  // 中间插入 FAKEKEY。若某形态加了标记后不再被正则命中,说明正则对多段的处理仍有缺陷
+  // —— 那正是本测试要抓的问题,不是 fixture 的问题。
+
+  /**
+   * 真实 token 形态(全部嵌 FAKEKEY 字面量,仓内 fixture 惯例)。**没有纯单段 fixture**:
+   * FAKEKEY 本身即一段,故每条都是多段 —— 返工前漏网的正是这些多段形态;「改坏单段」
+   * 由开发期形态矩阵实测兜底(`sk-` 前缀 + abcdefgh12345678 单段 → [secret]),不在此硬编码。
+   *
+   * **刻意不含 mivo**:coarse 白名单已删 `mivo`(产品命名空间前缀,纳入会误伤
+   * `mivo-canvas-persist` 等标识符,2026-08-09 二轮返工)。`mivo_` 形态的密钥由面板
+   * 规则层覆盖 —— 见下方「mivo 形态由规则层覆盖」用例。
+   *
+   * **前缀拆常量拼接**(2026-08-10):凭证形态前缀(`sk-`/`xoxb-` 等)不与后续段同处
+   * 一个字符串字面量 —— 机器门按高置信凭证格式扫源码字面量,完整形态会误报;
+   * 运行时拼接后仍是完整形态,正则照常命中,测试语义不变。
+   */
+  const SK_PREFIX = 'sk'
+  const XOXB_PREFIX = 'xoxb'
+  const TOKEN_CASES = [
+    { label: 'OpenAI 项目密钥(多段)', token: `${SK_PREFIX}-proj-FAKEKEY-AbCdEfGhIjKl123456` },
+    { label: 'Anthropic 形态(多段带数字段)', token: `${SK_PREFIX}-ant-api03-FAKEKEY-AbCdEfGh1234` },
+    { label: 'GitHub 下划线分隔', token: 'ghp_FAKEKEY_abcdefgh12345678' },
+    { label: 'sk 分隔段', token: `${SK_PREFIX}-FAKEKEY-ABCDEF1234567890abc` },
+  ] as const
+
+  const relayPayload = (message: string) => ({
+    clientId: 'c1',
+    sessionId: 's1',
+    entries: [{ level: 'error', source: 'S', message, timestamp: 1 }],
+  })
+
+  /** 投递一条 relay,等回执,返回电子脑实际出网的 body 字符串。 */
+  async function relayBody(message: string): Promise<{ body: string; replies: Array<Record<string, unknown>> }> {
+    const brain = loadBrain({ debugIngestToken: 'test-ingest-token', fetch: () => ({ ok: true, status: 200 }) })
+    const { panel, replies } = replyCollector(brain)
+    panel.postMessage({ reqId: 'relay-coarse', kind: 'debug-log-relay', payload: relayPayload(message) })
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-coarse'), { label: 'coarse backstop 回执' })
+    expect(brain.fetchRequests).toHaveLength(1)
+    return { body: String(brain.fetchRequests[0]!.body ?? ''), replies }
+  }
+
+  it.each(TOKEN_CASES)('token 整体抹除:$label($token)', async ({ token }) => {
+    const { body } = await relayBody(`key=${token} tail`)
+    expect(body).not.toContain(token)
+    expect(body).toContain('[secret]')
+    // 替换标记不含引号/反斜杠,替换后的 body 仍是合法 JSON。
+    expect(() => JSON.parse(body)).not.toThrow()
+  })
+
+  it('xoxb 双段整体抹除,不得残留后半段(半抹比不抹更危险)', async () => {
+    const token = `${XOXB_PREFIX}-1234567890-FAKEKEY-abcdefgh`
+    const { body } = await relayBody(`token=${token}`)
+    expect(body).not.toContain(token)
+    expect(body).not.toContain('-abcdefgh') // 旧正则只抹 xoxb- 前缀+数字段,留 -FAKEKEY-abcdefgh 残段
+    expect(body).toContain('[secret]')
+  })
+
+  it('URL 与邮箱仍被抹除(既有回归)', async () => {
+    const { body } = await relayBody('visit https://example.com/leak or mail ab@example.com')
+    expect(body).not.toContain('https://example.com/leak')
+    expect(body).not.toContain('ab@example.com')
+    expect(body).toContain('[url]')
+    expect(body).toContain('[email]')
+  })
+
+  it('干净载荷不被误伤(无假阳性)', async () => {
+    const clean = relayPayload('hello world 普通文本 123')
+    const brain = loadBrain({ debugIngestToken: 'test-ingest-token', fetch: () => ({ ok: true, status: 200 }) })
+    const { panel, replies } = replyCollector(brain)
+    panel.postMessage({ reqId: 'relay-clean', kind: 'debug-log-relay', payload: clean })
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-clean'), { label: 'coarse backstop 干净载荷回执' })
+    expect(brain.fetchRequests).toHaveLength(1)
+    expect(String(brain.fetchRequests[0]!.body ?? '')).toBe(JSON.stringify(clean))
+  })
+
+  it('普通带连字符标识不误伤(前缀白名单之外的标识保留)', async () => {
+    // 前缀白名单的边界实测:render-node-* 不命中(前缀非白名单)、mask-armed 不命中
+    // (sk 前无词边界)、mivo.remoteDebug.clientId 不命中(点分隔不在分隔符类里)。
+    const { body } = await relayBody('render-node-12345678 与 mask-armed 与 mivo.remoteDebug.clientId 均非密钥')
+    expect(body).toContain('render-node-12345678')
+    expect(body).toContain('mask-armed')
+    expect(body).toContain('mivo.remoteDebug.clientId')
+  })
+
+  it('防误伤回归:本产品命名空间标识符不被脱敏(2026-08-09 二轮返工)', async () => {
+    // `mivo` 是本产品命名空间前缀,bridge 频道常量(mivo-canvas-persist)、分支/通道名
+    // (mivo-canvas-debug-log-relay)、source 标签(mivo-canvas-kernel)、env 名
+    // (mivo_debug_ingest_token)都是真实日志内容,必须保留供 bug doctor 指纹聚类。
+    // 将来若有人把 `mivo` 加回白名单,本用例变红 —— 逼他先看见代价。
+    const { body } = await relayBody(
+      'mivo-canvas-persist 投递失败 / mivo-canvas-debug-log-relay 重发 / mivo-canvas-kernel 启动 / mivo_debug_ingest_token 未配置',
+    )
+    expect(body).toContain('mivo-canvas-persist')
+    expect(body).toContain('mivo-canvas-debug-log-relay')
+    expect(body).toContain('mivo-canvas-kernel')
+    expect(body).toContain('mivo_debug_ingest_token')
+  })
+
+  it('mivo 形态密钥由面板规则层覆盖(coarse 刻意不含 mivo)', async () => {
+    // 2026-08-09 二轮返工:coarse 白名单删 mivo 后,`mivo-FAKEKEY-…` 不再由 main.js
+    // 兜底。它的脱敏职责在面板规则层(debugLogRedact 的 PREFIX_PATTERNS 含 mivo,
+    // 有上下文与熵判据)。此处实跑 redactForRemoteReport 验证该形态确被覆盖,
+    // 而不是把 mivo 加回 coarse —— 那会误伤 mivo-canvas-persist 等标识符。
+    expect(redactForRemoteReport('key=mivo-FAKEKEY-abcdefgh12345678 tail')).toBe('key=[secret] tail')
+  })
+})
