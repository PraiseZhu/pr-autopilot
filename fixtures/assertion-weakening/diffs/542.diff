@@ -0,0 +1,114 @@
+/**
+ * relay-1 审计修复的机器守卫(#542 双审裁定):`persistRequest('debug-log-relay', …)`
+ * 的出网调用点必须是**唯一一处**,且只能在 `cindyplugin/src/diagnostics/debugLogRelay.ts` 内。
+ *
+ * 背景:debugLogRedact.ts 头注原本声称 main.js 里还有一道"刻意同构的实现"兜底,
+ * 但 main.js 实际对面板 payload 直接 `JSON.stringify` 后交 `hostFetch` —— 第二道
+ * 不存在。脱敏的真正唯一收口在面板侧组包点 `buildRemoteDebugPayload`
+ * (src/store/remoteDebugClientInfo.ts)。本测试就是原注释想要但没做到的「会喊的
+ * 机制」:新增第二个出网调用点 = 新增绕过脱敏的路径,在这里变红,而不是靠自觉。
+ *
+ * 本文件自身是扫描的豁免项(它必须包含这条字符串才能断言它)。
+ */
+import { describe, expect, it } from 'vitest'
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+import { dirname, join, relative } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const THIS_FILE = fileURLToPath(import.meta.url)
+const REPO_ROOT = join(dirname(THIS_FILE), '..', '..', '..')
+
+/** 扫描面:面板侧 + 主仓侧全部 TS/TSX(不含测试文件本身)。 */
+const SCAN_DIRS = ['cindyplugin/src', 'src']
+
+/** `persistRequest('debug-log-relay', …)` 字面调用(首参必须是指定 kind)。 */
+const CALL_RE = /persistRequest\(\s*['"]debug-log-relay['"]/
+
+const EXPECTED_SITE = 'cindyplugin/src/diagnostics/debugLogRelay.ts'
+
+/** 递归列出 rel 目录下所有 .ts/.tsx 文件(相对 repo root,`/` 分隔)。 */
+function listTsFiles(relDir: string): string[] {
+  const abs = join(REPO_ROOT, relDir)
+  const out: string[] = []
+  for (const entry of readdirSync(abs)) {
+    const rel = `${relDir}/${entry}`
+    const full = join(abs, entry)
+    if (statSync(full).isDirectory()) out.push(...listTsFiles(rel))
+    else if (/\.tsx?$/.test(entry)) out.push(rel)
+  }
+  return out
+}
+
+/**
+ * 去注释(保持行数),只留代码。注释里引用调用形态不算调用点 —— debugLogRedact.ts
+ * 头注、其它说明文字提到 `persistRequest('debug-log-relay', …)` 是正常的文档行为,
+ * 不该让守卫变红。
+ *
+ * 不感知字符串字面量:行内字符串里的 `//`(如 URL)只可能出现在调用之后,不影响
+ * 对 `persistRequest('debug-log-relay'` 前缀的匹配。
+ */
+function stripComments(src: string): string {
+  const out: string[] = []
+  let inBlock = false
+  for (const line of src.split('\n')) {
+    let s = line
+    if (inBlock) {
+      const end = s.indexOf('*/')
+      if (end === -1) {
+        out.push('')
+        continue
+      }
+      s = s.slice(end + 2)
+      inBlock = false
+    }
+    for (;;) {
+      const lineIdx = s.indexOf('//')
+      const blockIdx = s.indexOf('/*')
+      if (blockIdx !== -1 && (lineIdx === -1 || blockIdx < lineIdx)) {
+        const end = s.indexOf('*/', blockIdx + 2)
+        if (end === -1) {
+          s = s.slice(0, blockIdx)
+          inBlock = true
+          break
+        }
+        s = s.slice(0, blockIdx) + s.slice(end + 2)
+        continue
+      }
+      if (lineIdx !== -1) s = s.slice(0, lineIdx)
+      break
+    }
+    out.push(s)
+  }
+  return out.join('\n')
+}
+
+function findCallSites(): Array<{ file: string; line: number }> {
+  const sites: Array<{ file: string; line: number }> = []
+  for (const dir of SCAN_DIRS) {
+    for (const rel of listTsFiles(dir)) {
+      if (rel === relative(REPO_ROOT, THIS_FILE)) continue // 豁免守卫自身
+      const lines = stripComments(readFileSync(join(REPO_ROOT, rel), 'utf8')).split('\n')
+      lines.forEach((line, index) => {
+        if (CALL_RE.test(line)) sites.push({ file: rel, line: index + 1 })
+      })
+    }
+  }
+  return sites
+}
+
+describe('机器守卫:persistRequest("debug-log-relay") 唯一调用点', () => {
+  it('全仓(cindyplugin/src/** + src/**)恰好一处,且在 debugLogRelay.ts 内', () => {
+    const sites = findCallSites()
+    const list = sites.map((s) => `${s.file}:${s.line}`).join('、') || '(无)'
+    const message =
+      `persistRequest('debug-log-relay', …) 的出网调用点必须是唯一一处,现状 ${sites.length} 处:${list}。\n` +
+      `debug-log-relay 是 debug log 离开面板的唯一出网通道:新增调用点 = 新增绕过脱敏的路径,\n` +
+      `日志将原样出网。任何新增的出网调用点都必须经由 buildRemoteDebugPayload 组包以完成脱敏\n` +
+      `(组包点在 src/store/remoteDebugClientInfo.ts,对每条 entry 统一过 redactForRemoteReport),\n` +
+      `再走既有 relay transport;不要直接调 persistRequest('debug-log-relay', …)。\n` +
+      `唯一合法调用点:${EXPECTED_SITE}。若新增的是测试,请改用 debugLogRelay.ts 的\n` +
+      `__setDebugLogRelayTestSeam,不要直接调 persistRequest。`
+    expect(sites, message).toHaveLength(1)
+    expect(sites[0]!.file, message).toBe(EXPECTED_SITE)
+  })
+})
