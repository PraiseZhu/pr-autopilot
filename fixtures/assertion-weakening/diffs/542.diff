@@ -0,0 +1,57 @@
+import { describe, it, expect } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import pluginViteConfig, { resolvePluginAppVersion } from '../../vite.config'
+
+/**
+ * SC-0c:插件正式构建的 `VITE_MIVO_VERSION`(= 上报 payload 的 `appVersion`)必须等于
+ * `cindyplugin/ghost.json` 的 `version`,dev 构建才保留 `cindy-plugin-dev`。
+ *
+ * 为什么值得一道机器锁:这个值是插件日志在服务端 debug-records 里的唯一版本主键。
+ * 回归形态非常安静 —— 有人把 define 改回硬编码字符串,构建照样成功、面板照样能跑、
+ * 日志照样能上报,只是所有正式包的记录全部聚合成 "dev" 一个桶,"哪个版本引入的"
+ * 从此问不出来。除了这条断言,没有任何东西会在 CI 里喊出来。
+ *
+ * 测试**独立重读** ghost.json(不复用被测代码的返回值当期望值),否则会退化成
+ * "自己等于自己" 的空断言。
+ */
+
+const ghostVersion = (): string => {
+  const ghostPath = fileURLToPath(new URL('../../ghost.json', import.meta.url))
+  const parsed = JSON.parse(readFileSync(ghostPath, 'utf8')) as { version?: unknown }
+  return String(parsed.version ?? '')
+}
+
+// vite 的 defineConfig 对函数式配置是恒等返回,所以 default export 就是那个工厂函数。
+type ConfigFactory = (env: { command: 'build' | 'serve'; mode: string }) => {
+  define?: Record<string, string>
+}
+
+const defineFor = (command: 'build' | 'serve'): Record<string, string> => {
+  const factory = pluginViteConfig as unknown as ConfigFactory
+  return factory({ command, mode: command === 'build' ? 'production' : 'development' }).define ?? {}
+}
+
+describe('SC-0c:插件 appVersion 注入', () => {
+  it('正式构建(command=build)注入 ghost.json 的 version', () => {
+    const expected = ghostVersion()
+    // 前置合理性:ghost.json 的 version 本身必须是非空且不是 dev 占位,
+    // 否则下面两条断言会在一个坏基线上"通过"。
+    expect(expected).toMatch(/^\d+\.\d+\.\d+/)
+    expect(resolvePluginAppVersion('build')).toBe(expected)
+  })
+
+  it('正式构建绝不是 cindy-plugin-dev(这正是本次要修的回归)', () => {
+    expect(resolvePluginAppVersion('build')).not.toBe('cindy-plugin-dev')
+  })
+
+  it('dev 构建(command=serve)保留 cindy-plugin-dev 标识', () => {
+    expect(resolvePluginAppVersion('serve')).toBe('cindy-plugin-dev')
+  })
+
+  it('vite config 的 define 真的把该值接到 import.meta.env.VITE_MIVO_VERSION 上', () => {
+    // 只断言 resolvePluginAppVersion 不够 —— 它可能算对了却没被 define 消费。
+    expect(defineFor('build')['import.meta.env.VITE_MIVO_VERSION']).toBe(JSON.stringify(ghostVersion()))
+    expect(defineFor('serve')['import.meta.env.VITE_MIVO_VERSION']).toBe(JSON.stringify('cindy-plugin-dev'))
+  })
+})
diff --git a/src/diagnostics/debugLogRelay.ts b/src/diagnostics/debugLogRelay.ts
new file mode 100644
index 00000000..64de3620
--- /dev/null
+++ b/src/diagnostics/debugLogRelay.ts
@@ -0,0 +1,148 @@
+/**
+ * 面板侧 debug log 回传 transport(v3)。
+ *
+ * 面板跑在 `cindy-ghost://<id>/` 下,没有任何可用的出网出口:相对路径 `/api/mivo/...`
+ * 打不到 BFF,而宿主对 Origin **双向封死**(插件传入的 origin 被 STRIPPED_REQUEST_HEADERS
+ * 静默丢弃,secret inject 侧的 GHOST_NETWORK_FORBIDDEN_INJECT_HEADERS 同样含 origin)。
+ * 所以出网只能经电子脑 `cindy.fetch` 代发,本模块就是那条通道的面板端。
+ *
+ * 刻意不发明第二套桥:请求走**既有** `persistRequest`(BroadcastChannel + `/wake` 唤醒 +
+ * reqId 去重 + 800ms 重发 + 超时),只是多一个 kind。
+ *
+ * ── 两条硬约束(违反任一即为功能失败)──
+ * 1. **绝对零 UI**:本文件任何路径都不得产生用户可见反馈 —— 不调 toastFeedback、不调
+ *    cindy.notify、不新增视觉元素。
+ * 2. **不回流 debugLogger**:relay 自身的失败绝不能记成 warn/error。面板装了
+ *    consoleCapture,`console.warn/error` 会被改写成 `debugLogger.warn/error` → 再次
+ *    进上报队列 → 失败 → 又记一条…… 死循环。所以本文件**连 console 都不用**,可观测面
+ *    只有下面的内部计数器(main.js 侧另有 console 留痕,那边不回流面板)。
+ *
+ * 完整设计:docs/plans/2026-08-06-cindyplugin-silent-debug-log.md §1/§2-F/§2-G
+ */
+
+import { persistRequest, type PersistReply } from '../persist/bridge'
+import type { RemoteDebugPayload } from '../../../src/store/remoteDebugReporter'
+import type { RemoteDebugTransport, RemoteDebugTransportResult } from '../../../src/store/remoteDebugTransport'
+import { redactForRemoteReport } from './debugLogRedact'
+
+/** 单次 relay 的桥超时。与 §2-G "悬挂 30s 不阻塞画布" 的场景值一致。 */
+const RELAY_TIMEOUT_MS = 30_000
+/** 重发间隔:沿用 persistRequest 默认值,显式写出以示这是协议的一部分。 */
+const RELAY_RETRY_MS = 800
+
+/**
+ * 保险丝(§2-G):滑动 10 分钟窗口内最多发起 30 次 relay。
+ *
+ * 为什么按"发起次数"而不是"失败次数":风暴的成本在于**发出去的请求**本身
+ * (BC 消息 + 宿主出网 + 服务端限流额度),成功的风暴一样要封顶。
+ *
+ * 身份键是"本面板":本模块是面板上下文里的模块级单例,每个面板各有一份,天然等价于
+ * 按面板 sessionId 分桶,不需要再造一个 id。
+ */
+const FUSE_WINDOW_MS = 10 * 60_000
+const FUSE_MAX_STARTS = 30
+
+/** relay 发起时刻的滑动窗(升序;只保留窗内的)。 */
+let startedAt: number[] = []
+
+type RelayStats = {
+  /** 真正发起过的 relay 次数(不含被保险丝短路的)。 */
+  started: number
+  /** 被保险丝短路、连 BC 消息都没发的次数。 */
+  fuseBlocked: number
+  /** 最近一次映射结果(便于测试与真机自检;不含任何日志正文)。 */
+  lastOutcome: 'none' | '2xx' | 'http-error' | 'transport-error' | 'fuse'
+}
+
+const stats: RelayStats = { started: 0, fuseBlocked: 0, lastOutcome: 'none' }
+
+/** 只读快照。零 UI 约束下这是面板侧唯一的可观测面。 */
+export const getDebugLogRelayStats = (): RelayStats => ({ ...stats })
+
+// ── 测试 seam(生产零副作用)────────────────────────────────────────────────
+// 协议测试要能在不起真实 BroadcastChannel / 不等真实 30s 的前提下钉住映射表。
+type RelaySeam = {
+  request?: (kind: 'debug-log-relay', payload: Record<string, unknown>, options: { retryMs: number; timeoutMs: number }) => Promise<PersistReply>
+  now?: () => number
+}
+let seam: RelaySeam | null = null
+export const __setDebugLogRelayTestSeam = (next: RelaySeam | null): void => {
+  seam = next
+  startedAt = []
+  stats.started = 0
+  stats.fuseBlocked = 0
+  stats.lastOutcome = 'none'
+}
+
+const now = (): number => (seam?.now ? seam.now() : Date.now())
+const sendRequest = (payload: Record<string, unknown>): Promise<PersistReply> =>
+  seam?.request
+    ? seam.request('debug-log-relay', payload, { retryMs: RELAY_RETRY_MS, timeoutMs: RELAY_TIMEOUT_MS })
+    : persistRequest('debug-log-relay', payload, { retryMs: RELAY_RETRY_MS, timeoutMs: RELAY_TIMEOUT_MS })
+
+/**
+ * 脱敏收口(§2-D):这是日志离开面板的**最后一站**,所有 entry 的 message / stack 在此
+ * 统一过一遍 redactForRemoteReport。放在这里而不是各调用点的理由见 debugLogRedact.ts 头注。
+ * clientInfo 里的 pagePath / userAgent 等是设备元数据,不属"敏感三类",原样保留。
+ */
+const redactPayload = (payload: RemoteDebugPayload): RemoteDebugPayload => ({
+  ...payload,
+  entries: payload.entries.map((entry) => {
+    const next = { ...entry, message: redactForRemoteReport(entry.message) }
+    if (typeof next.stack === 'string') next.stack = redactForRemoteReport(next.stack)
+    return next
+  }),
+})
+
+/** 窗口滑动 + 是否已达上限。有副作用(剔除窗外记录),调用点只在 transport 入口。 */
+const fuseTripped = (nowMs: number): boolean => {
+  startedAt = startedAt.filter((at) => nowMs - at < FUSE_WINDOW_MS)
+  return startedAt.length >= FUSE_MAX_STARTS
+}
+
+/**
+ * relay transport。映射表(计划 §1,逐行有测试):
+ *
+ * | relay 现场                                   | 返回                          |
+ * |---------------------------------------------|-------------------------------|
+ * | HTTP 2xx                                     | resolve `{ok:true, status}`   |
+ * | HTTP 非 2xx(403/413/429/5xx…)              | resolve `{ok:false, status}`  |
+ * | 宿主回包 `{ok:false}`(cindy.fetch 自身失败) | **reject**                    |
+ * | 桥超时 / ghost 唤不醒 / 回包形状非法          | **reject**                    |
+ * | 保险丝已触发                                  | 短路 resolve `{ok:false,429}` |
+ *
+ * 保险丝短路时**不发 BC 消息、不打网络**(SC-4 的"零新请求"指这个)。返回 429 而不是
+ * 假装成功,是为了让 reporter 走它自己的退避与 drop 计数终态 —— 被丢弃的条目仍然可查,
+ * 不会被伪造成"已送达"而被删掉。
+ */
+export const debugLogRelayTransport: RemoteDebugTransport = async (payload): Promise<RemoteDebugTransportResult> => {
+  const at = now()
+  if (fuseTripped(at)) {
+    stats.fuseBlocked += 1
+    stats.lastOutcome = 'fuse'
+    // 429 = "本窗口内我方主动限速",语义上与服务端限流同类,reporter 按普通失败退避。
+    return { ok: false, status: 429 }
+  }
+  startedAt.push(at)
+  stats.started += 1
+
+  // 面板只递 payload,**不传 URL / header** —— 端点与请求头在电子脑侧写死(计划 §1-2),
+  // 面板拿不到也改不了。这样即使面板侧被注入,也没法让 relay 打别的地址。
+  const reply = await sendRequest({ payload: redactPayload(payload) })
+
+  // 桥层超时(persistRequest 合成的回执)与宿主传输失败合并成"传输错误"= reject。
+  if (!reply || reply.ok !== true) {
+    stats.lastOutcome = 'transport-error'
+    throw new Error(reply?.timeout ? 'debug-log relay timeout' : 'debug-log relay transport failure')
+  }
+  const status = Number(reply.status)
+  if (!Number.isFinite(status) || status <= 0) {
+    // 回包说 ok 却没给合法 status:协议对不上,按传输错误处理。绝不能把"消息送达"
+    // 当成 HTTP 成功 —— 那会让 reporter 删掉一批其实没落库的日志。
+    stats.lastOutcome = 'transport-error'
+    throw new Error('debug-log relay malformed reply (missing status)')
+  }
+  const ok = status >= 200 && status < 300
+  stats.lastOutcome = ok ? '2xx' : 'http-error'
+  return { ok, status }
+}
