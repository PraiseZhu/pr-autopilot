+  debugLogRelayTransport,
+  getDebugLogRelayStats,
+} from '../diagnostics/debugLogRelay'
+import { redactForRemoteReport } from '../diagnostics/debugLogRedact'
+import type { PersistReply } from '../persist/bridge'
+import type { RemoteDebugPayload } from '../../../src/store/remoteDebugReporter'
+
+// SC-1 / SC-4 / SC-8:面板侧 relay transport 的状态映射表、保险丝短路、上报出口脱敏。
+// 计划:docs/plans/2026-08-06-cindyplugin-silent-debug-log.md §1 / §2-D / §2-G
+
+const payloadWith = (message: string, stack?: string): RemoteDebugPayload => ({
+  clientId: 'c1',
+  sessionId: 's1',
+  appVersion: '0.9.24',
+  pagePath: '/panel.html',
+  userAgent: 'Test',
+  language: 'zh-CN',
+  timezone: 'UTC',
+  screen: { width: 100, height: 100, pixelRatio: 1 },
+  entries: [{ level: 'error', source: 'Console', message, timestamp: 1, ...(stack ? { stack } : {}) }],
+})
+
+const basePayload = payloadWith('boom')
+
+type SeamCall = { kind: string; payload: Record<string, unknown>; options: { retryMs: number; timeoutMs: number } }
+
+/** 装一个可编程的桥:记录每次调用,并按给定回执应答。 */
+const installSeam = (reply: (call: SeamCall) => PersistReply | Promise<PersistReply>, nowRef?: { at: number }) => {
+  const calls: SeamCall[] = []
+  __setDebugLogRelayTestSeam({
+    request: async (kind, payload, options) => {
+      const call = { kind, payload, options }
+      calls.push(call)
+      return reply(call)
+    },
+    ...(nowRef ? { now: () => nowRef.at } : {}),
+  })
+  return calls
+}
+
+const okReply = (status: number): PersistReply => ({ reqId: 'r', reply: true, ok: true, status })
+
+describe('SC-1:relay transport 状态映射表(逐行)', () => {
+  afterEach(() => __setDebugLogRelayTestSeam(null))
+
+  it('HTTP 2xx → resolve {ok:true,status}', async () => {
+    installSeam(() => okReply(200))
