+  it('中文宿主自由文本(混 ASCII 标点)也必须被指纹化 —— ASCII 标点不得切断判定', async () => {
+    // 第一版实现按"连续字符长度"判定,被 ASCII 逗号切成 3 段全部低于阈值 → 整句通过。
+    // 这条用例就是钉住那个漏洞:同样的输入必须整段变成指纹。
+    const hostText = '请求的资产无法解析,因为所属工作区已于上周归档,请联系管理员恢复后重试'
+    const out = await relayed(`relay rejected: ${hostText}`)
+    expect(out).not.toContain(hostText)
+    for (const fragment of ['无法解析', '所属工作区', '联系管理员']) {
+      expect(out).not.toContain(fragment)
