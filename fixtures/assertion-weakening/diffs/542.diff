+    await expect(debugLogRelayTransport(basePayload)).rejects.toThrow(/transport failure/)
+    expect(getDebugLogRelayStats().lastOutcome).toBe('transport-error')
+  })
+
+  it('桥超时回执(timeout:true)→ reject', async () => {
