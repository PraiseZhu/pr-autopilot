+import { describe, expect, it } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { loadBrain, flushUntil } from './brainHarness'
+
+/**
+ * #591 P1 返修的机器锁:debug-log-relay 的摄取 token 必须走**真实发布构建路径**注入,
+ * 而不是只经 `globalThis.__mivoBrainSeam`(seam 只在协议测试里存在,生产没有 ——
+ * 旧的 Brain 测试全走 seam,绿灯证明不了发布路径可用)。
+ *
+ * 缺陷回顾(审查者 zhongxingtai-ai P1):旧实现把「占位常量」与「被替换行」当成同一行,
+ * 守卫 `DEBUG_INGEST_TOKEN === DEBUG_INGEST_TOKEN_PLACEHOLDER` 与被替换行自比较。
+ * 生产没有 seam → token 恒等于占位值;而「发布前替换那一行」会同时改掉比较的两边,
+ * 等式永远成立 → 正式包永久零出网(relay 全被守卫拦下,日志静默不流失)。
+ *
+ * 修复后:注入点(`DEBUG_INGEST_TOKEN_FROM_BUILD`)与「未配置」判定(空串)解耦,
+ * `cindyplugin/build.sh` 从 `MIVO_DEBUG_INGEST_TOKEN` 把真实值注入 dist 副本。
+ *
+ * 本测试 3 条用例**复刻 build.sh 的注入语义**(在源码副本上替换注入点行),把注入后的
+ * 源码当成要发布的那份求值 —— 与既有 brainHarness 同一求值路径(`options.source`),
+ * 不是 seam 特供的副本。这锁的是「注入点判定逻辑」本身。
+ *
+ * 「build.sh 注入块本身被锁住」这条保障不在单测里:真实执行 build.sh 会触发完整
+ * vite build(>5000ms 单条超时,execFileSync 堵事件循环让超时定时器失效,是巧合
+ * 不是设计),且会污染 dist。它由 CI 的 `cindyplugin build` job 承担 —— 该 job
+ * 本来就跑 build.sh,注入断言加在构建之后(见 .github/workflows/ci.yml 同 job)。
+ */
+
+const MAIN_JS_PATH = fileURLToPath(new URL('../../main.js', import.meta.url))
+
+/** build.sh 注入点的锚定行(与 cindyplugin/build.sh 的 perl 替换同一目标)。 */
+const INJECT_ANCHOR_RE = /^const DEBUG_INGEST_TOKEN_FROM_BUILD = .*$/m
+
+/**
+ * 在源码副本上执行与 build.sh **同一编码**的注入:把注入点行替换成
+ * `DEBUG_INGEST_TOKEN_FROM_BUILD = <token 的 JS 字面量>`。
+ *
+ * build.sh 与这里一样用 node `JSON.stringify`(双引号字面量)注入 —— 对任意 token
+ * 字符(引号/反斜杠/换行)都产出解析回原值的 JS 字面量,不是"语义等价"而是逐字同构。
+ * 曾用 perl 的 `\Q…\E`(单引号字面量):它把换行转成 `\`+换行(JS 行继续符),语法合法
+ * 但值被静默改写(abc\ndef → abcdef),而测试用 JSON 编码同一输入仍绿 —— 锁不住真实
+ * 构建故障(审查者 greptile 指出,2026-08-10 已改为与测试同一编码)。
+ *
+ * **用函数替换器而非字符串替换串**(2026-08-10 greptile P1):`replace(regex, str)`
+ * 的字符串替换串会把 `$&` / `` $` `` / `$'` 等序列当模板展开,含这些序列的 token
+ * 会被静默改写;函数替换器 `() => line` 逐字返回,不做任何模板展开。
+ */
+function injectToken(source: string, token: string): string {
+  const line = `const DEBUG_INGEST_TOKEN_FROM_BUILD = ${JSON.stringify(token)}`
+  return source.replace(INJECT_ANCHOR_RE, () => line)
+}
+
+/** 与 debugLogRelayBrain.test.ts 同构的 relay 消息与回执收集。 */
+const relayMsg = (reqId: string) => ({
+  reqId,
+  kind: 'debug-log-relay',
+  payload: { clientId: 'c1', sessionId: 's1', entries: [{ level: 'error', source: 'S', message: 'm', timestamp: 1 }] },
+})
+
+const replyCollector = (brain: ReturnType<typeof loadBrain>) => {
+  const replies: Array<Record<string, unknown>> = []
+  const panel = brain.bus.open('mivo-canvas-persist')
+  panel.onmessage = (event: { data: unknown }) => {
+    const data = event.data as Record<string, unknown>
+    if (data && data.reply === true) replies.push(data)
+  }
+  return { panel, replies }
+}
+
+const realMainSource = (): string => readFileSync(MAIN_JS_PATH, 'utf8')
+
+describe('SC-0e:#591 真实发布路径注入(不经 seam)', () => {
+  it('按真实发布方式注入 token 后,relay 恰好发生 1 次出网,且请求头带注入值', async () => {
+    const token = 'relay-release-token-2026'
+    // 关键:loadBrain 不传 debugIngestToken(不经 seam),源码 = 注入后的 dist 副本。
+    const brain = loadBrain({
+      source: injectToken(realMainSource(), token),
+      fetch: () => ({ ok: true, status: 200 }),
+    })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-release'))
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-release'), { label: '发布路径 relay 回执' })
+
+    // 恰好一次出网:证明守卫没有(错误地)把已注入的 token 判成未配置。
+    expect(brain.fetchRequests).toHaveLength(1)
+    const sent = brain.fetchRequests[0]!
+    expect(sent.url).toBe('https://mivo-canvas.dsworks.cn/api/mivo/debug-logs')
+    const headers = sent.headers as Record<string, string>
+    expect(headers['X-Mivo-Debug-Ingest-Token']).toBe(token)
+  })
+
+  it('注入值含引号/反斜杠/换行等特殊字符时,出网请求头仍是原始值', async () => {
+    const token = "Ab&C'd\\e/\"q\"\nx"
+    const brain = loadBrain({
+      source: injectToken(realMainSource(), token),
+      fetch: () => ({ ok: true, status: 200 }),
+    })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-special'))
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-special'), { label: '特殊字符 token 回执' })
+
+    expect(brain.fetchRequests).toHaveLength(1)
+    const headers = brain.fetchRequests[0]!.headers as Record<string, string>
+    expect(headers['X-Mivo-Debug-Ingest-Token']).toBe(token)
+  })
+
+  it('注入值含 replace 模板序列($& / $` / $\x27)时,出网请求头仍是原始值', async () => {
+    // 2026-08-10 greptile P1:replace(regex, str) 的字符串替换串会把 $& / $` / $'
+    // 当模板展开(如 $& = 整个匹配文本),token 被静默改写;函数替换器逐字返回。
+    const token = 'seq-$&-backtick-`-$quote-\x27-end'
+    const brain = loadBrain({
+      source: injectToken(realMainSource(), token),
+      fetch: () => ({ ok: true, status: 200 }),
+    })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-dollar'))
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-dollar'), { label: '$ 模板序列 token 回执' })
+
+    expect(brain.fetchRequests).toHaveLength(1)
+    const headers = brain.fetchRequests[0]!.headers as Record<string, string>
+    expect(headers['X-Mivo-Debug-Ingest-Token']).toBe(token)
+  })
+
+  it('构建未注入(注入点保持空串)→ 零出网 fail-closed 回执 403(真实源码路径)', async () => {
+    // 等价于「发布时没配 MIVO_DEBUG_INGEST_TOKEN,dist 里注入点仍是空串」。
+    // 走真实源码(loadBrain 不传 seam token),不是既有 seam 缺省用例的重复,
+    // 而是把「构建后空注入点」也当成同一份源码求值。
+    const brain = loadBrain({
+      source: realMainSource(), // 未注入,注入点 = ''
+      fetch: () => ({ ok: true, status: 200 }),
+    })
+    const { panel, replies } = replyCollector(brain)
+
+    panel.postMessage(relayMsg('relay-uninjected'))
+    await flushUntil(() => replies.some((r) => r.reqId === 'relay-uninjected'), { label: '未注入 fail-closed 回执' })
+
+    expect(brain.fetchRequests).toHaveLength(0) // 零出网
+    expect(replies.find((r) => r.reqId === 'relay-uninjected')).toMatchObject({ ok: true, status: 403 })
+  })
+})
