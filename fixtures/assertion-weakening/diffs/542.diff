+    expect(getDebugLogRelayStats().lastOutcome).toBe('2xx')
+  })
+
+  it('HTTP 2xx 边界 204 / 299 同样算成功', async () => {
+    installSeam(() => okReply(204))
+    await expect(debugLogRelayTransport(basePayload)).resolves.toEqual({ ok: true, status: 204 })
+    installSeam(() => okReply(299))
+    await expect(debugLogRelayTransport(basePayload)).resolves.toEqual({ ok: true, status: 299 })
+  })
+
+  it.each([403, 413, 415, 429, 500, 502])('HTTP 非 2xx(%i)→ resolve {ok:false,status}(可重试失败,不是 reject)', async (status) => {
+    installSeam(() => okReply(status))
+    await expect(debugLogRelayTransport(basePayload)).resolves.toEqual({ ok: false, status })
