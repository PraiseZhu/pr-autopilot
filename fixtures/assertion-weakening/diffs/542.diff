+
+  it('已知边界(β):英文自由文本**不**做形状级指纹 —— 把限制钉在测试里,不假装它被挡住了', async () => {
+    // 为什么不挡:英文散文在形状上无法与运行时异常区分(下一条用例正是要求 TypeError
+    // 原样保留)。任何长度阈值都会二者必伤其一。英文宿主文本的残余暴露由服务端
+    // sanitizer 兜第二道,并作为已知边界交 owner 决策。
+    // 这条断言记录**当前真实行为**;哪天改成挡住了,它会红,提醒同步更新文档与 SC 说明。
+    const hostText = 'the requested asset could not be resolved because the workspace was archived'
+    const out = await relayed(`relay rejected: ${hostText}`)
+    expect(out).toContain('workspace was archived')
+  })
+
+  it('stack 与 message 同样过脱敏(stack 里常有真实路径与文件名)', async () => {
+    const out = await relayed('boom', 'Error: boom\n    at load (https://mivo-canvas.dsworks.cn/assets/index-9f8e.js:2:3344)')
+    expect(out).not.toContain('mivo-canvas.dsworks.cn')
+    expect(out).not.toContain('index-9f8e')
+  })
+
+  it('技术性文本保留原文(否则 bug-doctor 读不到有效信号 —— 脱敏不能把功能废掉)', async () => {
+    const out = await relayed('TypeError: Cannot read properties of undefined (reading id) code=MIVO_AUTH_INVALID status=401')
+    expect(out).toContain('TypeError')
+    expect(out).toContain('MIVO_AUTH_INVALID')
