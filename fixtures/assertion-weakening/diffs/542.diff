+    const b = redactForRemoteReport('prompt: 把这张图里的人物换成穿红色汉服的女孩背景改成黄昏的江南水乡电影感打光')
+    const c = redactForRemoteReport('prompt: 把这张图里的人物换成穿蓝色汉服的女孩背景改成黄昏的江南水乡电影感打光')
+    expect(a).toBe(b)
+    expect(a).not.toBe(c)
+  })
+
+  it('整条 message 有 4KB 硬上限', async () => {
+    const out = await relayed('X'.repeat(20_000))
+    const entries = JSON.parse(out) as Array<{ message: string }>
+    expect(entries[0]!.message.length).toBeLessThanOrEqual(4096 + 20)
+  })
+})
