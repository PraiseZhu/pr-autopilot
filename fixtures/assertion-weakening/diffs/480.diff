diff --git a/cindyplugin/src/__tests__/canvasSelectionTool.test.ts b/cindyplugin/src/__tests__/canvasSelectionTool.test.ts
new file mode 100644
index 00000000..011be1ce
--- /dev/null
+++ b/cindyplugin/src/__tests__/canvasSelectionTool.test.ts
@@ -0,0 +1,216 @@
+/**
+ * canvas_selection(#297 选中直读)main.js 侧流程测试。
+ *
+ * 背景:选中态是全局、极小、易变的事实,canvas_snapshot 的选中字段按 region/sectionId
+ * 结果集过滤,「没选」与「选了但在读取范围外」返回字节级同形(空数组+0)——2026-08-04
+ * 真机事故:把选中的 16:9 图读成隔壁 1:1。本工具一次返回全部选中节点,不吃过滤。
+ *
+ * 覆盖面:入参透传与校验 / 合法回执交卷 / 出口形状门(normalizeSelectionReply)逐条
+ * 坏例 / 离线不降级(与 canvas_snapshot 的离线降级刻意不同)。
+ */
+import { describe, expect, it } from 'vitest'
+import { loadBrain } from './brainHarness'
+import { closedPanelBrain, lastResult, withPanel } from './brainSnapshotFixtures'
+
+const selNode = (id: string, type = 'image') => ({
+  id,
+  type,
+  title: id,
+  bounds: { x: 0, y: 0, width: 100, height: 100 },
+})
+
+const validReply = {
+  ok: true,
+  sceneId: 'scene-1',
+  selectedNodes: [selNode('img-1'), selNode('note-1', 'markup')],
+  selectedNodeCount: 2,
+  selectedImageNodeIds: ['img-1'],
+}
+
+const callSelection = async (reply: Record<string, unknown>, args: Record<string, unknown> = {}) => {
+  const brain = loadBrain()
+  const seen = withPanel(brain, reply)
+  await brain.handles.handleToolCall({ tool: 'canvas_selection', callId: 'c1', args })
+  return { sent: lastResult(brain), seen }
+}
+
+describe('canvas_selection 入参', () => {
+  it('无参调用 → verb selection,params 为空(零寄存请求)', async () => {
+    const { sent, seen } = await callSelection(validReply)
+    expect(seen).toHaveLength(1)
+    expect(seen[0].verb).toBe('selection')
+    expect(seen[0].params).toEqual({})
+    expect(sent?.ok).toBe(true)
+  })
+
+  it('mediaNodeIds 透传;宿主注入与未知字段不进面板动词', async () => {
+    const { seen } = await callSelection(validReply, {
+      mediaNodeIds: ['img-1'],
+      session_context: { session_id: 's' },
+      attachments: ['deadbeef'],
+      nonsense: 1,
+    })
+    expect(seen[0].params).toEqual({ mediaNodeIds: ['img-1'] })
+  })
+
+  it('mediaNodeIds 超 8 个 → INVALID_PARAMS,不进面板', async () => {
+    const { sent, seen } = await callSelection(validReply, {
+      mediaNodeIds: Array.from({ length: 9 }, (_, i) => `img-${i}`),
+    })
+    expect(seen).toHaveLength(0)
+    expect(sent?.ok).toBe(false)
+    expect(sent?.errorCode).toBe('INVALID_PARAMS')
+  })
+
+  it('mediaNodeIds 含重复 → INVALID_PARAMS', async () => {
+    const { sent } = await callSelection(validReply, { mediaNodeIds: ['img-1', 'img-1'] })
+    expect(sent?.ok).toBe(false)
+    expect(sent?.errorCode).toBe('INVALID_PARAMS')
+  })
+})
+
+describe('canvas_selection 合法回执交卷', () => {
+  it('选中清单/计数/图片 id 原样交卷,source 标实时画布', async () => {
+    const { sent } = await callSelection(validReply)
+    expect(sent?.ok).toBe(true)
+    expect(sent?.result).toMatchObject({
+      source: '实时画布',
+      sceneId: 'scene-1',
+      selectedNodeCount: 2,
+      selectedImageNodeIds: ['img-1'],
+    })
+    expect((sent?.result?.selectedNodes as unknown[]).length).toBe(2)
+  })
+
+  it('选 0 张 → ok:true + note 点明「实时选中态,不是读取范围问题」', async () => {
+    const { sent } = await callSelection({ ok: true, sceneId: 's', selectedNodes: [], selectedNodeCount: 0, selectedImageNodeIds: [] })
+    expect(sent?.ok).toBe(true)
+    expect(sent?.result?.selectedNodeCount).toBe(0)
+    expect(String(sent?.result?.note)).toContain('实时选中态')
+  })
+
+  it('mediaStates/mediaSummary 原样透传(信任模型与 canvas_snapshot 一致)', async () => {
+    const { sent } = await callSelection({
+      ...validReply,
+      mediaStates: { 'img-1': { state: 'available', imageRef: 'cindy-media://blobs/ab.png' } },
+      mediaSummary: { requested: 1, available: 1, unavailable: 0 },
+    })
+    expect(sent?.result?.mediaStates).toEqual({ 'img-1': { state: 'available', imageRef: 'cindy-media://blobs/ab.png' } })
+    expect(sent?.result?.mediaSummary).toEqual({ requested: 1, available: 1, unavailable: 0 })
+  })
+
+  it('合法截断:64 条清单 + count>64 + truncated → 原样交卷', async () => {
+    const nodes = Array.from({ length: 64 }, (_, i) => selNode(`img-${i}`))
+    const { sent } = await callSelection({
+      ok: true,
+      sceneId: 's',
+      selectedNodes: nodes,
+      selectedNodeCount: 70,
+      selectedImageNodeIds: nodes.map((n) => n.id),
+      selectedNodesTruncated: true,
+    })
+    expect(sent?.ok).toBe(true)
+    expect(sent?.result?.selectedNodesTruncated).toBe(true)
+  })
+})
+
+describe('canvas_selection 出口形状门(整单拒绝,不剔字段放行)', () => {
+  const badCases: Array<[string, Record<string, unknown>]> = [
+    ['sceneId 缺失', { ...validReply, sceneId: undefined }],
+    ['selectedNodes 非数组', { ...validReply, selectedNodes: 'x' }],
+    ['selectedNodes 含空 id', { ...validReply, selectedNodes: [selNode('img-1'), selNode('')] , selectedNodeCount: 2 }],
+    ['selectedNodes 含重复 id', { ...validReply, selectedNodes: [selNode('img-1'), selNode('img-1')], selectedNodeCount: 2 }],
+    ['节点缺 bounds', { ...validReply, selectedNodes: [{ id: 'img-1', type: 'image', title: 't' }], selectedNodeCount: 1, selectedImageNodeIds: ['img-1'] }],
+    ['bounds 含非有限数', { ...validReply, selectedNodes: [{ ...selNode('img-1'), bounds: { x: NaN, y: 0, width: 1, height: 1 } }], selectedNodeCount: 1, selectedImageNodeIds: ['img-1'] }],
+    ['未截断但长度不等于计数', { ...validReply, selectedNodeCount: 5 }],
+    ['截断为 true 但清单未满', { ...validReply, selectedNodesTruncated: true, selectedNodeCount: 70 }],
+    ['selectedImageNodeIds 含重复', { ...validReply, selectedImageNodeIds: ['img-1', 'img-1'] }],
+    ['selectedImageNodeIds 命中清单里非 image 节点', { ...validReply, selectedImageNodeIds: ['note-1'] }],
+    ['selectedNodeCount 负数', { ...validReply, selectedNodeCount: -1 }],
+    // gpt 审查 P2:title 是契约必填(AiCanvasContextNode.title: string),egress 存在
+    // 的理由就是面板回执跨进程不可信 —— 初版漏验,缺 title 的坑回包会被判合法。
+    [
+      '节点缺 title(契约必填,egress 必须真的验)',
+      { ...validReply, selectedNodes: [{ id: 'img-1', type: 'image', bounds: { x: 0, y: 0, width: 1, height: 1 } }], selectedNodeCount: 1, selectedImageNodeIds: ['img-1'] },
+    ],
+    [
+      'title 不是字符串',
+      { ...validReply, selectedNodes: [{ ...selNode('img-1'), title: 42 }], selectedNodeCount: 1, selectedImageNodeIds: ['img-1'] },
+    ],
+    // gpt 审查 P2:未截断时清单即全量,外来 image id 此前因 `typeById.has(id)` 为 false
+    // 被放行 —— agent 会拿到一个根本没被选中的"选中图片 id"。
+    [
+      '未截断但 selectedImageNodeIds 含清单外的外来 id',
+      { ...validReply, selectedNodes: [selNode('note-1', 'markup')], selectedNodeCount: 1, selectedImageNodeIds: ['img-not-selected'] },
+    ],
+    [
+      '未截断但清单里的图片未被 selectedImageNodeIds 收录(漏收)',
+      { ...validReply, selectedNodes: [selNode('img-1'), selNode('img-2')], selectedNodeCount: 2, selectedImageNodeIds: ['img-1'] },
+    ],
+  ]
+  for (const [label, reply] of badCases) {
+    it(label + ' → SELECTION_INVALID', async () => {
+      const { sent } = await callSelection(reply)
+      expect(sent?.ok).toBe(false)
+      expect(sent?.errorCode).toBe('SELECTION_INVALID')
+    })
+  }
+})
+
+describe('canvas_selection 交卷投影(嵌套字段不得直通)', () => {
+  // gpt 审查 P2:result 字段 allowlist(门禁那份与 toolResultSweep 那份)只静态校验
+  // **顶层**键;`selectedNodes` 元素内部的键完全不受约束。原样引用面板对象时,坑回包
+  // 里多挂的任何字段都会随交卷载荷出去,而两道门照常绿。selectionResult 现在逐项
+  // 重建四元组,多余字段物理丢弃。
+  // 反证:把 selectionResult 里的 .map 投影改回 `live.selectedNodes`,本用例必须转红。
+  it('面板多挂的嵌套字段被丢弃,不随交卷载荷外泄', async () => {
+    const { sent } = await callSelection({
+      ...validReply,
+      selectedNodes: [
+        { ...selNode('img-1'), rawPanelReply: '/Users/praise/secret', assetOriginalName: '客户机密.png' },
+        selNode('note-1', 'markup'),
+      ],
+    })
+    expect(sent?.ok).toBe(true)
+    const nodes = sent?.result?.selectedNodes as Array<Record<string, unknown>>
+    expect(Object.keys(nodes[0]).sort()).toEqual(['bounds', 'id', 'title', 'type'])
+    expect(JSON.stringify(sent?.result)).not.toContain('/Users/praise/secret')
+    expect(JSON.stringify(sent?.result)).not.toContain('客户机密')
+  })
+
+  it('bounds 内部多挂的字段同样被丢弃(bounds 也是个不受约束的口子)', async () => {
+    const { sent } = await callSelection({
+      ...validReply,
+      selectedNodes: [
+        { ...selNode('img-1'), bounds: { x: 1, y: 2, width: 3, height: 4, leaked: '/Users/praise/x' } },
+        selNode('note-1', 'markup'),
+      ],
+    })
+    expect(sent?.ok).toBe(true)
+    const nodes = sent?.result?.selectedNodes as Array<{ bounds: Record<string, unknown> }>
+    expect(Object.keys(nodes[0].bounds).sort()).toEqual(['height', 'width', 'x', 'y'])
+    expect(JSON.stringify(sent?.result)).not.toContain('/Users/praise/x')
+  })
+})
+
+describe('canvas_selection 离线不降级', () => {
+  it('面板未打开 → PANEL_CLOSED,不读离线快照(选中态宁缺毋滥)', async () => {
+    const brain = closedPanelBrain()
+    const pending = brain.handles.handleToolCall({ tool: 'canvas_selection', callId: 'c1', args: {} })
+    brain.clock.advance(6_000)
+    await pending
+    const sent = lastResult(brain)
+    expect(sent?.ok).toBe(false)
+    expect(sent?.errorCode).toBe('PANEL_CLOSED')
+    expect(String(sent?.message)).toContain('滞后')
+    // 反向断言:离线降级读的是 canvases/ai-snapshot.json——选中直读绝不碰它。
+    const readPaths = brain.fsRequests.filter((r) => r.op === 'read').map((r) => r.path)
+    expect(readPaths).not.toContain('canvases/ai-snapshot.json')
+  })
+
+  it('面板明确拒绝(非 PANEL_CLOSED)→ 错误码原样透传', async () => {
+    const { sent } = await callSelection({ ok: false, code: 'SOME_ERR', message: 'x' })
+    expect(sent?.ok).toBe(false)
+    expect(sent?.errorCode).toBe('SOME_ERR')
+  })
+})
