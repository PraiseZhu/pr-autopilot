@@ -550,14 +559,22 @@ const deriveSelectedImageObservation = (
   rawSelectedNodeIds: string[],
   includedIds: Set<string>,
   nodesById: Map<string, AiCanvasContextNode>,
+  allNodeIds: Set<string>,
 ): SelectedImageObservation => {
   const selectedIncluded = rawSelectedNodeIds.filter((id) => includedIds.has(id))
   const selectedImageIds = selectedIncluded.filter((id) => nodesById.get(id)?.type === 'image')
   const truncated = selectedImageIds.length > MAX_SELECTED_IMAGE_NODE_IDS
+  // 范围外计数只认「画布上真实存在」的选中节点(allNodeIds 是**全快照**节点集,
+  // 不是过滤结果集):幽灵 id 既不在结果集也不在画布,归 0 而不是归"范围外",
+  // 否则消费方会为一个已删除的节点反复扩大 region。
+  const selectionOutOfScope = rawSelectedNodeIds.filter(
+    (id) => !includedIds.has(id) && allNodeIds.has(id),
+  ).length
 
   return {
     selectedImageNodeIds: truncated ? selectedImageIds.slice(0, MAX_SELECTED_IMAGE_NODE_IDS) : selectedImageIds,
     selectedNodeCount: selectedIncluded.length,
+    selectionOutOfScope,
     ...(truncated ? { selectedImageNodesTruncated: true as const } : {}),
   }
 }
