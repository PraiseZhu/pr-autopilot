+/** #297 编辑占位列布局:anchor 右侧生成一列 count 张衍生图,整列垂直居中于 anchor。
+ *  占位阶段 widths 缺省为 anchor.width;完成/部分完成阶段按 ordinal 传入各自宽度,
+ *  width 只影响矩形自身,列左缘 x = anchor.x + anchor.width + gap 固定。 */
+export const centeredColumnPlacements = ({
+  anchor,
+  count,
+  gap,
+  widths,
+}: {
+  anchor: Pick<MivoCanvasNode, 'x' | 'y' | 'width' | 'height'>
+  count: number
+  gap: number
+  widths?: number[]
+}): { x: number; y: number; width: number; height: number }[] => {
+  if (count <= 0) return []
+
+  const h = Math.round(anchor.height)
+  const x = anchor.x + anchor.width + gap
+
+  // count=1 退化情形(用户规格图 1):单张衍生图与原图上下边缘对齐。
+  // 垂直居中公式在整数高度下自然退化为此值;此处显式保证非整数高度的边缘对齐。
+  if (count === 1) {
+    return [{ x, y: anchor.y, width: Math.round(widths?.[0] ?? anchor.width), height: h }]
+  }
+
+  const totalH = count * h + (count - 1) * gap
+  const top = anchor.y + anchor.height / 2 - totalH / 2
+  return Array.from({ length: count }, (_, index) => ({
+    x,
+    y: top + index * (h + gap),
+    width: Math.round(widths?.[index] ?? anchor.width),
+    height: h,
+  }))
+}
+
+/** 编辑占位:衍生图高度锁定为原图高度(与原图上下边缘一致),宽度按结果图自身宽高比
+ *  换算。不复用 importedImageDisplaySize——它把最长边钳到 [96,360],与
+ *  「高度=原图高度」直接冲突。 */
+export const heightLockedSizeForDimensions = (
+  anchorHeight: number,
+  dimensions?: { width: number; height: number },
+): { width: number; height: number } => {
+  const height = Math.round(anchorHeight)
+  if (!dimensions || dimensions.width <= 0 || dimensions.height <= 0) {
+    return { width: height, height }
+  }
+  return { width: Math.round((anchorHeight * dimensions.width) / dimensions.height), height }
+}
