+  it('centeredColumnPlacements_single_edge_alignment — count=1 与原图上下边缘对齐', () => {
+    const [placement] = centeredColumnPlacements({ anchor, count: 1, gap: 20 })
+    expect(placement.y).toBe(anchor.y) // 顶边对齐
+    expect(placement.height).toBe(anchor.height) // 高度一致 → 底边也对齐
