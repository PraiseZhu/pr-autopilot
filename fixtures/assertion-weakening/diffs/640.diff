+    const [oddPlacement] = centeredColumnPlacements({ anchor: oddAnchor, count: 1, gap: 20 })
+    expect(oddPlacement.y).toBe(oddAnchor.y)
+    expect(oddPlacement.height).toBe(Math.round(oddAnchor.height))
+    expect(oddPlacement.y + oddPlacement.height).toBe(oddAnchor.y + Math.round(oddAnchor.height))
+  })
+
+  it('centeredColumnPlacements_vertical_center — 整列垂直居中于 anchor', () => {
+    const count = 2
+    const gap = 20
+    const h = Math.round(anchor.height) // 100
+    const totalH = count * h + (count - 1) * gap // 220
+    const top = anchor.y + anchor.height / 2 - totalH / 2 // 50 + 50 - 110 = -10
+    const placements = centeredColumnPlacements({ anchor, count, gap })
+
+    expect(placements[0].y).toBe(top)
