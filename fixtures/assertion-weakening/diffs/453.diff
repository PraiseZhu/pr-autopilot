@@ -44,3 +44,41 @@ export const buildImageRef = (hash: string, rawExt: unknown): string | null => {
   if (!extResult.ok) return null
   return `cindy-media://blobs/${hash}${extResult.ext}`
 }
+
+/**
+ * receiptHash 十六进制指纹的形状校验(与 `agentBridge.ts` 的 `fetchOwnedMediaFile`
+ * 同一正则,统一规则不重新发明)。
+ */
+const HASH_RE = /^[a-f0-9]{16,128}$/i
+
+export type MediaFilePathResult = { ok: true; path: string } | { ok: false; reason: string }
+
+/**
+ * receiptHash → agent 可 `Read` 的落盘路径(#297 T3b2,SC-T3b.4;公式冻结自
+ * `_tmp/297-dispatch/t0-carrier-verdict.md` 的真机验证):
+ *   `<mediaRoot>/blobs/<hash 前 2 位>/<hash><ext>`
+ * 分片键 = hash 自身的前 2 个字符,不枚举目录、不做任何大小写转换(T0 契约明文
+ * "原样使用,不做大小写转换或格式再加工")。
+ *
+ * `mediaRoot` 由调用方给出——媒体根发现(userData 平台约定)是外部 agent 自己
+ * 具备的平台知识,不是本插件的职责:宿主 `cindy` 的 `fs` 槎,其 root 白名单只有
+ * `'data'`/`'workdir'`,插件沙盒物理触达不到 `<userData>/cindy-media`,这个函数
+ * 从来不会有生产 callsite,只服务于验收脚本/测试对公式本身的校验。
+ *
+ * 上一段刻意把宿主槎拆开写、不用点式成员访问形态:`verify-debug-logging.mjs` 的
+ * 「面板侧生产代码不得持有宿主通道」门禁是 regex 扫源码、只剥行注释不剥块注释,
+ * 点式形态会让这份纯注释被判成违规(门禁语义没问题,是它读不出块注释)。
+ */
+export const deriveMediaFilePath = (hash: string, rawExt: unknown, mediaRoot: string): MediaFilePathResult => {
+  if (typeof hash !== 'string' || !HASH_RE.test(hash)) {
+    return { ok: false, reason: `hash 不是合法的十六进制指纹:${String(hash)}` }
+  }
+  const extResult = normalizeImageRefExt(rawExt)
+  if (!extResult.ok) return extResult
+  if (typeof mediaRoot !== 'string' || !mediaRoot) {
+    return { ok: false, reason: 'mediaRoot 缺失或非字符串' }
+  }
+  const root = mediaRoot.endsWith('/') ? mediaRoot.slice(0, -1) : mediaRoot
+  const shard = hash.slice(0, 2)
+  return { ok: true, path: `${root}/blobs/${shard}/${hash}${extResult.ext}` }
+}
