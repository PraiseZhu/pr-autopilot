+/**
+ * receiptHash → agent 可 `Read` 的落盘路径公式(#297 T3b2,SC-T3b.4)。
+ *
+ * 只测公式本身(纯函数,零 I/O)——不是"真的落盘读取 + digest 对账"的 E2E:
+ * 那半要求 deposit 通道真正通电(DoR = T1f)才能产出真实文件,归真机验收脚手架
+ * (`_tmp/`,不进 git),不进这个文件。本文件的判据是"公式算出的路径与
+ * owner 真机上实际存在的文件路径逐字节对得上"(lead 亲自读过这两个文件,
+ * 见下方两组真值夹具),不是"公式看起来合理"。
+ *
+ * 独立成文件而不塞进 `agentBridgeMediaResolve.test.ts`(该文件已 747 行,专注
+ * AST 接线锁,职责不同,继续塞会增加它逼近 800 行硬上限的风险)。
+ */
+import { describe, expect, it } from 'vitest'
+import { deriveMediaFilePath } from '../agent/mediaRefFormat'
+
+const FAKE_HASH = 'b'.repeat(32)
+
+describe('SC-T3b.4 deriveMediaFilePath(公式冻结自 t0-carrier-verdict.md,与真机文件对账)', () => {
+  it('真值夹具 1:owner 真机实际存在的文件(lead 已用 Read 工具读过)', () => {
+    const hash = '818ee098bd8aae57c5e61730c43f74c0f5dd87b24565c285b641a1745d3a73e7'
+    const mediaRoot = '/Users/praise/Library/Application Support/Cindy/cindy-media'
+    expect(deriveMediaFilePath(hash, '.png', mediaRoot)).toEqual({
+      ok: true,
+      path: '/Users/praise/Library/Application Support/Cindy/cindy-media/blobs/81/818ee098bd8aae57c5e61730c43f74c0f5dd87b24565c285b641a1745d3a73e7.png',
+    })
+  })
+
+  it('真值夹具 2:owner 真机实际存在的文件(lead 已用 Read 工具读过)', () => {
+    const hash = '3970c76575075bbb3bc292e022200d1ee37a514b7c1b9681072f430d0b9c4565'
+    const mediaRoot = '/Users/praise/Library/Application Support/Cindy/cindy-media'
+    expect(deriveMediaFilePath(hash, '.png', mediaRoot)).toEqual({
+      ok: true,
+      path: '/Users/praise/Library/Application Support/Cindy/cindy-media/blobs/39/3970c76575075bbb3bc292e022200d1ee37a514b7c1b9681072f430d0b9c4565.png',
+    })
+  })
+
+  it('mediaRoot 带末尾斜杠时不产生双斜杠(与不带斜杠的输入等价)', () => {
+    const hash = FAKE_HASH
+    const withSlash = deriveMediaFilePath(hash, '.png', '/root/cindy-media/')
+    const withoutSlash = deriveMediaFilePath(hash, '.png', '/root/cindy-media')
+    expect(withSlash).toEqual(withoutSlash)
+    expect(withSlash).toEqual({ ok: true, path: `/root/cindy-media/blobs/bb/${hash}.png` })
+  })
+
+  it('ext 两套约定(带点 vs 不带点)算出同一条路径——复用 normalizeImageRefExt,不重复实现判断', () => {
+    const hash = FAKE_HASH
+    const dotted = deriveMediaFilePath(hash, '.png', '/root')
+    const undotted = deriveMediaFilePath(hash, 'png', '/root')
+    expect(dotted).toEqual(undotted)
+    expect(dotted).toEqual({ ok: true, path: `/root/blobs/bb/${hash}.png` })
+  })
+
+  it('不对 hash 做大小写转换(T0 契约明文"原样使用,不做大小写转换")', () => {
+    const upperHash = FAKE_HASH.toUpperCase()
+    const result = deriveMediaFilePath(upperHash, '.png', '/root')
+    expect(result).toEqual({ ok: true, path: `/root/blobs/BB/${upperHash}.png` })
+  })
+
+  it.each([
+    ['空字符串', ''],
+    ['过短(15 位)', 'a'.repeat(15)],
+    ['过长(129 位)', 'a'.repeat(129)],
+    ['含路径分隔符 /', `../${FAKE_HASH}`],
+    ['含路径分隔符 \\', `${FAKE_HASH}\\x`],
+    ['含上级引用 ..', `..${FAKE_HASH.slice(2)}`],
+    ['非十六进制字符', `g${FAKE_HASH.slice(1)}`],
+    ['非字符串(number)', 12345],
+    ['非字符串(null)', null],
+  ])('hash 非法(%s)一律拒绝,不拼出任何路径', (_label, badHash) => {
+    const result = deriveMediaFilePath(badHash as unknown as string, '.png', '/root')
+    expect(result.ok).toBe(false)
+  })
+
+  it.each([
+    ['空', ''],
+    ['undefined', undefined],
+    ['null', null],
+    ['含路径分隔符 /', 'a/b.png'],
+    ['含路径分隔符 \\', 'a\\b.png'],
+    ['含上级引用 ..', '../x'],
+    ['主体非字母数字', '.p n g'],
+  ])('ext 非法(%s)一律拒绝,与 normalizeImageRefExt 判据一致', (_label, badExt) => {
+    const result = deriveMediaFilePath(FAKE_HASH, badExt, '/root')
+    expect(result.ok).toBe(false)
+  })
+
+  it.each([
+    ['空字符串', ''],
+    ['非字符串(number)', 42],
+    ['非字符串(null)', null],
+    ['非字符串(undefined)', undefined],
+  ])('mediaRoot 非法(%s)一律拒绝', (_label, badRoot) => {
+    const result = deriveMediaFilePath(FAKE_HASH, '.png', badRoot as unknown as string)
+    expect(result.ok).toBe(false)
+  })
+
+  it('hash 合法但 ext 非法:reason 来自 ext 判据,不是笼统错误(便于调用方诊断)', () => {
+    const result = deriveMediaFilePath(FAKE_HASH, '../x.png', '/root')
+    expect(result).toEqual({ ok: false, reason: expect.stringContaining('路径注入') })
+  })
+})
