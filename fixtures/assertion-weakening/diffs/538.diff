+    const node = stressSeedNode(5) as unknown as { generation: Record<string, unknown> }
+    seedUserCanvas({ ...stressSeedNode(5), id: 'stress-5-copy-1754300000000-0', generation: { ...node.generation, model: '用户自己的模型' } })
+    await expectUntouched('stress-5-copy-1754300000000-0', FAKE_BASE64)
+  })
+
+  it('对抗③ seed 缺失:复制链 id 合法、签名其余齐全但无 seed → 不动,禁止 fallback 0', async () => {
+    const node = stressSeedNode(5) as unknown as { generation: Record<string, unknown> }
+    const generation = { ...node.generation }
+    delete generation.seed
+    seedUserCanvas({ ...stressSeedNode(5), id: 'stress-5-copy-1754300000000-1', generation })
+    await expectUntouched('stress-5-copy-1754300000000-1', FAKE_BASE64)
+  })
+
+  it('对抗④ seed 越界:seed=7100 → 不动(复制链 index 只从合法 seed 还原,禁止取模)', async () => {
+    const node = stressSeedNode(0) as unknown as { generation: Record<string, unknown> }
+    seedUserCanvas({ ...stressSeedNode(0), id: 'stress-0-copy-1754300000000-0', generation: { ...node.generation, seed: 7100 } })
+    await expectUntouched('stress-0-copy-1754300000000-0', FAKE_BASE64)
+  })
+
+  it('对抗⑤ 复制后换图保留元数据:assetSourceDimensions 在(换图流程会记录)→ 不动,用户的图不被覆盖', async () => {
+    const replaced = {
+      ...createNodeCopy(stressSeedNode(8), 0), // 真实复制,再模拟换图:新 data: 图 + 记录源尺寸
+      assetUrl: 'data:image/png;base64,USER_REPLACED_BYTES',
+      asset: undefined,
+      fills: undefined,
+      assetSourceDimensions: { width: 800, height: 600 }, // 种子从不携带;换图痕迹
+    }
+    seedUserCanvas(replaced as unknown as Record<string, unknown>)
+    await expectUntouched(replaced.id, 'data:image/png;base64,USER_REPLACED_BYTES')
+  })
+
+  it('对抗⑦ 非 stress 前缀的手造 id(带完整签名)→ 不动(id 形态不在 canonical root + copy 链内)', async () => {
+    seedUserCanvas({ ...stressSeedNode(23), id: 'pasted-copy-abc' })
+    await expectUntouched('pasted-copy-abc', FAKE_BASE64)
+  })
+
+  it('对抗⑥ id 与 seed 错位:stress-3 携带 seed=7009 → 全签名一致性失败,不动', async () => {
+    const node = stressSeedNode(3) as unknown as { generation: Record<string, unknown> }
+    seedUserCanvas({ ...stressSeedNode(3), generation: { ...node.generation, seed: 7009, model: modelNames[9 % 3] } })
+    await expectUntouched('stress-3', FAKE_BASE64)
+  })
+
+  it('幂等:清洗后的 v13 blob 再次 rehydrate 不再变化(引用不再命中 data: 判据)', async () => {
+    ls().setItem(NAME, JSON.stringify(v12Blob()))
+    await useCanvasStore.persist.rehydrate()
+    await flushCanvasPersistWrite('migration-writeback-drain') // 首次迁移写回落定
+    const afterFirst = ls().getItem(NAME)
+    useCanvasStore.setState({ ...useCanvasStore.getInitialState() } as never, true)
+    __resetCanvasPersistStorageForTests() // 丢弃 reset 触发的暂存写(测试自扰,不是迁移)
+    await useCanvasStore.persist.rehydrate() // 第二次:盘上已是 v13
+    const doc = useCanvasStore.getState().canvases['stress-test']
+    expect(doc.nodes.every((n) => n.assetUrl?.startsWith('mivo-demo:stress/'))).toBe(true)
+    expect(afterFirst!.includes('data:image')).toBe(false)
+  })
+})
