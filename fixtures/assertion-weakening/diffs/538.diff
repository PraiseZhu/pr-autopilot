+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #506 四轮回归:pending 释放的主体 = 每笔 acquire 的 token(不是 URL、不是
+// entry 上的共享标记)。三审实测:URL/共享标记口径在「demo A→B→dispose(全程
+// 未到 rAF)」下泄漏 1 个队列 job——A 的释放状态污染了 B 这一笔。本文件钉死
+// token 化后的两条审核指定硬场景:
+//  1. demo 引用 A→B→dispose-before-rAF:队列 0 / 绘制 0 / lease 表 0;
+//  2. mivo-asset / mivo-sasset 慢解析(deferred resolver,慢 IDB/fetch)同场景:
+//     每个实际创建的 blob 恰一次 revoke(孤儿解析当场回收),零残留。
+
+vi.mock('leafer-ui', () => {
+  class FakeUI {
+    props: Record<string, unknown>
+    removed = false
+    constructor(props: Record<string, unknown> = {}) {
+      this.props = { ...props }
+    }
+    set(props: Record<string, unknown>) {
+      this.props = { ...this.props, ...props }
+    }
+    remove() {
+      this.removed = true
+    }
+  }
+  class FakeImage extends FakeUI {}
+  class FakeRect extends FakeUI {}
+  class FakeGroup extends FakeUI {
+    children: FakeUI[] = []
+    add(child: FakeUI) {
+      this.children.push(child)
+    }
+  }
+  class FakeBox extends FakeGroup {}
+  return { Image: FakeImage, Group: FakeGroup, Box: FakeBox, Rect: FakeRect }
+})
+
+vi.mock('./engineLodMode', () => ({
+  engineLodMode: 'on',
+  engineLodThresholdPx: 32,
+  isEngineLodRequested: true,
+}))
+
+// mivo-asset / mivo-sasset 都走 deferred resolver:测试手工控制落定时机,
+// 模拟慢 IDB / 慢 fetch(谓词覆盖面与真实 assetStorage.ts:105 一致)。
+const deferredResolvers: Array<{ url: string; resolve: (value: string) => void }> = []
+vi.mock('../lib/assetStorage', () => ({
+  isImportedAssetUrl: (url?: string) =>
+    Boolean(url && (url.startsWith('mivo-asset:') || url.startsWith('mivo-sasset:'))),
+  resolveAssetUrl: (url?: string) =>
+    new Promise<string>((resolve) => {
+      deferredResolvers.push({ url: url ?? '', resolve })
+    }),
+  readImportedAssetFile: () => Promise.resolve(undefined),
+}))
+
+const { createLeaferImagePaint } = await import('./leaferImagePaint')
+const { __leaseMapSize } = await import('../lib/assetUrlLease')
+const { stressDemoAssetUrl, __demoDrawQueueSize } = await import('../lib/demoAssets')
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+import type { RendererSyncContext } from './rendererAdapter'
+import type { Leafer } from 'leafer-ui'
+
+const flushPromises = () => new Promise<void>((resolve) => setTimeout(resolve, 0))
+
+type FakeUI = { props: Record<string, unknown>; removed: boolean }
+
+const makeFakeLeafer = () => {
+  const children: FakeUI[] = []
+  return {
+    add: (child: FakeUI) => children.push(child),
+    children,
+  } as unknown as Leafer & { children: FakeUI[] }
+}
+
+const ctx = (scale = 1): RendererSyncContext => ({
+  viewport: { x: 0, y: 0, scale },
+  selectedNodeIds: new Set<string>(),
+  isPanning: false,
+})
+
+const imgNode = (id: string, assetUrl: string): MivoCanvasNode =>
+  ({
+    id,
+    type: 'image',
+    status: 'ready',
+    x: 0,
+    y: 0,
+    width: 500,
+    height: 500,
+    assetUrl,
+  }) as unknown as MivoCanvasNode
+
+const makeFake2dCtx = () => {
+  const noop = () => undefined
+  return {
+    save: noop, restore: noop, translate: noop, beginPath: noop, closePath: noop,
+    moveTo: noop, lineTo: noop, arc: noop, arcTo: noop, ellipse: noop,
+    fill: noop, stroke: noop, fillRect: noop, fillText: noop, putImageData: noop,
+    getImageData: () => ({ data: new Uint8ClampedArray(320 * 420 * 4) }),
+    createLinearGradient: () => ({ addColorStop: noop }),
+    set fillStyle(_v: unknown) {}, set strokeStyle(_v: unknown) {},
+    set lineWidth(_v: unknown) {}, set globalAlpha(_v: unknown) {}, set font(_v: unknown) {},
+  } as unknown as CanvasRenderingContext2D
+}
+
+let drawCount = 0
+let liveObjectUrls: Set<string>
+let revokedUrls: string[]
+let urlSeq = 0
+let rafQueue: FrameRequestCallback[]
+
+const runFrame = () => {
+  const callbacks = rafQueue.splice(0)
+  for (const callback of callbacks) callback(0)
+}
+
+describe('leaferImagePaint × per-acquire token(#506 四轮回归)', () => {
+  beforeEach(() => {
+    drawCount = 0
+    urlSeq = 0
+    liveObjectUrls = new Set()
+    revokedUrls = []
+    rafQueue = []
+    deferredResolvers.length = 0
+    vi.stubGlobal('requestAnimationFrame', (callback: FrameRequestCallback) => {
+      rafQueue.push(callback)
+      return rafQueue.length
+    })
+    vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockImplementation((() => makeFake2dCtx()) as never)
+    Object.defineProperty(HTMLCanvasElement.prototype, 'toBlob', {
+      configurable: true,
+      value: function toBlob(cb: (blob: Blob) => void) {
+        drawCount += 1
+        cb(new Blob(['demo-jpeg-bytes'], { type: 'image/jpeg' }))
+      },
+    })
+    vi.stubGlobal('URL', {
+      ...URL,
+      createObjectURL: () => {
+        const url = `blob:paint-${(urlSeq += 1)}`
+        liveObjectUrls.add(url)
+        return url
+      },
+      revokeObjectURL: (url: string) => {
+        liveObjectUrls.delete(url)
+        revokedUrls.push(url)
+      },
+    })
+  })
+  afterEach(() => {
+    vi.unstubAllGlobals()
+    vi.restoreAllMocks()
+  })
+
+  it('demo A→B→dispose(全程未到 rAF):队列 0 / 绘制 0 / lease 表 0(审核实测三审版泄漏 delta=1)', async () => {
+    const leafer = makeFakeLeafer()
+    const paint = createLeaferImagePaint(leafer)
+
+    paint.sync([imgNode('n1', stressDemoAssetUrl(1))], ctx()) // A 入队
+    expect(__demoDrawQueueSize()).toBe(1)
+
+    paint.sync([imgNode('n1', stressDemoAssetUrl(2))], ctx()) // A→B:A 以自己的 token 出队,B 入队
+    expect(__demoDrawQueueSize()).toBe(1)
+
+    paint.dispose() // rAF 还没跑:B 以自己的 token 出队
+    expect(__demoDrawQueueSize()).toBe(0)
+
+    runFrame() // 帧来了也无活可干
+    expect(drawCount).toBe(0)
+    await flushPromises()
+    expect(__leaseMapSize()).toBe(0)
+    expect(liveObjectUrls.size).toBe(0)
+    expect(revokedUrls).toEqual([]) // 没画过 → 无 blob 可回收(不是"回收掉了泄漏")
+  })
+
+  it('mivo-asset→mivo-sasset 慢解析同场景:两笔各自孤儿落定,恰一次 revoke 零残留', async () => {
+    const leafer = makeFakeLeafer()
+    const paint = createLeaferImagePaint(leafer)
+
+    paint.sync([imgNode('n1', 'mivo-asset:slow-idb')], ctx()) // A 在飞(deferred)
+    expect(deferredResolvers.length).toBe(1)
+    paint.sync([imgNode('n1', 'mivo-sasset:slow-fetch')], ctx()) // A→B:A 的 token 即刻结账
+    expect(deferredResolvers.length).toBe(2)
+    expect(__leaseMapSize()).toBe(1) // A 的 entry 已摘,只剩 B
+    paint.dispose() // B 也在 pending 窗口离场
+    expect(__leaseMapSize()).toBe(0)
+
+    // 慢 IDB / 慢 fetch 此刻才落定 → 两笔都是孤儿解析,blob 当场回收
+    const blobA = URL.createObjectURL(new Blob(['a']))
+    const blobB = URL.createObjectURL(new Blob(['b']))
+    deferredResolvers[0].resolve(blobA)
+    deferredResolvers[1].resolve(blobB)
+    await flushPromises()
+
+    expect(revokedUrls.sort()).toEqual([blobA, blobB].sort()) // 每个 blob 恰一次 revoke
+    expect(liveObjectUrls.size).toBe(0)
+    expect(__leaseMapSize()).toBe(0)
+  })
+
+  it('慢解析 A 落定于 B pending 期间:A 的 .then 只结 A 的账,B 照常落定应用', async () => {
+    const leafer = makeFakeLeafer()
+    const paint = createLeaferImagePaint(leafer)
+
