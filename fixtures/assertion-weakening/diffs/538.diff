+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #506 显示验收:stress-test 场景节点换成 mivo-demo: 引用后,进入场景图片必须
+// 正常显示。真实链路:demoScenes 场景节点 → CanvasNodeView → useResolvedAssetUrl
+// → assetUrlLease → assetStorage.resolveAssetUrl(demo 分支惰性绘制)→ <img src=blob:>。
+// happy-dom 无 2d:stub canvas 提供最小可绘面;dom 渲染器下断言(leafer 侧走同一
+// acquireAssetUrl 缝,lease 生命周期契约见 assetUrlLease.demoAsset.test)。
+
+vi.mock('../render/rendererMode', () => ({ rendererMode: 'dom' }))
+
+const { snapshotFromScene } = await import('../store/demoScenes')
+const { CanvasNodeView } = await import('./CanvasNodeView')
+type CanvasNodeViewProps = import('./CanvasNodeView').CanvasNodeViewProps
+
+const makeFake2dCtx = () => {
+  const noop = () => undefined
+  return {
+    save: noop, restore: noop, translate: noop, beginPath: noop, closePath: noop,
+    moveTo: noop, lineTo: noop, arc: noop, arcTo: noop, ellipse: noop,
+    fill: noop, stroke: noop, fillRect: noop, fillText: noop, putImageData: noop,
+    getImageData: () => ({ data: new Uint8ClampedArray(320 * 420 * 4) }),
+    createLinearGradient: () => ({ addColorStop: noop }),
+    set fillStyle(_v: unknown) {}, set strokeStyle(_v: unknown) {},
+    set lineWidth(_v: unknown) {}, set globalAlpha(_v: unknown) {}, set font(_v: unknown) {},
+  } as unknown as CanvasRenderingContext2D
+}
+
+let container: HTMLDivElement
+let root: Root
+
+describe('CanvasNodeView × mivo-demo: 引用(#506 显示验收)', () => {
+  beforeEach(() => {
+    vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockImplementation((() => makeFake2dCtx()) as never)
+    Object.defineProperty(HTMLCanvasElement.prototype, 'toBlob', {
+      configurable: true,
+      value: function toBlob(cb: (blob: Blob) => void) {
+        cb(new Blob(['demo-jpeg-bytes'], { type: 'image/jpeg' }))
+      },
+    })
+    ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+    container = document.createElement('div')
+    document.body.appendChild(container)
+    root = createRoot(container)
+  })
+  afterEach(() => {
+    act(() => root.unmount())
+    container.remove()
+    vi.restoreAllMocks()
+  })
+
+  it('真实 stress 场景节点:img 解析出 blob: URL(不再有任何 data:image)', async () => {
+    const node = snapshotFromScene('stress-test').nodes.find((n) => n.id === 'stress-3')!
+    expect(node.assetUrl).toBe('mivo-demo:stress/3') // 种子已是微型引用
+    const props: CanvasNodeViewProps = {
+      node,
+      selected: false,
+      selectionPreview: false,
+      sectionDropTarget: false,
+      connectorDropTarget: false,
+      primarySelected: false,
+      editing: false,
+      effectiveLocked: false,
+      effectiveRendererMode: 'dom', // #524:改为必填 prop(不再自读全局)
+
+      handleSize: 10,
+      handleBorderWidth: 2,
+      selectionStrokeWidth: 2,
+      onResizeHandlePointerDown: () => {},
+      onMarkupPointPointerDown: () => {},
+      onTextResizeHandlePointerDown: () => {},
+      onUpdateText: () => {},
+      onFinishTextEdit: () => {},
+      onResizeNodeToContent: () => {},
+    }
+    await act(async () => {
+      root.render(<CanvasNodeView {...props} />)
+    })
+    await act(async () => {
+      await new Promise((resolve) => setTimeout(resolve, 10)) // 排空 lease 异步解析
+    })
+    const img = container.querySelector('img')
+    expect(img).not.toBeNull()
+    expect(img!.getAttribute('src') || '').toMatch(/^blob:/)
+    expect(container.innerHTML.includes('data:image')).toBe(false)
+  })
+})
