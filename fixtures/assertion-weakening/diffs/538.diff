+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #506 三轮 F2:绘制调度 = **时间预算切片**(每帧至少 1 张,超 DEMO_DRAW_FRAME_
+// BUDGET_MS 即让帧——固定张数在慢机上单帧仍可能 ~30ms)+ **取消语义**(job 未
+// 开始时最后消费者离场 → 从队列移除,stale 绘制不抢占新场景、不阻塞新请求)。
+// rAF 与时钟均为可控桩:每张画耗 3ms 假钟 → 8ms 预算 = 每帧恰 3 张。
+
+const { requestDemoImageDraw, renderDemoImageBlob, stressDemoAssetUrl, DEMO_DRAW_FRAME_BUDGET_MS, __demoDrawQueueSize } =
+  await import('./demoAssets')
+
+const makeFake2dCtx = () => {
+  const noop = () => undefined
+  return {
+    save: noop, restore: noop, translate: noop, beginPath: noop, closePath: noop,
+    moveTo: noop, lineTo: noop, arc: noop, arcTo: noop, ellipse: noop,
+    fill: noop, stroke: noop, fillRect: noop, fillText: noop, putImageData: noop,
+    getImageData: () => ({ data: new Uint8ClampedArray(320 * 420 * 4) }),
+    createLinearGradient: () => ({ addColorStop: noop }),
+    set fillStyle(_v: unknown) {}, set strokeStyle(_v: unknown) {},
+    set lineWidth(_v: unknown) {}, set globalAlpha(_v: unknown) {}, set font(_v: unknown) {},
+  } as unknown as CanvasRenderingContext2D
+}
+
+const MS_PER_DRAW = 3
+const DRAWS_PER_FRAME = 3 // 3ms/张 × 8ms 预算:画到第 3 张(9ms ≥ 8ms)让帧
+
+let drawCount = 0
+let fakeNowMs = 0
+let rafQueue: FrameRequestCallback[]
+
+const runFrame = () => {
+  const callbacks = rafQueue.splice(0)
+  for (const callback of callbacks) callback(0)
+}
+
+describe('demoAssets 时间预算分批 + 取消语义(#506 三轮 F2)', () => {
+  beforeEach(() => {
+    drawCount = 0
+    fakeNowMs = 0
+    rafQueue = []
+    vi.stubGlobal('requestAnimationFrame', (callback: FrameRequestCallback) => {
+      rafQueue.push(callback)
+      return rafQueue.length
+    })
+    vi.stubGlobal('performance', { now: () => fakeNowMs })
+    vi.spyOn(HTMLCanvasElement.prototype, 'getContext').mockImplementation((() => makeFake2dCtx()) as never)
+    Object.defineProperty(HTMLCanvasElement.prototype, 'toBlob', {
+      configurable: true,
+      value: function toBlob(cb: (blob: Blob) => void) {
+        drawCount += 1
+        fakeNowMs += MS_PER_DRAW // 每张画耗 3ms 假钟
+        cb(new Blob(['demo-jpeg-bytes'], { type: 'image/jpeg' }))
+      },
+    })
+  })
+  afterEach(() => {
+    for (let i = 0; i < 60 && (rafQueue.length > 0 || __demoDrawQueueSize() > 0); i += 1) runFrame()
+    vi.unstubAllGlobals()
+    vi.restoreAllMocks()
+  })
+
+  it('时间预算:100 张入队零同步绘制;每帧画到超 8ms 预算即让帧(3ms/张 → 每帧恰 3 张)', async () => {
+    const promises = Array.from({ length: 100 }, (_, index) => renderDemoImageBlob(stressDemoAssetUrl(index)))
+    expect(drawCount).toBe(0) // 同帧 mount 100 个节点:主线程零同步绘制
+    expect(DEMO_DRAW_FRAME_BUDGET_MS).toBe(8)
+
+    let frames = 0
+    while (__demoDrawQueueSize() > 0 && frames < 60) {
+      const before = drawCount
+      runFrame()
+      frames += 1
+      expect(drawCount - before).toBeLessThanOrEqual(DRAWS_PER_FRAME) // 超预算即让帧
+    }
+    expect(drawCount).toBe(100)
+    expect(frames).toBe(Math.ceil(100 / DRAWS_PER_FRAME)) // 100 张分布在 34 帧
+    const blobs = await Promise.all(promises)
+    expect(blobs.every((blob) => blob instanceof Blob)).toBe(true)
+  })
+
+  it('全量离场取消:100 请求在首帧前全部 cancel → 队列空、promise 全 resolve null、后续零绘制', async () => {
+    const requests = Array.from({ length: 100 }, (_, index) => requestDemoImageDraw(stressDemoAssetUrl(index)))
+    expect(__demoDrawQueueSize()).toBe(100)
+    for (const request of requests) request.cancel()
+    expect(__demoDrawQueueSize()).toBe(0) // 队列即刻清空
+    runFrame()
+    expect(drawCount).toBe(0) // stale 绘制一张都不画
+    const results = await Promise.all(requests.map((r) => r.promise))
+    expect(results.every((blob) => blob === null)).toBe(true)
+  })
+
+  it('中途取消:画了一帧后取消剩余 → 已开始的照常完成,未开始的移除;cancel 幂等', async () => {
+    const requests = Array.from({ length: 10 }, (_, index) => requestDemoImageDraw(stressDemoAssetUrl(index)))
+    runFrame() // 画 3 张
+    expect(drawCount).toBe(DRAWS_PER_FRAME)
+    for (const request of requests) {
+      request.cancel()
+      request.cancel() // 幂等
+    }
+    expect(__demoDrawQueueSize()).toBe(0)
+    runFrame()
+    expect(drawCount).toBe(DRAWS_PER_FRAME) // 取消后零新绘制
+    const results = await Promise.all(requests.map((r) => r.promise))
+    expect(results.slice(0, DRAWS_PER_FRAME).every((blob) => blob instanceof Blob)).toBe(true) // 已开始的画完
+    expect(results.slice(DRAWS_PER_FRAME).every((blob) => blob === null)).toBe(true)
+  })
+
+  it('新请求不被 stale job 阻塞:旧场景 100 张取消后,新请求首帧即画', async () => {
+    const stale = Array.from({ length: 100 }, (_, index) => requestDemoImageDraw(stressDemoAssetUrl(index)))
+    for (const request of stale) request.cancel() // 场景切换:全部离场
+    const fresh = renderDemoImageBlob(stressDemoAssetUrl(42))
+    expect(__demoDrawQueueSize()).toBe(1) // 队列里只有新请求
+    runFrame()
+    expect(drawCount).toBe(1)
+    expect(await fresh).toBeInstanceOf(Blob)
+  })
+
+  it('非法引用不入队直接 resolve null,不占帧预算', async () => {
+    expect(await renderDemoImageBlob('mivo-demo:stress/999')).toBeNull()
+    expect(__demoDrawQueueSize()).toBe(0)
+    expect(drawCount).toBe(0)
+  })
+
+  it('rAF 缺失环境:setTimeout 0 降级路径照常分批(审核补强项)', async () => {
+    // 手工 setTimeout 桩(vitest 假计时器会把同一虚拟时刻的链式 0ms timer 一口气
+    // 跑完,看不出分批)——逐"帧"手动放行,口径与 rAF 桩一致。
+    const timeoutQueue: Array<() => void> = []
+    vi.stubGlobal('requestAnimationFrame', undefined)
+    vi.stubGlobal('setTimeout', ((cb: () => void) => {
+      timeoutQueue.push(cb)
+      return 0
+    }) as never)
+    const runTimeoutFrame = () => {
+      const callbacks = timeoutQueue.splice(0)
+      for (const callback of callbacks) callback()
+    }
+    const promises = Array.from({ length: 7 }, (_, index) => renderDemoImageBlob(stressDemoAssetUrl(index)))
+    expect(drawCount).toBe(0)
+    runTimeoutFrame() // 第一批(3 张)
+    expect(drawCount).toBe(DRAWS_PER_FRAME)
+    runTimeoutFrame()
+    expect(drawCount).toBe(DRAWS_PER_FRAME * 2)
+    runTimeoutFrame()
+    expect(drawCount).toBe(7)
+    vi.unstubAllGlobals()
+    const blobs = await Promise.all(promises)
+    expect(blobs.every((blob) => blob instanceof Blob)).toBe(true)
+  })
+})
