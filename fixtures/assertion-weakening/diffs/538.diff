+import { describe, expect, it } from 'vitest'
+
+// #506:mivo-demo: 引用编解码与参数推导的纯函数契约。参数矩阵是渲染的单一
+// 真相源——demoScenes 种子与 v13 迁移都只存引用,同一引用必须永远推导出同一
+// 组绘制参数(否则迁移后老用户看到的图与原 base64 不一致)。
+
+import {
+  DEMO_ASSET_URL_PREFIX,
+  STRESS_DEMO_NODE_COUNT,
+  isDemoAssetUrl,
+  parseDemoAssetUrl,
+  stressDemoAssetUrl,
+  stressDemoImageOptions,
+} from './demoAssets'
+
+describe('demoAssets — mivo-demo: 引用编解码(#506)', () => {
+  it('编码/判定:stressDemoAssetUrl 产出 mivo-demo:stress/<index>,isDemoAssetUrl 识别', () => {
+    expect(stressDemoAssetUrl(0)).toBe('mivo-demo:stress/0')
+    expect(stressDemoAssetUrl(99)).toBe('mivo-demo:stress/99')
+    expect(isDemoAssetUrl(stressDemoAssetUrl(42))).toBe(true)
+    expect(isDemoAssetUrl('mivo-asset:abc')).toBe(false)
+    expect(isDemoAssetUrl('data:image/jpeg;base64,xxx')).toBe(false)
+    expect(isDemoAssetUrl(undefined)).toBe(false)
+    expect(DEMO_ASSET_URL_PREFIX).toBe('mivo-demo:')
+  })
+
+  it('round-trip:parse(encode(i)) 的参数与 stressDemoImageOptions(i) 全等(0..99)', () => {
+    for (let index = 0; index < STRESS_DEMO_NODE_COUNT; index += 1) {
+      expect(parseDemoAssetUrl(stressDemoAssetUrl(index))).toEqual(stressDemoImageOptions(index))
+    }
+  })
+
+  it('参数矩阵与旧 demoScenes 内联逐字段一致(迁移后图案不变的依据)', () => {
+    // 旧实现:label=R{i+1};mood 按 i%3 轮转;seed=3000+(i%12);accent/secondary 按 i%4 取色板
+    expect(stressDemoImageOptions(0)).toEqual({ label: 'R1', mood: 'character', seed: 3000, accent: '#a85232', secondary: '#d9c098' })
+    expect(stressDemoImageOptions(1)).toEqual({ label: 'R2', mood: 'variant', seed: 3001, accent: '#557463', secondary: '#a9beb0' })
+    expect(stressDemoImageOptions(2)).toEqual({ label: 'R3', mood: 'environment', seed: 3002, accent: '#566d89', secondary: '#b5c0d0' })
+    expect(stressDemoImageOptions(14)).toEqual({ label: 'R15', mood: 'environment', seed: 3002, accent: '#566d89', secondary: '#b5c0d0' })
+  })
+
+  it('parse 拒绝不合法引用(未知路径/越界 index/非数字)→ null,不抛', () => {
+    expect(parseDemoAssetUrl('mivo-demo:unknown/1')).toBeNull()
+    expect(parseDemoAssetUrl('mivo-demo:stress/100')).toBeNull() // 越界
+    expect(parseDemoAssetUrl('mivo-demo:stress/-1')).toBeNull()
+    expect(parseDemoAssetUrl('mivo-demo:stress/abc')).toBeNull()
+    expect(parseDemoAssetUrl('mivo-asset:xyz')).toBeNull()
+  })
+})
