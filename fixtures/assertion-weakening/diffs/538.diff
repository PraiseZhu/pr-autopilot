+    }
+    ls().setItem(
+      NAME,
+      JSON.stringify(
+        v12Blob({
+          'my-board': {
+            title: '我的画布',
+            nodes: [userNode],
+            edges: [],
+            tasks: [],
+            selectedNodeId: undefined,
+            selectedNodeIds: [],
+          },
+        }),
+      ),
+    )
+    await useCanvasStore.persist.rehydrate()
+    expect(useCanvasStore.getState().canvases['my-board'].nodes[0].assetUrl).toBe('data:image/png;base64,USERBYTES')
+  })
+
+  // ── F1 对抗五例(复审裁定:歧义一律保留原 data URL,禁止取模/禁止 fallback)──
+  const seedUserCanvas = (node: Record<string, unknown>) =>
+    ls().setItem(
+      NAME,
+      JSON.stringify(
+        v12Blob({
+          'my-board': { title: '我的画布', nodes: [node], edges: [], tasks: [], selectedNodeId: undefined, selectedNodeIds: [] },
+        }),
+      ),
+    )
+  const expectUntouched = async (nodeId: string, expected: string) => {
+    await useCanvasStore.persist.rehydrate()
+    const node = useCanvasStore.getState().canvases['my-board'].nodes.find((n) => n.id === nodeId)!
+    expect(node.assetUrl).toBe(expected)
+  }
+
+  it('对抗① id 撞车:stress-999(非 0..99 完整形)→ 不动,禁止取模成 99', async () => {
+    seedUserCanvas({ ...stressSeedNode(99), id: 'stress-999' })
+    await expectUntouched('stress-999', FAKE_BASE64)
+  })
+
+  it('对抗② prompt 撞车:复制链 id 合法但 model 与 seed 推导不一致 → 签名不完整,不动', async () => {
