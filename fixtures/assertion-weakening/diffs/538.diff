+// 此前 demoScenes 的 stress-test 场景在 store 初始化时同步生成 100 张 base64
+// data URL(20-40KB/张)塞进节点 assetUrl:base64 进 store、进持久化 blob(全新
+// 用户第一天就背几 MB),模块级 imageCache 还把全量 data URL 常驻堆。现在节点只
+// 存 `mivo-demo:stress/<index>` 微型引用,渲染时经 assetStorage.resolveAssetUrl +
+// assetUrlLease 惰性绘制成 blob URL(引用计数归零即 revoke)。绘制函数自
+// demoImages.ts 原样迁移;demoImages.ts 保留 createDemoImage 兼容出口(无缓存)。
+
+export type DemoImageOptions = {
+  label: string
+  accent: string
+  secondary: string
+  mood: 'character' | 'environment' | 'variant' | 'asset'
+  seed: number
+}
+
+const seededRandom = (seed: number) => {
+  let value = seed % 2147483647
+  if (value <= 0) value += 2147483646
+  return () => {
+    value = (value * 16807) % 2147483647
+    return (value - 1) / 2147483646
+  }
+}
+
+const addNoise = (
+  ctx: CanvasRenderingContext2D,
+  width: number,
+  height: number,
+  seed: number,
+) => {
+  const random = seededRandom(seed)
+  const imageData = ctx.getImageData(0, 0, width, height)
+  const { data } = imageData
+
+  for (let index = 0; index < data.length; index += 4) {
+    const n = (random() - 0.5) * 18
+    data[index] += n
+    data[index + 1] += n
+    data[index + 2] += n
+  }
+
+  ctx.putImageData(imageData, 0, 0)
+}
+
+const roundedRect = (
+  ctx: CanvasRenderingContext2D,
+  x: number,
+  y: number,
+  width: number,
+  height: number,
+  radius: number,
+) => {
+  const r = Math.min(radius, width / 2, height / 2)
+  ctx.beginPath()
+  ctx.moveTo(x + r, y)
+  ctx.arcTo(x + width, y, x + width, y + height, r)
+  ctx.arcTo(x + width, y + height, x, y + height, r)
+  ctx.arcTo(x, y + height, x, y, r)
+  ctx.arcTo(x, y, x + width, y, r)
+  ctx.closePath()
+}
+
+const drawCharacter = (
+  ctx: CanvasRenderingContext2D,
+  options: DemoImageOptions,
+  random: () => number,
+) => {
+  const { accent, secondary } = options
+  ctx.save()
+  ctx.translate(160 + random() * 22, 105)
+
+  ctx.fillStyle = 'rgba(255,255,255,0.66)'
+  roundedRect(ctx, 80, 260, 155, 52, 18)
+  ctx.fill()
+
+  ctx.fillStyle = secondary
+  roundedRect(ctx, 74, 114, 168, 230, 72)
+  ctx.fill()
+
+  ctx.fillStyle = accent
+  ctx.beginPath()
+  ctx.ellipse(158, 108, 72, 88, -0.08, 0, Math.PI * 2)
+  ctx.fill()
+
+  ctx.fillStyle = 'rgba(18, 22, 26, 0.88)'
+  roundedRect(ctx, 92, 52, 132, 108, 48)
+  ctx.fill()
+
+  ctx.fillStyle = '#f3c7a2'
+  ctx.beginPath()
+  ctx.ellipse(158, 136, 54, 60, 0, 0, Math.PI * 2)
+  ctx.fill()
+
+  ctx.fillStyle = 'rgba(20, 24, 28, 0.9)'
+  ctx.beginPath()
+  ctx.ellipse(139, 130, 5, 7, 0, 0, Math.PI * 2)
+  ctx.ellipse(177, 130, 5, 7, 0, 0, Math.PI * 2)
+  ctx.fill()
+
+  ctx.strokeStyle = 'rgba(20, 24, 28, 0.58)'
+  ctx.lineWidth = 3
+  ctx.beginPath()
+  ctx.arc(158, 151, 16, 0.15, Math.PI - 0.15)
+  ctx.stroke()
+
+  ctx.fillStyle = 'rgba(255,255,255,0.34)'
+  for (let i = 0; i < 26; i += 1) {
+    const x = 42 + random() * 238
+    const y = 22 + random() * 330
+    ctx.fillRect(x, y, 2 + random() * 6, 2 + random() * 6)
+  }
+
+  ctx.restore()
+}
+
+const drawEnvironment = (
+  ctx: CanvasRenderingContext2D,
+  options: DemoImageOptions,
+  random: () => number,
+) => {
+  const { accent, secondary } = options
+
+  ctx.fillStyle = 'rgba(255,255,255,0.48)'
+  ctx.beginPath()
+  ctx.moveTo(0, 302)
+  for (let x = 0; x <= 320; x += 18) {
+    ctx.lineTo(x, 258 + random() * 46)
+  }
+  ctx.lineTo(320, 420)
+  ctx.lineTo(0, 420)
+  ctx.fill()
+
+  ctx.fillStyle = secondary
+  ctx.beginPath()
+  ctx.moveTo(0, 244)
+  for (let x = 0; x <= 320; x += 22) {
+    ctx.lineTo(x, 168 + random() * 56)
+  }
+  ctx.lineTo(320, 420)
+  ctx.lineTo(0, 420)
+  ctx.fill()
+
+  ctx.fillStyle = accent
+  for (let i = 0; i < 9; i += 1) {
+    const x = 28 + random() * 236
+    const y = 96 + random() * 180
+    roundedRect(ctx, x, y, 28 + random() * 44, 84 + random() * 96, 12)
+    ctx.fill()
+  }
+
+  ctx.strokeStyle = 'rgba(255,255,255,0.52)'
+  ctx.lineWidth = 2
+  for (let i = 0; i < 14; i += 1) {
+    const x = 18 + random() * 284
+    ctx.beginPath()
+    ctx.moveTo(x, 44)
+    ctx.lineTo(x + 18 - random() * 36, 360)
+    ctx.stroke()
+  }
+}
+
+const drawVariant = (
+  ctx: CanvasRenderingContext2D,
+  options: DemoImageOptions,
+  random: () => number,
+) => {
+  const { accent, secondary } = options
+  ctx.fillStyle = 'rgba(255,255,255,0.7)'
+  ctx.beginPath()
+  ctx.ellipse(160, 216, 116, 144, -0.08 + random() * 0.18, 0, Math.PI * 2)
+  ctx.fill()
+
+  ctx.fillStyle = secondary
+  ctx.beginPath()
+  ctx.ellipse(160, 174, 92, 96, random() * 0.2, 0, Math.PI * 2)
+  ctx.fill()
+
+  ctx.strokeStyle = accent
+  ctx.lineWidth = 12
+  ctx.beginPath()
+  ctx.arc(160, 198, 86, 0.2, Math.PI * 1.72)
+  ctx.stroke()
+
+  ctx.fillStyle = accent
+  for (let i = 0; i < 18; i += 1) {
+    ctx.beginPath()
+    ctx.arc(70 + random() * 180, 70 + random() * 260, 3 + random() * 9, 0, Math.PI * 2)
+    ctx.fill()
+  }
+}
+
+const drawAsset = (
+  ctx: CanvasRenderingContext2D,
+  options: DemoImageOptions,
+  random: () => number,
+) => {
+  const { accent, secondary } = options
+  for (let i = 0; i < 7; i += 1) {
+    ctx.fillStyle = i % 2 ? accent : secondary
+    roundedRect(ctx, 34 + i * 27, 92 + random() * 22, 88, 220 - i * 16, 24)
+    ctx.fill()
+  }
+
+  ctx.fillStyle = 'rgba(255,255,255,0.78)'
+  roundedRect(ctx, 74, 266, 176, 68, 18)
+  ctx.fill()
+}
+
+
+/** 绘制一张 demo 图到离屏 canvas(无缓存——调用方经 assetUrlLease 引用计数
+ *  共享/回收,不再有常驻 data URL 的模块级 Map)。无 DOM/2d 上下文(node 测试
+ *  环境)返回 null。 */
+export const drawDemoImage = (options: DemoImageOptions): HTMLCanvasElement | null => {
+  if (typeof document === 'undefined' || typeof document.createElement !== 'function') return null
+  const width = 320
+  const height = 420
+  const canvas = document.createElement('canvas')
+  canvas.width = width
+  canvas.height = height
+  const ctx = canvas.getContext('2d')
+  if (!ctx) return null
+
+  const random = seededRandom(options.seed)
+  const gradient = ctx.createLinearGradient(0, 0, width, height)
+  gradient.addColorStop(0, '#f6f1e7')
+  gradient.addColorStop(0.44, options.secondary)
+  gradient.addColorStop(1, '#26332f')
+  ctx.fillStyle = gradient
+  ctx.fillRect(0, 0, width, height)
+
+  ctx.globalAlpha = 0.16
+  ctx.strokeStyle = '#ffffff'
+  ctx.lineWidth = 1
+  for (let x = -40; x < width + 40; x += 28) {
+    ctx.beginPath()
+    ctx.moveTo(x, 0)
+    ctx.lineTo(x + 118, height)
+    ctx.stroke()
+  }
+  ctx.globalAlpha = 1
+
+  if (options.mood === 'character') drawCharacter(ctx, options, random)
+  if (options.mood === 'environment') drawEnvironment(ctx, options, random)
+  if (options.mood === 'variant') drawVariant(ctx, options, random)
+  if (options.mood === 'asset') drawAsset(ctx, options, random)
+
+  addNoise(ctx, width, height, options.seed)
+
+  ctx.fillStyle = 'rgba(15, 18, 20, 0.72)'
+  roundedRect(ctx, 18, 360, 284, 38, 13)
+  ctx.fill()
+
+  ctx.fillStyle = 'rgba(255,255,255,0.92)'
+  ctx.font = '700 18px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont'
+  ctx.fillText(options.label, 34, 385)
+
+  return canvas
+}
+
+// ── mivo-demo: 引用(#506)────────────────────────────────────────────────────
+// demo 图不再以 base64 data URL 进 store/持久化——节点只存微型引用
+// `mivo-demo:stress/<index>`,渲染时经 assetUrlLease 惰性生成 blob URL(引用
+// 计数归零即 revoke,离开场景自动释放)。参数从 index 确定性推导(与旧
+// demoScenes 内联矩阵逐字段一致),同一引用永远渲染同一张图。
+
+export const DEMO_ASSET_URL_PREFIX = 'mivo-demo:'
+
+export const isDemoAssetUrl = (assetUrl?: string): assetUrl is string =>
+  Boolean(assetUrl && assetUrl.startsWith(DEMO_ASSET_URL_PREFIX))
+
+export const STRESS_DEMO_NODE_COUNT = 100
+
+const STRESS_ACCENTS = ['#a85232', '#557463', '#566d89', '#7b5b4e'] as const
+const STRESS_SECONDARIES = ['#d9c098', '#a9beb0', '#b5c0d0', '#d4b89d'] as const
+
+/** stress-test 第 index 张图的绘制参数(单一真相源;demoScenes 种子与 v13 迁移
+ *  重建都从这里推导,不得再内联复制矩阵)。 */
+export const stressDemoImageOptions = (index: number): DemoImageOptions => ({
+  label: `R${index + 1}`,
+  mood: index % 3 === 0 ? 'character' : index % 3 === 1 ? 'variant' : 'environment',
+  seed: 3000 + (index % 12),
+  accent: STRESS_ACCENTS[index % 4],
+  secondary: STRESS_SECONDARIES[index % 4],
+})
+
+export const stressDemoAssetUrl = (index: number): string => `${DEMO_ASSET_URL_PREFIX}stress/${index}`
+
+/** 解析 mivo-demo: 引用 → 绘制参数;不认识的形状返回 null(渲染侧落 error 态,
+ *  不抛)。index 夹取到 [0, 99] 防越界引用产生 NaN 参数。 */
+export const parseDemoAssetUrl = (assetUrl: string): DemoImageOptions | null => {
+  if (!isDemoAssetUrl(assetUrl)) return null
+  const match = /^mivo-demo:stress\/(\d{1,3})$/.exec(assetUrl)
+  if (!match) return null
+  const index = Number(match[1])
+  if (!Number.isInteger(index) || index < 0 || index >= STRESS_DEMO_NODE_COUNT) return null
+  return stressDemoImageOptions(index)
+}
+
+// ── 分批绘制调度(#506 复审 F4 / 三轮 F2)──────────────────────────────────────
+// 首入 stress 场景时 100 个节点同帧 mount → 100 次 acquire 同帧同步画完 = 主线程
+// ~300ms 长任务。绘制请求进队列,每帧(rAF;无 rAF 环境退 setTimeout 0)按**时间
+// 预算**切片(DEMO_DRAW_FRAME_BUDGET_MS,每帧至少画 1 张、超预算即让帧——固定
+// 张数在慢机上单帧仍可能超 30ms)。job 携带取消句柄(requestDemoImageDraw 返回
+// {promise, cancel}):最后消费者在 job 开始前离场 → 从队列移除并 resolve null,
+// stale 绘制不再跨帧抢占新场景,新请求也不会排在已离场的 job 之后;已开始的
+// job 照常画完。未绘完时渲染层照常按异步加载占位(Leafer Image 本就异步)。
+
+export const DEMO_DRAW_FRAME_BUDGET_MS = 8
+
+type QueuedDemoDraw = {
+  options: DemoImageOptions
+  started: boolean
+  cancelled: boolean
+  resolve: (blob: Blob | null) => void
+}
+
+const demoDrawQueue: QueuedDemoDraw[] = []
+let demoDrawPumpScheduled = false
+
+const demoDrawNow = (): number =>
+  typeof performance !== 'undefined' && typeof performance.now === 'function' ? performance.now() : Date.now()
+
+const scheduleDemoDrawFrame = (run: () => void): void => {
+  if (typeof requestAnimationFrame === 'function') {
+    requestAnimationFrame(() => run())
+    return
+  }
+  setTimeout(run, 0)
+}
+
+const drawQueuedDemoImage = (job: QueuedDemoDraw): void => {
+  const canvas = drawDemoImage(job.options)
+  if (!canvas) {
+    job.resolve(null)
+    return
+  }
+  if (typeof canvas.toBlob === 'function') {
+    canvas.toBlob((blob) => job.resolve(blob), 'image/jpeg', 0.78)
+    return
+  }
+  // toBlob 不可用的极端环境:退回 data URL 转 Blob(仍不进 store,仅本次渲染)。
+  try {
+    const dataUrl = canvas.toDataURL('image/jpeg', 0.78)
+    const [, base64] = dataUrl.split(',')
+    const bytes = Uint8Array.from(atob(base64), (c) => c.charCodeAt(0))
+    job.resolve(new Blob([bytes], { type: 'image/jpeg' }))
+  } catch {
+    job.resolve(null)
+  }
+}
+
+const pumpDemoDrawQueue = (): void => {
+  demoDrawPumpScheduled = false
+  const frameStart = demoDrawNow()
+  // 时间预算切片:每帧至少推进 1 张(否则慢机上永不前进),超预算即让帧。
+  while (demoDrawQueue.length > 0) {
+    const job = demoDrawQueue.shift()!
+    job.started = true
+    drawQueuedDemoImage(job)
+    if (demoDrawNow() - frameStart >= DEMO_DRAW_FRAME_BUDGET_MS) break
+  }
+  if (demoDrawQueue.length > 0) scheduleDemoDrawPump()
+}
+
+const scheduleDemoDrawPump = (): void => {
+  if (demoDrawPumpScheduled) return
+  demoDrawPumpScheduled = true
+  scheduleDemoDrawFrame(pumpDemoDrawQueue)
+}
+
+export type DemoImageDrawRequest = {
+  promise: Promise<Blob | null>
+  /** 取消句柄:job 尚未开始 → 从队列移除并 resolve null(幂等);已开始/已完成
+   *  → no-op(本批画完,不中断)。 */
+  cancel: () => void
+}
+
+/** mivo-demo: 引用 → 可取消的绘制请求(惰性,无缓存,经时间预算分批调度)。
+ *  引用不合法立即 resolve null 且不占帧预算。 */
+export const requestDemoImageDraw = (assetUrl: string): DemoImageDrawRequest => {
+  const options = parseDemoAssetUrl(assetUrl)
+  if (!options) return { promise: Promise.resolve(null), cancel: () => undefined }
+  let resolveFn: (blob: Blob | null) => void = () => undefined
+  const promise = new Promise<Blob | null>((resolve) => {
+    resolveFn = resolve
+  })
+  const job: QueuedDemoDraw = { options, started: false, cancelled: false, resolve: resolveFn }
+  demoDrawQueue.push(job)
+  scheduleDemoDrawPump()
+  return {
+    promise,
+    cancel: () => {
+      if (job.started || job.cancelled) return
+      job.cancelled = true
+      const index = demoDrawQueue.indexOf(job)
+      if (index >= 0) demoDrawQueue.splice(index, 1)
+      job.resolve(null)
+    },
+  }
+}
+
+/** mivo-demo: 引用 → JPEG Blob(不可取消形态:下载/剪贴板/图生图等一次性消费方
+ *  明确要等结果)。 */
+export const renderDemoImageBlob = (assetUrl: string): Promise<Blob | null> =>
+  requestDemoImageDraw(assetUrl).promise
+
+/** 测试观测:当前排队未开始的绘制 job 数。 */
+export const __demoDrawQueueSize = (): number => demoDrawQueue.length
