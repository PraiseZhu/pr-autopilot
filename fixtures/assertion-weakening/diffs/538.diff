+vi.hoisted(() => {
+  const store = new Map<string, string>()
+  const memStorage = {
+    get length() {
+      return store.size
+    },
+    clear: () => store.clear(),
+    getItem: (k: string) => store.get(k) ?? null,
+    key: (i: number) => [...store.keys()][i] ?? null,
+    removeItem: (k: string) => {
+      store.delete(k)
+    },
+    setItem: (k: string, v: string) => {
+      store.set(k, String(v))
+    },
+  }
+  const g = globalThis as Record<string, unknown>
+  if (g.window === undefined) g.window = { localStorage: memStorage }
+  if (g.localStorage === undefined) g.localStorage = memStorage
+})
+
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+vi.mock('../lib/assetStorage', () => ({
+  saveGeneratedAsset: vi.fn(),
+  saveImportedAsset: vi.fn(),
+  readImportedAssetFile: vi.fn(),
+}))
+vi.mock('./remoteDebugReporter', () => ({
+  reportRemoteDebugEntry: () => {},
+}))
+
+import { useCanvasStore } from './canvasStore'
+import { canvasPersistOptions, flushCanvasPersistWrite, __resetCanvasPersistStorageForTests } from './canvasPersistConfig'
+import { modelNames } from './demoScenes'
+import { createNodeCopy } from './nodeFactory'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+import type { CanvasState } from './canvasStore'
+
+const NAME = 'mivo-canvas-demo'
+const ls = () =>
+  (globalThis as unknown as {
+    localStorage: { setItem: (k: string, v: string) => void; getItem: (k: string) => string | null; clear: () => void }
+  }).localStorage
+
+// 逼真的 base64 载荷(~26KB/张,与旧 demo 图同量级)——体积断言要在真实量级上做。
+const FAKE_BASE64 = `data:image/jpeg;base64,${'A'.repeat(26_000)}`
+
+const stressSeedNode = (index: number): MivoCanvasNode =>
+  ({
+    id: `stress-${index}`,
+    type: 'image',
+    title: `Result ${String(index + 1).padStart(3, '0')}`,
+    x: (index % 10) * 162 - 740,
+    y: Math.floor(index / 10) * 214 - 520,
+    width: 132,
+    height: 174,
+    status: 'ready',
+    assetUrl: FAKE_BASE64,
+    generation: {
+      prompt: '批量结果压力测试节点',
+      model: modelNames[index % modelNames.length], // 完整签名:model 与 seed 推导一致
+      size: '768x1024',
+      seed: 7000 + index,
+    },
+  }) as unknown as MivoCanvasNode
+
+const v12Blob = (extraCanvases: Record<string, unknown> = {}) => ({
+  state: {
+    canvases: {
+      'stress-test': {
+        title: '100 张图片压力测试',
+        nodes: Array.from({ length: 100 }, (_, index) => stressSeedNode(index)),
+        edges: [],
+        tasks: [],
+        selectedNodeId: undefined,
+        selectedNodeIds: [],
+      },
+      ...extraCanvases,
+    },
+    sceneId: 'stress-test',
+    selectedNodeId: undefined,
+    selectedNodeIds: [],
+    activeTool: 'select',
+  },
+  version: 12,
+})
+
+beforeEach(() => {
+  ls().clear()
+  useCanvasStore.setState({ ...useCanvasStore.getInitialState() } as never, true)
+  // #532(写防抖 + 冻结目标)后:丢弃上一测试的暂存写 + read-your-writes 快照,
+  // 否则 seed 底层后 getItem 会按语义正确地返回旧快照/被迟发防抖写覆盖(参照
+  // canvasStore.hydrationMigration.contract.test.ts 的同款隔离)。
+  __resetCanvasPersistStorageForTests()
+})
+
+describe('#506 新用户基线:初始持久化输出零 base64、体积几十 KB 量级', () => {
+  it('partialize(初始态) 无 data:image;envelope 体积 < 200KB(旧基线 2-4MB)', () => {
+    const partialized = canvasPersistOptions.partialize(useCanvasStore.getState() as CanvasState)
+    const envelope = JSON.stringify({ state: partialized, version: 13 })
+    expect(envelope.includes('data:image')).toBe(false)
+    expect(envelope.length).toBeLessThan(200_000)
+    // stress 种子节点存的是微型引用
+    const stressNode = (partialized as { canvases: Record<string, { nodes: MivoCanvasNode[] }> }).canvases[
+      'stress-test'
+    ].nodes.find((n) => n.id === 'stress-42')
+    expect(stressNode?.assetUrl).toBe('mivo-demo:stress/42')
+  })
+})
+
+describe('#506 v13 迁移:存量 base64 demo 节点清洗(真实 rehydrate + 磁盘读回验证)', () => {
+  it('v12 blob(100×26KB base64)→ rehydrate → 内存节点为 mivo-demo: 引用;迁移写回后磁盘 blob 零 data:image、version=13、体积坍缩', async () => {
+    const seeded = JSON.stringify(v12Blob())
+    expect(seeded.length).toBeGreaterThan(2_000_000) // 前提自检:确实在 MB 量级上做断言
+    ls().setItem(NAME, seeded)
+
+    await useCanvasStore.persist.rehydrate()
+
+    // 内存:全部 stress 节点洗成对应 index 的引用(位置等其余字段不动)
+    const doc = useCanvasStore.getState().canvases['stress-test']
+    expect(doc.nodes).toHaveLength(100)
+    expect(doc.nodes.every((n) => n.assetUrl === `mivo-demo:stress/${/stress-(\d+)/.exec(n.id)?.[1]}`)).toBe(true)
+    expect(doc.nodes[7].x).toBe(7 * 162 - 740) // 内容字段未被重置
+
+    // F2(镜像原子同步):normalize 会把旧 assetUrl 镜像进 asset.url 与 image fill,
+    // 只改 legacy 字段会让 kernel 三域投影继续携带 base64——**完整节点 JSON** 断言
+    // 三处镜像全部同步(compact 会裁掉镜像,磁盘断言单独看不出来,这里必须看内存全量)。
+    const fullNodeJson = JSON.stringify(doc.nodes)
+    expect(fullNodeJson.includes('data:image')).toBe(false)
+    expect(doc.nodes[7].asset?.url).toBe('mivo-demo:stress/7')
+    const imageFill = doc.nodes[7].fills?.find((fill) => fill.kind === 'image')
+    expect(imageFill?.assetUrl).toBe('mivo-demo:stress/7')
+    // kernel 三域投影同样干净(kernel=new 真实 canonical 落盘断言见 docKernelPersistVersion.test)
+    const { projectToThreeDomain } = await import('../kernel/persistMigration')
+    const projected = projectToThreeDomain({
+      canvases: useCanvasStore.getState().canvases,
+      sceneId: 'stress-test',
+    } as never)
+    expect(JSON.stringify(projected.document).includes('data:image')).toBe(false)
+
+    // 磁盘读回验证(S01/S02):zustand 版本迁移触发写回;#532 后写回走防抖调度器,
+    // 先冲刷到落定再看盘。
+    await flushCanvasPersistWrite('migration-writeback-drain')
+    const written = ls().getItem(NAME)
+    expect(written).not.toBeNull()
+    expect(written!.includes('data:image')).toBe(false)
+    expect(written!.length).toBeLessThan(300_000) // MB → 几十/百 KB 量级
+    expect((JSON.parse(written!) as { version: number }).version).toBe(13)
+  })
+
+  it('真实复制链(三轮 F1):createNodeCopy 单次与多段副本同样清洗——id root 与 seed 一致', async () => {
+    // 生产真格式:nodeFactory.createNodeCopy → `${source.id}-copy-<timestamp>-<index>`,可多段
+    const singleCopy = createNodeCopy(stressSeedNode(23), 0)
+    const chainedCopy = createNodeCopy(createNodeCopy(stressSeedNode(7), 1), 2)
+    expect(singleCopy.id).toMatch(/^stress-23-copy-\d+-0$/) // 夹具自检:确实是生产 id 形态
+    expect(chainedCopy.id).toMatch(/^stress-7-copy-\d+-1-copy-\d+-2$/)
+    ls().setItem(
+      NAME,
+      JSON.stringify(
+        v12Blob({
+          'my-board': {
+            title: '我的画布',
+            nodes: [singleCopy, chainedCopy],
+            edges: [],
+            tasks: [],
+            selectedNodeId: undefined,
+            selectedNodeIds: [],
+          },
+        }),
+      ),
+    )
+    await useCanvasStore.persist.rehydrate()
+    const myBoard = useCanvasStore.getState().canvases['my-board']
+    const single = myBoard.nodes.find((n) => n.id === singleCopy.id)!
+    const chained = myBoard.nodes.find((n) => n.id === chainedCopy.id)!
+    expect(single.assetUrl).toBe('mivo-demo:stress/23')
+    expect(chained.assetUrl).toBe('mivo-demo:stress/7')
+    // 内存全量(含镜像)与盘上均零 data:image(盘上断言先冲刷防抖写回)
+    expect(JSON.stringify(myBoard.nodes).includes('data:image')).toBe(false)
+    await flushCanvasPersistWrite('migration-writeback-drain')
+    expect(ls().getItem(NAME)!.includes('data:image')).toBe(false)
+  })
+
+  it('边界:无种子指纹的用户 data: 图一律不动(不猜测非 demo 内容出处)', async () => {
