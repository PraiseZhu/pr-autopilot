@@ -0,0 +1,150 @@
+// @vitest-environment happy-dom
+import 'fake-indexeddb/auto'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #506 复审 F3:三域 schema 版本(11,磁盘布局)与 zustand persist 逻辑版本
+// (CANVAS_PERSIST_VERSION=13)分离。此前 adapter getItem 恒报 11 → kernel=new
+// 每次启动重跑 v12/v13 迁移并全量写回。契约(#532 会师后走冻结目标 + 写防抖
+// 调度器,persistVersion 随原子批存入 document 记录):
+// - 历史 canonical(无 persistVersion 字段)首启按 11 报 → 迁移链恰跑一次,
+//   写回后 document 记录 version 仍 =11(schema)、persistVersion=13(逻辑);
+// - 真实 IDB commit 口径的 #506 断言:写回后 canonical 里零 data:image;
+// - 第二次 rehydrate:adapter 报 13 → 零迁移零重写(调度器无入队写,记录字节不变)。
+
+vi.mock('../app/kernelMode', () => ({
+  kernelMode: 'new',
+  getKernelMode: () => 'new',
+  isLegacyKernel: false,
+  isNewKernel: true,
+  getEffectiveKernelMode: () => 'new',
+  isLegacyKernelEffective: () => false,
+  degradeKernelToLegacyForSession: () => {},
+  ensureEffectiveKernelReady: () => Promise.resolve(),
+  warnIfEffectiveKernelBootPending: () => {},
+  __resetKernelDegradationForTests: () => {},
+}))
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+vi.mock('../lib/assetStorage', () => ({
+  saveGeneratedAsset: vi.fn(),
+  saveImportedAsset: vi.fn(),
+  readImportedAssetFile: vi.fn(),
+}))
+vi.mock('../store/remoteDebugReporter', () => ({
+  reportRemoteDebugEntry: () => {},
+}))
+
+const { rawIdbStorage, __resetIdbPersist } = await import('../lib/persistIdbStorage')
+const { docKernelPersistStorage, documentKey, sessionKey } = await import('./docKernelPersistAdapter')
+const { projectToThreeDomain } = await import('./persistMigration')
+const { useCanvasStore } = await import('../store/canvasStore')
+const { flushCanvasPersistWrite, hasPendingCanvasPersistWrite, __resetCanvasPersistStorageForTests } = await import(
+  '../store/canvasPersistConfig'
+)
+const { modelNames } = await import('../store/demoScenes')
+
+const NAME = 'mivo-canvas-demo'
+const FAKE_BASE64 = `data:image/jpeg;base64,${'B'.repeat(20_000)}`
+
+const stressSeedNode = (index: number) => ({
+  id: `stress-${index}`,
+  type: 'image',
+  title: `Result ${String(index + 1).padStart(3, '0')}`,
+  x: index * 10,
+  y: 0,
+  width: 132,
+  height: 174,
+  status: 'ready',
+  assetUrl: FAKE_BASE64,
+  generation: {
+    prompt: '批量结果压力测试节点',
+    model: modelNames[index % modelNames.length],
+    size: '768x1024',
+    seed: 7000 + index,
+  },
+})
+
+describe('kernel=new 版本语义分离 × 真实 IDB 双启动(#506 F3)', () => {
+  beforeEach(async () => {
+    // 先丢弃上一测试的暂存写与 read-your-writes 快照,再清盘(#532 冻结目标架构
+    // 下 seed 底层前必须清快照,否则 getItem 语义正确地返回旧快照而非 seed)。
+    __resetCanvasPersistStorageForTests()
+    await __resetIdbPersist()
+    useCanvasStore.setState({ ...useCanvasStore.getInitialState() } as never, true)
+  })
+  afterEach(async () => {
+    vi.restoreAllMocks()
+    __resetCanvasPersistStorageForTests()
+    await __resetIdbPersist()
+  })
+
+  it('历史 v11 canonical(base64 种子)→ 首启迁移一次 + canonical 洗净 + persistVersion=13;二启零迁移零重写', async () => {
+    // 历史 canonical:migrateV10ToV11 时代的记录形状(无 persistVersion 字段)
+    const blobState = {
+      canvases: {
+        'stress-test': {
+          title: '100 张图片压力测试',
+          nodes: Array.from({ length: 5 }, (_, index) => stressSeedNode(index)),
+          edges: [],
+          tasks: [],
+          selectedNodeId: undefined,
+          selectedNodeIds: [],
+        },
+      },
+      sceneId: 'stress-test',
+      projects: [],
+      selectedNodeId: undefined,
+      selectedNodeIds: [],
+      activeTool: 'select',
+    }
+    const { document: docDomain, session: sessDomain } = projectToThreeDomain(blobState as never)
+    await rawIdbStorage.setItem(documentKey(NAME), JSON.stringify({ state: docDomain, version: 11 }))
+    await rawIdbStorage.setItem(sessionKey(NAME), JSON.stringify({ state: sessDomain, version: 11 }))
+    expect((await rawIdbStorage.getItem(documentKey(NAME)))!.includes('data:image')).toBe(true) // 前提自检
+
+    // ── 首次启动:persistVersion 缺省按 11 报 → 迁移链恰跑一次并写回 ──
+    await useCanvasStore.persist.rehydrate()
+    expect(hasPendingCanvasPersistWrite()).toBe(true) // 迁移写回已入队(防抖暂存)
+    await flushCanvasPersistWrite('migration-writeback-drain')
+
+    // 内存:种子洗成引用
+    const doc = useCanvasStore.getState().canvases['stress-test']
+    expect(doc.nodes.every((n) => n.assetUrl?.startsWith('mivo-demo:stress/'))).toBe(true)
+
+    // 真实 IDB commit 口径:canonical(document+session 两域)零 data:image;
+    // document 记录 version=11(schema)不变、persistVersion=13(逻辑)
+    const docAfter = await rawIdbStorage.getItem(documentKey(NAME))
+    const sessAfter = await rawIdbStorage.getItem(sessionKey(NAME))
+    expect(docAfter!.includes('data:image')).toBe(false)
+    expect(sessAfter!.includes('data:image')).toBe(false)
+    const docRecord = JSON.parse(docAfter!) as { version: number; persistVersion?: number }
+    expect(docRecord.version).toBe(11)
+    expect(docRecord.persistVersion).toBe(13)
+
+    // 二审 P2:adapter getItem 对外 envelope 直接断言逻辑版本 13(F3 的对外面)
+    const envelope = await docKernelPersistStorage.getItem(NAME)
+    expect((JSON.parse(envelope!) as { version: number }).version).toBe(13)
+
+    // ── 第二次 rehydrate(同盘面):adapter 报 13 → 零迁移零重写。
+    // 二审 P2(盘读鉴别力):rehydrate 前用 sentinel 污染内存——该 setState 触发
+    // 的防抖写被 __resetCanvasPersistStorageForTests 丢弃(盘面不动,同时清掉
+    // read-your-writes 快照,迫使二启真读盘)——二次 rehydrate 后 sentinel 必须
+    // 被盘面真相盖回,证明读的是盘而非内存残留。
+    useCanvasStore.setState((s) => ({
+      canvases: { ...s.canvases, 'stress-test': { ...s.canvases['stress-test'], title: 'SENTINEL-NOT-ON-DISK' } },
+    }))
+    __resetCanvasPersistStorageForTests() // 丢弃 sentinel 的暂存写,盘面不动
+    const docBeforeSecondBoot = await rawIdbStorage.getItem(documentKey(NAME))
+    expect(docBeforeSecondBoot!.includes('SENTINEL')).toBe(false) // sentinel 确未落盘
+    expect(useCanvasStore.getState().canvases['stress-test'].title).toBe('SENTINEL-NOT-ON-DISK')
+
+    await useCanvasStore.persist.rehydrate()
+    expect(hasPendingCanvasPersistWrite()).toBe(false) // 零迁移零重写:无入队写(v13==v13 无 migrate)
+    await flushCanvasPersistWrite('drain-anyway') // 双保险排空后看盘
+    expect(await rawIdbStorage.getItem(documentKey(NAME))).toBe(docBeforeSecondBoot) // 记录字节不变
+    const doc2 = useCanvasStore.getState().canvases['stress-test']
+    expect(doc2.title).toBe('100 张图片压力测试') // sentinel 被盘面真相盖回:读的确实是盘
+    expect(doc2.nodes.every((n) => n.assetUrl?.startsWith('mivo-demo:stress/'))).toBe(true) // 数据照常读回
+  })
+})
