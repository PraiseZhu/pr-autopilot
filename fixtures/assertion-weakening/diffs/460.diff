index 00000000..2806f1b5
--- /dev/null
+++ b/src/__tests__/depositOwned.test.ts
@@ -0,0 +1,190 @@
+/**
+ * owned 判定 + 生成/过户双写测试(SC1b.4,设计稿 §4.4.4 三类条目表)。
+ *
+ * 核心断言:`from:'artifact'`/`from:'ledger'` 命中 → `resolveDepositEntry`
+ * 零 `deposit_media`、零 `release_media`(双 spy,复用 T1a 已交付的
+ * `depositTestHarness` 的 `hostRequests`/`hostReleaseRequests`)。
+ *
+ * 本文件不接任何生产 callsite,只测 depositOwned.ts 的纯函数与它和 T1a 已交付的
+ * depositPort.ts(resolveDepositEntry/releaseHash)之间的 seam 行为。
+ */
+import { beforeEach, afterEach, describe, expect, it, vi } from 'vitest'
+import { isOwnedDepositFrom, isOwnedDepositEntry, recordArtifactDeposit } from '../agent/depositOwned'
+import { resolveDepositEntry } from '../agent/depositPort'
+import { lookupDeposit, recordDeposit, type DepositEntry } from '../agent/depositStore'
+import { initMediaLedger, lookupMedia, resetMediaLedgerForTests } from '../agent/mediaLedger'
+import {
+  createDepositHarness,
+  teardownDepositHarness,
+  blobOfBytes,
+  FAKE_HASH,
+  type DepositHarness,
+} from './depositTestHarness'
+
+let harness: DepositHarness
+/** `/kv` 的假"磁盘":真实 GET/PUT 往返,让 ledger 的持久化断言不是纸面声明。 */
+let kvDisk: Record<string, unknown> = {}
+
+beforeEach(() => {
+  harness = createDepositHarness()
+  kvDisk = {}
+  resetMediaLedgerForTests()
+  // recordArtifactDeposit 现在 await `recordMediaDurable`(SC-T1c-fix.1),真的会立即
+  // 发 GET/PUT `/kv`,不再是"排一个 1.5s 后才可能触发的定时器"——必须给出真实往返的
+  // fetch 替身,而不是像本文件改动前那样靠"测试跑得比 1.5s 快"侧面绕开它。
+  vi.stubGlobal('window', {
+    setTimeout: (fn: () => void, ms: number) => globalThis.setTimeout(fn, ms),
+    clearTimeout: (id: unknown) => globalThis.clearTimeout(id as never),
+  })
+  vi.stubGlobal('fetch', async (input: unknown, init?: { method?: string; body?: string }) => {
+    if (String(input) !== '/kv') throw new Error(`unexpected fetch target: ${String(input)}`)
+    if (init?.method === 'PUT') {
+      kvDisk = JSON.parse(String(init.body)) as Record<string, unknown>
+      return { ok: true, json: async () => kvDisk } as unknown as Response
+    }
+    return { ok: true, json: async () => kvDisk } as unknown as Response
+  })
+})
+
+afterEach(() => {
+  teardownDepositHarness()
+  resetMediaLedgerForTests()
+  vi.unstubAllGlobals()
+})
+
+const entryOf = (from: DepositEntry['from']): DepositEntry => ({
+  hash: FAKE_HASH,
+  ext: '.png',
+  depositedAt: 1,
+  from,
+  gen: 1,
+  writer: 'w',
+})
+
+describe('isOwnedDepositFrom / isOwnedDepositEntry(纯谓词)', () => {
+  it('artifact 与 ledger 是 owned,deposit 不是', () => {
+    expect(isOwnedDepositFrom('artifact')).toBe(true)
+    expect(isOwnedDepositFrom('ledger')).toBe(true)
+    expect(isOwnedDepositFrom('deposit')).toBe(false)
+  })
+
+  it('entry 版本覆盖三态 + 未命中(undefined)不是 owned', () => {
+    expect(isOwnedDepositEntry(entryOf('artifact'))).toBe(true)
+    expect(isOwnedDepositEntry(entryOf('ledger'))).toBe(true)
+    expect(isOwnedDepositEntry(entryOf('deposit'))).toBe(false)
+    expect(isOwnedDepositEntry(undefined)).toBe(false)
+  })
+})
+
+describe('owned 命中 → resolveDepositEntry 零 deposit_media 且零 release_media(SC1b.4 双 spy)', () => {
+  it('from=artifact 命中:返回缓存,零寄存请求、零释放请求', async () => {
+    const assetUrl = 'mivo-asset:artifact-1'
+    await recordDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png', depositedAt: 1, from: 'artifact' })
+
+    const entry = await resolveDepositEntry({ assetUrl, blob: blobOfBytes(2_048) })
+
+    expect(entry).toMatchObject({ hash: FAKE_HASH, ext: '.png', from: 'artifact' })
+    expect(harness.hostRequests).toHaveLength(0)
+    expect(harness.hostReleaseRequests).toHaveLength(0)
+  })
+
+  it('from=ledger 命中:返回缓存,零寄存请求、零释放请求', async () => {
+    const assetUrl = 'mivo-asset:legacy-1'
+    await recordDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png', depositedAt: 0, from: 'ledger' })
+
+    const entry = await resolveDepositEntry({ assetUrl })
+
+    expect(entry).toMatchObject({ hash: FAKE_HASH, ext: '.png', from: 'ledger' })
+    expect(harness.hostRequests).toHaveLength(0)
+    expect(harness.hostReleaseRequests).toHaveLength(0)
+  })
+})
+
+describe('生成/过户双写(recordArtifactDeposit,SC1b.4)', () => {
+  it('写入后 mediaLedger 与 depositMap 双双可查,depositMap from=artifact', async () => {
+    const assetUrl = 'mivo-asset:gen-1'
+
+    const result = await recordArtifactDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png', bytes: 999 })
+
+    expect(result.ledgerWritten).toBe(true)
+    expect(result.commit?.ok).toBe(true)
+    expect(lookupMedia(assetUrl)).toMatchObject({ hash: FAKE_HASH, ext: '.png' })
+    await expect(lookupDeposit(assetUrl)).resolves.toMatchObject({ hash: FAKE_HASH, ext: '.png', from: 'artifact' })
+  })
+
+  it('双写全程零 deposit_media、零 release_media(不是走寄存换来的,是直接记账)', async () => {
+    await recordArtifactDeposit('mivo-asset:gen-2', { hash: FAKE_HASH, ext: '.png' })
+
+    expect(harness.hostRequests).toHaveLength(0)
+    expect(harness.hostReleaseRequests).toHaveLength(0)
+  })
+
+  it('双写完成后 resolveDepositEntry 命中缓存,不再重寄存(端到端 SC1b.4)', async () => {
+    const assetUrl = 'mivo-asset:gen-3'
+    await recordArtifactDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png' })
+
+    const entry = await resolveDepositEntry({ assetUrl, blob: blobOfBytes(4_096) })
+
+    expect(entry).toMatchObject({ hash: FAKE_HASH, from: 'artifact' })
+    expect(harness.hostRequests).toHaveLength(0) // 缓存命中,没有发出任何 deposit_media
+  })
+
+  it('入参非法(缺 hash/ext)→ 两本账都不写', async () => {
+    const result = await recordArtifactDeposit('mivo-asset:bad-1', { hash: '', ext: '.png' })
+
+    expect(result.ledgerWritten).toBe(false)
+    expect(lookupMedia('mivo-asset:bad-1')).toBeUndefined()
+    await expect(lookupDeposit('mivo-asset:bad-1')).resolves.toBeUndefined()
+  })
+
+  it('depositMap 提交失败(写槎故障)→ ledger 仍已写,不当作配额孤儿处理', async () => {
+    teardownDepositHarness()
+    harness = createDepositHarness({ writeGuard: (request) => !request.path.startsWith('deposit/state-') })
+    const assetUrl = 'mivo-asset:gen-fail-1'
+
+    const result = await recordArtifactDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png' })
+
+    expect(result.ledgerWritten).toBe(true)
+    expect(result.commit?.ok).toBe(false)
+    expect(lookupMedia(assetUrl)).toMatchObject({ hash: FAKE_HASH, ext: '.png' }) // ledger 侧不受影响
+  })
+
+  describe('共享磁盘重启(SC-T1c-fix.1 要求 4):断言重启后两本账的真实落盘状态,不只查内存态', () => {
+    it('① ledger 持久化成功、depositMap 提交失败 → 重启后 ledger 真有这条,depositMap 真没有', async () => {
+      teardownDepositHarness()
+      harness = createDepositHarness({ writeGuard: (request) => !request.path.startsWith('deposit/state-') })
+      const assetUrl = 'mivo-asset:reboot-fail-1'
+
+      const result = await recordArtifactDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png' })
+      expect(result).toMatchObject({ ledgerWritten: true, commit: { ok: false } })
+
+      // 「重启」ledger:换一个干净的模块态,只从 kvDisk(真实 PUT 落盘的内容)重新加载,
+      // 不是继续读同一个内存 Map。
+      resetMediaLedgerForTests()
+      await initMediaLedger()
+      expect(lookupMedia(assetUrl)).toMatchObject({ hash: FAKE_HASH, ext: '.png' })
+
+      // 「重启」depositMap:换一个干净会话读同一份假磁盘。
+      const disk = { ...Object.fromEntries(harness.brain.files) }
+      teardownDepositHarness()
+      harness = createDepositHarness({ files: disk })
+      await expect(lookupDeposit(assetUrl)).resolves.toBeUndefined() // commit 失败,真没有这条
+    })
+
+    it('② ledger 持久化成功、depositMap 提交成功 → 随即崩溃重启,两本账都真的还在', async () => {
+      const assetUrl = 'mivo-asset:reboot-ok-1'
+
+      const result = await recordArtifactDeposit(assetUrl, { hash: FAKE_HASH, ext: '.png', bytes: 42 })
+      expect(result).toMatchObject({ ledgerWritten: true, commit: { ok: true } })
+
+      resetMediaLedgerForTests()
+      await initMediaLedger()
+      expect(lookupMedia(assetUrl)).toMatchObject({ hash: FAKE_HASH, ext: '.png' })
+
+      const disk = { ...Object.fromEntries(harness.brain.files) }
+      teardownDepositHarness()
+      harness = createDepositHarness({ files: disk })
+      await expect(lookupDeposit(assetUrl)).resolves.toMatchObject({ hash: FAKE_HASH, ext: '.png', from: 'artifact' })
+    })
+  })
+})
