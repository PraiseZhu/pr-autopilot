+/**
+ * owned 判定 + 生成/过户双写(设计稿 `docs/plan/cindy-deposit-media-design.md`
+ * §4.4.4 三类条目表,对应 SC1b.4)。
+ *
+ * `from:'artifact'`(生成产物/聊天附件过户回填)与 `from:'ledger'`(存量账本迁移)
+ * 两类条目**不占寄存配额、不可 `release_media`**——它们的指纹归宿主产物账管,不是
+ * 本插件寄存换来的。命中即"已 owned":`resolveDepositEntry`(depositPort.ts,T1a
+ * 已交付)对任何 `from` 的缓存命中都直接返回、不发 `deposit_media`,这本就是"绝不
+ * 重寄"的现有实现;本文件把"这条 from 是不是 owned"单独抽成可测的纯谓词,供 T1b2
+ * (LRU 淘汰前是否需要先 release)、T1e(接线时的判断点)复用,不必各自重新判定
+ * `from` 字面值。
+ *
+ * `recordArtifactDeposit` 是本段唯一的新写路径:生成产物落板 / 聊天附件过户上墙
+ * 后,现状只写 mediaLedger(`correlateNewAssets`/`correlatePlacedAttachments` 的
+ * 既有调用点)——切流后这条记账职责由 depositMap 承接(设计稿 §4.4.4),过渡期两本
+ * 账**双写**:ledger 继续按现状写(不改变那条既有路径的行为),depositMap 侧新增
+ * `from:'artifact'` 条目,使得切流后 `resolveDepositEntry` 缓存命中即可跳过重寄存。
+ *
+ * **双写顺序是持久化事实,不是内存写**(SC-T1c-fix.1,judge P1-C1):ledger 走
+ * `recordMediaDurable`——await 到它真正 PUT 落盘成功才提交 depositMap;ledger 落盘
+ * 失败则 depositMap 也不写,宁可两本账都没有,也不留半条映射(崩溃后只剩
+ * depositMap、ledger 缺条这种状态,过渡期消费 `from:'ledger'` 的旧路径会丢映射)。
+ *
+ * **本文件不接任何生产 callsite**:把 `correlateNewAssets` 里的裸
+ * `recordMedia(assetUrl, entry)` 换成 `recordArtifactDeposit(assetUrl, entry)`
+ * 是 T1e 的接线职责;本段只交付这一处逻辑与它的 seam 测试(执行纪律与 T1 完成点
+ * 总表:暗段 = 逻辑完成,生产完成点在 T1e/T1f)。
+ */
+import { debugLogger } from '../../../src/store/debugLogStore'
+import { recordMediaDurable } from './mediaLedger'
+import { recordDeposit, type DepositCommitResult, type DepositEntry, type DepositFrom } from './depositStore'
+
+const SOURCE = 'Cindy Deposit'
+
+/**
+ * `artifact`/`ledger` 不占寄存配额、不可 `release_media`(设计稿 §4.4.4 表)——
+ * 命中即 owned,不需要重新寄存,也绝不该被当作"该释放的寄存物"处理。
+ */
+export const isOwnedDepositFrom = (from: DepositFrom): boolean => from === 'artifact' || from === 'ledger'
+
+/** 便捷判定:未命中(`undefined`)不是 owned——调用方仍需走寄存。 */
+export const isOwnedDepositEntry = (entry: DepositEntry | undefined): boolean =>
+  entry !== undefined && isOwnedDepositFrom(entry.from)
+
+let now = (): number => Date.now()
+export const setDepositOwnedClockForTests = (next?: () => number): void => {
+  now = next ?? (() => Date.now())
+}
+
+export type ArtifactDepositInput = { hash: string; ext: string; bytes?: number }
+
+/**
+ * `ledgerWritten: true` 是"ledger 已确认持久化落盘"的事实陈述(`recordMediaDurable`
+ * 已 await 到 PUT 成功),不是"内存写过一次"——SC-T1c-fix.1 要求字段名不得说假话。
+ */
+export type ArtifactDepositResult =
+  | { ledgerWritten: false; commit?: undefined }
+  | { ledgerWritten: true; commit: DepositCommitResult }
+
+/**
+ * 生成产物落板 / 聊天附件过户上墙后的双写口。
+ *
+ * 入参非法(assetUrl/hash/ext 任一缺失)时**两本账都不写**——与既有 `recordMedia`
+ * 自身的防御一致(它对空 hash/ext 也是直接 return,不留半条记录),这里同样不产生
+ * 半条 depositMap 条目。
+ *
+ * 顺序是硬约束:ledger 必须先**持久化成功**才提交 depositMap;ledger 落盘失败则
+ * 直接返回、不碰 depositMap(SC-T1c-fix.1)——避免"depositMap 有、ledger 缺"的半条
+ * 映射(`recordDeposit` 是 await 的真实提交,若先调用它再异步写 ledger,两者完成
+ * 顺序会颠倒,崩溃窗口就会落在两次持久化之间)。
+ */
+export const recordArtifactDeposit = async (
+  assetUrl: string,
+  entry: ArtifactDepositInput,
+): Promise<ArtifactDepositResult> => {
+  if (!assetUrl || !entry.hash || !entry.ext) {
+    debugLogger.warn(SOURCE, 'artifact 双写跳过:assetUrl/hash/ext 缺失,ledger 与 depositMap 均不写')
+    return { ledgerWritten: false }
+  }
+  const ledgerPersisted = await recordMediaDurable(assetUrl, { hash: entry.hash, ext: entry.ext })
+  if (!ledgerPersisted) {
+    debugLogger.warn(SOURCE, 'artifact 双写中止:ledger 持久化未成功(非内存写失败),不提交 depositMap,避免半条映射')
+    return { ledgerWritten: false }
+  }
+  const commit = await recordDeposit(assetUrl, {
+    hash: entry.hash,
+    ext: entry.ext,
+    bytes: entry.bytes,
+    depositedAt: now(),
+    from: 'artifact',
+  })
+  if (!commit.ok) {
+    // depositMap 提交失败只丢缓存(设计稿 §4.4.1 两分支之一):ledger 已经确认落盘
+    // 不受影响,resolveSourceEntry 现状路径仍能查到这条产物;下一次落板重新触发
+    // 本函数即可补上 depositMap 侧的条目,不是配额孤儿(artifact 条目本就不占
+    // 寄存配额)。
+    debugLogger.warn(
+      SOURCE,
+      `artifact 双写:depositMap 落盘未成功(reason=${commit.reason ?? '未知'}),ledger 已持久化不受影响`,
+    )
+  }
+  return { ledgerWritten: true, commit }
+}
