index c639ff01..d2756fb0 100644
--- a/src/agent/depositMigration.ts
+++ b/src/agent/depositMigration.ts
@@ -25,49 +25,55 @@ const LEDGER_KV_KEY = 'mediaLedger'
 
 export type LedgerSnapshot = Record<string, unknown>
 
+/**
+ * 读取结果打成 tagged outcome(SC-T1c-fix.2,judge P1-C2):`status:'ok'` 覆盖两种
+ * 真正等价的情形——`ledger` 为 `null` 代表"确实没有账本"(键不存在/响应体为空);
+ * `status:'error'` 代表"这次没读到,不代表没有"——**只有 `'ok'` 才允许写迁移完成
+ * 标记**,`'error'` 必须保留下次重试资格,不能被当成"无账本"悄悄放过。
+ */
+export type LedgerReadOutcome = { status: 'ok'; ledger: LedgerSnapshot | null } | { status: 'error'; reason: string }
+
 /**
