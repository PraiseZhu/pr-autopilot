+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #505 P0-2「退出即弃」顺序回归:logout 必须先丢弃暂存写、等在途写落定,
+// clearCurrentUserCache 才执行——之后 pagehide flush / 慢写回填都不可能把
+// 旧用户数据写回。两条时序:
+//   1) edit → logout → pagehide:pending 已被弃,pagehide 无可写
+//   2) slow in-flight → logout:clear 排在慢写落定之后(不会 clear 完又被回填)
+
+const order: string[] = []
+
+const { logSpy, warnSpy, errorSpy, clearSpy } = vi.hoisted(() => ({
+  logSpy: vi.fn(),
+  warnSpy: vi.fn(),
+  errorSpy: vi.fn(),
+  clearSpy: vi.fn(),
+}))
+
+vi.mock('./debugLogStore', () => ({
+  debugLogger: { log: logSpy, warn: warnSpy, error: errorSpy },
+  useDebugLogStore: { getState: () => ({ entries: [], addEntry: vi.fn(), clear: vi.fn() }) },
+  installConsoleCapture: () => {},
+}))
+vi.mock('../lib/persistIdbStorage', async (importOriginal) => {
+  const original = await importOriginal<Record<string, unknown>>()
+  return { ...original, clearCurrentUserCache: clearSpy }
+})
+
+const { namespacedKey } = await import('../lib/persistUserId')
+const { useAuthStore } = await import('./authSlice')
+const {
+  createDebouncedCompactPersistStorage,
+  __clearDebouncedPersistInstancesForTests,
+} = await import('./canvasPersistWriteScheduler')
+
+type Slice = Record<string, unknown>
+
+// logout 会写 window.location.href(SSO 跳转)——替换成惰性对象,只记录意图。
+Object.defineProperty(window, 'location', {
+  configurable: true,
+  value: { href: 'https://app.local/x', origin: 'https://app.local' },
+})
+
+const makeBackend = () => {
+  const backend = {
+    writes: [] as string[],
+    writeImpl: [] as Array<(key: string, value: string) => Promise<void>>,
+    resolveTarget: (name: string) => {
+      const key = namespacedKey(name)
+      return {
+        key,
+        write: async (value: string) => {
+          const impl = backend.writeImpl.shift()
+          if (impl) return impl(key, value)
+          backend.writes.push(value)
+          order.push('backend-write')
+        },
+        remove: async () => undefined,
+        removeStrict: async () => undefined,
+      }
+    },
+    readCurrent: async () => null,
+  }
+  return backend
+}
+
+const makeStorage = (backend: ReturnType<typeof makeBackend>, extra?: { skipLifecycleListeners?: boolean }) =>
+  createDebouncedCompactPersistStorage<Slice>({
+    resolveTarget: backend.resolveTarget,
+    readCurrent: backend.readCurrent,
+    compactAtFlush: (s) => s,
+    ...extra,
+  })
+
+describe('authSlice.logout × persist 防抖(P0-2 退出即弃)', () => {
+  beforeEach(() => {
+    __clearDebouncedPersistInstancesForTests()
+    order.length = 0
+    clearSpy.mockClear()
+    clearSpy.mockImplementation(async () => {
+      order.push('clear-cache')
+    })
+    useAuthStore.setState({ user: { id: 'user-a', name: 'A' } as never, status: 'authenticated' })
+  })
+
+  it('edit → logout → pagehide:暂存写被弃,pagehide 不产生任何回写', async () => {
+    const backend = makeBackend()
+    const storage = makeStorage(backend)
+    storage.setItem('mivo-canvas-demo', { state: { edited: 'by-A' }, version: 12 })
+    expect(storage.hasPendingWrite()).toBe(true)
+
+    await useAuthStore.getState().logout()
+    expect(storage.hasPendingWrite()).toBe(false) // discard 在 clear 之前完成
+
+    window.dispatchEvent(new Event('pagehide'))
+    await storage.flushAndSettle('drain')
+    expect(backend.writes).toHaveLength(0) // A 的编辑没有任何通道写回
+    expect(clearSpy).toHaveBeenCalledTimes(1)
+  })
+
+  it('slow in-flight → logout:clearCurrentUserCache 排在慢写落定之后(无回填窗口)', async () => {
+    const backend = makeBackend()
+    let releaseSlow: () => void = () => {}
+    backend.writeImpl.push(
+      () =>
+        new Promise<void>((resolve) => {
+          releaseSlow = () => {
+            order.push('backend-write')
+            resolve()
+          }
+        }),
+    )
+    const storage = makeStorage(backend, { skipLifecycleListeners: true })
+    storage.setItem('mivo-canvas-demo', { state: { edited: 'slow' }, version: 12 })
+    void storage.flushAndSettle('t1') // 在途慢写
+    for (let tick = 0; tick < 10; tick += 1) await Promise.resolve()
+
+    const logout = useAuthStore.getState().logout()
+    for (let tick = 0; tick < 10; tick += 1) await Promise.resolve()
+    expect(order).not.toContain('clear-cache') // barrier 生效:clear 等着慢写
+
+    releaseSlow()
+    await logout
+    expect(order).toEqual(['backend-write', 'clear-cache']) // 写完才 clear,clear 后无 job 存活
+  })
+
+  it('logout 吸收态:返回后任何 setItem(后台任务迟到)都被丢弃 + error', async () => {
+    const backend = makeBackend()
+    const storage = makeStorage(backend)
+    await useAuthStore.getState().logout()
+
+    storage.setItem('mivo-canvas-demo', { state: { late: 'background-task' }, version: 12 })
+    expect(storage.hasPendingWrite()).toBe(false) // 「退出即弃」是永久性的,不是一次性清扫
+    expect(errorSpy).toHaveBeenCalledWith('Persist Debounce', expect.stringContaining('logout 后丢弃'))
+    window.dispatchEvent(new Event('pagehide'))
+    await storage.flushAndSettle('drain')
+    expect(backend.writes).toHaveLength(0)
+  })
+})
