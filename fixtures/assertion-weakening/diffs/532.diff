@@ -0,0 +1,83 @@
+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #505:localStorage 无事务、staging 回滚不是 crash-atomic(崩在中途的半套会成为
+// 下次启动的 durable canonical)——原子原语在无 IDB 环境一律**拒绝**,不做非原子
+// 降级。kernel=new 不再有运行期回退通道:无可用 IDB 时生效内核在启动编排层降级
+// legacy(见 kernelDegradation.test),这里的拒绝只是纵深防御(触发即 error 落账)。
+// happy-dom 不实现 indexedDB → isIdbAvailable() = false,天然是无 IDB 环境。
+
+const debugLogger = { log: vi.fn(), warn: vi.fn(), error: vi.fn() }
+vi.mock('../store/debugLogStore', () => ({ debugLogger }))
+const toastFeedback = { error: vi.fn(), success: vi.fn(), info: vi.fn() }
+vi.mock('../store/toastStore', () => ({ toastFeedback }))
+
+const {
+  rawIdbSetItemsAtomic,
+  rawIdbRemoveItemsAtomic,
+  rawIdbRemoveItemsAtomicStrict,
+  probeIdbOperational,
+  createIdbFrozenTarget,
+  __resetIdbOperationalProbeForTests,
+} = await import('./persistIdbStorage')
+const { createDocKernelFrozenTarget } = await import('../kernel/docKernelPersistAdapter')
+
+const NAME = 'mivo-canvas-demo'
+const envelope = JSON.stringify({ state: { canvases: {}, sceneId: 'c1' }, version: 12 })
+
+describe('无 IDB 环境的原子原语拒绝(kernel=new 由启动降级兜底,这里是纵深防御)', () => {
+  beforeEach(() => {
+    expect(typeof indexedDB).toBe('undefined') // 前提自检:确实在无 IDB 环境
+    localStorage.clear()
+    debugLogger.error.mockClear()
+    debugLogger.warn.mockClear()
+    __resetIdbOperationalProbeForTests()
+  })
+
+  it('rawIdbSetItemsAtomic:无 IDB 一律拒绝(error 日志 + throw),不做非原子降级', async () => {
+    await expect(
+      rawIdbSetItemsAtomic([
+        { name: 'k1', value: 'v1' },
+        { name: 'k2', value: 'v2' },
+      ]),
+    ).rejects.toThrow(/refusing non-atomic fallback/)
+    expect(localStorage.getItem('k1')).toBeNull() // 一个 key 都不写,零半套
+    expect(localStorage.getItem('k2')).toBeNull()
+    expect(debugLogger.error).toHaveBeenCalledWith(
+      'Persist IDB',
+      expect.stringContaining('atomic multi-key write refused'),
+    )
+  })
+
+  it('rawIdbRemoveItemsAtomic:同口径拒绝——预置数据原样保留(拒绝 ≠ 半删)', async () => {
+    localStorage.setItem('k1', 'v1') // 预置:拒绝路径不得碰任何 key
+    localStorage.setItem('k2', 'v2')
+    await expect(rawIdbRemoveItemsAtomic(['k1', 'k2'])).rejects.toThrow(/refusing non-atomic fallback/)
+    await expect(rawIdbRemoveItemsAtomicStrict(['k1', 'k2'])).rejects.toThrow(/refusing non-atomic fallback/)
+    expect(localStorage.getItem('k1')).toBe('v1')
+    expect(localStorage.getItem('k2')).toBe('v2')
+  })
+
+  it('无 IDB 环境的 operational 探测 = false(启动降级的判定前提)', async () => {
+    expect(await probeIdbOperational()).toBe(false)
+  })
+
+  it('纵深防御:降级失守时 kernel=new 冻结目标的 write 拒绝而非写半套(调度器 error 落账)', async () => {
+    const target = createDocKernelFrozenTarget(NAME)
+    await expect(target.write(envelope)).rejects.toThrow(/refusing non-atomic fallback/)
+    // 零 split key 落进 localStorage(拒绝 = 一个 key 都不写)
+    expect(localStorage.getItem(`${NAME}:document`)).toBeNull()
+    expect(localStorage.getItem(`${NAME}:session`)).toBeNull()
+  })
+
+  it('降级会话写面收敛:legacy 冻结目标在无 IDB 环境只写单 blob 键,零 split/杂键外溢', async () => {
+    const target = createIdbFrozenTarget(NAME) // 降级会话(生效 legacy)的实际写通道
+    await target.write(envelope)
+    expect(localStorage.getItem(NAME)).toBe(envelope) // LS 单 blob 落盘 + 可读回
+    // 全部 localStorage 键收敛为恰好这一个——降级会话不产生任何 split-domain 键
+    const keys = Array.from({ length: localStorage.length }, (_, i) => localStorage.key(i))
+    expect(keys).toEqual([NAME])
+    await target.remove()
+    expect(localStorage.getItem(NAME)).toBeNull()
+  })
+})
