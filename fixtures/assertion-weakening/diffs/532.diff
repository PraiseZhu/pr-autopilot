+import { describe, expect, it, vi, beforeEach } from 'vitest'
+
+// canvasStore 的 hydration/迁移写回契约——从 canvasStore.contract.test.ts 拆出
+// (#505:该文件贴 structure-guard 900 行上限,F8 的盘上 version=12 断言把它顶爆,
+// 按守卫指引拆分入库)。两条契约:
+// 1) v8 存量 blob 真实 rehydrate 进 store;zustand 迁移写回(v8→v12)在冻结目标
+//    架构下就是一次普通冻结键写,flush 后盘上 version 必须升到 12。
+// 2) 过期 generating slot/task 在 rehydrate 时 settle,且 settle 后的迁移写回同样
+//    真实落盘 version=12。
+//
+// harness 与母文件同源:node env 无 window,vi.hoisted 先装内存 localStorage,
+// zustand persist 才会挂 api.persist;demoImages/assetStorage/remoteDebugReporter
+// 三桩保持 hermetic。
+
+vi.hoisted(() => {
+  const store = new Map<string, string>()
+  const memStorage = {
+    get length() {
+      return store.size
+    },
+    clear: () => store.clear(),
+    getItem: (k: string) => store.get(k) ?? null,
+    key: (i: number) => [...store.keys()][i] ?? null,
+    removeItem: (k: string) => {
+      store.delete(k)
+    },
+    setItem: (k: string, v: string) => {
+      store.set(k, String(v))
+    },
+  }
+  const g = globalThis as Record<string, unknown>
+  if (g.window === undefined) g.window = { localStorage: memStorage }
+  if (g.localStorage === undefined) g.localStorage = memStorage
+})
+
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+vi.mock('../lib/assetStorage', () => ({
+  saveGeneratedAsset: vi.fn(),
+  saveImportedAsset: vi.fn(),
+  readImportedAssetFile: vi.fn(),
+}))
+vi.mock('./remoteDebugReporter', () => ({
+  reportRemoteDebugEntry: () => {},
+}))
+
+import { useCanvasStore } from './canvasStore'
+import type { CanvasTask, MivoCanvasNode } from '../types/mivoCanvas'
+
+const aiSlotNode = (overrides: Partial<MivoCanvasNode> = {}): MivoCanvasNode => ({
+  id: 'slot-1',
+  type: 'ai-slot',
+  title: 'Slot',
+  x: 40,
+  y: 60,
+  width: 320,
+  height: 320,
+  status: 'ready',
+  ...overrides,
+})
+
+const task = (overrides: Partial<CanvasTask> = {}): CanvasTask => ({
+  id: 'task-1',
+  label: '生成到槽位:Slot',
+  status: 'done',
+  progress: 100,
+  nodeIds: [],
+  ...overrides,
+})
+
+const ls = () =>
+  (globalThis as unknown as { localStorage: { setItem: (k: string, v: string) => void; getItem: (k: string) => string | null; clear: () => void } }).localStorage
