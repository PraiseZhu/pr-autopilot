+    ...node,
+    transform: { x: node.x, y: node.y, width: node.width, height: node.height, rotation },
+    asset: { kind: 'image', url: node.assetUrl },
+    fills: [{ id: 'f', type: 'image', url: node.assetUrl }],
+    relations: {},
+  }) as unknown as MivoCanvasNode
+
+describe('compactNodeForPersist — 刀3 按需拷贝的字节等价', () => {
+  const cases: Array<[string, MivoCanvasNode]> = [
+    ['已归一节点(store 常态,零旋转)', withTransform(baseNode())],
+    ['已归一节点(带旋转 → transform 保留在末尾)', withTransform(baseNode(), 45)],
+    [
+      'legacy 未归一节点(无 transform/无 fills → 走全重建吸附路径)',
+      baseNode({ id: 'legacy', fontWeight: 500 } as Partial<MivoCanvasNode>),
+    ],
+    [
+      '梯外字重节点(fontWeight 600 → 吸附语义必须保持)',
+      withTransform(baseNode({ id: 'fw', type: 'text', text: 'hi', fontWeight: 600, assetUrl: undefined } as Partial<MivoCanvasNode>)),
+    ],
+    [
+      '带畸形 box 锚点(缺 width/height → 持久化时丢弃的语义必须保持)',
+      withTransform(
+        baseNode({
+          id: 'anchor',
+          experimentalAnchors: [
+            { id: 'a1', type: 'box', targetNodeId: 'n1', x: 0, y: 0, width: 10, height: 10, instruction: 'i', createdAt: 1 },
+            // 畸形:box 缺 width/height → 持久化时丢弃(旧 cloneNode 语义)
+            { id: 'a2', type: 'box', targetNodeId: 'n1', x: 0, y: 0, instruction: 'i', createdAt: 2 },
+          ],
+        } as Partial<MivoCanvasNode>),
+      ),
+    ],
+    [
+      '带 markupPoints/generation 嵌套的 markup 节点',
+      withTransform(
+        baseNode({
+          id: 'mk',
+          type: 'markup',
+          markupKind: 'arrow',
+          assetUrl: undefined,
+          markupPoints: [
