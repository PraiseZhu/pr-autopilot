+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #505 六审 F2:kernel=new + 无 IDB 时插件链不得静默丢写。usePluginHydration 在
+// restore/rehydrate 前 await ensureEffectiveKernelReady()(与主站同一把闸,调用点
+// 与顺序由 src/app/kernelDegradation.test 的源码契约钉住);本文件走**真实生产
+// 写读链**验证降级后果:真实 canvasStore 编辑 → persist(canvasPersistConfig 的
+// debounced storage,resolveTarget 按生效内核分流)→ flush → legacy 单 blob 落
+// LS(happy-dom 无 IDB = fallback 在环)→ 清快照后真实读回。requested-new 经
+// VITE_MIVO_KERNEL 钉住。
+
+vi.stubEnv('VITE_MIVO_KERNEL', 'new')
+
+const { kernelMode, getEffectiveKernelMode, ensureEffectiveKernelReady, __resetKernelDegradationForTests } =
+  await import('../../../src/app/kernelMode')
+const { __resetIdbOperationalProbeForTests } = await import('../../../src/lib/persistIdbStorage')
+const { useCanvasStore } = await import('../../../src/store/canvasStore')
+const { flushCanvasPersistWrite, __resetCanvasPersistStorageForTests } = await import(
+  '../../../src/store/canvasPersistConfig'
+)
+
+const NAME = 'mivo-canvas-demo'
+
+describe('插件链 kernel=new + 无 IDB:启动降级后编辑落 legacy 单 blob 且可读回', () => {
+  beforeEach(() => {
+    localStorage.clear()
+    __resetIdbOperationalProbeForTests()
+    __resetKernelDegradationForTests()
+    __resetCanvasPersistStorageForTests()
+  })
+
+  it('requested-new + 无 IDB → 生效 legacy;真实编辑 flush 后 LS 单 blob 非空、零 split 键、可读回', async () => {
+    expect(kernelMode).toBe('new') // 前提自检:请求值确为 new
+    expect(typeof indexedDB).toBe('undefined') // 前提自检:无 IDB 环境
+
+    // usePluginHydration 在任何 restore/rehydrate 前 await 的同一把闸(生产函数)
+    await ensureEffectiveKernelReady()
+    expect(getEffectiveKernelMode()).toBe('legacy')
+
+    // 真实编辑 → persist setItem(debounced storage)→ flush
+    useCanvasStore.getState().setActiveTool('brush')
+    await flushCanvasPersistWrite('plugin-degradation-test')
+
+    const raw = localStorage.getItem(NAME) // legacy 单 blob(LS fallback)
+    expect(raw).not.toBeNull()
+    const parsed = JSON.parse(raw!) as { state: { activeTool?: string }; version: number }
+    expect(parsed.state.activeTool).toBe('brush')
+    expect(parsed.version).toBe(12)
+    expect(localStorage.getItem(`${NAME}:document`)).toBeNull() // 零 split-domain 键
+    expect(localStorage.getItem(`${NAME}:session`)).toBeNull()
+
+    // 可读回(反假成功):清 read-your-writes 快照,逼 getItem 走底层真实读
+    __resetCanvasPersistStorageForTests()
+    const opts = useCanvasStore.persist.getOptions()
+    const readBack = (await opts.storage!.getItem(NAME)) as { state: { activeTool?: string }; version: number } | null
+    expect(readBack).not.toBeNull()
+    expect(readBack!.state.activeTool).toBe('brush')
+    expect(readBack!.version).toBe(12)
+  })
+})
