+const { useStoreHydration } = await import('./useStoreHydration')
+
+// persist-busy 下 rehydrate 根本不发生(跳过盘面水合),无需命名空间记录器;
+// 「UID 保持 anonymous」由真实 auth 接线专测钉住(authSlice.worldSwitch ③b 与
