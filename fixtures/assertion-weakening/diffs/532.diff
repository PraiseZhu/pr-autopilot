+  })
+
+  it('F7:/me 返回纯空白 uid → 同口径 fail-closed', async () => {
+    setPersistUserId('user-a') // 已登录会话遇到坏 /me 响应:命名空间也不得被切走
+    fetchMeMock.mockResolvedValueOnce(me('   '))
+    await useAuthStore.getState().hydrate()
+    expect(useAuthStore.getState().status).toBe('unauthenticated')
+    expect(getPersistUserId()).toBe('user-a')
+    expect(reloadSpy).not.toHaveBeenCalled()
+    expect(errorSpy).toHaveBeenCalledWith('Auth', expect.stringContaining('非法 userId'))
+  })
+
+  it('F7:带空白的同 uid(" user-u ")归一化后走 same-UID no-op 分支,不误判为 A→B 切换', async () => {
+    setPersistUserId('user-u')
+    fetchMeMock.mockResolvedValueOnce(me('  user-u  '))
+    await useAuthStore.getState().hydrate()
+    expect(useAuthStore.getState().status).toBe('authenticated')
+    expect(useAuthStore.getState().user?.id).toBe('user-u') // 下游拿到的是归一化 uid
+    expect(getPersistUserId()).toBe('user-u')
+    expect(reloadSpy).not.toHaveBeenCalled() // 没有被误判成账号切换
+  })
+})
