--- /dev/null
+++ b/src/app/useStoreHydration.persistBusy.integration.test.tsx
@@ -0,0 +1,179 @@
+// @vitest-environment happy-dom
+//
+// #505 九审阻塞项的实证口径:chat/settings 与 canvas 共用同一 IDB kv store——
+// kv 里有卡死的 readwrite 事务时,任何盘面读事务都会排在它后面。persist-busy
+// 若仍同步 await migrate/rehydrate,首屏照样永久冻结。本文件用 fake-indexeddb
+// **真实占住 kv store**(readwrite 事务 keep-alive),跑真实 authSlice.hydrate +
+// 真实 useStoreHydration(真 store / 真调度器单例 / 真 5s 生产屏障),断言:
+// - 屏障 timed-out → persist-busy → hook 在**有界时间内** hydrated=true(不等卡死事务)
+// - migrate 与 canvas/chat/settings 三个 rehydrate 零调用,UID 仍 anonymous
+// - 释放事务后无迟发水合(不会突然覆盖用户已可编辑的内存态)
+import 'fake-indexeddb/auto'
+import { useEffect } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+const { fetchMeMock, migrateSpy } = vi.hoisted(() => ({
+  fetchMeMock: vi.fn(),
+  migrateSpy: vi.fn(async () => ({ ok: true, skipped: true })),
+}))
+
+vi.mock('../lib/authClient', () => ({
+  fetchMe: fetchMeMock,
+  AuthError: class AuthError extends Error {},
+}))
+vi.mock('../kernel/persistMigration', async (importOriginal) => ({
+  ...(await importOriginal<Record<string, unknown>>()),
+  migrateV10ToV11: migrateSpy,
+}))
+const toastFeedback = { error: vi.fn(), success: vi.fn(), info: vi.fn() }
+vi.mock('../store/toastStore', () => ({ toastFeedback }))
+vi.mock('../store/chatTaskReconcile', () => ({
+  reconcileExpiredChatTasks: vi.fn(async () => undefined),
+}))
+vi.mock('../lib/persistBoot', () => ({
+  resumePersistQueue: vi.fn(),
+  bootPersistWiring: vi.fn(async () => undefined),
+}))
+// canvasStore/chatStore 模块图的常规重依赖桩(沿用 hydrationDurableSettle 先例)
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+vi.mock('../lib/assetStorage', () => ({
+  migrateUntaggedAssets: vi.fn(async () => undefined),
+  clearAssetsForUser: vi.fn(async () => undefined),
+  saveGeneratedAsset: vi.fn(),
+  saveImportedAsset: vi.fn(),
+  readImportedAssetFile: vi.fn(),
+}))
+vi.mock('../store/remoteDebugReporter', () => ({ reportRemoteDebugEntry: () => {} }))
+vi.mock('../store/generationFacade', () => ({
+  generationFacade: {
+    prepareChatSlot: vi.fn(),
+    generateIntoAiSlot: vi.fn(),
+    generateBesideNode: vi.fn(),
+    getSceneChangeInfo: vi.fn().mockReturnValue({ sceneChanged: false, currentSceneId: '', sceneTitle: '' }),
+  },
+}))
+vi.mock('../store/chatMaskEditFlow', () => ({
+  cancelMaskEditMessage: vi.fn(),
+  beginMaskEditMessage: vi.fn(() => 'mask-msg-stub'),
+  runMaskEditChatFlow: vi.fn(async () => {}),
+  finishMaskEditMessage: vi.fn(),
+  failMaskEditMessage: vi.fn(),
+  setChatStoreAccessor: vi.fn(() => {}),
+}))
+
+const { rawIdbStorage } = await import('../lib/persistIdbStorage')
+const { getPersistUserId } = await import('../lib/persistUserId')
+const { useCanvasStore } = await import('../store/canvasStore')
+const { useChatStore } = await import('../store/chatStore')
+const { useSettingsStore } = await import('../store/settingsSlice')
+const { useAuthStore } = await import('../store/authSlice')
+const { useStoreHydration } = await import('./useStoreHydration')
+
+const observed = { hydrated: false }
+
+function Harness() {
+  const hydrated = useStoreHydration()
+  useEffect(() => {
+    observed.hydrated = hydrated
+  }, [hydrated])
+  return null
+}
+
+/** 真实占住 kv store:readwrite 事务经连环 get 请求 keep-alive(IDB 事务只要还有
+ *  未完成请求就不提交;停止续命后自然提交释放)。同 store 的后续 readwrite/read
+ *  事务(canvas 落盘、rehydrate 读)都会排在它后面——这就是审核人实证的冻结面。 */
+const holdKvStore = (): Promise<() => void> =>
+  new Promise((resolveReady, rejectReady) => {
+    const req = indexedDB.open('mivo-canvas-persist', 1)
+    req.onerror = () => rejectReady(req.error)
+    req.onsuccess = () => {
+      const db = req.result
+      const tx = db.transaction('kv', 'readwrite')
+      const store = tx.objectStore('kv')
+      let released = false
+      const spin = () => {
+        if (released) {
+          db.close()
+          return
+        }
+        const r = store.get('__hold__')
+        r.onsuccess = spin
+      }
+      spin()
+      resolveReady(() => {
+        released = true
+      })
+    }
+  })
+
+const waitFor = async (predicate: () => boolean, timeoutMs: number, intervalMs = 50): Promise<boolean> => {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (predicate()) return true
+    await new Promise((resolve) => setTimeout(resolve, intervalMs))
+  }
+  return predicate()
+}
+
+let root: Root | undefined
+let container: HTMLDivElement | undefined
+
+describe('persist-busy × 共享 kv store 真实阻塞(九审终裁实证)', () => {
+  afterEach(() => {
+    root?.unmount()
+    container?.remove()
+  })
+
+  it(
+    'kv 被真实 readwrite 事务占住 → 屏障 timed-out → 有界放行内存默认态,零盘面读,释放后无迟发水合',
+    async () => {
+      // 先经真实 adapter 建库建 store,再安放 keep-alive 阻塞事务
+      await rawIdbStorage.setItem('__warmup__', '1')
+      const releaseHold = await holdKvStore()
+
+      // 匿名会话的一笔编辑:persist setItem 暂存(屏障会把它 flush 成排队在阻塞
+      // 事务后面的卡死写——这正是 timed-out 的来源)
+      useCanvasStore.getState().setActiveTool('brush')
+
+      // 观测面:三个 rehydrate 只许 0 次(装在 mount 之前)
+      const canvasRehydrateSpy = vi.spyOn(useCanvasStore.persist, 'rehydrate')
+      const chatRehydrateSpy = vi.spyOn(useChatStore.persist, 'rehydrate')
+      const settingsRehydrateSpy = vi.spyOn(useSettingsStore.persist, 'rehydrate')
+
+      fetchMeMock.mockResolvedValue({ authenticated: true, user: { id: 'user-u', name: 'U' } })
+
+      container = document.createElement('div')
+      document.body.appendChild(container)
+      root = createRoot(container)
+      root.render(<Harness />)
+
+      // 有界放行:生产 5s 屏障 + 编排开销,10s 内必须 hydrated——阻塞事务全程未释放,
+      // 所以这个 true 只能来自「跳过盘面水合」的路径,不可能来自读到盘面。
+      const start = Date.now()
+      expect(await waitFor(() => observed.hydrated, 10_000)).toBe(true)
+      expect(Date.now() - start).toBeLessThan(10_000)
+
+      // fail-closed + 跳过语义齐备
+      expect(getPersistUserId()).toBe('anonymous') // 未切号
+      expect(useAuthStore.getState().status).toBe('unauthenticated')
+      expect(toastFeedback.error).toHaveBeenCalledTimes(1) // 已告知恰一次(文案键专测在 worldSwitch ③b)
+      expect(migrateSpy).not.toHaveBeenCalled()
+      expect(canvasRehydrateSpy).not.toHaveBeenCalled()
+      expect(chatRehydrateSpy).not.toHaveBeenCalled()
+      expect(settingsRehydrateSpy).not.toHaveBeenCalled()
+      expect(useCanvasStore.getState().activeTool).toBe('brush') // 内存态可用
+
+      // 释放阻塞事务:不得出现迟发水合(中途 rehydrate 会覆盖用户已开始的编辑)
+      releaseHold()
+      await new Promise((resolve) => setTimeout(resolve, 300))
+      expect(canvasRehydrateSpy).not.toHaveBeenCalled()
+      expect(chatRehydrateSpy).not.toHaveBeenCalled()
+      expect(settingsRehydrateSpy).not.toHaveBeenCalled()
+      expect(useCanvasStore.getState().activeTool).toBe('brush') // 内存态未被覆盖
+    },
+    20_000,
+  )
+})
