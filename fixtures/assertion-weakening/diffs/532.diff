+// canvasPersistWriteScheduler — #505 持久化写防抖(P1-2 第一刀)。
+//
+// 此前 zustand persist 每次 store set()(含拖拽逐帧)都同步走
+// partialize → JSON.stringify(全库)→ IDB put,零防抖。本模块把 persist 的
+// storage 换成自定义 PersistStorage:setItem 只暂存最新 StorageValue(引用捕获,
+// store 不可变更新保证是当次一致快照),trailing debounce 到期才做
+// 「compact + stringify + 底层写」——重活全部移出编辑热路径。
+//
+// ── 架构:入队冻结物理目标(R5 终审裁定)──────────────────────────────────────
+// setItem **同步**解析并冻结写目标:{物理键(含 kernel 两域的已解析 key)、
+// 不可变 state 引用、写通道}。flush 的唯一职责 = 把冻结内容写到冻结地址
+// (compact + stringify 仍延迟到 flush,内容来自冻结的不可变引用,天然是入队
+// 时刻的世界)。账号切换后迟到启动的写只会落**旧物理键**——语义合法(那本来
+// 就是旧世界的最后状态),不需要任何 gate/激活协议/世界会话。此前各轮的
+// WorldSession / ticket / hydrating 缓冲 / page-ending 信号全部退役:陈旧写被
+// 改造为无害,而不是被验证与拒绝。
+//
+// - **pending / read-your-writes 快照都按冻结物理键索引**:getItem 查「当前世界
+//   物理键」的快照——跨 UID 不可见是结构性质(旧世界的 pending 键 ≠ 当前键,
+//   查不到),不再需要 uid 校验。remove 落 tombstone 读返回 null。快照含已启动
+//   in-flight 的那份,getItem 永不 await 在途写(活性)。
+// - **统一有界屏障**:flush 暂存 + 等在途合并为单一 barrier(默认 5s,超时
+//   error + 照常推进——隐私清理/跳转优先于卡死的写)。logout / A→B / 匿名首登
+//   三个调用点同一口径。
+// - **logout「退出即弃」**:同步丢全部 pending + 有界屏障 + 一次性置位吸收态
+//   (本页紧接 SSO redirect,此后 set/remove 丢弃 + error)。屏障(含超时)之后
+//   才落定的迟到写触发**按其冻结键**补删(删的必然是原键),补删失败 error 留痕。
+// - 代际顺序:per-物理键单调 epoch + IDB 同连接事务创建序(通过项,未动)。
+// - 关页兜底:visibilitychange→hidden 与 pagehide 双保险。失败绝不静默。
+//
+// getItem 的底层解析语义与被替换的 createJSONStorage 逐字节等价(JSON.parse 无
+// reviver,parse 错误照样上抛);envelope 键序同 zustand 原生 { state, version }。
+
+import type { StorageValue } from 'zustand/middleware'
+import { debugLogger } from './debugLogStore'
+
+const SOURCE = 'Persist Debounce'
+
+export const CANVAS_PERSIST_DEBOUNCE_MS = 800
+export const PERSIST_BARRIER_TIMEOUT_MS = 5000
+
+/** remove 的 tombstone:快照层记「最新真相是删除」,getItem 返回 null。 */
+const REMOVED = Symbol('persist-removed')
+
+/** 屏障结果:'timed-out' = 有在途写卡死跨过 deadline(error 已落账)。auth 侧
+ *  据此改变后续路径——anonymous→uid 超时必须 **fail-closed 不切号**(页内 FX-6
+ *  认领不能在「卡死写可能随时解卡落 raw」的盘面上做,否则认领后解卡的写成永久
+ *  raw 孤儿;不切号则解卡写落 raw = 匿名世界合法终态,下次启动自然重试)。 */
+export type PersistBarrierOutcome = 'settled' | 'timed-out'
+
+/** 入队时刻同步冻结的物理写目标。key 是冻结的物理键身份(legacy 单 blob:
+ *  namespaced key;kernel split:documentKey)——pending/快照索引与迟到补删都
+ *  锚定它;write/remove 闭包捕获**已解析**的物理键,不得再读任何可变全局。 */
+export type FrozenPersistTarget = {
+  key: string
+  write: (serialized: string) => Promise<void>
+  remove: () => Promise<void>
+  /** logout 迟到写补删专用:失败必须 **propagate**(普通 remove 维持底层
+   *  warn-不抛的旧语义,补删失败吞掉会让「已清数据残留」无痕)。 */
+  removeStrict: () => Promise<void>
+}
+
+type DebouncedPersistStorage<S> = {
+  getItem: (name: string) => Promise<StorageValue<S> | null>
+  setItem: (name: string, value: StorageValue<S>) => void
+  removeItem: (name: string) => Promise<void>
+  /** 统一有界屏障:冲刷全部暂存写 + 等在途落定(默认 5s,超时 error+推进并返回
+   *  'timed-out',调用方据此决定后续路径)。 */
+  flushAndSettle: (reason: string, timeoutMs?: number) => Promise<PersistBarrierOutcome>
+  /** 测试观测:是否有暂存未落盘的写。 */
+  hasPendingWrite: () => boolean
+  /** logout 专用:丢弃全部暂存 + 有界屏障 + 吸收态置位 + arm 迟到写补删。 */
+  __discardAndSettleForLogout: () => Promise<PersistBarrierOutcome>
+  /** 测试专用:清空暂存与 read-your-writes 快照(替代旧架构里「终结会话」的
+   *  测试隔离作用——生产无世界终结概念,快照与磁盘一样是会话内持久事实)。 */
+  __resetForTests: () => void
+}
+
+// 注册表:authSlice 经下面两个出口驱动屏障。本模块只依赖 debugLogStore,
+// authSlice 可安全 import(无环)。
+const instances = new Set<DebouncedPersistStorage<unknown>>()
+
+/** 账号切换屏障(A→B 与 anonymous→uid 同一口径):冲刷全部暂存写进**当前
+ *  (旧)世界的冻结键** + 有界等在途。在 setPersistUserId 之前 await。返回聚合
+ *  状态:任一实例超时 → 'timed-out'——anonymous→uid 据此 fail-closed 不切号
+ *  (页内认领不能面对「卡死写可能解卡落 raw」的活动盘面);settled 时切换后
+ *  新入队的写落新键、旧冻结键已静止。 */
+export const flushPersistBarrierForUserSwitch = async (
+  reason: string,
+): Promise<{ status: PersistBarrierOutcome }> => {
+  let status: PersistBarrierOutcome = 'settled'
+  for (const instance of instances) {
+    if ((await instance.flushAndSettle(reason)) === 'timed-out') status = 'timed-out'
+  }
+  return { status }
+}
+
+/** logout 屏障:「退出即弃」——丢弃暂存、有界等在途、置吸收态。返回后不存在
+ *  还能写回旧命名空间的正常通道;超时未决的迟到写落定时按其冻结键补删。返回
+ *  聚合状态供调用方日志口径(隐私清理无论 settled/timed-out 都照常推进)。 */
+export const discardPersistWritesForLogout = async (): Promise<{ status: PersistBarrierOutcome }> => {
+  let status: PersistBarrierOutcome = 'settled'
+  for (const instance of instances) {
+    if ((await instance.__discardAndSettleForLogout()) === 'timed-out') status = 'timed-out'
+  }
+  return { status }
+}
+
+/** 测试专用:清空实例注册表——跨测试残留的卡死实例会让注册表屏障永久等待。 */
+export const __clearDebouncedPersistInstancesForTests = (): void => {
+  instances.clear()
+}
+
+export const createDebouncedCompactPersistStorage = <S>(options: {
+  /** 同步解析**当前世界**的冻结物理写目标(legacy: namespaced 单 key /
+   *  kernel=new: document+session 两域原子写)。setItem/removeItem 入队时调用
+   *  一次并冻结返回值;getItem 每次调用以取「当前世界物理键」做快照索引。 */
+  resolveTarget: (name: string) => FrozenPersistTarget
+  /** 当前世界的底层读(快照未命中时走它;含各 adapter 的迁移/回退语义)。 */
+  readCurrent: (name: string) => Promise<string | null>
+  /** flush 时对暂存 state 做的压缩(compactCanvasesForPersist 等);输出进 JSON.stringify。 */
+  compactAtFlush: (state: S) => S
+  debounceMs?: number
+  /** 屏障超时(默认 5s);测试注入短超时以真实计时器验证超时路径。 */
+  barrierTimeoutMs?: number
+  /** 测试注入:跳过 window/document 生命周期监听注册。 */
+  skipLifecycleListeners?: boolean
+}): DebouncedPersistStorage<S> => {
+  const {
+    resolveTarget,
+    readCurrent,
+    compactAtFlush,
+    debounceMs = CANVAS_PERSIST_DEBOUNCE_MS,
+    barrierTimeoutMs = PERSIST_BARRIER_TIMEOUT_MS,
+  } = options
+
+  // pending / 快照 / epoch 全部按冻结物理键索引(代际顺序是物理键的属性)。
+  type PendingJob = { target: FrozenPersistTarget; value: StorageValue<S>; timer: ReturnType<typeof setTimeout> }
+  const pendingByKey = new Map<string, PendingJob>()
+  // read-your-writes:per-键「最新已接受快照」——setItem 接受即更新,写启动后仍
+  // 保留(含 in-flight 那份),getItem 直读它,永不等在途写。remove 落 tombstone。
+  const latestByKey = new Map<string, StorageValue<S> | typeof REMOVED>()
+  const inflight = new Set<Promise<void>>()
+  const nextEpochByKey = new Map<string, number>()
+  const lastStartedEpochByKey = new Map<string, number>()
+  // logout 吸收态:一次性置位(本页紧接 SSO redirect)。置位后 set/remove 丢弃
+  // + error;屏障(含超时)后落定的迟到写按其冻结键补删。
+  let loggedOut = false
+  let lateWriteCleanupArmed = false
+
+  const claimEpoch = (key: string): number => {
+    const epoch = (nextEpochByKey.get(key) ?? 0) + 1
+    nextEpochByKey.set(key, epoch)
+    return epoch
+  }
+
+  /** epoch 守卫:比已启动者旧的 job 一律拒绝(代际顺序不变量;当前实现里
+   *  claim 与 start 同步发生,理论上不会触发——这是防未来改动的兜底)。 */
+  const startAllowed = (key: string, epoch: number): boolean => {
+    const last = lastStartedEpochByKey.get(key) ?? 0
+    if (epoch <= last) {
+      debugLogger.warn(SOURCE, `superseded job(epoch ${epoch} ≤ ${last})拒绝启动:${key}`)
+      return false
+    }
+    lastStartedEpochByKey.set(key, epoch)
+    return true
+  }
+
+  const serializeSnapshot = (value: StorageValue<S>): string =>
+    JSON.stringify({ state: compactAtFlush(value.state), version: value.version })
+
+  /** 追踪在途写。isWrite 的 job 在 logout 屏障(含超时)后才落定 → 按其**冻结键**
+   *  补删(删的必然是原键——目标在入队时就冻结了),补删自身失败 error 留痕。 */
+  const track = (target: FrozenPersistTarget, job: Promise<void>, isWrite: boolean): Promise<void> => {
+    inflight.add(job)
+    void job.finally(() => {
+      inflight.delete(job)
+      if (isWrite && lateWriteCleanupArmed) {
+        debugLogger.error(SOURCE, `迟到写在 logout 终局后落定,按冻结键补删 ${target.key} 防复活已清数据`)
+        void target.removeStrict().catch((error) => {
+          debugLogger.error(
+            SOURCE,
+            `迟到写补删失败(${target.key}),已清数据可能残留: ${error instanceof Error ? error.message : String(error)}`,
+          )
+        })
+      }
+    })
+    return job
+  }
+
+  /** 启动一笔冻结写:内容(compact+stringify)此刻才算,但来自冻结的不可变引用;
+   *  地址是入队时冻结的物理键。同键落盘顺序由同一 IDB 连接的事务创建序
+   *  (= 本处调用序 = epoch 序)保证,写启动即同步进入底层事务队列。 */
+  const startWrite = (target: FrozenPersistTarget, value: StorageValue<S>, reason: string): Promise<void> => {
+    if (!startAllowed(target.key, claimEpoch(target.key))) return Promise.resolve()
+    const write = (async () => {
+      try {
+        await target.write(serializeSnapshot(value))
+      } catch (error) {
+        // 失败不可静默:底层 adapter 已按各自路径记 quota/降级日志,这里兜住
+        // compact/stringify 或未预期的 adapter 异常,保证任何一次丢写都有痕迹。
+        debugLogger.error(
+          SOURCE,
+          `flush(${reason}) 落盘失败,本次状态未持久化(${target.key}): ${error instanceof Error ? error.message : String(error)}`,
+        )
+      }
+    })()
+    return track(target, write, true)
+  }
+
+  /** 冲刷全部暂存写(立即启动,返回这批写的落定 Promise)。 */
+  const flushAllPending = (reason: string): Promise<void> => {
+    const started: Promise<void>[] = []
+    for (const [key, job] of pendingByKey) {
+      clearTimeout(job.timer)
+      pendingByKey.delete(key)
+      started.push(startWrite(job.target, job.value, reason))
+    }
+    return Promise.all(started).then(() => undefined)
+  }
+
+  const boundedSettle = async (all: () => Promise<void>, timeoutMs: number): Promise<PersistBarrierOutcome> => {
+    let timedOut = false
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const timeout = new Promise<void>((resolve) => {
+      timer = setTimeout(() => {
+        timedOut = true
+        resolve()
+      }, timeoutMs)
+    })
+    await Promise.race([all(), timeout])
+    if (timer !== undefined) clearTimeout(timer)
+    if (timedOut) {
+      debugLogger.error(SOURCE, `屏障等待在途写超时(${timeoutMs}ms),照常推进——隐私清理/跳转优先于卡死的写`)
+      return 'timed-out'
+    }
+    return 'settled'
+  }
+
+  const flushAndSettle = (reason: string, timeoutMs = barrierTimeoutMs): Promise<PersistBarrierOutcome> =>
+    // 排空到静止:每轮重查 pending **和** inflight,两者皆空才返回——屏障等待期
+    // 新入队的写(如首登屏障慢写期间用户继续编辑)也在本屏障内落定,否则它会在
+    // FX-6 认领读盘之后才 debounce 落盘,成为 raw 孤儿。整体仍在单一超时上限内。
+    boundedSettle(async () => {
+      while (pendingByKey.size > 0 || inflight.size > 0) {
+        await flushAllPending(reason)
+        while (inflight.size > 0) {
+          await Promise.all([...inflight])
+        }
+      }
+    }, timeoutMs)
+
+  const storage: DebouncedPersistStorage<S> = {
+    getItem: async (name) => {
+      // read-your-writes:查**当前世界物理键**的快照——旧世界的快照键 ≠ 当前键,
+      // 跨 UID 不可见是结构性质。快照命中经同一 compact+stringify 管线返回。
+      const currentKey = resolveTarget(name).key
+      const snapshot = latestByKey.get(currentKey)
+      if (snapshot === REMOVED) return null
+      if (snapshot !== undefined) {
+        return JSON.parse(serializeSnapshot(snapshot)) as StorageValue<S>
+      }
+      const raw = await readCurrent(name)
+      if (raw == null) return null
+      return JSON.parse(raw) as StorageValue<S>
+    },
+    setItem: (name, value) => {
+      if (loggedOut) {
+        debugLogger.error(SOURCE, `logout 后丢弃 setItem(本页已「退出即弃」,紧接 SSO 跳转):${name}`)
+        return
+      }
+      // 入队即冻结:物理键/通道此刻解析,state 引用不可变——此后无论 uid 怎么
+      // 变,这笔写只会落这个键。
+      const target = resolveTarget(name)
+      latestByKey.set(target.key, value)
+      const existing = pendingByKey.get(target.key)
+      if (existing) clearTimeout(existing.timer)
+      const timer = setTimeout(() => {
+        const job = pendingByKey.get(target.key)
+        pendingByKey.delete(target.key)
+        if (job) void startWrite(job.target, job.value, 'debounce')
+      }, debounceMs)
+      pendingByKey.set(target.key, { target, value, timer })
+    },
+    removeItem: async (name) => {
+      if (loggedOut) {
+        debugLogger.error(SOURCE, `logout 后丢弃 removeItem(权威清理走 clearCurrentUserCache 直连 adapter):${name}`)
+        return
+      }
+      // remove 线性化:清同键暂存、落 tombstone、占 epoch 后立即启动删除。已启动
+      // 的旧 set 事务在 IDB 里排在本 delete 前(终态=删除);未启动的旧 set 已被清。
+      const target = resolveTarget(name)
+      const existing = pendingByKey.get(target.key)
+      if (existing) {
+        clearTimeout(existing.timer)
+        pendingByKey.delete(target.key)
+      }
+      latestByKey.set(target.key, REMOVED)
+      if (!startAllowed(target.key, claimEpoch(target.key))) return
+      await track(
+        target,
+        (async () => {
+          try {
+            await target.remove()
+          } catch (error) {
+            debugLogger.error(SOURCE, `removeItem 落盘失败(${target.key}): ${error instanceof Error ? error.message : String(error)}`)
+          }
+        })(),
+        false,
+      )
+    },
+    flushAndSettle,
+    hasPendingWrite: () => pendingByKey.size > 0,
+    __discardAndSettleForLogout: async () => {
+      // 同步丢弃全部暂存 + 快照,置吸收态——先于一切 await,discard 之后不存在
+      // 还能进入正常写通道的 job。
+      loggedOut = true
+      for (const job of pendingByKey.values()) clearTimeout(job.timer)
+      pendingByKey.clear()
+      latestByKey.clear()
+      // 有界等在途;屏障(含超时)完成后 arm 迟到写补删——无论当下有没有在途写
+      // 都要 arm(卡死写可能在任意晚的时刻落定)。
+      const outcome = await boundedSettle(async () => {
+        while (inflight.size > 0) {
+          await Promise.all([...inflight])
+        }
+      }, barrierTimeoutMs)
+      lateWriteCleanupArmed = true
+      return outcome
+    },
+    __resetForTests: () => {
+      for (const job of pendingByKey.values()) clearTimeout(job.timer)
+      pendingByKey.clear()
+      latestByKey.clear()
+    },
+  }
+
+  if (!options.skipLifecycleListeners) {
+    // 关页/切后台兜底:hidden 与 pagehide 双保险(移动端 tab 冻结常只发其一)。
+    // 不 await——浏览器不会等你;写启动即同步进入可独立提交的底层事务。
+    const lifecycleFlush = (reason: string) => {
+      if (pendingByKey.size > 0) debugLogger.log(SOURCE, `flush on ${reason}(关页/切后台兜底)`)
+      void flushAllPending(reason)
+    }
+    if (typeof document !== 'undefined' && typeof document.addEventListener === 'function') {
+      document.addEventListener('visibilitychange', () => {
+        if (document.visibilityState !== 'hidden') return
+        lifecycleFlush('visibilitychange')
+      })
+    }
+    if (typeof window !== 'undefined' && typeof window.addEventListener === 'function') {
+      window.addEventListener('pagehide', () => lifecycleFlush('pagehide'))
+    }
+  }
+
+  instances.add(storage as DebouncedPersistStorage<unknown>)
+  return storage
+}
