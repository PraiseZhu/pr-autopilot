+  it("outcome='persist-busy' → 跳过盘面水合(migrate 0 + 三 rehydrate 0)但 hydrated 放行(内存默认态)", async () => {
+    // 九审终裁:盘面读会排在卡死写事务后面——放行的前提是**不碰盘面**。与八轮
+    // 「冻结不放行」的区别:现在是「跳过并放行」,内存默认(匿名新会话)态可用。
+    spies.hydrateMock.mockResolvedValue('persist-busy')
+    await mountAndSettle()
+    expect(spies.hydrateMock).toHaveBeenCalled()
+    expect(spies.migrateSpy).not.toHaveBeenCalled()
+    expect(spies.canvasRehydrate).not.toHaveBeenCalled()
+    expect(spies.chatRehydrate).not.toHaveBeenCalled()
+    expect(spies.settingsRehydrate).not.toHaveBeenCalled()
+    expect(observed.hydrated).toBe(true) // 首屏放行,不等任何盘面事务
+  })
+
+  it("outcome='reload-issued'(A→B 整页 reload 在途)→ 同口径中止", async () => {
+    spies.hydrateMock.mockResolvedValue('reload-issued')
+    await mountAndSettle()
+    expect(spies.migrateSpy).not.toHaveBeenCalled()
+    expect(spies.canvasRehydrate).not.toHaveBeenCalled()
+    expect(spies.chatRehydrate).not.toHaveBeenCalled()
+    expect(spies.settingsRehydrate).not.toHaveBeenCalled()
