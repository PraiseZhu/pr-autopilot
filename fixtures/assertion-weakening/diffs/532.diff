@@ -0,0 +1,182 @@
+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #505:kernel=new 无可用 IDB 的**启动降级**。
+// - probeIdbOperational 是真实 open + noop 事务的 operational 探测:覆盖
+//   「indexedDB 全局存在但用不了」的两类失败(open reject / transaction 抛错),
+//   纯存在性判定(旧口径)会误判可用。结果每会话缓存一次。
+// - **接线口 = ensureEffectiveKernelReady()**(probe + degrade 的共享 boot 单例):
+//   主站 useStoreHydration 与插件 usePluginHydration 在任何 restore/rehydrate 前
+//   都 await 它——本文件直接测这个生产函数(不手抄编排逻辑),并以源码契约钉住
+//   两条水合链的调用点与顺序。kernel=new 语义只在 operational IDB 下存在。
+
+import hydrationSource from './useStoreHydration.ts?raw'
+import pluginHydrationSource from '../../cindyplugin/src/usePluginHydration.ts?raw'
+import mainSource from '../main.tsx?raw'
+
+const debugLogger = { log: vi.fn(), warn: vi.fn(), error: vi.fn() }
+vi.mock('../store/debugLogStore', () => ({ debugLogger }))
+
+// kernelMode 在模块加载时一次性解析:经 VITE_MIVO_KERNEL env(动态索引,专为
+// vi.stubEnv 留的测试缝)把本测试文件的 kernel 请求值钉成 new。
+vi.stubEnv('VITE_MIVO_KERNEL', 'new')
+
+const { probeIdbOperational, __resetIdbOperationalProbeForTests, __resetIdbPersist } = await import(
+  '../lib/persistIdbStorage'
+)
+const {
+  kernelMode,
+  getEffectiveKernelMode,
+  isLegacyKernelEffective,
+  degradeKernelToLegacyForSession,
+  ensureEffectiveKernelReady,
+  warnIfEffectiveKernelBootPending,
+  __resetKernelDegradationForTests,
+} = await import('./kernelMode')
+
+/** open 即失败的假 indexedDB(全局存在,operational 不可用)。 */
+const brokenOpenIdb = () => ({
+  open: () => {
+    const request: { onerror?: (e: unknown) => void; onsuccess?: () => void; onupgradeneeded?: () => void; error: Error } = {
+      error: new Error('open rejected (private mode)'),
+    }
+    setTimeout(() => request.onerror?.({ target: request }), 0)
+    return request
+  },
+})
+
+/** open 成功但事务创建即抛的假 indexedDB(连接可开,事务层坏)。 */
+const brokenTxIdb = () => ({
+  open: () => {
+    const db = {
+      objectStoreNames: { contains: () => true },
+      transaction: () => {
+        throw new Error('tx aborted (quota lockdown)')
+      },
+      close: () => undefined,
+    }
+    const request: { onerror?: () => void; onsuccess?: () => void; onupgradeneeded?: () => void; result: unknown } = {
+      result: db,
+    }
+    setTimeout(() => request.onsuccess?.(), 0)
+    return request
+  },
+  deleteDatabase: () => {
+    const request: { onsuccess?: () => void; onerror?: () => void; onblocked?: () => void } = {}
+    setTimeout(() => request.onsuccess?.(), 0)
+    return request
+  },
+})
+
+describe('kernel=new 启动降级(operational 探测 + 会话级生效值)', () => {
+  beforeEach(async () => {
+    vi.unstubAllGlobals()
+    await __resetIdbPersist().catch(() => undefined)
+    __resetIdbOperationalProbeForTests()
+    __resetKernelDegradationForTests()
+    debugLogger.error.mockClear()
+  })
+
+  it('请求值确认:env 钉 kernel=new(降级测试的前提自检)', () => {
+    expect(kernelMode).toBe('new')
+    expect(getEffectiveKernelMode()).toBe('new')
+  })
+
+  it('open reject:operational 探测 false', async () => {
+    vi.stubGlobal('indexedDB', brokenOpenIdb())
+    expect(await probeIdbOperational()).toBe(false)
+  })
+
+  it('transaction 抛错:纯存在性判定会误判可用,operational 探测识破', async () => {
+    vi.stubGlobal('indexedDB', brokenTxIdb())
+    expect(typeof indexedDB).not.toBe('undefined') // 存在性判定会说"可用"
+    expect(await probeIdbOperational()).toBe(false)
+  })
+
+  it('探测缓存:会话内只探一次(第二次调用不再触发 open)', async () => {
+    let openCalls = 0
+    const counting = brokenOpenIdb()
+    vi.stubGlobal('indexedDB', {
+      open: () => {
+        openCalls += 1
+        return counting.open()
+      },
+    })
+    await probeIdbOperational()
+    await probeIdbOperational()
+    expect(openCalls).toBe(1)
+  })
+
+  it('降级:生效内核翻转 legacy,error 日志恰一次(重复调用不刷屏)', () => {
+    degradeKernelToLegacyForSession('IDB operational 探测失败(测试)')
+    expect(getEffectiveKernelMode()).toBe('legacy')
+    expect(isLegacyKernelEffective()).toBe(true)
+    expect(kernelMode).toBe('new') // 请求值不变——只降生效值
+    degradeKernelToLegacyForSession('再来一次')
+    const kernelErrors = debugLogger.error.mock.calls.filter(([source]) => source === 'Kernel')
+    expect(kernelErrors).toHaveLength(1)
+    expect(String(kernelErrors[0][1])).toContain('降级为 legacy')
+  })
+
+  it('接线口(生产函数):IDB 坏 → ensureEffectiveKernelReady 后生效内核 = legacy,幂等单飞', async () => {
+    vi.stubGlobal('indexedDB', brokenOpenIdb())
+    const first = ensureEffectiveKernelReady()
+    expect(ensureEffectiveKernelReady()).toBe(first) // 单例 boot promise(两条水合链共享)
+    await first
+    expect(getEffectiveKernelMode()).toBe('legacy')
+    await ensureEffectiveKernelReady() // 幂等
+    const kernelErrors = debugLogger.error.mock.calls.filter(([source]) => source === 'Kernel')
+    expect(kernelErrors).toHaveLength(1)
+  })
+
+  it('接线口(生产函数):IDB 可用 → ensureEffectiveKernelReady 后生效内核保持 new', async () => {
+    const { IDBFactory } = await import('fake-indexeddb')
+    vi.stubGlobal('indexedDB', new IDBFactory())
+    await ensureEffectiveKernelReady()
+    expect(await probeIdbOperational()).toBe(true) // operational 探测真过(非存在性)
+    expect(getEffectiveKernelMode()).toBe('new')
+    expect(isLegacyKernelEffective()).toBe(false)
+  })
+
+  it('接线契约:闸先于**一切持久化口**——main eager auth.hydrate / auth 屏障 / migrate / rehydrate / 插件 restore', () => {
+    // main.tsx 的 eager auth.hydrate 必须被闸串行化(.then 结构直接钉时序,
+    // 不靠 index 比较——await 后移到 hydrate 之后仍会被这里揪出)。
+    expect(mainSource).toMatch(
+      /ensureEffectiveKernelReady\(\)\s*\.then\(\(\) => useAuthStore\.getState\(\)\.hydrate\(\)\)/,
+    )
+    expect(mainSource).not.toMatch(/^void useAuthStore\.getState\(\)\.hydrate\(\)/m)
+    // useStoreHydration:闸 < auth.hydrate(hydrate 内的账号切换屏障会冻结通道)
+    const gateAt = hydrationSource.indexOf('await ensureEffectiveKernelReady()')
+    expect(gateAt).toBeGreaterThan(0)
+    expect(gateAt).toBeLessThan(hydrationSource.indexOf('useAuthStore.getState().hydrate()'))
+    // useStoreHydration:闸 < migrate 仪式 < rehydrate
+    expect(gateAt).toBeLessThan(hydrationSource.indexOf('migrateV10ToV11('))
+    expect(gateAt).toBeLessThan(hydrationSource.indexOf('.persist.rehydrate()'))
+    // 插件:闸 < 磁盘 restore
+    expect(pluginHydrationSource).toContain('await ensureEffectiveKernelReady()')
+    expect(pluginHydrationSource.indexOf('await ensureEffectiveKernelReady()')).toBeLessThan(
+      pluginHydrationSource.indexOf('restoreFromDiskIfEmpty()'),
+    )
+  })
+
+  it('运行时守卫(fail-visible):boot 未完成即解析通道 → error 恰一次;boot 完成后静默', async () => {
+    // boot 前调用(kernel=new 请求下)→ error 落账,且不重复刷
+    warnIfEffectiveKernelBootPending('test.resolveTarget')
+    warnIfEffectiveKernelBootPending('test.resolveTarget')
+    const pre = debugLogger.error.mock.calls.filter(
+      ([source, message]) => source === 'Kernel' && String(message).includes('boot 完成前'),
+    )
+    expect(pre).toHaveLength(1)
+
+    // boot 完成后 → 静默(守卫只抓编排回归,不骚扰正常路径)
+    __resetKernelDegradationForTests()
+    debugLogger.error.mockClear()
+    vi.stubGlobal('indexedDB', brokenOpenIdb())
+    await ensureEffectiveKernelReady()
+    warnIfEffectiveKernelBootPending('test.resolveTarget')
+    const post = debugLogger.error.mock.calls.filter(
+      ([source, message]) => source === 'Kernel' && String(message).includes('boot 完成前'),
+    )
+    expect(post).toHaveLength(0)
+  })
+})
diff --git a/src/app/kernelMode.ts b/src/app/kernelMode.ts
index 9289cdee..c9adc208 100644
--- a/src/app/kernelMode.ts
+++ b/src/app/kernelMode.ts
@@ -85,3 +85,81 @@ export function getKernelMode(): KernelMode {
 
 export const isLegacyKernel = kernelMode === 'legacy'
 export const isNewKernel = kernelMode === 'new'
+
+// ── #505 启动降级(会话级)────────────────────────────────────────────────────
+// kernel=new 的 split-domain canonical 依赖可用的 IndexedDB(两域一笔事务原子写);
+// IDB operational 探测失败(private mode / 配额封锁 / open 被 block)的环境里
+// kernel=new 语义不存在——**生效内核**降级为 legacy(URL/env 请求值仍在,但本会话
+// 不生效;与 rendererMode 非法值回退默认同款精神)。降级只发生在 useStoreHydration
+// 启动编排里、任何 persist 读写之前;error 日志恰一次。
+
+let degradedToLegacyThisSession = false
+
+/** 启动降级:kernel=new 请求 + IDB operational 探测失败 → 本会话生效内核 = legacy。 */
+export const degradeKernelToLegacyForSession = (reason: string): void => {
+  if (kernelMode !== 'new' || degradedToLegacyThisSession) return
+  degradedToLegacyThisSession = true
+  debugLogger.error('Kernel', `kernel=new 本会话降级为 legacy:${reason}(URL/env 请求值不生效,单 blob 通道)`)
+}
+
+/** 生效内核:持久化路径(persist backend / migrate 仪式 / e2e 物理键)一律读它,
+ *  不读启动请求值 isLegacyKernel/isNewKernel。 */
+export const getEffectiveKernelMode = (): KernelMode =>
+  degradedToLegacyThisSession ? 'legacy' : kernelMode
+
+export const isLegacyKernelEffective = (): boolean => getEffectiveKernelMode() === 'legacy'
+
+// 单例 boot promise:probe + degrade 的共享封装。主站 useStoreHydration 与插件
+// usePluginHydration 在任何 restore/rehydrate/persist 写之前都必须 await 它——
+// 生效内核的判定恰一次,两条水合链同一把闸,不存在旁路。
+// (probeIdbOperational 动态 import:kernelMode 被大量模块在加载期引用,静态挂上
+// persistIdbStorage 的依赖闭包会制造 app↔lib↔store 环;boot 路径一次性动态解析。)
+let effectiveKernelReady: Promise<void> | undefined
+let effectiveKernelBootCompleted = false
+let bootPendingWarned = false
+
+/** 等生效内核判定完成(幂等,单飞,**total/never-reject**)。kernel=legacy 请求值
+ *  下直接返回。任何异常(dynamic import 失败 / probe 未吞的异常)→ error 落账 +
+ *  按 fail-safe 降级 legacy + 照常 resolve——boot 是 main 的 .then 链、主站 hook、
+ *  插件 hook 三条链的公共前置,reject 会把三条链一起打死。 */
+export const ensureEffectiveKernelReady = (): Promise<void> => {
+  if (effectiveKernelReady) return effectiveKernelReady
+  effectiveKernelReady = (async () => {
+    try {
+      if (kernelMode !== 'new') return
+      const { probeIdbOperational } = await import('../lib/persistIdbStorage')
+      if (!(await probeIdbOperational())) {
+        degradeKernelToLegacyForSession('IDB operational 探测失败(open/事务不可用)')
+      }
+    } catch (error) {
+      debugLogger.error(
+        'Kernel',
+        `effective-kernel boot 异常,fail-safe 降级 legacy: ${error instanceof Error ? error.message : String(error)}`,
+      )
+      degradeKernelToLegacyForSession('boot 异常(import/probe 失败)')
+    } finally {
+      effectiveKernelBootCompleted = true
+    }
+  })()
+  return effectiveKernelReady
+}
+
+/** 运行时守卫(fail-visible,防未来编排回归):kernel=new 请求下,boot 完成前
+ *  就有调用方解析持久化通道 → error 落账恰一次。**只报警不阻塞**——写按当时
+ *  生效值冻结照常进行(阻塞会制造新的丢写面);正确编排下不可达。 */
+export const warnIfEffectiveKernelBootPending = (source: string): void => {
+  if (kernelMode !== 'new' || effectiveKernelBootCompleted || bootPendingWarned) return
+  bootPendingWarned = true
+  debugLogger.error(
+    'Kernel',
+    `${source} 在 effective-kernel boot 完成前解析持久化通道(编排顺序回归)——写按当时生效值冻结,未阻塞`,
+  )
+}
+
+/** 测试专用:重置会话降级位与 boot 单例。 */
+export const __resetKernelDegradationForTests = (): void => {
+  degradedToLegacyThisSession = false
+  effectiveKernelReady = undefined
+  effectiveKernelBootCompleted = false
+  bootPendingWarned = false
+}
