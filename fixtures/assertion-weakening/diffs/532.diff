+    const reference: StateStorage = {
+      getItem: async (name) => referenceData.get(name) ?? null,
+      setItem: async (name, value) => {
+        referenceCalls.push(value)
+        referenceData.set(name, value)
+      },
+      removeItem: async () => undefined,
+    }
+    const jsonStorage = createJSONStorage<Slice>(() => reference)!
+
+    const value = storageValue('select')
+    storage.setItem('k', value)
+    await storage.flushAndSettle('test')
+    await jsonStorage.setItem('k', value)
+
+    expect(backend.writeCalls[0][1]).toBe(referenceCalls[0])
+    // getItem 语义同样等价(JSON.parse 无 reviver;null 透传)
+    expect(await storage.getItem('k')).toEqual(await jsonStorage.getItem('k'))
+    expect(await storage.getItem('missing')).toBeNull()
+  })
+
+  it('关页兜底:pagehide 强制 flush 暂存写(真实事件,非手动调 flush)', async () => {
+    const backend = makeBackend()
+    const storage = makeStorage(backend)
+    storage.setItem(NAME, storageValue('brush'))
+    expect(backend.writeCalls).toHaveLength(0)
+
+    window.dispatchEvent(new Event('pagehide'))
+    await storage.flushAndSettle('drain')
+    expect(backend.writeCalls).toHaveLength(1)
+    expect(debugLogger.log).toHaveBeenCalledWith('Persist Debounce', expect.stringContaining('pagehide'))
+  })
+
+  it('切后台兜底:visibilitychange→hidden 强制 flush;可见态切换不触发', async () => {
+    const backend = makeBackend()
+    const storage = makeStorage(backend)
+    storage.setItem(NAME, storageValue('hand'))
+
