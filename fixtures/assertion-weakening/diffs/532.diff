+import { describe, expect, it, vi } from 'vitest'
+
+// canvasDocumentModel 传递引入 demoScenes → demoImages 需要 document(node 测试
+// 环境没有)——与 leaferLinePaint.test.ts 同款 mock。
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+import {
+  compactCanvasesForPersist,
+  compactDocumentForPersist,
+  compactNodeForPersist,
+} from './canvasDocumentModel'
+import { cloneNode } from './nodeFactory'
+import type { CanvasDocument, MivoCanvasNode } from '../types/mivoCanvas'
+
+// #505 三刀中两刀的回归:
+// - 刀3(按需拷贝):新 compactNodeForPersist 的 JSON 输出必须与旧
+//   「cloneNode 全量深拷贝再 delete」实现逐字节一致(含键序)——旧算法在测试里
+//   原样重建作参照,覆盖已归一/legacy 未归一/带旋转/带畸形锚点四类节点。
+// - 刀2(只 compact 变更画布):同一 document 引用复用缓存输出(零拷贝),
+//   引用变化才重新 compact。
+
+/** 旧实现原样重建(#505 前的 canvasDocumentModel.ts:76-91),作字节参照。 */
+const legacyCompactNodeForPersist = (node: MivoCanvasNode): MivoCanvasNode => {
+  const compactNode = cloneNode(node)
+  const transform = compactNode.transform
+  const rotation = transform?.rotation ?? 0
+
+  delete compactNode.asset
+  delete compactNode.fills
+  delete compactNode.relations
+  delete compactNode.strokes
+  delete compactNode.transform
+
+  return {
+    ...compactNode,
+    ...(Math.abs(rotation) > 0.0001 ? { transform } : {}),
+  }
+}
+
+const baseNode = (overrides: Partial<MivoCanvasNode> = {}): MivoCanvasNode =>
+  ({
+    id: 'n1',
+    type: 'image',
+    status: 'ready',
+    title: 'Img',
+    x: 10,
+    y: 20,
+    width: 200,
+    height: 100,
+    assetUrl: 'mivo-asset:abc',
+    ...overrides,
+  }) as unknown as MivoCanvasNode
+
