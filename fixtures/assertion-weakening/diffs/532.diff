+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { createJSONStorage, type StateStorage } from 'zustand/middleware'
+
+// #505 写防抖的可观测锚(lead 验收口径):连发 N 次 setItem 只落 1 次底层写;
+// 关页前强制 flush 有测试锚定(S01/S02 假成功前科,不允许"看起来写了")。
+//
+// 架构锚(入队冻结物理目标):setItem 入队时同步冻结 {物理键, state 引用},
+// flush 只把冻结内容写到冻结地址——账号切换后迟到启动的写**落旧键**(合法的
+// 旧世界终态),不丢、不 gate、不报警;跨 UID 读不可见是「键不同查不到」的
+// 结构性质。logout 是唯一吸收态(丢 pending + 有界屏障 + 迟到写按冻结键补删)。
+
+const debugLogger = { log: vi.fn(), warn: vi.fn(), error: vi.fn() }
+vi.mock('./debugLogStore', () => ({ debugLogger }))
+
+const { setPersistUserId, __resetPersistUserId, namespacedKey } = await import('../lib/persistUserId')
+const {
+  createDebouncedCompactPersistStorage,
+  CANVAS_PERSIST_DEBOUNCE_MS,
+  discardPersistWritesForLogout,
+  flushPersistBarrierForUserSwitch,
+  __clearDebouncedPersistInstancesForTests,
+} = await import('./canvasPersistWriteScheduler')
+
+type Slice = { canvases: Record<string, { title: string }>; activeTool?: string }
+
+const NAME = 'mivo-canvas-demo'
+
+/** 冻结目标测试后端:resolveTarget 在调用时刻解析 namespacedKey 并冻结进闭包
+ *  (与生产 createIdbFrozenTarget 同构),写/删按物理键记账。 */
+const makeBackend = () => {
+  const data = new Map<string, string>()
+  const backend = {
+    data,
+    /** [物理键, 值] 记账(写落定时 push,便于断言"落到了哪个键")。 */
+    writeCalls: [] as Array<[string, string]>,
+    removeCalls: [] as string[],
+    /** 注入:替换下一次/全部写的实现(卡死/慢写/失败注入)。 */
+    writeImpl: [] as Array<(key: string, value: string) => Promise<void>>,
+    removeImpl: undefined as undefined | ((key: string) => Promise<void>),
+    /** 注入:strict 补删失败(F4——普通 remove 与补删 strict 是两条原语)。 */
+    removeStrictImpl: undefined as undefined | ((key: string) => Promise<void>),
+    resolveTarget: (name: string) => {
+      const frozenKey = namespacedKey(name)
+      const doRemove = async () => {
+        backend.removeCalls.push(frozenKey)
+        data.delete(frozenKey)
+      }
+      return {
+        key: frozenKey,
+        write: async (value: string) => {
+          const impl = backend.writeImpl.shift()
+          if (impl) return impl(frozenKey, value)
+          backend.writeCalls.push([frozenKey, value])
+          data.set(frozenKey, value)
+        },
+        remove: async () => {
+          if (backend.removeImpl) return backend.removeImpl(frozenKey)
+          return doRemove()
+        },
+        removeStrict: async () => {
+          if (backend.removeStrictImpl) return backend.removeStrictImpl(frozenKey)
+          return doRemove()
+        },
+      }
+    },
+    readCurrent: async (name: string) => data.get(namespacedKey(name)) ?? null,
+  }
+  return backend
+}
+
+const makeStorage = (backend: ReturnType<typeof makeBackend>, extra?: { skipLifecycleListeners?: boolean; barrierTimeoutMs?: number }) =>
+  createDebouncedCompactPersistStorage<Slice>({
+    resolveTarget: backend.resolveTarget,
+    readCurrent: backend.readCurrent,
+    compactAtFlush: (s) => s,
+    ...extra,
+  })
+
+const storageValue = (tool: string, title = 'T') => ({
+  state: { canvases: { c1: { title } }, activeTool: tool } as Slice,
+  version: 12,
+})
+
+const microtasks = async (ticks = 10) => {
+  for (let tick = 0; tick < ticks; tick += 1) await Promise.resolve()
+}
+
+describe('createDebouncedCompactPersistStorage — #505 写防抖(冻结物理目标)', () => {
+  beforeEach(() => {
+    __resetPersistUserId()
+    __clearDebouncedPersistInstancesForTests()
+    vi.useFakeTimers()
+    debugLogger.log.mockClear()
