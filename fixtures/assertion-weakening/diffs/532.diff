+++ b/src/app/kernelBootTotal.test.ts
@@ -0,0 +1,63 @@
+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #505 八审 F2-余:ensureEffectiveKernelReady 必须 **total / never-reject**。
+// 它是 main 的 .then 链、主站 useStoreHydration、插件 usePluginHydration 三条链的
+// 公共前置——reject 会把三条链一起打死(auth 永不水合)。characterization:
+// dynamic import 失败 / probe 抛异常两例,都必须 resolve + fail-safe 降级 legacy +
+// error 落账,且下游(auth.hydrate 形态的 .then 链)照常执行。
+
+const state = vi.hoisted(() => ({ mode: 'import-boom' as 'import-boom' | 'probe-throw' }))
+const debugLogger = vi.hoisted(() => ({ log: vi.fn(), warn: vi.fn(), error: vi.fn() }))
+vi.mock('../store/debugLogStore', () => ({ debugLogger }))
+vi.mock('../lib/persistIdbStorage', () => {
+  if (state.mode === 'import-boom') {
+    throw new Error('import boom (chunk load failed)') // 模块级失败 → 动态 import reject
+  }
+  return {
+    probeIdbOperational: vi.fn(async () => {
+      throw new Error('probe boom (unswallowed)') // probe 自身抛出未吞异常
+    }),
+  }
+})
+
+vi.stubEnv('VITE_MIVO_KERNEL', 'new') // 请求值钉 new:走 probe 分支才有异常面
+
+describe('ensureEffectiveKernelReady total/never-reject(八审 F2-余 characterization)', () => {
+  beforeEach(() => {
+    vi.resetModules() // 每例重新求值 kernelMode(boot 单例/降级位归零)
+    debugLogger.error.mockClear()
+  })
+
+  const runCase = async () => {
+    const km = await import('./kernelMode')
+    const hydrateSpy = vi.fn()
+    // main.tsx 的链形态:boot reject 时 .then 永不执行 → auth 永不水合(这就是要防的)
+    await km.ensureEffectiveKernelReady().then(() => hydrateSpy())
+    expect(hydrateSpy).toHaveBeenCalledTimes(1) // 链存活:auth 照常 hydrate
+    expect(km.getEffectiveKernelMode()).toBe('legacy') // fail-safe 降级
+    const bootErrors = () =>
+      debugLogger.error.mock.calls.filter(
+        ([source, message]) => source === 'Kernel' && String(message).startsWith('effective-kernel boot 异常'),
+      )
+    const degradeErrors = () =>
+      debugLogger.error.mock.calls.filter(
+        ([source, message]) => source === 'Kernel' && String(message).includes('降级为 legacy'),
+      )
+    expect(bootErrors()).toHaveLength(1) // catch 兜底 error 恰一次
+    expect(degradeErrors()).toHaveLength(1) // 降级 error 恰一次
+    await km.ensureEffectiveKernelReady() // 幂等:单例缓存,不再抛/不再刷日志
+    expect(bootErrors()).toHaveLength(1)
+    expect(degradeErrors()).toHaveLength(1)
+  }
+
+  it('dynamic import 失败(chunk 加载失败形态)→ resolve + legacy + error 恰一次 + 下游链存活', async () => {
+    state.mode = 'import-boom'
+    await runCase()
+  })
+
+  it('probe 抛未吞异常 → 同口径 total 兜底', async () => {
+    state.mode = 'probe-throw'
+    await runCase()
+  })
+})
