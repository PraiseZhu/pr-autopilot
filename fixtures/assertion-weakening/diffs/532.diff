@@ -0,0 +1,94 @@
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it, vi } from 'vitest'
+
+// #505 P1-6:compact 从 partialize 移到 storage flush 后,插件 persistSync 的
+// 手动 envelope(不经 zustand storage)必须与主站走**同一 compact 出口**
+// (compactCanvasPersistSlice),否则 asset/fills/relations/strokes/transform
+// 全量进档案(契约回归)。三层钉:
+//   1) 源码契约:persistSync 的 envelope 构建必须经 compactCanvasPersistSlice
+//   2) 字节契约:compactCanvasPersistSlice(partialize(state)) 与 #505 前
+//      「partialize 内嵌 compact」的输出逐字节一致
+//   3) 缓存契约:未变画布跨两次调用复用同一 compact 结果(零拷贝)
+
+vi.mock('../../../src/lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+
+const { canvasPersistOptions, compactCanvasPersistSlice } = await import(
+  '../../../src/store/canvasPersistConfig'
+)
+const { compactCanvasesForPersist } = await import('../../../src/store/canvasDocumentModel')
+import type { CanvasState } from '../../../src/store/canvasStore'
+
+const persistSyncSource = readFileSync(
+  fileURLToPath(new URL('../persist/persistSync.ts', import.meta.url)),
+  'utf8',
+)
+
+const node = {
+  id: 'n1',
+  type: 'image',
+  status: 'ready',
+  x: 1,
+  y: 2,
+  width: 100,
+  height: 80,
+  assetUrl: 'mivo-asset:xyz',
+  transform: { x: 1, y: 2, width: 100, height: 80, rotation: 0 },
+  asset: { kind: 'image', url: 'mivo-asset:xyz' },
+  fills: [{ id: 'f', type: 'image', url: 'mivo-asset:xyz' }],
+  relations: {},
+}
+
+const stateFixture = {
+  canvases: {
+    c1: { title: 'A', nodes: [node], edges: [], tasks: [], selectedNodeId: undefined, selectedNodeIds: [] },
+  },
+  projects: [],
+  sceneId: 'c1',
+  selectedNodeId: undefined,
+  selectedNodeIds: [],
+  activeTool: 'select',
+  lastMarkupShapeTool: 'rect',
+  brushStyle: { color: '#000', width: 8, kind: 'marker' },
+  drawStyle: { color: '#000' },
+  activeStampKind: 'star',
+  appliedAgentIntents: [],
+} as unknown as CanvasState
+
+/** #505 前的 partialize(compact 内嵌)原样重建,作字节参照。 */
+const legacyPartialize = (state: CanvasState) => ({
+  canvases: compactCanvasesForPersist(state.canvases),
+  projects: state.projects,
+  sceneId: state.sceneId,
+  selectedNodeId: state.selectedNodeId,
+  selectedNodeIds: state.selectedNodeIds,
+  activeTool: state.activeTool,
+  lastMarkupShapeTool: state.lastMarkupShapeTool,
+  brushStyle: state.brushStyle,
+  drawStyle: state.drawStyle,
+  activeStampKind: state.activeStampKind,
+  appliedAgentIntents: state.appliedAgentIntents,
+})
+
+describe('persistSync × compactCanvasPersistSlice(#505 P1-6)', () => {
+  it('源码契约:persistSync 的 envelope 必须经 compactCanvasPersistSlice(partialize(...)) 构建', () => {
+    expect(persistSyncSource).toMatch(/compactCanvasPersistSlice\(canvasPersistOptions\.partialize\(/)
+  })
+
+  it('字节契约:与 #505 前 partialize 内嵌 compact 的 envelope 逐字节一致(裁剪字段不进档案)', () => {
+    const current = JSON.stringify(compactCanvasPersistSlice(canvasPersistOptions.partialize(stateFixture)))
+    const legacy = JSON.stringify(legacyPartialize(stateFixture))
+    expect(current).toBe(legacy)
+    for (const dropped of ['"asset"', '"fills"', '"relations"', '"strokes"']) {
+      expect(current).not.toContain(dropped)
+    }
+  })
+
+  it('缓存契约:未变画布跨两次 envelope 构建复用同一 compact 结果(零拷贝)', () => {
+    const first = compactCanvasPersistSlice(canvasPersistOptions.partialize(stateFixture))
+    const second = compactCanvasPersistSlice(canvasPersistOptions.partialize(stateFixture))
+    expect(second.canvases.c1).toBe(first.canvases.c1)
+  })
+})
