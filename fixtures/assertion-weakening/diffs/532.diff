+            { x: 10, y: 10 },
+          ],
+          generation: { prompt: 'p', model: 'm', maskBounds: { x: 1, y: 2, width: 3, height: 4 } },
+        } as Partial<MivoCanvasNode>),
+      ),
+    ],
+  ]
+
+  for (const [label, node] of cases) {
+    it(`${label}:JSON 输出与旧 clone-then-delete 实现逐字节一致`, () => {
+      expect(JSON.stringify(compactNodeForPersist(node))).toBe(
+        JSON.stringify(legacyCompactNodeForPersist(node)),
+      )
+    })
+  }
