+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+// #505(F8):auth.hydrate 三分支的**真实接线**回归——不手调 scheduler
+// primitives 模拟 auth 侧,直接跑 authSlice.hydrate():
+//   ① same UID:重复 hydrate 世界不动(写照常收)
+//   ② A→B:有界 flush 屏障(存量落 A 的冻结键)→ setUid → reload 意图;
+//     屏障后的写冻结 B 键(与 main 的写时解析同语义,reload 在途)
+//   ③ anonymous→uid:有界 flush(匿名存量冲净 raw)→ setUid,页内继续,无间隙
+// 外加 F7:uid 在边界 trim + 非空校验(空/空白 fail-closed;含空白的同 uid
+// 归一化后走 no-op 分支)。
+
+const { logSpy, warnSpy, errorSpy, clearSpy, fetchMeMock } = vi.hoisted(() => ({
+  logSpy: vi.fn(),
+  warnSpy: vi.fn(),
+  errorSpy: vi.fn(),
+  clearSpy: vi.fn(async () => undefined),
+  fetchMeMock: vi.fn(),
+}))
+
+vi.mock('./debugLogStore', () => ({
+  debugLogger: { log: logSpy, warn: warnSpy, error: errorSpy },
+  useDebugLogStore: { getState: () => ({ entries: [], addEntry: vi.fn(), clear: vi.fn() }) },
+  installConsoleCapture: () => {},
+}))
+vi.mock('../lib/authClient', () => ({
+  fetchMe: fetchMeMock,
+  AuthError: class AuthError extends Error {},
+}))
+vi.mock('../lib/persistIdbStorage', async (importOriginal) => {
+  const original = await importOriginal<Record<string, unknown>>()
+  return { ...original, clearCurrentUserCache: clearSpy }
+})
+vi.mock('../lib/assetStorage', () => ({
+  migrateUntaggedAssets: vi.fn(async () => undefined),
+  clearAssetsForUser: vi.fn(async () => undefined),
+}))
+vi.mock('../lib/persistBoot', () => ({
+  resumePersistQueue: vi.fn(),
+  bootPersistWiring: vi.fn(),
+}))
+const toastFeedback = { error: vi.fn(), success: vi.fn(), info: vi.fn() }
+vi.mock('./toastStore', () => ({ toastFeedback }))
+vi.mock('../i18n', () => ({ t: (key: string) => key }))
+
+const { setPersistUserId, __resetPersistUserId, getPersistUserId, namespacedKey } = await import('../lib/persistUserId')
+const { useAuthStore } = await import('./authSlice')
+const { createDebouncedCompactPersistStorage, __clearDebouncedPersistInstancesForTests } = await import(
+  './canvasPersistWriteScheduler'
+)
+
+type Slice = Record<string, unknown>
+
+const reloadSpy = vi.fn()
+Object.defineProperty(window, 'location', {
+  configurable: true,
+  value: { href: 'https://app.local/x', origin: 'https://app.local', reload: reloadSpy },
+})
+
+const me = (id: string) => ({ authenticated: true, user: { id, name: id } })
+
+const NAME = 'mivo-canvas-demo'
+
+const makeBackend = () => {
+  const backend = {
+    /** [冻结物理键, 值] 记账。 */
+    writes: [] as Array<[string, string]>,
+    /** 注入:替换下一次写的实现(卡死注入)。 */
+    writeImpl: [] as Array<(key: string, value: string) => Promise<void>>,
+    /** 底层读计数:超时→reload 语义断言「页内未发生认领读」。 */
+    readCurrentCalls: 0,
+    resolveTarget: (name: string) => {
+      const key = namespacedKey(name)
+      return {
+        key,
+        write: async (value: string) => {
+          const impl = backend.writeImpl.shift()
+          if (impl) return impl(key, value)
+          backend.writes.push([key, value])
+        },
+        remove: async () => undefined,
+        removeStrict: async () => undefined,
+      }
+    },
+    readCurrent: async () => {
+      backend.readCurrentCalls += 1
+      return null
+    },
+  }
+  return backend
+}
+
+const makeStorage = (backend: ReturnType<typeof makeBackend>, extra?: { barrierTimeoutMs?: number }) =>
+  createDebouncedCompactPersistStorage<Slice>({
+    resolveTarget: backend.resolveTarget,
+    readCurrent: backend.readCurrent,
+    compactAtFlush: (s) => s,
+    ...extra,
+  })
+
+describe('authSlice.hydrate 三分支 × persist 冻结目标(F8 真实接线)+ F7 uid 校验', () => {
+  beforeEach(() => {
+    __clearDebouncedPersistInstancesForTests()
+    __resetPersistUserId()
+    reloadSpy.mockClear()
+    errorSpy.mockClear()
+    toastFeedback.error.mockClear()
+    fetchMeMock.mockReset()
+    useAuthStore.setState({ user: null, status: 'unknown' })
+  })
+
+  it('③ anonymous→uid:屏障把匿名存量冲进 raw 键 → setUid;随后的写冻结 u 键照常收单(无间隙)', async () => {
+    const backend = makeBackend()
+    const storage = makeStorage(backend)
+    storage.setItem(NAME, { state: { edited: 'anon' }, version: 12 })
+    fetchMeMock.mockResolvedValueOnce(me('user-u'))
+
+    expect(await useAuthStore.getState().hydrate()).toBe('ok')
+    expect(getPersistUserId()).toBe('user-u')
+    expect(backend.writes).toHaveLength(1)
+    expect(backend.writes[0][0]).toBe(NAME) // 匿名存量已被屏障冲出(raw 命名空间)
+
+    storage.setItem(NAME, { state: { edited: 'u-world' }, version: 12 }) // rehydrate 写回/后续编辑
+    expect(storage.hasPendingWrite()).toBe(true) // 冻结 u 键,立即收单——没有世界间隙
+    await storage.flushAndSettle('drain')
+    expect(backend.writes[1][0]).toBe(`${NAME}:user-u`)
+    expect(reloadSpy).not.toHaveBeenCalled()
+  })
+
+  it('③b anonymous→uid 屏障超时:fail-closed 不切号——outcome=persist-busy、toast+error 恰一次、零认领读、无 reload', async () => {
+    // 八审裁定:超时 = 匿名盘面不静止(卡死写可能随时解卡落 raw)。不切号则解卡
+    // 写落 raw = 匿名世界自己的合法终态,无倒挂面;登录本次失败,服务端 session
+    // 仍在,下次启动 fetchMe 仍返回 U,同一屏障在静止盘面上自然重试完成切换。
+    const backend = makeBackend()
+    const storage = makeStorage(backend, { barrierTimeoutMs: 30 }) // 短屏障(生产 5s)
+    backend.writeImpl.push(() => new Promise<void>(() => {})) // v1 写卡死跨 deadline
+    storage.setItem(NAME, { state: { edited: 'anon-v1' }, version: 12 })
+    void storage.flushAndSettle('t1') // v1 已启动并卡死
+    await new Promise((resolve) => setTimeout(resolve, 5))
+    storage.setItem(NAME, { state: { edited: 'anon-v2' }, version: 12 }) // 等待期还有暂存
+    fetchMeMock.mockResolvedValueOnce(me('user-u'))
+
+    const outcome = await useAuthStore.getState().hydrate()
+    expect(outcome).toBe('persist-busy') // outcome 上抛给 useStoreHydration 编排层
+    expect(getPersistUserId()).toBe('anonymous') // fail-closed:不切号
+    expect(useAuthStore.getState().status).toBe('unauthenticated') // 不置 authenticated
+    expect(reloadSpy).not.toHaveBeenCalled() // reload 方案已撤销(close-pending 不 abort 事务)
+    expect(errorSpy).toHaveBeenCalledWith('Auth', expect.stringContaining('首登屏障超时'))
+    expect(toastFeedback.error).toHaveBeenCalledTimes(1) // 用户被告知恰一次
+    expect(toastFeedback.error).toHaveBeenCalledWith('toast.auth.persistBusyLogin')
+    expect(backend.readCurrentCalls).toBe(0) // 页内未发生任何认领/底层读
+  })
+
+  it('① same UID:重复 hydrate 世界不动(写照常收,无 reload)', async () => {
+    const backend = makeBackend()
+    setPersistUserId('user-u')
+    const storage = makeStorage(backend)
+    fetchMeMock.mockResolvedValue(me('user-u'))
+    await useAuthStore.getState().hydrate()
+    await useAuthStore.getState().hydrate() // mid-session /me 刷新
+
+    storage.setItem(NAME, { state: { edited: 'still-alive' }, version: 12 })
+    expect(storage.hasPendingWrite()).toBe(true) // 世界从未被动过
+    expect(reloadSpy).not.toHaveBeenCalled()
+  })
+
+  it('② A→B:屏障把 A 存量冲进 A 的冻结键 → setUid(B)→ reload;屏障后的写冻结 B 键(main 同语义)', async () => {
+    const backend = makeBackend()
+    setPersistUserId('user-a')
+    const storage = makeStorage(backend)
+    storage.setItem(NAME, { state: { edited: 'a-edit' }, version: 12 })
+    fetchMeMock.mockResolvedValueOnce(me('user-b'))
+
+    expect(await useAuthStore.getState().hydrate()).toBe('reload-issued')
+    expect(reloadSpy).toHaveBeenCalledTimes(1)
+    expect(backend.writes).toHaveLength(1)
+    expect(backend.writes[0][0]).toBe(`${NAME}:user-a`) // A 存量 flush 进 A 命名空间
+    expect(getPersistUserId()).toBe('user-b')
+
+    // reload 在途窗口的写:入队冻结 B 键(与 main 的写时 namespacedKey 解析同语义;
+    // 冻结目标保证的是「切换前入队的写永落 A 键」,上面 writes[0] 即该保证)。
+    storage.setItem(NAME, { state: { edited: 'during-reload' }, version: 12 })
+    await storage.flushAndSettle('drain')
+    expect(backend.writes[1][0]).toBe(`${NAME}:user-b`)
+  })
+
+  it('F7:/me 返回空 uid → fail-closed 按未登录处理,不动命名空间、不 reload、error 留痕', async () => {
+    fetchMeMock.mockResolvedValueOnce(me(''))
+    await useAuthStore.getState().hydrate()
+    expect(useAuthStore.getState().status).toBe('unauthenticated')
+    expect(getPersistUserId()).toBe('anonymous')
+    expect(reloadSpy).not.toHaveBeenCalled()
