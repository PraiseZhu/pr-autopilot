+// 真挂 useStoreHydration(react-dom/client + React 19 act,harness 沿用
+// useRegionEditFreezeGuard 先例);依赖 store/迁移全 mock(编排控制流是本测试的唯一
+// 对象;kernel 生效值与 authSlice 行为各有专测),kernelMode mock 成 effective=new 让
+// migrate 断言有意义。共享 kv store 真实阻塞下的有界放行见
+// useStoreHydration.persistBusy.integration.test。
+import { act, useEffect } from 'react'
