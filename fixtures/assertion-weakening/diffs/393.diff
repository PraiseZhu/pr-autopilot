+// #313 周期 asset reaper:MIVO_ENABLE_ASSET_SERVICE=1 时启用。runScheduledReap 只清
+// 「attach 过又归零 + 7 天 grace 到期」的确定孤儿;从未 attach 的资产(含 demo/local-only
+// 画布结构性 unattached 引用,服务端无法区分)一律豁免(exempted 计数留痕)——硬约束见
+// issue #313 2026-07-30 评论。间隔 MIVO_ASSET_REAPER_INTERVAL_MS(默认 6h,设 0 关闭)。
+// 非重入:上一轮未结束跳过本轮(fail-visible warn),防 listRecords 慢时定时器堆叠。
+const startAssetReaper = (): void => {
+  if (!sharedAssetStore) return
+  const raw = process.env.MIVO_ASSET_REAPER_INTERVAL_MS
+  const intervalMs = raw === undefined ? 6 * 60 * 60 * 1000 : Number(raw)
+  if (!Number.isFinite(intervalMs) || intervalMs <= 0) {
+    console.log(`[mivo-bff] asset reaper disabled (MIVO_ASSET_REAPER_INTERVAL_MS=${raw})`)
+    return
+  }
+  const store = sharedAssetStore
+  let running = false
+  const reap = async (label: string): Promise<void> => {
+    if (running) {
+      console.warn(`[mivo-bff] asset reaper(${label}) skipped: previous run still in progress`)
+      return
+    }
+    running = true
+    try {
+      const r = await store.runScheduledReap()
+      if (r.purged > 0 || r.exempted > 0) {
+        console.log(`[mivo-bff] asset reaper(${label}): purged=${r.purged} exempted-never-attached=${r.exempted} scanned=${r.scanned}`)
+      }
+    } catch (err) {
+      console.warn(`[mivo-bff] asset reaper(${label}) failed: ${err instanceof Error ? err.message : String(err)}`)
+    } finally {
+      running = false
+    }
+  }
+  void reap('startup')
+  setInterval(() => void reap('interval'), intervalMs)
+  console.log(`[mivo-bff] asset reaper enabled: interval=${intervalMs}ms (never-attached assets exempt — #313)`)
+}
