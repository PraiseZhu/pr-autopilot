+ * Run a readwrite transaction that may issue MULTIPLE requests on the store
+ * (unlike runTransaction, which is single-request). The callback receives the
+ * object store and may `await requestToPromise(req)` between operations; the
+ * transaction stays alive across microtask continuations (a new request queued
+ * before the macrotask boundary keeps it from auto-committing) and resolves on
+ * `tx.oncomplete`. Used by FX-6 migrateToNamespaced's atomic claim
+ * (get→get→put→delete in ONE tx): IDB serializes readwrite transactions on a
+ * store, so two concurrent claims can't both copy the same legacy raw — the
+ * second tx sees the raw already deleted (or the namespaced key already present).
+ */
+const runReadWriteTx = async <T>(run: (store: IDBObjectStore) => Promise<T>): Promise<T> =>
+  openDb().then(
+    (db) =>
+      new Promise<T>((resolve, reject) => {
+        const tx = db.transaction(STORE_NAME, 'readwrite')
+        const store = tx.objectStore(STORE_NAME)
+        let outcome: { ok: true; value: T } | { ok: false; error: unknown } | undefined
+        run(store).then(
+          (value) => {
+            outcome = { ok: true, value }
+          },
+          (error) => {
+            outcome = { ok: false, error }
+            try {
+              tx.abort()
+            } catch {
+              // tx may already be aborting/inactive
+            }
+          },
+        )
+        tx.oncomplete = () => {
+          if (outcome?.ok) resolve(outcome.value)
+          else if (outcome?.ok === false) reject(outcome.error)
+          else reject(new Error('IDB transaction completed with no callback result'))
+        }
+        tx.onerror = () => {
+          if (outcome?.ok === false) reject(outcome.error)
+          else reject(tx.error ?? new Error('IDB transaction error'))
+        }
+        tx.onabort = () => {
+          if (outcome?.ok === false) reject(outcome.error)
+          else reject(tx.error ?? new Error('IDB transaction aborted'))
+        }
+      }),
+  )
