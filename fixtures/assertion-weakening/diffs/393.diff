+/** Promise-wrap a single IDBRequest (onsuccess/onerror). */
+const requestToPromise = <T>(req: IDBRequest<T>): Promise<T> =>
+  new Promise<T>((resolve, reject) => {
+    req.onsuccess = () => resolve(req.result)
+    req.onerror = () => reject(req.error)
+  })
+
