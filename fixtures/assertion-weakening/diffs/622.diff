diff --git a/server/routes/debug-logs.route.test.ts b/server/routes/debug-logs.route.test.ts
index 222ae89b..64149c1f 100644
--- a/server/routes/debug-logs.route.test.ts
+++ b/server/routes/debug-logs.route.test.ts
@@ -1025,3 +1025,60 @@ describe('debug-logs route — D9: ingest token(POST-only)+ Origin 路径回归
     expect(res.status).toBe(200)
   })
 })
+
+// ── 空串 Origin 行为锁(issue #545 唯一担心的语义分歧场景)────────────────────────
+// hasOrigin(唯一 falsy 语义源)把 undefined 与空串统一判为『无 Origin』。本块锁死跨函数
+// 不变式:isOriginAllowed 与 hasDebugIngestGrant 对空串的判定必须同为『无 Origin』——
+// 即『空串 Origin』与『缺失 Origin』行为逐字节等价。三条分别锁 POST 判定式里两条并列
+// 判据对空串的判定一致:(a) 走 token 支路(与 D9 无 Origin + 正确 token 等价);
+// (b)(c) 走 Origin 支路(生产 fail-closed / 非生产 dev compat,与无 Origin 各分支等价)。
+describe('debug-logs route — 空串 Origin 行为锁(空串与缺失 Origin 等价)', () => {
+  // 与既有 INGEST 同样拼接构造,避免被字面量扫描误判成真凭证。
+  const EMPTY_ORIGIN_INGEST = ['empty-origin', 'ingest', 'fixture'].join('-')
+  const EMPTY_ORIGIN_ENV = ['NODE_ENV', 'MIVO_PUBLIC', 'MIVO_PUBLIC_ORIGIN', 'MIVO_DEBUG_INGEST_TOKEN', 'MIVO_DEBUG_ALLOWED_ORIGINS', 'MIVO_DEBUG_POST_RATE_LIMIT', 'MIVO_DEBUG_VIEW_TOKEN']
+  const saved: Record<string, string | undefined> = {}
+  beforeEach(() => {
+    for (const n of EMPTY_ORIGIN_ENV) saved[n] = process.env[n]
+    for (const n of EMPTY_ORIGIN_ENV) delete process.env[n]
+    __resetDebugLogsRateLimit()
+  })
+  afterEach(() => {
+    for (const n of EMPTY_ORIGIN_ENV) {
+      if (saved[n] === undefined) delete process.env[n]
+      else process.env[n] = saved[n]
+    }
+    __resetDebugLogsRateLimit()
+  })
+
+  // 与 D9 relayPost 同构,仅多 origin:'' 头(空串 header 能传进 handler:底层走真实
+  // Headers,c.req.header('origin') 拿到 '' 而非 undefined)。
+  const emptyOriginPost = (token?: string) =>
+    request(
+      'POST',
+      jsonBody({ clientId: 'c1', sessionId: 's1', entries: [{ level: 'error', source: 'Plugin', message: 'm', timestamp: 1 }] }),
+      token === undefined
+        ? { 'content-type': 'application/json', origin: '' }
+        : { 'content-type': 'application/json', origin: '', 'x-mivo-debug-ingest-token': token },
+    )
+
+  it('生产 + 空串 Origin + 正确 ingest token → 200(空串走 token 入口,与无 Origin 同)', async () => {
+    process.env.NODE_ENV = 'production'
+    process.env.MIVO_DEBUG_INGEST_TOKEN = EMPTY_ORIGIN_INGEST
+    const res = await emptyOriginPost(EMPTY_ORIGIN_INGEST)
+    expect(res.status).toBe(200)
+    expect((await json(res)).accepted).toBe(1)
+  })
+
+  it('生产 + 空串 Origin + 无 token → 403(空串不因非 undefined 被当作有 Origin 而走 allowlist 分支)', async () => {
+    process.env.NODE_ENV = 'production'
+    const res = await emptyOriginPost()
+    expect(res.status).toBe(403)
+    expect((await json(res)).error).toBe('Origin not allowed')
+  })
+
+  it('非生产 + 空串 Origin + 无 token → 200(dev compat 分支同样把空串当无 Origin)', async () => {
+    const res = await emptyOriginPost()
+    expect(res.status).toBe(200)
+    expect((await json(res)).accepted).toBe(1)
+  })
+})
