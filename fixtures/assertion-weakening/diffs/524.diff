+import { describe, expect, it } from 'vitest'
+import { fallbackReasonFor, isTransientVirtualizationFallback, orderedMaterializedNodes } from './useCanvasVirtualization'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+// #504 默认 on 后的冷启动 warn 噪音治理:shell 首测前的 shell-size-missing 是
+// 每个会话开机的正常瞬态,不告警;首测完成后的任何 fallback 才是真降级。
+
+describe('fallbackReasonFor — 虚拟化降级原因', () => {
+  it('culling=off → culling=off(逃生口显式关裁剪,虚拟化必须降级)', () => {
+    expect(fallbackReasonFor({ cullingMode: 'off', shellSize: { width: 800, height: 600 } })).toBe('culling=off')
+  })
+
+  it('shell 尺寸缺失 → shell-size-missing', () => {
+    expect(fallbackReasonFor({ cullingMode: 'on', shellSize: { width: 0, height: 0 } })).toBe('shell-size-missing')
+    expect(fallbackReasonFor({ cullingMode: 'on', shellSize: { width: 800, height: 0 } })).toBe('shell-size-missing')
+  })
+
+  it('culling on 且 shell 已测量 → 无降级', () => {
+    expect(fallbackReasonFor({ cullingMode: 'on', shellSize: { width: 800, height: 600 } })).toBeUndefined()
+  })
+
+  it('culling=off 优先于 shell-size-missing(告警语义更准确)', () => {
+    expect(fallbackReasonFor({ cullingMode: 'off', shellSize: { width: 0, height: 0 } })).toBe('culling=off')
+  })
+})
+
+describe('isTransientVirtualizationFallback — 启动瞬态与真降级的分界', () => {
+  it('shell 首测前的 shell-size-missing 是瞬态(不 warn)', () => {
+    expect(isTransientVirtualizationFallback('shell-size-missing', false)).toBe(true)
+  })
+
+  it('shell 首测完成后再出现 shell-size-missing 是真降级(要 warn)', () => {
+    expect(isTransientVirtualizationFallback('shell-size-missing', true)).toBe(false)
+  })
+
+  it('culling=off 任何时候都是真降级(要 warn)', () => {
+    expect(isTransientVirtualizationFallback('culling=off', false)).toBe(false)
+    expect(isTransientVirtualizationFallback('culling=off', true)).toBe(false)
+  })
+
+  it('无降级原因时不参与判定', () => {
+    expect(isTransientVirtualizationFallback(undefined, false)).toBe(false)
+  })
+})
+
+describe('orderedMaterializedNodes — z 序契约(#504 z 序修复回归)', () => {
+  const node = (id: string) => ({ id, type: 'image', x: 0, y: 0, width: 10, height: 10 }) as unknown as MivoCanvasNode
+  const docOrder = [node('a'), node('b'), node('c'), node('d')]
+
+  it('materializedIds 为 append 序(≠文档序)时,输出仍严格文档序', () => {
+    // 分批材料化的真实场景:d 先入场(视口内),a/c 随后补齐——append 序 [d,c,a]
+    expect(orderedMaterializedNodes(docOrder, ['d', 'c', 'a']).map((n) => n.id)).toEqual(['a', 'c', 'd'])
+  })
+
+  it('集合语义:只输出已材料化的节点,未材料化的不补位', () => {
+    expect(orderedMaterializedNodes(docOrder, ['b']).map((n) => n.id)).toEqual(['b'])
+    expect(orderedMaterializedNodes(docOrder, []).map((n) => n.id)).toEqual([])
+  })
+
+  it('stale id(已不在 visibleNodes)被自然丢弃', () => {
+    expect(orderedMaterializedNodes(docOrder, ['gone', 'b', 'a']).map((n) => n.id)).toEqual(['a', 'b'])
+  })
+
+  it('全量材料化时输出与文档序完全一致(与非虚拟化路径同构)', () => {
+    expect(orderedMaterializedNodes(docOrder, ['c', 'd', 'a', 'b']).map((n) => n.id)).toEqual(['a', 'b', 'c', 'd'])
+  })
+})
