@@ -0,0 +1,167 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+// #504 防双画状态机的 focused 回归(sol-review 二轮):钉住 syncInlineTextObjects
+// 的三条契约,防止未来误删 editingNodeId 依赖/签名后缀/签名门外 opacity set 时
+// 套件仍全绿(会重新双画,或退出编辑后 text 永久隐身):
+// 1. 进入编辑 → Leafer 本体 opacity 1→0,对象保留(children 守恒);
+// 2. 编辑中 LOD kind 翻转(Text→Rect 重建)→ 新对象 opacity 仍 0;
+// 3. 退出编辑 → opacity 恢复 1。
+// mock leafer-ui 的 Fake 类模式参照 leaferImagePaint.test.ts。
+
+vi.mock('leafer-ui', () => {
+  class FakeDisplayObject {
+    props: Record<string, unknown>
+    removed = false
+    onRemove?: () => void
+    constructor(props: Record<string, unknown>) {
+      this.props = { ...props }
+    }
+    set(next: Record<string, unknown>) {
+      Object.assign(this.props, next)
+    }
+    remove() {
+      this.removed = true
+      this.onRemove?.()
+    }
+  }
+  class FakeImage extends FakeDisplayObject {}
+  class FakeRect extends FakeDisplayObject {}
+  class FakeText extends FakeDisplayObject {}
+  class FakeLeafer {
+    children: FakeDisplayObject[] = []
+    add(object: FakeDisplayObject) {
+      this.children.push(object)
+      object.onRemove = () => {
+        const index = this.children.indexOf(object)
+        if (index >= 0) this.children.splice(index, 1)
+      }
+    }
+  }
+  return { Image: FakeImage, Rect: FakeRect, Text: FakeText, Leafer: FakeLeafer, Box: FakeDisplayObject }
+})
+vi.mock('@leafer-in/view', () => ({}))
+// canvasStore 传递引入 demoScenes → demoImages 需要 document(node 测试环境没有)
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+
+const { Rect, Text } = await import('leafer-ui')
+const { syncInlineTextObjects } = await import('./useLeaferSpikeRenderer')
+
+type FakeObject = { props: Record<string, unknown> }
+type Harness = {
+  leafer: { children: FakeObject[]; add: (o: unknown) => void }
+  painted: Map<string, { object: unknown; node: MivoCanvasNode; kind: string }>
+  signatures: Map<string, string>
+}
+
+const textNode = (overrides: Partial<MivoCanvasNode> = {}): MivoCanvasNode =>
+  ({
+    id: 't1',
+    type: 'text',
+    status: 'ready',
+    x: 0,
+    y: 0,
+    width: 200,
+    height: 100,
+    text: 'hello',
+    ...overrides,
+  }) as unknown as MivoCanvasNode
+
+const makeHarness = (): Harness => {
+  return {
+    leafer: new (class {
+      children: FakeObject[] = []
+      add(object: unknown) {
+        this.children.push(object as FakeObject)
+        ;(object as { onRemove?: () => void }).onRemove = () => {
+          const index = this.children.indexOf(object as FakeObject)
+          if (index >= 0) this.children.splice(index, 1)
+        }
+      }
+    })(),
+    painted: new Map(),
+    signatures: new Map(),
+  }
+}
+
+// 投影 200px ≥ 32px 阈值 → 高保真 Text;scale 0.1 时投影 20px < 32px → LOD Rect
+const HD_VIEWPORT = { x: 0, y: 0, scale: 1 }
+const LOD_VIEWPORT = { x: 0, y: 0, scale: 0.1 }
+
+const sync = (
+  harness: Harness,
+  { editingNodeId, viewport = HD_VIEWPORT }: { editingNodeId?: string; viewport?: { x: number; y: number; scale: number } } = {},
+) =>
+  syncInlineTextObjects({
+    leafer: harness.leafer as never,
+    painted: harness.painted as never,
+    signatures: harness.signatures as never,
+    nodes: [textNode()],
+    viewport,
+    editingNodeId,
+  })
+
+const paintedObject = (harness: Harness) => harness.painted.get('t1')!.object as FakeObject
+
+describe('syncInlineTextObjects — #504 text 防双画状态机', () => {
+  it('create → 进入编辑(1→0)→ 退出编辑(0→1),对象全程保留,children 守恒', () => {
+    const harness = makeHarness()
+
+    sync(harness)
+    expect(paintedObject(harness)).toBeInstanceOf(Text)
+    expect(paintedObject(harness).props.opacity).toBe(1)
+    expect(harness.leafer.children).toHaveLength(1)
+
+    const objectBeforeEditing = paintedObject(harness)
+    sync(harness, { editingNodeId: 't1' })
+    expect(paintedObject(harness)).toBe(objectBeforeEditing) // 对象保留,不重建
+    expect(paintedObject(harness).props.opacity).toBe(0)
+    expect(harness.leafer.children).toHaveLength(1) // children === expectedChildren
+
+    sync(harness)
+    expect(paintedObject(harness).props.opacity).toBe(1)
+    expect(harness.leafer.children).toHaveLength(1)
+  })
+
+  it('编辑中 LOD kind 翻转(Text→Rect 重建)→ 新对象 opacity 仍 0,children 守恒', () => {
+    const harness = makeHarness()
+    sync(harness, { editingNodeId: 't1' })
+    expect(paintedObject(harness)).toBeInstanceOf(Text)
+    expect(paintedObject(harness).props.opacity).toBe(0)
+
+    sync(harness, { editingNodeId: 't1', viewport: LOD_VIEWPORT })
+    expect(paintedObject(harness)).toBeInstanceOf(Rect) // kind 重建
+    expect(paintedObject(harness).props.opacity).toBe(0) // 重建后仍隐形
+    expect(harness.leafer.children).toHaveLength(1)
+
+    // 编辑中放大回高保真 → 再次重建,仍隐形
+    sync(harness, { editingNodeId: 't1', viewport: HD_VIEWPORT })
+    expect(paintedObject(harness)).toBeInstanceOf(Text)
+    expect(paintedObject(harness).props.opacity).toBe(0)
+    expect(harness.leafer.children).toHaveLength(1)
+  })
+
+  it('编辑别的节点不影响本节点(editingNodeId 不命中 → opacity 1)', () => {
+    const harness = makeHarness()
+    sync(harness, { editingNodeId: 'other' })
+    expect(paintedObject(harness).props.opacity).toBe(1)
+  })
+
+  it('节点离场 → 对象移除,painted/signatures 清空', () => {
+    const harness = makeHarness()
+    sync(harness)
+    expect(harness.leafer.children).toHaveLength(1)
+    syncInlineTextObjects({
+      leafer: harness.leafer as never,
+      painted: harness.painted as never,
+      signatures: harness.signatures as never,
+      nodes: [],
+      viewport: HD_VIEWPORT,
+    })
+    expect(harness.leafer.children).toHaveLength(0)
+    expect(harness.painted.size).toBe(0)
+    expect(harness.signatures.size).toBe(0)
+  })
+})
