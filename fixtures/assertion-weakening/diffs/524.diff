diff --git a/scripts/bench/evidence-gate.contract.test.ts b/scripts/bench/evidence-gate.contract.test.ts
new file mode 100644
index 00000000..1c9135d7
--- /dev/null
+++ b/scripts/bench/evidence-gate.contract.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from 'vitest'
+// @ts-expect-error — 纯 JS bench 工装模块,无类型声明
+import { assertModeEvidence } from './evidence-gate.mjs'
+
+// #504 证据门契约:四种请求状态的完整组合断言 + 'unknown' 一律拒收。
+// 重点回归(sol-review 二轮):dom+lod=on 不豁免——engineSpikeLod 的
+// emptyEngineLodStats 直读 URL 解析的 engineLodMode,dom 渲染器同样上报 on/true。
+
+const shell = (overrides: Record<string, unknown> = {}) => ({
+  virtualizeMode: 'on',
+  virtualizeActive: true,
+  engineLodMode: 'on',
+  engineLodEnabled: true,
+  ...overrides,
+})
+
+describe('assertModeEvidence — #504 bench 证据门', () => {
+  it('默认组(virtualize=on + lod=on)shell 全对 → 放行', () => {
+    expect(() => assertModeEvidence({ virtualize: 'on', lod: 'on', renderState: shell() })).not.toThrow()
+  })
+
+  it('逃生口组(off/off)shell 全对 → 放行', () => {
+    expect(() =>
+      assertModeEvidence({
+        virtualize: 'off',
+        lod: 'off',
+        renderState: shell({ virtualizeMode: 'off', virtualizeActive: false, engineLodMode: 'off', engineLodEnabled: false }),
+      }),
+    ).not.toThrow()
+  })
+
+  // sol-review 二轮核心回归:dom+lod=on 场景(renderer 不参与本函数,天然无豁免)
+  it('lod=on 但 shell 报 unknown(属性读不到)→ 拒收', () => {
+    expect(() =>
+      assertModeEvidence({ virtualize: 'on', lod: 'on', renderState: shell({ engineLodMode: 'unknown' }) }),
+    ).toThrow(/lod=on evidence invalid/)
+  })
+
+  it('lod=on 但 shell 报 off(逃生口被误触/翻转失效)→ 拒收', () => {
+    expect(() =>
+      assertModeEvidence({ virtualize: 'on', lod: 'on', renderState: shell({ engineLodMode: 'off', engineLodEnabled: false }) }),
+    ).toThrow(/lod=on evidence invalid/)
+  })
+
+  it('lod=on 但 enabled=false(mode/enabled 失配)→ 拒收', () => {
+    expect(() =>
+      assertModeEvidence({ virtualize: 'on', lod: 'on', renderState: shell({ engineLodEnabled: false }) }),
+    ).toThrow(/lod=on evidence invalid/)
+  })
+
+  it('lod=off 但 shell 报 on 或 enabled=true → 拒收', () => {
+    expect(() =>
+      assertModeEvidence({ virtualize: 'off', lod: 'off', renderState: shell({ virtualizeMode: 'off', virtualizeActive: false }) }),
+    ).toThrow(/lod=off evidence invalid/)
+    expect(() =>
+      assertModeEvidence({
+        virtualize: 'off',
+        lod: 'off',
+        renderState: shell({ virtualizeMode: 'off', virtualizeActive: false, engineLodMode: 'off', engineLodEnabled: true }),
+      }),
+    ).toThrow(/lod=off evidence invalid/)
+  })
+
+  it('lod=off 但 shell 报 unknown → 拒收', () => {
+    expect(() =>
+      assertModeEvidence({
+        virtualize: 'off',
+        lod: 'off',
+        renderState: shell({ virtualizeMode: 'off', virtualizeActive: false, engineLodMode: 'unknown', engineLodEnabled: false }),
+      }),
+    ).toThrow(/lod=off evidence invalid/)
+  })
+
+  it('virtualize=on 但 mode=unknown / active=false → 拒收', () => {
+    expect(() =>
+      assertModeEvidence({ virtualize: 'on', lod: 'on', renderState: shell({ virtualizeMode: 'unknown' }) }),
+    ).toThrow(/virtualize=on evidence invalid/)
+    expect(() =>
+      assertModeEvidence({ virtualize: 'on', lod: 'on', renderState: shell({ virtualizeActive: false }) }),
+    ).toThrow(/virtualize=on evidence invalid/)
+  })
+
+  it('virtualize=off 但 mode=on / active=true → 拒收', () => {
+    expect(() =>
+      assertModeEvidence({ virtualize: 'off', lod: 'on', renderState: shell() }),
+    ).toThrow(/virtualize=off evidence invalid/)
+    expect(() =>
+      assertModeEvidence({ virtualize: 'off', lod: 'on', renderState: shell({ virtualizeMode: 'off' }) }),
+    ).toThrow(/virtualize=off evidence invalid/)
+  })
+})
diff --git a/scripts/bench/evidence-gate.mjs b/scripts/bench/evidence-gate.mjs
new file mode 100644
index 00000000..dc6b4610
--- /dev/null
+++ b/scripts/bench/evidence-gate.mjs
@@ -0,0 +1,26 @@
+// #504 证据门(对称化):virtualize/lod 的 on/off 四种请求状态都回读 shell 断言
+// mode + active/enabled 完整组合——默认翻转后 off 是逃生口,静默失效会让"对照组"
+// 悄悄变成默认组;'unknown'(属性读不到)一律拒收,不许冒充任何一侧。
+//
+// lod=on 对**所有渲染器**断言(含 dom):engineSpikeLod.emptyEngineLodStats 直读
+// URL 解析的 engineLodMode,dom 渲染器同样把 mode=on / enabled=true 上报到 shell
+// (sol-review 二轮用真实浏览器探针实测 ?renderer=dom&lod=on 证实)。阈值/LOD 节点
+// 计数的细断言仍留在 collect.mjs 的 renderer!=='dom' 块——LOD 节点计数只有
+// leafer/pixi 的 paint stats 会累计,dom 恒 0,不适用计数断言。
+//
+// 从 collect.mjs 抽出为纯函数,由 evidence-gate.contract.test.ts 钉住拒收行为。
+
+export const assertModeEvidence = ({ virtualize, lod, renderState }) => {
+  if (virtualize === 'on' && (renderState.virtualizeMode !== 'on' || !renderState.virtualizeActive)) {
+    throw new Error(`Bench virtualize=on evidence invalid: shell reports mode=${renderState.virtualizeMode}, active=${renderState.virtualizeActive}`)
+  }
+  if (virtualize === 'off' && (renderState.virtualizeMode !== 'off' || renderState.virtualizeActive)) {
+    throw new Error(`Bench virtualize=off evidence invalid: shell reports mode=${renderState.virtualizeMode}, active=${renderState.virtualizeActive}`)
+  }
+  if (lod === 'on' && (renderState.engineLodMode !== 'on' || !renderState.engineLodEnabled)) {
+    throw new Error(`Bench lod=on evidence invalid: shell reports mode=${renderState.engineLodMode}, enabled=${renderState.engineLodEnabled}`)
+  }
+  if (lod === 'off' && (renderState.engineLodMode !== 'off' || renderState.engineLodEnabled)) {
+    throw new Error(`Bench lod=off evidence invalid: shell reports mode=${renderState.engineLodMode}, enabled=${renderState.engineLodEnabled}`)
+  }
+}
