+// @vitest-environment happy-dom
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import type { CullingMode } from '../render/cullingMode'
+
+// #504 冷启动 warn 时序回归:真实渲染 hook(非纯谓词),逐步更新 shellSize,
+// 断言 warn 只在"首测完成后再降级"时打——启动瞬态({0,0} 初值)零告警。
+
+const debugLogger = { log: vi.fn(), warn: vi.fn(), error: vi.fn() }
+vi.mock('../store/debugLogStore', () => ({ debugLogger }))
+// 钉死 virtualize=on(默认翻转后的生产态),不依赖 happy-dom 的 URL。
+vi.mock('../render/virtualizationMode', () => ({
+  virtualizationMode: 'on',
+  isDomVirtualizationRequested: true,
+}))
+
+const { useCanvasVirtualization } = await import('./useCanvasVirtualization')
+
+type ProbeProps = { cullingMode: CullingMode; shellSize: { width: number; height: number } }
+
+const Probe = ({ cullingMode, shellSize }: ProbeProps) => {
+  useCanvasVirtualization({
+    cullingMode,
+    visibleNodes: [],
+    shellSize,
+    viewport: { x: 0, y: 0, scale: 1 },
+    selectedNodeIds: [],
+  })
+  return null
+}
+
+declare global {
+  // React 19 act() 环境开关
+  var IS_REACT_ACT_ENVIRONMENT: boolean | undefined
+}
+
+describe('useCanvasVirtualization — 冷启动 warn 时序(renderHook 级)', () => {
+  let container: HTMLDivElement
+  let root: Root
+
+  const render = (props: ProbeProps) => act(() => root.render(<Probe {...props} />))
+
+  beforeEach(() => {
+    globalThis.IS_REACT_ACT_ENVIRONMENT = true
+    debugLogger.log.mockClear()
+    debugLogger.warn.mockClear()
+    debugLogger.error.mockClear()
+    container = document.createElement('div')
+    document.body.appendChild(container)
+    root = createRoot(container)
+  })
+
+  afterEach(() => {
+    act(() => root.unmount())
+    container.remove()
+  })
+
+  it('开机瞬态({0,0} 初值)不告警;首测完成后仍不告警', () => {
+    render({ cullingMode: 'on', shellSize: { width: 0, height: 0 } })
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+
+    render({ cullingMode: 'on', shellSize: { width: 800, height: 600 } })
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+  })
+
+  it('首测完成后 shell 尺寸再丢失 → 真降级,必须告警', () => {
+    render({ cullingMode: 'on', shellSize: { width: 0, height: 0 } })
+    render({ cullingMode: 'on', shellSize: { width: 800, height: 600 } })
+    expect(debugLogger.warn).not.toHaveBeenCalled()
+
+    render({ cullingMode: 'on', shellSize: { width: 0, height: 0 } })
+    expect(debugLogger.warn).toHaveBeenCalledWith(
+      'Renderer',
+      expect.stringContaining('shell-size-missing'),
+    )
+  })
+
+  it('culling=off 是显式逃生口降级:首测前也要告警', () => {
+    render({ cullingMode: 'off', shellSize: { width: 0, height: 0 } })
+    expect(debugLogger.warn).toHaveBeenCalledWith(
+      'Renderer',
+      expect.stringContaining('culling=off'),
+    )
+  })
+
+  it('同一降级原因只告警一次(fallbackLoggedRef 去重口径不变)', () => {
+    render({ cullingMode: 'off', shellSize: { width: 0, height: 0 } })
+    render({ cullingMode: 'off', shellSize: { width: 0, height: 0 } })
+    expect(debugLogger.warn).toHaveBeenCalledTimes(1)
+  })
+})
