+
+const loadWithSearch = async (search: string | null) => {
+  vi.resetModules()
+  // search === null 模拟非浏览器环境(与 rendererMode.test.ts 同款签名)
+  vi.stubGlobal(
+    'window',
+    (search === null ? undefined : { location: { search } }) as unknown as Window & typeof globalThis,
+  )
+  const debugLogger = { warn: vi.fn(), log: vi.fn() }
+  vi.doMock('../store/debugLogStore', () => ({ debugLogger }))
+  const mod = await import('./engineLodMode')
+  vi.unstubAllGlobals()
+  return { mod, debugLogger }
+}
+
+describe('engineLodMode(#504 默认翻转)', () => {
+  it('缺省 on:未带参数时 LOD 默认开启,阈值 32px,默认路径打 active 日志', async () => {
+    const { mod, debugLogger } = await loadWithSearch('')
+    expect(mod.engineLodMode).toBe('on')
+    expect(mod.isEngineLodRequested).toBe(true)
+    expect(mod.engineLodThresholdPx).toBe(32)
+    expect(debugLogger.log).toHaveBeenCalledWith('Renderer', expect.stringContaining('default on'))
+  })
+
+  it('?lod=off 逃生口可用,且逃生路径有日志', async () => {
+    const { mod, debugLogger } = await loadWithSearch('?lod=off')
+    expect(mod.engineLodMode).toBe('off')
+    expect(mod.isEngineLodRequested).toBe(false)
+    expect(debugLogger.log).toHaveBeenCalledWith('Renderer', expect.stringContaining('逃生口'))
+  })
+
+  it('显式 ?lod=on 与缺省等价', async () => {
+    const { mod } = await loadWithSearch('?lod=on')
+    expect(mod.engineLodMode).toBe('on')
+  })
+
+  it('非法值回退默认 on 并 warn', async () => {
+    const { mod, debugLogger } = await loadWithSearch('?lod=maybe')
+    expect(mod.engineLodMode).toBe('on')
+    expect(debugLogger.warn).toHaveBeenCalled()
+  })
+
+  it('?lodPx 仍可覆盖阈值', async () => {
+    const { mod } = await loadWithSearch('?lodPx=48')
+    expect(mod.engineLodThresholdPx).toBe(48)
+  })
+
+  it('非浏览器环境回退默认 on(与 rendererMode 同款,不打日志)', async () => {
+    const { mod, debugLogger } = await loadWithSearch(null)
+    expect(mod.engineLodMode).toBe('on')
+    expect(debugLogger.log).not.toHaveBeenCalled()
+  })
+
+  // 6 个合法 token 全表(+trim/大小写):钉死 ?lod=false / ?lod=0 与 off 同义走
+  // 逃生口,true/1 与 on 同义,解析先 trim 再 lowercase。
+  for (const token of ['on', 'true', '1', ' ON ', 'True']) {
