+// @vitest-environment happy-dom
+import { describe, expect, it, vi } from 'vitest'
+
+// #504 freeze-pan DOM 层回归(用户真机抓到):此前 applyViewportImperatively 在
+// engineLodEnabled + leafer/pixi 时跳过 .dom-canvas-layer transform 与 shell 背景
+// 位移(bench 时代的 engineOnlyPan 门)。lod 翻成默认 on 后,生产 DOM 托管的
+// video/pdf/markdown 等节点在拖拽中不动、松手后跳位。本测试钉住修正后的口径:
+// **任何渲染器/LOD 组合下,每帧都同步 domLayer transform 与背景位移**。
+// (旧口径正好断言"跳过"——这是 bug 口径的修正,不是行为漂移。)
+
+vi.mock('../store/debugLogStore', () => ({
+  debugLogger: { log: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}))
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+
+const { applyViewportImperatively } = await import('./useViewport')
+
+const makeShell = (dataset: Record<string, string>) => {
+  const shell = document.createElement('div')
+  shell.className = 'canvas-shell'
+  for (const [key, value] of Object.entries(dataset)) shell.dataset[key] = value
+  const domLayer = document.createElement('div')
+  domLayer.className = 'dom-canvas-layer'
+  shell.appendChild(domLayer)
+  document.body.appendChild(shell)
+  return { shell, domLayer }
+}
+
+const viewport = { x: -120, y: 45, scale: 1.5 }
+
+describe('applyViewportImperatively — freeze-pan 每帧 DOM 同步(#504 回归修正)', () => {
+  it('leafer + engineLodEnabled(生产默认组合):domLayer transform 与背景每帧跟手', () => {
+    const { shell, domLayer } = makeShell({ rendererMode: 'leafer', engineLodEnabled: 'true' })
+    applyViewportImperatively(shell, viewport)
+    expect(domLayer.style.transform).toBe('translate(-120px, 45px) scale(1.5)')
+    expect(shell.style.backgroundPosition).toBe('-120px 45px')
+    expect(shell.style.backgroundSize).toBe('54px 54px') // 36 * 1.5,网格背景随缩放
+    expect(shell.dataset.viewportX).toBe('-120')
+    expect(shell.dataset.viewportY).toBe('45')
+  })
+
+  it('dom 渲染器(逃生口)口径不变:同样每帧同步', () => {
+    const { shell, domLayer } = makeShell({ rendererMode: 'dom', engineLodEnabled: 'false' })
+    applyViewportImperatively(shell, viewport)
+    expect(domLayer.style.transform).toBe('translate(-120px, 45px) scale(1.5)')
+    expect(shell.style.backgroundPosition).toBe('-120px 45px')
+  })
+
+  it('pixi + LOD(工装轨)也不再跳过——engineOnlyPan 门已整体退役', () => {
+    const { shell, domLayer } = makeShell({ rendererMode: 'pixi', engineLodEnabled: 'true' })
+    applyViewportImperatively(shell, viewport)
+    expect(domLayer.style.transform).toBe('translate(-120px, 45px) scale(1.5)')
+    expect(shell.style.backgroundPosition).toBe('-120px 45px')
+  })
+
+  it('shell 为 null 时安全 no-op', () => {
+    expect(() => applyViewportImperatively(null, viewport)).not.toThrow()
+  })
+})
