@@ -0,0 +1,67 @@
+import { describe, expect, it, vi } from 'vitest'
+
+// virtualizationMode 在模块加载时解析一次 URL —— 用 resetModules + stubGlobal
+// 逐场景重载,与 textPaintMode/rendererMode 的既有测法同款。
+// #504(2026-08-05):默认值翻转为 on,?virtualize=off 保留为逃生口。
+
+const loadWithSearch = async (search: string | null) => {
+  vi.resetModules()
+  // search === null 模拟非浏览器环境(与 rendererMode.test.ts 同款签名)
+  vi.stubGlobal(
+    'window',
+    (search === null ? undefined : { location: { search } }) as unknown as Window & typeof globalThis,
+  )
+  const debugLogger = { warn: vi.fn(), log: vi.fn() }
+  vi.doMock('../store/debugLogStore', () => ({ debugLogger }))
+  const mod = await import('./virtualizationMode')
+  vi.unstubAllGlobals()
+  return { mod, debugLogger }
+}
+
+describe('virtualizationMode(#504 默认翻转)', () => {
+  it('缺省 on:未带参数时虚拟化默认开启,且默认路径打 active 日志', async () => {
+    const { mod, debugLogger } = await loadWithSearch('')
+    expect(mod.virtualizationMode).toBe('on')
+    expect(mod.isDomVirtualizationRequested).toBe(true)
+    expect(debugLogger.log).toHaveBeenCalledWith('Renderer', expect.stringContaining('default on'))
+  })
+
+  it('?virtualize=off 逃生口可用,且逃生路径有日志', async () => {
+    const { mod, debugLogger } = await loadWithSearch('?virtualize=off')
+    expect(mod.virtualizationMode).toBe('off')
+    expect(mod.isDomVirtualizationRequested).toBe(false)
+    expect(debugLogger.log).toHaveBeenCalledWith('Renderer', expect.stringContaining('逃生口'))
+  })
+
+  it('显式 ?virtualize=on 与缺省等价', async () => {
+    const { mod } = await loadWithSearch('?virtualize=on')
+    expect(mod.virtualizationMode).toBe('on')
+  })
+
+  it('非法值回退默认 on 并 warn', async () => {
+    const { mod, debugLogger } = await loadWithSearch('?virtualize=maybe')
+    expect(mod.virtualizationMode).toBe('on')
+    expect(debugLogger.warn).toHaveBeenCalled()
+  })
+
+  it('非浏览器环境回退默认 on(与 rendererMode 同款,不打日志)', async () => {
+    const { mod, debugLogger } = await loadWithSearch(null)
+    expect(mod.virtualizationMode).toBe('on')
+    expect(debugLogger.log).not.toHaveBeenCalled()
+  })
+
+  // 6 个合法 token 全表(+trim/大小写):钉死 ?virtualize=false / ?virtualize=0
+  // 与 off 同义走逃生口,true/1 与 on 同义,解析先 trim 再 lowercase。
+  for (const token of ['on', 'true', '1', ' ON ', 'True']) {
+    it(`token "${token}" → on`, async () => {
+      const { mod } = await loadWithSearch(`?virtualize=${encodeURIComponent(token)}`)
+      expect(mod.virtualizationMode).toBe('on')
+    })
+  }
+  for (const token of ['off', 'false', '0', ' OFF ', 'False']) {
+    it(`token "${token}" → off(逃生口)`, async () => {
+      const { mod } = await loadWithSearch(`?virtualize=${encodeURIComponent(token)}`)
+      expect(mod.virtualizationMode).toBe('off')
+    })
+  }
+})
