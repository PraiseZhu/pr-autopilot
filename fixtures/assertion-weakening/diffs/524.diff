+      expect(mod.engineLodMode).toBe('on')
+    })
+  }
+  for (const token of ['off', 'false', '0', ' OFF ', 'False']) {
+    it(`token "${token}" → off(逃生口)`, async () => {
+      const { mod } = await loadWithSearch(`?lod=${encodeURIComponent(token)}`)
+      expect(mod.engineLodMode).toBe('off')
+    })
+  }
+})
