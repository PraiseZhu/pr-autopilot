+    expect(summary.ok).toBe(false)
+    expect(summary.errors.some((e) => e.includes('缺格:mask::dom::legacy::dev'))).toBe(true)
+  })
+
+  it('RED: 混入错误 runId → ok=false,指出该记录', () => {
+    const runId = testRunId('wrong-runid')
+    writeManifestFile(runId)
+    writeLedgerLines(runId, [
+      JSON.stringify(record({ runId: 'some-other-run', name: 'debug::dom::legacy::dev', scenario: 'debug' })),
+      JSON.stringify(record({ runId, name: 'mask::dom::legacy::dev', scenario: 'mask' })),
+    ])
+    const summary = summarizeRun(runId)
+    expect(summary.ok).toBe(false)
+    expect(summary.errors.some((e) => e.includes('记录 runId 不符'))).toBe(true)
+  })
+
+  it('RED: 混入错误 headSha → ok=false,指出该记录', () => {
