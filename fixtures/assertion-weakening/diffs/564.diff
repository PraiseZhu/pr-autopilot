+    const summary = summarizeRun(runId)
+    expect(summary.ok).toBe(false)
+    expect(summary.errors.some((e) => e.includes('记录 name 与字段不符'))).toBe(true)
+  })
+
+  it('RED(#560 R1 codex-adversarial CAX-2):混入一条 manifest 从未声明的 foreign key → ok=false,恰好点名该 cellKey', () => {
+    const runId = testRunId('cax2-foreign-key')
+    writeManifestFile(runId)
+    writeLedgerLines(runId, [
+      JSON.stringify(record({ runId, name: 'debug::dom::legacy::dev', scenario: 'debug' })),
+      JSON.stringify(record({ runId, name: 'mask::dom::legacy::dev', scenario: 'mask' })),
+      // manifest.expectedCells 从未声明过这一格——旧版校验只检查"expectedKeys 是否都
+      // 出现过"(漏格方向),没检查反方向(多出未声明的格),这条会被放过。
+      JSON.stringify(record({ runId, name: 'totally-unexpected::dom::legacy::dev', scenario: 'totally-unexpected' })),
+    ])
