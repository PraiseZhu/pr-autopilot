+    expect(summary.errors.some((e) => e.includes('ledger 第 2 行 JSON 解析失败'))).toBe(true)
+    // 缺格仍应命中:坏行没能解析出 mask 记录
+    expect(summary.errors.some((e) => e.includes('缺格:mask::dom::legacy::dev'))).toBe(true)
+  })
+
+  it('RED: 人为造重复 cellKey → ok=false,恰好点名该 cellKey', () => {
+    const runId = testRunId('dup-cell')
