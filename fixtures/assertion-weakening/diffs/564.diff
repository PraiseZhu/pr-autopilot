+    expect(summary.ok).toBe(false)
+    expect(summary.errors.some((e) => e.includes('未声明的格:totally-unexpected::dom::legacy::dev'))).toBe(true)
+  })
+
+  it('RED(#560 R1 codex-adversarial CAX-1):记录带 evidenceMissing=true → ok=false,明确指出证据缺失而不是静默信任这条 PASS', () => {
+    const runId = testRunId('cax1-evidence-missing')
+    writeManifestFile(runId)
+    writeLedgerLines(runId, [
+      JSON.stringify(record({ runId, name: 'debug::dom::legacy::dev', scenario: 'debug', status: 'PASS', evidenceMissing: true })),
+      JSON.stringify(record({ runId, name: 'mask::dom::legacy::dev', scenario: 'mask' })),
+    ])
+    const summary = summarizeRun(runId)
+    expect(summary.ok).toBe(false)
+    expect(summary.errors.some((e) => e.includes('记录证据缺失'))).toBe(true)
+  })
+
+  it('控制组:evidenceMissing=false 时不触发证据缺失校验', () => {
+    const runId = testRunId('cax1-control')
+    writeManifestFile(runId)
+    writeLedgerLines(runId, [
+      JSON.stringify(record({ runId, name: 'debug::dom::legacy::dev', scenario: 'debug', status: 'PASS', evidenceMissing: false })),
+      JSON.stringify(record({ runId, name: 'mask::dom::legacy::dev', scenario: 'mask' })),
+    ])
+    const summary = summarizeRun(runId)
+    expect(summary.ok).toBe(true)
+  })
+})
