+    writeManifestFile(runId)
+    writeLedgerLines(runId, [
+      JSON.stringify(record({ runId, name: 'debug::dom::legacy::dev', scenario: 'debug' })),
+      JSON.stringify(record({ runId, name: 'mask::dom::legacy::dev', scenario: 'mask' })),
+    ])
+    const summary = summarizeRun(runId)
+    expect(summary.ok).toBe(true)
+  })
+
+  it('RED(#560 R1 codex-adversarial CAX-2):name 落在 expectedKeys 里,但 scenario/renderer 字段被改写成别的值 → ok=false,指出 name 与字段不符', () => {
