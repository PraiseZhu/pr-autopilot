+// scripts/e2e/ledger-summary.mjs — 严格 ledger reader/validator(#560)。
+//
+// fail-closed:manifest 缺失/坏、ledger 缺失/坏行、记录的 runId/headSha/schemaVersion
+// 与 manifest 不符、缺格、重复格——任一命中都在 ok:false 里列出具体原因,不再像旧版
+// readJsonlSafe 那样把坏行静默 filter(Boolean) 丢弃、缺格/重复格完全没人检测。
+//
+// 这是本仓 ledger 数据的唯一权威读法——e2e-runner.mjs 的终端计数、CI job summary 都
+// 消费本模块的 summarizeRun() 输出,不各自维护一份平行计数(避免两处统计跑偏)。
+import { appendFileSync, existsSync, readFileSync } from 'node:fs'
+import { cellKey, ledgerPath, manifestPath, readLatestRunId } from './result-ledger.mjs'
+
+const FOUR_STATES = ['PASS', 'RETRY_PASS', 'FAIL', 'N_A']
+
+/**
+ * 读取并校验一次 run 的 manifest.json + ledger.jsonl。
+ * 返回 { ok, errors, counts, records, manifest, retryPassCells }。
+ * ok=false 时 counts 仍尽量给出(能算多少算多少),不因校验失败就完全不输出统计——
+ * 诊断价值优先于"要么全对要么什么都不给"。
+ */
+export const summarizeRun = (runId) => {
+  const errors = []
+
+  if (!runId) {
+    return { ok: false, errors: ['未提供 runId,且 test-artifacts/e2e-runs/LATEST 指针缺失或为空'], counts: null, records: [], manifest: null, retryPassCells: [] }
+  }
+
+  const manifestFile = manifestPath(runId)
+  if (!existsSync(manifestFile)) {
+    return { ok: false, errors: [`manifest 缺失:${manifestFile}(疑似 e2e-runner.mjs 从未启动,或在写 manifest 前就已崩溃——setup 阶段失败)`], counts: null, records: [], manifest: null, retryPassCells: [] }
+  }
+
+  let manifest
+  try {
+    manifest = JSON.parse(readFileSync(manifestFile, 'utf8'))
+  } catch (err) {
+    return { ok: false, errors: [`manifest JSON 解析失败:${manifestFile}(${err instanceof Error ? err.message : String(err)})`], counts: null, records: [], manifest: null, retryPassCells: [] }
+  }
+
+  const ledgerFile = ledgerPath(runId)
+  if (!existsSync(ledgerFile)) {
+    errors.push(`ledger 缺失:${ledgerFile}(manifest 存在但 ledger 从未写入——疑似所有 scenario 尚未跑完就中止)`)
+    return { ok: false, errors, counts: null, records: [], manifest, retryPassCells: [] }
+  }
+
+  const raw = readFileSync(ledgerFile, 'utf8')
+  // 保留原始行号(不先 filter(Boolean) 再算 index)——文件中若存在中间空行(如手工
+  // 编辑/写坏导致),先 filter 会让 index 与真实行号错位,报错行号失真。
+  const rawLines = raw.split('\n')
+  const records = []
+  rawLines.forEach((rawLine, index) => {
+    const line = rawLine.trim()
+    if (!line) return
+    try {
+      records.push(JSON.parse(line))
+    } catch (err) {
+      errors.push(`ledger 第 ${index + 1} 行 JSON 解析失败:${err instanceof Error ? err.message : String(err)}`)
+    }
+  })
+
+  const expectedKeys = new Set((manifest.expectedCells ?? []).map((cell) => cellKey(cell)))
+
+  for (const record of records) {
+    if (record.runId !== manifest.runId) {
+      errors.push(`记录 runId 不符(name=${record.name}):记录=${record.runId} manifest=${manifest.runId}`)
+    }
+    if (record.schemaVersion !== manifest.schemaVersion) {
+      errors.push(`记录 schemaVersion 不符(name=${record.name}):记录=${record.schemaVersion} manifest=${manifest.schemaVersion}`)
+    }
+    if (record.headSha !== manifest.headSha) {
+      errors.push(`记录 headSha 不符(name=${record.name}):记录=${record.headSha} manifest=${manifest.headSha}`)
+    }
+    // #560 codex-adversarial R1 CAX-2:name 字段本身在 expectedKeys 里,不代表这条记录
+    // 真的对应该格——name 是随记录一起写入的普通字符串字段,可能与 scenario/renderer/
+    // kernel/topology 四个字段各自的取值不一致(伪造/写坏都可能产生);必须用四字段重算
+    // 一遍 cellKey,严格要求与 record.name 逐字相等,不能只信 name 本身。
+    const recomputedKey = cellKey({ scenario: record.scenario, renderer: record.renderer, kernel: record.kernel, topology: record.topology })
+    if (recomputedKey !== record.name) {
+      errors.push(`记录 name 与字段不符(name=${record.name}):由 scenario/renderer/kernel/topology 字段重算得 ${recomputedKey}`)
+    }
+    // #560 codex-adversarial R1 CAX-2:旧版只检查"expectedKeys 里的格是否都出现过"(漏格),
+    // 没检查反方向——ledger 里混入一条 manifest 从未声明的 foreign key,旧版会放过。
+    if (!expectedKeys.has(record.name)) {
+      errors.push(`未声明的格:${record.name}(不在 manifest.expectedCells 中,疑似伪造/写坏的记录)`)
+    }
+    // #560 codex-adversarial R1 CAX-1:exit code 判定为 PASS/RETRY_PASS,但 resolveAttemptResult
+    // 标记了 evidenceMissing(exitCode===0 但对应 attempt 没有 fragment 佐证)——不能排除
+    // 这本该是 N_A(leafer-skip 等)却因 fragment 写失败被误判成 PASS 的可能,严格校验对此
+    // fail-closed(不静默信任"没证据的绿")。
+    if (record.evidenceMissing === true) {
+      errors.push(`记录证据缺失(name=${record.name}):status=${record.status} 但无 fragment 佐证(exit code 判定,不能排除实为 N_A)`)
+    }
+  }
+
+  const seenCells = new Map()
+  for (const record of records) {
+    const key = record.name
+    const count = (seenCells.get(key) ?? 0) + 1
+    seenCells.set(key, count)
+    if (count === 2) {
+      errors.push(`重复格:${key}(单次 run 内出现 ≥2 条终态记录)`)
+    }
+  }
+
+  for (const key of expectedKeys) {
+    if (!seenCells.has(key)) {
+      errors.push(`缺格:${key}(manifest.expectedCells 声明但 ledger 无对应终态记录)`)
+    }
+  }
+
+  const counts = { PASS: 0, RETRY_PASS: 0, FAIL: 0, N_A: 0 }
+  const retryPassCells = []
+  for (const record of records) {
+    if (FOUR_STATES.includes(record.status)) {
+      counts[record.status] += 1
+    } else {
+      errors.push(`未知 status:${record.status}(name=${record.name})`)
+    }
+    if (record.status === 'RETRY_PASS') retryPassCells.push(record.name)
+  }
+
+  return { ok: errors.length === 0, errors, counts, records, manifest, retryPassCells }
+}
+
+const formatSummaryText = (runId, summary) => {
+  const lines = [`[ledger-summary] run=${runId}`]
+  if (!summary.ok) {
+    lines.push(`[ledger-summary] fail-closed — ${summary.errors.length} 处台账问题:`)
+    for (const err of summary.errors) lines.push(`  - ${err}`)
+  }
+  if (summary.counts) {
+    const { counts, retryPassCells } = summary
+    lines.push(`[ledger-summary] PASS=${counts.PASS} RETRY_PASS=${counts.RETRY_PASS} FAIL=${counts.FAIL} N_A=${counts.N_A}`)
+    if (retryPassCells.length) {
+      lines.push(`[ledger-summary] RETRY_PASS cells: ${retryPassCells.join(', ')}`)
+    }
+  }
+  return lines.join('\n')
+}
+
+/** 打印到 stdout,若 GITHUB_STEP_SUMMARY 存在则同时追加写入该文件。返回 summarizeRun() 的结果。 */
+export const printSummary = (runId) => {
+  const summary = summarizeRun(runId)
+  const text = formatSummaryText(runId ?? '(unknown)', summary)
+  console.log(text)
+  const stepSummaryPath = process.env.GITHUB_STEP_SUMMARY
+  if (stepSummaryPath) {
+    try {
+      appendFileSync(stepSummaryPath, `${text}\n`)
+    } catch (err) {
+      console.warn(`[ledger-summary] 写 GITHUB_STEP_SUMMARY 失败: ${err instanceof Error ? err.message : String(err)}`)
+    }
+  }
+  return summary
+}
+
+const isMainModule = () => {
+  try {
+    return import.meta.url === `file://${process.argv[1]}`
+  } catch {
+    return false
+  }
+}
+
+if (isMainModule()) {
+  const argv = process.argv.slice(2)
+  const runIdIdx = argv.indexOf('--run-id')
+  const useLatest = argv.includes('--latest')
+  const runId = runIdIdx >= 0 ? argv[runIdIdx + 1] : useLatest ? readLatestRunId() : null
+
+  if (!runId) {
+    console.error('[ledger-summary] 用法: node scripts/e2e/ledger-summary.mjs --run-id <runId> | --latest')
+    if (useLatest) {
+      console.error('[ledger-summary] --latest 指定,但 test-artifacts/e2e-runs/LATEST 指针缺失或为空(疑似 e2e-runner.mjs 从未启动——setup 阶段失败)')
+    }
+    process.exit(2)
+  }
+
+  const summary = printSummary(runId)
+  process.exit(summary.ok ? 0 : 1)
+}
