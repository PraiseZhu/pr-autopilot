+      JSON.stringify(record({ runId, name: 'debug::dom::legacy::dev', scenario: 'debug' })),
+      JSON.stringify(record({ runId, name: 'debug::dom::legacy::dev', scenario: 'debug' })),
+      JSON.stringify(record({ runId, name: 'mask::dom::legacy::dev', scenario: 'mask' })),
+    ])
+    const summary = summarizeRun(runId)
+    expect(summary.ok).toBe(false)
+    expect(summary.errors.some((e) => e.includes('重复格:debug::dom::legacy::dev'))).toBe(true)
+  })
+
+  it('RED: 删掉一个 expectedCells 声明的格(缺格)→ ok=false,恰好点名该 cellKey', () => {
+    const runId = testRunId('missing-cell')
+    writeManifestFile(runId)
