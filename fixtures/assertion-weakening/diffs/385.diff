+describe('P2 continue 未决凭据生命周期(#297 P2 返修 R4.2:markDone 原子 done.add+attempted.delete,容量逼近上限 fail-closed 不淘汰未决)', () => {
+  it('done 写失败留未决 + 200 个后续正常提交都不挤占它 + 重启重放仍是零二次调用', async () => {
+    let writeCount = 0
+    let failFromWrite = Number.POSITIVE_INFINITY
+    const booted = boot({
+      writeGuard: () => {
+        if (failFromWrite === Number.POSITIVE_INFINITY) return true
+        writeCount += 1
+        return writeCount < failFromWrite
+      },
+    })
+    await seedRootRecord(booted)
+
+    // 让"标记完成"这次提交(attempted 已经落盘成功之后的下一次提交)的两次 fsWrite
+    // 全部失败:命中的正是 cardActionMarkDone 里 done.add+attempted.delete 那次提交,
+    // 不是前面 attempted 落盘那次(那次必须成功,才谈得上"已调用但结果未知")。
+    writeCount = 0
+    failFromWrite = 3
+    await clickAction(booted, {
+      actionId: 'continue',
+      spawnCallId: 'done-write-fails',
+      userActionToken: 'tok-done-write-fails',
+    })
+    expect(booted.brain.agentRunCalls).toHaveLength(1) // 真实调用已经发生(agent.run 成功)
+    expect((await booted.brain.handles.cardAction.attemptedIds())).toContain('done-write-fails') // 未决凭据没被抹掉
+    expect((await booted.brain.handles.cardAction.doneIds())).not.toContain('done-write-fails') // done 提交确实没落盘
+
+    // 写盘恢复正常,后续 200 个正常 continue 各自完整走完(attempted 落盘又被
+    // markDone 原子摘掉),验证它们不会把上面这条未决凭据从 attempted 里挤出去。
+    failFromWrite = Number.POSITIVE_INFINITY
+    for (let index = 0; index < 200; index += 1) {
+      await clickAction(booted, {
+        actionId: 'continue',
+        spawnCallId: `normal-continue-${index}`,
+        userActionToken: `tok-normal-${index}`,
+      })
+    }
+    expect(booted.brain.agentRunCalls).toHaveLength(201) // 1 条未决 + 200 条全部走完
+    expect((await booted.brain.handles.cardAction.attemptedIds())).toContain('done-write-fails')
+
+    // 重启:全新 brain 吃上一份的落盘快照,重放同一张票据。
+    const restarted = boot({ files: filesOf(booted) })
+    expect((await restarted.brain.handles.cardAction.attemptedIds())).toContain('done-write-fails')
+    await clickAction(restarted, {
+      actionId: 'continue',
+      spawnCallId: 'done-write-fails',
+      userActionToken: 'tok-done-write-fails',
+    })
+    expect(restarted.brain.agentRunCalls).toHaveLength(0) // 零二次调用
+    const replayed = doneCardsFor(restarted, 'done-write-fails').pop()
+    expect(replayed?.html).toContain(restarted.brain.handles.card.text('en', 'continueFailed'))
+  })
