+#!/usr/bin/env node
+// check-workflow-permissions.mjs — workflow `permissions:` ⊇ 它调用的 API 所需 scope 守卫。
+//
+// 为什么存在(2026-08-02,PR-w2 三审 codex-adversarial W2-R1-E-004 相邻 finding /
+// claude-adversarial w2-r1-F8):main-health.yml 曾经新增三个 `github.rest.*` 调用,
+// 但 `permissions:` 没跟着扩权,导致这三个调用在生产环境全部 403 —— 而 `actionlint`
+// (不做语义分析)与 `node --check`(只看语法)都测不出这类问题,合并前零信号。
+// 本守卫把"声明的 permissions 是否覆盖实际调用的 API"变成可机器执行的静态核对。
+//
+// 覆盖范围(有意"至少覆盖",不是穷举 REST API 全集):
+//   - repos.getContent → contents(读取源码文件,如 main-health 读 deploy-green-ref.yml)
+//   - checks.*         → checks(查 check-run 结论 / 建 check-run,读写方法分别映射)
+//   - actions.*        → actions(查 workflow run / job / step 明细,读写方法分别映射)
+//   - issues.*         → issues 或 pull-requests 之一,但仅限 comment 系端点(见下方
+//     ISSUES_METHOD_RULES 的 dual 字段);issue 本体端点(create/update/addLabels 等)
+//     只认 issues,不接受 pull-requests 顶替(二轮盲审 W2R2-CODEX-F3 / W2R1-A1 修正:
+//     此前对全部 issues.* 方法一律给 dual anyOf,会让"仅 pull-requests:write"的
+//     workflow 对 issues.create 这类本体端点也被判"已满足",而 GitHub 官方文档对
+//     该端点只列 Issues 权限)。
+// 其余 resource(repos 的非 getContent 方法、git.*、pulls.* 等)本仓当前用法均不依赖
+// 本守卫覆盖的这几条,故不在校验范围内 —— 新增依赖时按需扩展 SCOPE_RULES。
+//
+// covered resource(methodAllowlist===null,即"该 resource 下所有方法都受约束")上
+// 出现未被下方方法表收录的方法时,fail-closed:报告"映射缺失",不能像上一轮那样
+// 对 checks.*/actions.* 不分方法一律判"read"(W2R2-CODEX-F3:`actions.cancelWorkflowRun`
+// 这类写端点会被误判 actions:read 已满足,守卫假绿)。新增调用踩到未收录方法时,
+// 把它加进对应的 READ/WRITE 方法表,而不是放宽判定。
+//
+// 权限求解(GitHub 官方语义):workflow 级一旦显式声明 `permissions:`,未列出的 scope
+// 全部为 none;job 级若声明了自己的 `permissions:` 块,则**完全替换**(不是合并)
+// 该 job 的 workflow 级权限。level 排序 write ⊇ read,none/未声明 = 无权限。
+//
+// 实现方式:零依赖行解析(与仓内 repo-health-watchdog.yml 解析 main-health.yml 同一
+// 风格),不引入 YAML 依赖 —— 本仓 `yaml` 包只是间接依赖,未提升为可 import 的直接
+// 依赖,引入需要 npm install(本轮改动不允许)。permissions 块的子行缩进不再硬编码
+// 2/4/6 空格,改为从块首行动态检测(二轮盲审 UP2-S5)。job key 缩进与 job 属性
+// (含 permissions 头)缩进同样不再硬编码 2/4 空格,改为从 `jobs:` 与各 job 区间内
+// 首条实质行动态检测(三审 claude-adversarial W2R3-A1 相邻假绿 finding:硬编码在
+// job 用 4/6/8 空格等非常规缩进时会漏识别整个 job,内部调用落回 findJobForLine=null,
+// 借用更宽的 topPermissions,假绿而不是告警)。
+//
+// permissions 块内的独立注释行与行尾注释均透明跳过 / 剥除,不再让"块内有一行注释"
+// 被误判为"无法解析"(三审 claude-adversarial W2R3-A1:此前的回归 —— 同一输入
+// pre 正确解析、post 因为一行注释就把整份文件的全部调用判成违规,拖垮
+// `test:unit`)。多行 flow-map(`permissions: {` 单独收尾,逐行 `key: value,`,以
+// 单独一行 `}` 结束)与 YAML 锚点/别名(`permissions: &name {...}` 定义 +
+// `permissions: *name` 引用,仅限锚点定义本身也写在某个 `permissions:` 行上)现在
+// 也能正确解析,不再落回"未找到头,借用外层权限"的假绿路径(三审
+// claude-adversarial W2R3-A1 相邻 finding:此前这四类 actionlint 合法形状
+// checkWorkflowText() 全部返回 [],而实际 job permissions 是空/none)。
+//
+// 遇到无法可靠理解的形状(带引号 job 名、非空 flow-map permissions、tab 缩进、
+// 子行缩进不一致、flow-map 内出现无法识别的项、别名指向的锚点找不到或锚点自身
+// 也无法解析)时,同样 fail-closed:返回专门的 `'unparsed'` 标记而不是当作"该 job
+// 没声明任何权限"或"借用外层权限"静默处理,调用方看到的是"permissions 块无法
+// 解析,请人工核对"而不是被误导的缺 scope 提示。
+//
+// 方法级调用识别(SC3,codex-adversarial W2R3-CODEX-F4,三审 R2 起再扩一轮):
+// 除单行点号(github.rest.resource.method)外,现在也识别 bracket 方法名
+// (github.rest.resource['method']/[`method`])、bracket resource(github.rest['resource'].method
+// 及 resource/method 都 bracket 的组合)、跨行点号(含"本行以 resource. 收尾、下一行
+// 裸方法名"的尾随点号变体)、optional chaining(github.rest?.actions?.method)、
+// resource 级解构/简单赋值别名(`const { resource } = github.rest` /
+// `const api = github.rest.resource`)、整对象别名(`const gh = github.rest`
+// 之后 gh.resource.method)、以及方法级解构(`const { method } = github.rest.resource`
+// 或 `= <resource 别名>`,解构清单里的原属性名本身就是方法名)。
+//
+// 三审 R2 起的判据收紧(claude-adversarial W2R4-A1 / codex-adversarial
+// W2R3-R2-CODEX-F2):不再满足于"逐个语法打补丁、覆盖不到的等价写法归入已知局限
+// 假绿"——静态解析对抗任意等价 JS 语法本质上没有终点。改为:findRestCalls 在完成
+// 上述所有已知形态的识别后,对每一行残留的"仍引用了 github.rest 或已知别名/解构
+// 产物,但没被上述任何形态消费掉"的文本一律判定为"引用证据存在,但解析不出具体
+// 方法调用",标记该行 unparsed —— 由 findUnresolvedRestReferences 导出,
+// checkWorkflowText 据此产出 fail-closed 违规,不再是零信号的假绿。
+//
+// 域边界(三审 R3 复核盲审第 6 轮结构性收口,claude-adversarial W2R6-A1 /
+// codex-adversarial W2R3-R4-CODEX-F1 — 取代此前"位置代理"的字符邻接启发式):
+// 上面这套别名/调用识别、以及下方的残留引用扫描,只在 `script:` 键的 YAML
+// **block scalar**(`script: |`/`script: >`,可带 `+`/`-`/数字 chomping 指示符)
+// 划出的文本区间内进行 —— `github.rest` 是 `actions/github-script` 注入进它自己
+// `with.script` 沙箱的对象,只在这个域里才有意义(为什么不放宽到任意 block
+// scalar key 名,见下方 findScriptBlocks 与已知局限里的说明:`run: |` 之类的
+// shell 脚本语法上不是 JS,放宽后会把 bash 内嵌的多行字符串误判成 JS 词法歧义,
+// 产出与 permissions 无关的假 unparsed)。域外(真正的 YAML 结构:`permissions:`、
+// `uses:`、序列项键等)本就不可能出现 `github.rest` 语义,天然不在扫描面内,
+// 不需要再靠"两侧是否贴 `-`/`/`"或"是否在
+// 行首"这类跟 JS 语义无关的字符位置代理去分辨 —— 而这类代理本身在两个方向都有
+// 反例:字符邻接会把注释起始的 `/`(`acts/* 注释 */.method()`)误判成词边界信号,
+// 产出真实可执行的权限绕过假绿(codex-adversarial W2R3-R4-CODEX-F1);行首豁免则
+// 会漏掉"别名恰好独占一行、冒号紧贴"的三元/switch 变体(claude-adversarial
+// W2R6-G1)。域分离从根上消掉这两类反例,而不是再打第三轮字符位置补丁。
+// findScriptBlocks() 按缩进动态探测每个 block scalar 的内容区间(与本文件其它
+// 缩进探测同一手法),detect 到的每个区间各自独立跑一次下方的 analyzeRestCalls
+// —— 别名作用域天然按区间(即按 step)隔离,不会跨 step 泄漏(与真实 GitHub
+// Actions 里每个 script 步骤是独立 JS 执行上下文的语义一致)。
+//
+// 注释与字符串感知(同一轮结构性收口):区间内先做一次轻量词法扫描(tokenizeJsLines),
+// 剥离 `//` 行注释与 `/* */` 块注释(块注释整段删除而不是留空白占位,原本被注释
+// 隔开的 token 剥离后重新贴邻,直接调用识别的严格贴邻正则才能跨过注释继续匹配 ——
+// 这正是修正 codex-adversarial W2R3-R4-CODEX-F1 的关键一步,不是只换个位置代理);
+// 另外产出一份把字符串/模板字符串内容也抹成等长空白的版本,只供第 4 步残留引用
+// 扫描使用(直接调用识别仍在保留字符串的版本上跑,bracket 方法名等合法写法依赖
+// 字符串内容本身)—— 字符串字面量里偶然撞出的别名同形词(如 main-health.yml 里
+// `'github-actions[bot]'` 撞上别名 `actions`)不是真实 JS 引用,不该被残留扫描
+// 当成"碰了 github.rest 覆盖面"。扫描到行尾仍未闭合的单/双引号字符串(拿不准是否
+// 是合法的跨行续行写法)时不猜测,整行记入 forcedUnparsedLines,交给残留扫描
+// fail-closed 处理;跨行的块注释与模板字符串按 JS 本身的语法允许跨行,不算歧义。
+//
+// 已知局限(不藏,按方向分类,三审 R3 复核盲审第 6 轮结构性收口后重写):
+//   [假红方向 fail-open 不适用 / 保持 fail-closed]
+//   - 仍不支持 tab 缩进 —— indent 计算只识别空格前缀,tab 缩进的 job key /
+//     permissions 子行 / block scalar 头会因缩进不匹配而漏识别或直接返回
+//     'unparsed'(与本仓既有的缩进假设同一性质,应先跑 actionlint 确认 YAML
+//     本身没有跑偏)。
+//   - YAML 锚点/别名仅支持"锚点定义本身写在某个 permissions: 行上"这一种形态。
+//   - 多行 flow-map 只支持"每行一条 key: value[,]"的直白形式。
+//   - 别名解析只追一跳(`const a = github.rest.actions` 后 `a` 是已知别名,但
+//     `const b = a` 不会被继续追踪)。
+//   - 简单赋值别名只认单行、以 `;` 收尾的形态;跨行赋值不被识别为别名定义,但
+//     右侧文本仍会被残留引用扫描抓到,fail-closed 为 unparsed。
+//   - 解构里任一成员带本解析器不支持的语法(默认值、computed key 等)时,整条
+//     解构语句都不会被 consume,原文本(含其中的 github.rest 字面量/已知别名)
+//     保留在残留扫描里,fail-closed 为 unparsed。
+//   - 别名名字若与其它 JS 文本巧合撞形(如作为普通标识符出现在别的表达式里,
+//     不构成调用)不会被特别排除,会被当作残留引用报 unparsed —— 方向仍是
+//     fail-closed(多报而不是漏报),不是假绿。
+//   - block scalar 区间探测只认 `script:` 这一个 key 名(见 findScriptBlocks
+//     注释),不识别是否真的挂在 `uses: actions/github-script` 步骤下 —— 若
+//     某处 `script:` 键恰好不是 github-script 步骤(本仓未出现这种写法),仍会
+//     被当成 JS 域扫描,同样是"多扫一点,不会漏扫"的方向,不是假绿。
+//   [假绿方向,已知但暂未覆盖 —— 方法级调用识别]
+//   - 别名解析只追一跳,`b.method()` 既不报违规也不报 unparsed —— 多跳别名链
+//     需要真正的绑定追踪(变量数据流分析),不是本解析器的"至少覆盖"定位。
+//   - 简单赋值别名跨行/无分号形态不被识别为别名定义(见上,fail-closed 兜底)。
+//   - 解构成员语法不支持时整条不 consume(见上,fail-closed 兜底)。
+//   - 词法扫描不追踪模板字符串内 `${...}` 插值的嵌套结构,把整个模板字符串
+//     (含插值部分)当成不透明文本一次性跳过 —— 插值内部若恰好写了
+//     `github.rest.*` 调用,不会被识别为调用,但字面量外层(`github.rest` 若
+//     在模板外)仍会被残留扫描的 marker 检查抓到;本仓当前(2026-08-03)零处
+//     使用带插值的模板字符串,未构造对应回归。
+//   - `/` 单字符不参与注释判定(只有 `//`/`/*` 两字符组合才触发),真正的正则
+//     字面量(如 main-health.yml 里 `/<!-- ... -->/`)不会被误当注释;但若某个
+//     正则字面量内部恰好包含 `//` 或 `/*` 这两个字符组合,词法扫描仍会把它误判
+//     为注释起点 —— 区分"除号/正则字面量起始的 `/`"与真实注释起点需要完整的
+//     JS 表达式上下文(前一个 token 是否允许除法),本解析器不做这层判断;本仓
+//     当前用到的唯一正则字面量不含这两个组合,未构造对应回归。
+//
+// 退出码:0=全部调用的 scope 需求都被满足;1=有缺口(逐条 file:line + 修法);
+// 2=运行错误(目录扫描失败 / 文件读取失败 / 一个 workflow 文件都没找到),fail-closed。
+import { readFileSync, readdirSync, realpathSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const WORKFLOWS_DIR = '.github/workflows'
+
+// ── resource → 方法级 read/write 映射(未收录方法 = null,由调用方 fail-closed) ──
+// checks.*:官方文档 "Create a check run" / "Update a check run" 要 checks:write,
+// 其余列出/读取类端点 read 即可。
+const CHECKS_METHOD_LEVEL = {
+  listForRef: 'read',
+  listSuitesForRef: 'read',
+  get: 'read',
+  getSuite: 'read',
+  create: 'write',
+  update: 'write',
+  rerequestRun: 'write',
+  rerequestSuite: 'write',
+  setSuitesPreferences: 'write',
+}
+
+// actions.*:官方文档里明确的写端点(取消/重跑/删除/触发 dispatch/开关 workflow 等)
+// 要 actions:write,其余列出/查询/下载类端点 read 即可。
+const ACTIONS_METHOD_LEVEL = {
+  listJobsForWorkflowRunAttempt: 'read',
+  listJobsForWorkflowRun: 'read',
+  listWorkflowRunsForRepo: 'read',
+  listWorkflowRuns: 'read',
+  getWorkflowRun: 'read',
+  getWorkflowRunAttempt: 'read',
+  getWorkflowRunUsage: 'read',
+  listRepoWorkflows: 'read',
+  listWorkflowRunArtifacts: 'read',
+  listArtifactsForRepo: 'read',
+  downloadArtifact: 'read',
+  downloadJobLogsForWorkflowRun: 'read',
+  downloadWorkflowRunLogs: 'read',
+  getWorkflowRunLogs: 'read',
+  cancelWorkflowRun: 'write',
+  forceCancelWorkflowRun: 'write',
+  reRunWorkflow: 'write',
+  reRunWorkflowFailedJobs: 'write',
+  deleteWorkflowRun: 'write',
+  deleteWorkflowRunLogs: 'write',
+  createWorkflowDispatch: 'write',
+  deleteArtifact: 'write',
+  disableWorkflow: 'write',
+  enableWorkflow: 'write',
+}
+
+// issues.*:{ level, dual }。dual=true 表示该方法是 GitHub 官方文档承认的
+// "Issues 或 Pull requests 权限二选一"comment 系端点(pr-hygiene.yml 现有的纯
+// pull-requests:write 正是依赖这条规则合法工作)。dual=false 表示这是 issue 本体
+// 端点,官方文档只列 Issues 权限,pull-requests:write **不能**顶替
+// (W2R2-CODEX-F3 反例:issues.create 只配 pull-requests:write 时应判违规)。
+const ISSUES_METHOD_RULES = {
+  listComments: { level: 'read', dual: true },
+  getComment: { level: 'read', dual: true },
+  createComment: { level: 'write', dual: true },
+  updateComment: { level: 'write', dual: true },
+  deleteComment: { level: 'write', dual: true },
+  get: { level: 'read', dual: false },
+  listForRepo: { level: 'read', dual: false },
+  getLabel: { level: 'read', dual: false },
+  listLabelsForRepo: { level: 'read', dual: false },
+  listLabelsOnIssue: { level: 'read', dual: false },
+  create: { level: 'write', dual: false },
+  update: { level: 'write', dual: false },
+  lock: { level: 'write', dual: false },
+  unlock: { level: 'write', dual: false },
+  addLabels: { level: 'write', dual: false },
+  removeLabel: { level: 'write', dual: false },
+  removeAllLabels: { level: 'write', dual: false },
+  addAssignees: { level: 'write', dual: false },
+  removeAssignees: { level: 'write', dual: false },
+  delete: { level: 'write', dual: false },
+}
+
+export const SCOPE_RULES = {
+  repos: {
+    // 只覆盖 getContent(至少覆盖清单里明确点名的方法),其余 repos.* 方法本仓
+    // 现有调用(getBranch/compareCommits)不依赖新增只读 scope,不在校验范围。
+    methodAllowlist: new Set(['getContent']),
+    requiredLevel: () => 'read',
+    anyOfScopes: () => ['contents'],
+  },
+  checks: {
+    methodAllowlist: null, // null = 该 resource 下所有方法都受本规则约束
+    requiredLevel: (method) => CHECKS_METHOD_LEVEL[method] ?? null,
+    anyOfScopes: () => ['checks'],
+  },
+  actions: {
+    methodAllowlist: null,
+    requiredLevel: (method) => ACTIONS_METHOD_LEVEL[method] ?? null,
+    anyOfScopes: () => ['actions'],
+  },
+  issues: {
+    methodAllowlist: null,
+    requiredLevel: (method) => ISSUES_METHOD_RULES[method]?.level ?? null,
+    anyOfScopes: (method) => (ISSUES_METHOD_RULES[method]?.dual ? ['issues', 'pull-requests'] : ['issues']),
+  },
+}
+
+const LEVEL_RANK = { none: 0, read: 1, write: 2 }
+const levelSatisfies = (required, declared) =>
+  (LEVEL_RANK[declared] || 0) >= LEVEL_RANK[required]
+
+// 剥除行尾注释:'#' 前是空白或位于行首才算注释起点(YAML 语义;本仓 permissions
+// 块内的取值均无引号,不需要处理引号内 '#' 的转义场景),截断后再去掉尾随空白。
+function stripTrailingComment(line) {
+  return line.replace(/(^|\s)#.*$/, '').replace(/\s+$/, '')
+}
+
+// 剥除 `permissions:` 之后紧跟的 YAML 锚点标记(`&name `),不改变其后的实际
+// 取值 —— 用于 `permissions: &name {...}` 这类"定义处就带值"的锚点,与别名引用
+// (见 resolveAliasValue)是两条不同路径。锚点标记出现在 "permissions:" 之后
+// (而不是整行开头),故匹配必须锚定该前缀,不能只看行首。
+function stripLeadingAnchor(s) {
+  return s.replace(/^(\s*permissions:\s*)&[A-Za-z0-9_-]+\s*/, '$1')
+}
+
+// 单行/多行 flow-map 的公共 body 解析:逗号分隔的 `key: value` 列表。
+function parseFlowMapBody(body) {
+  const scopes = new Map()
+  const items = body.trim() ? body.split(',') : []
+  for (const pair of items) {
+    if (!pair.trim()) continue
+    const m = /^\s*([a-zA-Z-]+)\s*:\s*(read|write|none)\s*$/.exec(pair)
+    if (!m) return 'unparsed'
+    scopes.set(m[1], m[2])
+  }
+  return scopes
+}
+
+// 多行 flow-map:从 `{` 单独收尾的头行下一行开始,逐行收集 `key: value,`(允许行尾
+// 逗号与行尾注释),直到出现单独一行的 `}`(允许前导空白与行尾注释)。找不到闭合
+// `}`、或中途出现无法识别的行,fail-closed 为 'unparsed'。
+function parseMultilineFlowMap(lines, headerIdx) {
+  const scopes = new Map()
+  for (let i = headerIdx + 1; i < lines.length; i += 1) {
+    const raw = stripTrailingComment(lines[i])
+    if (raw.trim() === '') continue
+    if (/^\s*\}\s*$/.test(raw)) return scopes
+    const m = /^\s*([a-zA-Z-]+)\s*:\s*(read|write|none)\s*,?\s*$/.exec(raw)
+    if (!m) return 'unparsed'
+    scopes.set(m[1], m[2])
+  }
+  return 'unparsed' // 扫到文件末尾都没找到闭合 `}`,声明不完整
+}
+
+// 别名解析(`permissions: *name`):在全文里找同一形态的锚点定义
+// `permissions: &name ...`,取它声明的值递归解析。找不到定义、或定义自身也无法
+// 理解,一律 'unparsed'(不猜测,也不当作"未声明"借用外层权限)。
+function resolveAliasValue(lines, name) {
+  const defRe = new RegExp(`^\\s*permissions:\\s*&${name}\\b`)
+  const defIdx = lines.findIndex((l) => defRe.test(stripTrailingComment(l)))
+  if (defIdx === -1) return 'unparsed'
+  return parsePermissionsBlock(lines, defIdx)
+}
+
+// ── 纯函数:解析一个 `permissions:` 块(vitest 覆盖) ─────────────────────────
+// lines: 整个文件的行数组;headerIdx: `permissions:` 那一行的下标。
+// 返回 Map<scope, level> | 'read-all' | 'write-all' | 'unparsed' | null。
+// null = 未找到 permissions 头(headerIdx<0);'unparsed' = 找到了头,但块内容
+// 是本解析器未能可靠理解的形状 —— 二者语义不同,分别标记,不合并成同一个
+// "没权限"结果(UP2-S5)。
+export function parsePermissionsBlock(lines, headerIdx) {
+  if (headerIdx < 0 || headerIdx >= lines.length) return null
+  const headerLine = stripLeadingAnchor(stripTrailingComment(lines[headerIdx]))
+  const headerIndent = headerLine.length - headerLine.replace(/^ */, '').length
+
+  const aliasMatch = /^\s*permissions:\s*\*([A-Za-z0-9_-]+)\s*$/.exec(headerLine)
+  if (aliasMatch) return resolveAliasValue(lines, aliasMatch[1])
+
+  const inlineAll = /^\s*permissions:\s*(read-all|write-all)\s*$/.exec(headerLine)
+  if (inlineAll) return inlineAll[1]
+  if (/^\s*permissions:\s*\{\s*\}\s*$/.test(headerLine)) return new Map()
+  // 非空单行 flow-map:`permissions: { contents: read, checks: write }`
+  // (W2R2-CODEX-F4:job 级 flow-map permissions 此前完全不被识别,静默继承
+  // workflow 级更宽的权限)。
+  const flow = /^\s*permissions:\s*\{([^{}]*)\}\s*$/.exec(headerLine)
+  if (flow) return parseFlowMapBody(flow[1])
+  // 多行 flow-map:`permissions: {` 单独一行开头(三审 W2R3-A1 相邻假绿修复 —— 此前
+  // 完全不被识别为头,静默借用外层权限)。
+  if (/^\s*permissions:\s*\{\s*$/.test(headerLine)) return parseMultilineFlowMap(lines, headerIdx)
+  if (!/^\s*permissions:\s*$/.test(headerLine)) {
+    // 头行还带着本解析器不认识的其它内容,fail-closed。
+    return 'unparsed'
+  }
+
+  // block 形式:以紧随其后第一条非空、非纯注释、缩进大于 headerIndent 的行为子行
+  // 缩进基准,不再硬编码固定空格数(UP2-S5)。独立注释行与行尾注释透明跳过/剥除
+  // (三审 W2R3-A1:此前一条注释就会把整块判成 'unparsed')。
+  let scopeIndent = null
+  const scopes = new Map()
+  for (let i = headerIdx + 1; i < lines.length; i += 1) {
+    const line = lines[i]
+    if (line.trim() === '') continue
+    if (line.trim().startsWith('#')) continue
+    const indent = line.length - line.replace(/^ */, '').length
+    if (indent <= headerIndent) break // dedent 或同级,块结束(含空块,等价于 {})
+    if (scopeIndent === null) scopeIndent = indent
+    if (indent !== scopeIndent) return 'unparsed' // 子行缩进不一致,无法可靠解析
+    const stripped = stripTrailingComment(line)
+    const m = new RegExp(`^ {${scopeIndent}}([a-zA-Z-]+):\\s*(read|write|none)\\s*$`).exec(stripped)
+    if (!m) return 'unparsed' // 这一行不是合法的 "scope: level",不猜测,直接报无法解析
+    scopes.set(m[1], m[2])
+  }
+  return scopes
+}
+
+// 把 parsePermissionsBlock 的返回值统一成"查询某个 scope 的声明 level"的函数,
+// 方便下游按 anyOfScopes 求最大 level。'unparsed' 与 null/非 Map 同样落到 fail-closed
+// 的 'none'(不猜测任何 scope 已声明);missingScopesForCall 里对 'unparsed' 另有
+// 专门分支,用于产出"无法解析"而不是"缺 scope"的诊断文案。
+export function resolveDeclaredLevel(permissions, scope) {
+  if (permissions === 'read-all') return 'read'
+  if (permissions === 'write-all') return 'write'
+  if (!permissions || !(permissions instanceof Map)) return 'none'
+  return permissions.get(scope) || 'none'
+}
+
+// ── 纯函数:在整份文件文本里定位 jobs 段与每个 job 的行区间 + 生效 permissions ──
+export function parseWorkflow(text) {
+  const lines = text.split('\n')
+  // 顶层 permissions 头:不再要求精确匹配 3 种固定形状,只要求"顶层(0 缩进)的
+  // permissions: 键"本身,剥掉行尾注释后判定(三审 W2R3-A1 相邻假绿修复:此前
+  // `permissions: {} # 说明` 这类带尾注的头完全不被识别为头,直接落到
+  // headerIdx=-1 → 借用"未声明"的默认语义,而不是被正确解析成显式声明的空权限)。
+  // 具体形状(read-all / flow-map / block / 锚点 / 别名)交给 parsePermissionsBlock
+  // 逐一识别,识别不了的一律 'unparsed',不在这里预先过滤掉。
+  const topHeaderIdx = lines.findIndex((l) => /^permissions:/.test(stripTrailingComment(l)))
+  const topPermissions = parsePermissionsBlock(lines, topHeaderIdx)
+
+  // `jobs:` 头本身也剥掉行尾注释再判定(三审 R2 codex-adversarial W2R3-R2-CODEX-F1:
+  // 此前只对 permissions 头剥注释,`jobs: # 说明` 这类合法尾注会让本行匹配 /^jobs:\s*$/
+  // 失败,整个 jobs 段落漏识别 → jobs=[] → 内部全部调用借用更宽的顶层权限,静默假绿)。
+  const jobsIdx = lines.findIndex((l) => /^jobs:\s*$/.test(stripTrailingComment(l)))
+  const jobs = []
+  if (jobsIdx >= 0) {
+    // job key 缩进从 `jobs:` 后第一条非空/非注释行动态检测,不再硬编码 2 空格
+    // (三审 W2R3-A1 相邻假绿修复:job key 用 4/6/8 等非常规缩进时此前会漏识别
+    // 全部 job,内部调用落回 findJobForLine=null,借用更宽的 topPermissions)。
+    // job 名允许裸标识符或单/双引号包裹(W2R2-CODEX-F4)。
+    let jobKeyIndent = null
+    const jobKeyBodyRe = /^(?:'([^']+)'|"([^"]+)"|([A-Za-z0-9_.-]+)):\s*$/
+    for (let i = jobsIdx + 1; i < lines.length; i += 1) {
+      const line = lines[i]
+      if (line.trim() === '') continue
+      if (line.trim().startsWith('#')) continue
+      const indent = line.length - line.replace(/^ */, '').length
+      if (indent === 0) break // 回到顶层下一个 key,jobs 块结束
+      if (jobKeyIndent === null) jobKeyIndent = indent
+      if (indent !== jobKeyIndent) continue // 更深缩进的属性行,不是 job key,跳过
+      // job key 行同样剥掉行尾注释再匹配(同一条 W2R3-R2-CODEX-F1:`x: # 说明` 这类
+      // 合法尾注此前会让该 job key 本身漏识别,该 job 的边界连带丢失)。
+      const m = jobKeyBodyRe.exec(stripTrailingComment(line).slice(jobKeyIndent))
+      if (m) jobs.push({ name: m[1] || m[2] || m[3], startLine: i })
+    }
+    for (let i = 0; i < jobs.length; i += 1) {
+      jobs[i].endLine = i + 1 < jobs.length ? jobs[i + 1].startLine - 1 : lines.length - 1
+    }
+    for (const job of jobs) {
+      // job 属性(含 permissions 头)缩进同样从该 job 区间内第一条实质行动态检测,
+      // 不再硬编码 4 空格 —— 与 jobKeyIndent 同一手法,同一批修复。
+      let propIndent = null
+      let jobPermHeaderIdx = -1
+      for (let i = job.startLine + 1; i <= job.endLine; i += 1) {
+        const raw = lines[i]
+        if (raw.trim() === '') continue
+        if (raw.trim().startsWith('#')) continue
+        const indent = raw.length - raw.replace(/^ */, '').length
+        if (propIndent === null) propIndent = indent
+        if (indent !== propIndent) continue // 更深层嵌套内容(steps 详情等),跳过
+        const stripped = stripTrailingComment(raw)
+        if (/^permissions:/.test(stripped.slice(propIndent))) {
+          jobPermHeaderIdx = i
+          break
+        }
+      }
+      // job 级 permissions 若声明,完全替换(不合并)workflow 级 —— GitHub 官方语义。
+      job.permissions = jobPermHeaderIdx >= 0 ? parsePermissionsBlock(lines, jobPermHeaderIdx) : topPermissions
+    }
+  }
+  return { lines, topPermissions, jobs }
+}
+
+// ── 内部辅助:整份文本(可能跨行)的字符偏移 ↔ 行号互转,供下面的"残余引用扫描"
+// 在多行匹配(如跨多行的解构语句)里定位具体是哪一行、以及把已消费的文本区间从
+// 残余扫描副本里抹掉。 ──────────────────────────────────────────────────────
+function buildLineOffsets(lines) {
+  const offsets = []
+  let pos = 0
+  for (const l of lines) {
+    offsets.push(pos)
+    pos += l.length + 1 // +1 为 join('\n') 时的换行符
+  }
+  return offsets
+}
+
+function lineIndexAt(lineOffsets, offset) {
+  // lineOffsets 严格递增;workflow 文件通常几百到几千行,线性扫描足够,不必二分。
+  let idx = 0
+  while (idx + 1 < lineOffsets.length && lineOffsets[idx + 1] <= offset) idx += 1
+  return idx
+}
+
+function blankRange(residualLines, lineOffsets, start, end) {
+  // 把字符偏移区间 [start, end)(可能跨多行)在 residualLines 副本里替换成等长
+  // 空白,防止"残余引用扫描"对已经被某个解析成功的调用/别名定义消费掉的文本
+  // 重复告警。只动 residualLines(供残余扫描用的独立副本),不影响原始 lines/text
+  // 上任何其它已完成的正则匹配。
+  let pos = start
+  while (pos < end) {
+    const lineIdx = lineIndexAt(lineOffsets, pos)
+    const lineStart = lineOffsets[lineIdx]
+    const lineText = residualLines[lineIdx]
+    const lineEnd = lineStart + lineText.length
+    const from = pos - lineStart
+    const to = Math.min(end, lineEnd) - lineStart
+    if (to > from) {
+      residualLines[lineIdx] = lineText.slice(0, from) + ' '.repeat(to - from) + lineText.slice(to)
+    }
+    pos = lineEnd + 1 // 跳过换行符,继续下一行
+    if (lineIdx + 1 >= residualLines.length) break
+  }
+}
+
+const escapeRegExpLiteral = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+
+// ── 纯函数:定位全文里全部 `script:` 键的 YAML block scalar(`script: |`/
+// `script: >`,可带 `+`/`-`/数字 chomping 指示符)内容行区间(三审 R3 复核盲审
+// 第 6 轮结构性收口,见文件头"域边界"说明)。只认 `script:` 这一个 key 名 ——
+// `github.rest` 是 `actions/github-script` 注入进它自己 `with.script` 沙箱的
+// 对象,只在这个域里才有意义;其它 block scalar(最典型是 `run: |` 的 shell
+// 脚本)语法上完全不是 JS,曾经把探测放宽到"任意 key 名"时,ci.yml 里
+// `run: | \n node -e "...多行 JS 字符串..."` 这类 bash 内嵌多行双引号字符串
+// 被当成 JS 逐行词法扫描,行尾"未闭合字符串"的歧义判定被大量触发,产出与
+// permissions 完全无关的假 unparsed(2026-08-03 结构性收口过程中用真实仓内
+// 文件实测发现,未采纳该放宽方案)。仓内测试 fixture 里历史上用 `run: |`
+// 简写表示"这一步的 JS 内容",现按同一收口统一改为 `script: |`,与真实文件的
+// 唯一合法域对齐,不再需要放宽 key 名去兼容旧写法。缩进探测手法与本文件其它
+// 区间探测(permissions 子行 / job 属性)一致:从头行下一条非空行的缩进动态
+// 取值,不硬编码空格数;块内容持续到出现缩进小于该基准的非空行,或到文件末尾。
+// 返回按位置排序、互不重叠的 { startLine, endLine } 数组(startLine > endLine
+// 表示空块,即头行后立即 dedent,没有任何内容行)。 ───────────────────────────
+function findScriptBlocks(lines) {
+  const blocks = []
+  // 允许可选的序列项前缀(`- `)—— `- script: |` 是"steps 列表项内嵌一个
+  // mapping key"的写法,前导 `-` 不算 key 名的一部分,但捕获组 1 仍取"这一行的
+  // 整体缩进"(dash 本身的位置,不是 key 名的位置),与本文件其它缩进探测统一按
+  // "这一行的前导空白长度"取值的惯例一致。
+  const headerRe = /^(\s*)(?:-\s+)?script:\s*[|>][+-]?\d*\s*(?:#.*)?$/
+  for (let i = 0; i < lines.length; i += 1) {
+    const m = headerRe.exec(lines[i])
+    if (!m) continue
+    const headerIndent = m[1].length
+    let bodyIndent = null
+    let firstContentLine = -1
+    for (let j = i + 1; j < lines.length; j += 1) {
+      if (lines[j].trim() === '') continue
+      const indent = lines[j].length - lines[j].replace(/^ */, '').length
+      if (indent <= headerIndent) break // 立即 dedent,空块
+      bodyIndent = indent
+      firstContentLine = j
+      break
+    }
+    if (firstContentLine === -1) {
+      blocks.push({ startLine: i + 1, endLine: i })
+      continue
+    }
+    let end = firstContentLine
+    for (let k = firstContentLine + 1; k < lines.length; k += 1) {
+      if (lines[k].trim() === '') { end = k; continue }
+      const indent = lines[k].length - lines[k].replace(/^ */, '').length
+      if (indent < bodyIndent) break
+      end = k
+    }
+    blocks.push({ startLine: firstContentLine, endLine: end })
+    i = end // 跳过已消费的块,避免把块内容自己的文本误判成新的块头
+  }
+  return blocks
+}
+
+// 判定一个 `/` 是正则字面量的起点还是除号/取余的字面字符 —— 经典的 JS 词法
+// 歧义,标准做法是看"前一个有意义的 token 是否是能作为表达式结尾的值"(值之后
+// 的 `/` 才是运算符;否则前面还没有左操作数,只能是正则起点)。lastNonSpaceChar
+// 是最近一个非空白字符本身(标识符/数字字符会一路累积进 lastWord,供关键字判定;
+// 字符串/模板字符串/正则字面量闭合后 lastNonSpaceChar 落在闭合引号/斜杠这个
+// "值"上,均不在下面的运算符集合里,天然落到"除号"分支,不需要额外的哨兵值)。
+const REGEX_PERMIT_CHARS = new Set(['(', '[', '{', ',', ';', ':', '=', '!', '&', '|', '?', '+', '-', '*', '%', '^', '~', '<', '>'])
+const REGEX_PERMIT_KEYWORDS = new Set([
+  'return', 'typeof', 'instanceof', 'in', 'of', 'new', 'delete', 'void',
+  'throw', 'case', 'yield', 'await', 'else', 'do',
+])
+function isRegexStart(lastNonSpaceChar, lastWord) {
+  if (lastNonSpaceChar === '') return true // 区块开头,尚无左操作数
+  if (REGEX_PERMIT_CHARS.has(lastNonSpaceChar)) return true
+  return REGEX_PERMIT_KEYWORDS.has(lastWord)
+}
+
+// ── 纯函数:轻量 JS 词法扫描(不做完整语法解析),区分"注释 / 字符串-模板
