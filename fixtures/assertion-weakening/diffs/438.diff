+// ── SC1 接线锁:main-health.yml 必须真的从本文件导入判据,不能悄悄退回"手工镜像"
+// (W2R2-C1 / CODEX-F2 / UP2-S4 的根因就是"两份实现靠注释同步") ─────────────────
+describe('main-health.yml 单一源接线(SC1)', () => {
+  const workflowText = readFileSync(join(process.cwd(), '.github/workflows/main-health.yml'), 'utf8')
+
+  it('github-script 步骤动态 import 本文件,而不是重新声明这些判据函数/常量', () => {
+    expect(workflowText).toMatch(/await import\(.*main-health-logic\.mjs['"]?\)/)
+  })
+
+  it('checkout 步骤在 github-script 步骤之前(import 需要工作目录里有仓库源码)', () => {
+    const checkoutIdx = workflowText.indexOf('actions/checkout@')
+    const scriptIdx = workflowText.indexOf('await import(')
+    expect(checkoutIdx).toBeGreaterThan(-1)
+    expect(scriptIdx).toBeGreaterThan(-1)
+    expect(checkoutIdx).toBeLessThan(scriptIdx)
+  })
+
+  // 三审返修(claude-adversarial W2R3-C1 / upstream-preview UP3-F3):上面三条断言
+  // 只证明"字符串长得像一句 import 语句",从未核对 import 的路径是否真实存在、也
+  // 从未核对解构出的符号是否真的在模块导出里 —— 是正则烟雾测试。反向变异实测两种
+  // 真实演进都能全绿通过:P8(模块被搬到别的目录,workflow 里路径字面量没跟着改)、
+  // P9(解构清单里某个符号打错成不存在的名字)。下面把"接线锁"改成对真实文件系统
+  // 与真实模块导出的核对,取代字符串形状匹配。
+
+  // 从 workflow 文本里解析出 import 的路径字面量与解构清单,两条断言共用。
+  const importPathMatch = /await import\(process\.env\.GITHUB_WORKSPACE \+ '([^']+)'\)/.exec(workflowText)
+  const destructureMatch = /const\s*\{([^}]+)\}\s*=\s*mainHealthLogic;/.exec(workflowText)
+  const destructuredNames = destructureMatch
+    ? destructureMatch[1].split(',').map((s) => s.trim()).filter(Boolean)
+    : []
+
+  // 三审 R2(upstream-preview UP3R2-F2):独立于被审文本维护的期望符号集 —— 此前
+  // `destructuredNames` 完全由 workflowText 自己的解构清单推导,构成自我举证:
+  // 只要把某个符号从解构清单里删掉,`for (const name of destructuredNames)` 遍历
+  // 就不再含它,"不再本地重新声明"这条锁同步停止守它;而"删掉解构 + 本地重声明"
+  // 恰恰是唯一能真正跑起来的镜像回退形态(同作用域既解构又重声明同名变量是
+  // SyntaxError,那些语法上活不下来的变异反而全被 M1-M5 抓到,制造"锁很强"的假象)。
+  // 唯一的下限断言 `toBeGreaterThan(0)` 也不够 —— 13 个符号删到 12 个仍然 >0,
+  // 不会变红。这里改成与固定期望集的集合比较,任意增删都会立即不相等。
+  const EXPECTED_DESTRUCTURED_NAMES = new Set([
+    'GREEN_REF_WORKFLOW_NAME',
+    'selectBlockingMode',
+    'isBlockingMode',
+    'parseRequiredOnMain',
+    'aggregateStepConclusions',
+    'computeFailedSteps',
+    'computeNotRerunPairs',
+    'validateFailedStepsShape',
+    'buildJobsForAttemptParams',
+    'buildStepLabel',
+    'IDLE_COMMENT_PREFIX',
+    'hasRecentIdleNotice',
+    'compareRunSeq',
+  ])
+
+  it('SC1 反向变异 P8:import 路径字面量必须指向真实存在的文件(此前"模块被搬到别的目录、字面量没跟着改"这一变异 0 红,现在必须变红)', () => {
+    expect(importPathMatch, '未能从 workflow 文本里解析出 import 的路径字面量').not.toBeNull()
+    const resolved = join(process.cwd(), importPathMatch[1])
+    expect(existsSync(resolved), `import 路径 "${importPathMatch[1]}" 解析到 ${resolved},该文件不存在`).toBe(true)
+  })
+
+  it('SC1 反向变异 P9:全部解构符号都必须在 main-health-logic.mjs 的真实导出集合里(此前"解构清单里某个符号打错"这一变异 0 红,现在必须变红)', () => {
+    expect(destructuredNames.length).toBeGreaterThan(0)
+    for (const name of destructuredNames) {
+      expect(name in mainHealthLogicModule, `解构符号 "${name}" 不在 main-health-logic.mjs 的真实导出集合里`).toBe(true)
+    }
+  })
+
+  it('SC:upstream-preview 三审 R2 UP3R2-F2 —— 解构清单与独立维护的期望符号集完全一致,任意增删都会变红(而不是只看数量 > 0 的近似空断言;13→12 这类"删一个符号"的真实退化,靠这条锁住)', () => {
+    expect(new Set(destructuredNames)).toEqual(EXPECTED_DESTRUCTURED_NAMES)
+  })
+
+  it('不再本地重新声明已导入的判据函数/常量(防止悄悄退回镜像;覆盖 function 声明与 const/let/var 赋值(含箭头函数)两类形态。三审 R2 UP3R2-F2 修正:遍历的是独立维护的期望符号集而不是从 workflowText 自己解析出的解构清单 —— 否则"把某符号从解构清单删掉再本地重声明"这一真实可执行的退化会让该符号从遍历对象里一起消失,这条锁反而不会去检查它;此前硬编码 5 条正则,只覆盖 function 声明形态,13 个解构符号里有 9 个完全不在名单内,且贴回箭头函数形态的原文能绕过检测(upstream-preview UP3-F3))', () => {
+    for (const name of EXPECTED_DESTRUCTURED_NAMES) {
+      const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+      // 解构语法(`const { NAME, ... } = mainHealthLogic`)里每个名字后面跟的是
+      // `,` 或 `}`,从不是 `=`,故 asAssignment 不会命中解构清单本身,不需要
+      // 额外排除自匹配。
+      const asFunctionDecl = new RegExp(`function\\s+${escaped}\\s*\\(`)
+      const asAssignment = new RegExp(`(?:const|let|var)\\s+${escaped}\\s*=`)
+      expect(workflowText, `"${name}" 疑似以 function 声明形态被重新声明(镜像回归)`).not.toMatch(asFunctionDecl)
+      expect(workflowText, `"${name}" 疑似以 const/let/var 赋值形态(含箭头函数)被重新声明(镜像回归)`).not.toMatch(asAssignment)
+    }
+  })
+})
