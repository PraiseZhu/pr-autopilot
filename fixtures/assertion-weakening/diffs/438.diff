+  const unresolvedSet = new Set(forcedUnparsedLines)
+  residualLines.forEach((line, idx) => {
+    if (markerRe.test(line)) unresolvedSet.add(idx)
+  })
+
+  return { calls, unresolvedLines: [...unresolvedSet].sort((a, b) => a - b) }
+}
+
+export function findRestCalls(lines) {
+  return analyzeRestCalls(lines).calls
+}
+
+// 导出供 checkWorkflowText 与测试直接使用:D1 fail-closed 兜底命中的行号(0-based),
+// 即"引用了 github.rest 覆盖面但解析不出具体调用"的那些行。
+export function findUnresolvedRestReferences(lines) {
+  return analyzeRestCalls(lines).unresolvedLines
+}
+
+function findJobForLine(jobs, lineIdx) {
+  return jobs.find((j) => lineIdx >= j.startLine && lineIdx <= j.endLine) || null
+}
+
+// ── 纯函数:对一次调用求出"缺失的 scope 选项"(空数组 = 已满足) ───────────────
+// 返回值是字符串数组:正常情况下每项是 `scope:level` 形式(供 CLI 拼"需要以下
+// 任一 scope");两种 fail-closed 分支返回单元素诊断文案数组(内容不是
+// scope:level,调用方按数组非空即判违规即可,消息本身供人读)。
+export function missingScopesForCall(call, effectivePermissions) {
+  const rule = SCOPE_RULES[call.resource]
+  if (!rule) return [] // 不在覆盖范围内的 resource,不校验
+  if (rule.methodAllowlist && !rule.methodAllowlist.has(call.method)) return []
+  if (effectivePermissions === 'unparsed') {
+    // permissions 块本身解析失败,不知道真实声明是什么 —— 不借用更宽的外层权限,
+    // 也不误报"缺 XXX scope"(那会让排查者去补一个可能已经声明只是没读出来的
+    // scope)。诊断文案不再只提"缩进或语法"(三审 W2R3-A1:那不是所有 unparsed
+    // 成因的准确描述,如今仍会走到这里的是 tab 缩进 / 缩进不一致 / 无法解析的
+    // 锚点或别名 / flow-map 内无法识别的项)。
+    return ['permissions 块无法解析(存在本解析器不支持的形状,如 tab 缩进、缩进不一致、'
+      + '或无法解析的 YAML 锚点/别名),按 fail-closed 处理,请人工核对该 job/workflow 的实际权限']
+  }
+  const requiredLevel = rule.requiredLevel(call.method)
+  if (requiredLevel === null) {
+    // covered resource(methodAllowlist===null)上出现未收录的方法 —— 不默认当作
+    // read 放行(W2R2-CODEX-F3),也不猜测所需 level,直接报映射缺失。
+    return [`github.rest.${call.resource}.${call.method}() 缺少已知的 scope 映射(未收录方法,fail-closed)—— 请在 check-workflow-permissions.mjs 里补充该方法的 read/write 归类`]
+  }
+  const anyOf = rule.anyOfScopes(call.method)
+  const satisfied = anyOf.some(
+    (scope) => levelSatisfies(requiredLevel, resolveDeclaredLevel(effectivePermissions, scope)),
+  )
+  return satisfied ? [] : anyOf.map((scope) => `${scope}:${requiredLevel}`)
+}
+
+// ── 纯函数:核对一份 workflow 文件全文,返回违规列表 ───────────────────────────
+export function checkWorkflowText(filePath, text) {
+  const { lines, topPermissions, jobs } = parseWorkflow(text)
+  // 域分离(见文件头"域边界"说明):只在 findScriptBlocks 探测到的 block scalar
+  // 区间内跑 analyzeRestCalls,YAML 结构区域完全不进扫描面。每个区间独立分析,
+  // 别名作用域天然按区间(即按 step)隔离,再把区间内的相对行号换算回文件绝对
+  // 行号。
+  const blocks = findScriptBlocks(lines)
+  const calls = []
+  const unresolvedLines = []
+  for (const block of blocks) {
+    if (block.endLine < block.startLine) continue // 空块
+    const blockLines = lines.slice(block.startLine, block.endLine + 1)
+    const result = analyzeRestCalls(blockLines)
+    for (const call of result.calls) calls.push({ ...call, line: call.line + block.startLine })
+    for (const lineIdx of result.unresolvedLines) unresolvedLines.push(lineIdx + block.startLine)
+  }
+
+  const violations = []
+  for (const call of calls) {
+    const job = findJobForLine(jobs, call.line)
+    const effective = job ? job.permissions : topPermissions
+    const missing = missingScopesForCall(call, effective)
+    if (missing.length) {
+      violations.push({
+        file: filePath,
+        line: call.line + 1,
+        resource: call.resource,
+        method: call.method,
+        job: job ? job.name : null,
+        anyOf: missing,
+      })
+    }
+  }
+  // D1 fail-closed 兜底:这些行确实碰了 github.rest 覆盖面(或其别名/解构产物),
+  // 但解析不出具体 resource.method,不知道该核对哪个 scope —— 无论该 job/workflow
+  // 声明了多宽的权限都判违规(与 permissions 块 'unparsed' 同一处理原则:不猜测,
+  // 不因为"declared 很宽"就假装已核对过)。
+  for (const lineIdx of unresolvedLines) {
+    const job = findJobForLine(jobs, lineIdx)
+    violations.push({
+      file: filePath,
+      line: lineIdx + 1,
+      resource: null,
+      method: null,
+      job: job ? job.name : null,
+      anyOf: ['该行引用了 github.rest 覆盖面(或其别名/解构产物),但本解析器解析不出具体的 '
+        + 'resource.method 调用(如 Reflect.get 间接取值、把 resource 对象整体当参数透传、'
+        + '赋给对象属性、真正插值拼接的计算 key 等)—— 按 fail-closed 处理,不假设零信号等于'
+        + '零调用,请人工核对该处实际访问的 REST 端点与所需 scope'],
+    })
+  }
+  return violations
+}
+
+// ── CLI 主流程 ────────────────────────────────────────────────────────────
+function main() {
+  let files
+  try {
+    files = readdirSync(WORKFLOWS_DIR)
+      .filter((f) => f.endsWith('.yml') || f.endsWith('.yaml'))
+      .sort()
+      .map((f) => join(WORKFLOWS_DIR, f))
+  } catch (e) {
+    console.error(`[workflow-permissions] 扫描 ${WORKFLOWS_DIR} 失败:${e.message}`)
+    process.exit(2)
+  }
+  if (files.length === 0) {
+    console.error(`[workflow-permissions] ${WORKFLOWS_DIR} 未找到任何 workflow 文件,fail-closed。`)
+    process.exit(2)
+  }
+
+  const allViolations = []
+  for (const f of files) {
+    let text
+    try {
+      text = readFileSync(f, 'utf8')
+    } catch (e) {
+      console.error(`[workflow-permissions] 读取失败即 fail-closed:${f}:${e.message}`)
+      process.exit(2)
+    }
+    allViolations.push(...checkWorkflowText(f, text))
+  }
+
+  if (allViolations.length === 0) {
+    console.log(`[workflow-permissions] OK:${files.length} 个 workflow 文件的 github.rest.* 调用均在声明的 permissions 范围内`)
+    process.exit(0)
+  }
+
+  console.error(`[workflow-permissions] 发现 ${allViolations.length} 处 permissions 缺口:\n`)
+  for (const v of allViolations) {
+    // resource===null:D1 fail-closed 兜底(引用了 github.rest 覆盖面但解析不出具体
+    // 调用),anyOf 本身就是可读诊断文案,不再拼 "github.rest.null.null()" 这种误导前缀。
+    const detail = v.resource
+      ? `github.rest.${v.resource}.${v.method}() 需要以下任一 scope:${v.anyOf.join(' 或 ')}`
+      : v.anyOf.join(' 或 ')
+    console.error(`  ${v.file}:${v.line} [${v.job ? 'job=' + v.job : 'workflow 级'}] ${detail}`)
+  }
+  console.error(`
+修法:在该调用生效的 permissions 块(job 级若已声明会完全替换 workflow 级,否则改
+workflow 级)里补上列出的 scope 之一,只补只读面即可(本守卫要求的都是 read,除非
+提示要求 write)。`)
+  process.exit(1)
+}
+
+const isCliEntry = () => {
+  if (!process.argv[1]) return false
+  try {
+    return realpathSync(fileURLToPath(import.meta.url)) === realpathSync(resolve(process.argv[1]))
+  } catch {
+    return false
+  }
+}
+if (isCliEntry()) {
+  main()
+}
