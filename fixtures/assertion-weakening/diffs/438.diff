+// scripts/ci/main-health-logic.mjs — .github/workflows/main-health.yml 判据逻辑的
+// 单一实现源(PR-w2 二轮盲审 W2R2-C1 / CODEX-F2 / UP2-S4 共识:此前是"手工镜像",
+// 测试只测本文件,生产执行的是 workflow 内联脚本里另一份手写实现,两者靠注释
+// 承诺同步 —— 反向变异证明"改坏内联脚本,71 条用例不会有一条变红",镜像漂移面
+// 是零信号)。
+//
+// main-health.yml 现在新增一次只读 checkout(persist-credentials:false,见该文件
+// 文件头「已知边界」②的更新说明),github-script 步骤里用
+// `await import(process.env.GITHUB_WORKSPACE + '/scripts/ci/main-health-logic.mjs')`
+// 直接消费本文件 —— 测试断言的就是生产实际执行的函数,不再是一份需要手工保持
+// 同步的复述。workflow 侧只保留必须发起网络调用的部分(github.rest.* 调用本身、
+// 以及把调用结果喂给下方纯函数),纯判据/解析/格式化逻辑一律从本文件导入,
+// 不再本地重复定义。
+//
+// 覆盖范围:分档(SC2.1 强/弱措辞 + greenref 强制阻断)、关闭判据(SC2.2 真重跑 /
+// 空转 / 重名 step 聚合,W2R2-CODEX-F1 撤回后为 fail-closed:仅 conclusion===success
+// 才算已重跑,全部 skipped 不再视为已解决)、REQUIRED_ON_MAIN 解析(锚定唯一活动
+// 声明 + exact 语法校验,不接受"部分解析成功")、marker 形状校验、attempt 绑定
+// 参数、可见 label 转义(按完整 code span pair 边界截断)、空转评论节流(扫最近
+// N 条评论)。均为纯函数,不发起任何网络调用。
+
+// ── SC3:greenref 推进器角色不看名单命中,固定阻断 ───────────────────────────
+export const GREEN_REF_WORKFLOW_NAME = 'deploy green ref'
+
+// requiredOnMain: string[] | null(null = 名单未知,读取/解析失败)
+// blockingNotGreen: string[] | null(null = 未查询或查询失败;[] = 全绿)
+export function selectBlockingMode({ wfName, requiredOnMain, blockingNotGreen }) {
+  if (wfName === GREEN_REF_WORKFLOW_NAME) return 'greenref-forced'
+  if (requiredOnMain === null || blockingNotGreen === null) return 'strong'
+  return blockingNotGreen.length > 0 ? 'strong' : 'weak'
+}
+
+export function isBlockingMode(mode) {
+  return mode !== 'weak'
+}
+
+// ── SC5:REQUIRED_ON_MAIN 解析,锚定行首(允许前导空白)非注释的唯一 const 声明 ──
+const REQUIRED_ON_MAIN_OPEN_RE = /^[ \t]*const\s+REQUIRED_ON_MAIN\s*=\s*\[/gm
+const REQUIRED_ON_MAIN_STRING_RE = /'((?:[^'\\]|\\.)*)'/g
+
+// 从 `[` 的下一个字符开始扫描,跳过合法单引号字符串内部的字符(含转义 \' 与 ]),
+// 找到与之匹配的顶层 `]`。避免"字符串里出现 ] 就把数组截断"(W2R2-CODEX-F5)。
+// 返回该 `]` 的下标;未找到(声明不完整/缺闭合括号)返回 -1。
+function findMatchingBracket(text, openIdx) {
+  let i = openIdx + 1
+  while (i < text.length) {
+    const c = text[i]
+    if (c === ']') return i
+    if (c === "'") {
+      i += 1
+      while (i < text.length && text[i] !== "'") {
+        if (text[i] === '\\') i += 1
+        i += 1
+      }
+      i += 1
+      continue
+    }
+    i += 1
+  }
+  return -1
+}
+
+// 返回 { ok: true, names: string[] } | { ok: false, reason: string }
+export function parseRequiredOnMain(ymlText) {
+  const candidates = []
+  let m
+  REQUIRED_ON_MAIN_OPEN_RE.lastIndex = 0
+  while ((m = REQUIRED_ON_MAIN_OPEN_RE.exec(ymlText))) {
+    const openIdx = m.index + m[0].length - 1 // 指向声明自己的 `[`
+    const closeIdx = findMatchingBracket(ymlText, openIdx)
+    if (closeIdx === -1) continue // 声明不完整(缺闭合 ]),不算有效候选
+    candidates.push(ymlText.slice(openIdx + 1, closeIdx))
+  }
+  if (candidates.length !== 1) {
+    return {
+      ok: false,
+      reason: candidates.length === 0 ? 'no-declaration-found' : 'multiple-candidates',
+    }
+  }
+  const body = candidates[0]
+  const names = [...body.matchAll(REQUIRED_ON_MAIN_STRING_RE)].map((x) => x[1].replace(/\\'/g, "'"))
+  // exact 消费校验(W2R2-CODEX-F5):把全部识别出的单引号字符串从正文里挖掉,残留部分
+  // 必须只剩空白与逗号 —— 任何未消费的 token(双引号字符串、裸标识符、表达式等)
+  // 都说明数组正文没被完全理解,不能只返回认出来的那一部分名字("部分解析成功"
+  // 会让真正阻断的红灯被静默漏掉)。
+  const residual = body.replace(REQUIRED_ON_MAIN_STRING_RE, '')
+  if (!/^[\s,]*$/.test(residual)) {
+    return { ok: false, reason: 'unrecognized-token' }
+  }
+  if (!names.length) return { ok: false, reason: 'empty-list' }
+  return { ok: true, names }
+}
+
+// ── SC6①②:同名 step 聚合 + 失败路径专属 step 判据 ──────────────────────────
+// jobs: actions.listJobsForWorkflowRunAttempt 返回的 data.jobs 形状(数组,每项含
+// name 与 steps[]),返回 Map<string(JSON [jobName,stepName]), Set<conclusion>>。
+export function aggregateStepConclusions(jobs) {
+  const map = new Map()
+  for (const j of jobs || []) {
+    for (const s of j.steps || []) {
+      const key = JSON.stringify([j.name, s.name])
+      if (!map.has(key)) map.set(key, new Set())
+      map.get(key).add(s.conclusion)
+    }
+  }
+  return map
+}
+
+export const FAILED_STEP_CONCLUSIONS = new Set(['failure', 'timed_out'])
+
+// 从聚合后的 stepMap 提取"本次失败的 (job, step) 对"列表(RED 侧记录用)。
+// 同名 step 任一为 failure/timed_out 即计入(不再是后者覆盖前者)。
+export function computeFailedSteps(stepMap) {
+  const failed = []
+  for (const [key, conclusions] of stepMap) {
+    if ([...conclusions].some((c) => FAILED_STEP_CONCLUSIONS.has(c))) failed.push(JSON.parse(key))
+  }
+  return failed
+}
+
+// 某个 (job, step) key 在本次 run 是否可判定为"已解决"(fail-closed,W2R2-CODEX-F1
+// 撤回了此前"全部 skipped 视为已解决"的宽松判据):
+//   - 无记录(本次没跑到)→ 未解决;
+//   - 本次仍含失败 → 未解决;
+//   - 任一记录为 success → 已解决(真的重跑并通过);
+//   - 其余情况(含"全部 skipped")→ 未解决。
+// 为什么撤回:API 只给出 step 的 conclusion,不提供"这个 step 是否只在 if:failure()
+// 失败路径下才运行"的语义。之前的版本把任意"全部 skipped"都当"失败路径这次没
+// 触发",但同一个 skipped 也可能是"这次本该重跑却被跳过"(例如 Daily Changelog
+// 当天无新 PR、publish 步骤被跳过、run 仍以 success 收场)——这正是本 PR 最初要拦的
+// 空转假关闭,若不区分会原样复现。已知局限(不藏):只在失败路径运行的 step(如
+// `if: failure()`)在绿灯 run 里必然是 skipped,现在会被判"未重跑",Issue 会保持
+// open、需要人工关闭一次 —— 宁可偶尔需要人工关,不可假关闭。
+export function isStepResolved(conclusions) {
+  if (!conclusions || conclusions.size === 0) return false
+  if ([...conclusions].some((c) => FAILED_STEP_CONCLUSIONS.has(c))) return false
+  return conclusions.has('success')
+}
+
+// 空转判据:recordedPairs 中仍未解决的那些,即"视为空转、不关闭"的依据。
+export function computeNotRerunPairs(recordedPairs, currentStepMap) {
+  return recordedPairs.filter((pair) => !isStepResolved(currentStepMap.get(JSON.stringify(pair))))
+}
+
+// ── SC8:failedsteps marker 解码后的形状校验 ────────────────────────────────
+// parsed: JSON.parse 的结果(任意值)。合法形状 = 二维字符串数组(每项长度 2)。
+export function validateFailedStepsShape(parsed) {
+  const isPair = (p) => Array.isArray(p) && p.length === 2 && typeof p[0] === 'string' && typeof p[1] === 'string'
+  if (!Array.isArray(parsed) || !parsed.every(isPair)) return null
+  return parsed
+}
+
+// ── SC4:attempt 绑定 —— 从触发事件自己的 payload 派生查询参数,不依赖全局/共享状态 ──
+// run: workflow_run payload(或其子集 { id, run_attempt })。
+export function buildJobsForAttemptParams(run) {
+  return { run_id: run.id, attempt_number: run.run_attempt || 1 }
+}
+
+// ── SC9:可见 step 名转义 + 截断 ────────────────────────────────────────────
+export function escapeStepLabelPart(s) {
+  return String(s)
+    .replace(/`/g, 'ˋ')
+    .replace(/[\r\n]+/g, ' ')
+    .replace(/@/g, '@' + String.fromCharCode(0x200b))
+    .slice(0, 80)
+}
+
+export const MAX_STEP_LABEL_TOTAL = 400
+
+// 按完整 pair 边界累加到预算,超出时在上一个完整 pair 处截断(upstream-preview
+// UP2-S2:此前按字符 slice 整串,可能停在某个 `...` code span 中间,留下奇数个
+// 反引号,CommonMark 下未配对反引号不会闭合 span,后半段渲染错乱)。
+export function buildStepLabel(pairs) {
+  const parts = pairs.map((p) => '`' + escapeStepLabelPart(p[0]) + ' / ' + escapeStepLabelPart(p[1]) + '`')
+  let out = ''
+  for (const part of parts) {
+    const next = out ? out + '、' + part : part
+    if (next.length > MAX_STEP_LABEL_TOTAL) return out + '…(其余步骤名已截断)'
+    out = next
+  }
+  return out
+}
+
+// ── SC10:空转说明评论节流 ──────────────────────────────────────────────────
+export const IDLE_COMMENT_PREFIX = '⏭ 本次 success 未重跑上次失败的步骤'
+
+export function isLastCommentIdleNotice(lastCommentBody) {
+  return typeof lastCommentBody === 'string' && lastCommentBody.startsWith(IDLE_COMMENT_PREFIX)
+}
+
+// upstream-preview UP2-S3:只看最后一条评论会被任何插入的其它评论(RED"又一次
+// 失败"、陈旧 RED/GREEN 的留痕评论)清空节流状态 —— 这些插入在本 workflow 自己
+// 的行为里就会发生(红灯期间"空转→失败→空转→失败"交替)。改为扫最近 N 条,
+// 命中任一条即视为"已节流",不再逐次重复追加。
+export const IDLE_COMMENT_LOOKBACK = 20
+
+export function hasRecentIdleNotice(commentBodies, lookback = IDLE_COMMENT_LOOKBACK) {
+  return commentBodies.slice(-lookback).some((b) => isLastCommentIdleNotice(b))
+}
+
+// ── run 执行序(number, attempt)陈旧性比较,跨 workflow identity 不比较 ────────
+// recorded/seq: { wfId, number, attempt }。返回 { stale: boolean, identityMismatch: boolean }。
+export function compareRunSeq(recorded, seq) {
+  if (!recorded) return { stale: false, identityMismatch: false }
+  if (recorded.wfId !== seq.wfId) return { stale: false, identityMismatch: true }
+  const stale = seq.number !== recorded.number
+    ? seq.number < recorded.number
+    : seq.attempt < recorded.attempt
+  return { stale, identityMismatch: false }
+}
