+    for (let i = 0; i < 5; i += 1) bodies.push('🔴 又一次失败:`CI` @ `sha' + i + '`(failure)—— url' + i)
+    expect(hasRecentIdleNotice(bodies, 3)).toBe(false)
+    expect(hasRecentIdleNotice(bodies, 10)).toBe(true)
+  })
+
+  it('SC12:完全没有空转说明时返回 false', () => {
+    expect(hasRecentIdleNotice(['✅ 已恢复:`CI`', '🔴 又一次失败:`CI`'])).toBe(false)
+  })
+})
