+describe('compareRunSeq(执行序陈旧性比较,支撑 attempt 不串味的另一半;参数为 (recorded, seq) —— recorded 是 Issue 上已记录的执行序,seq 是本次事件的执行序,返回值描述"本次事件是否比已记录的更旧")', () => {
+  it('无记录(人工建 Issue)→ 不判陈旧', () => {
+    expect(compareRunSeq(null, { wfId: 1, number: 5, attempt: 1 })).toEqual({ stale: false, identityMismatch: false })
+  })
+
+  it('相同 identity,本次事件的 number 比已记录的更小 → 本次是陈旧的迟到事件', () => {
+    const r = compareRunSeq({ wfId: 1, number: 5, attempt: 1 }, { wfId: 1, number: 3, attempt: 1 })
+    expect(r).toEqual({ stale: true, identityMismatch: false })
+  })
+
+  it('相同 identity,本次事件的 number 更大 → 不陈旧(正常推进)', () => {
+    const r = compareRunSeq({ wfId: 1, number: 3, attempt: 1 }, { wfId: 1, number: 5, attempt: 1 })
+    expect(r).toEqual({ stale: false, identityMismatch: false })
+  })
+
+  it('相同 identity、同 number,本次事件的 attempt 比已记录的更小 → 陈旧(rerun 场景,attempt 不串味的关键判据)', () => {
+    const r = compareRunSeq({ wfId: 1, number: 5, attempt: 3 }, { wfId: 1, number: 5, attempt: 1 })
+    expect(r.stale).toBe(true)
+  })
+
+  it('相同 identity、同 number,本次事件的 attempt 更大 → 不陈旧', () => {
+    const r = compareRunSeq({ wfId: 1, number: 5, attempt: 1 }, { wfId: 1, number: 5, attempt: 3 })
+    expect(r.stale).toBe(false)
+  })
+
+  it('workflow identity 不同 → 不做数值比较,标记 identityMismatch', () => {
+    const r = compareRunSeq({ wfId: 1, number: 999, attempt: 1 }, { wfId: 2, number: 1, attempt: 1 })
+    expect(r).toEqual({ stale: false, identityMismatch: true })
+  })
+})
