+    expect(r1.status).toBe('consumed')
+    expect(r1.newClusters).toBe(1)
+    const countAfter1 = state.clusters[fp('idem1')].count
+
+    const r2 = consumeSentryFindings(state, { findingsDir: dir, dateStr, rules: RULES })
+    expect(r2.status).toBe('consumed')
+    expect(r2.newFindings).toBe(0)
+    expect(r2.newClusters).toBe(0)
+    expect(state.clusters[fp('idem1')].count).toBe(countAfter1)
+  })
+
+  it('新日期同 fp 晚于 fixedAt → recurrent(复用批次1机制)', () => {
+    const state = defaultState(FINGERPRINT_VERSION)
+    state.clusters[fp('recur1')] = {
+      source: 'Trae audit', pattern: 'x', sLevel: 'S1', tCap: 'T1', count: 1,
+      clients: [], firstSeen: '2026-07-01T00:00:00.000Z', lastSeen: '2026-07-01T00:00:00.000Z',
+      appVersions: [], status: 'fixed', fixedAt: '2026-07-01T00:00:00.000Z', attempts: 1,
