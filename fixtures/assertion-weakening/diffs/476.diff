+import { mkdtempSync, rmSync, writeFileSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import {
+  SENTRY_ORIGIN,
+  consumeSentryFindings,
+  findingsFilePath,
+} from './sentry-intake.mjs'
+import { defaultState } from './state.mjs'
+import { FINGERPRINT_VERSION } from './fingerprint.mjs'
+
+// 本文件是核心消费面用例(PR 分段 2a):复发 fail-closed / 幂等 / missing-degraded
+// 台账。sentryIntake 节持久化往返、分拣路由 / T1 预筛 / mark-fixed / 输入安全 /
+// CLI 端到端在紧随的分段 2b 补齐(同一测试文件原位扩展)。
+const RULES = JSON.parse(
+  // rules.json 与本文件同目录;不复制常量,测试永远用真实配置跑
+  (await import('node:fs')).readFileSync(new URL('./rules.json', import.meta.url), 'utf8'),
+)
+
+let dir // findings dir
+let stateDir
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'sentry-findings-'))
+  stateDir = mkdtempSync(join(tmpdir(), 'bug-doctor-state-'))
+})
+
+afterEach(() => {
+  rmSync(dir, { recursive: true, force: true })
+  rmSync(stateDir, { recursive: true, force: true })
+})
+
+// 16 位 hex 指纹(Sentry 侧已算好,测试用确定性 hash 造合法值,不是脚本自己算指纹)
+const fp = (seed) => createHash('sha256').update(seed).digest('hex').slice(0, 16)
+
+const finding = (over = {}) => ({
+  severity: 'P1',
+  dim: 'log-violation',
+  file: 'src/app/Foo.tsx',
+  line: 10,
+  category: 'missing-debug-log',
+  evidence: 'no debugLogger call on success path',
+  verify: '不可信复现提示:需人工核实',
+  fingerprint: fp('aaaa'),
+  ...over,
+})
+
+const writeFindings = (dateStr, items) => {
+  writeFileSync(findingsFilePath(dir, dateStr), JSON.stringify(items))
+}
+
+describe('SC-B2-1 sentry-intake 消费(幂等 + missing/degraded 台账)', () => {
+  it('同一未变文件二跑:newFindings=0/newClusters=0,cluster count 不变', () => {
+    const dateStr = '2026-08-02'
