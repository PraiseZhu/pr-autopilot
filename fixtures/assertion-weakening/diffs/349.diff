+describe('#320 同一根卡的并发首次点击(会话认领窗口,跟进项 4)', () => {
+  it('同一会话两次几乎同时首次点击同一张未绑定的根卡 → 恰好一次进入生成,另一次收到 ACTION_BUSY', async () => {
+    const booted = boot({ locale: 'zh-CN' })
+    await seedRootRecord(booted)
+    // 基线:种根记录本身也会发一次 generate 请求(callId=根卡自己的 callId),
+    // 与下面两次点击的请求是两件事——必须扣掉基线,否则"只有一次生成"这条断言
+    // 永远因为把种子请求也算进去而假绿/假红。
+    const before = generationRequests(booted).length
+
+    // 先发起、不 await——两次调用几乎同时到达,`settle()` 之后才收口(先 await
+    // 会在假时钟推进之前就去等一个需要推进才能兑现的 promise,永远等不到)。
+    const pending = [
+      booted.brain.handles.handleCardAction({
+        type: 'card-action',
+        actionId: 'regen',
+        callId: ROOT_CALL_ID,
+        spawnCallId: 'spawn-claim-a',
+        sessionId: 'session-A',
+      }),
+      booted.brain.handles.handleCardAction({
+        type: 'card-action',
+        actionId: 'regen',
+        callId: ROOT_CALL_ID,
+        spawnCallId: 'spawn-claim-b',
+        sessionId: 'session-A',
+      }),
+    ]
+    await booted.settle()
+    await Promise.all(pending)
+
+    // 核心断言:这两次点击真正促成的生成请求只有一个,不是两个——如果判定与登记
+    // 之间的窗口没堵住,两次首次点击都会各自读到"0 个在途"通过判定,各自派一次生成。
+    expect(generationRequests(booted).length - before).toBe(1)
+
+    const doneA = lastDoneFor(booted, 'spawn-claim-a')
+    const doneB = lastDoneFor(booted, 'spawn-claim-b')
+    const outcomes = [doneA, doneB].map((card) => (card?.html?.includes('上一张还在生成') ? 'busy' : 'settled'))
+    // 恰好一个 busy、一个正常终态(成功卡的具体文案由生成结果决定,这里只关心
+    // "没有被 ACTION_BUSY 拒绝",生成结果本身已由其余用例覆盖)。
+    expect(outcomes.filter((outcome) => outcome === 'busy')).toHaveLength(1)
+    expect(outcomes.filter((outcome) => outcome === 'settled')).toHaveLength(1)
+  })
+
+  it('登记时序:输家的 ACTION_BUSY 在赢家生成仍悬挂时就已经落地(不等赢家结束),且此刻在途恰为 1', async () => {
+    // 面板脚本可切换:种根记录这一步要能正常结束(否则拿不到可用的记录),
+    // 只有下面两次点击触发的生成才需要悬挂在面板身上——用一个可重新赋值的引用
+    // 而不是固定脚本,种子阶段与测试阶段各自要的行为不是同一件事。
+    let script = readyPanel()
+    const booted = boot({ locale: 'zh-CN', panel: (request) => script(request) })
+    await seedRootRecord(booted)
+    const before = generationRequests(booted).length
+    script = () => 'never' // 从这里开始,任何 generate 请求永不应答。
+
+    const first = booted.brain.handles.handleCardAction({
+      type: 'card-action',
+      actionId: 'regen',
+      callId: ROOT_CALL_ID,
+      spawnCallId: 'spawn-order-a',
+      sessionId: 'session-A',
+    })
+    const second = booted.brain.handles.handleCardAction({
+      type: 'card-action',
+      actionId: 'regen',
+      callId: ROOT_CALL_ID,
+      spawnCallId: 'spawn-order-b',
+      sessionId: 'session-A',
+    })
+
+    // 按状态收口,不猜固定 flush 次数:等到"赢家已经把生成请求发出去、输家已经拿到
+    // 终态卡"这个状态同时成立——单看 inflightCount()===1 会在赢家登记完但还没真正
+    // 发出生成请求那一刻就提前成立,断言"已经发出一次生成"会撞上还没发生的状态。
+    const busyCardOf = (spawnCallId: string) => Boolean(lastDoneFor(booted, spawnCallId)?.html?.includes('上一张还在生成'))
+    await flushUntil(
+      () => generationRequests(booted).length - before === 1 && (busyCardOf('spawn-order-a') || busyCardOf('spawn-order-b')),
+      { label: '赢家已发出生成请求且输家已拿到 ACTION_BUSY 终态卡(都不需要等赢家悬挂的那一路结束)' },
+    )
+
+    // 此刻:恰好一次生成请求已经发出(赢家),输家已经拿到 ACTION_BUSY 的终态卡——
+    // 都不需要等赢家(悬挂在 'never' 上)结束;且此刻在途表恰好 1 条(赢家的登记)。
+    expect(generationRequests(booted).length - before).toBe(1)
+    expect(booted.brain.handles.cardAction.inflightCount()).toBe(1)
+    const doneA = lastDoneFor(booted, 'spawn-order-a')
+    const doneB = lastDoneFor(booted, 'spawn-order-b')
+    const busyCards = [doneA, doneB].filter((card) => card?.html?.includes('上一张还在生成'))
+    expect(busyCards).toHaveLength(1)
