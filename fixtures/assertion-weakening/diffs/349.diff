+const EXPORT_NAME_LEDGER_PATH = 'export/used-default-names.json'
+const EXPORT_NAME_LEDGER_MAX = 512
+
+/**
+ * 读台账,收敛成两档:
+ *   {names, corrupt:false} —— 台账不存在(当空台账)或读出且结构合法
+ *   {names:[], corrupt:true} —— 读出了内容但解析/结构不合法(触发方案 B 兜底)
+ */
+async function exportReadNameLedger() {
+  const text = await fsRead(EXPORT_NAME_LEDGER_PATH)
+  if (text === null) return { names: [], corrupt: false }
+  let parsed
+  try {
+    parsed = JSON.parse(text)
+  } catch {
+    return { names: [], corrupt: true }
+  }
+  if (!parsed || typeof parsed !== 'object' || !Array.isArray(parsed.names) || !parsed.names.every((name) => typeof name === 'string')) {
+    return { names: [], corrupt: true }
+  }
+  return { names: parsed.names, corrupt: false }
+}
+
+/** 追加一条并按①有界原则淘汰最旧;写回失败只 diag 留痕,不阻断本次导出。 */
+async function exportRecordDefaultName(existingNames, finalName) {
+  const names = existingNames.concat([finalName])
+  while (names.length > EXPORT_NAME_LEDGER_MAX) names.shift() // FIFO 淘汰最旧
+  const ok = await fsWrite(EXPORT_NAME_LEDGER_PATH, JSON.stringify({ names }))
+  if (!ok) {
+    diagSkip(
+      DIAG_SOURCE.tool,
+      'export 缺省名台账写回失败: 本次导出不受影响,但下次面板重载可能不知道 "' + finalName + '" 已被使用',
+    )
+  }
+  return ok
+}
+
+/**
+ * 从候选缺省名(面板算出的 `mivo-canvas-<timestamp>.<ext>`)决定最终落盘名。
+ *
+ * - 台账可用且候选名已在台账里 → 确定性递增后缀(`-1`/`-2`……),逐个探台账直到
+ *   找到台账里没记过的名字(与面板侧 Map 的递增惯例一致,只是探测源换成跨重载
+ *   持久的台账)。
+ * - 台账不可用(见 exportReadNameLedger 的 corrupt 档)→ 方案 B:候选名直接加短
+ *   随机串(概率性避撞,没有可信的"已用列表"可供确定性递增探测)。
+ */
+async function exportPickDefaultName(candidateName) {
+  const ledger = await exportReadNameLedger()
+  const dot = candidateName.lastIndexOf('.')
+  const base = dot > 0 ? candidateName.slice(0, dot) : candidateName
+  const ext = dot > 0 ? candidateName.slice(dot) : ''
+
+  if (ledger.corrupt) {
+    diagSkip(
+      DIAG_SOURCE.tool,
+      'export 缺省名台账不可读或结构损坏,按方案 B 兜底: "' + candidateName + '" 追加随机串避撞,并尝试重建台账',
+    )
+    const finalName = base + '-' + Math.random().toString(36).slice(2, 8) + ext
+    await exportRecordDefaultName([], finalName) // 重建:台账只含这一条,后续导出重新开始累积
+    return finalName
+  }
+
+  if (!ledger.names.includes(candidateName)) {
+    await exportRecordDefaultName(ledger.names, candidateName)
+    return candidateName
+  }
+  let n = 1
+  let finalName = base + '-' + n + ext
+  while (ledger.names.includes(finalName)) {
+    n += 1
+    finalName = base + '-' + n + ext
+  }
+  await exportRecordDefaultName(ledger.names, finalName)
+  return finalName
+}
