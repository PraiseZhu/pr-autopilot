+  # ── cindyplugin 构建门禁(2026-08-01 门禁收尾,阻断)──────────────────────────
+  # 痛点:cindyplugin/ 是插件交付物,版本高频迭代(ghost.json 0.7.x→0.8.x 连跳),但
+  # CI 此前对它**零覆盖** —— build.sh 全靠开发者本地自觉。本 job 把「manifest 是
+  # 合法 JSON 且关键字段在 + 插件 bundle 能构建 + 产物形状与运行时引用完整」变成
+  # 每 PR 阻断项。
+  # 边界诚实声明(2026-08-01 gpt-5.6-sol 审查 P2 修正):本 gate 覆盖**构建可行性 +
+  # manifest 浅层格式 + 产物引用完整性**三层;#347 那类宿主 pack 期深校验失败
+  # (未知能力键、字段长度超限等 schema 语义)它拦不住 —— 深层校验的单一真相源是
+  # 宿主 ghost_forge_pack,CI 侧维护宿主键集副本只会造名单漂移病,有意不做。
+  # 阻断语义:失败即 job 红;注册为 required check 后挡合并(照 pg-suite 先例,
+  # ruleset/经典保护为 PR 外 lead 动作)。同 PR 已把本 check 名同步进
+  # deploy-green-ref REQUIRED_ON_MAIN 与 watchdog 两处名单 —— 三处必须一起改。
+  cindyplugin-build:
+    name: cindyplugin build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+
+      - name: Setup Node (LTS)
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: lts/*
+          cache: npm
+
+      - name: Install dependencies
+        run: npm ci
+
+      # manifest 基本面:合法 JSON + 打包最低要求字段(id/version/entry/name/icon)。
+      # version 必须是 x.y.z 数字三段 —— cardManifest.test.ts 的「版本严格递增」
+      # 守的是跨 commit 语义,这里守的是「单点格式合法」,两层互补。
+      # entry/icon 约束为包内相对路径(拒绝绝对路径/`..`):它们随后作为 dist 校验的
+      # 依据 —— manifest 指哪,产物就必须有哪(2026-08-01 返修:此前 sanity 与 dist
+      # 校验彼此脱钩,entry 改成 missing.js 时两步都绿,宿主装入才翻车)。
+      - name: Manifest sanity (ghost.json)
+        run: |
+          node -e "
+            const m = JSON.parse(require('fs').readFileSync('cindyplugin/ghost.json', 'utf8'));
+            for (const k of ['id', 'version', 'entry', 'name']) {
+              if (!m[k] || typeof m[k] !== 'string') throw new Error('ghost.json 缺少或非法字段: ' + k);
+            }
+            if (!/^\d+\.\d+\.\d+$/.test(m.version)) throw new Error('ghost.json version 非 x.y.z 格式: ' + m.version);
+            for (const k of ['entry', 'icon']) {
+              const v = m[k];
+              if (k === 'icon' && v === undefined) continue; // icon 可选:缺省只允许 undefined
+              // 空串也拒绝(第二轮审查:icon:'' 曾同时绕过这里和 dist 校验的 falsy 判断)
+              if (typeof v !== 'string' || v === '' || v.startsWith('/') || v.split('/').includes('..')) {
+                throw new Error('ghost.json ' + k + ' 必须是非空包内相对路径(无绝对/..): ' + JSON.stringify(v));
+              }
+            }
+            console.log('ghost.json OK: id=' + m.id + ' version=' + m.version + ' entry=' + m.entry + ' icon=' + (m.icon || '(无)'));
+          "
+
+      - name: Build plugin bundle (cindyplugin/build.sh)
+        run: bash cindyplugin/build.sh
+
+      # 产物完整性(2026-08-01 返修加强):
+      #   1. manifest 引用完整性:dist/<entry>、dist/<icon> 按 ghost.json 实际值校验
+      #      非空普通文件,不硬编码 main.js;
+      #   2. Vite 核心产物:panel.html 非空 + assets/ 非空,并解析 panel.html 里的
+      #      相对 script/style 引用逐一验存在(vite input/output 漂移时立刻红);
+      #   3. 运行时引用资产:从源码 grep 实际引用的 /stickers/*.svg 与 /demo-assets/*
+      #      字面路径,逐个对 dist 验非空 —— 清单自维护,删任一被引用文件即红
+      #      (此前只验目录存在,空目录/缺单个印章都能溜过去,运行时 404)。
+      - name: Verify dist shape & referenced assets
+        run: |
+          set -e
+          node -e "
+            const fs = require('fs');
+            const m = JSON.parse(fs.readFileSync('cindyplugin/ghost.json', 'utf8'));
+            const mustFile = (p, why) => {
+              const st = fs.existsSync(p) && fs.statSync(p);
+              if (!st || !st.isFile() || st.size === 0) throw new Error('dist 缺少或为空: ' + p + '(' + why + ')');
+            };
+            const path = require('path');
+            const distRoot = path.resolve('cindyplugin/dist');
+            mustFile('cindyplugin/dist/' + m.entry, 'manifest entry');
+            // icon 与 sanity 步同语义:undefined=缺省,存在必须非空(falsy 判断会被 '' 绕过)
+            if (m.icon !== undefined) mustFile('cindyplugin/dist/' + m.icon, 'manifest icon');
+            mustFile('cindyplugin/dist/ghost.json', 'manifest 本体');
+            mustFile('cindyplugin/dist/panel.html', 'vite 面板入口');
+            const assets = fs.existsSync('cindyplugin/dist/assets') ? fs.readdirSync('cindyplugin/dist/assets') : [];
+            if (!assets.length) throw new Error('dist/assets 缺失或为空(vite 产物布局漂移?)');
+            // panel.html 的相对引用逐一验存在(忽略 http(s)/data/协议相对)。
+            // containment(第二轮审查 P1):resolve 后必须仍在 dist 根内 —— ../ghost.json
+            // 这类上跳引用会命中仓内同名文件而假绿,但打进包里的 dist 并没有它,
+            // 宿主加载即 404。(本注释不用反引号:整段在 shell 双引号串里,反引号=命令替换)
+            const html = fs.readFileSync('cindyplugin/dist/panel.html', 'utf8');
+            const refs = [...html.matchAll(/(?:src|href)=\"([^\"]+)\"/g)].map((x) => x[1])
+              .filter((u) => !/^(?:https?:|data:|\/\/)/.test(u));
+            for (const u of refs) {
+              const rel = u.split(/[?#]/)[0].replace(/^\.?\//, '');
+              const abs = path.resolve(distRoot, rel);
+              if (abs !== distRoot && !abs.startsWith(distRoot + path.sep)) {
+                throw new Error('panel.html 引用越出 dist 根(打包后必然失效): ' + u);
+              }
+              mustFile(path.relative(process.cwd(), abs), 'panel.html 引用');
+            }
+            if (!fs.existsSync('cindyplugin/dist/skills') || !fs.readdirSync('cindyplugin/dist/skills').length) {
+              throw new Error('dist/skills 缺失或为空');
+            }
+            console.log('dist 形状 OK: entry/icon/panel/assets(' + assets.length + ')/skills 就绪, panel 相对引用 ' + refs.length + ' 条全在');
+          "
+          # 源码引用的静态资产清单(自维护):src/cindyplugin 里出现的字面路径必须在 dist 里非空存在
+          refs=$(grep -rhoE "/(stickers|demo-assets)/[A-Za-z0-9._-]+\.[A-Za-z0-9]+" src cindyplugin --include='*.ts' --include='*.tsx' | sort -u)
+          [ -n "$refs" ] || { echo "::error::未从源码提取到任何 stickers/demo-assets 引用 —— 提取正则或源码结构变了,请同步本步骤"; exit 1; }
+          n=0
+          while IFS= read -r r; do
+            f="cindyplugin/dist$r"
+            [ -s "$f" ] || { echo "::error::源码引用的资产在 dist 缺失或为空: $r"; exit 1; }
+            n=$((n+1))
+          done <<< "$refs"
+          echo "运行时引用资产 OK($n 个,全部非空)"
+
+  # ── semgrep 基线 SAST(2026-08-01 门禁收尾,非阻断)───────────────────────────
+  # 痛点:org trunk-guard 里的 CodeQL 规则因 GHAS 未启用永久空转(repo 侧无解,材料
+  # 已转 org owner),而「静态安全扫描」这个能力可以自建:semgrep OSS 免费、红绿在
+  # job 本地判定、完全不碰被 403 的 code-scanning API。实证:#334 的原型污染硬化
+  # 是人肉审查发现的;gitleaks 只扫 secret 形态,不扫代码模式(原型污染/eval/路径拼接)。
+  # 为什么非阻断(照 deps-audit 先例):规则集随 semgrep 版本演进,新规则可能把无关
+  # PR 打红;基线期先看信噪比,转 required 由 lead 依据几周数据另行决策。
+  # docker 镜像钉 **manifest digest**(2026-08-01 gpt-5.6-sol 审查 P1:tag 可被上游
+  # 重指,且容器挂载整个 $PWD —— checkout 默认把 GITHUB_TOKEN 持久化进 .git/config,
+  # 恶意镜像可读走 token;action 层的 SHA-pin 覆盖不了这条执行依赖):
+  # digest 钉死字节 + persist-credentials:false 让容器无凭据可读,双层。
+  semgrep:
+    name: semgrep baseline (non-blocking)
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - name: Checkout (no credentials — mounted into third-party container)
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+        with:
+          persist-credentials: false
+
+      # 退出码语义(第二轮审查更正:semgrep scan **默认有 findings 也退 0**,只有加
+      # `--error` 才以 1 表示 findings —— 故显式加 --error,rc 才携带信息):
+      #   0=完成且 0 findings;1=完成且有 findings;其余=扫描器自身故障。
+      # rc 落盘参与四态判定,并与 results 做交叉一致性校验(rc 与 results 矛盾 =
+      # 报告不可信)。`set +e` + 落盘仅防 step 提前红,判定不吞信息。
+      # 扫描范围:仓库根(semgrep 默认跳过 .gitignore 内容),显式排除文档与产物
+      # —— 白名单目录制会让 shared/ 这类新增顶层生产模块静默漏扫(审查实证)。
+      - name: Semgrep scan (p/default, digest-pinned docker)
+        continue-on-error: true
+        run: |
+          mkdir -p test-artifacts
+          set +e
+          docker run --rm -v "$PWD":/src -w /src \
+            semgrep/semgrep@sha256:65dcd4408adda7c183a6b4550cb1e9b19f7f627a6fbb7e0559bd466bedc44d7b \
+            semgrep scan --config p/default --metrics=off --json --error \
+              --output test-artifacts/semgrep.json \
+              --exclude docs --exclude test-artifacts --exclude history \
+              . \
+              2> test-artifacts/semgrep.err
+          echo "$?" > test-artifacts/semgrep.rc
+          # ↑ digest = semgrep/semgrep:1.172.0 的多架构 manifest(2026-08-01 核验);
+          #   升级流程:改 digest + 本注释的版本号,走显式 diff。
+          true
+
+      # 四态判定(clean / findings / findings-partial / inconclusive),与 deps-audit
+      # 同款契约:报告不可信时明确说「本次没有结论」,绝不折叠成绿。判定要素三个:
+      # rc(0/1=扫描完成,其余=故障)、results、errors(非空=覆盖不完整)。
+      # clean 的充要条件 = rc==0 && results 空 && errors 空;errors 非空时即便
+      # results 空也只能 inconclusive —— 「没扫全的 0 findings」不是安全结论。
+      # 本步不 continue-on-error:判定器坏了必须可见。
+      - name: Classify and surface semgrep result
+        if: always()
+        run: |
+          cat > /tmp/semgrep-verdict.cjs <<'NODE'
+          const fs = require('fs');
+          const out = [];
+          let state = 'inconclusive', reason = '', results = null, errors = [];
+          try {
+            const rcRaw = fs.readFileSync('test-artifacts/semgrep.rc', 'utf8').trim();
+            if (!/^\d+$/.test(rcRaw)) throw new Error('rc 文件内容非法:' + JSON.stringify(rcRaw));
+            const rc = Number(rcRaw);
+            const r = JSON.parse(fs.readFileSync('test-artifacts/semgrep.json', 'utf8'));
+            if (!r || typeof r !== 'object' || !Array.isArray(r.results)) {
+              throw new Error('semgrep JSON 顶层缺 results 数组');
+            }
+            // errors 必须真的是数组(第二轮审查:`?: []` 会把「字段缺失/形状变了」
+            // 静默吞成 0 errors —— 那是 schema 漂移信号,必须 inconclusive)。
+            if (!Array.isArray(r.errors)) throw new Error('semgrep JSON 顶层缺 errors 数组(schema 漂移?)');
+            results = r.results;
+            errors = r.errors;
+            if (rc !== 0 && rc !== 1) {
+              throw new Error('semgrep 退出码 ' + rc + '(非 0/1)= 扫描器自身故障,报告不可信');
+            }
+            // rc 与 results 交叉一致(--error 模式契约):矛盾即报告不可信。
+            if (rc === 0 && results.length > 0) throw new Error('rc=0 但 results=' + results.length + ',与 --error 契约矛盾');
+            if (rc === 1 && results.length === 0) throw new Error('rc=1 但 results 为空,与 --error 契约矛盾');
+            if (results.length > 0) {
+              state = errors.length > 0 ? 'findings-partial' : 'findings';
+            } else if (errors.length > 0) {
+              throw new Error('results 为空但 semgrep 自报 ' + errors.length
+                + ' 条解析/规则错误 —— 覆盖不完整,「0 findings」不能当安全结论');
+            } else {
+              state = 'clean'; // 此处必然 rc===0 && 0 results && 0 errors(充要条件)
+            }
+          } catch (e) {
+            reason = (e && e.message) || String(e);
+          }
+          out.push('## semgrep 基线扫描(p/default,non-blocking)', '');
+          if (state === 'clean') {
+            out.push('✅ **0 findings**,扫描完整(rc=0,errors=0;范围=仓库根,排除 docs/test-artifacts/history 与 .gitignore 内容)。');
+          } else if (state === 'findings' || state === 'findings-partial') {
+            const bySev = { ERROR: [], WARNING: [], INFO: [] };
+            for (const f of results) {
+              const sev = (f.extra && f.extra.severity) || 'INFO';
+              (bySev[sev] || bySev.INFO).push(f);
+            }
+            out.push('⚠️ **' + results.length + ' findings**(非阻断,不挡合并):'
+              + ' ERROR=' + bySev.ERROR.length + ' WARNING=' + bySev.WARNING.length
+              + ' INFO=' + bySev.INFO.length);
+            if (state === 'findings-partial') {
+              out.push('', '🟡 **且覆盖不完整**:semgrep 自报 ' + errors.length
+                + ' 条解析/规则错误 —— 以上 findings 有效,但「只有这些」不成立,未扫到的部分无结论。');
+            }
+            const fmt = (f) => '- `' + f.check_id + '` — ' + f.path + ':' + (f.start && f.start.line || '?');
+            const top = [...bySev.ERROR, ...bySev.WARNING].slice(0, 20);
+            if (top.length) {
+              out.push('', '<details><summary>ERROR/WARNING 明细(前 ' + top.length + ' 条)</summary>', '',
+                ...top.map(fmt), '</details>');
+            }
+          } else {
+            out.push('🟡 **本次扫描没有产出结果** —— 报告不可信:' + reason);
+            out.push('', '这既不代表有问题也不代表没有(常见成因:registry 拉规则失败/docker 拉镜像失败)。');
+            const err = fs.existsSync('test-artifacts/semgrep.err')
+              ? fs.readFileSync('test-artifacts/semgrep.err', 'utf8').trimEnd().split('\n').slice(-20).join('\n') : '';
+            if (err) out.push('', '<details><summary>semgrep stderr(末 20 行)</summary>', '', '```', err, '```', '</details>');
+          }
+          out.push('', '> 口径:`semgrep scan --config p/default --metrics=off`,docker 镜像钉 manifest digest(= 1.172.0);');
+          out.push('> clean 充要条件 = rc==0 && 0 results && 0 errors,errors 非空一律降级 partial/inconclusive。');
+          out.push('> 非阻断基线期:是否转 required 依据几周信噪比另行决策(同 deps-audit/bench 先例)。');
+          fs.appendFileSync(process.env.GITHUB_STEP_SUMMARY, out.join('\n') + '\n');
+          if (state === 'findings' || state === 'findings-partial') {
+            console.log('::warning::semgrep 发现 ' + results.length + ' 条 findings'
+              + (state === 'findings-partial' ? '(且覆盖不完整:' + errors.length + ' 条扫描错误)' : '')
+              + '(非阻断,仅报告),见 job summary。');
+          } else if (state === 'inconclusive') {
+            console.log('::warning::semgrep 未产出可信结果(' + reason + ')—— 这不是安全结论,需要结论请重跑本 job。');
+          }
+          NODE
+          node /tmp/semgrep-verdict.cjs
+
+      - name: Upload semgrep raw report
+        if: always()
+        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: semgrep-report
+          path: test-artifacts/semgrep.json
+          if-no-files-found: ignore
+          retention-days: 14
+
+  # ── coverage 报告(2026-08-01 门禁收尾,非阻断)───────────────────────────────
+  # 痛点:vitest 此前无任何 coverage 配置 —— 5000+ 单测听着厚,但 server/persist
+  # (6.3kL,持久化+权限)这类高危模块哪块裸奔没人知道。先只报告不阻断:阈值
+  # 门禁要等有了几周基线、知道"正常水位"是多少才有意义,凭空拍阈值只会天天红。
+  # 单列 job 不进 build-and-test:v8 插桩让全量单测明显变慢,不该拖 required 主链路。
+  coverage:
+    name: coverage report (non-blocking)
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - name: Checkout
+        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+        with:
+          # 与 build-and-test 同理由:单测里有相对 merge-base 的门禁,浅克隆必红。
+          fetch-depth: 0
+
+      - name: Setup Node (LTS)
+        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: lts/*
+          cache: npm
+
+      - name: Install dependencies
+        run: npm ci
+
+      # continue-on-error:测试失败的红灯归 build-and-test(required)管,本 job 只管
+      # 出覆盖率数字 —— 同一套测试在两个 job 各红一次只会制造重复噪音。
+      # (vitest 4 的 coverage.reportOnFailure 默认 false + coverage.clean 默认 true:
+      #  测试失败时不会产出可被误读的残缺 summary,下游步会走「无结论」分支。)
+      #
+      # coverage.include 显式声明交付源码范围(2026-08-01 gpt-5.6-sol 审查 P2:
+      # 不配 include 时 v8 只统计「本次测试实际加载到」的文件,完全没被任何测试
+      # import 的文件不会以 0% 出现 —— 恰好漏掉本 job 要定位的裸奔模块,总覆盖率
+      # 也被抬高)。exclude 掉测试文件与类型声明,分母只留生产代码。
+      - name: Run unit tests with coverage (v8)
+        continue-on-error: true
+        run: >
+          npx vitest run
+          --coverage.enabled
+          --coverage.provider=v8
+          --coverage.reporter=json-summary
+          --coverage.reporter=text-summary
+          --coverage.include='src/**/*.{ts,tsx}'
+          --coverage.include='server/**/*.ts'
+          --coverage.include='shared/**/*.ts'
+          --coverage.include='cindyplugin/**/*.{ts,tsx}'
+          --coverage.exclude='**/*.test.*'
+          --coverage.exclude='**/*.spec.*'
+          --coverage.exclude='**/__tests__/**'
+          --coverage.exclude='**/*.d.ts'
+          --coverage.exclude='**/dist/**'
+
+      - name: Surface coverage summary
+        if: always()
+        run: |
+          cat > /tmp/coverage-summary.cjs <<'NODE'
+          const fs = require('fs');
+          const out = ['## coverage 报告(vitest v8,non-blocking)', ''];
+          try {
+            const s = JSON.parse(fs.readFileSync('coverage/coverage-summary.json', 'utf8'));
+            const t = s.total;
+            out.push('| 维度 | 覆盖率 | covered/total |');
+            out.push('|------|--------|---------------|');
+            for (const k of ['lines', 'statements', 'branches', 'functions']) {
+              out.push('| ' + k + ' | **' + t[k].pct + '%** | ' + t[k].covered + '/' + t[k].total + ' |');
