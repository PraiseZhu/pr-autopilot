@@ -0,0 +1,181 @@
+#!/usr/bin/env node
+// check-internal-literals.mjs — 内网基础设施字面量守卫(守卫家族;借鉴 cindy 主仓
+// check-endpoint-literals 的「单一来源门禁」设计,配置按本仓语境重写)。
+//
+// 为什么存在(2026-08-01 门禁收尾):AGENTS.md 部署规则明文要求「部署机信息不得
+// 硬编码进 scripts/ 脚本本体(脚本的 MIVO_DEPLOY_HOST/MIVO_DEPLOY_USER 必须保持
+// 无默认值)」,但该规则此前**零机器执行** —— 实证:scripts/loops/bug-doctor/gate.mjs
+// 曾把 `user@10.102.x.x` 硬编码为 env fallback(本守卫落地当轮修掉),AGENTS.md
+// 靠人肉根本钉不住。本守卫把规则变成 CI 阻断项。
+//
+// 威胁模型(2026-08-01 gpt-5.6-sol 审查后写明,不许超卖):本守卫防的是**明文、
+// 连续字面量**的顺手硬编码 —— 即 gate.mjs 那类真实翻车形态。它不防刻意混淆
+// (字符串拼接 `'10.' + '102...'`、escape 编码、运行时拼装):任何词法守卫都防不住
+// 刻意绕过,那属于恶意行为,归 code review / 安全审计管,不在本守卫承诺内。
+//
+// 扫描范围(2026-08-01 审查返修:白名单目录制 → 全仓排除制):git tracked 全部
+// 文件,减去显式排除(见 EXCLUDES,每条带理由)与二进制(NUL 探测)。此前只扫
+// 5 个目录 + 固定扩展名,vite.config.ts / shared/ / tracked plist / Dockerfile
+// 这些真实可写入内网地址的位置全在盲区 —— 排除制下新增文件默认**在**守卫视野内。
+//
+// 规则(两层,精度优先 —— 大量测试 fixture 用 10.0.0.x 教学值,不能一刀切):
+//   1. 硬禁(零豁免,测试与 allowlist 一律不放行):部署网段前缀 `10.102.` ——
+//      这是真实生产网段,任何形态(完整 IP / 子网写法)都不允许出现在扫描范围内。
+//   2. RFC1918 完整 IPv4 字面量(10/8、172.16/12、192.168/16)默认违规,两类豁免:
+//      a. 测试代码(basename 含 .test./.spec.,或位于 __tests__/、scripts/e2e/):
+//         SSRF 防护、e2e reset 等测试必须用私网 IP 当反例 fixture,天然合法;
+//      b. FILE_ALLOWLIST 显式列出的文件(带理由,见下)。
+//   loopback(127.x)/0.0.0.0 等不属于内网基础设施信息,不在规则内。
+//
+// 权威通道说明:本守卫在 CI(干净 checkout,required check)上的运行是权威判定;
+// 本地 preflight 运行是开发便利,扫的是工作区现状 —— 「提交坏内容再清工作区」
+// 骗得过本地,骗不过 CI。任何文件读取失败一律 fail-closed(exit 2),不静默跳过。
+//
+// 退出码:0=干净;1=有违规(逐条 file:line + 修法);2=运行错误(git 不可用/文件读取失败)。
+import { execFileSync } from 'node:child_process'
+import { readFileSync, realpathSync } from 'node:fs'
+import { resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+// ── 规则定义 ──────────────────────────────────────────────────────────────
+// 硬禁:生产部署网段前缀。用前缀而非完整 IP,连 `10.102.x` 这种子网提及也拦。
+// 左边界 (?<![\d.]):版本串 `1.10.102.3` 的中段不误报(与 RFC1918 层同语义)。
+export const HARD_BAN = { name: 'deploy-subnet-10.102.*', re: /(?<![\d.])10\.102\./ }
+
+// RFC1918 完整 IPv4。octet 收紧 0-255,两侧都锁边界:
+//   左 (?<![\d.]) 防 `1.10.0.0.1` 前挂,右 (?![\d.]) 防五段串 `10.0.0.1.2` 与
+//   超范围 `10.999.999.999`(999 不是合法 octet,整串不该命中)。
+const OCTET = '(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)'
+export const RFC1918 = [
+  { name: 'rfc1918-10/8', re: new RegExp(`(?<![\\d.])10\\.${OCTET}\\.${OCTET}\\.${OCTET}(?![\\d.])`) },
+  { name: 'rfc1918-172.16/12', re: new RegExp(`(?<![\\d.])172\\.(1[6-9]|2\\d|3[01])\\.${OCTET}\\.${OCTET}(?![\\d.])`) },
+  { name: 'rfc1918-192.168/16', re: new RegExp(`(?<![\\d.])192\\.168\\.${OCTET}\\.${OCTET}(?![\\d.])`) },
+]
+
+// 测试代码豁免(仅对 RFC1918 层;硬禁层无豁免)。
+// .test./.spec. 只认 **basename**(2026-08-01 返修:此前匹配整条路径,目录名含
+// `.test.` 的生产文件 `server/foo.test.data/config.ts` 会被误豁免);
+// 目录级豁免仅 __tests__/ 与 scripts/e2e/ 两个既定测试根。
+export const isTestPath = (path) =>
+  /(?:^|\/)[^/]*\.(?:test|spec)\.[^/]+$/.test(path)
+  || /(?:^|\/)__tests__\//.test(path)
+  || /^scripts\/e2e\//.test(path)
+
+// 显式豁免文件 → 理由(仅 RFC1918 层)。新增条目必须写清「为什么这个文件需要
+// 私网 IP 字面量」,review 时按理由审。
+export const FILE_ALLOWLIST = new Map([
+  [
+    'server/lib/proxyImageSecurity.ts',
+    'SSRF 防护实现本体:私网段判定逻辑与文档注释(10.0.0.0/8 等)是它的业务内容',
+  ],
+  [
+    'ops/postgres/docker-compose.yml',
+    '固定 ipam 选段(192.168.228.0/24)与避段依据注释:本地容器网段规划,非部署主机信息',
+  ],
+  [
+    'ops/postgres/docker-compose.e2e.yml',
+    '同上:e2e 独立 ipam 选段(192.168.229.0/24),本地容器网段规划,非部署主机信息',
+  ],
+])
+
+// 全仓排除(每条带理由;排除制的纪律是「排得少而明确」,新增排除必须过 review):
+export const EXCLUDES = [
+  { re: /^docs\//, reason: '文档区按其定位记录内网拓扑,归另一治理问题,AGENTS.md 规则边界本来就是代码本体' },
+  { re: /^AGENTS\.md$/, reason: 'AGENTS.md 自身是部署地址的唯一许可记载处(其部署规则原文如此约定)' },
+  { re: /\.(png|jpe?g|gif|webp|ico|woff2?|ttf|otf|eot|pdf|zip|jar|mp[34]|mov|cindy)$/i, reason: '二进制资产(另有 NUL 探测兜底)' },
+]
+
+// 守卫自身与其测试是唯一的整体豁免(含硬禁层):规则定义、注释示例、测试 fixture
+// 必然包含被禁字面量本身(同 .gitleaks.toml 不扫自己)。除这两个文件外硬禁零豁免。
+const SELF_FILES = new Set([
+  'scripts/ci/check-internal-literals.mjs',
+  'scripts/ci/check-internal-literals.test.mjs',
+])
+
+// ── 纯函数:单文件内容检查(vitest 单测覆盖) ────────────────────────────────
+export const checkContent = (path, content) => {
+  const violations = []
+  const exempt = isTestPath(path) || FILE_ALLOWLIST.has(path)
+  const lines = content.split('\n')
+  for (let i = 0; i < lines.length; i += 1) {
+    const line = lines[i]
+    if (HARD_BAN.re.test(line)) {
+      violations.push({ path, line: i + 1, rule: HARD_BAN.name, text: line.trim(), hard: true })
+      continue // 同一行命中硬禁即够,不再叠报 RFC1918
+    }
+    if (exempt) continue
+    for (const r of RFC1918) {
+      if (r.re.test(line)) {
+        violations.push({ path, line: i + 1, rule: r.name, text: line.trim(), hard: false })
+        break
+      }
+    }
+  }
+  return violations
+}
+
+// 二进制探测:前 8KB 含 NUL 即视为二进制跳过(git 同款启发式)。
+const looksBinary = (buf) => buf.subarray(0, 8192).includes(0)
+
+// ── CLI 主流程 ────────────────────────────────────────────────────────────
+const main = () => {
+  let files
+  try {
+    files = execFileSync('git', ['ls-files', '-z'], { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 })
+      .split('\0')
+      .filter((f) => f && !SELF_FILES.has(f) && !EXCLUDES.some((e) => e.re.test(f)))
+  } catch (e) {
+    console.error(`[internal-literals] git ls-files 失败:${e.message}`)
+    process.exit(2)
+  }
+
+  const all = []
+  let scanned = 0
+  for (const f of files) {
+    let buf
+    try {
+      buf = readFileSync(f)
+    } catch (e) {
+      // fail-closed(2026-08-01 返修):读不到就下不了结论,静默跳过等于给「index 有
+      // 坏内容、工作区被清掉」这类形态留 fail-open 通道。CI 干净 checkout 上读失败
+      // 本身就是异常,必须可见。
+      console.error(`[internal-literals] 读取失败即 fail-closed:${f}:${e.message}`)
+      process.exit(2)
+    }
+    if (looksBinary(buf)) continue
+    scanned += 1
+    all.push(...checkContent(f, buf.toString('utf8')))
+  }
+
+  if (all.length === 0) {
+    console.log(`[internal-literals] OK:${scanned} 个文本文件无内网基础设施字面量(tracked ${files.length},二进制跳过 ${files.length - scanned})`)
+    process.exit(0)
+  }
+
+  console.error(`[internal-literals] 发现 ${all.length} 处内网字面量违规:\n`)
+  for (const v of all) {
+    console.error(`  ${v.path}:${v.line} [${v.rule}${v.hard ? ',硬禁' : ''}] ${v.text}`)
+  }
+  console.error(`
+修法(按 AGENTS.md 部署规则):
+  - 部署主机/内网地址改从环境变量或本地不入库配置读取,代码里不留默认值;
+  - 测试需要私网 IP 当 fixture → 放测试文件(*.test.*/*.spec.* basename、__tests__/、scripts/e2e/)即可豁免;
+  - 非测试文件确有正当理由(如 SSRF 判定实现)→ 在本脚本 FILE_ALLOWLIST 加条目并写明理由;
+  - \`10.102.*\` 为生产部署网段,零豁免:任何文件(含测试/allowlist)都不允许出现。`)
+  process.exit(1)
+}
+
+// 仅作为 CLI 入口时执行(被 vitest import 时不跑)。
+// realpath + 绝对路径全等比较(2026-08-01 返修):此前用 basename endsWith,同名
+// importer 会误触发 main,Windows 反斜杠路径下则永不触发(preflight 静默空转)。
+const isCliEntry = () => {
+  if (!process.argv[1]) return false
+  try {
+    return realpathSync(fileURLToPath(import.meta.url)) === realpathSync(resolve(process.argv[1]))
+  } catch {
+    return false
+  }
+}
+if (isCliEntry()) {
+  main()
+}
diff --git a/scripts/ci/check-internal-literals.test.mjs b/scripts/ci/check-internal-literals.test.mjs
new file mode 100644
index 00000000..7197c3bf
--- /dev/null
+++ b/scripts/ci/check-internal-literals.test.mjs
@@ -0,0 +1,96 @@
+// check-internal-literals 守卫单测(vitest,随 test:unit / required gate 跑)。
+// 覆盖:硬禁零豁免语义与两侧边界、RFC1918 三段与 octet 范围、测试路径豁免
+// (basename 语义)、allowlist 豁免、版本号/五段串/loopback 不误报、排除清单形状。
+// fixture 里的内网 IP 是被测样本,本测试文件在守卫扫描中属 SELF_FILES 整体豁免。
+import { describe, expect, it } from 'vitest'
+import { EXCLUDES, FILE_ALLOWLIST, checkContent, isTestPath } from './check-internal-literals.mjs'
+
+describe('check-internal-literals', () => {
+  it('硬禁:部署网段前缀在任何文件都违规(含测试路径与 allowlist 文件)', () => {
