+// 算法)。单采样点是文字字形间隙的盲区,故对投影矩形做 3×3 子矩形网格,任一子矩形
+// 满足 sampleAvailable && intersects && nonEmpty 即该节点落画证据成立;全部失败
+// (区域无像素 / 矩形不碰可见画布 / canvas 缺失或尺寸为 0)→ 节点证据不成立,fail-closed。
+// 轮询至 deadline:image 走异步 lease 解析,采样需等待位图真正落画(与 renderer 自身
+// sampleSoon 的 30×100ms 重试窗口同因)。超时是硬期限,单轮采样与剩余期限 race——
+// 页面卡死时不得挂到 job 级 timeout(与 wait-async-predicate 第 4 条同款失败形态)。
+const NODE_PIXEL_GRID = 3
+
+export const waitForArchiveNodePixelEvidence = async (
+  page,
+  nodeIds,
+  { timeout = 30000, interval = 200, label } = {},
+) => {
+  const what = label ?? `节点投影区域像素证据:${nodeIds.join(', ')}`
+  if (!(timeout > 0)) {
+    throw new Error(`waitForArchiveNodePixelEvidence: timeout 必须为正数(收到 ${timeout})`)
+  }
+  const deadline = Date.now() + timeout
+  let last = null
+  let everEvaluated = false
+  for (;;) {
+    const remaining = deadline - Date.now()
+    if (remaining <= 0) {
+      throw new Error(
+        everEvaluated
+          ? `waitForArchiveNodePixelEvidence 超时(${timeout}ms):${what} —— 末次读数 ${JSON.stringify(last)}`
+          : `waitForArchiveNodePixelEvidence 超时(${timeout}ms):${what} —— 一次都没采样完`,
+      )
+    }
+
+    const pending = (async () => {
+      const readout = {}
+      let allReady = true
+      for (const nodeId of nodeIds) {
+        const projected = await projectedScreenRectForNode(page, nodeId)
+        if (!projected) {
+          // store 无该节点 / shell 缺失 → 投影拿不到,证据不可用(fail-closed)。
+          readout[nodeId] = { projected: null }
+          allReady = false
+          continue
+        }
+        const probes = []
+        for (let row = 0; row < NODE_PIXEL_GRID; row += 1) {
+          for (let column = 0; column < NODE_PIXEL_GRID; column += 1) {
+            probes.push(
+              await sampleCanvasPixelInRect(page, {
+                x: projected.x + (projected.width * column) / NODE_PIXEL_GRID,
+                y: projected.y + (projected.height * row) / NODE_PIXEL_GRID,
+                width: projected.width / NODE_PIXEL_GRID,
+                height: projected.height / NODE_PIXEL_GRID,
+              }),
+            )
+          }
+        }
+        const evidenceOk = probes.some((probe) => probe.sampleAvailable && probe.intersects && probe.nonEmpty)
+        readout[nodeId] = { projected, probes, evidenceOk }
+        if (!evidenceOk) allReady = false
+      }
+      return { allReady, readout }
+    })()
+
+    let timer
+    let result
+    try {
+      result = await Promise.race([
+        pending,
+        new Promise((resolve) => {
+          timer = setTimeout(() => resolve(EXPIRED_SENTINEL), remaining)
+        }),
+      ])
+    } finally {
+      clearTimeout(timer)
+    }
+
+    if (result === EXPIRED_SENTINEL) {
+      // 放弃这轮采样:它可能永远不 settle。不能让它变成 unhandledRejection,但也不能
+      // 完全丢掉——迟到的错误可能正是最有指向性的一句(与 wait-async-predicate 同款)。
+      void Promise.resolve(pending).catch((err) => {
+        console.warn(
+          `[waitForArchiveNodePixelEvidence] 已放弃的采样稍后失败了(${what}):${err instanceof Error ? err.message : String(err)}`,
+        )
+      })
+      throw new Error(
+        `waitForArchiveNodePixelEvidence 超时(${timeout}ms):${what} —— 单轮采样未在期限内返回` +
+          `(页面卡死;末次已知读数 ${JSON.stringify(last)})`,
+      )
+    }
+
+    everEvaluated = true
+    last = result.readout
+    if (result.allReady) return result.readout
+
+    const left = deadline - Date.now()
+    if (left <= 0) continue
+    await new Promise((resolve) => setTimeout(resolve, Math.min(interval, left)))
+  }
+}
+
+const EXPIRED_SENTINEL = Symbol('archive-assets:node-pixel-evidence-expired')
