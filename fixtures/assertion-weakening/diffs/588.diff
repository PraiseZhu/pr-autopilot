+// scripts/e2e/scenarios/archive-assets.evidence.test.mjs
+// waitForArchiveNodePixelEvidence 的诚实性契约测试(F542-R1-CA-001 返修补上)。
+//
+// 为什么需要:该原语是 archive-assets leafer 恢复断言的新主证据——每个归档节点必须
+// 在其 ID 绑定的投影区域采到非空像素。双审 major 指出旧断言只验证聚合信号
+// (children/expected/global pixel),「stale 双对象」与「仅 text 有像素、image 未落画」
+// 两种反例都可假绿。新原语的接线层判定(3×3 子矩形网格 → 任一
+// sampleAvailable && intersects && nonEmpty 即证据成立)与 fail-closed 语义必须有
+// 契约测试钉住,否则下一次返修可能把像素证据悄悄改回聚合口径(正是本 finding 的形态)。
+//
+// 锁住四条(不启真浏览器:假 page 即可 —— 本原语与浏览器的唯一接触面是
+// projectedScreenRectForNode / sampleCanvasPixelInRect 内部的 page.evaluate):
+//   ① 两节点投影区域都有非空像素 → 返回含两节点 evidenceOk:true 的读数;
+//   ② 仅 image 区域无像素(text 正常)→ 期限内抛错,消息带 label 与末次读数
+//      (「image 不落画而 text 落画」反例必须让目标断言自身红);
+//   ③ 节点投影拿不到(store 无该节点 / shell 缺失)→ fail-closed 抛错,读数含 projected:null;
+//   ④ 单轮采样永不 settle → 仍在期限内抛错(硬期限;与 wait-async-predicate 第 4 条同款)。
+import { describe, expect, it } from 'vitest'
+import { waitForArchiveNodePixelEvidence } from './archive-assets.mjs'
+
+const TEXT_PROJECTED = { x: 0, y: 0, width: 240, height: 96 }
+const IMAGE_PROJECTED = { x: 360, y: 96, width: 64, height: 64 }
+
+/**
+ * 假 page:projectedScreenRectForNode 传 nodeId(string),sampleCanvasPixelInRect 传
+ * rect(object)。按 arg 形状分派:文本节点投影 x<100,image 投影 x>=360,采样响应按
+ * 矩形 x 坐标区分节点(imageProbe / textProbe 可各自定制)。evaluate 恒返回成功值。
+ */
+const fakePage = ({
+  textProbe = { sampleAvailable: true, intersects: true, nonEmpty: true },
+  imageProbe = { sampleAvailable: true, intersects: true, nonEmpty: true },
+} = {}) => ({
+  evaluate: async (_fn, arg) => {
+    if (typeof arg === 'string') {
+      return arg === 'archive-image' ? IMAGE_PROJECTED : TEXT_PROJECTED
+    }
+    return (arg?.x ?? 0) < 100 ? textProbe : imageProbe
+  },
+})
+
+describe('waitForArchiveNodePixelEvidence 契约', () => {
+  it('① 两节点投影区域都有非空像素 → 返回含两节点 evidenceOk:true 的读数', async () => {
+    const page = fakePage()
+    const got = await waitForArchiveNodePixelEvidence(page, ['archive-text', 'archive-image'], {
+      timeout: 2000,
+      interval: 5,
+      label: '测试:两节点均落画',
+    })
+    expect(got['archive-text'].evidenceOk).toBe(true)
+    expect(got['archive-image'].evidenceOk).toBe(true)
+    // 每个节点采样 3×3 网格 = 9 次
+    expect(got['archive-text'].probes).toHaveLength(9)
+    expect(got['archive-image'].probes).toHaveLength(9)
+  })
+
+  it('② image 不落画而 text 落画 → 期限内抛错,消息带 label 与末次读数(目标断言自身红)', async () => {
+    const page = fakePage({ imageProbe: { sampleAvailable: true, intersects: true, nonEmpty: false } })
+    const err = await waitForArchiveNodePixelEvidence(page, ['archive-text', 'archive-image'], {
+      timeout: 300,
+      interval: 5,
+      label: '测试:image 区域无像素',
+    }).catch((e) => e)
+    expect(err).toBeInstanceOf(Error)
+    expect(err.message).toContain('测试:image 区域无像素')
+    // 末次读数必须如实带出哪个节点、哪类证据失败,否则超时信息退化成"不知道当时是什么"
+    expect(err.message).toContain('archive-image')
+    expect(err.message).toContain('"evidenceOk":false')
+    expect(err.message).toContain('"archive-text"')
+  })
+
+  it('③ 节点投影拿不到(store 无该节点 / shell 缺失)→ fail-closed 抛错,读数含 projected:null', async () => {
+    const page = {
+      evaluate: async (_fn, arg) => (typeof arg === 'string' ? null : { sampleAvailable: true, intersects: true, nonEmpty: true }),
+    }
+    const err = await waitForArchiveNodePixelEvidence(page, ['archive-text', 'archive-image'], {
+      timeout: 300,
+      interval: 5,
+      label: '测试:投影缺失',
+    }).catch((e) => e)
+    expect(err).toBeInstanceOf(Error)
+    expect(err.message).toContain('测试:投影缺失')
+    expect(err.message).toContain('"projected":null')
+  })
+
+  it('④ 单轮采样永不 settle → 仍在期限内抛错(硬期限,防挂死)', async () => {
+    const page = { evaluate: () => new Promise(() => {}) }
+    const started = Date.now()
+    const err = await waitForArchiveNodePixelEvidence(page, ['archive-text', 'archive-image'], {
+      timeout: 300,
+      interval: 5,
+      label: '测试:采样永不返回',
+    }).catch((e) => e)
+    expect(err).toBeInstanceOf(Error)
+    expect(err.message).toContain('单轮采样未在期限内返回')
+    expect(Date.now() - started).toBeLessThan(3000)
+  })
+
+  it('timeout 非正数 → 直接报错,不做无期限等待', async () => {
+    const page = fakePage()
+    await expect(
+      waitForArchiveNodePixelEvidence(page, ['archive-text', 'archive-image'], { timeout: 0 }),
+    ).rejects.toThrow(/timeout 必须为正数/)
+  })
+})
