+// / canvasRenderAdapter.markupRenderStyleFor),但"现读"只在渲染/effect 运行的那一刻发生
+// 一次——外部改写 DOM 属性不会自动变成一次 React 重渲染或 Leafer sync,没有观察器就没有
+// 触发源。这个 hook 就是那个触发源:把"属性变化"转成"可订阅的 state"。
+//
+// 单例 MutationObserver + 订阅者集合(而不是每个调用点各开一个 observer):调用方可能是
+// MarkupNodeView(每个 markup 节点一份实例,数量可达上千)与 useLeaferSpikeRenderer(单份),
+// 共享同一个观察器实例避免随调用点数量线性增长。最后一个订阅者退订时 disconnect,
+// 下一个订阅者到来时重新 observe——不会有"没人用了但观察器还在跑"的泄漏。
+//
+// R2 重写(F-A5):快照(getSnapshot/getServerSnapshot)永远现读 DOM 真值,不再经过任何
+// 模块级缓存——字符串按值比较,useSyncExternalStore 对基本类型现读是安全的(不会像
+// 每次返回新对象/数组引用那样触发无限重渲染)。模块级 `lastNotifiedTheme` 只保留给
+// notify() 用于「避免同一属性变化通知两次」的去重,不再是任何组件读到的真相源。
+//
+// 这条线的第一版曾经把 cachedTheme 当成快照源:最后一个订阅者退订 → observer
+// disconnect → 退订期间发生的属性变化没有任何代码路径去更新这份缓存 → 下一个订阅者
+// 重挂载时,(a) 从 getSnapshot() 读到的是退订前的陈旧值,且 (b) 更糟的是,后续那次真的
+// 切回该陈旧值的变化,会被 notify() 里 `next === cachedTheme` 的去重判断当成"没变"而
+// 吞掉,状态从此卡死。根因是把"用于去重的缓存"和"组件读到的快照"合成了同一个变量——
+// 两者必须分离:快照永远现读,去重缓存只影响是否调用监听器,且在每次重新订阅时都要
+// 与 DOM 重同步一次,才能不遗留跨越"无订阅者窗口"的陈旧比较基准。
+
+const THEME_ATTRIBUTE = 'data-mivo-theme'
+
+const readThemeAttribute = (): string => {
+  if (typeof document === 'undefined') return ''
+  return document.documentElement.getAttribute(THEME_ATTRIBUTE) || ''
+}
+
+// 仅用于 notify() 的「这次 mutation 有没有真的改变值」去重判断——不是快照源。
+let lastNotifiedTheme = readThemeAttribute()
+const listeners = new Set<() => void>()
+let observer: MutationObserver | null = null
+
+const notify = () => {
+  const next = readThemeAttribute()
+  if (next === lastNotifiedTheme) return
+  lastNotifiedTheme = next
+  for (const listener of listeners) listener()
+}
+
+const subscribe = (onStoreChange: () => void): (() => void) => {
+  listeners.add(onStoreChange)
+  if (!observer && typeof document !== 'undefined' && typeof MutationObserver !== 'undefined') {
+    // 重新订阅:与 DOM 重同步去重基准。上一个订阅者退订到现在这段时间没有观察器,
+    // `lastNotifiedTheme` 可能已经落后于 DOM 真值——不重同步的话,下一次真实变化如果
+    // 恰好变回这份陈旧基准值,会被上面的 `next === lastNotifiedTheme` 误判成"没变"
+    // 而吞掉,永久卡住。快照本身(getSnapshot)已经不依赖这份缓存,这里重同步只是为了
+    // 让 notify() 的去重判断在恢复观察的那一刻起就是准的。
+    lastNotifiedTheme = readThemeAttribute()
+    observer = new MutationObserver(notify)
+    observer.observe(document.documentElement, {
+      attributes: true,
+      attributeFilter: [THEME_ATTRIBUTE],
+    })
+  }
+  return () => {
+    listeners.delete(onStoreChange)
+    if (listeners.size === 0 && observer) {
+      observer.disconnect()
+      observer = null
+    }
+  }
+}
+
+/**
+ * 当前 `data-mivo-theme` 属性值(空串 = light)。外部(插件宿主)改写该属性会让
+ * 所有订阅了这个 hook 的组件重渲染——派生连线颜色随主题即时更新的触发源。
+ */
+export const useDocumentThemeAttribute = (): string =>
+  useSyncExternalStore(subscribe, readThemeAttribute, readThemeAttribute)
