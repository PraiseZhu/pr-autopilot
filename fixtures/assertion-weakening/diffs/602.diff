+    act(() => {
+      document.documentElement.setAttribute(THEME_ATTR, 'light')
+    })
+    await flushAsync()
+    expect(capturedA).toBe('light')
+
+    // 最后一个订阅者退订 → 观察器应该 disconnect。
+    act(() => {
