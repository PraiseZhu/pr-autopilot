+    expect(useCanvasStore.getState().nodes.find((n) => n.id === 'pinned')).toBeDefined()
+  })
+})
+
+describe('剪切(cutSelectedNodes)纯派生连线选区', () => {
+  beforeEach(() => { seedStore() })
+
+  it('Ctrl+X 剪切纯派生连线选区:节点与 edge 记录同时移除、clipboardNodes 非空', () => {
