+// @vitest-environment happy-dom
+// derivation edge 的"不可拖、可删"语义(2026-08-08 真机:选中连线按 Delete 无反应)。
+// 根因:createDerivationEdgeNode 出厂 locked:true(防拖动),而 deleteNode /
+// deleteSelectedNodes 的锁定守卫把它挡在删除集之外 → Delete 永远空转;
+// 修复 = 删除路径对 derivation edge 豁免锁定守卫,普通锁定节点语义不变。
+// 真 store 测试,不 mock slice;fixture 走真工厂(锁定态是判别前提,见前提断言)。
+import { beforeEach, describe, expect, it } from 'vitest'
+import { useCanvasStore } from './canvasStore'
+import { createDerivationEdgeNode } from './nodeFactory'
+import type { CanvasEdge, MivoCanvasNode } from '../types/mivoCanvas'
+
+const image = (id: string, x: number): MivoCanvasNode =>
+  ({
+    id,
+    type: 'image',
+    title: id,
+    x,
+    y: 0,
+    width: 100,
+    height: 100,
+    status: 'ready',
+  }) as MivoCanvasNode
+
+const edge: CanvasEdge = { id: 'e1', from: 'src', to: 'tgt', type: 'edit', prompt: '', createdAt: 0 }
+
+const seedStore = () => {
+  const src = image('src', 0)
+  const tgt = image('tgt', 300)
+  const edgeNode = createDerivationEdgeNode(edge, [src, tgt])
+  if (!edgeNode) throw new Error('fixture: derivation edge node not created')
+  useCanvasStore.setState({
+    nodes: [src, tgt, edgeNode],
+    edges: [edge],
+    selectedNodeId: undefined,
+    selectedNodeIds: [],
+  })
+  return edgeNode
+}
+
+describe('derivation edge 删除 — 锁定豁免(不可拖、可删)', () => {
+  beforeEach(() => { seedStore() })
+
+  it('前提断言:真工厂产出的连线节点确实是 locked(豁免才有判别力)', () => {
+    const edgeNode = useCanvasStore.getState().nodes.find((n) => n.id === 'derivation-e1')
+    expect(edgeNode?.locked).toBe(true)
+  })
+
+  it('键盘 Delete(deleteSelectedNodes):锁定的连线节点可删,edge 记录同步移除不复活', () => {
+    useCanvasStore.setState({ selectedNodeIds: ['derivation-e1'] })
+    useCanvasStore.getState().deleteSelectedNodes()
+    const state = useCanvasStore.getState()
+    expect(state.nodes.find((n) => n.id === 'derivation-e1')).toBeUndefined()
+    expect(state.edges).toHaveLength(0) // 记录不删会被 syncDerivationEdgeNodes 复活
+    expect(state.nodes.map((n) => n.id).sort()).toEqual(['src', 'tgt']) // 两端图片不动
+  })
+
+  it('右键单删(deleteNode):同样豁免锁定守卫', () => {
+    useCanvasStore.getState().deleteNode('derivation-e1')
+    const state = useCanvasStore.getState()
+    expect(state.nodes.find((n) => n.id === 'derivation-e1')).toBeUndefined()
+    expect(state.edges).toHaveLength(0)
+  })
+
+  it('豁免不外溢:普通锁定节点仍然拒绝删除', () => {
+    useCanvasStore.setState({
+      nodes: [...useCanvasStore.getState().nodes, { ...image('pinned', 600), locked: true }],
+      selectedNodeIds: ['pinned'],
+    })
+    useCanvasStore.getState().deleteSelectedNodes()
+    expect(useCanvasStore.getState().nodes.find((n) => n.id === 'pinned')).toBeDefined()
