+
+describe('已验证投影(isDerivationEdgeNode + id 恰好对应真实 edge + edge 记录存在,三者缺一不授予特权)', () => {
+  beforeEach(() => { seedStore() })
+
+  it('伪造 model 字符串但无匹配 edge 的节点不获特权(锁豁免拒绝,三条移除路径均挡住,edge 记录不受影响)', () => {
+    const forged = {
+      id: 'derivation-forged-no-edge',
+      type: 'markup',
+      title: 'forged',
