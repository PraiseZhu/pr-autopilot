+  const b2 = 3 * mt * t * t
+  const b3 = t * t * t
+  return {
+    x: b0 * p0.x + b1 * cp1.x + b2 * cp2.x + b3 * p1.x,
+    y: b0 * p0.y + b1 * cp1.y + b2 * cp2.y + b3 * p1.y,
