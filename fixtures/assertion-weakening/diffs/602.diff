+  it('cut 分支的 edge 记录过滤可达(选中连线后 edges 真的减少;豁免缺失时这行过滤永远碰不到派生连线,是不可达死代码)', () => {
+    expect(useCanvasStore.getState().edges).toHaveLength(1) // 前提:确有 1 条 edge 记录可供过滤
+    useCanvasStore.setState({ selectedNodeIds: ['derivation-e1'] })
