+/**
+ * 派生特权(锁定豁免、删 edge 记录)的唯一判据——不是"内容相等"(generation.model
+ * 字符串、id 前缀),是"创建凭证"(hardening-checklist 第 3 类):节点必须同时满足
+ * isDerivationEdgeNode(类型+model)、id 恰好等于 derivation-{edge.id}(而不是
+ * 任意共享 "derivation-" 前缀的字符串)、且该 edge 记录在当前 edges 里真实存在。
+ * 三者缺一律不授予——伪造 model 字符串的节点、或 id 前缀碰撞但并非派生连线的节点,
+ * 都不应蹭到锁豁免或让删除路径误删无关 edge 记录。
+ *
+ * 返回该节点对应的真实 edge id(供调用方决定是否连带移除 edge 记录),无匹配时
+ * 返回 undefined。
+ */
+export const verifiedDerivationEdgeIdFor = (
+  node: MivoCanvasNode,
+  edges: CanvasEdge[],
+): string | undefined => {
+  if (!isDerivationEdgeNode(node)) return undefined
+  return edges.find((edge) => derivationEdgeNodeId(edge.id) === node.id)?.id
+}
+
+export const isVerifiedDerivationEdgeNode = (node: MivoCanvasNode, edges: CanvasEdge[]): boolean =>
+  verifiedDerivationEdgeIdFor(node, edges) !== undefined
+
+/** 批量版本:给一组候选节点(如即将被删除/剪切的节点),收集它们各自已验证的 edge
+ *  id——三条移除路径(deleteNode/deleteSelectedNodes/cutSelectedNodes)共用同一份
+ *  判据,不再各自剥字符串前缀。 */
+export const verifiedDerivationEdgeIds = (nodes: MivoCanvasNode[], edges: CanvasEdge[]): Set<string> => {
+  const ids = new Set<string>()
+  for (const node of nodes) {
+    const edgeId = verifiedDerivationEdgeIdFor(node, edges)
+    if (edgeId) ids.add(edgeId)
+  }
+  return ids
+}
