+  const { useDocumentThemeAttribute } = await import('./useDocumentThemeAttribute')
+  function Harness() {
+    const theme = useDocumentThemeAttribute()
+    useEffect(() => {
+      captured = theme
+    })
+    return null
+  }
+  act(() => {
+    root.render(createElement(Harness))
+  })
+}
+
+describe('useDocumentThemeAttribute — 外部 DOM mutation 转成可订阅 state（派生连线重绘的触发源）', () => {
+  it('外部改写 data-mivo-theme 后 hook 返回新值', async () => {
+    await mountHarness()
+    expect(captured).toBe('')
+
+    act(() => {
+      document.documentElement.setAttribute(THEME_ATTR, 'dark')
+    })
+    await flushAsync()
+    expect(captured).toBe('dark')
+
+    act(() => {
+      document.documentElement.setAttribute(THEME_ATTR, 'light')
+    })
+    await flushAsync()
+    expect(captured).toBe('light')
+  })
+
+  it('属性被移除时兜底回空串（light 的既有约定）', async () => {
+    document.documentElement.setAttribute(THEME_ATTR, 'dark')
+    await mountHarness()
+    expect(captured).toBe('dark')
+
+    act(() => {
+      document.documentElement.removeAttribute(THEME_ATTR)
+    })
+    await flushAsync()
+    expect(captured).toBe('')
+  })
+
+  it('卸载后 disconnect：不再收到通知，也不会因残留监听器抛错', async () => {
+    await mountHarness()
+    act(() => {
+      document.documentElement.setAttribute(THEME_ATTR, 'dark')
+    })
+    await flushAsync()
+    expect(captured).toBe('dark')
+
+    act(() => {
+      root.unmount()
+    })
