+// @vitest-environment happy-dom
+//
+// data-mivo-theme 由 Cindy 插件宿主从外部灌入,本应用自身从不写这个属性(见
+// useDocumentThemeAttribute.ts 头部注释)。没有观察器就没有触发源——这三个测试
+// 钉住"外部改写属性 → hook 返回新值"这条唯一存在意义的行为,而不是纯函数层面的
+// 字符串解析(那没有争议,真正的坑在"谁通知了 React")。
+//
+// harness 沿用 useRegionEditFlip.test.tsx 的先例:react-dom/client + React 19 act,
+// 不引入 @testing-library。用 createElement 而非 JSX——文件是 .ts 不是 .tsx。
+import { act, createElement, useEffect } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const THEME_ATTR = 'data-mivo-theme'
+
+let container: HTMLDivElement
+let root: Root
+let captured: string
+
+/** MutationObserver 回调是微任务派发,React 的 useSyncExternalStore 重渲染跟在
+ *  后面;等一个宏任务边界,保证两者都已落定(纯 Promise.resolve() 微任务链在不同
+ *  React 调度路径下深度不完全确定,宏任务边界更稳)。 */
+const flushAsync = () => new Promise<void>((resolve) => setTimeout(resolve, 0))
+
+beforeEach(async () => {
+  document.documentElement.removeAttribute(THEME_ATTR)
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+  captured = ''
+  // 每个测试拿一份全新的模块级单例(cachedTheme/listeners/observer),不跨测试残留
+  // 上一次的订阅者集合或缓存值。
+  vi.resetModules()
+})
+
+afterEach(() => {
+  act(() => {
+    root.unmount()
+  })
+  container.remove()
+  document.documentElement.removeAttribute(THEME_ATTR)
+})
+
