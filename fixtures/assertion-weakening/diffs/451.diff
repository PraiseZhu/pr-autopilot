+    expect(JSON.stringify(harness.hostRequests[0])).not.toContain('张三')
+  })
+
+  it('diag 日志区分 trigger=snapshot(不新增 DIAG_SOURCE,只加字段区分触发路径)', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://a')] })
+    readImportedAssetFileMock.mockResolvedValue({ name: 'a.png', type: 'image/png', blob: blobOfBytes(64), createdAt: 0 })
+    const logSpy = vi.spyOn(debugLogger, 'log')
+
+    const { ask } = wireBridge()
+    await ask('snapshot', { mediaNodeIds: ['img-1'] })
+
+    const hit = logSpy.mock.calls.find(([source, message]) => source === 'Cindy Deposit' && String(message).includes('trigger=snapshot'))
+    expect(hit).toBeTruthy()
