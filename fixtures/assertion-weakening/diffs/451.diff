+/**
+ * agentBridge.ts 的 snapshot 动词真实逐 id 媒体解析(#297 T3b1,设计稿
+ * §2.1.1「触发实现点」/§2.2/§2.3/§2.4/§2.5/§2.6/§2.7/§2.8/§4.7)。
+ *
+ * 覆盖 SC(T3b 预拆裁决:T3b1 = 不需要 deposit 通道通电的那一半):
+ *  - SC-T3b.1 唯一业务链:page.snapshot.nodes 校验 → store 回查原始
+ *    MivoCanvasNode → assetBlobForNode → resolveDepositEntry(唯一入口);
+ *    rg 接线锁(不直调无缓存原语 depositBlob、不自行写 depositMap);逐 id
+ *    catch/继续。
+ *  - SC-T3b.2 MediaNodeState 两态判别联合;reason 枚举全量;
+ *    available+unavailable=requested 恒等式;部分成功工具仍 ok:true;live 最终
+ *    对象含 mediaStates/mediaSummary;空/缺省 mediaNodeIds 字节级兼容且零 deposit。
+ *  - SC-T3b.3 要看才传(仅点名节点寄存);from:'deposit' 记账;同批重看零新增
+ *    配额;固定中性 label(敏感文件名/节点名夹具断言 payload 不含二者);diag
+ *    trigger:'edit'|'snapshot';不进 WRITE_VERBS 负断言 + 真实 undo 栈零增量。
+ *  - SC-T3b.5 mediaStates 方案 A 适配层 enrichment;回执只携带引用,永不内联
+ *    base64。
+ *
+ * 段边界:imageRef 按 T0 冻结契约解析 → 真实 Read → byteDigest 对账(SC-T3b.4)
+ * 需要 deposit 通道真正通电,归 T3b2(DoR = T1f),本文件不测、不声称交付。
+ *
+ * 端到端跑在真实 depositPort.ts/depositStore.ts + 真实 main.js(经
+ * depositTestHarness 的假宿主)之上,不是对着替身自说自话——与
+ * depositPort.test.ts 同一套基础设施,只是驱动方式换成真实 agentBridge.ts 的
+ * 'snapshot' 动词(经 brainHarness 的 ChannelBus,与 agentBridgeMediaNodeIds.test.ts
+ * 同一套桥接手法)。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.hoisted(() => {
+  const store = new Map<string, string>()
+  const memStorage = {
+    get length() {
+      return store.size
+    },
+    clear: () => store.clear(),
+    getItem: (key: string) => store.get(key) ?? null,
+    key: (index: number) => [...store.keys()][index] ?? null,
+    removeItem: (key: string) => {
+      store.delete(key)
+    },
+    setItem: (key: string, value: string) => {
+      store.set(key, String(value))
+    },
+  }
+  const globals = globalThis as Record<string, unknown>
+  if (globals.window === undefined) globals.window = { localStorage: memStorage }
+  if (globals.localStorage === undefined) globals.localStorage = memStorage
+})
+
+vi.mock('../../../src/lib/demoImages', () => ({ createDemoImage: () => 'data:image/png;base64,mock' }))
+vi.mock('../../../src/store/remoteDebugReporter', () => ({ reportRemoteDebugEntry: () => {} }))
+
+const flushPersistNowMock = vi.fn(async () => true)
+vi.mock('../persist/persistSync', () => ({
+  flushPersistNow: () => flushPersistNowMock(),
+  restoreFromDiskIfEmpty: async () => 'skipped',
+  startAutoSave: () => {},
+}))
+
+type ImportedAssetFile = { name: string; type: string; blob: Blob; createdAt: number }
+const readImportedAssetFileMock = vi.fn<(assetUrl?: string) => Promise<ImportedAssetFile | undefined>>()
+vi.mock('../../../src/lib/assetStorage', () => ({
+  saveGeneratedAsset: vi.fn(async () => ({ assetUrl: 'mivo-asset://mock', name: 'n', type: 'image/png' })),
+  saveImportedAsset: vi.fn(async () => ({ assetUrl: 'mivo-asset://mock-imported' })),
+  readImportedAssetFile: (assetUrl?: string) => readImportedAssetFileMock(assetUrl),
+}))
+
+// 有意不 mock '../persist/bridge':本文件要走真实 depositPort/depositStore 的
+// 传输注入点(setDepositMediaTransport/setDepositTransport,depositTestHarness
+// 已经这么做),不是对着一个手搓替身断言。
+
+import { ChannelBus, channelConstructorFor, flushUntil } from './brainHarness'
+import {
+  FAKE_HASH,
+  blobOfBytes,
+  createDepositHarness,
+  teardownDepositHarness,
+  type DepositHarness,
+} from './depositTestHarness'
+import { resetCanvasWriteGateForTests } from '../../../src/agent/canvasWriteGate'
+import { installAgentBridge, mediaFailureReasonFor } from '../agent/agentBridge'
+import { DepositError, setDepositSleepForTests, type DepositFailureCode } from '../agent/depositPort'
+import { lookupDeposit } from '../agent/depositStore'
+import { useCanvasStore } from '../../../src/store/canvasStore'
+import { debugLogger, useDebugLogStore } from '../../../src/store/debugLogStore'
+import type { MivoCanvasNode } from '../../../src/types/mivoCanvas'
+
+const CHANNEL = 'mivo-canvas-agent'
+
+/** 起一个独立总线 + 真实桥(与 depositTestHarness 内部的假 main.js 总线互不相关,
+ * 两者只通过 depositPort/depositStore 的模块级传输注入点耦合)。 */
+const wireBridge = () => {
+  const bus = new ChannelBus()
+  const globals = globalThis as Record<string, unknown>
+  const previous = globals.BroadcastChannel
+  globals.BroadcastChannel = channelConstructorFor(bus)
+  installAgentBridge()
+  globals.BroadcastChannel = previous
+
+  const brainSide = bus.open(CHANNEL)
+  let seq = 0
+  const ask = async (verb: string, params: Record<string, unknown> = {}): Promise<Record<string, unknown> | null> => {
+    seq += 1
+    const reqId = `probe-${seq}`
+    let reply: Record<string, unknown> | null = null
+    brainSide.onmessage = (event) => {
+      const data = event.data as Record<string, unknown> | undefined
+      if (data && data.reply === true && data.reqId === reqId) reply = data
+    }
+    brainSide.postMessage({ reqId, verb, params })
+    await flushUntil(() => reply !== null, { label: `agent 桥对动词 '${verb}' 的回执` })
+    return reply
+  }
+  return { ask }
+}
+
+const imageNode = (id: string, assetUrl: string, extra: Partial<MivoCanvasNode> = {}): MivoCanvasNode => ({
+  id,
+  type: 'image',
+  title: id,
+  x: 0,
+  y: 0,
+  width: 100,
+  height: 100,
+  status: 'ready',
+  assetUrl,
+  ...extra,
+})
+
+let harness: DepositHarness
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  flushPersistNowMock.mockImplementation(async () => true)
+  readImportedAssetFileMock.mockResolvedValue(undefined)
+  resetCanvasWriteGateForTests()
+  useDebugLogStore.getState().clear()
+  harness = createDepositHarness()
+  // 频控退避走真实 setTimeout(depositPort.ts 的编译期常量 DEPOSIT_RATE_RETRY_DELAY_MS
+  // = 1.1s);测试不用假时钟(brainHarness 的 flushUntil 只推进微任务,推不动真实
+  // 定时器),直接把退避睡眠替身成立即 resolve,与 depositPort.test.ts 同一手法。
+  setDepositSleepForTests(async () => {})
+})
+
+afterEach(() => {
+  setDepositSleepForTests(undefined)
+  teardownDepositHarness()
+  vi.unstubAllGlobals()
+})
+
+describe('SC-T3b.1 唯一业务链(rg 源码接线锁)', () => {
+  it('agentBridge.ts 只经 resolveDepositEntry 消费寄存,不直调 depositBlob、不 import depositStore', async () => {
+    const source = await import('node:fs/promises').then((fs) =>
+      fs.readFile(new URL('../agent/agentBridge.ts', import.meta.url), 'utf8'),
+    )
+    expect(source).toContain('resolveDepositEntry(')
+    expect(source).not.toMatch(/\bdepositBlob\(/)
+    expect(source).not.toMatch(/from '\.\/depositStore'/)
+  })
+})
+
+describe('SC-T3b.2 真实逐 id 解析:available/unavailable 判别联合', () => {
+  it('图片节点在页内 + 寄存成功 → available,imageRef=cindy-media://blobs/<hash><ext>,永不内联 base64(SC-T3b.5)', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://a')] })
+    readImportedAssetFileMock.mockResolvedValue({
+      name: 'a.png',
+      type: 'image/png',
+      blob: blobOfBytes(64),
+      createdAt: 0,
+    })
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1'] })
+
+    expect(reply).toMatchObject({ ok: true })
+    expect(reply?.mediaStates).toEqual({
+      'img-1': { state: 'available', imageRef: `cindy-media://blobs/${FAKE_HASH}.png` },
+    })
+    expect(reply?.mediaSummary).toEqual({ requested: 1, available: 1, unavailable: 0 })
+    // §4.7 定案:只携带引用——回执 JSON 里不出现 base64/data: 字样。
+    expect(JSON.stringify(reply)).not.toMatch(/data:image|base64/i)
+    await expect(lookupDeposit('mivo-asset://a')).resolves.toMatchObject({ hash: FAKE_HASH, from: 'deposit' })
+  })
+
+  it('id 不在这一页 → not_in_page,不查 store、不发寄存请求', async () => {
+    // 故意不把 'img-ghost' 放进 store:page.snapshot.nodes 里同样没有它。
+    useCanvasStore.setState({ nodes: [] })
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-ghost'] })
+
+    expect(reply?.mediaStates).toEqual({ 'img-ghost': { state: 'unavailable', reason: 'not_in_page' } })
+    expect(harness.hostRequests).toHaveLength(0)
+  })
+
+  it('id 在页内但不是图片类型 → not_image,不发寄存请求', async () => {
+    useCanvasStore.setState({
+      nodes: [
+        { id: 'note-1', type: 'text', title: 'note', x: 0, y: 0, width: 10, height: 10, status: 'ready' } as MivoCanvasNode,
+      ],
+    })
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['note-1'] })
+
+    expect(reply?.mediaStates).toEqual({ 'note-1': { state: 'unavailable', reason: 'not_image' } })
+    expect(harness.hostRequests).toHaveLength(0)
+  })
+
+  it('部分成功(2 个里 1 个 not_in_page)→ 工具整体仍 ok:true,available+unavailable=requested 恒等式成立', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://a')] })
+    readImportedAssetFileMock.mockResolvedValue({ name: 'a.png', type: 'image/png', blob: blobOfBytes(64), createdAt: 0 })
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1', 'img-missing'] })
+
+    expect(reply?.ok).toBe(true)
+    expect(reply?.mediaStates).toMatchObject({
+      'img-1': { state: 'available' },
+      'img-missing': { state: 'unavailable', reason: 'not_in_page' },
+    })
+    const summary = reply?.mediaSummary as { requested: number; available: number; unavailable: number }
+    expect(summary.available + summary.unavailable).toBe(summary.requested)
+    expect(summary).toEqual({ requested: 2, available: 1, unavailable: 1 })
+  })
+
+  it('宿主回执结构化配额两数命中 → quota_full', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://quota')] })
+    readImportedAssetFileMock.mockResolvedValue({ name: 'a.png', type: 'image/png', blob: blobOfBytes(64), createdAt: 0 })
+    harness.setHostReply(() => ({ ok: false, quotaUsedBytes: 100, quotaLimitBytes: 100 }))
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1'] })
+
+    expect(reply?.mediaStates).toEqual({ 'img-1': { state: 'unavailable', reason: 'quota_full' } })
+  })
+
+  it('宿主回执文案命中限流 → rate_limited(退避重试仍失败后如实上报,不阻断整单)', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://rl')] })
+    readImportedAssetFileMock.mockResolvedValue({ name: 'a.png', type: 'image/png', blob: blobOfBytes(64), createdAt: 0 })
+    harness.setHostReply(() => ({ ok: false, message: '请求过于频繁,请稍后再试' }))
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1'] })
+
+    expect(reply?.ok).toBe(true) // 单个 id 失败不阻断整次 snapshot 调用
+    expect(reply?.mediaStates).toEqual({ 'img-1': { state: 'unavailable', reason: 'rate_limited' } })
+  })
+
+  it('assetBlobForNode 取字节失败(读不到源图字节)→ unknown,不进入寄存链路', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://unreadable')] })
+    readImportedAssetFileMock.mockResolvedValue(undefined)
+    vi.stubGlobal('fetch', vi.fn(async () => ({ ok: false }) as Response))
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1'] })
+
+    expect(reply?.mediaStates).toEqual({ 'img-1': { state: 'unavailable', reason: 'unknown' } })
+    expect(harness.hostRequests).toHaveLength(0) // 从未到达 resolveDepositEntry
+  })
+
+  it('空数组 → 最终交卷对象不出现 mediaStates/mediaSummary,零寄存请求(字节级兼容)', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://a')] })
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: [] })
+
+    expect(reply).not.toHaveProperty('mediaStates')
+    expect(reply).not.toHaveProperty('mediaSummary')
+    expect(harness.hostRequests).toHaveLength(0)
+  })
+
+  it('未传 mediaNodeIds → 最终交卷对象不出现 mediaStates/mediaSummary,零寄存请求', async () => {
+    useCanvasStore.setState({ nodes: [imageNode('img-1', 'mivo-asset://a')] })
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot')
+
+    expect(reply).not.toHaveProperty('mediaStates')
+    expect(reply).not.toHaveProperty('mediaSummary')
+    expect(harness.hostRequests).toHaveLength(0)
+  })
+})
+
+describe('SC-T3b.2 reason 枚举全量(DepositFailureCode → MediaUnavailableReason 映射)', () => {
+  const cases: Array<[DepositFailureCode, string]> = [
+    ['TOO_LARGE', 'too_large'],
+    ['UNSUPPORTED_MIME', 'unsupported_type'],
+    ['QUOTA_FULL', 'quota_full'],
+    ['RATE_LIMITED', 'rate_limited'],
+    ['HOST_UNSUPPORTED', 'host_unsupported_kind'],
+    ['BRAIN_TIMEOUT', 'host_unresponsive'],
+    ['BAD_RECEIPT', 'unknown'],
+    ['DEPOSIT_FAILED', 'unknown'],
+  ]
+
+  for (const [code, reason] of cases) {
+    it(`DepositError(${code}) → reason=${reason}`, () => {
+      expect(mediaFailureReasonFor(new DepositError(code, 'x'))).toBe(reason)
+    })
+  }
+
+  it('非 DepositError 的异常 → unknown 兜底', () => {
+    expect(mediaFailureReasonFor(new Error('boom'))).toBe('unknown')
+    expect(mediaFailureReasonFor('not even an error')).toBe('unknown')
+  })
+})
+
