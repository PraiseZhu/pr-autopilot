+/**
+ * 选中观测组的原子派生(#297 T2a2,与共享层 `deriveSelectedImageObservation`
+ * `src/agent/snapshotRegion.ts` 同规则):对原始 snapshot 的 selectedNodeIds、
+ * 裁剪到「结果集」(离线路径无过滤 → 整份快照的节点)。
+ */
+function deriveSelectedImageObservation(rawSelectedNodeIds, includedIds, nodesById) {
+  const selectedIncluded = (Array.isArray(rawSelectedNodeIds) ? rawSelectedNodeIds : []).filter((id) =>
+    includedIds.has(id),
+  )
+  const selectedImageIds = selectedIncluded.filter((id) => {
+    const found = nodesById.get(id)
+    return Boolean(found) && found.type === 'image'
+  })
+  const truncated = selectedImageIds.length > SNAPSHOT_MAX_SELECTED_IMAGE_NODE_IDS
+  const result = {
+    selectedImageNodeIds: truncated
+      ? selectedImageIds.slice(0, SNAPSHOT_MAX_SELECTED_IMAGE_NODE_IDS)
+      : selectedImageIds,
+    selectedNodeCount: selectedIncluded.length,
+  }
+  if (truncated) result.selectedImageNodesTruncated = true
+  return result
+}
