@@ -0,0 +1,600 @@
+// remoteDebugReporter FX-7 durable outbox + retry + drop count 用例(v4 段,从 remoteDebugReporter.test.ts 拆出,① structure-guard 拆分)。
+//
+// 拆分理由:remoteDebugReporter.test.ts 1036 行越 structure-guard 的 900 绝对线(#591 CI structure guard 红灯)。
+// 本文件承载 FX-7 durable outbox + exponential-backoff retry + drop count 用例;基础行为、createId/stack/
+// 出网脱敏、模块级初始值锁用例留在主文件(remoteDebugReporter.test.ts)。
+//
+// 内容为原样搬移(拆分等价),断言零改动;主文件与本文各自独立跑,共享的 IndexedDB 底层
+// (按 DB_NAME 持久化)由各 describe 的 afterEach 清理,跨文件互不污染。
+
+import 'fake-indexeddb/auto'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { useDebugLogStore } from './debugLogStore'
+import {
+  __resetRemoteDebugStateForTest,
+  __setRemoteDebugTestHooks,
+  drainRemoteDebugOutbox,
+  flushRemoteDebugEntries,
+  getRemoteDebugDropCount,
+  getRemoteDebugOutboxCount,
+  reportRemoteDebugEntry,
+  type RemoteDebugClientInfo,
+} from './remoteDebugReporter'
+
+// ── FX-7: durable outbox + exponential-backoff retry + drop count (A6 · D-4 hard prereq) ──
+
+const fixedClientInfo = (): RemoteDebugClientInfo => ({
+  clientId: 'client-fixed',
+  sessionId: 'session-fixed',
+  appVersion: '0.0.0-test',
+  pagePath: '/canvas',
+  userAgent: 'TestBrowser',
+  language: 'en',
+  timezone: 'UTC',
+  screen: { width: 1440, height: 900, pixelRatio: 2 },
+})
+
+describe('FX-7 remoteDebugReporter durable outbox + retry + drop count', () => {
+  beforeEach(async () => {
+    vi.clearAllMocks()
+    await __resetRemoteDebugStateForTest()
+  })
+  afterEach(async () => {
+    vi.unstubAllGlobals()
+    await __resetRemoteDebugStateForTest()
+  })
+
+  it('SC1: a failed batch persists to the durable outbox, recovers on resend, and is not lost', async () => {
+    const sentPayloads: { entries: Array<{ message: string }> }[] = []
+    let shouldFail = true
+    const fetchMock = vi.fn(async (_url: unknown, init: { body?: string }) => {
+      if (shouldFail) throw new Error('network down (BFF jitter)')
+      sentPayloads.push(JSON.parse(init.body ?? '{}'))
+      return new Response('{}', { status: 200 })
+    })
+    let clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: fetchMock as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5, // deterministic jitter → 0.75 of capped delay
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+
+    // Report an error entry; flush immediately (batch is the single entry).
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1000 })
+    await flushRemoteDebugEntries()
+
+    // The batch failed to send but was NOT lost — it landed in the durable IDB outbox,
+    // and the drop count is still 0 (retry is not yet exhausted).
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+
+    // Simulate BFF recovery: fetch now succeeds. Advance the clock past the record's
+    // backoff window so it is due, then drain the durable outbox.
+    shouldFail = false
+    clock += 10_000
+    const result = await drainRemoteDebugOutbox()
+
+    expect(result.sent).toBe(1)
+    expect(result.dropped).toBe(0)
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+    // The original batch was actually delivered (not lost): its entry survived the
+    // failed flush + durable round-trip.
+    expect(sentPayloads).toHaveLength(1)
+    expect(sentPayloads[0].entries[0].message).toBe('boom')
+  })
+
+  it('SC2: after the retry limit the drop count increments and is queryable', async () => {
+    const fetchMock = vi.fn(async () => {
+      throw new Error('network down (BFF permanently unreachable)')
+    })
+    let clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: fetchMock as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1000 })
+    await flushRemoteDebugEntries() // batch fails → durable outbox (attempts=0)
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+
+    // DEFAULT_MAX_RETRIES = 5. Each drain (clock advanced past the record's backoff
+    // window) fails and bumps attempts; on the 5th retry attempt (attempts reaches
+    // 5 >= maxRetries) the batch is dropped + counted. The clock is advanced before the
+    // FIRST drain too, because persistFailedBatch set nextAttemptAt = now + backoff(1)
+    // (so the record is not due at clock=1000 immediately after the failed flush).
+    let last: { dropped: number } = { dropped: 0 }
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      clock += 100_000 // well past any backoff window so the record is due
+      last = await drainRemoteDebugOutbox()
+    }
+    // The 5th retry attempt drops the batch (attempts=5 >= maxRetries).
+    expect(last.dropped).toBe(1)
+    // Drop count is persisted + queryable.
+    expect(await getRemoteDebugDropCount()).toBe(1)
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+    // 1 initial flush send + 5 retry sends, all failed.
+    expect(fetchMock).toHaveBeenCalledTimes(6)
+  })
+
+  it('F-A1-03(R2 fix): 2xx 送达后 outbox 记录删不掉时,attempts 仍递增并最终计入 drop(不会永远 due)', async () => {
+    // 第一次 flush 网络失败,把这一批放进 outbox(attempts=0)。
+    const initialFailFetch = vi.fn(async () => {
+      throw new Error('network down (BFF jitter)')
+    })
+    let clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: initialFailFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1000 })
+    await flushRemoteDebugEntries()
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+
+    // 之后每次 drain 都"送达成功"(2xx),但 outbox 记录删不掉 —— 用 fake-indexeddb 原型打断
+    // 前 5 次 delete 调用,第 6 次(第 5 轮 drop 分支里的 best-effort 补删)放行,验证记录最终
+    // 被真正清理而不是永远残留。
+    const deliveredFetch = vi.fn(async () => new Response('{}', { status: 200 }))
+    __setRemoteDebugTestHooks({
+      fetchImpl: deliveredFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+    const originalDelete = IDBObjectStore.prototype.delete
+    let deleteCallCount = 0
+    const deleteSpy = vi
+      .spyOn(IDBObjectStore.prototype, 'delete')
+      .mockImplementation(function (this: IDBObjectStore, query?: IDBValidKey | IDBKeyRange) {
+        deleteCallCount += 1
+        if (deleteCallCount <= 5) throw new Error('delete blocked (quota lockdown)')
+        return originalDelete.call(this, query as IDBValidKey)
+      })
+
+    let last: { sent: number; retained: number; dropped: number } = { sent: 0, retained: 0, dropped: 0 }
+    for (let attempt = 1; attempt <= 5; attempt++) {
+      clock += 100_000
+      last = await drainRemoteDebugOutbox()
+      if (attempt < 5) {
+        // 反向变异对照:退掉本轮修复(删不掉时不抛错,直接当成功)会让这里变成
+        // {sent:1,retained:0,dropped:0}(误判已投递并清空 outbox),而不是 retained:1
+        // (仍受重试上限约束)。
+        expect(last).toMatchObject({ sent: 0, retained: 1, dropped: 0 })
+      }
+    }
+    deleteSpy.mockRestore()
+
+    // 送达从未失败过(deliveredFetch 一直 2xx)—— 5 次全部是"送达成功但删不掉"而非网络
+    // 失败,证明重试上限确实施加于"删除失败"这一失败模式,不只是"发送失败"。
+    expect(deliveredFetch).toHaveBeenCalledTimes(5)
+    expect(last.dropped).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(1)
+    // 第 6 次 delete 调用(drop 分支的 best-effort 补删)放行后记录被真正清理。
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+  })
+
+  it('F-A1-03(R3 fix):delete 恒抛(不限次)时,重投与 drop 计数最终都停止增长,记录不再被重发', async () => {
+    // 硬要求(R3 任务书):stub 不得构造成让残余缺陷不可见——上一轮的测试只让 delete
+    // 失败 5 次、第 6 次放行,刚好卡在重试上限边界,"持续删除失败"这个真实场景从未出现。
+    // 本轮把边界推远:delete 恒抛,不限次。
+    const initialFailFetch = vi.fn(async () => {
+      throw new Error('network down (BFF jitter)')
+    })
+    let clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: initialFailFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1000 })
+    await flushRemoteDebugEntries()
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+
+    const deliveredFetch = vi.fn(async () => new Response('{}', { status: 200 }))
+    __setRemoteDebugTestHooks({
+      fetchImpl: deliveredFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+    const deleteSpy = vi.spyOn(IDBObjectStore.prototype, 'delete').mockImplementation(() => {
+      throw new Error('delete blocked (quota lockdown, permanent)')
+    })
+
+    const sendsAfterRound: number[] = []
+    const dropAfterRound: number[] = []
+    for (let round = 1; round <= 10; round++) {
+      clock += 100_000
+      await drainRemoteDebugOutbox()
+      sendsAfterRound.push(deliveredFetch.mock.calls.length)
+      dropAfterRound.push(await getRemoteDebugDropCount())
+    }
+    deleteSpy.mockRestore()
+
+    // 修复前的形状(①席 10 轮实测):dropCount 持续增长([0,0,0,0,1,2,2,2,3,4] 一类),
+    // outboxCount 全程 =1,记录从未清理。修复后的形状——本测试断言的就是这个对照:
+    // 到达重试上限(第 5 轮)后,发送次数与 drop 计数都不再增长(记录被标记终态,
+    // 不再被 due 过滤选中,不会再重发、也不会再虚增 drop)。
+    expect(sendsAfterRound.slice(4)).toEqual(new Array(6).fill(sendsAfterRound[4])) // 第5轮起发送次数不再增长
+    expect(dropAfterRound.slice(4)).toEqual(new Array(6).fill(1)) // drop 恰好计 1 次,此后不再增长
+    expect(deliveredFetch).toHaveBeenCalledTimes(5) // 只有前 5 次(到达上限之前)真正发送过
+
+    // 留痕存在:本地 Debug Log 有一条"标记终态,停止重发"的 error 级痕迹。
+    const messages = useDebugLogStore.getState().entries.filter((e) => e.source === 'Remote Debug')
+    expect(messages.some((e) => e.level === 'error' && e.message.includes('marked terminal to stop further resends'))).toBe(
+      true,
+    )
+  })
+
+  it('F-A1-03(R3 fix)对照组:delete 只失败一次随后成功 → 正常投递完成,不会被误标终态', async () => {
+    const initialFailFetch = vi.fn(async () => {
+      throw new Error('network down (BFF jitter)')
+    })
+    let clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: initialFailFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1000 })
+    await flushRemoteDebugEntries()
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+
+    const deliveredFetch = vi.fn(async () => new Response('{}', { status: 200 }))
+    __setRemoteDebugTestHooks({
+      fetchImpl: deliveredFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+    const originalDelete = IDBObjectStore.prototype.delete
+    let deleteCallCount = 0
+    const deleteSpy = vi
+      .spyOn(IDBObjectStore.prototype, 'delete')
+      .mockImplementation(function (this: IDBObjectStore, query?: IDBValidKey | IDBKeyRange) {
+        deleteCallCount += 1
+        if (deleteCallCount === 1) throw new Error('delete blocked (transient)')
+        return originalDelete.call(this, query as IDBValidKey)
+      })
+
+    clock += 100_000
+    const firstDrain = await drainRemoteDebugOutbox() // 送达成功但删不掉一次 → retained
+    expect(firstDrain).toMatchObject({ sent: 0, retained: 1, dropped: 0 })
+    clock += 100_000
+    const secondDrain = await drainRemoteDebugOutbox() // 再次送达且删除成功 → 正常完成
+    deleteSpy.mockRestore()
+
+    expect(secondDrain).toMatchObject({ sent: 1, retained: 0, dropped: 0 })
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+  })
+
+  it('R3b fix:enforceOutboxCapacity 驱逐失败时不虚增 drop 计数,日志如实说"驱逐失败"而非声称已驱逐', async () => {
+    // enforceOutboxCapacity 此前把 deleteOutbox 的返回值丢掉——驱逐失败时仍无条件
+    // incrementDropCount 并在日志里声称 "evicted"，是与 drop 分支同一个"丢弃返回值"形状的
+    // 缺陷，且日志本身在失败路径上宣称成功（运行时版本的失准声明）。
+    const alwaysFailFetch = vi.fn(async () => {
+      throw new Error('network down')
+    })
+    const clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: alwaysFailFetch as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      buildClientInfo: fixedClientInfo,
+      enabled: true,
+    })
+
+    // 填满到 DEFAULT_MAX_OUTBOX(64)条记录——第 65 条写入前 enforceOutboxCapacity 才会
+    // 真正触发驱逐尝试（`existing.length >= 64`）。clock 恒定不前进：所有记录的
+    // nextAttemptAt 都在未来，不会被任何后台 drain 定时器意外处理，测试的确定性不受
+    // scheduleOutboxDrain 真实定时器影响。
+    for (let i = 0; i < 64; i++) {
+      reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: `seed-${i}`, timestamp: 1000 + i })
+      await flushRemoteDebugEntries()
+    }
+    expect(await getRemoteDebugOutboxCount()).toBe(64)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+
+    // 打断 delete(恒抛，不限次),再写入第 65 条 → enforceOutboxCapacity 尝试驱逐最旧的
+    // 一条,但删不掉。
+    const deleteSpy = vi.spyOn(IDBObjectStore.prototype, 'delete').mockImplementation(() => {
+      throw new Error('delete blocked (quota lockdown, permanent)')
+    })
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'overflow', timestamp: 2000 })
+    await flushRemoteDebugEntries()
+    deleteSpy.mockRestore()
+
+    // 反向变异对照:退掉修复(丢弃返回值)会让这里变成 1(驱逐失败也被计入一次 drop)。
+    expect(await getRemoteDebugDropCount()).toBe(0)
+    // 容量确实没释放:64 条旧记录 + 1 条新写入的记录都还在(驱逐没有真正发生)。
+    expect(await getRemoteDebugOutboxCount()).toBe(65)
+    // 日志如实反映驱逐失败,不写"evicted"这种声称已成功的措辞。
+    const messages = useDebugLogStore.getState().entries.filter((e) => e.source === 'Remote Debug')
+    expect(
+      messages.some(
+        (e) =>
+          e.level === 'error' &&
+          e.message.includes('eviction of oldest batch') &&
+          e.message.includes('failed') &&
+          e.message.includes('capacity NOT released'),
+      ),
+    ).toBe(true)
+    expect(messages.some((e) => e.message.includes('evicted oldest batch'))).toBe(false)
+  })
+
+  it('R1 fix ③:终态记录不再触发空 drain 0ms 自激(全终态时不 re-arm 定时器)', async () => {
+    // 机制(R1 三席共识,②席报):drain 的 due 过滤排除 terminal,但 scheduleOutboxDrain 的
+    // earliest 计算不排除 —— 全终态时 earliest 取到终态记录的过期 nextAttemptAt,delay 恒为
+    // 0,而 drain 又是空跑,尾部还无条件 re-arm → 无限 0ms 自激。修法:两处判据统一。
+    // 反向变异对照:退回"earliest 不排除 terminal / 尾部无条件 re-arm"会让下面的
+    // `getTimerCount() === 0` 恰好变红(终态后每轮 drain 尾部都会再排一个 0ms timer)。
+    vi.useFakeTimers({ toFake: ['setTimeout', 'clearTimeout'] })
+    try {
+      const initialFailFetch = vi.fn(async () => {
+        throw new Error('network down (BFF jitter)')
+      })
+      let clock = 1000
+      __setRemoteDebugTestHooks({
+        fetchImpl: initialFailFetch as unknown as typeof fetch,
+        now: () => clock,
+        random: () => 0.5,
+        buildClientInfo: fixedClientInfo,
+        enabled: true,
+      })
+      reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1000 })
+      await flushRemoteDebugEntries()
+      expect(await getRemoteDebugOutboxCount()).toBe(1)
+
