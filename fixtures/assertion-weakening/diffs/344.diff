 .canvas-tool-dock,
-.canvas-tool-flyout,
-.canvas-controls {
+.canvas-tool-flyout {
   background: color-mix(in srgb, var(--surface-elevated, #fffaf0) 94%, var(--text-primary, #232323) 6%);
   border-color: color-mix(in srgb, var(--text-primary, #232323) 16%, var(--border-default, #d6d0c6));
 }
@@ -54,16 +52,14 @@
    面板嵌套在 flyout 内,内部控件由下方专属规则接管,不能被这里覆盖。 */
 .canvas-tool-dock > button,
 .canvas-tool-dock .canvas-tool-group > button,
-.canvas-tool-dock .canvas-tool-flyout > button,
-.canvas-controls button {
+.canvas-tool-dock .canvas-tool-flyout > button {
   color: color-mix(in srgb, var(--text-primary, #554f48) 78%, var(--surface, #fffaf0));
 }
 
 /* 悬停 = 轻水洗(不再整块反色,消除 Dark 下的白色大亮斑) */
 .canvas-tool-dock > button:hover:not(.active):not(:disabled),
 .canvas-tool-dock .canvas-tool-group > button:hover:not(.active):not(:disabled),
-.canvas-tool-dock .canvas-tool-flyout > button:hover:not(.active):not(:disabled),
-.canvas-controls button:hover:not(:disabled) {
+.canvas-tool-dock .canvas-tool-flyout > button:hover:not(.active):not(:disabled) {
   color: var(--text-primary, #232323);
   background: color-mix(in srgb, var(--text-primary, #232323) 10%, transparent);
 }
