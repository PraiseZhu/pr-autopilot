diff --git a/scripts/e2e/nightly-matrix-contract.test.mjs b/scripts/e2e/nightly-matrix-contract.test.mjs
new file mode 100644
index 00000000..cce8aa65
--- /dev/null
+++ b/scripts/e2e/nightly-matrix-contract.test.mjs
@@ -0,0 +1,114 @@
+// scripts/e2e/nightly-matrix-contract.test.mjs — B2:nightly-e2e.yml 矩阵字面量 ↔ scenarioOrder
+// 一致性哨兵(PR 期拦截,替代"只在夜间响"的兜底)。
+//
+// 动机(issue #561 沿革):workflow 里 `--expect-total 148` 是字面量,而真实矩阵
+// 148 = scenarioOrder(37) × renderer(2) × kernel(2)。B1 的 ledger-aggregate 校验器
+// 兜底只在夜间运行响应(scenarioOrder 变多 → 实际格数 ≠ expect-total → aggregate job
+// 红),PR 期场景数/形状变了不响。本条把 workflow 字面量与 scenarioOrder 绑到一处,
+// CI test:unit(vitest run)PR 期即拦,不必等夜间。
+//
+// 契约范围刻意窄:只 import scenarioOrder,不 import ledger-aggregate/summary——
+// 本测试管的是「workflow 字面量与场景数一致」,与校验器实现无关(职责分离)。
+//
+// 反向变异契约(SC-N,与 B1 ledger-aggregate.test.mjs 同款纪律):每一条拒绝规则对应
+// 一个变异,变异 = 在**临时副本** workflow 上违反单个规则,跑本文件断言实际红集 ==
+// 跑前写下的预测红集。预测红集写在每个变异 ID 注释里。
+// 隔离原则 = 红集**可预测**,不是红集**单元素**:一个变异破坏前置条件时,前置检查
+// 与依赖它的断言双双变红是正确行为;为把红集压成 1 条而给断言开「返回而不断言」
+// 的早退路径,代价是断言恒真——那个交换永远不值得。
+//
+//   M1  --expect-total 改数(148→150) → 预测 {主断言}(提取 it 全过,只主断言红)
+//   M2  kernel 列表 2 项 → 1 项       → 预测 {主断言}(kernel 提取 it 只解析不设数量
+//                                         门槛,1 项合法;主断言 148≠37×2×1=74 红)
+//   M3  删掉 --renderer=both          → 预测 {renderer 存在 it, 主断言}(前置条件被
+//                                         破坏 → 前置检查与依赖它的断言双双变红)
+//
+// 路径解析:workflow 用相对本文件的 URL(CI 与本地 cwd 可能不同,禁 process.cwd())。
+// 默认路径必须是真实相对路径;NIGHTLY_E2E_WORKFLOW_PATH 仅供变异验证注入,不改默认值。
+
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { scenarioOrder } from './scenarios/index.mjs'
+
+const DEFAULT_WORKFLOW_PATH = fileURLToPath(
+  new URL('../../.github/workflows/nightly-e2e.yml', import.meta.url),
+)
+// 变异验证注入点(默认保持真实相对路径,不为了可测性改默认值)。
+const workflowPath = process.env.NIGHTLY_E2E_WORKFLOW_PATH || DEFAULT_WORKFLOW_PATH
+
+// ── 三个提取器,全部 fail-closed:提取不到/形状异常即抛错,绝不静默返回缺省 ──────
+
+// --expect-total 字面量:必须恰好出现 1 次(0 次 = 校验器没接上;≥2 次 = 有第二条
+// 校验链路没被更新,两处一起漂)。
+function extractExpectTotal(workflow) {
+  const matches = [...workflow.matchAll(/--expect-total\s+(\d+)/g)]
+  if (matches.length !== 1) {
+    throw new Error(
+      `--expect-total 字面量必须恰好出现 1 次,实际 ${matches.length} 次` +
+        (matches.length > 0
+          ? `(命中值:${matches.map((m) => m[1]).join(', ')})`
+          : '——校验器可能没接上或参数名已改'),
+    )
+  }
+  return Number(matches[0][1])
+}
+
+// matrix.kernel 列表:必须恰好 1 个 YAML 数组定义,且条目数 ≥1(0 条目 = 空矩阵,
+// 整条链没跑,不是"合法 0 kernel")。
+function extractKernelCount(workflow) {
+  const matches = [...workflow.matchAll(/kernel:\s*\[([^\]]*)\]/g)]
+  if (matches.length !== 1) {
+    throw new Error(
+      `matrix kernel 列表定义必须恰好出现 1 次,实际 ${matches.length} 次` +
+        (matches.length > 0 ? '(多条 kernel: 定义 = 矩阵形状不确定)' : '——matrix 定义缺失或语法已改'),
+    )
+  }
+  const items = matches[0][1]
+    .split(',')
+    .map((s) => s.trim())
+    .filter(Boolean)
+  if (items.length < 1) {
+    throw new Error('matrix kernel 列表为空——空矩阵意味着整条链不会跑,不是合法状态')
+  }
+  return items.length
+}
+
+// --renderer=both:必须存在。renderer 数由它推出为 2(将来改成单 renderer 时,
+// 找不到 --renderer=both 即抛,提示更新本契约)。
+function extractRendererCount(workflow) {
+  if (!workflow.includes('--renderer=both')) {
+    throw new Error("必须包含 --renderer=both(renderer 矩阵由它驱动;缺失 = 形状变化或接线被拆)")
+  }
+  return 2
+}
+
+describe('nightly-e2e.yml 矩阵字面量 ↔ scenarioOrder 契约', () => {
+  const workflow = readFileSync(workflowPath, 'utf8')
+
+  it('--expect-total 字面量恰好出现一次', () => {
+    // 真断言:提取器 fail-closed,在真实文件上触发即红;值比较交给主断言。
+    expect(() => extractExpectTotal(workflow)).not.toThrow()
+  })
+
+  it('matrix kernel 列表定义恰好一个且条目数 ≥1', () => {
+    expect(() => extractKernelCount(workflow)).not.toThrow()
+  })
+
+  it('--renderer=both 必须存在', () => {
+    expect(() => extractRendererCount(workflow)).not.toThrow()
+  })
+
+  // 漂移哨兵主断言:workflow 字面量必须 == scenarioOrder × renderer × kernel。
+  // 形状(kernel 数 / renderer 数)变化时从 workflow 实际提取再乘,自动适配;
+  // 场景数变化时 scenarioOrder.length 变 → 与字面量不符即红。
+  // fail-closed:renderer 缺失时 extractRendererCount 直接抛 → 本断言红,
+  // 绝不"返回而不断言"地报绿。
+  it('expectTotal === scenarioOrder.length × rendererCount × kernelCount', () => {
+    const expectTotal = extractExpectTotal(workflow)
+    const kernelCount = extractKernelCount(workflow)
+    const rendererCount = extractRendererCount(workflow)
+    const expected = scenarioOrder.length * rendererCount * kernelCount
+    expect(expectTotal).toBe(expected)
+  })
+})
