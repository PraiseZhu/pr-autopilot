new file mode 100644
index 00000000..a6170369
--- /dev/null
+++ b/scripts/bench/image-mem-gate-mutation-check.mjs
@@ -0,0 +1,96 @@
+// image-mem-gate-mutation-check — 证据门拒收分支的测试覆盖自查(#580 review 第 7 条)。
+//
+// 为什么需要它:契约测试「全绿」只说明**已写的**断言成立,不说明每个拒收分支都真被咬住。
+// #580 review 把 image-mem-gate.mjs 里每个 throw 的判定逐个中和成 `if (false)` 重跑契约测试,
+// 发现 24 个分支里有 9 个中和掉**不产生任何测试失败** —— 也就是说那些判据写错(比较方向反了、
+// 漏一个 `!`)同样不会有人发现,而 PR 正文当时声称 contract test 钉住了「各点拒收行为」。
+//
+// 这个脚本把那次人工检查固化下来:
+//   1. 逐个把「紧跟 throw 的 if 判定」改成 `if (false)`;
+//   2. 每次变异后跑契约测试;
+//   3. 测试仍然全绿 = 该分支**没有**测试保护(变异存活),列出来。
+// 存活数应为 0。改门或加门之后跑一遍,能立刻看出新分支有没有配套的拒收测试。
+//
+// 用法:node scripts/bench/image-mem-gate-mutation-check.mjs
+// 不改动任何文件(结束前无条件恢复原文,含异常路径);只读跑测试,几十秒级。
+
+import { spawnSync } from 'node:child_process'
+import { readFileSync, writeFileSync } from 'node:fs'
+import { dirname, join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import process from 'node:process'
+
+const here = dirname(fileURLToPath(import.meta.url))
+const projectRoot = resolve(here, '..', '..')
+const gatePath = join(here, 'image-mem-gate.mjs')
+const testPath = 'scripts/bench/image-mem-gate.contract.test.ts'
+
+/** 找出「其后 3 行内出现 throw new Error」的 if 判定行号(0-based)。 */
+const findRejectionBranches = (lines) => {
+  const targets = []
+  for (let i = 0; i < lines.length; i += 1) {
+    const text = lines[i].trim()
+    if (!text.startsWith('if (')) continue
+    if (!text.endsWith('{') && !text.endsWith(')')) continue
+    const lookahead = text.endsWith('{') ? 4 : 3
+    for (let j = i + 1; j < Math.min(i + lookahead, lines.length); j += 1) {
+      if (lines[j].includes('throw new Error')) {
+        targets.push(i)
+        break
+      }
+    }
+  }
+  return targets
+}
+
+const runContractTests = () =>
+  spawnSync('npx', ['vitest', 'run', testPath, '--reporter=dot'], {
+    cwd: projectRoot,
+    encoding: 'utf8',
+  })
+
+const main = () => {
+  const original = readFileSync(gatePath, 'utf8')
+  const lines = original.split('\n')
+  const targets = findRejectionBranches(lines)
+  console.log(`[gate-mutation] 待检查的拒收分支: ${targets.length} 个`)
+
+  // 先跑一次 pristine 对照组:基线本身必须全绿,否则"变异后仍绿"这个判据没有意义。
+  const pristine = runContractTests()
+  if (pristine.status !== 0) {
+    console.error('[gate-mutation] pristine 对照组就没全绿 —— 先修好契约测试再跑变异检查')
+    console.error(pristine.stdout || pristine.stderr)
+    process.exitCode = 1
+    return
+  }
+
+  const survivors = []
+  try {
+    for (const index of targets) {
+      const mutated = [...lines]
+      const source = mutated[index]
+      const indent = source.slice(0, source.length - source.trimStart().length)
+      mutated[index] = source.trimEnd().endsWith('{') ? `${indent}if (false) {` : `${indent}if (false)`
+      writeFileSync(gatePath, mutated.join('\n'))
+      if (runContractTests().status === 0) {
+        survivors.push({ line: index + 1, source: source.trim() })
+      }
+    }
+  } finally {
+    // 无条件恢复:异常/中断都不留下被变异的门文件。
+    writeFileSync(gatePath, original)
+  }
+
+  if (!survivors.length) {
+    console.log(`[gate-mutation] OK — ${targets.length} 个拒收分支全部有测试保护(零存活)`)
+    return
+  }
+  console.error(`[gate-mutation] ${survivors.length}/${targets.length} 个拒收分支**没有**测试保护(变异存活):`)
+  for (const survivor of survivors) {
+    console.error(`  image-mem-gate.mjs:${survivor.line}  ${survivor.source}`)
+  }
+  console.error('[gate-mutation] 给每个存活分支补一条构造刚好越界输入、断言 toThrow 且消息可定位的拒收测试。')
+  process.exitCode = 1
+}
+
+main()
