+/**
+ * canvas_snapshot 测试夹具——从 brainSnapshot.test.ts 抽出,供该文件与
+ * brainSnapshotMedia.test.ts 共享(2026-08-02,#297 T3 拆分:brainSnapshot.test.ts
+ * 越过 800 行红线,详见 brainSnapshotMedia.test.ts 文件头)。
+ */
+import { loadBrain } from './brainHarness'
+import type { LoadBrainOptions, LoadedBrain } from './brainHarness'
+import type { AiCanvasContextNode, AiCanvasContextSnapshot, CanvasEdge } from '../../../src/types/mivoCanvas'
+
+export const closedPanelBrain = (options: LoadBrainOptions = {}) => loadBrain({ panelPresent: () => false, ...options })
+
+export const node = (id: string, extra: Partial<AiCanvasContextNode> = {}): AiCanvasContextNode => ({
+  id,
+  type: 'text',
+  title: id,
+  bounds: { x: 0, y: 0, width: 100, height: 100 },
+  status: 'ready',
+  ...extra,
+})
+
+export const snapshotFixture = (nodes: AiCanvasContextNode[], edges: CanvasEdge[] = []): AiCanvasContextSnapshot => ({
+  version: 1,
+  sceneId: 'scene-offline',
+  selectedNodeIds: ['n-0'],
+  summary: {
+    nodes: nodes.length,
+    images: nodes.filter((item) => item.type === 'image').length,
+    slots: 0,
+    annotations: 0,
+    results: 0,
+  },
+  nodes,
+  edges,
+  links: [],
+})
+
+/** 装一个「面板在线」的假面板:按 scenario 回应 agent 动词请求,并记录收到的参数。 */
+export const withPanel = (brain: LoadedBrain, reply: Record<string, unknown>) => {
+  const seen: Array<{ verb?: string; params?: Record<string, unknown> }> = []
+  const agent = brain.bus.open('mivo-canvas-agent')
+  agent.onmessage = (event) => {
+    const request = event.data as { reqId?: string; verb?: string; params?: Record<string, unknown> }
+    if (!request || typeof request.reqId !== 'string') return
+    seen.push({ verb: request.verb, params: request.params })
+    agent.postMessage({ reqId: request.reqId, reply: true, ...reply })
+  }
+  return seen
+}
+
+export const lastResult = (brain: LoadedBrain) => {
+  const sent = brain.cindySent.filter(
+    (item): item is { type: string; ok: boolean; result?: Record<string, unknown>; errorCode?: string; message?: string } =>
+      Boolean(item) && (item as { type?: string }).type === 'tool-result',
+  )
+  return sent.at(-1)
+}
