+/**
+ * canvas_snapshot mediaNodeIds 测试(从 brainSnapshot.test.ts 拆出)。
+ *
+ * 拆分原因(2026-08-02,#297 T3 拆分):brainSnapshot.test.ts 加上本段内容后
+ * 越过团队 800 行硬红线,按语义边界(mediaNodeIds 暗态运输/校验/offline 合成,
+ * 与其余 canvas_snapshot 分页/离线降级测试是两个独立话题)整段搬迁到本文件,
+ * 断言与测试名逐字未改。共享夹具(loadBrain 之外的 closedPanelBrain/node/
+ * snapshotFixture/withPanel/lastResult)见 brainSnapshotFixtures.ts。
+ *
+ * #297 T3a:mediaNodeIds 暗态运输 + 两份独立校验 + offline/假 host egress。
+ *
+ * 段边界(设计稿 §2.1.1-②③④/§2.10,SC-T3a.1/T3a.2):本段只验参数运输端到端、
+ * 整单校验(非法形状 fail-fast)、offline 合成(每 id = panel_closed)、main.js
+ * 侧 egress 透传合约(用假 host 回执代表未来 T3b 的真实产出,只验证"面板给了就
+ * 原样带上",不代表这份内容有真实语义)。真实逐 id 解析(not_in_page/not_image/
+ * byte-failure)、reason 全量映射、live 路径的 mediaSummary/partial 全部归 T3b,
+ * 本文件不测这些——测了就是本段声称了不该声称的交付。ghost.json 本段不暴露该
+ * 参数,以下用例都是直接构造 args,模拟"参数已经到达"这一暗态路径。
+ */
+import { describe, expect, it } from 'vitest'
+import { loadBrain } from './brainHarness'
+import { closedPanelBrain, lastResult, node, snapshotFixture, withPanel } from './brainSnapshotFixtures'
+
+describe('canvas_snapshot mediaNodeIds 参数运输 + 校验 + offline 合成(#297 T3a,暗态)', () => {
+  it('合法 mediaNodeIds 原样透传给面板动词(参数运输端到端)', async () => {
+    const brain = loadBrain()
+    const seen = withPanel(brain, { ok: true, snapshot: { version: 1, nodes: [] }, truncated: false })
+    await brain.handles.handleToolCall({
+      tool: 'canvas_snapshot',
+      callId: 'c1',
+      args: { mediaNodeIds: ['img-1', 'img-2'] },
+    })
+    expect(seen).toHaveLength(1)
+    expect(seen[0].params).toMatchObject({ mediaNodeIds: ['img-1', 'img-2'] })
+  })
+
+  it('未传 mediaNodeIds → 面板动词参数里不出现该字段(零参不等于空数组)', async () => {
+    const brain = loadBrain()
+    const seen = withPanel(brain, { ok: true, snapshot: { version: 1, nodes: [] }, truncated: false })
