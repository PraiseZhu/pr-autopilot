+/**
+ * agentBridge.ts 侧 mediaNodeIds 独立校验(#297 T3a SC-T3a.1:进程间边界纵深复校,
+ * 与 main.js 侧逐字节一致但物理独立,设计稿 §2.1.1-③)。
+ *
+ * 段边界:真实逐 id 解析(mediaStates/mediaSummary)归 T3b,这里只验证——合法
+ * 参数能到达 `agentReadSnapshotPage` 之前的校验点(不炸、不报错)、非法形状
+ * fail-fast(INVALID_PARAMS、不读页),且校验对本文件全程未引用的 `main.js`
+ * 零依赖——面板侧纵深复校的意义正是"不盲信调用方已经校验过",单测必须能绕开
+ * main.js 直接命中这层校验,与 `agentBridgeWriteGate.test.ts` 同一套
+ * `wireBridge()` 桥接手法,断言跑在真实 `installAgentBridge()` 上。
+ */
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.hoisted(() => {
+  const store = new Map<string, string>()
+  const memStorage = {
+    get length() {
+      return store.size
+    },
+    clear: () => store.clear(),
+    getItem: (key: string) => store.get(key) ?? null,
+    key: (index: number) => [...store.keys()][index] ?? null,
+    removeItem: (key: string) => {
+      store.delete(key)
+    },
+    setItem: (key: string, value: string) => {
+      store.set(key, String(value))
+    },
+  }
+  const globals = globalThis as Record<string, unknown>
+  if (globals.window === undefined) globals.window = { localStorage: memStorage }
+  if (globals.localStorage === undefined) globals.localStorage = memStorage
+})
+
+vi.mock('../../../src/lib/demoImages', () => ({ createDemoImage: () => 'data:image/png;base64,mock' }))
+vi.mock('../../../src/store/remoteDebugReporter', () => ({ reportRemoteDebugEntry: () => {} }))
+vi.mock('../../../src/lib/assetStorage', () => ({
+  saveGeneratedAsset: vi.fn(async () => ({ assetUrl: 'mivo-asset://mock', name: 'n', type: 'image/png' })),
+  saveImportedAsset: vi.fn(async () => ({ assetUrl: 'mivo-asset://mock-imported' })),
+  readImportedAssetFile: vi.fn(),
+}))
+
+const persistRequestMock = vi.fn()
+const flushPersistNowMock = vi.fn(async () => true)
+vi.mock('../persist/bridge', () => ({ persistRequest: (...args: unknown[]) => persistRequestMock(...args) }))
+vi.mock('../persist/persistSync', () => ({
+  flushPersistNow: () => flushPersistNowMock(),
+  restoreFromDiskIfEmpty: async () => 'skipped',
+  startAutoSave: () => {},
+}))
+
+import { ChannelBus, channelConstructorFor, flushUntil } from './brainHarness'
+import { resetCanvasWriteGateForTests } from '../../../src/agent/canvasWriteGate'
+import { installAgentBridge } from '../agent/agentBridge'
+
+const CHANNEL = 'mivo-canvas-agent'
+
+/** 起一个总线 + 真实桥,返回「发动词请求并收回执」的调用器(电子脑视角,同 agentBridgeWriteGate.test.ts)。 */
+const wireBridge = () => {
+  const bus = new ChannelBus()
+  const globals = globalThis as Record<string, unknown>
+  const previous = globals.BroadcastChannel
+  globals.BroadcastChannel = channelConstructorFor(bus)
+  installAgentBridge()
+  globals.BroadcastChannel = previous
+
+  const brainSide = bus.open(CHANNEL)
+  let seq = 0
+  const ask = async (verb: string, params: Record<string, unknown> = {}): Promise<Record<string, unknown> | null> => {
+    seq += 1
+    const reqId = `probe-${seq}`
+    let reply: Record<string, unknown> | null = null
+    brainSide.onmessage = (event) => {
+      const data = event.data as Record<string, unknown> | undefined
+      if (data && data.reply === true && data.reqId === reqId) reply = data
+    }
+    brainSide.postMessage({ reqId, verb, params })
+    await flushUntil(() => reply !== null, { label: `agent 桥对动词 '${verb}' 的回执` })
+    return reply
+  }
+  return { ask }
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  flushPersistNowMock.mockImplementation(async () => true)
+  resetCanvasWriteGateForTests()
+})
+
+describe('agentBridge snapshot 动词的 mediaNodeIds 独立校验(#297 T3a SC-T3a.1)', () => {
+  it('合法 mediaNodeIds 到达 snapshot 动词,不报错、正常读页(参数运输到达面板侧)', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1', 'img-2'] })
+    expect(reply).toMatchObject({ ok: true })
+    expect(reply?.snapshot).toBeTruthy()
+    // T3a 不实现真实逐 id 解析:合法参数到达不代表这里已经产出
+    // mediaStates/mediaSummary,那是 T3b 的交付边界——本条同时钉住"没有提前偷跑"。
+    expect(reply).not.toHaveProperty('mediaStates')
+    expect(reply).not.toHaveProperty('mediaSummary')
+  })
+
+  it('未传 mediaNodeIds → 正常读页,不受影响', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot')
+    expect(reply).toMatchObject({ ok: true })
+    expect(reply?.snapshot).toBeTruthy()
+  })
+
+  it('空数组 → 视为未请求,正常读页(不触发任何后续语义)', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: [] })
+    expect(reply).toMatchObject({ ok: true })
+    expect(reply?.snapshot).toBeTruthy()
+  })
+
+  it('非数组 → INVALID_PARAMS,不读页', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: 'not-an-array' })
+    expect(reply).toMatchObject({ ok: false, code: 'INVALID_PARAMS' })
+    expect(reply?.snapshot).toBeUndefined()
+  })
+
+  it('超过 8 个 → INVALID_PARAMS,不处理前 8 个', async () => {
+    const { ask } = wireBridge()
+    const ids = Array.from({ length: 9 }, (_, index) => `img-${index}`)
+    const reply = await ask('snapshot', { mediaNodeIds: ids })
+    expect(reply).toMatchObject({ ok: false, code: 'INVALID_PARAMS' })
+  })
+
+  it('含空字符串 → INVALID_PARAMS', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1', ''] })
+    expect(reply).toMatchObject({ ok: false, code: 'INVALID_PARAMS' })
+  })
+
+  it('含非字符串项 → INVALID_PARAMS', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1', 42] })
+    expect(reply).toMatchObject({ ok: false, code: 'INVALID_PARAMS' })
+  })
+
+  it('出现重复 id → INVALID_PARAMS(与 ghost.json 的 uniqueItems 呼应,但运行时独立生效)', async () => {
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot', { mediaNodeIds: ['img-1', 'img-1'] })
+    expect(reply).toMatchObject({ ok: false, code: 'INVALID_PARAMS' })
+  })
+})
