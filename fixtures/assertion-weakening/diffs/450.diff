+// mediaNodeIds 单次上限(#297 T3a,设计稿 §2.1.1-②/§2.1.2):超出/重复一律
+// 整单 INVALID_PARAMS。ghost.json 本段暂不暴露这个参数(暗态)。
+const MEDIA_NODE_IDS_MAX = 8
+
+/**
+ * mediaNodeIds 的类型校验——面板侧纵深复校(#297 T3a 设计稿 §2.1.1-③):
+ * `agentBridge.ts` 经 BroadcastChannel 接收 `params`,这是一个进程间消息传递
+ * 边界,不能假设消息一定来自 `main.js` 那条已校验路径——独立重跑同一套规则,
+ * 不盲信一个已校验的标志位。
+ *
+ * 与 `cindyplugin/main.js` 的同名函数逐字节一致但物理上是两份独立代码(main.js
+ * 是不过打包的自包含脚本,没法 import 这份 TS 模块;与 `ownArg`/原型污染防护的
+ * 既有两份并存模式同构)。非法输入一律整单 INVALID_PARAMS、fail-fast、零副作用:
+ * 不调 `agentReadSnapshotPage`。
+ */
+function validateMediaNodeIds(value: unknown): { ok: true; value?: string[] } | { ok: false; message: string } {
+  if (value === undefined) return { ok: true, value: undefined }
+  if (!Array.isArray(value)) return { ok: false, message: 'mediaNodeIds 必须是字符串数组' }
+  if (value.length > MEDIA_NODE_IDS_MAX) {
+    return { ok: false, message: `mediaNodeIds 最多 ${MEDIA_NODE_IDS_MAX} 个,请拆成多次调用` }
+  }
+  const seen = new Set<string>()
+  for (const id of value) {
+    if (typeof id !== 'string' || !id) return { ok: false, message: 'mediaNodeIds 里的每一项必须是非空字符串' }
+    if (seen.has(id)) return { ok: false, message: `mediaNodeIds 不允许重复项: ${id}` }
+    seen.add(id)
+  }
+  return { ok: true, value: value as string[] }
+}
