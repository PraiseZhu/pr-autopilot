new file mode 100644
index 00000000..c6237158
--- /dev/null
+++ b/src/canvas/actions/objectNames.ts
@@ -0,0 +1,36 @@
+// 选区对象名(i18n)——从 canvasActionModel 抽出(结构守卫 763 行基线,i18n
+// 迁移不允许把存量大文件养大;与 image/multi/import action groups 同一拆分先例)。
+//
+// 对象名一律走词条插值:menu.object.*(单数)/ menu.objectPlural.*(复数),
+// "Copy 3 images"/"复制 3 个图片"由 copyMulti 等模板 key 在装配层组装。
+import { t } from '../../i18n'
+import type { CanvasSelectionContext } from './canvasSelectionModel'
+
+const singleObjectKeyFor = (context: CanvasSelectionContext) => {
+  if (context.primaryNode?.type === 'text') return 'text'
+  if (context.primaryNode?.type === 'frame') return 'section'
+  if (context.primaryNode?.type === 'ai-slot') return 'aiSlot'
+  if (context.primaryNode?.type === 'annotation') return 'annotation'
+  if (context.primaryNode?.type === 'markup') return 'markup'
+  if (context.primaryNode?.type === 'markdown') return 'markdown'
+  if (context.primaryNode?.type === 'pdf') return 'pdf'
+  if (context.primaryNode?.type === 'video') return 'video'
+  if (context.primaryNode?.type === 'task-placeholder') return 'task'
+  return 'image'
+}
+
+const pluralObjectKeyFor = (context: CanvasSelectionContext) => {
+  if (context.objectTypes.size !== 1) return 'objects'
+  if (context.objectTypes.has('image')) return 'image'
+  if (context.objectTypes.has('text')) return 'text'
+  if (context.objectTypes.has('markdown')) return 'markdown'
+  if (context.objectTypes.has('pdf')) return 'pdf'
+  if (context.objectTypes.has('video')) return 'video'
+  return 'objects'
+}
+
+/** 当前选区的对象名(已本地化):单选按类型、多选按同类/混合。 */
+export const objectNameFor = (context: CanvasSelectionContext) =>
+  context.selectedCount > 1
+    ? t(`menu.objectPlural.${pluralObjectKeyFor(context)}`)
+    : t(`menu.object.${singleObjectKeyFor(context)}`)
