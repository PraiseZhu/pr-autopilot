diff --git a/src/i18n/__tests__/i18nCompleteness.test.ts b/src/i18n/__tests__/i18nCompleteness.test.ts
new file mode 100644
index 00000000..51b176c7
--- /dev/null
+++ b/src/i18n/__tests__/i18nCompleteness.test.ts
@@ -0,0 +1,90 @@
+/**
+ * i18n 完整性守卫(对齐 Cindy 的 i18nCompleteness 思路):
+ * 扫 src/ 源码里所有 key 形状的字符串字面量(t('menu.x.y') 与注册表里的
+ * label: 'tools.x'),断言每个 key 在全部支持语言的 catalog 里都存在。
+ *
+ * 这是"新功能忘加翻译"的第一道红灯:新增 t('menu.foo.bar') 而没在四语 JSON
+ * 里补词条,本测试直接失败。动态模板 key(t(`menu.objectPlural.${k}`))扫不到,
+ * 由 scripts/check-i18n.mjs 的四语结构一致性兜底。
+ */
+import { describe, expect, it } from 'vitest'
+import { readdirSync, readFileSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+import { SUPPORTED_LOCALES } from '../locale'
+import en from '../locales/en'
+import ja from '../locales/ja'
+import ko from '../locales/ko'
+import zhCN from '../locales/zh-CN'
+
+const catalogs: Record<string, unknown> = { en, 'zh-CN': zhCN, ja, ko }
+
+const SRC_ROOT = join(__dirname, '../..')
+// namespace 后 1+ 段(canvasToolRegistry 的 tools.select 这类顶层 key 也要收),
+// 单双引号都认(PR #367 双审:原正则要求 2+ 段,18 个顶层 tools.* 全部漏扫)。
+const KEY_PATTERN = /['"]((?:menu|tools)\.[a-zA-Z0-9_]+(?:\.[a-zA-Z0-9_]+)*)['"]/g
+const PLURAL_SUFFIXES = ['zero', 'one', 'two', 'few', 'many', 'other']
+
+const collectSourceFiles = (dir: string, out: string[] = []): string[] => {
+  for (const entry of readdirSync(dir)) {
+    if (entry === '__tests__' || entry === 'node_modules') continue
+    const path = join(dir, entry)
+    if (statSync(path).isDirectory()) {
+      // locales 目录本身不扫(词条值里出现 key 形状的串不算引用)
+      if (path.includes(join('i18n', 'locales'))) continue
+      collectSourceFiles(path, out)
+    } else if (/\.(ts|tsx)$/.test(entry) && !/\.test\./.test(entry)) {
+      out.push(path)
+    }
+  }
+  return out
+}
+
+const lookup = (catalog: unknown, key: string): unknown => {
+  let node: unknown = catalog
+  for (const part of key.split('.')) {
+    if (!node || typeof node !== 'object') return undefined
+    node = (node as Record<string, unknown>)[part]
+  }
+  return node
+}
+
+// 空字符串不算存在(PR #367 双审):i18next 会把空串当合法译文渲染成空按钮,
+// 而不是回落 en——留空必须显式改词条,不允许静默逃过。
+const isNonEmptyString = (value: unknown): boolean =>
+  typeof value === 'string' && value.trim() !== ''
+
+const keyExists = (catalog: unknown, key: string): boolean => {
+  if (isNonEmptyString(lookup(catalog, key))) return true
+  // 复数家族:t('menu.create.paste', {count}) 对应 paste_one/_other 词条
+  return PLURAL_SUFFIXES.some((suffix) => isNonEmptyString(lookup(catalog, `${key}_${suffix}`)))
+}
+
+describe('i18n completeness', () => {
+  const files = collectSourceFiles(SRC_ROOT)
+  const usedKeys = new Map<string, string>() // key → 首个引用文件(报错定位用)
+
+  for (const file of files) {
+    const source = readFileSync(file, 'utf8')
+    for (const match of source.matchAll(KEY_PATTERN)) {
+      if (!usedKeys.has(match[1])) usedKeys.set(match[1], file)
+    }
+  }
+
+  it('扫描到源码中的 i18n key 引用(空结果说明扫描器坏了)', () => {
+    expect(usedKeys.size).toBeGreaterThan(50)
+  })
+
+  it('扫描器收得到顶层与嵌套两种 key 形状(回归:顶层 tools.* 曾被 2+ 段正则漏扫)', () => {
+    expect(usedKeys.has('tools.select')).toBe(true)
+    expect(usedKeys.has('menu.image.crop')).toBe(true)
+  })
+
+  for (const locale of SUPPORTED_LOCALES) {
+    it(`所有源码引用的 key 在 ${locale} catalog 中存在`, () => {
+      const missing = [...usedKeys.entries()]
+        .filter(([key]) => !keyExists(catalogs[locale], key))
+        .map(([key, file]) => `${key}(引用于 ${file.replace(SRC_ROOT, 'src')})`)
+      expect(missing).toEqual([])
+    })
+  }
+})
diff --git a/src/i18n/index.ts b/src/i18n/index.ts
new file mode 100644
index 00000000..28833b45
--- /dev/null
+++ b/src/i18n/index.ts
@@ -0,0 +1,79 @@
+/**
+ * i18next 初始化(对齐 Cindy desktop 的约定):
+ * - 资源同步 import、无 backend / LanguageDetector / Suspense —— init 同步完成,
+ *   首屏不闪裸 key;
+ * - 单一 namespace('translation'),catalog 按模块拆 JSON、由 locales/<l>/index.ts 组装;
+ * - fallback 一律 en;语义 key(menu.image.crop),不用英文原文当 key。
+ *
+ * 语言来源:
+ * - 主站:localStorage 偏好(LOCALE_STORAGE_KEY,'system'/缺省 = navigator.language);
+ * - Cindy 插件:plugin-main 启动时读宿主 /app-context 再 changeLanguage(见
+ *   cindyplugin/src/i18n/hostLocale.ts),宿主切语言走整页 reload。
+ *
+ * 非组件模块(action 装配层/注册表消费点)直接 `import { t } from '../i18n'`;
+ * React 组件用 useTranslation() 以便语言切换时重渲染。
+ */
+import i18n from 'i18next'
+import { initReactI18next } from 'react-i18next'
+import { DEFAULT_LOCALE, LOCALE_STORAGE_KEY, normalizeLocale, type SupportedLocale } from './locale'
+import en from './locales/en'
+import ja from './locales/ja'
+import ko from './locales/ko'
+import zhCN from './locales/zh-CN'
+
+export { SUPPORTED_LOCALES, DEFAULT_LOCALE, LOCALE_STORAGE_KEY, normalizeLocale } from './locale'
+export type { SupportedLocale } from './locale'
+
+const initialLocale = (): SupportedLocale => {
+  // vitest(node)/SSR 环境无 window:固定 en,测试断言与源语言基准一致。
+  if (typeof window === 'undefined') return DEFAULT_LOCALE
+  let stored: string | null = null
+  try {
+    stored = window.localStorage.getItem(LOCALE_STORAGE_KEY)
+  } catch {
+    // localStorage 不可用(隐私模式/webview 限制)→ 走下方 en 默认。
+  }
+  if (stored && stored !== 'system') return normalizeLocale(stored)
+  // 未显式设置偏好时固定 en(PR #367 review):迁移期只有部分界面接入 t(),
+  // 跟随浏览器语言会让主站首开就是"菜单中文、其余英文"的半翻译态。
+  // Wave 4 语言设置项上线后,'system'/缺省 再切回 normalizeLocale(navigator.language)。
+  return DEFAULT_LOCALE
+}
+
+void i18n.use(initReactI18next).init({
+  resources: {
+    en: { translation: en },
+    'zh-CN': { translation: zhCN },
+    ja: { translation: ja },
+    ko: { translation: ko },
+  },
+  lng: initialLocale(),
+  fallbackLng: DEFAULT_LOCALE,
+  interpolation: { escapeValue: false },
+  returnNull: false,
+})
+
+// 部分测试环境 document 存在但 documentElement 为空(局部 DOM mock),可选链防御。
+if (typeof document !== 'undefined' && document.documentElement) {
+  document.documentElement.lang = i18n.language
+  i18n.on('languageChanged', (lng) => {
+    document.documentElement.lang = lng
+  })
+}
+
+/** 切换语言(归一化到支持语言并持久化偏好;'system' = 跟随环境)。 */
+export const setAppLocale = async (preference: SupportedLocale | 'system'): Promise<void> => {
+  try {
+    window.localStorage.setItem(LOCALE_STORAGE_KEY, preference)
+  } catch {
+    // 持久化失败不阻断本次切换。
+  }
+  // 'system' 在迁移期同样落 en(与 initialLocale 一致);Wave 4 放开为跟随浏览器。
+  const next = preference === 'system' ? DEFAULT_LOCALE : preference
+  await i18n.changeLanguage(next)
+}
+
+/** 非组件模块用的翻译函数(组件请用 useTranslation 以获得语言切换重渲染)。 */
+export const t = i18n.t.bind(i18n)
+
+export default i18n
