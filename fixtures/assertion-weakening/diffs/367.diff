new file mode 100644
index 00000000..0adbd894
--- /dev/null
+++ b/src/i18n/locale.ts
@@ -0,0 +1,27 @@
+/**
+ * 支持语言与 locale 归一化(与 Cindy 宿主对齐:zh-CN / en / ja / ko,en 兜底)。
+ * 纯函数、零依赖——check-i18n 脚本从本文件的 SUPPORTED_LOCALES 源码解析语言
+ * 列表,新增语言只改这里(+ 对应 locales/<locale>/ 目录)。
+ */
+export const SUPPORTED_LOCALES = ['en', 'zh-CN', 'ja', 'ko'] as const
+
+export type SupportedLocale = (typeof SUPPORTED_LOCALES)[number]
+
+export const DEFAULT_LOCALE: SupportedLocale = 'en'
+
+/** 语言偏好持久化 key(localStorage;'system' = 跟随浏览器/宿主)。 */
+export const LOCALE_STORAGE_KEY = 'mivo.language'
+
+/**
+ * 任意 locale 串(navigator.language / 宿主 /app-context)折叠到支持语言:
+ * 中文全部变体(Hans/Hant/TW/HK/MO)→ zh-CN,ja/ko 按前缀匹配,其余 → en。
+ * 刻意用前缀匹配而非 Intl.Locale:输入来源杂(宿主自定义串),行为要可预测。
+ */
+export const normalizeLocale = (raw: string | null | undefined): SupportedLocale => {
+  const lower = (raw || '').trim().toLowerCase()
+  if (!lower) return DEFAULT_LOCALE
+  if (lower.startsWith('zh')) return 'zh-CN'
+  if (lower.startsWith('ja')) return 'ja'
+  if (lower.startsWith('ko')) return 'ko'
+  return DEFAULT_LOCALE
+}
