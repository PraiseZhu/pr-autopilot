new file mode 100644
index 00000000..beb51807
--- /dev/null
+++ b/scripts/check-i18n.mjs
@@ -0,0 +1,177 @@
+#!/usr/bin/env node
+/**
+ * i18n catalog 静态门禁(对齐 Cindy 的 check-i18n 思路,减配落地):
+ *
+ *   报错(exit 1):
+ *   - 各 locale 的 catalog 模块文件集不一致(少文件/多文件)
+ *   - 缺 key / 孤儿 key(某 key 只在部分 locale 存在;复数按 Intl.PluralRules
+ *     家族校验——en 需 one+other,zh/ja/ko 只需 other)
+ *   - 同 key 类型冲突(一边字符串、一边对象)
+ *   - {{占位符}} 集合与 en 不一致(插值变量漏写/写错必红)
+ *   - JSON 解析失败
+ *
+ *   告警(不阻断):
+ *   - (空字符串值已升级为报错——空译文渲染成空 UI,不会回落 en)
+ *   - 非 en locale 的值与 en 完全相同(疑似未翻译;专有名词豁免不了就先忍着)
+ *
+ * 语言列表从 src/i18n/locale.ts 源码解析(单一事实源,加语言不用改本脚本)。
+ */
+import { readFileSync, readdirSync } from 'node:fs'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const root = join(dirname(fileURLToPath(import.meta.url)), '..')
+const localesDir = join(root, 'src/i18n/locales')
+
+const localeSource = readFileSync(join(root, 'src/i18n/locale.ts'), 'utf8')
+const localesMatch = localeSource.match(/SUPPORTED_LOCALES\s*=\s*\[([^\]]+)\]/)
+if (!localesMatch) {
+  console.error('check-i18n: 无法从 src/i18n/locale.ts 解析 SUPPORTED_LOCALES')
+  process.exit(1)
+}
+const LOCALES = [...localesMatch[1].matchAll(/'([^']+)'/g)].map((m) => m[1])
+const BASE = 'en'
+
+const errors = []
+const warnings = []
+
+/** locale → { 模块名 → 解析后的 JSON 对象 } */
+const catalogs = new Map()
+for (const locale of LOCALES) {
+  const dir = join(localesDir, locale)
+  const files = readdirSync(dir).filter((f) => f.endsWith('.json')).sort()
+  const modules = new Map()
+  for (const file of files) {
+    try {
+      modules.set(file, JSON.parse(readFileSync(join(dir, file), 'utf8')))
+    } catch (err) {
+      errors.push(`${locale}/${file}: JSON 解析失败 — ${err.message}`)
+    }
+  }
+  catalogs.set(locale, modules)
+}
+
+// 模块文件集一致性
+const baseFiles = [...(catalogs.get(BASE)?.keys() || [])]
+for (const locale of LOCALES) {
+  if (locale === BASE) continue
+  const files = [...catalogs.get(locale).keys()]
+  for (const f of baseFiles) if (!files.includes(f)) errors.push(`${locale}: 缺少 catalog 文件 ${f}`)
+  for (const f of files) if (!baseFiles.includes(f)) errors.push(`${locale}: 多出 catalog 文件 ${f}(en 没有)`)
+}
+
+/** 扁平化:嵌套对象 → 点路径叶子 map(路径 → 字符串值) */
+const flatten = (obj, prefix, out, locale) => {
+  for (const [key, value] of Object.entries(obj)) {
+    const path = prefix ? `${prefix}.${key}` : key
+    if (typeof value === 'string') out.set(path, value)
+    else if (value && typeof value === 'object' && !Array.isArray(value)) flatten(value, path, out, locale)
+    else errors.push(`${locale}: ${path} 值类型非法(仅允许字符串/嵌套对象)`)
+  }
+  return out
+}
+
+const flat = new Map()
+for (const locale of LOCALES) {
+  const out = new Map()
+  for (const [file, obj] of catalogs.get(locale)) flatten(obj, file.replace(/\.json$/, ''), out, locale)
+  flat.set(locale, out)
+}
+
+const PLURAL_SUFFIXES = ['zero', 'one', 'two', 'few', 'many', 'other']
+const pluralBaseOf = (key) => {
+  const m = key.match(/^(.*)_(zero|one|two|few|many|other)$/)
+  return m ? { base: m[1], category: m[2] } : null
+}
+
+/** locale 需要的复数类别(cardinal)。 */
+const requiredCategories = (locale) => new Set(new Intl.PluralRules(locale).resolvedOptions().pluralCategories)
+
+// 家族视图:key → 普通 key 或复数家族
+const familiesOf = (locale) => {
+  const families = new Map() // base → Set(categories) | null(普通 key)
+  for (const key of flat.get(locale).keys()) {
+    const plural = pluralBaseOf(key)
+    if (plural) {
+      const set = families.get(plural.base)
+      if (set instanceof Set) set.add(plural.category)
+      else families.set(plural.base, new Set([plural.category]))
+    } else if (!families.has(key)) {
+      families.set(key, null)
+    }
+  }
+  return families
+}
+
+const baseFamilies = familiesOf(BASE)
+for (const locale of LOCALES) {
+  if (locale === BASE) continue
+  const localeFamilies = familiesOf(locale)
+  const required = requiredCategories(locale)
+
+  for (const [base, categories] of baseFamilies) {
+    const localeEntry = localeFamilies.get(base)
+    if (categories === null) {
+      if (localeEntry === undefined) errors.push(`${locale}: 缺 key ${base}`)
+      else if (localeEntry !== null) errors.push(`${locale}: ${base} 在 en 是普通 key,此处是复数家族`)
+    } else {
+      if (localeEntry === undefined) errors.push(`${locale}: 缺复数家族 ${base}_*`)
+      else if (localeEntry === null) errors.push(`${locale}: ${base} 在 en 是复数家族,此处是普通 key`)
+      else {
+        for (const cat of required) {
+          if (!localeEntry.has(cat)) errors.push(`${locale}: 复数家族 ${base} 缺 _${cat} 档(该语言必需)`)
+        }
+      }
+    }
+  }
+  for (const base of localeFamilies.keys()) {
+    if (!baseFamilies.has(base)) errors.push(`${locale}: 孤儿 key ${base}(en 没有)`)
+  }
+}
+
+// en 自身复数完整性
+const enRequired = requiredCategories('en')
+for (const [base, categories] of baseFamilies) {
+  if (categories instanceof Set) {
+    for (const cat of enRequired) if (!categories.has(cat)) errors.push(`en: 复数家族 ${base} 缺 _${cat} 档`)
+  }
+}
+
+// 占位符一致性 + 空值/未翻译告警
+const placeholdersOf = (value) => new Set([...value.matchAll(/\{\{\s*([\w.]+)\s*\}\}/g)].map((m) => m[1]))
+const comparableEnKeyFor = (key, enFlat) => {
+  if (enFlat.has(key)) return key
+  const plural = pluralBaseOf(key)
+  if (!plural) return null
+  for (const suffix of PLURAL_SUFFIXES) {
+    if (enFlat.has(`${plural.base}_${suffix}`)) return `${plural.base}_${suffix}`
+  }
+  return null
+}
+
+const enFlat = flat.get(BASE)
+for (const locale of LOCALES) {
+  for (const [key, value] of flat.get(locale)) {
+    // 空译文是 error 不是 warning(PR #367 双审):i18next 会把空串当合法译文
+    // 渲染成空按钮/空 ARIA,而不是回落 en。刻意留空须走显式 allowlist。
+    if (value.trim() === '') errors.push(`${locale}: ${key} 值为空字符串(空译文会渲染成空 UI,不会回落 en)`)
+    if (locale === BASE) continue
+    const enKey = comparableEnKeyFor(key, enFlat)
+    if (!enKey) continue // 孤儿 key 已在上面报错
+    const enValue = enFlat.get(enKey)
+    const a = [...placeholdersOf(enValue)].sort().join(',')
+    const b = [...placeholdersOf(value)].sort().join(',')
+    if (a !== b) errors.push(`${locale}: ${key} 占位符 {${b}} 与 en {${a}} 不一致`)
+    if (value === enValue && /[a-z]{3,}/i.test(enValue) && !/^\{\{|^[A-Z+0-9° /]+$/.test(enValue)) {
+      warnings.push(`${locale}: ${key} 与 en 完全相同(疑似未翻译)`)
+    }
+  }
+}
+
+for (const w of warnings) console.warn(`⚠️  ${w}`)
+if (errors.length) {
+  for (const e of errors) console.error(`❌ ${e}`)
+  console.error(`\ncheck-i18n: ${errors.length} 个错误(${LOCALES.join(' / ')})`)
+  process.exit(1)
+}
+console.log(`check-i18n: OK — ${LOCALES.length} 语言 × ${baseFiles.length} 模块,${enFlat.size} 词条,${warnings.length} 告警`)
