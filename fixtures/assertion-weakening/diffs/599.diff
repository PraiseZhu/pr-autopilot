new file mode 100644
index 00000000..3cc64d6b
--- /dev/null
+++ b/src/app/settings/KeyDialogEscapeBubbling.test.tsx
@@ -0,0 +1,95 @@
+// @vitest-environment happy-dom
+//
+// PR #599 复盘(greptile review):GatewayKeyDialog/MivoKeyDialog 的 Escape 处理器
+// 原本只挂在输入框 onKeyDown 上,不 stopPropagation —— 原生 keydown 事件继续冒泡到
+// SettingsPanel 的 window 监听器,触发 closeSettings(),导致父设置面板被一并关闭
+// 而不是只退出当前最上层弹窗。
+//
+// 第一轮修复(3742647891)只在输入框上补了 stopPropagation,但 review
+// 3743141648 指出:Tab 把焦点移到关闭/显示密钥/取消/保存/控制台任一按钮后按
+// Escape,事件根本不经过输入框,同样会穿透。改成挂在弹窗根节点上后,不论
+// Escape 是从输入框还是从任一按钮触发都应该被拦住 —— 下面分别对输入框和
+// 一个头部按钮、一个底部按钮验证。用真 DOM 事件复现(冒泡行为只在真实事件
+// 路径上成立,纯函数测不出来,沿用 useRegionEditKeyboard.test.tsx 的
+// react-dom/client + act 先例)。
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { GatewayKeyDialog } from './GatewayKeyDialog'
+import { MivoKeyDialog } from './MivoKeyDialog'
+
+let container: HTMLDivElement
+let root: Root
+let parentEscapeHandler: (event: KeyboardEvent) => void
+let parentEscapeCalls: number
+
+beforeEach(() => {
+  ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+  // 模拟 SettingsPanel 自己的 window Escape 监听器(真实实现里就是它触发 closeSettings)。
+  parentEscapeCalls = 0
+  parentEscapeHandler = () => {
+    parentEscapeCalls += 1
+  }
+  window.addEventListener('keydown', parentEscapeHandler)
+})
+
+afterEach(() => {
+  window.removeEventListener('keydown', parentEscapeHandler)
+  act(() => {
+    root.unmount()
+  })
+  container.remove()
+})
+
+const pressEscapeOn = (selector: string) => {
+  const target = document.body.querySelector<HTMLElement>(selector)
+  if (!target) throw new Error(`dialog element not found: ${selector}`)
+  const event = new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true })
+  act(() => {
+    target.dispatchEvent(event)
+  })
+}
+
+describe.each([
+  ['GatewayKeyDialog', GatewayKeyDialog],
+  ['MivoKeyDialog', MivoKeyDialog],
+] as const)('%s Escape does not bubble to the parent settings panel', (_name, Dialog) => {
+  it('closes itself from the input without triggering the parent window listener', () => {
+    const onClose = vi.fn()
+    act(() => {
+      root.render(<Dialog onClose={onClose} />)
+    })
+
+    pressEscapeOn('input')
+
+    expect(onClose).toHaveBeenCalledTimes(1)
+    expect(parentEscapeCalls).toBe(0)
+  })
+
+  it('closes itself when focus is on the header close button (Tab away from the input)', () => {
+    const onClose = vi.fn()
+    act(() => {
+      root.render(<Dialog onClose={onClose} />)
+    })
+
+    pressEscapeOn('header button')
+
+    expect(onClose).toHaveBeenCalledTimes(1)
+    expect(parentEscapeCalls).toBe(0)
+  })
+
+  it('closes itself when focus is on a footer button (e.g. Cancel)', () => {
+    const onClose = vi.fn()
+    act(() => {
+      root.render(<Dialog onClose={onClose} />)
+    })
+
+    pressEscapeOn('footer button')
+
+    expect(onClose).toHaveBeenCalledTimes(1)
+    expect(parentEscapeCalls).toBe(0)
+  })
+})
