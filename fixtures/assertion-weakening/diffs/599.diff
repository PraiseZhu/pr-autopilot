@@ -0,0 +1,76 @@
+import { create } from 'zustand'
+import { debugLogger } from './debugLogStore'
+
+export const CANVAS_BACKGROUND_PATTERNS = ['grid', 'dots'] as const
+export type CanvasBackgroundPattern = (typeof CANVAS_BACKGROUND_PATTERNS)[number]
+
+export const CANVAS_BACKGROUND_PATTERN_STORAGE_KEY = 'mivo.canvas.background-pattern'
+const DEFAULT_PATTERN: CanvasBackgroundPattern = 'grid'
+
+const isCanvasBackgroundPattern = (value: string | null): value is CanvasBackgroundPattern =>
+  value === 'grid' || value === 'dots'
+
+export const readCanvasBackgroundPatternFromStorage = (): CanvasBackgroundPattern => {
+  if (typeof window === 'undefined') return DEFAULT_PATTERN
+  try {
+    const stored = window.localStorage.getItem(CANVAS_BACKGROUND_PATTERN_STORAGE_KEY)
+    return isCanvasBackgroundPattern(stored) ? stored : DEFAULT_PATTERN
+  } catch {
+    debugLogger.warn('Canvas Appearance', 'Background pattern preference unavailable; using grid default')
+    return DEFAULT_PATTERN
+  }
+}
+
+const persistPattern = (pattern: CanvasBackgroundPattern): boolean => {
+  if (typeof window === 'undefined') return true
+  try {
+    window.localStorage.setItem(CANVAS_BACKGROUND_PATTERN_STORAGE_KEY, pattern)
+    return true
+  } catch {
+    // 画布底纹是非关键偏好：宿主存储不可用时保留本次会话的内存态即可。
+    debugLogger.warn('Canvas Appearance', 'Background pattern preference could not be persisted; using session memory')
+    return false
+  }
+}
+
+export type CanvasAppearanceState = {
+  backgroundPattern: CanvasBackgroundPattern
+  appearancePanelOpen: boolean
+  setBackgroundPattern: (pattern: CanvasBackgroundPattern) => void
+  openCanvasAppearance: () => void
+  closeCanvasAppearance: () => void
+}
+
+export const createCanvasAppearanceStore = () =>
+  create<CanvasAppearanceState>((set) => ({
+    backgroundPattern: readCanvasBackgroundPatternFromStorage(),
+    appearancePanelOpen: false,
+    setBackgroundPattern: (pattern) => {
+      const persisted = persistPattern(pattern)
+      debugLogger.log(
+        'Canvas Appearance',
+        `Background pattern changed: ${pattern}${persisted ? '' : ' (session only; storage unavailable)'}`,
+      )
+      set({ backgroundPattern: pattern })
+    },
+    openCanvasAppearance: () => {
+      debugLogger.log('Canvas Appearance', 'Canvas appearance settings opened')
+      set({ appearancePanelOpen: true })
+    },
+    closeCanvasAppearance: () => {
+      debugLogger.log('Canvas Appearance', 'Canvas appearance settings closed')
+      set({ appearancePanelOpen: false })
+    },
+  }))
+
+export const useCanvasAppearanceStore = createCanvasAppearanceStore()
+
+export const __resetCanvasAppearanceForTests = () => {
+  useCanvasAppearanceStore.setState({ backgroundPattern: DEFAULT_PATTERN, appearancePanelOpen: false })
+  if (typeof window === 'undefined') return
+  try {
+    window.localStorage.removeItem(CANVAS_BACKGROUND_PATTERN_STORAGE_KEY)
+  } catch {
+    // Ignore unavailable test/browser storage.
+  }
+}
