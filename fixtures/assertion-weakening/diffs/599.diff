+// @vitest-environment happy-dom
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  CANVAS_BACKGROUND_PATTERN_STORAGE_KEY,
+  __resetCanvasAppearanceForTests,
+  createCanvasAppearanceStore,
+  readCanvasBackgroundPatternFromStorage,
+  useCanvasAppearanceStore,
+} from './canvasAppearanceStore'
+import { useDebugLogStore } from './debugLogStore'
+
+beforeEach(() => {
+  __resetCanvasAppearanceForTests()
+  useDebugLogStore.getState().clear()
+})
+
+describe('canvasAppearanceStore', () => {
+  it('defaults to the grid pattern', () => {
+    expect(useCanvasAppearanceStore.getState().backgroundPattern).toBe('grid')
+  })
+
+  it('switches between grid and dots and persists the preference', () => {
+    useCanvasAppearanceStore.getState().setBackgroundPattern('dots')
+    expect(useCanvasAppearanceStore.getState().backgroundPattern).toBe('dots')
+    expect(window.localStorage.getItem(CANVAS_BACKGROUND_PATTERN_STORAGE_KEY)).toBe('dots')
+    const reloadedStore = createCanvasAppearanceStore()
+    expect(reloadedStore.getState().backgroundPattern).toBe('dots')
+
+    useCanvasAppearanceStore.getState().setBackgroundPattern('grid')
+    expect(useCanvasAppearanceStore.getState().backgroundPattern).toBe('grid')
+  })
+
+  it('falls back to grid when stored value is invalid', () => {
+    window.localStorage.setItem(CANVAS_BACKGROUND_PATTERN_STORAGE_KEY, 'stripes')
+    expect(readCanvasBackgroundPatternFromStorage()).toBe('grid')
+  })
+
+  it('warns and keeps memory state when storage is unavailable', () => {
+    const getItem = vi.spyOn(window.localStorage, 'getItem').mockImplementation(() => {
+      throw new Error('blocked')
+    })
+    expect(readCanvasBackgroundPatternFromStorage()).toBe('grid')
+    expect(useDebugLogStore.getState().entries[0]?.message).toContain('using grid default')
+    getItem.mockRestore()
+
+    const setItem = vi.spyOn(window.localStorage, 'setItem').mockImplementation(() => {
+      throw new Error('blocked')
+    })
+    useCanvasAppearanceStore.getState().setBackgroundPattern('dots')
+    expect(useCanvasAppearanceStore.getState().backgroundPattern).toBe('dots')
+    expect(useDebugLogStore.getState().entries.some((entry) => entry.level === 'warning')).toBe(true)
+    setItem.mockRestore()
+  })
+
+  it('opens and closes the canvas appearance panel independently', () => {
+    useCanvasAppearanceStore.getState().openCanvasAppearance()
+    expect(useCanvasAppearanceStore.getState().appearancePanelOpen).toBe(true)
+    useCanvasAppearanceStore.getState().closeCanvasAppearance()
+    expect(useCanvasAppearanceStore.getState().appearancePanelOpen).toBe(false)
+    expect(useDebugLogStore.getState().entries.map((entry) => entry.message)).toEqual([
+      'Canvas appearance settings closed',
+      'Canvas appearance settings opened',
+    ])
+  })
+})
