+import { useTranslation } from 'react-i18next'
+import {
+  CANVAS_BACKGROUND_PATTERNS,
+  useCanvasAppearanceStore,
+  type CanvasBackgroundPattern,
+} from '../../store/canvasAppearanceStore'
+import { t } from '../../i18n'
+
+const patternLabelKey: Record<CanvasBackgroundPattern, string> = {
+  grid: 'settings.canvas.grid',
+  dots: 'settings.canvas.dots',
+}
+
+export function CanvasAppearanceSection() {
+  useTranslation()
+  const selectedPattern = useCanvasAppearanceStore((state) => state.backgroundPattern)
+  const setPattern = useCanvasAppearanceStore((state) => state.setBackgroundPattern)
+
+  return (
+    <section className="settings-section canvas-appearance-section" data-section="canvas-appearance">
+      <div className="canvas-appearance-heading">
+        <div>
+          <h4>{t('settings.canvas.background')}</h4>
+          <p>{t('settings.canvas.backgroundDescription')}</p>
+        </div>
+      </div>
+      <div className="canvas-appearance-options" role="radiogroup" aria-label={t('settings.canvas.background')}>
+        {CANVAS_BACKGROUND_PATTERNS.map((pattern) => {
+          const selected = selectedPattern === pattern
+          return (
+            <button
+              key={pattern}
+              type="button"
+              className={`canvas-appearance-option${selected ? ' selected' : ''}`}
+              role="radio"
+              aria-checked={selected}
+              onClick={() => setPattern(pattern)}
+            >
+              <span className="canvas-pattern-preview" data-pattern={pattern} aria-hidden="true" />
+              <span className="canvas-appearance-option-label">{t(patternLabelKey[pattern])}</span>
+            </button>
+          )
+        })}
+      </div>
+    </section>
+  )
+}
