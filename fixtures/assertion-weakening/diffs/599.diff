@@ -0,0 +1,85 @@
+// @vitest-environment happy-dom
+//
+// review #599(4890810821)指出旧断言只验证"aria-checked=true 在 html 里存在一次",
+// 无法辨别选中态倒挂/错标。修复过程中发现问题比断言精度更深:旧测试用
+// renderToStaticMarkup(SSR 静态渲染)——zustand 的 useStore 把 React.useSyncExternalStore
+// 的 getServerSnapshot 接到 api.getInitialState()(node.js/zustand/react.js),SSR 路径下
+// 永远读"store 创建时的初始值"(此处固定为 grid),setBackgroundPattern('dots') 之后的
+// getState() 变化对 SSR 渲染完全不可见——旧测试从未真正渲染过"dots 被选中"这条分支,
+// 只是因为 grid 按钮恰好总是 aria-checked=true 才凑巧过。改用真实客户端挂载
+// (react-dom/client + act,沿用 KeyDialogEscapeBubbling.test.tsx 的先例)走
+// useSyncExternalStore 的客户端 getSnapshot=getState() 路径,才能让"dots 选中"这条分支
+// 被真实渡染和断言到。
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import i18n from '../../i18n'
+import { __resetCanvasAppearanceForTests, useCanvasAppearanceStore } from '../../store/canvasAppearanceStore'
+import { CanvasAppearanceSection } from './CanvasAppearanceSection'
+
+let container: HTMLDivElement
+let root: Root
+
+beforeEach(() => {
+  ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+})
+
+afterEach(() => {
+  act(() => {
+    root.unmount()
+  })
+  container.remove()
+})
+
+/** 按每个 radio 按钮内部的 data-pattern 预览 span 归属到对应选项。 */
+function getOptionButtons(): Record<'grid' | 'dots', HTMLButtonElement> {
+  const buttons = Array.from(container.querySelectorAll<HTMLButtonElement>('button[role="radio"]'))
+  const byPattern: Partial<Record<'grid' | 'dots', HTMLButtonElement>> = {}
+  for (const button of buttons) {
+    const pattern = button.querySelector('[data-pattern]')?.getAttribute('data-pattern')
+    if (pattern === 'grid' || pattern === 'dots') byPattern[pattern] = button
+  }
+  if (!byPattern.grid || !byPattern.dots) throw new Error('expected one radio button per pattern')
+  return byPattern as Record<'grid' | 'dots', HTMLButtonElement>
+}
+
+describe('CanvasAppearanceSection', () => {
+  it('renders the grid and dots choices with the selected state', () => {
+    __resetCanvasAppearanceForTests()
+    useCanvasAppearanceStore.getState().setBackgroundPattern('dots')
+    act(() => {
+      root.render(<CanvasAppearanceSection />)
+    })
+
+    expect(container.querySelector('[data-section="canvas-appearance"]')).not.toBeNull()
+    expect(container.textContent).toContain('Dots')
+
+    // 全局只应有一处选中标记(排除双 true / 全 false 静默通过)。
+    expect(container.querySelectorAll('[aria-checked="true"]')).toHaveLength(1)
+    expect(container.querySelectorAll('.canvas-appearance-option.selected')).toHaveLength(1)
+
+    // 逐选项按 store 当前值锚定,而不是只看"存在一个 true"。
+    const { grid, dots } = getOptionButtons()
+    expect(dots.getAttribute('aria-checked')).toBe('true')
+    expect(dots.classList.contains('selected')).toBe(true)
+    expect(grid.getAttribute('aria-checked')).toBe('false')
+    expect(grid.classList.contains('selected')).toBe(false)
+  })
+
+  it('keeps the option labels translated', async () => {
+    await i18n.changeLanguage('zh-CN')
+    try {
+      __resetCanvasAppearanceForTests()
+      act(() => {
+        root.render(<CanvasAppearanceSection />)
+      })
+      expect(container.textContent).toContain('网格')
+      expect(container.textContent).toContain('点状')
+    } finally {
+      await i18n.changeLanguage('en')
+    }
+  })
+})
