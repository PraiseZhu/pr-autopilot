diff --git a/cindyplugin/src/__tests__/pluginCanvasSettings.test.tsx b/cindyplugin/src/__tests__/pluginCanvasSettings.test.tsx
new file mode 100644
index 00000000..9312a3b3
--- /dev/null
+++ b/cindyplugin/src/__tests__/pluginCanvasSettings.test.tsx
@@ -0,0 +1,99 @@
+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const pluginState = vi.hoisted(() => ({ hydrated: true }))
+
+vi.mock('../usePluginHydration', () => ({ usePluginHydration: () => pluginState.hydrated }))
+vi.mock('../../../src/canvas/MivoCanvas', () => ({
+  MivoCanvas: () => <div data-testid="mivo-canvas" />,
+}))
+vi.mock('../../../src/app/ToastViewport', () => ({ ToastViewport: () => null }))
+vi.mock('../../../src/app/MediaLightbox', () => ({ MediaLightbox: () => null }))
+vi.mock('../../../src/app/DetailsTargetGuard', () => ({ DetailsTargetGuard: () => null }))
+vi.mock('../agent/depositMigration', () => ({
+  migrateLedgerIntoDepositStore: vi.fn(async () => ({ ok: true, skipped: true })),
+}))
+
+const { PluginApp } = await import('../PluginApp')
+const { __resetCanvasAppearanceForTests, useCanvasAppearanceStore } = await import(
+  '../../../src/store/canvasAppearanceStore'
+)
+
+let container: HTMLDivElement
+let root: Root
+
+const click = (element: Element) =>
+  act(() => {
+    if (element instanceof HTMLElement) element.focus()
+    element.dispatchEvent(new MouseEvent('click', { bubbles: true }))
+  })
+const pointerDown = (element: Element) =>
+  act(() => element.dispatchEvent(new PointerEvent('pointerdown', { bubbles: true })))
+
+const keyDown = (element: Element, init: KeyboardEventInit) =>
+  act(() => element.dispatchEvent(new KeyboardEvent('keydown', { bubbles: true, cancelable: true, ...init })))
+
+describe('PluginApp canvas settings entry', () => {
+  beforeEach(() => {
+    globalThis.IS_REACT_ACT_ENVIRONMENT = true
+    __resetCanvasAppearanceForTests()
+    container = document.createElement('div')
+    document.body.appendChild(container)
+    root = createRoot(container)
+    act(() => root.render(<PluginApp />))
+  })
+
+  afterEach(() => {
+    act(() => root.unmount())
+    container.remove()
+    document.querySelector('.canvas-settings-backdrop')?.remove()
+  })
+
+  it('opens from the gear, switches pattern, and closes with Escape', () => {
+    const gear = container.querySelector('.plugin-settings-trigger') as HTMLElement
+    click(gear)
+    expect(document.querySelector('.canvas-settings-backdrop')).not.toBeNull()
+    expect(document.activeElement).toBe(document.querySelector('.canvas-settings-panel'))
+
+    const dots = Array.from(document.querySelectorAll('[role="radio"]')).find((item) =>
+      item.textContent?.includes('Dots'),
+    )!
+    click(dots)
+    expect(useCanvasAppearanceStore.getState().backgroundPattern).toBe('dots')
+
+    act(() => window.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true })))
+    expect(document.querySelector('.canvas-settings-backdrop')).toBeNull()
+    expect(document.activeElement).toBe(gear)
+  })
+
+  it('wraps forward and backward Tab traversal inside the dialog', () => {
+    click(container.querySelector('.plugin-settings-trigger')!)
+    const panel = document.querySelector('.canvas-settings-panel') as HTMLElement
+    const focusables = Array.from(panel.querySelectorAll<HTMLElement>('button'))
+    const first = focusables[0]
+    const last = focusables.at(-1)!
+
+    last.focus()
+    keyDown(panel, { key: 'Tab' })
+    expect(document.activeElement).toBe(first)
+
+    first.focus()
+    keyDown(panel, { key: 'Tab', shiftKey: true })
+    expect(document.activeElement).toBe(last)
+  })
+
+  it('closes from the backdrop and close button and restores gear focus', () => {
+    const gear = container.querySelector('.plugin-settings-trigger') as HTMLElement
+    click(gear)
+    pointerDown(document.querySelector('.canvas-settings-backdrop')!)
+    expect(document.querySelector('.canvas-settings-backdrop')).toBeNull()
+    expect(document.activeElement).toBe(gear)
+
+    click(gear)
+    click(document.querySelector('.canvas-settings-panel .settings-panel-header button')!)
+    expect(document.querySelector('.canvas-settings-backdrop')).toBeNull()
+    expect(document.activeElement).toBe(gear)
+  })
+})
