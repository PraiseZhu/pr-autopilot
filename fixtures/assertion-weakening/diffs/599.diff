@@ -0,0 +1,93 @@
+import { useEffect, useRef, type KeyboardEvent as ReactKeyboardEvent } from 'react'
+import { createPortal } from 'react-dom'
+import { X } from 'lucide-react'
+import { useTranslation } from 'react-i18next'
+import { t } from '../../i18n'
+import { useCanvasAppearanceStore } from '../../store/canvasAppearanceStore'
+import { CanvasAppearanceSection } from './CanvasAppearanceSection'
+
+export function CanvasSettingsPanel() {
+  useTranslation()
+  const open = useCanvasAppearanceStore((state) => state.appearancePanelOpen)
+  const close = useCanvasAppearanceStore((state) => state.closeCanvasAppearance)
+  const panelRef = useRef<HTMLElement | null>(null)
+
+  useEffect(() => {
+    if (!open) return
+
+    const previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : undefined
+    panelRef.current?.focus()
+
+    const handleKeyDown = (event: KeyboardEvent) => {
+      if (event.key !== 'Escape') return
+      event.preventDefault()
+      event.stopPropagation()
+      close()
+    }
+    window.addEventListener('keydown', handleKeyDown)
+
+    return () => {
+      window.removeEventListener('keydown', handleKeyDown)
+      previousFocus?.focus()
+    }
+  }, [close, open])
+
+  const handlePanelKeyDown = (event: ReactKeyboardEvent<HTMLElement>) => {
+    if (event.key !== 'Tab') return
+
+    const panel = panelRef.current
+    if (!panel) return
+
+    const focusables = Array.from(
+      panel.querySelectorAll<HTMLElement>('button, input, textarea, select, [href], [tabindex]:not([tabindex="-1"])'),
+    ).filter((element) => !element.hasAttribute('disabled') && !element.closest('[inert]'))
+
+    if (focusables.length === 0) {
+      event.preventDefault()
+      return
+    }
+
+    const first = focusables[0]
+    const last = focusables[focusables.length - 1]
+    if (event.shiftKey && (document.activeElement === first || document.activeElement === panel)) {
+      event.preventDefault()
+      last.focus()
+    } else if (!event.shiftKey && document.activeElement === last) {
+      event.preventDefault()
+      first.focus()
+    }
+  }
+
+  if (!open) return null
+
+  return createPortal(
+    <div
+      className="settings-backdrop canvas-settings-backdrop"
+      role="presentation"
+      onPointerDown={(event) => {
+        if (event.target === event.currentTarget) close()
+      }}
+    >
+      <section
+        ref={panelRef}
+        className="settings-panel canvas-settings-panel"
+        role="dialog"
+        aria-modal="true"
+        aria-label={t('settings.canvas.title')}
+        tabIndex={-1}
+        onKeyDown={handlePanelKeyDown}
+      >
+        <header className="settings-panel-header">
+          <strong>{t('settings.canvas.title')}</strong>
+          <button type="button" aria-label={t('settings.close')} onClick={close}>
+            <X size={16} />
+          </button>
+        </header>
+        <div className="settings-panel-body">
+          <CanvasAppearanceSection />
+        </div>
+      </section>
+    </div>,
+    document.body,
+  )
+}
