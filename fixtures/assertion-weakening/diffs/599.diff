diff --git a/src/canvas/canvasPattern.ts b/src/canvas/canvasPattern.ts
new file mode 100644
index 00000000..d42152e0
--- /dev/null
+++ b/src/canvas/canvasPattern.ts
@@ -0,0 +1,57 @@
+import type { CSSProperties } from 'react'
+import type { CanvasBackgroundPattern } from '../store/canvasAppearanceStore'
+
+export type { CanvasBackgroundPattern } from '../store/canvasAppearanceStore'
+
+type CanvasPatternConfig = {
+  gap: number
+  lineWidth?: number
+  dotRadius?: number
+}
+
+/**
+ * MivoCanvas-owned geometry for the visible background patterns.
+ * Cindy may override the color tokens, but it must not own these values.
+ */
+export const CANVAS_PATTERN_CONFIG = {
+  grid: {
+    gap: 36,
+    lineWidth: 1,
+  },
+  dots: {
+    gap: 36,
+    dotRadius: 1,
+  },
+} as const satisfies Record<CanvasBackgroundPattern, CanvasPatternConfig>
+
+export const canvasPatternConfigFor = (pattern: CanvasBackgroundPattern) => CANVAS_PATTERN_CONFIG[pattern]
+
+export const canvasPatternSizeFor = (pattern: CanvasBackgroundPattern, scale: number) => {
+  const config = canvasPatternConfigFor(pattern)
+  const size = config.gap * scale
+  return Number.isFinite(size) && size > 0 ? size : config.gap
+}
+
+/** Keep repeated CSS background offsets bounded while preserving their phase. */
+export const canvasPatternOffsetFor = (offset: number, patternSize: number) => {
+  if (!Number.isFinite(offset) || !Number.isFinite(patternSize) || patternSize <= 0) return 0
+  const remainder = offset % patternSize
+  return Object.is(remainder, -0) ? 0 : remainder
+}
+
+export const canvasBackgroundStyleFor = (
+  pattern: CanvasBackgroundPattern,
+  viewport: { x: number; y: number; scale: number },
+): CSSProperties => {
+  const config = canvasPatternConfigFor(pattern)
+  const patternSize = canvasPatternSizeFor(pattern, viewport.scale)
+  const lineWidth = 'lineWidth' in config ? config.lineWidth : 1
+  const dotRadius = 'dotRadius' in config ? config.dotRadius : 1
+  return {
+    backgroundPosition: `${canvasPatternOffsetFor(viewport.x, patternSize)}px ${canvasPatternOffsetFor(viewport.y, patternSize)}px`,
+    backgroundSize: `${patternSize}px ${patternSize}px`,
+    '--mivo-canvas-pattern-gap': `${config.gap}px`,
+    '--mivo-canvas-pattern-line-width': `${lineWidth}px`,
+    '--mivo-canvas-pattern-dot-radius': `${dotRadius}px`,
+  } as CSSProperties
+}
