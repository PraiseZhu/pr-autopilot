index 00000000..16d464fb
--- /dev/null
+++ b/src/__tests__/canvasSnapshotMediaDisciplineText.test.ts
@@ -0,0 +1,93 @@
+/**
+ * #297 T3c:`canvas_snapshot` 的 ghost 描述文本(mediaNodeIds 纪律 + imageRef 载体
+ * 说明)与生产代码逐条对账,防"说明书假话"(本 dispatch 当晚已三次撞上文本与实现
+ * 不符的事故——ghost 键形状写错、AI 说明书把新能力写成不支持、机制模型判断错误)。
+ *
+ * 只锁"数字/前缀这类可编程比对的锚点",不锁整段散文——散文表述允许改写,但里面
+ * 引用的具体常量值/字符串前缀一旦跟代码脱钩,必须立刻被这个测试文件抓到。
+ *
+ * 范围声明(诚实边界):本文件不校验 selectionObservation/三层递进/批次线索这部分
+ * Agent 纪律——那些字段属于 Task①(选中可见)的产出,在本分支(base
+ * feat/297-t3b1-fix)尚未落地,写了会自我打脸("文本引用不存在的字段")。等
+ * Task① 落地、本段 rebase 之后再补那一段纪律文本与对应断言,不在本次交付范围内
+ * 假装已完成。
+ */
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+const GHOST_PATH = fileURLToPath(new URL('../../ghost.json', import.meta.url))
+const MAIN_JS_PATH = fileURLToPath(new URL('../../main.js', import.meta.url))
+const AGENT_BRIDGE_PATH = fileURLToPath(new URL('../agent/agentBridge.ts', import.meta.url))
+const MEDIA_REF_FORMAT_PATH = fileURLToPath(new URL('../agent/mediaRefFormat.ts', import.meta.url))
+
+type Manifest = {
+  tools: Array<{ name: string; description: string; parameters: { properties: Record<string, unknown> } }>
+}
+
+const manifest = (): Manifest => JSON.parse(readFileSync(GHOST_PATH, 'utf8')) as Manifest
+
+const canvasSnapshotTool = () => {
+  const tool = manifest().tools.find((item) => item.name === 'canvas_snapshot')
+  if (!tool) throw new Error('ghost.json 里找不到 canvas_snapshot 工具声明')
+  return tool
+}
+
+/** 从源码文本里抠出 `MEDIA_NODE_IDS_MAX = <数字>` 的字面量,不 import 运行时模块
+ *  ——main.js 是不过打包的自包含脚本,agentBridge.ts 的常量也没有导出,直接读
+ *  源文本比强行导出一个仅供测试使用的符号更贴近"两份独立代码各自维护"的既有约定
+ *  (mediaRefFormat.ts 顶部注释里已经点名的那个约定)。 */
+const extractMediaNodeIdsMax = (filePath: string): number => {
+  const text = readFileSync(filePath, 'utf8')
+  const match = text.match(/MEDIA_NODE_IDS_MAX\s*=\s*(\d+)/)
+  if (!match) throw new Error(`${filePath} 里找不到 MEDIA_NODE_IDS_MAX 常量`)
+  return Number(match[1])
+}
+
+describe('SC-T3c.1 canvas_snapshot 描述文本与 mediaNodeIds 生产代码对账', () => {
+  it('main.js 与 agentBridge.ts 的 MEDIA_NODE_IDS_MAX 两份独立代码彼此一致', () => {
+    const fromMainJs = extractMediaNodeIdsMax(MAIN_JS_PATH)
+    const fromAgentBridge = extractMediaNodeIdsMax(AGENT_BRIDGE_PATH)
+    expect(fromMainJs).toBe(fromAgentBridge)
+  })
+
+  it('description 与 mediaNodeIds 参数描述里写的上限数字,与代码常量一致', () => {
+    const codeMax = extractMediaNodeIdsMax(AGENT_BRIDGE_PATH)
+    const tool = canvasSnapshotTool()
+    const mediaNodeIdsProp = tool.parameters.properties.mediaNodeIds as
+      | { description?: string; type?: string; items?: { type?: string } }
+      | undefined
+    expect(mediaNodeIdsProp).toBeDefined()
+    expect(mediaNodeIdsProp?.type).toBe('array')
+    expect(mediaNodeIdsProp?.items?.type).toBe('string')
+    // 顶层 description 与参数自身 description 都提到了上限,两处都必须对得上代码值——
+    // 任一处将来单独改了代码常量却没改文本,这条测试立刻变红。
+    expect(tool.description).toContain(`最多 ${codeMax} 个`)
+    expect(mediaNodeIdsProp?.description).toContain(`最多 ${codeMax} 个`)
+  })
+
+  it('description 里的 imageRef 前缀与 mediaRefFormat.ts 实际拼接的前缀一致', () => {
+    const tool = canvasSnapshotTool()
+    const source = readFileSync(MEDIA_REF_FORMAT_PATH, 'utf8')
+    // buildImageRef 的模板字面量固定形如 `cindy-media://blobs/${hash}${ext}`;
+    // 这里只断言字面前缀子串存在,不解析模板——足够抓住"前缀改了但文本没跟着改"
+    // 这一类事故,不需要真的跑一遍拼接逻辑(那是 mediaFilePathFormula.test.ts 的活)。
+    expect(source).toContain('cindy-media://blobs/')
+    expect(tool.description).toContain('cindy-media://blobs/<hash><ext>')
+  })
+
+  it('description 里的落盘路径推导公式与 T0 冻结契约的分片规则(前 2 位)描述一致', () => {
+    const tool = canvasSnapshotTool()
+    // 公式本身的可执行版本在 T3b2 的 deriveMediaFilePath(独立 PR,不在本分支)——
+    // 本条只锁"文本自己内部有没有前后矛盾"这一层:分片键的位数描述与路径模板
+    // 里出现的位数一致,防止散文改写时把"前 2 位"悄悄改成别的数字却漏改模板。
+    expect(tool.description).toContain('前 2 位小写')
+    expect(tool.description).toContain('blobs/<hash 前 2 位小写>/<hash><ext>')
+  })
+
+  it('description 不得只字未提 mediaSummary/mediaStates 输出形状(否则 agent 拿到字段却不知道怎么解读)', () => {
+    const tool = canvasSnapshotTool()
+    expect(tool.description).toContain('mediaStates')
+    expect(tool.description).toContain('mediaSummary')
+  })
+})
