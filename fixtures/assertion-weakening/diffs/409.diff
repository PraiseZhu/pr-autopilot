+// @vitest-environment happy-dom
+// menuOverlayStack(context-menu-standard R6)——Escape 分层的纯 handler 测试:
+// - capture 层次级浮层(快捷条/文字条子菜单):任一右键菜单(画布 .node-context-menu
+//   或共享 .sidebar-context-menu)开着就让行,否则消费(preventDefault +
+//   stopImmediatePropagation)并关闭;
+// - 右键菜单自身:总是消费(preventDefault + stopPropagation)并关闭。
+// 钉住"共享菜单也在让行名单里"(终审第二轮第 1 条:只让行画布菜单会把共享菜单饿死)。
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { handleContextMenuEscape, handleOverlayEscape, isContextMenuOpen } from './menuOverlayStack'
+
+const mountMenu = (className: string) => {
+  const el = document.createElement('div')
+  el.className = className
+  document.body.appendChild(el)
+  return el
+}
+
+afterEach(() => {
+  document.body.innerHTML = ''
+})
+
+const escapeEvent = () => ({
+  key: 'Escape',
+  preventDefault: vi.fn(),
+  stopPropagation: vi.fn(),
+  stopImmediatePropagation: vi.fn(),
+})
+
+describe('handleOverlayEscape(capture 层次级浮层)', () => {
+  it('画布右键菜单开着 → 让行:不消费事件、不关闭', () => {
+    mountMenu('node-context-menu')
+    const event = escapeEvent()
+    const close = vi.fn()
+    expect(handleOverlayEscape(event, close)).toBe(false)
+    expect(close).not.toHaveBeenCalled()
+    expect(event.preventDefault).not.toHaveBeenCalled()
+    expect(event.stopImmediatePropagation).not.toHaveBeenCalled()
+  })
+
+  it('共享右键菜单(.sidebar-context-menu)开着 → 同样让行(终审第二轮第 1 条)', () => {
+    mountMenu('sidebar-context-menu')
+    const event = escapeEvent()
+    const close = vi.fn()
+    expect(handleOverlayEscape(event, close)).toBe(false)
+    expect(close).not.toHaveBeenCalled()
+    expect(event.stopImmediatePropagation).not.toHaveBeenCalled()
+  })
+
+  it('没有右键菜单 → 消费事件(preventDefault + stopImmediatePropagation)并关闭', () => {
+    const event = escapeEvent()
+    const close = vi.fn()
+    expect(handleOverlayEscape(event, close)).toBe(true)
+    expect(close).toHaveBeenCalledTimes(1)
+    expect(event.preventDefault).toHaveBeenCalledTimes(1)
+    expect(event.stopImmediatePropagation).toHaveBeenCalledTimes(1)
+  })
+
+  it('非 Escape 键 → 完全不介入', () => {
+    const event = { ...escapeEvent(), key: 'Enter' }
+    const close = vi.fn()
+    expect(handleOverlayEscape(event, close)).toBe(false)
+    expect(close).not.toHaveBeenCalled()
+    expect(event.preventDefault).not.toHaveBeenCalled()
+  })
+})
+
+describe('handleContextMenuEscape(右键菜单自身)', () => {
+  it('Escape → 总是消费(preventDefault + stopPropagation)并关闭', () => {
+    const event = escapeEvent()
+    const close = vi.fn()
+    expect(handleContextMenuEscape(event, close)).toBe(true)
+    expect(close).toHaveBeenCalledTimes(1)
+    expect(event.preventDefault).toHaveBeenCalledTimes(1)
+    expect(event.stopPropagation).toHaveBeenCalledTimes(1)
+  })
+
+  it('非 Escape 键 → 不介入', () => {
+    const event = { ...escapeEvent(), key: 'a' }
+    const close = vi.fn()
+    expect(handleContextMenuEscape(event, close)).toBe(false)
+    expect(close).not.toHaveBeenCalled()
+  })
+})
+
+describe('isContextMenuOpen(让行名单)', () => {
+  it('画布菜单或共享菜单任一存在都算开;都不存在为关', () => {
+    expect(isContextMenuOpen()).toBe(false)
+    const canvasMenu = mountMenu('node-context-menu')
+    expect(isContextMenuOpen()).toBe(true)
+    canvasMenu.remove()
+    expect(isContextMenuOpen()).toBe(false)
+    mountMenu('sidebar-context-menu')
+    expect(isContextMenuOpen()).toBe(true)
+  })
+})
