+// @vitest-environment happy-dom
+// replaceFileNodeAsset(context-menu-standard §5,阶段 4):markdown/pdf/video 的
+// Replace file——markdown 同步替换正文 text;missing/locked/类型不符时拒绝并
+// 返回 false(调用方按返回值反馈,不误报成功)。真 store 测试。
+//
+// fixture 必须走 normalizeCanvasNodeV2:生产导入节点 normalize 后同时携带
+// canonical(node.asset)与 legacy 镜像(assetUrl/...),canonical 映射与服务端
+// 快照优先读 node.asset——手造纯 legacy fixture 曾放过"只改镜像、canonical 仍指
+// 旧文件"的持久化故障(终审第二轮第 3/8 条)。
+import { beforeEach, describe, expect, it } from 'vitest'
+import { useCanvasStore } from './canvasStore'
+import { normalizeCanvasNodeV2 } from '../model/documentModelV2'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+const node = (seed: Partial<MivoCanvasNode> & { id: string }): MivoCanvasNode =>
+  normalizeCanvasNodeV2(
+    {
+      type: 'markdown',
+      title: seed.id,
+      x: 0,
+      y: 0,
+      width: 100,
+      height: 100,
+      status: 'ready',
+      ...seed,
+    } as MivoCanvasNode,
+  )
+
+describe('replaceFileNodeAsset — §5 Replace file', () => {
+  beforeEach(() => {
+    useCanvasStore.setState({
+      nodes: [
+        node({
+          id: 'md',
+          type: 'markdown',
+          text: '# old',
+          assetUrl: 'imported-asset://old-md',
+          assetMimeType: 'text/markdown',
+          assetOriginalName: 'old.md',
+          assetSizeBytes: 5,
+        }),
+        node({ id: 'pdf', type: 'pdf', assetUrl: 'imported-asset://old-pdf' }),
+        node({ id: 'img', type: 'image', assetUrl: 'imported-asset://img' }),
+      ],
+      selectedNodeId: undefined,
+      selectedNodeIds: [],
+    })
+    // 前置自检:normalize 后 fixture 必须已带 canonical asset,否则下面的
+    // canonical 断言全是空转。
+    expect(useCanvasStore.getState().nodes.find((item) => item.id === 'md')?.asset?.url).toBe('imported-asset://old-md')
+  })
+
+  it('markdown:替换资产并同步替换正文 text;canonical 与镜像同步指向新资产', () => {
+    const ok = useCanvasStore.getState().replaceFileNodeAsset('md', 'imported-asset://new-md', { text: '# new' })
+    expect(ok).toBe(true)
+    const md = useCanvasStore.getState().nodes.find((item) => item.id === 'md')
+    expect(md?.assetUrl).toBe('imported-asset://new-md')
+    expect(md?.asset?.url).toBe('imported-asset://new-md')
+    expect(md?.text).toBe('# new')
+    // 再走一遍 normalize(≈ 持久化/快照映射的入口):canonical 仍是新资产,
+    // 不会被残留旧 asset 覆写回去。
+    expect(normalizeCanvasNodeV2(md as MivoCanvasNode).asset?.url).toBe('imported-asset://new-md')
+  })
+
+  it('pdf:只换资产;metadata 原子更新 canonical + Inspector 镜像三字段(终审 MAJOR-3)', () => {
+    const ok = useCanvasStore.getState().replaceFileNodeAsset('pdf', 'imported-asset://new-pdf', {
+      metadata: { mimeType: 'application/pdf', originalName: 'v2.pdf', sizeBytes: 2048 },
+    })
+    expect(ok).toBe(true)
+    const pdf = useCanvasStore.getState().nodes.find((item) => item.id === 'pdf')
+    expect(pdf?.assetUrl).toBe('imported-asset://new-pdf')
+    expect(pdf?.assetMimeType).toBe('application/pdf')
+    expect(pdf?.assetOriginalName).toBe('v2.pdf')
+    expect(pdf?.assetSizeBytes).toBe(2048)
+    expect(pdf?.asset).toMatchObject({
+      url: 'imported-asset://new-pdf',
+      mimeType: 'application/pdf',
+      originalName: 'v2.pdf',
+      sizeBytes: 2048,
+    })
+  })
+
+  it('替换是单个撤销单元:undo 一步回到旧资产(canonical+镜像)与旧正文', () => {
+    useCanvasStore.getState().replaceFileNodeAsset('md', 'imported-asset://new-md', {
+      text: '# new',
+      metadata: { mimeType: 'text/markdown', originalName: 'new.md', sizeBytes: 5 },
+    })
+    useCanvasStore.getState().undo()
+    const md = useCanvasStore.getState().nodes.find((item) => item.id === 'md')
+    expect(md?.assetUrl).toBe('imported-asset://old-md')
+    expect(md?.asset?.url).toBe('imported-asset://old-md')
+    expect(md?.text).toBe('# old')
+  })
+
+  it('拒绝:image 类型 / 不存在 / 已锁定 → 返回 false 且不改状态', () => {
+    expect(useCanvasStore.getState().replaceFileNodeAsset('img', 'imported-asset://x')).toBe(false)
+    expect(useCanvasStore.getState().replaceFileNodeAsset('ghost', 'imported-asset://x')).toBe(false)
+    useCanvasStore.setState({
+      nodes: useCanvasStore.getState().nodes.map((item) => (item.id === 'md' ? { ...item, locked: true } : item)),
+    })
+    expect(useCanvasStore.getState().replaceFileNodeAsset('md', 'imported-asset://y', { text: 'z' })).toBe(false)
+    const md = useCanvasStore.getState().nodes.find((item) => item.id === 'md')
+    expect(md?.text).toBe('# old')
+    expect(md?.asset?.url).toBe('imported-asset://old-md')
+  })
+})
