new file mode 100644
index 00000000..8f13ba69
--- /dev/null
+++ b/src/canvas/useFileNodeActions.ts
@@ -0,0 +1,231 @@
+// useFileNodeActions — markdown/pdf/video 的 Replace file 与 pdf Open preview
+// (context-menu-standard §5,阶段 4 实装)。Replace 流程与 useImageEditActions 的
+// replaceImageNode 同款契约:选文件前后双重校验(missing/locked)、异步落地后按
+// store 返回值决定成功/拒绝反馈、拒绝时清理孤儿资产。
+//
+// 终审加固(2026-08-01):
+// - 替换文件先过字节签名闸(inspectFileSignature,与 canonical 导入同一份判定),
+//   accept 只是选择器提示,伪装/错族文件在触碰 assetStorage 前判死;
+// - 资产元数据(assetMimeType/assetOriginalName/assetSizeBytes)随替换原子更新,
+//   Inspector 不再展示旧文件的来源信息;
+// - Open preview 在点击栈内同步预开窗口(保住用户激活),被 popup blocker 拦下
+//   如实 toast,不再记假成功。
+import { useCallback } from 'react'
+import { useCanvasStore } from '../store/canvasStore'
+import { debugLogger } from '../store/debugLogStore'
+import { toastFeedback } from '../store/toastStore'
+import { deleteImportedAsset, isImportedAssetUrl, readImportedAssetFile, saveImportedAsset } from '../lib/assetStorage'
+import { canvasAssetNodeTypeForFile } from '../lib/canvasAssetImport'
+import { inspectFileSignature } from '../lib/fileSignature'
+import { wrapMutation } from './actions/canvasSyncRuntime'
+import { isEffectivelyLocked } from '../store/canvasDocumentModel'
+import { t } from '../i18n'
+
+const REPLACEABLE_FILE_TYPES = ['markdown', 'pdf', 'video'] as const
+export type ReplaceableFileType = (typeof REPLACEABLE_FILE_TYPES)[number]
+
+const acceptByType: Record<ReplaceableFileType, string> = {
+  markdown: '.md,.markdown,text/markdown',
+  pdf: 'application/pdf,.pdf',
+  video: 'video/*',
+}
+
+const isReplaceableFileType = (type: string): type is ReplaceableFileType =>
+  (REPLACEABLE_FILE_TYPES as readonly string[]).includes(type)
+
+/** 替换文件的准入校验(纯函数,单测覆盖):扩展名/类型解析必须与节点类型同族,
+ *  且字节签名过闸(与 prepareCanvasFileImport 同一份 inspectFileSignature)。 */
+export const validateReplacementFile = async (
+  file: File,
+  expectedType: ReplaceableFileType,
+): Promise<{ ok: true } | { ok: false; reason: string }> => {
+  const resolvedType = canvasAssetNodeTypeForFile(file)
+  if (resolvedType !== expectedType) {
+    return { ok: false, reason: `declared ${resolvedType || 'unknown'}, node is ${expectedType}` }
+  }
+  const signature = await inspectFileSignature(file, expectedType)
+  if (!signature.matchesNodeType) {
+    return { ok: false, reason: `content signature mismatch: bytes look like ${signature.container || 'unknown'}` }
+  }
+  return { ok: true }
+}
+
+// 预览导航只放行这三种协议:同步预开的 about:blank 窗口与本站同源,放进
+// javascript:(乃至 data:/file:)就是把 crafted/服务端同步来的 assetUrl 变成可
+// 执行导航(终审第二轮第 4 条)。相对 URL 按当前站点解析,落在 http(s) 内。
+const safePreviewProtocols = new Set(['http:', 'https:', 'blob:'])
+
+export const isSafePreviewUrl = (url: string): boolean => {
+  try {
+    return safePreviewProtocols.has(new URL(url, window.location.href).protocol)
+  } catch {
+    return false
+  }
+}
+
+/** 预览窗导航(可注入 window 句柄单测):协议不过闸或导航抛错时关窗+立即回收
+ *  blob URL 并返回 false;成功时 blob 场景 60s 后回收。 */
+export const navigatePreviewWindow = (win: Window | null, url: string, revoke?: () => void): boolean => {
+  if (!win) {
+    revoke?.()
+    return false
+  }
+  if (!isSafePreviewUrl(url)) {
+    win.close()
+    revoke?.()
+    return false
+  }
+  try {
+    win.opener = null
+    win.location.replace(url)
+  } catch {
+    win.close()
+    revoke?.()
+    return false
+  }
+  if (revoke) {
+    // blob URL 与预览窗同寿命:窗口关闭后才回收。固定 60s 定时会在查看器
+    // reload/后退再前进重新取流时把还在用的 URL 撤销掉(Greptile P1)。
+    const timer = window.setInterval(() => {
+      if (win.closed) {
+        window.clearInterval(timer)
+        revoke()
+      }
+    }, 5_000)
+  }
+  return true
+}
+
+export function useFileNodeActions() {
+  const replaceFileNodeAsset = useCanvasStore((state) => state.replaceFileNodeAsset)
+
+  const replaceFileNode = useCallback(
+    (nodeId: string) => {
+      // 钉住发起时的画布:文件对话框可以无限期开着,期间用户可能切画布——
+      // 复制画布与源画布共享节点 id(nodeFactory.cloneNode 保留 id),不钉
+      // sceneId 会把文件替换到另一块画布的同 id 节点上(Greptile P1)。
+      const { nodes, sceneId } = useCanvasStore.getState()
+      const target = nodes.find((node) => node.id === nodeId && isReplaceableFileType(node.type))
+      if (!target || isEffectivelyLocked(nodes, target)) {
+        debugLogger.warn('Document', `Replace file blocked: node ${nodeId} missing or locked`)
+        toastFeedback.warn(t('toast.fileEdit.replaceBlocked'))
+        return
+      }
+      const fileType = target.type as ReplaceableFileType
+
+      const input = document.createElement('input')
+      input.type = 'file'
+      input.accept = acceptByType[fileType]
+
+      input.onchange = async () => {
+        const file = input.files?.[0]
+        if (!file) return
+        // 文件对话框可以无限期开着:落地前重查画布未切换、节点仍在且未锁。
+        const now = useCanvasStore.getState()
+        const stillThere = now.nodes.find((node) => node.id === nodeId && node.type === fileType)
+        if (now.sceneId !== sceneId || !stillThere || isEffectivelyLocked(now.nodes, stillThere)) {
+          debugLogger.warn('Document', `Replace file aborted before upload: canvas switched or node ${nodeId} missing/locked`)
+          toastFeedback.warn(t('toast.fileEdit.replaceBlocked'))
+          return
+        }
+        try {
+          const verdict = await validateReplacementFile(file, fileType)
+          if (!verdict.ok) {
+            debugLogger.warn('Document', `Replace file rejected for ${nodeId}: ${verdict.reason}`)
+            toastFeedback.warn(t('toast.fileEdit.replaceInvalid'))
+            return
+          }
+          // markdown 的渲染源是 node.text:替换资产的同时同步读入新正文。
+          const text = fileType === 'markdown' ? await file.text() : undefined
+          const asset = await saveImportedAsset(file)
+          // 读正文/落盘资产都是 await:提交前最后一道画布归属闸(同 id 节点
+          // 存在于复制画布时,store 的 missing 检查挡不住,必须看 sceneId)。
+          if (useCanvasStore.getState().sceneId !== sceneId) {
+            const cleaned = await deleteImportedAsset(asset.assetUrl)
+            debugLogger.warn(
+              'Document',
+              `Replace file aborted: canvas switched before commit; orphan asset ${asset.assetUrl} ${cleaned ? 'deleted' : 'left for GC'}`,
+            )
+            toastFeedback.warn(t('toast.fileEdit.replaceBlocked'))
+            return
+          }
+          const replaced = wrapMutation(replaceFileNodeAsset)(nodeId, asset.assetUrl, {
+            text,
+            metadata: {
+              mimeType: asset.type || file.type || undefined,
+              originalName: asset.name,
+              sizeBytes: asset.sizeBytes,
+            },
+          })
+          if (replaced) {
+            toastFeedback.success(t('toast.fileEdit.replaced'))
+          } else {
+            const cleaned = await deleteImportedAsset(asset.assetUrl)
+            debugLogger.warn(
+              'Document',
+              `Replace file refused for ${nodeId}; orphan asset ${asset.assetUrl} ${cleaned ? 'deleted' : 'left for GC'}`,
+            )
+            toastFeedback.warn(t('toast.fileEdit.replaceRefused'))
+          }
+        } catch (error) {
+          debugLogger.error(
+            'Document',
+            `Replace file failed for ${nodeId}: ${error instanceof Error ? error.message : String(error)}`,
+          )
+          toastFeedback.error(t('toast.fileEdit.replaceFailed'))
+        }
+      }
+
+      input.click()
+    },
+    [replaceFileNodeAsset],
+  )
+
+  const openFilePreview = useCallback(async (nodeId: string) => {
+    const node = useCanvasStore.getState().nodes.find((item) => item.id === nodeId)
+    if (!node?.assetUrl) {
+      debugLogger.warn('Document', `Open preview skipped: node ${nodeId} has no assetUrl`)
+      toastFeedback.warn(t('toast.document.previewUnavailable'))
+      return
+    }
+    // 点击栈内同步预开:异步读资产之后再 window.open 会丢用户激活,被
+    // popup blocker 拦下还会记假成功(终审第 4 条)。
+    const previewWindow = window.open('', '_blank')
+    if (!previewWindow) {
+      debugLogger.warn('Document', `Open preview blocked by the browser for ${nodeId}`)
+      toastFeedback.warn(t('toast.document.previewBlocked'))
+      return
+    }
+    try {
+      let navigated: boolean
+      if (isImportedAssetUrl(node.assetUrl)) {
+        const asset = await readImportedAssetFile(node.assetUrl)
+        if (!asset) {
+          previewWindow.close()
+          debugLogger.warn('Document', `Open preview failed: imported asset missing for ${nodeId}`)
+          toastFeedback.warn(t('toast.document.previewUnavailable'))
+          return
+        }
+        const url = URL.createObjectURL(asset.blob)
+        navigated = navigatePreviewWindow(previewWindow, url, () => URL.revokeObjectURL(url))
+      } else {
+        navigated = navigatePreviewWindow(previewWindow, node.assetUrl)
+      }
+      if (!navigated) {
+        debugLogger.warn('Document', `Open preview refused for ${nodeId}: unsupported or failed navigation URL`)
+        toastFeedback.warn(t('toast.document.previewUnavailable'))
+        return
+      }
+      debugLogger.log('Document', `Opened preview for ${nodeId}`)
+    } catch (error) {
+      previewWindow.close()
+      debugLogger.error(
+        'Document',
+        `Open preview failed for ${nodeId}: ${error instanceof Error ? error.message : String(error)}`,
+      )
+      toastFeedback.error(t('toast.document.previewUnavailable'))
+    }
+  }, [])
+
+  return { replaceFileNode, openFilePreview }
+}
