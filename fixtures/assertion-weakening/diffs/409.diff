+// documentActionGroups — markdown/pdf/video 的右键菜单专属组(context-menu-standard
+// §5,2026-08-01 拍板,阶段 4 实装)。三类型此前只有骨架组零专属项;按标准:
+//   markdown → Copy as Markdown + Replace file(详情入口沿用骨架 View details,
+//              不做假 Edit;真 Markdown 编辑器立项后再回填,见 §5 决策)
+//   pdf      → Open preview + Replace file
+//   video    → Replace file
+// 共同约束:不加任何 AI 生成项(生成链路不吃文档/视频输入);Download 由骨架
+// export 组覆盖,不重复设项。
+import { ClipboardCopy, ExternalLink, FileUp } from 'lucide-react'
+import { t } from '../../i18n'
+import { debugLogger } from '../../store/debugLogStore'
+import { toastFeedback } from '../../store/toastStore'
+import type { CanvasActionGroup, CanvasActionItem, CanvasActionRuntime } from './canvasActionTypes'
+
+// Copy as Markdown:markdown 节点的正文(node.text,导入时已读入)进系统剪贴板。
+// 空文与剪贴板失败都要有可见反馈(dev-logging 规则)。
+const copyMarkdownSource = async (runtime: CanvasActionRuntime) => {
+  const node = runtime.context.primaryNode
+  const source = node?.text ?? ''
+  if (!source.trim()) {
+    debugLogger.warn('Document', `Copy as Markdown skipped: node ${node?.id ?? '?'} has no source text`)
+    toastFeedback.warn(t('toast.document.copyEmpty'))
+    return
+  }
+  try {
+    await navigator.clipboard.writeText(source)
+    debugLogger.log('Document', `Copied markdown source of ${node?.id} (${source.length} chars)`)
+    toastFeedback.success(t('toast.document.copied'))
+  } catch (error) {
+    debugLogger.error('Document', `Copy as Markdown failed: ${error instanceof Error ? error.message : String(error)}`)
+    toastFeedback.error(t('toast.document.copyFailed'))
+  }
+}
+
+export const documentContextMenuGroupsFor = (runtime: CanvasActionRuntime): CanvasActionGroup[] => {
+  const node = runtime.context.primaryNode
+  if (!node) return []
+
+  const actions: CanvasActionItem[] = []
+  if (node.type === 'markdown') {
+    actions.push({
+      id: 'copy-source',
+      label: t('menu.document.copySource'),
+      icon: ClipboardCopy,
+      onClick: () => void copyMarkdownSource(runtime),
+    })
+  }
+  if (node.type === 'pdf') {
+    actions.push({
+      id: 'open-preview',
+      label: t('menu.document.openPreview'),
+      icon: ExternalLink,
+      onClick: () => runtime.onOpenFilePreview?.(node.id),
+    })
+  }
+  actions.push({
+    id: 'replace-file',
+    label: t('menu.document.replaceFile'),
+    icon: FileUp,
+    onClick: () => runtime.onReplaceFile?.(node.id),
+  })
+
+  return [{ id: 'document', actions }]
+}
