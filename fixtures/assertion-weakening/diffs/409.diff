@@ -0,0 +1,48 @@
+// menuOverlayStack — Escape 分层(context-menu-standard R6)的单一来源。
+//
+// 分层规则:右键菜单(画布 .node-context-menu / 共享 .sidebar-context-menu)是
+// 最上层浮层。capture 层的次级浮层(快捷条子菜单、文字工具条子菜单等)收到
+// Escape 时必须先查这里的选择器让行——只对 .node-context-menu 让行会把共享菜单
+// 饿死(快捷条 capture+stopImmediatePropagation 先吃掉事件,共享菜单永远收不到,
+// 终审第二轮第 1 条)。新增右键菜单形态时把根节点 class 加进 contextMenuSelector。
+export const contextMenuSelector = '.node-context-menu, .sidebar-context-menu'
+
+type QueryableDocument = Pick<Document, 'querySelector'>
+
+export const isContextMenuOpen = (doc: QueryableDocument = document): boolean =>
+  Boolean(doc.querySelector(contextMenuSelector))
+
+type OverlayEscapeEvent = Pick<KeyboardEvent, 'key' | 'preventDefault' | 'stopImmediatePropagation'>
+
+/**
+ * capture 层次级浮层的 Escape 处理:任一右键菜单开着时让行(返回 false,事件
+ * 原样穿透给菜单);否则消费事件(preventDefault + stopImmediatePropagation,
+ * 防止 bubble 层全局 Escape 同帧继续清选区/工具)并执行 close。
+ */
+export const handleOverlayEscape = (
+  event: OverlayEscapeEvent,
+  close: () => void,
+  doc: QueryableDocument = document,
+): boolean => {
+  if (event.key !== 'Escape') return false
+  if (isContextMenuOpen(doc)) return false
+  event.preventDefault()
+  event.stopImmediatePropagation()
+  close()
+  return true
+}
+
+type MenuEscapeEvent = Pick<KeyboardEvent, 'key' | 'preventDefault' | 'stopPropagation'>
+
+/**
+ * 右键菜单自身的 Escape 处理:菜单是最上层,总是消费事件(preventDefault +
+ * stopPropagation)并关闭——不消费的话,画布 window 层全局 Escape 会同帧继续
+ * 清编辑态/选区/工具(终审第一轮第 1 条)。
+ */
+export const handleContextMenuEscape = (event: MenuEscapeEvent, close: () => void): boolean => {
+  if (event.key !== 'Escape') return false
+  event.preventDefault()
+  event.stopPropagation()
+  close()
+  return true
+}
