diff --git a/src/lib/menuOverlayStack.contract.test.ts b/src/lib/menuOverlayStack.contract.test.ts
new file mode 100644
index 00000000..def05d90
--- /dev/null
+++ b/src/lib/menuOverlayStack.contract.test.ts
@@ -0,0 +1,194 @@
+// menuOverlayStack 合同守卫(context-menu-standard R6,终审第三/四轮):
+// "右键菜单开着时 Escape 先关菜单"要成立,前提是**所有** capture 层的 keydown
+// 消费者都让行——任何一个不让行的 capture 处理器都会把菜单饿死(事件到不了
+// 菜单所在的 document bubble 层)。
+//
+// 用 TypeScript AST 逐注册分析(第四/五轮升级,不再是正则挑形态):
+// 1. 枚举全部 src 非测试源码里的 addEventListener('keydown', <任意 handler 表达式>,
+//    <options>) 调用,options 为 `true` 或含 capture: true 的对象字面量(可带
+//    once 等其他属性,键可以是标识符或字符串字面量)都算 capture;静态判不了的
+//    一律红灯要求人工改写——包括 options 是标识符/非字面量、对象里有展开、
+//    computed 键、以及 `{ capture }` shorthand / capture 值非布尔字面量(第五轮
+//    封口:这些形态既不许进 capture 也不许静默溜走);
+// 2. 含 capture keydown 注册的文件集合与登记表钉死(新增文件必登记);
+// 3. **逐注册 verdict,无例外必须让行**(第六轮起不按 Escape 文本自动豁免——
+//    `event.key !== ESCAPE_KEY` 之类的常量重构会绕过文本判定;第七轮起连精确
+//    豁免也取消——豁免只能证明"不饿死菜单",证不了"不在同帧清下层状态",
+//    Cmd+Z handler 也统一装了菜单优先门):每个 capture 注册的 handler(内联
+//    箭头/函数表达式直接取,标识符解析到注册点前最近的同名声明)必须在
+//    **顶层函数体**(不进嵌套函数,`const unused = () => isContextMenuOpen()`
+//    冒充不算)存在 callee 为 isContextMenuOpen / handleOverlayEscape 的真实
+//    CallExpression。
+import { readFileSync, readdirSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+import ts from 'typescript'
+import { describe, expect, it } from 'vitest'
+
+const SRC_ROOT = join(__dirname, '..')
+
+// 登记表:允许出现 capture keydown 注册的文件(src 相对路径,排序)。
+const CAPTURE_KEYDOWN_FILES = [
+  'app/LibraryWorkspace.tsx', // lightbox 预览 Escape(handleOverlayEscape)
+  'canvas/ImageCropOverlay.tsx', // crop Enter/Escape(isContextMenuOpen 让行)
+  'canvas/ImageMaskEditOverlay.tsx', // Cmd/Ctrl+Z 撤销重做(装了菜单优先门)
+  'canvas/RegionEditOverlay.tsx', // 选区 Escape(让行)+ Cmd/Ctrl+Z(菜单优先门)
+  'canvas/SelectionQuickToolbar.tsx', // 快捷条子菜单 Escape(handleOverlayEscape)
+  'canvas/TextFormatToolbar.tsx', // 文字条子菜单 Escape(handleOverlayEscape)
+  'canvas/useMaskPointArmed.ts', // mask 待放点 Escape(isContextMenuOpen 让行)
+]
+
+const YIELD_HELPER_NAMES = new Set(['isContextMenuOpen', 'handleOverlayEscape'])
+
+const collectSourceFiles = (dir: string): string[] =>
+  readdirSync(dir).flatMap((name) => {
+    const full = join(dir, name)
+    if (statSync(full).isDirectory()) return collectSourceFiles(full)
+    if (!/\.(ts|tsx)$/.test(name) || /\.test\.tsx?$/.test(name)) return []
+    return [full]
+  })
+
+type Registration = { handler: ts.Expression; line: number }
+
+const scanFile = (filePath: string) => {
+  const content = readFileSync(filePath, 'utf8')
+  if (!content.includes('addEventListener')) {
+    return { sourceFile: undefined, registrations: [] as Registration[], unanalyzable: [] as number[] }
+  }
+  const sourceFile = ts.createSourceFile(filePath, content, ts.ScriptTarget.Latest, true)
+  const registrations: Registration[] = []
+  const unanalyzable: number[] = []
+  const lineOf = (node: ts.Node) => sourceFile.getLineAndCharacterOfPosition(node.getStart(sourceFile)).line + 1
+
+  const visit = (node: ts.Node) => {
+    if (
+      ts.isCallExpression(node) &&
+      ts.isPropertyAccessExpression(node.expression) &&
+      node.expression.name.text === 'addEventListener'
+    ) {
+      const [eventType, handler, options] = node.arguments
+      if (eventType && ts.isStringLiteralLike(eventType) && eventType.text === 'keydown' && handler && options) {
+        if (options.kind === ts.SyntaxKind.TrueKeyword) {
+          registrations.push({ handler, line: lineOf(node) })
+        } else if (ts.isObjectLiteralExpression(options)) {
+          // 逐属性静态解析:capture: true|false 之外的一切 capture 相关形态
+          // (shorthand { capture }、字符串键之外的 computed 键、展开、非布尔
+          // 字面量值、getter/method)都判 unanalyzable,不许静默溜走。
+          let verdict: 'capture' | 'not-capture' | 'unknown' = 'not-capture'
+          for (const prop of options.properties) {
+            if (ts.isSpreadAssignment(prop)) {
+              verdict = 'unknown'
+              break
+            }
+            if (prop.name && ts.isComputedPropertyName(prop.name)) {
+              verdict = 'unknown'
+              break
+            }
+            const name =
+              prop.name && (ts.isIdentifier(prop.name) || ts.isStringLiteralLike(prop.name))
+                ? prop.name.text
+                : undefined
+            if (name !== 'capture') continue
+            if (ts.isPropertyAssignment(prop) && prop.initializer.kind === ts.SyntaxKind.TrueKeyword) {
+              verdict = 'capture'
+            } else if (ts.isPropertyAssignment(prop) && prop.initializer.kind === ts.SyntaxKind.FalseKeyword) {
+              verdict = 'not-capture'
+            } else {
+              verdict = 'unknown'
+              break
+            }
+          }
+          if (verdict === 'capture') registrations.push({ handler, line: lineOf(node) })
+          else if (verdict === 'unknown') unanalyzable.push(lineOf(node))
+        } else if (options.kind !== ts.SyntaxKind.FalseKeyword) {
+          // options 是标识符/其他表达式 → 静态判不了 capture,同样红灯。
+          unanalyzable.push(lineOf(node))
+        }
+      }
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(sourceFile)
+  return { sourceFile, registrations, unanalyzable }
+}
+
+/** 解析 handler 函数节点:内联函数直接取;标识符找注册点前最近的同名声明。 */
+const resolveHandlerNode = (handler: ts.Expression, sourceFile: ts.SourceFile): ts.Node | undefined => {
+  if (ts.isArrowFunction(handler) || ts.isFunctionExpression(handler)) return handler
+  if (!ts.isIdentifier(handler)) return undefined
+  let nearest: ts.Node | undefined
+  const visit = (node: ts.Node) => {
+    const isMatch =
+      (ts.isVariableDeclaration(node) &&
+        ts.isIdentifier(node.name) &&
+        node.name.text === handler.text &&
+        node.initializer) ||
+      (ts.isFunctionDeclaration(node) && node.name?.text === handler.text)
+    if (isMatch && node.getStart(sourceFile) < handler.getStart(sourceFile)) {
+      if (!nearest || node.getStart(sourceFile) > nearest.getStart(sourceFile)) {
+        nearest = ts.isVariableDeclaration(node) ? node.initializer : node
+      }
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(sourceFile)
+  return nearest
+}
+
+/** 让行校验:handler **顶层函数体**内存在 callee 为让行 helper 的真实
+ *  CallExpression。注释/字符串里的同名文本不算(第五轮封口);嵌套函数不进
+ *  (`const unused = () => isContextMenuOpen()` 冒充不算,第六轮封口)——
+ *  helper 作为顶层调用的实参箭头(handleOverlayEscape(event, () => ...))在
+ *  进入嵌套前就已命中,不受影响。 */
+const callsYieldHelperAtTopLevel = (handlerNode: ts.Node): boolean => {
+  let found = false
+  const visit = (node: ts.Node) => {
+    if (found) return
+    if (node !== handlerNode && ts.isFunctionLike(node)) return
+    if (ts.isCallExpression(node) && ts.isIdentifier(node.expression) && YIELD_HELPER_NAMES.has(node.expression.text)) {
+      found = true
+      return
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(handlerNode)
+  return found
+}
+
+
+describe('menuOverlayStack 合同:capture keydown 逐 handler 让行', () => {
+  const files = collectSourceFiles(SRC_ROOT)
+  const scanned = files.map((file) => ({ rel: file.slice(SRC_ROOT.length + 1), ...scanFile(file) }))
+
+  it('capture 语义必须静态可判(options 用字面量,不许变量/展开兜圈)', () => {
+    const offenders = scanned
+      .filter((entry) => entry.unanalyzable.length)
+      .map((entry) => `${entry.rel}:${entry.unanalyzable.join(',')}`)
+    expect(offenders, 'keydown options 静态判不了 capture,请改为字面量并登记').toEqual([])
+  })
+
+  it('含 capture keydown 注册的文件集合与登记表钉死(新增未登记 → 红灯)', () => {
+    const captureFiles = scanned
+      .filter((entry) => entry.registrations.length)
+      .map((entry) => entry.rel)
+      .sort()
+    expect(captureFiles).toEqual(CAPTURE_KEYDOWN_FILES)
+  })
+
+  it('每个 capture 注册无例外:handler 顶层函数体必须真调用让行 helper', () => {
+    for (const entry of scanned) {
+      for (const registration of entry.registrations) {
+        const sourceFile = entry.sourceFile as ts.SourceFile
+        const handlerNode = resolveHandlerNode(registration.handler, sourceFile)
+        expect(
+          handlerNode,
+          `${entry.rel}:${registration.line} 的 capture handler 无法静态解析(请用同文件命名函数或内联函数)`,
+        ).toBeDefined()
+        if (!handlerNode) continue
+        expect(
+          callsYieldHelperAtTopLevel(handlerNode),
+          `${entry.rel}:${registration.line} 的 capture handler 顶层函数体内没有 isContextMenuOpen/handleOverlayEscape 的真实调用(R6 菜单优先门,无豁免)`,
+        ).toBe(true)
+      }
+    }
+  })
+})
