+// @vitest-environment happy-dom
+// §5 Replace file / Open preview 的可测内核(终审 MINOR-8):
+// - validateReplacementFile:类型族不符 / 字节签名伪装 → 拒绝(与 canonical 导入
+//   同一份 inspectFileSignature 判定);
+// - navigatePreviewWindow:popup 被拦(null 句柄)→ false 且回收 blob URL;正常
+//   句柄 → 断 opener、replace 导航;危险协议(javascript:/data:/file:)→ 关窗
+//   拒绝;导航抛错 → 关窗 + 立即回收(终审第二轮第 4 条)。
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { isSafePreviewUrl, navigatePreviewWindow, validateReplacementFile } from './useFileNodeActions'
+
+const fileOf = (name: string, bytes: string, type: string) => new File([bytes], name, { type })
+
+afterEach(() => {
+  vi.useRealTimers()
+})
+
+describe('validateReplacementFile(§5 替换准入)', () => {
+  it('类型族不符:给 pdf 节点选 .md 文件 → 拒绝', async () => {
+    const verdict = await validateReplacementFile(fileOf('note.md', '# hi', 'text/markdown'), 'pdf')
+    expect(verdict.ok).toBe(false)
+  })
+
+  it('字节伪装:.pdf 扩展名 + 非 PDF 字节 → 签名闸拒绝', async () => {
+    const verdict = await validateReplacementFile(fileOf('fake.pdf', 'hello world', 'application/pdf'), 'pdf')
+    expect(verdict.ok).toBe(false)
+  })
+
+  it('真 PDF 头 → 通过;markdown 文本 → 通过', async () => {
+    expect((await validateReplacementFile(fileOf('ok.pdf', '%PDF-1.7\n%%EOF', 'application/pdf'), 'pdf')).ok).toBe(true)
+    expect((await validateReplacementFile(fileOf('ok.md', '# title', 'text/markdown'), 'markdown')).ok).toBe(true)
+  })
+})
+
+describe('navigatePreviewWindow(popup blocker 语义)', () => {
+  it('句柄为 null(被拦)→ 返回 false 并立即回收 blob URL', () => {
+    const revoke = vi.fn()
+    expect(navigatePreviewWindow(null, 'blob:x', revoke)).toBe(false)
+    expect(revoke).toHaveBeenCalledTimes(1)
+  })
+
+  it('正常句柄 → 断 opener + location.replace 导航,返回 true', () => {
+    const replace = vi.fn()
+    const win = { opener: {}, location: { replace } } as unknown as Window
+    expect(navigatePreviewWindow(win, 'blob:y')).toBe(true)
+    expect(win.opener).toBeNull()
+    expect(replace).toHaveBeenCalledWith('blob:y')
+  })
+
+  it('危险协议(javascript:/data:/file:)→ 关窗、回收、返回 false,绝不导航', () => {
+    for (const url of ['javascript:alert(1)', 'data:text/html,<script>1</script>', 'file:///etc/passwd']) {
+      const replace = vi.fn()
+      const close = vi.fn()
+      const revoke = vi.fn()
+      const win = { opener: {}, location: { replace }, close } as unknown as Window
+      expect(navigatePreviewWindow(win, url, revoke)).toBe(false)
+      expect(replace).not.toHaveBeenCalled()
+      expect(close).toHaveBeenCalledTimes(1)
+      expect(revoke).toHaveBeenCalledTimes(1)
+    }
+  })
+
+  it('成功导航后 blob URL 与预览窗同寿命:窗口开着不回收,关闭后才回收(Greptile P1)', () => {
+    vi.useFakeTimers()
+    const revoke = vi.fn()
+    const win = { opener: {}, location: { replace: vi.fn() }, closed: false } as unknown as Window & { closed: boolean }
+    expect(navigatePreviewWindow(win, 'blob:alive', revoke)).toBe(true)
+    vi.advanceTimersByTime(120_000)
+    expect(revoke).not.toHaveBeenCalled()
+    win.closed = true
+    vi.advanceTimersByTime(10_000)
+    expect(revoke).toHaveBeenCalledTimes(1)
+    vi.advanceTimersByTime(60_000)
+    expect(revoke).toHaveBeenCalledTimes(1)
+  })
+
+  it('location.replace 抛错 → 关窗 + 立即回收 blob URL,返回 false(不留泄漏)', () => {
+    const close = vi.fn()
+    const revoke = vi.fn()
+    const win = {
+      opener: {},
+      location: {
+        replace: () => {
+          throw new Error('nav refused')
+        },
+      },
+      close,
+    } as unknown as Window
+    expect(navigatePreviewWindow(win, 'blob:z', revoke)).toBe(false)
+    expect(close).toHaveBeenCalledTimes(1)
+    expect(revoke).toHaveBeenCalledTimes(1)
+  })
+})
+
+describe('isSafePreviewUrl(导航协议白名单)', () => {
+  it('http(s)/blob/相对路径放行;javascript/data/file/畸形拒绝', () => {
+    expect(isSafePreviewUrl('https://example.com/a.pdf')).toBe(true)
+    expect(isSafePreviewUrl('http://example.com/a.pdf')).toBe(true)
+    expect(isSafePreviewUrl('blob:http://localhost/uuid')).toBe(true)
+    expect(isSafePreviewUrl('/assets/a.pdf')).toBe(true)
+    expect(isSafePreviewUrl('javascript:alert(1)')).toBe(false)
+    expect(isSafePreviewUrl('data:text/html,x')).toBe(false)
+    expect(isSafePreviewUrl('file:///etc/passwd')).toBe(false)
+    expect(isSafePreviewUrl('JaVaScRiPt:alert(1)')).toBe(false)
+  })
+})
