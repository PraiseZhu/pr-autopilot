+  })
+
+  it('名录命中 + Slack 查无该邮箱(users_not_found)→ tier real-name,reason slack-miss(...)', async () => {
+    process.env.ORG_ROSTER_TOKEN = 'ghp_test'
+    process.env.SLACK_BOT_TOKEN = 'xoxb-test'
+    spawnSync.mockReturnValue({ status: 0, stdout: rosterStdout(ROSTER_MD) })
