+    expect(findValueTernaryEmptyStringViolations(yamlText)).toHaveLength(1)
+  })
+
+  it('双引号变体 `&& "" ||` 同样命中', () => {
+    const yamlText = 'X: ${{ a == "b" && "" || "c" }}'
+    expect(findValueTernaryEmptyStringViolations(yamlText)).toHaveLength(1)
+  })
+
+  it('非空串的取值三元式(正常用法)不命中', () => {
+    const yamlText = "X: ${{ a == 'b' && 'yes' || 'no' }}"
+    expect(findValueTernaryEmptyStringViolations(yamlText)).toEqual([])
+  })
+})
+
+describe('findValueTernaryEmptyStringViolations — 扫全 .github/workflows/ 目录', () => {
+  const files = readdirSync(WORKFLOWS_DIR).filter((f) => /\.ya?ml$/.test(f))
+
+  it('目录里确实有多个 workflow 文件可扫(防止目录路径写错导致测试空转通过)', () => {
+    expect(files.length).toBeGreaterThan(1)
+  })
+
+  it.each(files)('%s 不含取值三元式+空串形态', (file) => {
+    const yamlText = readFileSync(join(WORKFLOWS_DIR, file), 'utf8')
+    expect(findValueTernaryEmptyStringViolations(yamlText)).toEqual([])
+  })
+})
