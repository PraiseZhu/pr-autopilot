+
+  it('markdown 为空 / login 为空 → null,不抛错', () => {
+    expect(findInRoster('', 'testlogin')).toBeNull()
+    expect(findInRoster(ROSTER_MD, '')).toBeNull()
+  })
+})
+
+describe('resolveAuthorMention — 三档 + 四类失败原因(全程不抛错,不阻断致谢发出)', () => {
