+// from-github-event.test.mjs — 事件路径解析契约 + 要点校验 + Actions 注解判定
+//
+// 背景(#419):真实合并事件下 MERGE_THANKS_EVENT_PATH 优先判定用了
+// `event_name == 'pull_request' && '' || '/tmp/…'` 这种三元式,Actions 的 &&/|| 是取值
+// 运算符,空字符串 falsy,两条分支求出同一个值——致谢链路静默失败了两小时,job 全程绿灯。
+// 本文件把「MERGE_THANKS_EVENT_PATH 优先、否则回落 GITHUB_EVENT_PATH」这条分支逻辑钉死,
+// 不让同一类 bug 下次再悄悄溜过去。
+//
+// 全离线:不联网、不需要任何 token/secret——事件路径缺失或指向合成 fixture 时脚本在网络
+// 调用之前就已经退出。
+import { execFileSync } from 'node:child_process'
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { dirname, join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+
+import {
+  describeChannelFailure,
+  describeSlackNotConfigured,
+  FORK_SLACK_NOT_CONFIGURED_REASON,
+  formatAnnotation,
+  isCrossRepositoryPR,
+  resolveEventPath,
+  resolveEventProvenance,
+  validateDetails,
+} from './from-github-event.mjs'
+
+const HERE = dirname(fileURLToPath(import.meta.url))
+const SCRIPT_PATH = join(HERE, 'from-github-event.mjs')
+
+describe('resolveEventPath — MERGE_THANKS_EVENT_PATH 优先,否则回落 GITHUB_EVENT_PATH', () => {
+  it('两者都设置时,MERGE_THANKS_EVENT_PATH 优先', () => {
+    expect(resolveEventPath({ MERGE_THANKS_EVENT_PATH: '/tmp/a.json', GITHUB_EVENT_PATH: '/tmp/b.json' })).toBe(
+      '/tmp/a.json',
+    )
+  })
+
+  it('MERGE_THANKS_EVENT_PATH 未设置(键不存在)时回落 GITHUB_EVENT_PATH', () => {
+    expect(resolveEventPath({ GITHUB_EVENT_PATH: '/tmp/b.json' })).toBe('/tmp/b.json')
+  })
+
+  it('MERGE_THANKS_EVENT_PATH 为空字符串时仍回落 GITHUB_EVENT_PATH(#419 的 bug 类:空串是 falsy)', () => {
+    expect(resolveEventPath({ MERGE_THANKS_EVENT_PATH: '', GITHUB_EVENT_PATH: '/tmp/b.json' })).toBe('/tmp/b.json')
+  })
+
+  it('两者都没有时返回 null,不抛异常', () => {
+    expect(() => resolveEventPath({})).not.toThrow()
+    expect(resolveEventPath({})).toBeNull()
+  })
+})
+
+describe('resolveEventPath 接入 main() 的真实行为(子进程实跑,不 mock)', () => {
+  let dir
+
+  beforeEach(() => {
+    dir = mkdtempSync(join(tmpdir(), 'merge-thanks-eventpath-'))
+  })
+
+  afterEach(() => {
+    rmSync(dir, { recursive: true, force: true })
+  })
+
+  const runScript = (env) =>
+    execFileSync(process.execPath, [SCRIPT_PATH], {
+      encoding: 'utf8',
+      env: { PATH: process.env.PATH, ...env },
