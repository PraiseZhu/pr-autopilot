+  })
+
+  it('名录命中 + SLACK_BOT_TOKEN 未配置 → tier real-name,reason slack-miss(no-slack-token),不抛错', async () => {
+    process.env.ORG_ROSTER_TOKEN = 'ghp_test'
+    spawnSync.mockReturnValue({ status: 0, stdout: rosterStdout(ROSTER_MD) })
+    const r = await resolveAuthorMention('testlogin')
