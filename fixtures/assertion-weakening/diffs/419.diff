+// 目的,其中任一目的的完备性要求都必须单独检查——不能假设"够用于定位"就"够用于判边界"。
+const STEP_ITEM_RE = /^(\s*)-(?:\s|$)/
+
+/**
+ * 按步骤名切出该步骤在 YAML 文本里的行范围(不含下一个同级或更外层步骤),并算出该步骤
+ * mapping 层键(`name:`/`if:`/`run:`/`env:` 等,与 `- name:` 的 `name` 同列)的缩进列数——
+ * `- ` 占 2 列,键就在 dash 缩进 +2 列起。调用方靠这个列数精确定位"步骤自己的 if:"而不是
+ * 被 `run: |` 块内容里恰好同名的文本行(CX-1 第三层)骗过:block scalar 的内容按 YAML
+ * 语法规则必须比 `run:` 键更深缩进,不可能落在这一列,所以按列精确匹配天然排除它。
+ *
+ * 起点用 STEP_HEADER_RE(按名字精确定位,不变);边界扫描用 STEP_ITEM_RE(接受本文件头
+ * "步骤边界判定"一节列出的三种已支持列表项形态,不要求带 name;不是穷尽 YAML 语义
+ * 判定,行级 best-effort)——两者服务不同目的,不能共用同一个"只认 name"的正则。
+ */
+function extractStep(lines, stepName) {
+  const startIdx = lines.findIndex((l) => {
+    const m = l.match(STEP_HEADER_RE)
+    return m && m[2].trim().replace(/^['"]|['"]$/g, '') === stepName
+  })
+  if (startIdx === -1) return null
+  const dashIndent = lines[startIdx].match(STEP_HEADER_RE)[1].length
+  let endIdx = lines.length
+  for (let i = startIdx + 1; i < lines.length; i++) {
+    const m = lines[i].match(STEP_ITEM_RE)
+    if (m && m[1].length <= dashIndent) {
+      endIdx = i
+      break
+    }
+  }
+  return { lines: lines.slice(startIdx, endIdx), keyIndent: dashIndent + 2 }
+}
+
+/** 过滤掉注释行(trim 后以 # 开头)——避免把"解释为什么不这么写"的说明段误判成真实配置。 */
+const stripComments = (lines) => lines.filter((l) => !l.trim().startsWith('#'))
+
+/**
+ * 检测「取值三元式 + 空字符串」形态:`${{ ... && '' || ... }}` / `&& "" || `。
+ * Actions 的 &&/|| 是取值运算符(同 JS),空串 falsy——`true && ''` 求出 `''` 又落到
+ * `|| B`,两条分支求出同一个值(#419 真实缺陷)。只在 `${{ }}` 表达式内部扫描,天然
+ * 跳过纯文字注释里提及该写法的说明段(注释不是 `${{ }}` 表达式,不会被本正则捕获)。
+ */
+export function findValueTernaryEmptyStringViolations(yamlText) {
+  const violations = []
+  const exprRe = /\$\{\{([\s\S]*?)\}\}/g
+  let m
+  while ((m = exprRe.exec(yamlText))) {
+    const expr = m[1]
+    if (/&&\s*(['"])\1\s*\|\|/.test(expr)) {
+      violations.push(`value-ternary-empty-string: \${{${expr}}}`)
+    }
+  }
+  return violations
+}
+
+const DISPATCH_GUARD = "github.event_name != 'pull_request'"
+const EVENT_PATH_WRITE_RE = /MERGE_THANKS_EVENT_PATH=\/tmp\/dispatch-event\.json"\s*>>\s*"\$\{?GITHUB_ENV\}?"/
+
+/**
+ * 廉价还原 YAML 双引号标量里的 `\xHH` / `\uHHHH` 转义(单引号标量不支持转义,不需处理)。
+ * 只处理这两种最常被用来拆散字面子串的转义形式——不是完整 YAML 解析器,只为让
+ * `MERGE_THANKS_EVENT_PATH` 键被编码成转义序列时,原始文本 `includes()` 依然看得见。
+ */
+const unescapeYamlDoubleQuoted = (line) =>
+  line
+    .replace(/\\x([0-9a-fA-F]{2})/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
+    .replace(/\\u([0-9a-fA-F]{4})/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
+
+/**
+ * merge-thanks.yml 专属契约:
+ *   1. 全文(去注释、去 YAML 双引号转义)含 MERGE_THANKS_EVENT_PATH 的行必须有且仅有一条,
+ *      且必须是写入 GITHUB_ENV 的那一行(`event-path-not-single-github-env-write`)——
+ *      不分 step/job/workflow 层级,任何位置多声明一处都算违规,一条规则覆盖三个注入位
+ *      (CA-8);
+ *   2. 那唯一一行还必须落在受 guard 的构造步骤本身内部,否则报
+ *      `event-path-moved-out-of-dispatch-step`——哪怕全文仍只有它一行、仍是写入形态,
+ *      搬到构造步骤之外就等于绕开了 guard(CA-9/SC13);
+ *   3. 构造步骤的 if: 必须是唯一一条且精确等于 DISPATCH_GUARD——它是让 Post 步骤回落到
+ *      真实 GITHUB_EVENT_PATH 的机制本身,删掉、反转或变成结构含糊(同列出现多条)都会
+ *      让原 bug 原地复活或判定不可信(CX-1);
+ *   4. 全文不得出现取值三元式+空串形态。
+ */
+export function checkMergeThanksWorkflowContract(yamlText) {
+  const violations = []
+  const lines = yamlText.split('\n')
+  const nonComment = stripComments(lines)
+
+  const dispatchStep = extractStep(lines, 'Build event payload for dry-run')
+  if (!dispatchStep) {
+    violations.push('missing-step: 找不到 "Build event payload for dry-run" 步骤')
+  } else {
+    // 断言"唯一",不用 first-match:同列出现两个 if:(重复键)时,find() 只看第一条,
+    // 值恰好没变就会放过——但那已经是结构含糊,不该被判定"guard 完好"。命中数 ≠ 1
+    // 或值 ≠ DISPATCH_GUARD,都归同一个 dispatch-step-guard-changed。
+    const ifPrefix = `${' '.repeat(dispatchStep.keyIndent)}if:`
+    const ifLines = stripComments(dispatchStep.lines).filter((l) => l.startsWith(ifPrefix))
+    const guard = ifLines.length === 1 ? ifLines[0].slice(ifPrefix.length).trim() : null
+    if (ifLines.length !== 1 || guard !== DISPATCH_GUARD) {
+      violations.push(
+        `dispatch-step-guard-changed: "Build event payload for dry-run" 步骤的 if: 必须是唯一一条且精确等于 ` +
+          `${DISPATCH_GUARD},实际命中 ${ifLines.length} 条,值为 ${JSON.stringify(guard)}`,
+      )
+    }
+  }
+
+  if (!extractStep(lines, 'Post merge thanks')) {
+    violations.push('missing-step: 找不到 "Post merge thanks" 步骤')
+  }
+
+  // CA-9/SC13:「全文恰好一行且该行是写入」曾经够用,是因为上一版检查天然带着「必须在
+  // 受 guard 的构造步骤范围内」这层位置约束(旧版在 dispatchStep 的行范围内单独找写入)。
+  // 收敛成单条全文规则时这层约束被丢了——把写入行原样搬到 Build 之前一个没有 if: 的新
+  // 步骤,全文仍只有一行、仍是写入形态,旧规则判定通过,但真实 pull_request 触发时这个
+  // 新步骤会无条件执行、把 GITHUB_ENV 设成一个从未被创建的文件路径,#390 原样复活。
+  // 因此拆成两段判断、给两个不同的违规 id——「不止一条/不是写入」与「搬出了构造步骤」
+  // 是两类不同的缺陷,共用一个 id 会让将来触发时读不出到底是哪一种。
+  const eventPathLines = nonComment.filter((l) => unescapeYamlDoubleQuoted(l).includes('MERGE_THANKS_EVENT_PATH'))
+  const isSingleLegitWrite = eventPathLines.length === 1 && EVENT_PATH_WRITE_RE.test(eventPathLines[0])
+  if (!isSingleLegitWrite) {
+    violations.push(
+      `event-path-not-single-github-env-write: 含 MERGE_THANKS_EVENT_PATH 的行必须有且仅有一条 GITHUB_ENV ` +
+        `写入行,实际命中 ${eventPathLines.length} 行`,
+    )
+  } else if (!dispatchStep || !stripComments(dispatchStep.lines).includes(eventPathLines[0])) {
+    violations.push(
+      `event-path-moved-out-of-dispatch-step: 唯一的 GITHUB_ENV 写入行没有落在受 guard 的 ` +
+        `"Build event payload for dry-run" 步骤内部——像是被搬到了别的步骤;真实 pull_request ` +
+        `触发时该步骤会无条件执行、把变量设成一个从未被创建的文件路径(#390 复活)`,
+    )
+  }
+
+  violations.push(...findValueTernaryEmptyStringViolations(yamlText))
+
+  return violations
+}
