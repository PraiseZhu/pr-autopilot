+      mention: '<@U123>',
+      tier: 'slack-mention',
+      name: '测试同学',
+      email: 'test@xd.com',
+      slackId: 'U123',
+    })
+  })
+
+  it('名录命中 + Slack 缺 users:read.email scope → tier real-name,reason slack-noscope', async () => {
+    process.env.ORG_ROSTER_TOKEN = 'ghp_test'
+    process.env.SLACK_BOT_TOKEN = 'xoxb-test'
+    spawnSync.mockReturnValue({ status: 0, stdout: rosterStdout(ROSTER_MD) })
+    globalThis.fetch = async () => ({ json: async () => ({ ok: false, error: 'missing_scope' }) })
