+  })
+
+  it('名录命中 + Slack 查到邮箱 → tier slack-mention,带真名与 Slack ID', async () => {
+    process.env.ORG_ROSTER_TOKEN = 'ghp_test'
+    process.env.SLACK_BOT_TOKEN = 'xoxb-test'
