+// remoteDebug 传输契约(v3)。
+//
+// 单独成模块的两个理由:① 契约是**双方**共用的 —— 网页版由 remoteDebugReporter 消费,
+// Cindy 插件侧的 relay 实现要 import 同一份类型,从大实现文件里导出会让插件反向依赖整个
+// reporter;② remoteDebugReporter.ts 已接近 structure-guard 的 900 行线,契约与文档放这里
+// 让两边都读得到"为什么"而不挤占实现文件。
+//
+// 完整背景:配套 PR #541 的 `docs/plans/2026-08-06-cindyplugin-silent-debug-log.md`；本分支按
+// size-gate 拆分只含插件侧。
+//
+// 跨 PR 指针(R2 fix:明确标注,避免读起来像本仓已存在的东西):上面提到的"Cindy 插件侧的
+// relay 实现"在后续接线 PR(`feat/cindyplugin-debug-relay-wiring`,即 B 支)完成,本 PR 内
+// 无该实现的任何代码、也无消费者。
+
+import type { RemoteDebugPayload } from './remoteDebugReporter'
+
+/**
+ * 传输结果。状态映射**冻结表**(计划 §1),实现方不得自行加解释:
+ *   - HTTP 2xx    → resolve `{ ok: true,  status }`
+ *   - HTTP 非 2xx → resolve `{ ok: false, status }`(可重试失败:退避 / 入 outbox)
+ *   - 传输层失败  → **reject**(等价网络错误:桥超时、宿主 `{ok:false}`、回包畸形)
+ *
+ * 红线:通道层的"消息已送达"**不等于** HTTP 成功。把送达当 2xx 会让 reporter 以为
+ * 批次已落库而删掉 outbox 记录 —— 那是静默丢日志,正是本功能要消灭的东西。
+ *
+ * R3 fix(F-A1-02):消费方(remoteDebugReporter.sendPayload)对 `status` 存在但不是 [200,300)
+ * 区间内整数的回包 fail-closed —— `status` 一旦存在(`!== undefined`)就必须是该区间内的整数
+ * 才算成功,字符串(如 `'500'`)、`NaN`、`Infinity`、非整数(如 `250.5`)、区间外数值都一律按
+ * 失败处理,无论 `ok` 为何。`{ok:true}` 无 `status` 仍视为成功(向后兼容旧形态)。实现方应确保
+ * `ok` 与 `status` 一致;写反或写畸形都不会被静默接受,而是被当成失败重试。
+ * （R2 版判据只拦"status 是有限数但不在 2xx 区间"，把畸形值误判为"不存在"而放过，被审查
+ * 席实测矩阵证伪后收窄为本判据 —— 这是同一处 fail-closed 判据的第二版。）
+ */
+export type RemoteDebugTransportResult = { ok: boolean; status?: number }
+
+export type RemoteDebugTransport = (payload: RemoteDebugPayload) => Promise<RemoteDebugTransportResult>
+
+/**
+ * `installRemoteDebugReporter` 的可选装配参数。
+ *
+ * **四项默认值都等于本模块的历史行为** —— 网页版(src/App.tsx)不传任何参数,行为逐字节
+ * 不变(回归锁见 remoteDebugReporter.test.ts 的 "v3" 段)。这些参数只为插件形态存在。
+ */
+export type InstallRemoteDebugReporterOptions = {
+  /**
+   * 替换出网方式。插件面板没有可用的直连出口(相对路径打不到 BFF,且宿主对 Origin
+   * 双向封死),必须经电子脑 relay 出网。传入即接管出网动作,其余(攒批 / 退避 /
+   * outbox / drop 计数)全部复用 reporter 既有实现。不传 → 走原来的 fetch。
+   */
+  transport?: RemoteDebugTransport
+  /**
+   * 先落 outbox 再发送(2xx 才删)。默认 false = 历史顺序"先清内存 queue 再 await 发送",
+   * 那个顺序有个丢窗口:发送悬挂期间面板被关掉,这一批既不在 queue 也不在 outbox。
+   * 面板随时可被用户收起,故插件侧开启。代价是"服务端已收 2xx 但回执丢失"时会合法
+   * 重投一次(at-least-once,上界受重试上限约束),这是刻意接受的取舍。
+   */
+  durableFirst?: boolean
+  /**
+   * 抑制 IDB 降级的**用户可见** toast(本地 Debug Log 仍照记,可观测性不降级)。
+   * 插件是"绝对零 UI"硬约束:面板挂着 ToastViewport,任何 toast 都会真弹出来。
+   */
+  silent?: boolean
+  /**
+   * 在 env 门关闭的构建里(`VITE_MIVO_REMOTE_DEBUG='0'`)显式开启上报。
+   *
+   * 插件形态必须这么做:`reportRemoteDebugEntry` 只受 `remoteDebugEnabled()` 门控,
+   * **不受 `installed` 门控** —— transport 装上之前产生的 warn/error 会走默认 fetch 去打
+   * 相对路径,在 cindy-ghost:// 下必然失败,还会带着错误的出网方式进 outbox 反复重试。
+   * 只靠"把 install 写在入口第一行"挡不住:ESM 的 import 求值早于入口任何语句,任一被
+   * import 的模块在求值期 warn 一次就漏了。所以构建期先 fail-closed,再由本参数在
+   * transport 就位的**同一次调用**里开启。
+   */
+  forceEnable?: boolean
+}
