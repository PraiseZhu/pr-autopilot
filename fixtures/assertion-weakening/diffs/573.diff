+// remoteDebugReporter 插件形态装配参数测试(v3 段,从 remoteDebugReporter.test.ts 拆出,① structure-guard 拆分)。
+//
+// 拆分理由:remoteDebugReporter.test.ts 1235 行越 structure-guard 的 900 绝对线(R1 三席共识
+// blocker)。本文件承载与插件装配参数(transport / durableFirst / silent / forceEnable)及
+// fail-safe 客户端信息(P1-2)相关的用例;网页版回归锁与核心 outbox/drain 用例留在主文件。
+//
+// 内容为原样搬移(拆分等价),断言零改动;主文件与本文各自独立跑,共享的 IndexedDB 底层
+// (按 DB_NAME 持久化)由各 describe 的 afterEach 清理,跨文件互不污染。
+
+import 'fake-indexeddb/auto'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { useDebugLogStore } from './debugLogStore'
+import { useToastStore } from './toastStore'
+import {
+  __resetRemoteDebugStateForTest,
+  __setRemoteDebugTestHooks,
+  createRemoteDebugClientInfo,
+  drainRemoteDebugOutbox,
+  flushRemoteDebugEntries,
+  getRemoteDebugDropCount,
+  getRemoteDebugOutboxCount,
+  installRemoteDebugReporter,
+  reportRemoteDebugEntry,
+  type RemoteDebugClientInfo,
+  type RemoteDebugTransport,
+} from './remoteDebugReporter'
+
+const createMemoryStorage = () => {
+  const values = new Map<string, string>()
+
+  return {
+    get length() {
+      return values.size
+    },
+    clear: () => values.clear(),
+    getItem: (key: string) => values.get(key) ?? null,
+    key: (index: number) => [...values.keys()][index] ?? null,
+    removeItem: (key: string) => values.delete(key),
+    setItem: (key: string, value: string) => {
+      values.set(key, value)
+    },
+  } satisfies Storage
+}
+const fixedClientInfo = (): RemoteDebugClientInfo => ({
+  clientId: 'client-fixed',
+  sessionId: 'session-fixed',
+  appVersion: '0.0.0-test',
+  pagePath: '/canvas',
+  userAgent: 'TestBrowser',
+  language: 'en',
+  timezone: 'UTC',
+  screen: { width: 1440, height: 900, pixelRatio: 2 },
+})
+
+/** 让 drain 的 Promise 续链与 fake-IndexedDB 事件任务落地;单飞锁挡住时给后台 drain 一个释放机会。 */
+const flushMicrotasks = async (): Promise<void> => {
+  await Promise.resolve()
+  await Promise.resolve()
+  await new Promise<void>((resolve) => globalThis.setTimeout(resolve, 0))
+}
+describe('FX-7 P1-2: fail-safe client info (no silent batch loss on localStorage failure)', () => {
+  beforeEach(async () => {
+    vi.clearAllMocks()
+    await __resetRemoteDebugStateForTest()
+  })
+  afterEach(async () => {
+    vi.unstubAllGlobals()
+    await __resetRemoteDebugStateForTest()
+  })
+
+  it('createRemoteDebugClientInfo does NOT throw when storage.getItem throws (falls back to a fresh client id)', () => {
+    const throwingStorage = {
+      ...createMemoryStorage(),
+      getItem: () => {
+        throw new Error('localStorage blocked (sandboxed iframe)')
+      },
+      setItem: () => {
+        throw new Error('quota exceeded')
+      },
+    }
+    // Must not throw — the read failure falls back to the injected createClientId.
+    const info = createRemoteDebugClientInfo({
+      storage: throwingStorage,
+      createId: () => 'client-fallback',
+      sessionId: 's1',
+      locationPath: '/x',
+      userAgent: 'ua',
+      language: 'en',
+      timezone: 'UTC',
+      screen: { width: 1, height: 1, pixelRatio: 1 },
+    })
+    expect(info.clientId).toBe('client-fallback') // getItem threw → generated
+    expect(info.sessionId).toBe('s1')
+  })
+
+  it('a failing browser client-info read does not silently lose the batch (emergency fallback → outbox persists)', async () => {
+    // No buildClientInfo injected → createBrowserClientInfo uses readBrowserClientInfo →
+    // window.localStorage throws (node test env has no window) → emergencyClientInfo.
+    // The batch must still land in the durable outbox, NOT be silently dropped.
+    const fetchMock = vi.fn(async () => {
+      throw new Error('network down')
+    })
+    const clock = 1000
+    __setRemoteDebugTestHooks({
+      fetchImpl: fetchMock as unknown as typeof fetch,
+      now: () => clock,
+      random: () => 0.5,
+      enabled: true, // no buildClientInfo → exercises the fail-safe default path
+    })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'S', message: 'm', timestamp: 1000 })
+    await flushRemoteDebugEntries()
+    // Batch persisted to the durable outbox despite the client-info read failing.
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+  })
+})
+// ── v3:插件形态装配参数(transport / durableFirst / silent / forceEnable)+ 网页版回归锁 ──
+//
+// 完整设计:配套 PR #541 的 `docs/plans/2026-08-06-cindyplugin-silent-debug-log.md`(§1 状态映射表 /
+// §2-A 零 UI / §2-C 持久性三态 / §4 SC-1、SC-2、SC-3、SC-6);本分支按 size-gate 拆分只含插件侧。
+//
+// 跨 PR 指针(R2 fix:明确标注,避免读起来像本仓已存在的东西):插件侧 relay 的具体接线在
+// 后续接线 PR(`feat/cindyplugin-debug-relay-wiring`,即 B 支)完成;本文件覆盖的是共享层
+// 契约本身(transport 注入点的行为),不是接线实现,本仓内无该实现的消费者。
+//
+// 本段最重要的两条是**方向相反的顺序断言**:默认模式必须"先发送、后落库",durableFirst
+// 必须"先落库、后发送"。只断言最终 outbox 深度是不够的 —— 两种模式的终态可以完全一样,
+// 真正决定"面板中途被关会不会丢这一批"的是这个先后顺序。
+describe('v3 remoteDebugReporter 装配参数 + 网页版回归锁', () => {
+  /**
+   * 让 IDB 真的坏掉。
+   *
+   * 顺序很关键:`__resetRemoteDebugStateForTest()` 末尾会调 clearOutboxStore(),那一步
+   * 会重新 openDb 并把 dbPromise 缓存住。所以必须"先 stub、后 reset"—— 反过来 stub 会被
+   * 已缓存的真实连接完全绕开,IDB 根本不会降级,于是所有"零 toast"断言都变成假通过。
+   * reset 还会清掉 test hooks,故调用方在本函数之后再设 hooks。
+   */
+  const breakIndexedDb = async (): Promise<void> => {
+    vi.stubGlobal('indexedDB', { open: () => { throw new Error('idb blocked') } })
+    await __resetRemoteDebugStateForTest()
+    useToastStore.getState().clearToasts()
+    useDebugLogStore.getState().clear()
+  }
+
+  /** 降级是否真的发生过(warnIdbDegradation 一定写一条 Remote Debug 的 in-memory fallback 本地日志)。 */
+  const degradationLogged = (): boolean =>
+    useDebugLogStore.getState().entries.some((e) => e.source === 'Remote Debug' && e.message.includes('in-memory fallback'))
+
+  beforeEach(async () => {
+    vi.clearAllMocks()
+    await __resetRemoteDebugStateForTest()
+    useToastStore.getState().clearToasts()
+    useDebugLogStore.getState().clear()
+  })
+  afterEach(async () => {
+    vi.unstubAllGlobals()
+    await __resetRemoteDebugStateForTest()
+    useToastStore.getState().clearToasts()
+  })
+
+  // ── SC-6 回归锁:不传新参数 → 行为逐字节不变 ──
+
+  it('回归锁:不传参数时仍走全局 fetch 打默认端点(POST + application/json)', async () => {
+    const calls: Array<{ url: unknown; init: { method?: string; headers?: Record<string, string> } }> = []
+    const fetchMock = vi.fn(async (url: unknown, init: { method?: string; headers?: Record<string, string> }) => {
+      calls.push({ url, init })
+      return new Response('{}', { status: 200 })
+    })
+    __setRemoteDebugTestHooks({ fetchImpl: fetchMock as unknown as typeof fetch, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter() // 网页版调用形态:零参数
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    expect(calls[0]!.url).toBe('/api/mivo/debug-logs')
+    expect(calls[0]!.init.method).toBe('POST')
+    expect(calls[0]!.init.headers).toMatchObject({ 'Content-Type': 'application/json' })
+  })
+
+  it('回归锁:默认模式下发送发生在任何 outbox 写入之前(先发后落 — 历史顺序)', async () => {
+    let outboxDepthAtSend = -1
+    const fetchMock = vi.fn(async () => {
+      outboxDepthAtSend = await getRemoteDebugOutboxCount()
+      return new Response('{}', { status: 200 })
+    })
+    __setRemoteDebugTestHooks({ fetchImpl: fetchMock as unknown as typeof fetch, buildClientInfo: fixedClientInfo, enabled: true })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(fetchMock).toHaveBeenCalledTimes(1)
+    expect(outboxDepthAtSend).toBe(0) // 发送时 outbox 还是空的 = 没有先落库
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+  })
+
+  it('回归锁:默认(silent 未传)时 IDB 降级仍弹用户可见 toast', async () => {
+    await breakIndexedDb()
+    const fetchMock = vi.fn(async () => { throw new Error('net down') })
+    __setRemoteDebugTestHooks({ fetchImpl: fetchMock as unknown as typeof fetch, buildClientInfo: fixedClientInfo, enabled: true })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    // 前置:降级确实发生了(否则下面的 toast 断言会变成同义反复)。
+    expect(degradationLogged()).toBe(true)
+    expect(useToastStore.getState().entries.length).toBeGreaterThan(0)
+  })
+
+  // ── SC-1:transport 注入 + 状态映射 ──
+
+  it('transport 注入后接管出网,全局 fetch 零调用', async () => {
+    const fetchMock = vi.fn(async () => new Response('{}', { status: 200 }))
+    const transport = vi.fn(async () => ({ ok: true, status: 200 }))
+    __setRemoteDebugTestHooks({ fetchImpl: fetchMock as unknown as typeof fetch, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(transport).toHaveBeenCalledTimes(1)
+    expect(fetchMock).not.toHaveBeenCalled()
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+  })
+
+  it('transport resolve {ok:false,status:403} → 当可重试失败处理(入 outbox,drop 仍为 0)', async () => {
+    const transport = vi.fn(async () => ({ ok: false, status: 403 }))
+    __setRemoteDebugTestHooks({ now: () => 1000, random: () => 0.5, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+  })
+
+  it('transport reject(桥超时 / 宿主传输失败)→ 同样入 outbox', async () => {
+    const transport = vi.fn(async () => { throw new Error('bridge timeout') })
+    __setRemoteDebugTestHooks({ now: () => 1000, random: () => 0.5, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+  })
+
+  // ── SC-2:durableFirst 顺序反转 ──
+
+  it('durableFirst:outbox 写入发生在发送之前(先落后发 — 堵住"发送悬挂期面板被关"的丢失窗口)', async () => {
+    let outboxDepthAtSend = -1
+    const transport = vi.fn(async () => {
+      outboxDepthAtSend = await getRemoteDebugOutboxCount()
+      return { ok: true, status: 200 }
+    })
+    __setRemoteDebugTestHooks({ now: () => 1000, random: () => 0.5, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport, durableFirst: true })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(transport).toHaveBeenCalledTimes(1)
+    expect(outboxDepthAtSend).toBe(1) // 发送时这一批已在 outbox 里 = 先落库
+    expect(await getRemoteDebugOutboxCount()).toBe(0) // 2xx ack 后删除
+  })
+
+  it('durableFirst + 发送失败 → 批次留在 outbox 等退避重投(不丢)', async () => {
+    const transport = vi.fn(async () => { throw new Error('bridge timeout') })
+    __setRemoteDebugTestHooks({ now: () => 1000, random: () => 0.5, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport, durableFirst: true })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    expect(await getRemoteDebugOutboxCount()).toBe(1)
+    expect(await getRemoteDebugDropCount()).toBe(0)
+  })
+
+  it('durableFirst:"服务端已收 2xx 但回执丢失" → 合法重投一次,不产生第二条 outbox 记录', async () => {
+    // SC-9 反例:第一次 transport 实际已被服务端接收,但回执在桥上丢了(reject)。
+    // 语义是 at-least-once —— 重投是**合法**的,不许被判成失败放大;上界仍受重试上限约束。
+    let clock = 1000
+    const received: number[] = []
+    let dropReceipt = true
+    const transport = vi.fn(async () => {
+      received.push(clock)
+      if (dropReceipt) {
+        dropReceipt = false
+        throw new Error('receipt lost after server accepted')
+      }
+      return { ok: true, status: 200 }
+    })
+    __setRemoteDebugTestHooks({ now: () => clock, random: () => 0.5, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport, durableFirst: true })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+    expect(await getRemoteDebugOutboxCount()).toBe(1) // 回执丢了 → 留在 outbox
+
+    // `draining` 是模块级单飞守卫(见 remoteDebugReporter.ts):installRemoteDebugReporter
+    // 会 void 一次后台 drain,与它重叠的显式调用**静默返回 processed:0**。这类空转不能
+    // 消耗「真实 drain 尝试」预算,否则高负载下会假红;每次真实处理才计入 50 次上界,
+    // 因而 drain 真坏掉(持续处理但无法完成)仍会耗尽预算并红。
+    let attempts = 0
+    while (received.length < 2 && attempts < 50) {
+      clock += 60_000 // 越过退避窗口
+      const result = await drainRemoteDebugOutbox()
+      if (result.processed === 0) {
+        await flushMicrotasks()
+        continue
+      }
+      attempts += 1
+    }
+
+    expect(received).toHaveLength(2) // 服务端共收到 2 次(同一批)= at-least-once
+    expect(await getRemoteDebugOutboxCount()).toBe(0)
+    expect(await getRemoteDebugDropCount()).toBe(0) // 合法重投,不是失败
+  })
+
+  // ── SC-3:silent 零 UI ──
+
+  it('silent:IDB 降级不弹 toast,但本地 Debug Log 仍留痕(静默的是提示,不是可观测性)', async () => {
+    await breakIndexedDb()
+    const transport = vi.fn(async () => { throw new Error('relay failed') })
+    __setRemoteDebugTestHooks({ now: () => 1000, random: () => 0.5, buildClientInfo: fixedClientInfo, enabled: true })
+    installRemoteDebugReporter({ transport, durableFirst: true, silent: true })
+
+    reportRemoteDebugEntry({ level: 'error', source: 'Canvas', message: 'boom', timestamp: 1 })
+    await flushRemoteDebugEntries()
+
+    // 前置:降级确实发生了。缺了这一条,"零 toast" 会在 IDB 根本没坏的情况下
+    // 空跑通过 —— 那是假通过,不是零 UI 的证据。
+    expect(degradationLogged()).toBe(true)
