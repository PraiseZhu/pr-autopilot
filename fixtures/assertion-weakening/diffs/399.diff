@@ -350,6 +350,22 @@ describe('card transport — fail-visible 且不悬挂', () => {
     const { spy } = attachPanelBridge(brain)
     expect(spy.find('card 版本超体积未发送')[0]?.level).toBe('error')
   })
+
+  it('七轮可选修复:超限判据按真实 UTF-8 字节数,不是 UTF-16 code units——中文重复串在 .length 视角"没超限"但真实字节超限', async () => {
+    const { brain, cards } = cardBrain()
+    // 中文字符 UTF-16 占 1 个 code unit,UTF-8 占 3 字节——构造一份 `.length` 明显
+    // 小于上限、真实 UTF-8 字节数明显大于上限的 HTML。
+    const chinesePad = '中'.repeat(Math.ceil(brain.handles.card.maxBytes / 2))
+    const html = `<div>${chinesePad}</div>`
+    expect(html.length).toBeLessThan(brain.handles.card.maxBytes)
+    expect(new TextEncoder().encode(html).length).toBeGreaterThan(brain.handles.card.maxBytes)
+
+    await brain.handles.card.final('call-1', { state: 'done', height: 522, html })
+
+    expect(cards).toHaveLength(0)
+    const { spy } = attachPanelBridge(brain)
+    expect(spy.find('card 版本超体积未发送')[0]?.level).toBe('error')
+  })
 })
 
