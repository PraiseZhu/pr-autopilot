new file mode 100644
index 00000000..7b9d0999
--- /dev/null
+++ b/src/canvas/actions/canvasActionModel.copyAsPng.test.ts
@@ -0,0 +1,254 @@
+// 多选「复制为 PNG」的装配契约 + 菜单复制的哨兵补写。
+//
+// 覆盖:
+//  SC-B1  多选全是图片 → 菜单出现 copy-as-png,点击把整个选区(图层顺序)交出去
+//  SC-B3  混选 / 非图片 / 缺 assetUrl → 不出现(不做"跳过非图片只拼图片")
+//  SC-B4  多选时单选专属项(AI 编辑/变体/旁生成/reset-crop 等)仍不出现 ——
+//         证明本项是单开的,没有去松 generationContextMenuGroupsFor 的
+//         `kind !== 'single'` 早退(那个早退同时护着上述各项)
+//  D1     菜单/快捷条「复制」补写哨兵,否则剪贴板里的旧截图会赢过刚复制的节点
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { contextMenuGroupsFor } from './canvasActionModel'
+import { createCanvasSelectionContext } from './canvasSelectionModel'
+import type { CanvasActionGroup, CanvasActionItem, CanvasActionRuntime } from './canvasActionTypes'
+import type { CanvasNodeType, MivoCanvasNode } from '../../types/mivoCanvas'
+import { CANVAS_CLIPBOARD_SENTINEL } from '../../lib/canvasClipboardSentinel'
+
+const node = (id: string, type: CanvasNodeType, over: Partial<MivoCanvasNode> = {}): MivoCanvasNode =>
+  ({
+    id,
+    title: id,
+    type,
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 100,
+    status: 'ready',
+    ...over,
+  }) as MivoCanvasNode
+
+/** 可复制为 PNG 的图片 = 有 assetUrl 的 image。 */
+const imageNode = (id: string, over: Partial<MivoCanvasNode> = {}) =>
+  node(id, 'image', { assetUrl: `asset://${id}`, ...over })
+
+const ctx = (nodes: MivoCanvasNode[], primary?: MivoCanvasNode) =>
+  createCanvasSelectionContext(nodes, primary ?? nodes[0])
+
+const createRuntime = (
+  context: ReturnType<typeof ctx>,
+  overrides: Partial<CanvasActionRuntime> = {},
+): CanvasActionRuntime =>
+  ({
+    context,
+    clipboardCount: 0,
+    hiddenCount: 0,
+    allNodeIds: context.nodes.map((n) => n.id),
+    canvasPosition: undefined,
+    setActiveTool: vi.fn(),
+    selectNodes: vi.fn(),
+    copySelectedNodes: vi.fn(),
+    pasteClipboardNodes: vi.fn(),
+    duplicateNode: vi.fn(),
+    duplicateSelectedNodes: vi.fn(),
+    deleteNode: vi.fn(),
+    deleteSelectedNodes: vi.fn(),
+    groupSelectedNodes: vi.fn(),
+    ungroupSelectedNodes: vi.fn(),
+    moveNodeLayer: vi.fn(),
+    moveSelectedLayer: vi.fn(),
+    alignSelectedNodes: vi.fn(),
+    distributeSelectedNodes: vi.fn(),
+    arrangeSelectedNodes: vi.fn(),
+    toggleSelectedNodesLocked: vi.fn(),
+    hideSelectedNodes: vi.fn(),
+    showAllHiddenNodes: vi.fn(),
+    updateMarkupStyle: vi.fn(),
+    updateSelectedMarkupStyle: vi.fn(),
+    updateSectionStyle: vi.fn(),
+    setSectionLockMode: vi.fn(),
+    removeSectionOnly: vi.fn(),
+    rotateImageNode: vi.fn(),
+    flipImageNode: vi.fn(),
+    resetImageCrop: vi.fn(),
+    addTextNode: vi.fn(() => 'text-id'),
+    addFrameNode: vi.fn(() => 'frame-id'),
+    addAiSlotNode: vi.fn(() => 'slot-id'),
+    addAnnotationNode: vi.fn(() => 'note-id'),
+    addMarkupNode: vi.fn(() => 'markup-id'),
+    generateVariations: vi.fn(async () => []),
+    generateImageEdit: vi.fn(async () => []),
+    generateBesideNode: vi.fn(async () => []),
+    generateIntoAiSlot: vi.fn(async () => []),
+    generateFromAnnotation: vi.fn(async () => []),
+    ...overrides,
+  }) as unknown as CanvasActionRuntime
+
+const findAction = (groups: CanvasActionGroup[], id: string): CanvasActionItem | undefined => {
+  for (const group of groups) {
+    for (const action of group.actions) {
+      if (action.id === id) return action
+      const child = action.children?.find((c) => c.id === id)
+      if (child) return child
+    }
+  }
+  return undefined
+}
+
+const hasAction = (groups: CanvasActionGroup[], id: string) => Boolean(findAction(groups, id))
+
+const fire = (groups: CanvasActionGroup[], id: string) => {
+  const action = findAction(groups, id)
+  if (!action?.onClick) throw new Error(`action missing or not clickable: ${id}`)
+  action.onClick()
+}
+
+const stubClipboard = () => {
+  const writeText = vi.fn(async () => undefined)
+  const original = Object.getOwnPropertyDescriptor(navigator, 'clipboard')
+  Object.defineProperty(navigator, 'clipboard', { value: { writeText }, configurable: true })
+  return {
+    writeText,
+    restore: () => {
+      if (original) Object.defineProperty(navigator, 'clipboard', original)
+      else Reflect.deleteProperty(navigator as unknown as Record<string, unknown>, 'clipboard')
+    },
+  }
+}
+
+let clipboard: ReturnType<typeof stubClipboard> | undefined
+
+afterEach(() => {
+  clipboard?.restore()
+  clipboard = undefined
+})
+
+describe('多选「复制为 PNG」装配', () => {
+  it('SC-B1 多选全是有资产的图片 → 出现 copy-as-png', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), imageNode('b')])))
+    expect(hasAction(groups, 'copy-as-png')).toBe(true)
+  })
+
+  it('SC-B1 点击把整个选区按传入(图层)顺序交给 onCopyImagesAsPng', () => {
+    const onCopyImagesAsPng = vi.fn()
+    const nodes = [imageNode('bottom'), imageNode('middle'), imageNode('top')]
+    const groups = contextMenuGroupsFor(createRuntime(ctx(nodes), { onCopyImagesAsPng }))
+
+    fire(groups, 'copy-as-png')
+    expect(onCopyImagesAsPng).toHaveBeenCalledTimes(1)
+    expect(onCopyImagesAsPng.mock.calls[0][0].map((n: MivoCanvasNode) => n.id)).toEqual([
+      'bottom',
+      'middle',
+      'top',
+    ])
+  })
+
+  it('自成独立一组,紧跟 inspect 簇之后(= 落在「适应所选」下面,带分隔线)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), imageNode('b')]), { onFitSelection: vi.fn() }),
+    )
+    const groupIds = groups.map((g) => g.id)
+    expect(groupIds.indexOf('selection-export')).toBe(groupIds.indexOf('inspect') + 1)
+
+    // 这一组只装 copy-as-png 一项(不许顺手塞别的进来)。
+    const exportGroup = groups.find((g) => g.id === 'selection-export')
+    expect(exportGroup?.actions.map((a) => a.id)).toEqual(['copy-as-png'])
+
+    // 反向:它不在 inspect 簇里 —— 在里面就没有分隔线,与单图菜单观感不一致。
+    const inspectIds = groups.find((g) => g.id === 'inspect')?.actions.map((a) => a.id) ?? []
+    expect(inspectIds).not.toContain('copy-as-png')
+    // inspect 簇本身仍以 copy → fit-selection 收尾(证明只是搬出去,没打乱既有顺序)。
+    expect(inspectIds.slice(0, 2)).toEqual(['copy', 'fit-selection'])
+  })
+
+  it('没接 onCopyImagesAsPng 时点击不抛(可选链安全)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), imageNode('b')]), { onCopyImagesAsPng: undefined }),
+    )
+    expect(() => fire(groups, 'copy-as-png')).not.toThrow()
+  })
+
+  it('SC-B3 混入文本节点 → 不出现', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), node('t', 'text')])))
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('SC-B3 混入 task-placeholder → 不出现(它也持有 imageAsset 能力,但没有 assetUrl)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), node('task', 'task-placeholder')])),
+    )
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('SC-B3 image 但缺 assetUrl → 不出现', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), node('empty', 'image')])),
+    )
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('SC-B3 混选 [image,text] → 整个 selection-export 组都不出现', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), node('t', 'text')])))
+    expect(groups.map((g) => g.id)).not.toContain('selection-export')
+  })
+
+  it('SC-B3 全是非图片(便签多选)→ 不出现', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([node('n1', 'annotation'), node('n2', 'annotation')])),
+    )
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('单选图片仍只有一份 copy-as-png(来自 edit 簇,没被多选那项重复装配)', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a')])))
+    const matches = groups.flatMap((g) => g.actions.filter((a) => a.id === 'copy-as-png'))
+    expect(matches).toHaveLength(1)
+  })
+
+  it('SC-B4 多选时单选专属项仍不出现 —— 没有松动 kind!=="single" 早退', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), imageNode('b')])))
+    for (const id of [
+      'reset-crop',
+      'variations',
+      'generate-beside',
+      'add-edit-note',
+      'edit-with-prompt',
+      'select-area-edit',
+      'remove-background',
+      'view-details',
+    ]) {
+      expect(hasAction(groups, id)).toBe(false)
+    }
+    // 同一份菜单里 copy-as-png 确实在(证明上面的"不出现"不是整份菜单为空)。
+    expect(hasAction(groups, 'copy-as-png')).toBe(true)
+  })
+})
+
+describe('D1 菜单「复制」补写哨兵', () => {
+  it('点击 copy → 内部剪贴板 + 系统剪贴板哨兵,两件都做', async () => {
+    clipboard = stubClipboard()
+    const copySelectedNodes = vi.fn()
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), imageNode('b')]), { copySelectedNodes }),
+    )
+
+    fire(groups, 'copy')
+    expect(copySelectedNodes).toHaveBeenCalledTimes(1)
+    // 补写是异步的(菜单点击没有 copy 事件可 setData),让微任务跑完再断言。
+    await Promise.resolve()
+    expect(clipboard.writeText).toHaveBeenCalledWith(CANVAS_CLIPBOARD_SENTINEL)
+  })
+
+  it('系统剪贴板不可用时,内部复制照做、不抛(哨兵只是增强)', () => {
+    const original = Object.getOwnPropertyDescriptor(navigator, 'clipboard')
+    Object.defineProperty(navigator, 'clipboard', { value: undefined, configurable: true })
+    try {
+      const copySelectedNodes = vi.fn()
+      const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a')]), { copySelectedNodes }))
+      expect(() => fire(groups, 'copy')).not.toThrow()
+      expect(copySelectedNodes).toHaveBeenCalledTimes(1)
+    } finally {
+      if (original) Object.defineProperty(navigator, 'clipboard', original)
+    }
+  })
+})
