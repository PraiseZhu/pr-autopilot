--- /dev/null
+++ b/src/lib/imageClipboardGeometry.ts
@@ -0,0 +1,249 @@
+// imageClipboardGeometry —— Copy as PNG 的纯几何层(不碰 DOM,可单测)。
+//
+// 为什么单独一层:jsdom 没有真 canvas / toBlob(见 src/main.tsx:46 的注释),几何
+// 若留在栅格化函数体内就只能靠 e2e 证,回归成本高。因此"取哪块源像素、产物多大、
+// 每张画在哪"全部收进本文件的纯函数,栅格化那层只剩 drawImage 的机械调用。
+//
+// 与渲染层严格同语义(canvasRenderAdapter.nodeRenderBoxFor / CanvasNodeView /
+// render/leaferImagePaint) —— 忠实度就是"和渲染层算的一样":
+//  - 几何取 node.transform,缺失时回落 x/y/width/height + rotation 0(同 transformOf);
+//  - rotation 单位 deg、顺时针、**绕中心**(渲染层 transformOrigin: '50% 50%');
+//  - imageCrop 存在**源空间**;镜像(imageFlipH/V)作用在裁剪后的窗口**整体**上
+//    (DOM 侧是 media box 的 scale(-1,1),leafer 侧是 paint 的 scaleX/scaleY)。
+//    因此变换顺序固定为 crop → flip → rotate,不可交换。
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+export type Size = { width: number; height: number }
+export type SourceRect = { x: number; y: number; width: number; height: number }
+
+const FULL_CROP = { x: 0, y: 0, width: 1, height: 1 }
+
+/** 多图合成的放大上限:朝"最高清那张不丢分辨率"努力,但不允许把画布撑到荒谬。 */
+export const MULTI_IMAGE_MAX_SCALE = 4
+
+/**
+ * 单边像素上限。**面积闸拦不住这一条**:两张 100×100 的图在无限画布上纵向隔开
+ * 十万单位,并集包围盒约 100×100000 —— 只 1000 万像素、面积闸放行,但 Chromium
+ * 在单边 ≥65536 时 `toBlob` 直接返回 null(实测 65535×10 成功、65536×10 为 null),
+ * 结果是用户只看到一句泛化失败。所以尺寸必须单独设闸并 fail-visible。
+ *
+ * 注:`canvasExport.ts` 的导出通道只有面积闸、没有这条,存在同款潜在缺口 —— 那是
+ * 另一个出口,不在本次改动范围内。
+ */
+export const CANVAS_MAX_BITMAP_SIDE = 65_535
+
+/** 几何真源:transform 优先,缺失回落扁平字段(与渲染层 transformOf 同款防御)。 */
+export const nodeGeometryOf = (node: MivoCanvasNode) =>
+  node.transform || { x: node.x, y: node.y, width: node.width, height: node.height, rotation: 0 }
+
+/** 归一化到 [0, 360)。 */
+export const normalizeRotation = (rotation: number) => {
+  if (!Number.isFinite(rotation)) return 0
+  const wrapped = rotation % 360
+  return wrapped < 0 ? wrapped + 360 : wrapped
+}
+
+/**
+ * 绕中心旋转后的轴对齐包围盒尺寸。
+ *
+ * 90 的倍数走整数快路径:图片节点的 rotation 实际只由 rotateImageNode 的 +90 步进
+ * 产生(没有自由旋转 UI),这条路径覆盖全部真实取值,且不引入浮点误差、不产生透明
+ * 边角。非 90 倍数走通用公式兜底(类型允许任意角度)。
+ */
+export const rotatedBoundsOf = (width: number, height: number, rotation: number): Size => {
+  const deg = normalizeRotation(rotation)
+  if (deg % 90 === 0) return deg % 180 === 0 ? { width, height } : { width: height, height: width }
+
+  const rad = (deg * Math.PI) / 180
+  const cos = Math.abs(Math.cos(rad))
+  const sin = Math.abs(Math.sin(rad))
+  return { width: width * cos + height * sin, height: width * sin + height * cos }
+}
+
+export type ImageNodeRasterPlan = {
+  /** 源位图上要取的矩形(源像素,未取整 —— drawImage 接受浮点)。 */
+  source: SourceRect
+  /** 旋转前的绘制尺寸(整数像素)= 单图产物的分辨率基准。 */
+  draw: Size
+  /** 产物画布尺寸(整数像素),= draw 绕中心旋转后的包围盒。 */
+  output: Size
+  rotation: number
+  flipH: boolean
+  flipV: boolean
+}
+
+/**
+ * 单张图片节点 → 栅格化计划。产物分辨率沿用**源裁剪区的像素数**(不是画布显示
+ * 尺寸),与本函数抽出前的行为一致:rotation=0 且无镜像时 output === draw ===
+ * round(源裁剪尺寸),产物逐字节不变。
+ */
+export const planImageNodeRaster = (node: MivoCanvasNode, natural: Size): ImageNodeRasterPlan => {
+  const crop = node.imageCrop || FULL_CROP
+  const source: SourceRect = {
+    x: crop.x * natural.width,
+    y: crop.y * natural.height,
+    width: Math.max(1, crop.width * natural.width),
+    height: Math.max(1, crop.height * natural.height),
+  }
+  const draw: Size = {
+    width: Math.max(1, Math.round(source.width)),
+    height: Math.max(1, Math.round(source.height)),
+  }
+  const rotation = normalizeRotation(nodeGeometryOf(node).rotation)
+  const bounds = rotatedBoundsOf(draw.width, draw.height, rotation)
+
+  return {
+    source,
+    draw,
+    // 承载内容的外接尺寸用 ceil 不用 round:round 会向下取整,把旋转后外沿裁掉
+    // (100×100 转 45° 理论 AABB 141.421,round 成 141 → 每侧切掉约 0.21px 的
+    // 不透明角点)。90 的倍数下 bounds 已是整数,ceil === round,故零变换路径的
+    // 逐字节口径不受影响。
+    output: {
+      width: Math.max(1, Math.ceil(bounds.width)),
+      height: Math.max(1, Math.ceil(bounds.height)),
+    },
+    rotation,
+    flipH: !!node.imageFlipH,
+    flipV: !!node.imageFlipV,
+  }
+}
+
+export type MultiImageEntry = { node: MivoCanvasNode; natural: Size }
+
+export type MultiImagePlacement = {
+  nodeId: string
+  /** 节点中心在产物坐标系里的位置(输出像素)。 */
+  center: { x: number; y: number }
+  /** 旋转前的绘制尺寸(输出像素)= 画布显示尺寸 × scale。 */
+  draw: Size
+  source: SourceRect
+  rotation: number
+  flipH: boolean
+  flipV: boolean
+}
+
+export type MultiImageCompositePlan = {
+  /** 1 画布单位 = scale 输出像素。 */
+  scale: number
+  /** 产物画布尺寸(整数像素)。调用方须对它跑像素预算闸。 */
+  output: Size
+  /** 绘制顺序 = 传入顺序(调用方传的是图层顺序)。 */
+  placements: MultiImagePlacement[]
+}
+
+/**
+ * 多张图片节点 → 合成计划。产物是选区的并集包围盒,保持各自相对位置与图层顺序。
+ *
+ * scale 的取法(这是唯一有裁量的地方,写清楚免得后人当成随手数):
+ *  - 基线是 1(1 画布单位 = 1 像素,即 100% 缩放下的所见);
+ *  - 朝上取到 nativeRatio —— 让"源分辨率最高那张"不被降采样,封顶 MULTI_IMAGE_MAX_SCALE;
+ *  - 若超出像素预算或单边上限则回退,但**只回退到 1**。低于 1 就是相对基线的静默
+ *    画质损失,那种情况不在这里悄悄降级,而是让产物尺寸继续超标、由调用方的闸报错
+ *    (fail-visible,与画布导出同口径)。
+ *
+ * 回退用**整数尺寸迭代收敛**,不是一次连续求解就收工:连续解算完再对宽高取整,取整
+ * 后的面积可能被推回上限之上 —— 那样"明明存在一个 >1 的合法 scale"却被调用方判超限
+ * 误拒(实测反例:两张约 100.3×100 的图纵向相隔 299900.3、源图 800×800,连续解
+ * scale=1.15297 → 取整后 116×345892 = 40,123,472 > 4000 万)。故循环压到真正装得下。
+ */
+export const planMultiImageComposite = (
+  entries: MultiImageEntry[],
+  options?: { maxScale?: number; maxPixels?: number; maxSide?: number },
+): MultiImageCompositePlan => {
+  const maxScale = options?.maxScale ?? MULTI_IMAGE_MAX_SCALE
+  if (!entries.length) return { scale: 1, output: { width: 1, height: 1 }, placements: [] }
+
+  let minX = Number.POSITIVE_INFINITY
+  let minY = Number.POSITIVE_INFINITY
+  let maxX = Number.NEGATIVE_INFINITY
+  let maxY = Number.NEGATIVE_INFINITY
+  let nativeRatio = 1
+
+  const boxes = entries.map(({ node, natural }) => {
+    const geometry = nodeGeometryOf(node)
+    const rotation = normalizeRotation(geometry.rotation)
+    const bounds = rotatedBoundsOf(geometry.width, geometry.height, rotation)
+    const center = { x: geometry.x + geometry.width / 2, y: geometry.y + geometry.height / 2 }
+
+    minX = Math.min(minX, center.x - bounds.width / 2)
+    minY = Math.min(minY, center.y - bounds.height / 2)
+    maxX = Math.max(maxX, center.x + bounds.width / 2)
+    maxY = Math.max(maxY, center.y + bounds.height / 2)
+
+    const crop = node.imageCrop || FULL_CROP
+    // 该节点若要不降采样,1 画布单位需要几个源像素。
+    nativeRatio = Math.max(
+      nativeRatio,
+      (crop.width * natural.width) / Math.max(1, geometry.width),
+      (crop.height * natural.height) / Math.max(1, geometry.height),
+    )
+
+    return { node, natural, geometry, rotation, center }
+  })
+
+  const unionWidth = Math.max(1, maxX - minX)
+  const unionHeight = Math.max(1, maxY - minY)
+  const maxPixels = options?.maxPixels ?? Number.POSITIVE_INFINITY
+  const maxSide = options?.maxSide ?? Number.POSITIVE_INFINITY
+  const areaScale = Number.isFinite(maxPixels)
+    ? Math.sqrt(maxPixels / (unionWidth * unionHeight))
+    : Number.POSITIVE_INFINITY
+  const sideScale = Number.isFinite(maxSide)
+    ? Math.min(maxSide / unionWidth, maxSide / unionHeight)
+    : Number.POSITIVE_INFINITY
+
+  const outputFor = (value: number) => ({
+    width: Math.max(1, Math.ceil(unionWidth * value)),
+    height: Math.max(1, Math.ceil(unionHeight * value)),
+  })
+  const fits = (size: Size) =>
+    size.width * size.height <= maxPixels && size.width <= maxSide && size.height <= maxSide
+
+  let scale = Math.max(1, Math.min(nativeRatio, maxScale, areaScale, sideScale))
+  let output = outputFor(scale)
+  // 取整后仍不合格就按"差多少收多少"往下压。上限 8 轮:每轮至少乘 0.999 的收缩比,
+  // 足够收敛;压到 1 还不行就停手,让调用方的闸报错(不静默降到 1 以下)。
+  for (let round = 0; round < 8 && scale > 1 && !fits(output); round += 1) {
+    const shrink = Math.min(
+      Math.sqrt(maxPixels / (output.width * output.height)),
+      maxSide / output.width,
+      maxSide / output.height,
+      0.999,
+    )
+    scale = Math.max(1, scale * shrink)
+    output = outputFor(scale)
+  }
+  // 收敛兜底:本函数只承诺两种终态 —— **装得下**,或 **scale === 1**(基线,超标由
+  // 调用方的闸 fail-visible)。极端长宽比下 8 轮可能压不进预算(可复现输入:几何
+  // 1×20,000,000、源 4×80,000,000、只给 maxPixels=4000 万 → 8 轮后 2×20,027,095
+  // 仍超标而 scale 还停在 1.0013),那会留下"既没装下、scale 又 >1"的第三种状态 ——
+  // 调用方据此以为拿到了合法放大计划。这里直接落回基线,消掉第三态。
+  // (生产调用同时给 maxSide,该输入会被单边闸先压到 1,所以这是契约缺口而非线上缺陷。)
+  if (scale > 1 && !fits(output)) {
+    scale = 1
+    output = outputFor(1)
+  }
+
+  return {
+    scale,
+    output,
+    placements: boxes.map(({ node, natural, geometry, rotation, center }) => {
+      const crop = node.imageCrop || FULL_CROP
+      return {
+        nodeId: node.id,
+        center: { x: (center.x - minX) * scale, y: (center.y - minY) * scale },
+        draw: { width: geometry.width * scale, height: geometry.height * scale },
+        source: {
+          x: crop.x * natural.width,
+          y: crop.y * natural.height,
+          width: Math.max(1, crop.width * natural.width),
+          height: Math.max(1, crop.height * natural.height),
+        },
+        rotation,
+        flipH: !!node.imageFlipH,
+        flipV: !!node.imageFlipV,
+      }
+    }),
+  }
+}
diff --git a/src/lib/imageNodeClipboard.ts b/src/lib/imageNodeClipboard.ts
index 624a1b96..9cbdb8d1 100644
--- a/src/lib/imageNodeClipboard.ts
+++ b/src/lib/imageNodeClipboard.ts
@@ -1,10 +1,31 @@
-// Copy-as-PNG for image nodes (FigJam parity: right-click → Copy as PNG).
-// Rasterizes the node's VISIBLE content — imageCrop applied — to a PNG blob and
-// writes it to the system clipboard. Success/skip/failure all reported via
-// debugLogger (+ toast for the user-visible outcome).
+// Copy-as-PNG for image nodes (参考产品同名菜单项的对位实现).
+// Rasterizes the node's VISIBLE content — imageCrop + 镜像 + 旋转 全部应用 — to a
+// PNG blob and writes it to the system clipboard. Success/skip/failure all reported
+// via debugLogger (+ toast for the user-visible outcome).
+//
+// 几何全部委托给 imageClipboardGeometry(纯函数、可单测);本文件只负责解码位图、
+// 按计划 drawImage、编码、写剪贴板。
+//
+// 2026-08-05:
+//  - 补上旋转与镜像 —— 此前只应用 imageCrop,把图转 90°/翻转后复制,粘出来是没转
+//    没翻的原图(静默给错结果)。
+//  - 新增多选合成入口 copyImageNodesAsPng。
 
 import type { MivoCanvasNode } from '../types/mivoCanvas'
 import { isImportedAssetUrl, readImportedAssetFile } from './assetStorage'
+import {
+  CANVAS_MAX_BITMAP_SIDE,
+  planImageNodeRaster,
+  planMultiImageComposite,
+  type MultiImageEntry,
+  type SourceRect,
+} from './imageClipboardGeometry'
+import {
+  CANVAS_EXPORT_ERROR_CODES,
+  CANVAS_EXPORT_LIMITS,
+  CanvasExportError,
+  assertCanvasExportPixelBudget,
+} from './canvasExport'
 import { isDemoAssetUrl, renderDemoImageBlob } from './demoAssets'
 import { debugLogger } from '../store/debugLogStore'
 import { toastFeedback } from '../store/toastStore'
@@ -40,51 +61,211 @@ const decodeImage = (url: string) =>
     image.src = url
   })
 
+/** 复制为 PNG 的合格节点:必须是有资产的 image。
+ *
+ *  注意不能用 `imageAsset` capability 代替 —— task-placeholder 也持有该能力
+ *  (canvasNodeRegistry),但它是待生成占位、没有 assetUrl,栅格化必挂。 */
+export const isCopyablePngNode = (node: MivoCanvasNode | undefined): boolean =>
+  !!node && node.type === 'image' && !!node.assetUrl
+
+const clipboardWriteAvailable = () => typeof ClipboardItem !== 'undefined' && !!navigator.clipboard?.write
+
+/**
+ * 绕中心画一张(已裁剪的)源位图,按 crop → flip → rotate 的顺序。
+ * 顺序与渲染层一致,理由见 imageClipboardGeometry 头注释。
+ */
+const drawPlacement = (
+  context: CanvasRenderingContext2D,
+  image: HTMLImageElement,
+  placement: {
+    center: { x: number; y: number }
+    draw: { width: number; height: number }
+    source: SourceRect
+    rotation: number
+    flipH: boolean
+    flipV: boolean
+  },
+) => {
+  const { center, draw, source, rotation, flipH, flipV } = placement
+  context.save()
+  context.translate(center.x, center.y)
+  if (rotation) context.rotate((rotation * Math.PI) / 180)
+  if (flipH || flipV) context.scale(flipH ? -1 : 1, flipV ? -1 : 1)
+  context.drawImage(
+    image,
+    source.x,
+    source.y,
+    source.width,
+    source.height,
+    -draw.width / 2,
+    -draw.height / 2,
+    draw.width,
+    draw.height,
+  )
+  context.restore()
+}
+
+const createCanvas = (width: number, height: number) => {
+  const canvas = document.createElement('canvas')
+  canvas.width = width
+  canvas.height = height
+  const context = canvas.getContext('2d')
+  if (!context) throw new Error('2d context unavailable')
+  return { canvas, context }
