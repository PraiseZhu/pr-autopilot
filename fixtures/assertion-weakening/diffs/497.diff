diff --git a/scripts/e2e/scenarios/copy-as-png.mjs b/scripts/e2e/scenarios/copy-as-png.mjs
new file mode 100644
index 00000000..64e62171
--- /dev/null
+++ b/scripts/e2e/scenarios/copy-as-png.mjs
@@ -0,0 +1,534 @@
+// copy-as-png — 剪贴板出图的忠实度 + 多选合成 + 哨兵仲裁。
+//
+// 为什么必须在真浏览器里证:jsdom 没有真 canvas/toBlob,也没有系统剪贴板。
+// "产物像素对不对""外部粘得到不到图""旧截图会不会赢"三件事只有这一层能证;
+// 几何算得对不对由 src/lib/imageClipboardGeometry.test.ts 单测覆盖,两层不重叠。
+//
+// 覆盖:
+//  SC-A4  零变换时产物 = 源图整幅(改动前后口径一致)
+//  SC-A1  旋转 90/180/270 → 产物方向随之(尺寸互换 + **四角映射方向**)
+//  SC-A2  镜像 → 产物像素随之改变,且**翻的是正确那根轴**
+//  SC-B1  多选两张 → 一张含两者的合成图,尺寸 = 并集包围盒,且**每张都在自己位置上**
+//  SC-B2  重叠时上层压下层
+//  D1     右键菜单「复制」也补写哨兵(真浏览器路径,不只是 mock)
+//  SC-C2  Cmd+C → Cmd+V 仍粘出节点副本
+//  SC-C3  剪贴板里先有外部图时,画布内 Cmd+C 后 Cmd+V 粘的仍是节点(哨兵仲裁生效)
+//
+// 渲染器无关:断言主体是 store 状态 + 系统剪贴板产物,节点点击走 renderer-evidence 投影。
+
+import { clickCanvasNode, waitForNodeRendered } from '../renderer-evidence.mjs'
+import { waitForAsyncPredicate } from '../wait-async-predicate.mjs'
+
+const HERO = 'ref-hero'
+const MOOD = 'mood-env'
+
+/**
+ * 读回系统剪贴板里的图:尺寸 + 四角采样 + 网格指纹 + 调用方指定的任意探针点。
+ *
+ * 四角采样不是装饰:方向类断言(旋转转对了没、镜像翻的是哪根轴)只能靠"源图哪个角
+ * 跑到了产物哪个角"来钉 —— 只断"尺寸变了"或"指纹不同"的话,把 rotate(+θ) 写成
+ * rotate(-θ)、或把 H/V 两轴对调,断言照样全绿。
+ */
+const readClipboardImage = (page, probes = []) =>
+  page.evaluate(async (probePoints) => {
+    const items = await navigator.clipboard.read()
+    for (const item of items) {
+      const type = item.types.find((entry) => entry.startsWith('image/'))
+      if (!type) continue
+
+      const blob = await item.getType(type)
+      const bitmap = await createImageBitmap(blob)
+      const canvas = document.createElement('canvas')
+      canvas.width = bitmap.width
+      canvas.height = bitmap.height
+      const context = canvas.getContext('2d')
+      context.drawImage(bitmap, 0, 0)
+
+      // 采**小区域均值**而不是单点:同一张源图以不同倍率画进产物(单张走源分辨率、
+      // 合成走 union×scale)时,单点会因重采样漂移十几到几十个色阶,区域均值稳定得多。
+      // 半径 6 → 13×13 的盒;盒被 clamp 在图内,边角处会往内收。
+      const pixel = (x, y, radius = 6) => {
+        const cx = Math.min(Math.max(radius, Math.round(x)), Math.max(radius, bitmap.width - 1 - radius))
+        const cy = Math.min(Math.max(radius, Math.round(y)), Math.max(radius, bitmap.height - 1 - radius))
+        const left = Math.max(0, cx - radius)
+        const top = Math.max(0, cy - radius)
+        const width = Math.min(bitmap.width - left, radius * 2 + 1)
+        const height = Math.min(bitmap.height - top, radius * 2 + 1)
+        const { data } = context.getImageData(left, top, width, height)
+        const sum = [0, 0, 0, 0]
+        for (let offset = 0; offset < data.length; offset += 4) {
+          sum[0] += data[offset]
+          sum[1] += data[offset + 1]
+          sum[2] += data[offset + 2]
+          sum[3] += data[offset + 3]
+        }
+        const count = data.length / 4
+        return sum.map((channel) => Math.round(channel / count))
+      }
+      // 8×8 网格指纹:整幅内容的稳定摘要,不依赖具体图案。
+      const grid = []
+      for (let gy = 0; gy < 8; gy += 1) {
+        for (let gx = 0; gx < 8; gx += 1) {
+          grid.push(pixel(((gx + 0.5) * bitmap.width) / 8, ((gy + 0.5) * bitmap.height) / 8).join(','))
+        }
+      }
+
+      return {
+        type,
+        width: bitmap.width,
+        height: bitmap.height,
+        signature: grid.join('|'),
+        pixel: {
+          tl: pixel(2, 2),
+          tr: pixel(bitmap.width - 3, 2),
+          bl: pixel(2, bitmap.height - 3),
+          br: pixel(bitmap.width - 3, bitmap.height - 3),
+          center: pixel(bitmap.width / 2, bitmap.height / 2),
+        },
+        probes: probePoints.map((point) => pixel(point.x, point.y, point.radius ?? 6)),
+      }
+    }
+    return null
+  }, probes)
+
+/** 把剪贴板清成一段无关文本 —— 保证下一步读到的图一定是本次复制产生的。 */
+const clearClipboard = (page) => page.evaluate(() => navigator.clipboard.writeText('__e2e_clipboard_reset__'))
+
+const readClipboardText = (page) => page.evaluate(() => navigator.clipboard.readText())
+
+/** 往系统剪贴板塞一张"外部截图"(2×2 纯色 PNG),用于哨兵仲裁的对照。 */
+const putForeignImageOnClipboard = (page) =>
+  page.evaluate(async () => {
+    const canvas = document.createElement('canvas')
+    canvas.width = 2
+    canvas.height = 2
+    const context = canvas.getContext('2d')
+    context.fillStyle = '#00ff00'
+    context.fillRect(0, 0, 2, 2)
+    const blob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'))
+    await navigator.clipboard.write([new ClipboardItem({ 'image/png': blob })])
+  })
+
+/**
+ * 清掉 DOM 文字选区再按 Cmd+C。
+ *
+ * 不是保险起见:handleCopyOrCut 在 `hasActiveTextSelection()` 为真时**直接放行系统
+ * 默认行为**(让聊天气泡等处的文本复制不被接管),于是哨兵不会被写。前面刚点过右键
+ * 菜单项,点击有可能在菜单文案上留下一段选区 —— 那样这一步会变成"偶发不写哨兵",
+ * 表现为下面的等待超时。把选区显式清掉,消掉这个干扰源。
+ */
+const clearDomTextSelection = (page) =>
+  page.evaluate(() => {
+    window.getSelection()?.removeAllRanges()
+  })
+
+/**
+ * 等"剪贴板里的文字**就是哨兵**",不是等"文字非空"。
+ * 后者会被上一步残留的任何文本满足,等待就成了摆设(本仓 e2e-wait-guard 关心的同一类)。
+ */
+const waitForSentinelOnClipboard = (page, label) =>
+  waitForAsyncPredicate(
+    page,
+    async () => {
+      const text = await navigator.clipboard.readText()
+      return !!text && !/\S/u.test(text.replace(/\u200b/gu, ''))
+    },
+    undefined,
+    { label, timeout: 10000 },
+  )
+
+const readNode = (page, moduleSpec, nodeId) =>
+  page.evaluate(
+    async ({ spec, id }) => {
+      const { useCanvasStore } = await import(spec)
+      const node = useCanvasStore.getState().nodes.find((entry) => entry.id === id)
+      if (!node) return null
+      return {
+        x: node.x,
+        y: node.y,
+        width: node.width,
+        height: node.height,
+        assetUrl: node.assetUrl,
+        crop: node.imageCrop || null,
+        rotation: node.transform?.rotation ?? 0,
+        flipH: Boolean(node.imageFlipH),
+        flipV: Boolean(node.imageFlipV),
+      }
+    },
+    { spec: moduleSpec, id: nodeId },
+  )
+
+const nodeSummary = (page, moduleSpec) =>
+  page.evaluate(async (spec) => {
+    const { useCanvasStore } = await import(spec)
+    const { nodes } = useCanvasStore.getState()
+    return {
+      total: nodes.length,
+      assetUrls: nodes.filter((node) => node.type === 'image').map((node) => node.assetUrl),
+    }
+  }, moduleSpec)
+
+const selectNodes = (page, moduleSpec, nodeIds) =>
+  page.evaluate(
+    async ({ spec, ids }) => {
+      const { useCanvasStore } = await import(spec)
+      useCanvasStore.getState().selectNodes(ids, ids[0])
+    },
+    { spec: moduleSpec, ids: nodeIds },
+  )
+
+/** 右键节点 → 点菜单里指定项。菜单项是 role="menuitem"(不是 button)。 */
+const clickContextMenuItem = async (page, rendererMode, nodeId, itemName) => {
+  await clickCanvasNode(page, rendererMode, nodeId, { button: 'right' })
+  await page.waitForSelector('.node-action-menu', { timeout: 5000 })
+  const item = page.locator('.node-action-menu').getByRole('menuitem', { name: itemName })
+  if (!(await item.count())) {
+    const labels = await page.locator('.node-action-menu button').allTextContents()
+    throw new Error(`Context menu for ${nodeId} lacks "${itemName}"; items = ${JSON.stringify(labels)}`)
+  }
+  await item.click()
+}
+
+/** 右键节点 → 点「Copy as PNG」→ 等剪贴板里真出现图。 */
+const copyAsPngViaContextMenu = async (page, rendererMode, nodeId, probes = []) => {
+  await clearClipboard(page)
+  await clickContextMenuItem(page, rendererMode, nodeId, 'Copy as PNG')
+  await waitForAsyncPredicate(
+    page,
+    async () => {
+      const items = await navigator.clipboard.read()
+      return items.some((item) => item.types.some((type) => type.startsWith('image/')))
+    },
+    undefined,
+    { label: 'Copy as PNG 把位图写进系统剪贴板', timeout: 10000 },
+  )
+  return readClipboardImage(page, probes)
+}
+
+/** 两个 RGBA 采样是否近似相同(重采样/JPEG 会带来几个数量级内的抖动)。 */
+const samePixel = (a, b, tolerance = 16) =>
+  a.length === b.length && a.every((channel, index) => Math.abs(channel - b[index]) <= tolerance)
+
+const assertPixelMaps = (label, from, to) => {
+  if (!samePixel(from, to)) {
+    throw new Error(`${label}: expected source pixel ${JSON.stringify(from)} to land at ${JSON.stringify(to)}`)
+  }
+}
+
+/** 走真实 store 动作(与快捷条按钮同一条路),不手改 transform 字段。 */
+const rotateNode = (page, moduleSpec, nodeId, times) =>
+  page.evaluate(
+    async ({ spec, id, count }) => {
+      const { useCanvasStore } = await import(spec)
+      for (let i = 0; i < count; i += 1) useCanvasStore.getState().rotateImageNode(id)
+    },
+    { spec: moduleSpec, id: nodeId, count: times },
+  )
+
+const moveNode = (page, moduleSpec, nodeId, x, y) =>
+  page.evaluate(
+    async ({ spec, id, nx, ny }) => {
+      const { useCanvasStore } = await import(spec)
+      useCanvasStore.getState().updateNodePosition(id, nx, ny)
+    },
+    { spec: moduleSpec, id: nodeId, nx: x, ny: y },
+  )
+
+const moveLayer = (page, moduleSpec, nodeId, move) =>
+  page.evaluate(
+    async ({ spec, id, direction }) => {
+      const { useCanvasStore } = await import(spec)
+      useCanvasStore.getState().moveNodeLayer(id, direction)
+    },
+    { spec: moduleSpec, id: nodeId, direction: move },
+  )
+
+const flipNode = (page, moduleSpec, nodeId, axis) =>
+  page.evaluate(
+    async ({ spec, id, which }) => {
+      const { useCanvasStore } = await import(spec)
+      useCanvasStore.getState().flipImageNode(id, which)
+    },
+    { spec: moduleSpec, id: nodeId, which: axis },
+  )
+
+/**
+ * 造一张**四象限纯色**图片节点(TL 红 / TR 绿 / BL 蓝 / BR 黄),专供方向类断言。
+ *
+ * 为什么不能用 demo 里的照片:ref-hero 是「蓝色背景」的人物插画,四个角颜色几乎一样 ——
+ * 实测拿"把 rotate(+θ) 改成 rotate(-θ)"的 mutant 跑过,基于它的四角断言**照样全绿**。
+ * 方向能不能被证,取决于基准图四角是否可区分,所以这里自带一张可区分的。
+ * 源尺寸自己定(400×300),顺带让"产物 = 源分辨率"这条也变成精确断言。
+ */
+const createQuadrantImageNode = (page, moduleSpec) =>
+  page.evaluate(async (spec) => {
+    const { useCanvasStore } = await import(spec)
+    const canvas = document.createElement('canvas')
+    canvas.width = 400
+    canvas.height = 300
+    const context = canvas.getContext('2d')
+    const quadrants = [
+      ['#ff0000', 0, 0],
+      ['#00ff00', 200, 0],
+      ['#0000ff', 0, 150],
+      ['#ffff00', 200, 150],
+    ]
+    for (const [color, x, y] of quadrants) {
+      context.fillStyle = color
+      context.fillRect(x, y, 200, 150)
+    }
+    const title = 'e2e-quadrants'
+    useCanvasStore.getState().addImportedImage(canvas.toDataURL('image/png'), title, undefined, { x: 260, y: -180 })
+    const node = useCanvasStore.getState().nodes.find((entry) => entry.title === title)
+    return node ? node.id : null
+  }, moduleSpec)
+
+/** 四象限图的角色:红=左上、绿=右上、蓝=左下、黄=右下(容差内判等)。 */
+const QUADRANT = {
+  red: [255, 0, 0, 255],
+  green: [0, 255, 0, 255],
+  blue: [0, 0, 255, 255],
+  yellow: [255, 255, 0, 255],
+}
+
+export const runCopyAsPngScenario = async (context) => {
+  const { page, rendererMode, canvasStoreSpec } = context
+  const moduleSpec = await canvasStoreSpec()
+
+  await waitForNodeRendered(page, rendererMode, HERO)
+  await waitForNodeRendered(page, rendererMode, MOOD)
+
+  // ── A 组:忠实度。全部跑在自造的四象限图上(理由见 createQuadrantImageNode)──
+  const quadId = await createQuadrantImageNode(page, moduleSpec)
+  if (!quadId) throw new Error('Failed to seed the quadrant fixture node')
+  await waitForNodeRendered(page, rendererMode, quadId)
+
+  // SC-A4 基线:零变换 → 产物 = 源图整幅(源尺寸自己定的 400×300,精确可断)
+  const baseline = await copyAsPngViaContextMenu(page, rendererMode, quadId)
+  if (!baseline) throw new Error('Copy as PNG should put an image on the clipboard')
+  if (baseline.type !== 'image/png') throw new Error(`Clipboard image should be PNG, got ${baseline.type}`)
+  if (baseline.width !== 400 || baseline.height !== 300) {
+    throw new Error(`Baseline PNG should carry SOURCE resolution 400x300, got ${baseline.width}x${baseline.height}`)
+  }
+  // 基准图本身的四角必须是四种可区分的颜色 —— 否则下面所有方向断言都是摆设。
+  assertPixelMaps('fixture top-left should be red', QUADRANT.red, baseline.pixel.tl)
+  assertPixelMaps('fixture top-right should be green', QUADRANT.green, baseline.pixel.tr)
+  assertPixelMaps('fixture bottom-left should be blue', QUADRANT.blue, baseline.pixel.bl)
+  assertPixelMaps('fixture bottom-right should be yellow', QUADRANT.yellow, baseline.pixel.br)
+
+  // SC-A1 旋转:尺寸 + **方向**。四角互不相同,所以顺时针/逆时针写反必然变红。
+  await rotateNode(page, moduleSpec, quadId, 1)
+  const rotated90 = await copyAsPngViaContextMenu(page, rendererMode, quadId)
+  if (rotated90.width !== baseline.height || rotated90.height !== baseline.width) {
+    throw new Error(
+      `90° rotation should swap the PNG dimensions: baseline ${baseline.width}x${baseline.height}, rotated ${rotated90.width}x${rotated90.height}`,
+    )
+  }
+  assertPixelMaps('90° CW maps top-left → top-right', QUADRANT.red, rotated90.pixel.tr)
+  assertPixelMaps('90° CW maps top-right → bottom-right', QUADRANT.green, rotated90.pixel.br)
+  assertPixelMaps('90° CW maps bottom-right → bottom-left', QUADRANT.yellow, rotated90.pixel.bl)
+  assertPixelMaps('90° CW maps bottom-left → top-left', QUADRANT.blue, rotated90.pixel.tl)
+
+  await rotateNode(page, moduleSpec, quadId, 1)
+  const rotated180 = await copyAsPngViaContextMenu(page, rendererMode, quadId)
+  if (rotated180.width !== baseline.width || rotated180.height !== baseline.height) {
+    throw new Error(`180° rotation should keep the PNG dimensions, got ${rotated180.width}x${rotated180.height}`)
+  }
+  // 尺寸相同,只能靠像素证"旋转真的落到了 canvas 上"(尺寸来自几何计划,变换没执行
+  // 时画布尺寸照样对 —— 实测"只应用 crop"的 mutant 让 90° 尺寸断言照绿、这里变红)。
+  assertPixelMaps('180° maps top-left → bottom-right', QUADRANT.red, rotated180.pixel.br)
+  assertPixelMaps('180° maps top-right → bottom-left', QUADRANT.green, rotated180.pixel.bl)
+
+  await rotateNode(page, moduleSpec, quadId, 2) // 回到 0°
+  const unrotated = await readNode(page, moduleSpec, quadId)
+  if (unrotated.rotation !== 0) throw new Error(`Rotation cleanup failed, got ${unrotated.rotation}`)
+
+  // SC-A2 镜像:断**哪根轴**。H 是左右对调、上下不动;V 反之。两轴写反必然变红。
+  await flipNode(page, moduleSpec, quadId, 'horizontal')
+  const flippedH = await copyAsPngViaContextMenu(page, rendererMode, quadId)
+  if (flippedH.width !== baseline.width || flippedH.height !== baseline.height) {
+    throw new Error(`Flip must not change dimensions, got ${flippedH.width}x${flippedH.height}`)
+  }
+  assertPixelMaps('H flip maps top-left → top-right', QUADRANT.red, flippedH.pixel.tr)
+  assertPixelMaps('H flip maps top-right → top-left', QUADRANT.green, flippedH.pixel.tl)
+  assertPixelMaps('H flip keeps rows (bottom-left → bottom-right)', QUADRANT.blue, flippedH.pixel.br)
+
+  await flipNode(page, moduleSpec, quadId, 'horizontal') // 关掉 H
+  await flipNode(page, moduleSpec, quadId, 'vertical')
+  const flippedV = await copyAsPngViaContextMenu(page, rendererMode, quadId)
+  assertPixelMaps('V flip maps top-left → bottom-left', QUADRANT.red, flippedV.pixel.bl)
+  assertPixelMaps('V flip maps bottom-left → top-left', QUADRANT.blue, flippedV.pixel.tl)
+  assertPixelMaps('V flip keeps columns (top-right → bottom-right)', QUADRANT.green, flippedV.pixel.br)
+
+  await flipNode(page, moduleSpec, quadId, 'vertical') // 关掉 V
+
+  // 复原后必须回到基线逐格一致(证明上面几步没有留下副作用)。
+  const restoredQuad = await copyAsPngViaContextMenu(page, rendererMode, quadId)
+  if (restoredQuad.signature !== baseline.signature) {
+    throw new Error('Clearing rotation/flip should reproduce the baseline PNG exactly')
+  }
+
+  // B 组要拿 ref-hero 自己的单张产物做参照(合成里按位置比对时用)。
+  const restored = await copyAsPngViaContextMenu(page, rendererMode, HERO)
+
+  // ── SC-B1 / SC-B2 多选合成 ────────────────────────────────────────────────
+  const heroBox = await readNode(page, moduleSpec, HERO)
+  const moodBox = await readNode(page, moduleSpec, MOOD)
+
+  // 先各自单独复制一次,拿到"这张图自己的中心像素"作为参照。
+  await selectNodes(page, moduleSpec, [MOOD])
+  const moodSolo = await copyAsPngViaContextMenu(page, rendererMode, MOOD)
+
+  const minX = Math.min(heroBox.x, moodBox.x)
+  const minY = Math.min(heroBox.y, moodBox.y)
+  const unionWidth = Math.max(heroBox.x + heroBox.width, moodBox.x + moodBox.width) - minX
+  const unionHeight = Math.max(heroBox.y + heroBox.height, moodBox.y + moodBox.height) - minY
+  // 两节点之间的空隙(hero 右缘 → mood 左缘),用来断"空处必须透明"。
+  const gapCenterX = (heroBox.x + heroBox.width + moodBox.x) / 2
+  if (gapCenterX <= heroBox.x + heroBox.width || gapCenterX >= moodBox.x) {
+    throw new Error('Fixture assumption broken: ref-hero and mood-env should not touch/overlap here')
+  }
+
+  await selectNodes(page, moduleSpec, [HERO, MOOD])
+  // 两趟:第一趟只为从产物尺寸反推 scale(合成会按"最高清那张不降采样"放大,倍数
+  // 由源图分辨率决定,场景侧算不出),第二趟带着换算好的探针点再取一次。
+  const sizeProbe = await copyAsPngViaContextMenu(page, rendererMode, HERO)
+  if (!sizeProbe) throw new Error('Multi-select Copy as PNG should put an image on the clipboard')
+  const scale = sizeProbe.width / unionWidth
+  const probeFor = (canvasX, canvasY) => ({ x: (canvasX - minX) * scale, y: (canvasY - minY) * scale })
+
+  const multi = await copyAsPngViaContextMenu(page, rendererMode, HERO, [
+    probeFor(heroBox.x + heroBox.width / 2, heroBox.y + heroBox.height / 2),
+    probeFor(moodBox.x + moodBox.width / 2, moodBox.y + moodBox.height / 2),
+    { ...probeFor(gapCenterX, minY + unionHeight / 2), radius: 0 }, // 透明判定必须单点
+  ])
+  const [heroProbe, moodProbe, gapProbe] = multi.probes
+
+  const aspect = multi.width / multi.height
+  const unionAspect = unionWidth / unionHeight
+  if (Math.abs(aspect - unionAspect) > 0.02) {
+    throw new Error(
+      `Composite PNG should match the union bbox aspect: expected ~${unionAspect.toFixed(3)}, got ${aspect.toFixed(3)} (${multi.width}x${multi.height})`,
+    )
+  }
+
+  // **每张都被画、且画在自己的位置上**。只断比例/宽度是不够的:实现若只画最上面
+  // 那一张、或把两张都摞在中心,比例与宽度断言照样绿。
+  assertPixelMaps('composite should carry ref-hero at its own centre', restored.pixel.center, heroProbe)
+  assertPixelMaps('composite should carry mood-env at its own centre', moodSolo.pixel.center, moodProbe)
+  if (samePixel(heroProbe, moodProbe)) {
+    throw new Error('Two different photos must not sample identically — probes are not discriminating')
+  }
+  // 空隙必须透明:证明画布确实是并集包围盒、两张各就各位而不是铺满。
+  if (gapProbe[3] !== 0) {
+    throw new Error(`Gap between the two images should stay transparent, got alpha ${gapProbe[3]}`)
+  }
+
+  // ── SC-B2 层序:重叠时上层压下层 ──────────────────────────────────────────
+  // 差分断言 —— 把两张叠一半,交换层序前后各取一张合成图,像素必须不同。
+  // 若合成无视图层顺序(比如永远按选中顺序画),两张会逐格相同。
+  // 右键必须点在**最上层**那个节点上:被压住的节点会被 Playwright 的可操作性
+  // 检查判成 "subtree intercepts pointer events"。选区已含两者,点谁都开多选菜单。
+  await moveNode(page, moduleSpec, MOOD, heroBox.x + heroBox.width / 2, heroBox.y)
+  await selectNodes(page, moduleSpec, [HERO, MOOD])
+  const moodOnTop = await copyAsPngViaContextMenu(page, rendererMode, MOOD)
+  await moveLayer(page, moduleSpec, HERO, 'front')
+  await selectNodes(page, moduleSpec, [HERO, MOOD])
+  const heroOnTop = await copyAsPngViaContextMenu(page, rendererMode, HERO)
+  if (moodOnTop.width !== heroOnTop.width || moodOnTop.height !== heroOnTop.height) {
+    throw new Error('Layer reorder must not change the union bbox; only the overlap pixels')
+  }
+  if (moodOnTop.signature === heroOnTop.signature) {
+    throw new Error('Bringing a node to front must change the composite overlap — layer order was ignored')
+  }
+  await moveNode(page, moduleSpec, MOOD, moodBox.x, moodBox.y)
+
+  // ── SC-C2 / SC-C3 哨兵仲裁 ────────────────────────────────────────────────
+  await selectNodes(page, moduleSpec, [HERO])
+  const before = await nodeSummary(page, moduleSpec)
+
+  // C2:普通 Cmd+C → Cmd+V 粘出节点副本。
+  await clearDomTextSelection(page)
+  await page.keyboard.press('ControlOrMeta+c')
+  await waitForSentinelOnClipboard(page, 'Cmd+C 把哨兵写进系统剪贴板')
+  const sentinelText = await readClipboardText(page)
+  if (/[^\s\u200b]/.test(sentinelText)) {
+    throw new Error(`Sentinel must not contain visible text, got ${JSON.stringify(sentinelText)}`)
+  }
+  await page.keyboard.press('ControlOrMeta+v')
+  await waitForAsyncPredicate(
+    page,
+    async ({ spec, expected }) => {
+      const { useCanvasStore } = await import(spec)
+      return useCanvasStore.getState().nodes.length >= expected
+    },
+    { spec: moduleSpec, expected: before.total + 1 },
+    { label: 'Cmd+V 粘出一个节点副本', timeout: 10000 },
+  )
+  const afterPaste = await nodeSummary(page, moduleSpec)
+  const heroAssetCount = (summary) => summary.assetUrls.filter((url) => url === heroBox.assetUrl).length
+  if (heroAssetCount(afterPaste) !== heroAssetCount(before) + 1) {
+    throw new Error('Cmd+V should duplicate the canvas node (same assetUrl), not import a bitmap')
+  }
+
+  // C3(关键回归):剪贴板里先躺一张外部图,再画布内复制节点 → 粘的仍须是节点。
+  await putForeignImageOnClipboard(page)
+  await selectNodes(page, moduleSpec, [HERO])
+  await clearDomTextSelection(page)
+  await page.keyboard.press('ControlOrMeta+c')
+  await waitForSentinelOnClipboard(page, 'Cmd+C 覆盖掉外部图、写入哨兵')
+  const beforeArbitration = await nodeSummary(page, moduleSpec)
+  await page.keyboard.press('ControlOrMeta+v')
+  await waitForAsyncPredicate(
+    page,
+    async ({ spec, expected }) => {
+      const { useCanvasStore } = await import(spec)
+      return useCanvasStore.getState().nodes.length >= expected
+    },
+    { spec: moduleSpec, expected: beforeArbitration.total + 1 },
+    { label: '仲裁后 Cmd+V 粘出节点副本', timeout: 10000 },
+  )
+  const afterArbitration = await nodeSummary(page, moduleSpec)
+  if (heroAssetCount(afterArbitration) !== heroAssetCount(beforeArbitration) + 1) {
+    throw new Error(
+      'Canvas clipboard must win over the stale foreign image: expected another node copy of the hero asset',
+    )
+  }
+
+  // ── D1:右键菜单「复制」也必须补写哨兵(真浏览器路径)────────────────────────
+  // 单测只能证"writeText 被调用";菜单点击是否真在用户手势窗口内、异步写入是否
+  // 真的赶在粘贴之前落地,只有这一层能证。修复前这条必红:菜单复制完全不碰系统
+  // 剪贴板 → 仲裁认为系统内容更新 → 粘出的是那张外部图而不是节点副本。
+  await putForeignImageOnClipboard(page)
+  await selectNodes(page, moduleSpec, [HERO])
+  await clickContextMenuItem(page, rendererMode, HERO, 'Copy image')
+  await waitForAsyncPredicate(
+    page,
+    async () => {
+      const items = await navigator.clipboard.read()
+      // 补写完成的判据:图没了、只剩文字(哨兵)。
+      return !items.some((item) => item.types.some((type) => type.startsWith('image/')))
+    },
+    undefined,
+    { label: '菜单「复制」把哨兵异步补写进系统剪贴板', timeout: 10000 },
+  )
+  const beforeMenuPaste = await nodeSummary(page, moduleSpec)
+  await page.keyboard.press('ControlOrMeta+v')
+  await waitForAsyncPredicate(
+    page,
+    async ({ spec, expected }) => {
+      const { useCanvasStore } = await import(spec)
+      return useCanvasStore.getState().nodes.length >= expected
+    },
+    { spec: moduleSpec, expected: beforeMenuPaste.total + 1 },
+    { label: '菜单复制后 Cmd+V 粘出节点副本', timeout: 10000 },
+  )
+  const afterMenuPaste = await nodeSummary(page, moduleSpec)
+  if (heroAssetCount(afterMenuPaste) !== heroAssetCount(beforeMenuPaste) + 1) {
+    throw new Error(
+      'Menu "Copy image" must write the sentinel so the canvas clipboard wins: expected a node copy, got the foreign bitmap',
+    )
+  }
+
+  console.log('[e2e-smoke] copy-as-png scenario passed')
+}
