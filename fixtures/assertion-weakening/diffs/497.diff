@@ -0,0 +1,58 @@
+// canvasClipboardSentinel —— 画布复制/剪切时写进系统剪贴板的哨兵记号。
+//
+// **它是承重的仲裁记号,不是给用户看的文案。**
+// 粘贴时哨兵还在 = 期间没复制过别的东西 → 画布内部剪贴板最新鲜,优先消费;
+// 哨兵不在(之后截了图/复制了别的)→ 系统剪贴板内容优先。没有哨兵机制时,
+// 系统里残留的旧截图会永远遮蔽画布的剪切/复制内容(2026-07-31 用户报
+// 「剪切粘贴没生效」就是这个)。
+//
+// 三条红线:
+//  1. **别删** —— 删了就退回"系统剪贴板里有图就一定赢",旧截图遮蔽 bug 复活。
+//  2. **别本地化** —— 匹配是全等比较,复制与粘贴之间切了语言就漏判。
+//  3. **别换空串** —— 空串与"剪贴板本来就没文字"(如刚从别处复制了一张图)撞车,
+//     会把陈旧的内部剪贴板误判成最新鲜。零宽空格是有内容的,撞不上。
+//
+// 2026-08-05:原值是一句中文提示,粘到画布外的输入框会吐出可见文字(参考产品
+// 不留任何可见内容)。改成零宽空格 —— 外部粘贴观感为"什么都没粘上",仲裁精度不变。
+// 唯一代价:粘进终端/代码编辑器会插入一个不可见字符,取舍上优于吐一句中文。
+import { debugLogger } from '../store/debugLogStore'
+
+const SENTINEL_LOG_SOURCE = 'Canvas Clipboard'
+
+// 必须写成转义序列:字面零宽字符在编辑器里不可见,容易被格式化工具/手改静默吃掉。
+export const CANVAS_CLIPBOARD_SENTINEL = '\u200b'
+
+/** 历史哨兵值:只用于识别"升级前复制、升级后粘贴"那一次,永不写出。 */
+const LEGACY_CANVAS_CLIPBOARD_SENTINELS = ['Mivo Canvas 剪贴板占位 — 回到画布按 Ctrl/Cmd+V 粘贴']
+
+/** 这段文字是否是我们自己的哨兵(当前值或历史值)。空/undefined 一律不算。 */
+export const isCanvasClipboardSentinel = (text: string | null | undefined): boolean =>
+  !!text && (text === CANVAS_CLIPBOARD_SENTINEL || LEGACY_CANVAS_CLIPBOARD_SENTINELS.includes(text))
+
+/**
+ * 给**没有 copy 事件**的复制入口(右键菜单的「复制」)补写哨兵。
+ *
+ * Cmd/Ctrl+C 走原生 copy 事件,能同步 `setData` 保底;菜单点击没有事件对象,
+ * 只能走异步 `writeText`。不补的话菜单复制完全不碰系统剪贴板,粘贴时哨兵缺席
+ * → 仲裁判定"系统内容更新",剪贴板里残留的旧截图会赢,用户复制的节点被无视。
+ *
+ * 失败不弹 toast:哨兵是不可见机制,写不进去只是退回补写之前的行为
+ * (画布内粘贴仍有 handlePaste 末尾的内部剪贴板兜底)。三条路径各留一条日志。
+ */
+export const writeCanvasClipboardSentinel = async (): Promise<boolean> => {
+  if (!navigator.clipboard?.writeText) {
+    debugLogger.warn(SENTINEL_LOG_SOURCE, 'Sentinel write skipped: Clipboard API unavailable in this browser')
+    return false
+  }
+  try {
+    await navigator.clipboard.writeText(CANVAS_CLIPBOARD_SENTINEL)
+    debugLogger.log(SENTINEL_LOG_SOURCE, 'Canvas clipboard sentinel written (menu copy path)')
+    return true
+  } catch (error) {
+    debugLogger.warn(
+      SENTINEL_LOG_SOURCE,
+      `Sentinel write failed: ${error instanceof Error ? error.message : String(error)}`,
+    )
+    return false
+  }
+}
