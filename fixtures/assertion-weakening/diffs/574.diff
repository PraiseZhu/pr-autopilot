+  // 逐位相等已吸收长度/去重/集合三查:e2e-runner 的两条写入路径(scenarioOrder 直写或
+  // filter 子集)都保持原顺序,合法排列必是逐位相等;任何重排/重复/缺项都红。
+  const scenarios = manifest.selectedScenarios
+  if (scenarios.length !== scenarioOrder.length || !scenarios.every((name, index) => name === scenarioOrder[index])) {
+    errors.push('selectedScenarios 必须恰等于权威 scenarioOrder(同长度、逐位同序、无重复)')
+  }
+  // [M22 变异点:persist 钉死 "local"(删此 if → t-persist 应变绿)]
+  if (manifest.persist !== 'local') {
+    errors.push(`persist 必须恰为 "local"(收到 ${sanitizeToken(manifest.persist, 20)})`)
+  }
+  return errors
+}
+
+const childLabel = (dir, index) => dir?.label ?? dir?.expectKernel ?? `child-${index + 1}`
+
+/**
+ * 单个 child 的完整检查:定位 → shape guard → manifest 契约 → 暂存 → summarizeRun(记录级)→ 终态边界(SC-J)。
+ * 返回 { label, path, runId, manifest, ok, kind, errors, counts, records }。
+ * kind ∈ {'hard' | 'schema' | 'contract' | 'soft'}:
+ *   hard     输入边界级失败(定位/暂存/大小/symlink/路径穿越)——任何变异/降级下都必须上报;
+ *   schema   外部 manifest 结构非法(D2)——aggregate 层抛 AggregateInputError(exit 2);
+ *   contract P0 契约失败(topology/rendererModes/kernelModes/selectedScenarios/persist
+ *             谎报)——与 hard 同级始终上报,不可被 R9 pass-through 变异遮蔽
+ *             (变异隔离:契约规则由 M18-M24 各自捕获,M9 只能影响记录级 soft);
