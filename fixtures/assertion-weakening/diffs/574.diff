+/** 单条路径的安全检查:不存在 / 是 symlink / 不是普通文件 → 返回错误文案,合法返回 null。 */
+const inspectFile = (path, kind) => {
+  if (!existsSync(path)) return `${kind} 不存在`
+  try {
+    // [M11 变异点:symlink 拒绝规则(改条件为 false → t-symlink 应变绿)]
+    if (lstatSync(path).isSymbolicLink()) return `${kind} 是 symlink(拒绝读取)`
+    if (!statSync(path).isFile()) return `${kind} 不是普通文件(拒绝读取)`
+  } catch {
+    return `${kind} 不可访问`
+  }
+  return null
+}
+
+const isPlainObject = (value) => typeof value === 'object' && value !== null && !Array.isArray(value)
+const isStringArray = (value) => Array.isArray(value) && value.every((item) => typeof item === 'string')
+
+/**
+ * 外部 manifest 的 shape guard(D2):业务逻辑(重算/求交/遍历)之前先验结构,
+ * 任何形状违规 → 结构化 schema 错误(kind:'schema' → CLI exit 2),禁止 TypeError
+ * 崩溃。只报"哪个字段是什么类型",不携带外部输入内容(D4)。
+ */
+// [M25 变异点:manifest shape guard(删此调用 → t-shape-* / t-cli-shape 应变红)]
+const validateManifestShape = (manifest) => {
+  if (!isPlainObject(manifest)) return 'manifest 必须是 JSON 对象'
+  if (typeof manifest.schemaVersion !== 'string' || manifest.schemaVersion.length === 0) return 'manifest.schemaVersion 必须是非空字符串'
+  if (typeof manifest.headSha !== 'string' || manifest.headSha.length === 0) return 'manifest.headSha 必须是非空字符串'
+  if (typeof manifest.topology !== 'string') return 'manifest.topology 必须是字符串'
+  if (typeof manifest.persist !== 'string') return 'manifest.persist 必须是字符串'
+  if (!isStringArray(manifest.kernelModes)) return 'manifest.kernelModes 必须是字符串数组'
+  if (!isStringArray(manifest.rendererModes)) return 'manifest.rendererModes 必须是字符串数组'
+  if (!isStringArray(manifest.selectedScenarios)) return 'manifest.selectedScenarios 必须是字符串数组'
+  if (
+    !Array.isArray(manifest.expectedCells) ||
+    !manifest.expectedCells.every(
+      (cell) => isPlainObject(cell) &&
+        typeof cell.scenario === 'string' && typeof cell.renderer === 'string' &&
+        typeof cell.kernel === 'string' && typeof cell.topology === 'string',
+    )
+  ) {
+    return 'manifest.expectedCells 必须是 {scenario,renderer,kernel,topology} 字符串字段的对象数组'
+  }
+  return null
+}
+
+/**
+ * 在下载目录内显式定位 run(SC-H/SC-I/D6 canonical 布局)。返回
+ * { runId, manifest, manifestFile, ledgerFile } 或 { error, kind? }。
+ * kind='schema' → 结构非法(exit 2);无 kind → 输入边界失败(exit 1)。
+ * 绝不读 LATEST、绝不递归下探、绝不解析 manifest 之外的任何文件内容。
+ */
+const locateRun = (dir) => {
+  if (!existsSync(dir)) return { error: '下载目录不存在' }
+  try {
+    if (lstatSync(dir).isSymbolicLink()) return { error: '下载目录是 symlink(拒绝读取)' }
+    if (!statSync(dir).isDirectory()) return { error: '下载目录不是目录' }
+  } catch {
+    return { error: '下载目录不可访问' }
+  }
+
+  let entries
+  try {
+    entries = readdirSync(dir)
+  } catch {
+    return { error: '下载目录不可读' }
+  }
+  if (entries.length > MAX_TOP_ENTRIES) return { error: `下载目录条目过多(>${MAX_TOP_ENTRIES})` }
+
+  // canonical 布局:manifest.json 必须直接在根。不做递归下探(D6)。
+  if (!entries.includes('manifest.json')) {
+    if (entries.includes('ledger.jsonl')) return { error: '有 ledger 无 manifest(打包不完整;canonical 布局要求 manifest.json 与 ledger.jsonl 都在下载目录根)' }
