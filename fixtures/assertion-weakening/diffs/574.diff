+++ b/src/lib/imageClipboardGeometry.test.ts
@@ -0,0 +1,324 @@
+// Copy as PNG 的几何契约。
+//
+// 为什么几何要单测:jsdom 没有真 canvas / toBlob(src/main.tsx:46),几何若不抽成
+// 纯函数就只能靠 e2e 证。这里钉的是"取哪块源像素、产物多大、每张画在哪";
+// "画出来的像素对不对"由 e2e 采样证,两层分工不重叠。
+//
+// 覆盖:SC-A3(crop×flip×rotate 叠加)、SC-A4(零变换时口径不变)、
+//      SC-B2(绘制顺序)、SC-B5(超预算时产物尺寸继续超标,交给调用方闸报错)。
+
+import { describe, expect, it } from 'vitest'
+import {
+  CANVAS_MAX_BITMAP_SIDE,
+  MULTI_IMAGE_MAX_SCALE,
+  nodeGeometryOf,
+  normalizeRotation,
+  planImageNodeRaster,
+  planMultiImageComposite,
+  rotatedBoundsOf,
+} from './imageClipboardGeometry'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+const imageNode = (over: Partial<MivoCanvasNode> = {}): MivoCanvasNode =>
+  ({
+    id: over.id || 'img',
+    title: over.id || 'img',
+    type: 'image',
+    assetUrl: 'asset://x',
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 100,
+    status: 'ready',
+    ...over,
+  }) as MivoCanvasNode
+
+const natural = { width: 400, height: 300 }
+
+describe('normalizeRotation', () => {
+  it('归一化到 [0,360),负角与超圈都收', () => {
+    expect(normalizeRotation(0)).toBe(0)
+    expect(normalizeRotation(90)).toBe(90)
+    expect(normalizeRotation(360)).toBe(0)
+    expect(normalizeRotation(450)).toBe(90)
+    expect(normalizeRotation(-90)).toBe(270)
+    expect(normalizeRotation(-450)).toBe(270)
+  })
+
+  it('非有限值回落 0(不让 NaN 传进 canvas 变换)', () => {
+    expect(normalizeRotation(Number.NaN)).toBe(0)
+    expect(normalizeRotation(Number.POSITIVE_INFINITY)).toBe(0)
+  })
+})
+
+describe('rotatedBoundsOf', () => {
+  it('90 的倍数走整数快路径:0/180 原样,90/270 宽高互换', () => {
+    expect(rotatedBoundsOf(400, 300, 0)).toEqual({ width: 400, height: 300 })
+    expect(rotatedBoundsOf(400, 300, 180)).toEqual({ width: 400, height: 300 })
+    expect(rotatedBoundsOf(400, 300, 90)).toEqual({ width: 300, height: 400 })
+    expect(rotatedBoundsOf(400, 300, 270)).toEqual({ width: 300, height: 400 })
+  })
+
+  it('90 倍数不引入浮点误差(通用公式会算出 300.00000000000006 之类)', () => {
+    const bounds = rotatedBoundsOf(400, 300, 90)
+    expect(Number.isInteger(bounds.width)).toBe(true)
+    expect(Number.isInteger(bounds.height)).toBe(true)
+  })
+
+  it('非 90 倍数走通用包围盒(比原尺寸大,含透明边角)', () => {
+    const bounds = rotatedBoundsOf(100, 100, 45)
+    expect(bounds.width).toBeCloseTo(Math.SQRT2 * 100, 6)
+    expect(bounds.height).toBeCloseTo(Math.SQRT2 * 100, 6)
+  })
+})
+
+describe('产物尺寸用 ceil 不用 round(否则裁掉旋转后的外沿)', () => {
+  it('45° 的 100×100 产物 ≥ 理论 AABB,不是被 round 砍成 141', () => {
+    const plan = planImageNodeRaster(
+      imageNode({ transform: { x: 0, y: 0, width: 100, height: 100, rotation: 45 } }),
+      { width: 100, height: 100 },
+    )
+    const exact = Math.SQRT2 * 100 // 141.42…
+    expect(plan.output.width).toBe(Math.ceil(exact)) // 142
+    expect(plan.output.width).toBeGreaterThanOrEqual(exact)
+    expect(plan.output.height).toBeGreaterThanOrEqual(exact)
+  })
+
+  it('90 的倍数下 ceil === round,零变换路径的整数口径不受影响', () => {
+    const plan = planImageNodeRaster(imageNode(), natural)
+    expect(plan.output).toEqual({ width: 400, height: 300 })
+    const rotated = planImageNodeRaster(
+      imageNode({ transform: { x: 0, y: 0, width: 100, height: 100, rotation: 90 } }),
+      natural,
+    )
+    expect(rotated.output).toEqual({ width: 300, height: 400 })
+  })
+})
+
+describe('nodeGeometryOf', () => {
+  it('transform 优先', () => {
+    const node = imageNode({ transform: { x: 5, y: 6, width: 7, height: 8, rotation: 90 } })
+    expect(nodeGeometryOf(node)).toEqual({ x: 5, y: 6, width: 7, height: 8, rotation: 90 })
+  })
+
+  it('transform 缺失时回落扁平字段 + rotation 0(同渲染层 transformOf)', () => {
+    const node = imageNode({ x: 1, y: 2, width: 3, height: 4 })
+    expect(nodeGeometryOf(node)).toEqual({ x: 1, y: 2, width: 3, height: 4, rotation: 0 })
+  })
+})
+
+describe('planImageNodeRaster(单图)', () => {
+  it('SC-A4 无裁剪/无旋转/无镜像 → 产物 = 整张源图,口径与抽出前一致', () => {
+    const plan = planImageNodeRaster(imageNode(), natural)
+    expect(plan.source).toEqual({ x: 0, y: 0, width: 400, height: 300 })
+    expect(plan.draw).toEqual({ width: 400, height: 300 })
+    expect(plan.output).toEqual({ width: 400, height: 300 })
+    expect(plan.rotation).toBe(0)
+    expect(plan.flipH).toBe(false)
+    expect(plan.flipV).toBe(false)
+  })
+
+  it('imageCrop 在源空间取矩形,产物 = 裁剪区的源像素数(不是显示尺寸)', () => {
+    const plan = planImageNodeRaster(
+      imageNode({ width: 50, height: 50, imageCrop: { x: 0.25, y: 0.5, width: 0.5, height: 0.5 } }),
+      natural,
+    )
+    expect(plan.source).toEqual({ x: 100, y: 150, width: 200, height: 150 })
+    // 显示尺寸 50×50 不参与:产物仍是 200×150 源像素。
+    expect(plan.output).toEqual({ width: 200, height: 150 })
+  })
+
+  it('旋转 90/270 → 产物宽高互换;180 → 不变', () => {
+    const rotated = (rotation: number) =>
+      planImageNodeRaster(imageNode({ transform: { x: 0, y: 0, width: 100, height: 100, rotation } }), natural)
+    expect(rotated(90).output).toEqual({ width: 300, height: 400 })
+    expect(rotated(270).output).toEqual({ width: 300, height: 400 })
+    expect(rotated(180).output).toEqual({ width: 400, height: 300 })
+    // draw(旋转前的绘制尺寸)始终是源裁剪尺寸,旋转只改产物画布。
+    expect(rotated(90).draw).toEqual({ width: 400, height: 300 })
+  })
+
+  it('镜像标记原样透出(作用在裁剪后的窗口整体上)', () => {
+    const plan = planImageNodeRaster(imageNode({ imageFlipH: true, imageFlipV: true }), natural)
+    expect(plan.flipH).toBe(true)
+    expect(plan.flipV).toBe(true)
+    // 镜像不改产物尺寸。
+    expect(plan.output).toEqual({ width: 400, height: 300 })
+  })
+
+  it('SC-A3 crop + flip + rotate 三者叠加:各自互不污染', () => {
+    const plan = planImageNodeRaster(
+      imageNode({
+        transform: { x: 0, y: 0, width: 100, height: 100, rotation: 90 },
+        imageCrop: { x: 0, y: 0, width: 0.5, height: 1 },
+        imageFlipH: true,
+      }),
+      natural,
+    )
+    expect(plan.source).toEqual({ x: 0, y: 0, width: 200, height: 300 })
+    expect(plan.draw).toEqual({ width: 200, height: 300 })
+    expect(plan.output).toEqual({ width: 300, height: 200 })
+    expect(plan.rotation).toBe(90)
+    expect(plan.flipH).toBe(true)
+    expect(plan.flipV).toBe(false)
+  })
+
+  it('退化裁剪不产出 0 尺寸画布(canvas 宽高为 0 会让 toBlob 回 null)', () => {
+    const plan = planImageNodeRaster(imageNode({ imageCrop: { x: 0, y: 0, width: 0, height: 0 } }), natural)
+    expect(plan.output.width).toBeGreaterThanOrEqual(1)
+    expect(plan.output.height).toBeGreaterThanOrEqual(1)
+  })
+})
+
+describe('planMultiImageComposite(多图合成)', () => {
+  const entry = (node: MivoCanvasNode, size = natural) => ({ node, natural: size })
+
+  it('并集包围盒 = 选区外接矩形,相对位置按画布保持', () => {
+    const plan = planMultiImageComposite([
+      entry(imageNode({ id: 'a', x: 0, y: 0, width: 100, height: 100 }), { width: 100, height: 100 }),
+      entry(imageNode({ id: 'b', x: 200, y: 50, width: 100, height: 100 }), { width: 100, height: 100 }),
+    ])
+    // union = x 0..300, y 0..150;两张都是 1:1,scale 保持 1。
+    expect(plan.scale).toBe(1)
+    expect(plan.output).toEqual({ width: 300, height: 150 })
+    expect(plan.placements.map((p) => p.center)).toEqual([
+      { x: 50, y: 50 },
+      { x: 250, y: 100 },
+    ])
+  })
+
+  it('SC-B2 placements 顺序 = 传入顺序(调用方传图层顺序 → 上层后画压住下层)', () => {
+    const plan = planMultiImageComposite([
+      entry(imageNode({ id: 'bottom' }), { width: 100, height: 100 }),
+      entry(imageNode({ id: 'middle' }), { width: 100, height: 100 }),
+      entry(imageNode({ id: 'top' }), { width: 100, height: 100 }),
+    ])
+    expect(plan.placements.map((p) => p.nodeId)).toEqual(['bottom', 'middle', 'top'])
+  })
+
+  it('旋转节点的包围盒按旋转后算(90° 的节点会顶出未旋转矩形之外)', () => {
+    const plan = planMultiImageComposite([
+      entry(
+        imageNode({ id: 'a', transform: { x: 0, y: 0, width: 200, height: 100, rotation: 90 } }),
+        { width: 200, height: 100 },
+      ),
+    ])
+    // 200×100 绕中心转 90° → 包围盒 100×200,中心不动(100,50)。
+    expect(plan.output).toEqual({ width: 100, height: 200 })
+    expect(plan.placements[0].center).toEqual({ x: 50, y: 100 })
+    expect(plan.placements[0].rotation).toBe(90)
+  })
+
+  it('scale 朝"最高清那张不降采样"取,封顶 MULTI_IMAGE_MAX_SCALE', () => {
+    // 源 800×800 塞进 100×100 的框 → nativeRatio 8,封顶 4。
+    const plan = planMultiImageComposite([
+      entry(imageNode({ id: 'a', width: 100, height: 100 }), { width: 800, height: 800 }),
+    ])
+    expect(plan.scale).toBe(MULTI_IMAGE_MAX_SCALE)
+    expect(plan.output).toEqual({ width: 400, height: 400 })
+  })
+
+  it('全是 1:1 时 scale 保持 1,不无谓放大', () => {
+    const plan = planMultiImageComposite([
+      entry(imageNode({ id: 'a', width: 100, height: 100 }), { width: 100, height: 100 }),
+      entry(imageNode({ id: 'b', x: 100, width: 100, height: 100 }), { width: 100, height: 100 }),
+    ])
+    expect(plan.scale).toBe(1)
+  })
+
+  it('裁剪后的源像素才算 nativeRatio(裁掉一半就只剩一半分辨率)', () => {
+    const plan = planMultiImageComposite([
+      entry(
+        imageNode({ id: 'a', width: 100, height: 100, imageCrop: { x: 0, y: 0, width: 0.5, height: 0.5 } }),
+        { width: 400, height: 400 },
+      ),
+    ])
+    // 裁剪后源 200×200 进 100×100 → ratio 2。
+    expect(plan.scale).toBe(2)
+  })
+
+  it('像素预算内回退 scale,但不低于 1(基线以下不静默降级)', () => {
+    // union 1000×1000 = 100 万像素;预算 400 万 → 允许 scale 2,而非封顶 4。
+    const plan = planMultiImageComposite(
+      [entry(imageNode({ id: 'a', width: 1000, height: 1000 }), { width: 8000, height: 8000 })],
+      { maxPixels: 4_000_000 },
+    )
+    expect(plan.scale).toBeCloseTo(2, 6)
+    expect(plan.output).toEqual({ width: 2000, height: 2000 })
+  })
+
+  it('SC-B5 连 1:1 都放不下时,scale 停在 1 且产物尺寸继续超标 —— 交给调用方的预算闸报错', () => {
+    const plan = planMultiImageComposite(
+      [entry(imageNode({ id: 'a', width: 10_000, height: 10_000 }), { width: 100, height: 100 })],
+      { maxPixels: 4_000_000 },
+    )
+    expect(plan.scale).toBe(1)
+    expect(plan.output.width * plan.output.height).toBeGreaterThan(4_000_000)
+  })
+
+  it('单边闸:面积够小但放大后单边超限时按单边回退(面积闸拦不住这条)', () => {
+    // union 20000×100 = 200 万像素,面积闸怎么放大都不会碰上限;但源图高清会把
+    // scale 顶到 4 → 80000 宽,越过 Chromium 单边上限(实测 65536 起 toBlob 回 null)。
+    const plan = planMultiImageComposite(
+      [
+        entry(imageNode({ id: 'a', x: 0, y: 0, width: 100, height: 100 }), { width: 800, height: 800 }),
+        entry(imageNode({ id: 'b', x: 19_900, y: 0, width: 100, height: 100 }), { width: 800, height: 800 }),
+      ],
+      { maxPixels: 40_000_000, maxSide: CANVAS_MAX_BITMAP_SIDE },
+    )
+    expect(plan.scale).toBeLessThan(MULTI_IMAGE_MAX_SCALE) // 被单边闸压下来了
+    expect(plan.scale).toBeGreaterThan(1) // 但没白退到基线
+    expect(plan.output.width).toBeLessThanOrEqual(CANVAS_MAX_BITMAP_SIDE)
+    expect(plan.output.height).toBeLessThanOrEqual(CANVAS_MAX_BITMAP_SIDE)
+  })
+
+  it('跨度本身就超单边时停在 scale=1,交给调用方 fail-visible(不静默降到 1 以下)', () => {
+    // 两张 100×100 纵向隔开 20 万单位:union 高 20 万,scale 降到 1 也救不了 ——
+    // 再降就是相对"所见"的静默降采样,那条线不许跨,让调用方报错。
+    const plan = planMultiImageComposite(
+      [
+        entry(imageNode({ id: 'a', x: 0, y: 0, width: 100, height: 100 }), { width: 100, height: 100 }),
+        entry(imageNode({ id: 'b', x: 0, y: 200_000, width: 100, height: 100 }), { width: 100, height: 100 }),
+      ],
+      { maxPixels: 40_000_000, maxSide: CANVAS_MAX_BITMAP_SIDE },
+    )
+    expect(plan.scale).toBe(1)
+    expect(plan.output.height).toBeGreaterThan(CANVAS_MAX_BITMAP_SIDE)
+  })
+
+  it('取整后不得把面积推回上限之上 —— 存在 >1 的合法 scale 就不许误拒', () => {
+    // 反例来自审核:连续解 scale≈1.15297,round 后 116×345892 = 40,123,472 > 4000 万。
+    // 迭代收敛必须把它压到真正装得下,且仍 >1(没有退到基线)。
+    const plan = planMultiImageComposite(
+      [
+        entry(imageNode({ id: 'a', x: 0, y: 0, width: 100.3, height: 100 }), { width: 800, height: 800 }),
+        entry(imageNode({ id: 'b', x: 0, y: 299_900.3, width: 100.3, height: 100 }), { width: 800, height: 800 }),
+      ],
+      { maxPixels: 40_000_000 },
+    )
+    expect(plan.output.width * plan.output.height).toBeLessThanOrEqual(40_000_000)
+    expect(plan.scale).toBeGreaterThan(1)
+  })
+
+  it('收敛失败时落回 scale=1,不留"既没装下、scale 又 >1"的第三态', () => {
+    // 审核给出的可复现输入:极端长宽比 + 只给面积闸,连续解算 8 轮压不进预算。
+    // 契约是"要么装得下,要么 scale===1",不许返回一个既超标又自称放大过的计划。
+    const plan = planMultiImageComposite(
+      [
+        {
+          node: imageNode({ id: 'a', transform: { x: 0, y: 0, width: 1, height: 20_000_000, rotation: 0 } }),
+          natural: { width: 4, height: 80_000_000 },
+        },
+      ],
+      { maxPixels: 40_000_000 },
+    )
+    const fits = plan.output.width * plan.output.height <= 40_000_000
+    expect(fits || plan.scale === 1).toBe(true)
+  })
+
+  it('空选区返回 1×1 空计划,不产出 0 尺寸画布', () => {
+    const plan = planMultiImageComposite([])
+    expect(plan.placements).toEqual([])
+    expect(plan.output).toEqual({ width: 1, height: 1 })
+  })
+})
