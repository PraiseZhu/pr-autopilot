+  })
+
+  it('t-scenarios-order: selectedScenarios 合法排列(首尾互换,同集合)→ 红(M27 预测红集 {t-scenarios-order})', () => {
+    // 只换顺序不换集合:旧实现(只查长度+集合+去重)会绿,逐位相等才拦得住——本用例
