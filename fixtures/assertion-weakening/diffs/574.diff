+    const nested = entries.filter((name) => SAFE_NAME.test(name) && existsSync(join(dir, name, 'manifest.json')))
+    if (nested.length > 0) {
+      return {
+        error: `未找到 manifest.json(canonical 布局:manifest.json 必须直接在下载目录根;提示:在 ${nested.slice(0, 3).map((name) => sanitizeToken(name, 40)).join(', ')}${nested.length > 3 ? ` 等 ${nested.length} 个子目录` : ''} 找到 manifest.json——若 artifact 解压产物包了一层 runId 子目录,请把 --dir 指向该子目录;校验器不读 LATEST,不做递归下探)`,
+      }
+    }
+    return { error: '未找到 manifest.json(canonical 布局:manifest.json 与 ledger.jsonl 必须直接在下载目录根;校验器不读 LATEST,不做递归下探)' }
+  }
+
+  const manifestFile = join(dir, 'manifest.json')
+  const fileError = inspectFile(manifestFile, 'manifest.json')
+  if (fileError) return { error: fileError }
+  // 先按 stat 大小上限拦截,再读文件(bounded JSON:不把超大文件整体读进内存)。
+  let stat
+  try {
+    stat = statSync(manifestFile)
+  } catch {
+    return { error: 'manifest.json 不可访问' }
+  }
+  // [M13 变异点:manifest 大小上限规则(改条件为 false → t-big-manifest 应变绿)]
+  if (stat.size > MAX_MANIFEST_BYTES) {
+    return { error: `manifest.json 超过大小上限(${MAX_MANIFEST_BYTES} bytes)` }
+  }
+  let raw
+  try {
+    raw = readFileSync(manifestFile, 'utf8')
+  } catch {
+    return { error: 'manifest.json 不可读' }
+  }
+  let manifest
+  try {
+    manifest = JSON.parse(raw)
+  } catch {
+    // 不携带 err.message:JSON.parse 的错误信息会回显输入内容片段(SC-L)。
+    return { error: 'manifest JSON 解析失败(定位 runId;内容已省略)' }
+  }
+  const runId = manifest?.runId
+  // [M12 变异点:runId 白名单/路径穿越拒绝规则(改条件为 false → t-traversal/t-ctl-runid 应变绿)]
+  if (typeof runId !== 'string' || !SAFE_NAME.test(runId)) {
+    return { error: `manifest.runId 非法:${sanitizeToken(runId, 60)}(白名单外字符或疑似路径穿越)` }
+  }
+  const shapeError = validateManifestShape(manifest)
+  if (shapeError) return { error: shapeError, kind: 'schema' }
+  return { runId, manifest, manifestFile, ledgerFile: join(dir, 'ledger.jsonl') }
+}
+
+/** 把下载目录里的 manifest/ledger 暂存进本仓 test-artifacts/e2e-runs/<runId>/,让 summarizeRun 能以真实路径读到。 */
+const stageChildRun = (runId, manifestFile, ledgerFile) => {
+  const target = runDir(runId)
+  if (existsSync(target)) {
+    // runId 已过 SAFE_NAME 白名单,是可回显的安全 token;完整路径不回显(D4)。
+    return { error: `暂存目标已存在(runId=${runId},疑似 runId 冲突,拒绝覆盖)` }
+  }
+  try {
+    mkdirSync(target, { recursive: true })
+    copyFileSync(manifestFile, manifestPath(runId))
+    if (existsSync(ledgerFile)) {
+      const ledgerError = inspectFile(ledgerFile, 'ledger.jsonl')
+      if (ledgerError) throw new Error(ledgerError)
+      const stat = statSync(ledgerFile)
+      // [M13 变异点:ledger 大小上限规则(改条件为 false → t-big-ledger 应变绿)]
+      if (stat.size > MAX_LEDGER_BYTES) throw new Error(`ledger.jsonl 超过大小上限(${MAX_LEDGER_BYTES} bytes)`)
+      copyFileSync(ledgerFile, ledgerPath(runId))
+    }
+  } catch (err) {
+    // 已建目录/已复制 manifest 也要清干净:半成品暂存目录不得残留(测试变异循环
+    // 实测发现漏清,t-big-ledger 每次跑都留一个只有 manifest 的空壳目录)。
+    try {
+      rmSync(target, { recursive: true, force: true })
+    } catch {
+      // 清理失败不吞判定,继续上报。
+    }
+    return { error: err instanceof Error && err.message.startsWith('ledger') ? err.message : '暂存失败(内容已省略)' }
+  }
+  return { target }
+}
+
+/** SC-D:从权威 scenarioOrder + manifest 的 modes 重算 expectedCells 笛卡尔积(不信任 manifest.expectedCells)。 */
+const recomputeExpectedCells = (manifest) => {
+  const cells = []
+  for (const kernel of manifest.kernelModes) {
+    for (const renderer of manifest.rendererModes) {
+      for (const scenario of scenarioOrder) {
+        cells.push(cellKey({ scenario, renderer, kernel, topology: manifest.topology }))
+      }
+    }
+  }
+  return new Set(cells)
+}
+
+/** SC-C:期望 N_A 集合 = leaferSkippedScenarios × (rendererModes∩{leafer}) × kernelModes × topology,从代码与 manifest 派生,禁止写死。 */
+const deriveNaCells = (manifest) => {
+  const skips = Object.keys(leaferSkippedScenarios).filter((name) => manifest.selectedScenarios.includes(name))
+  const cells = []
+  for (const scenario of skips) {
+    for (const kernel of manifest.kernelModes) {
+      for (const renderer of manifest.rendererModes) {
+        if (renderer === 'leafer') cells.push(cellKey({ scenario, renderer, kernel, topology: manifest.topology }))
+      }
+    }
+  }
+  return new Set(cells)
+}
