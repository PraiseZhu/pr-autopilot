+    // t-ledger-null-row 应变红为 exit 1→exit 3)]
+    // 坏输入(合法 JSON 但非对象行,如 null)会让 summarizeRun 内部 TypeError,若一路穿到
+    // CLI 被映射成 exit 3,就把"数据不合法"伪装成"校验器内部错误",带偏排查方向。
+    // 这里转成结构化 child hard 错误,CLI 退 1;不回显任何外部输入内容(D4),只给类别诊断。
+    // 注:primitive 行(123/true/"str")不抛——属性访问返回 undefined,走记录级
+    // "runId 不符"路径(soft),本就 exit 1,只有 null 这类会抛的形态需要此 catch。
+    return {
+      label,
+      path,
+      runId,
+      manifest,
+      ok: false,
+      kind: 'hard',
+      errors: ['ledger 记录级校验抛出异常(疑似非对象行,如 null/primitive JSON)'],
+      counts: null,
+      records: [],
+    }
+  } finally {
+    try {
+      rmSync(runDir(runId), { recursive: true, force: true })
+    } catch (cleanupErr) {
+      // 清理失败不吞判定,但也不再静默(F5):CI 单次执行下残留无害(gitignore 的临时产物),
+      // 但会让后续同 runId 调用撞上 stageChildRun 的"暂存目标已存在"拒绝。只带 runId
+      // 不带完整路径(D4);不改退出码、不影响判定——只是从静默变成可见。
+      console.warn(`[ledger-aggregate] 清理暂存目录失败(runId=${sanitizeToken(runId, 24)}),后续同 runId 调用可能撞上暂存冲突`)
+    }
+  }
+  const errors = sanitizeChildErrors(runId, summary.errors)
+  // SC-J 终态边界(记录级已拦 evidenceMissing/未知 status,这里补 FAIL/RETRY_PASS):
+  // 只点名格与状态,不打印 message/pageErrors 等正文(SC-L bounded 诊断)。
+  // [M8 变异点:终态 FAIL/RETRY_PASS 规则]
+  const badTerminals = summary.records.filter((record) => record.status === 'FAIL' || record.status === 'RETRY_PASS')
+  if (badTerminals.length > 0) {
+    const names = badTerminals.slice(0, 20).map((record) => `${record.status}:${sanitizeToken(record.name, 80)}`)
+    const more = badTerminals.length > 20 ? ` +${badTerminals.length - 20} 更多` : ''
+    errors.push(`终态含 ${badTerminals.length} 个非绿格:${names.join(', ')}${more}`)
+  }
+  const boundedErrors = errors.slice(0, MAX_ERRORS_PER_CHILD)
+  if (errors.length > MAX_ERRORS_PER_CHILD) {
+    boundedErrors.push(`…另有 ${errors.length - MAX_ERRORS_PER_CHILD} 条问题(已截断)`)
+  }
