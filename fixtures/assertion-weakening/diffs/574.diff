+//                                          (null 行使 summarizeRun 内部 TypeError,删 catch
+//                                          后穿到 CLI 变 exit 3;primitive 行不抛——属性
+//                                          访问返回 undefined,走记录级 runId 不符路径,
+//                                          本就不 exit 3,t-ledger-primitive-row 为行为锚点)
+//
+//   M3/M4 已随 P0 修复删除:旧 kernel 并集与 topology 相等规则被"每 child 钉死"
+//   规则(M18/M20/M24)吸收;M17(禁读 LATEST)已随 D6 canonical 布局收敛删除——
+//   canonical 布局不扫描目录条目,LATEST 天然不可读;t-no-latest-env 保留为
+//   行为测试(毒化 LATEST 不影响结果),无独立变异点。
+import { afterEach, describe, expect, it } from 'vitest'
+import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { spawn } from 'node:child_process'
+import { fileURLToPath } from 'node:url'
+import os from 'node:os'
+import { cellKey, runDir } from './result-ledger.mjs'
+import { AggregateInputError, aggregateLedgers } from './ledger-aggregate.mjs'
+import { leaferSkippedScenarios, scenarioOrder } from './scenarios/index.mjs'
+
+const REPO_ROOT = fileURLToPath(new URL('../..', import.meta.url))
+
+// 真实矩阵总格数由 scenarioOrder 派生,不再在 20 处硬编码。
+const MATRIX_TOTAL = scenarioOrder.length * 4
+
+// ---------------------------------------------------------------------------
+// fixture 构造(canonical 布局:manifest.json + ledger.jsonl 直接在下载目录根)
+// ---------------------------------------------------------------------------
+
+const cleanedTmpRoots = []
+const cleanedStagedRuns = []
+afterEach(() => {
+  for (const root of cleanedTmpRoots) {
+    try {
+      rmSync(root, { recursive: true, force: true })
+    } catch {}
+  }
+  cleanedTmpRoots.length = 0
+  for (const runId of cleanedStagedRuns) {
+    try {
+      rmSync(runDir(runId), { recursive: true, force: true })
+    } catch {}
+  }
+  cleanedStagedRuns.length = 0
+})
+
+let fixtureSeq = 0
+const nextRunId = (kernel) => `agg-${kernel}-${process.pid}-${fixtureSeq += 1}`
+
+const makeCells = (kernel, renderers, scenarios, topology) => {
+  const cells = []
+  for (const renderer of renderers) {
+    for (const scenario of scenarios) {
+      cells.push({ scenario, renderer, kernel, topology })
+    }
+  }
+  return cells
+}
+
+const cellStatus = (cell) => (leaferSkippedScenarios[cell.scenario] && cell.renderer === 'leafer' ? 'N_A' : 'PASS')
+
+const makeRecord = ({ runId, cell, headSha, status, overrides = {} }) => ({
+  runId,
+  schemaVersion: '1',
+  name: cellKey(cell),
+  scenario: cell.scenario,
+  renderer: cell.renderer,
+  kernel: cell.kernel,
+  topology: cell.topology,
+  status: status ?? cellStatus(cell),
+  durationMs: 100,
+  flaky: false,
+  retries: 0,
+  evidenceMissing: false,
+  retryAttempts: [],
+  message: null,
+  headSha,
+  diagnostics: { pageErrors: [] },
+  ...overrides,
+})
+
+/**
+ * 构造一个完整 child 下载目录(canonical 布局 A:manifest.json + ledger.jsonl
+ * 直接在该目录根)。fixture 数据从 scenarioOrder/leaferSkippedScenarios 动态派生
+ * (SC-C:期望 N_A 数随 skip 名单变化,测试套件不写死 2)。返回
+ * { dir, runId, manifest, records }。
+ */
+const buildChild = ({ kernel, headSha = 'abc1234', topology = 'prod', scenarios = scenarioOrder, runIdOverride = null, manifestOverrides = {}, ledgerOverrides = [] }) => {
+  const root = mkdtempSync(join(os.tmpdir(), 'agg-fixture-'))
+  cleanedTmpRoots.push(root)
+  const runId = runIdOverride ?? nextRunId(kernel)
+  const renderers = ['dom', 'leafer']
+  const expectedCells = makeCells(kernel, renderers, scenarios, topology)
+  const manifest = {
+    runId,
+    schemaVersion: '1',
+    headSha,
+    topology,
+    persist: 'local',
+    kernelModes: [kernel],
+    rendererModes: renderers,
+    selectedScenarios: scenarios,
+    expectedCells,
+    recordedAt: new Date(0).toISOString(),
+    ...manifestOverrides,
+  }
+  const records = expectedCells.map((cell) => makeRecord({ runId, cell, headSha }))
+  for (const override of ledgerOverrides) records.push(override)
+  writeFileSync(join(root, 'manifest.json'), JSON.stringify(manifest))
+  writeFileSync(join(root, 'ledger.jsonl'), `${records.map((record) => JSON.stringify(record)).join('\n')}\n`)
+  return { dir: root, runId, manifest, records }
+}
+
+const rewriteLedger = (dir, records) => {
+  writeFileSync(join(dir, 'ledger.jsonl'), `${records.map((record) => JSON.stringify(record)).join('\n')}\n`)
+}
+
+const runAggregate = ({ a, b, expectTotal = MATRIX_TOTAL }) =>
+  aggregateLedgers({
+    dirs: [
+      { path: a.dir, label: 'child-1', expectKernel: 'legacy' },
+      { path: b.dir, label: 'child-2', expectKernel: 'new' },
+    ],
+    expectTotal,
+  })
+
+const runCli = (args) =>
+  new Promise((resolvePromise) => {
+    const script = fileURLToPath(new URL('./ledger-aggregate.mjs', import.meta.url))
+    const child = spawn(process.execPath, [script, ...args], { cwd: REPO_ROOT })
+    let stdout = ''
+    let stderr = ''
+    child.stdout.on('data', (chunk) => { stdout += chunk })
+    child.stderr.on('data', (chunk) => { stderr += chunk })
+    child.on('close', (code) => resolvePromise({ code, stdout, stderr }))
+  })
+
+// ---------------------------------------------------------------------------
+// 正向路径
+// ---------------------------------------------------------------------------
+
+describe('ledger-aggregate — 正常路径', () => {
+  it('CLEAN: 双 child 各 74 格(73 PASS + 1 N_A),合计 148 → ok=true', () => {
+    // 漂移哨兵:场景增删时这一条先红,提醒同步更新
+    // .github/workflows/nightly-e2e.yml 的 --expect-total 字面量。
+    expect(scenarioOrder.length).toBe(37)
+    const a = buildChild({ kernel: 'legacy' })
+    const b = buildChild({ kernel: 'new' })
+    const result = runAggregate({ a, b })
+    expect(result.ok).toBe(true)
+    expect(result.errors).toHaveLength(0)
+    expect(result.total).toBe(MATRIX_TOTAL)
+    // N_A 恰等于派生集合:每 child 恰 |skips| 个(SC-C 动态派生,不写死 2)
+    expect(result.counts.N_A).toBe(2 * Object.keys(leaferSkippedScenarios).length)
+    expect(result.counts.PASS).toBe(MATRIX_TOTAL - result.counts.N_A)
+    expect(result.counts).toMatchObject({ RETRY_PASS: 0, FAIL: 0 })
+  })
+
+  it('SC-A: 复用 summarizeRun —— 注入非法记录,错误文案来自 summarizeRun 原文', () => {
+    const a = buildChild({ kernel: 'legacy' })
+    const b = buildChild({ kernel: 'new' })
+    const bad = makeRecord({ runId: b.runId, cell: { scenario: 'debug', renderer: 'dom', kernel: 'new', topology: 'prod' }, headSha: 'different-sha' })
+    rewriteLedger(b.dir, [bad])
+    const result = runAggregate({ a, b })
+    expect(result.ok).toBe(false)
+    // 文案是 summarizeRun 的"记录 headSha 不符",带 child 前缀点名
+    expect(result.errors.some((e) => e.includes('child-2') && e.includes('记录 headSha 不符'))).toBe(true)
+  })
+
+  it('SC-M: 源码注释与文案只声称 T1,不含更高等级措辞', async () => {
+    const { readFile } = await import('node:fs/promises')
+    const source = await readFile(fileURLToPath(new URL('./ledger-aggregate.mjs', import.meta.url)), 'utf8')
+    for (const banned of ['防伪造', '不可篡改', '防恶意', 'tamper-proof', 'forgery', '篡改']) {
+      expect(source, `源码不得出现 ${banned}`).not.toContain(banned)
