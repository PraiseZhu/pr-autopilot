+    label,
+    path,
+    runId,
+    manifest,
+    ok: summary.ok && badTerminals.length === 0,
+    kind: 'soft',
+    errors: boundedErrors,
+    counts: summary.counts,
+    records: summary.records,
+  }
+}
+
+/**
+ * 跨 child 汇总校验(SC-B..SC-F)。dirs = 恰好 2 个 { path, expectKernel, label? };
+ * expectKernel ∈ {legacy,new} 且两值各一次(D3:每 child 绑定期望 kernel);
+ * expectTotal 必填。返回 { ok, errors, children, counts, total }。
+ * fail-closed:任一 child 不 ok 即整体不 ok,child 错误原样上报(禁"可用部分先合并")。
+ * 任一 child 的 manifest 结构非法 → throw AggregateInputError(SC-F:输入类别错误)。
+ */
+export const aggregateLedgers = ({ dirs, expectTotal }) => {
+  // [M14b 变异点:函数侧必填/入参校验(删这些 throw → t-fn-throw 应变红)]
+  if (!Array.isArray(dirs) || dirs.length !== 2) {
+    throw new AggregateInputError(`需要恰好 2 个下载目录(--dir ×2),收到 ${Array.isArray(dirs) ? dirs.length : 'none'}`)
+  }
+  if (!Number.isInteger(expectTotal) || expectTotal <= 0) {
+    // 无默认值:给默认值会把"调用方漏传"从报错降级成静默改判(SC-F)。
+    throw new AggregateInputError('expectTotal 必填且必须为正整数(无默认值,漏传必须报错)')
+  }
+  for (let index = 0; index < dirs.length; index += 1) {
+    const dir = dirs[index]
+    if (dir === null || typeof dir !== 'object' || Array.isArray(dir)) {
+      throw new AggregateInputError(`第 ${index + 1} 个 --dir 项必须是非空对象(收到非对象)`)
+    }
+    if (typeof dir.path !== 'string' || dir.path.length === 0) {
+      throw new AggregateInputError(`第 ${index + 1} 个 --dir 缺 path(必须为非空字符串)`)
+    }
+    if (dir.expectKernel !== 'legacy' && dir.expectKernel !== 'new') {
+      throw new AggregateInputError(`第 ${index + 1} 个 --dir 缺 expectKernel(必须为 legacy 或 new——D3 每 child 绑定期望 kernel)`)
+    }
+    if (dir.label !== undefined && (typeof dir.label !== 'string' || dir.label.length === 0)) {
+      throw new AggregateInputError(`第 ${index + 1} 个 --dir 的 label 必须是非空字符串`)
+    }
+  }
+  if (dirs[0].expectKernel === dirs[1].expectKernel) {
+    throw new AggregateInputError('两个 --dir 的 expectKernel 必须互不相同(legacy 与 new 各一次)')
+  }
+
+  const children = dirs.map((dir, index) => inspectChild({ label: childLabel(dir, index), path: dir.path, expectKernel: dir.expectKernel }))
+  const schemaChildren = children.filter((child) => child.kind === 'schema')
+  if (schemaChildren.length > 0) {
+    throw new AggregateInputError(`manifest 结构非法:${schemaChildren.map((child) => ` ${child.label}:${child.errors[0]}`).join(';')}`)
+  }
+
+  const errors = []
+  for (const child of children) {
+    if (child.ok) continue
+    if (child.kind === 'hard' || child.kind === 'contract') {
+      // 输入边界级错误(定位/暂存/外部输入)与 P0 契约谎报:始终上报,不可被
+      // pass-through 变异遮蔽(契约规则由 M18-M24 各自捕获,M9 只影响记录级 soft)。
+      // 只输出 label + 错误,不回显原始 path(D4)。
+      for (const error of child.errors) {
+        errors.push(`${sanitizeToken(child.label, 24)}: ${error}`)
+      }
+    } else {
+      // R9(SC-A/SC-I):child 记录级校验失败必须原样上报,禁止"可用部分先合并"。
+      // —— M9 反向变异点:删除此 else 分支,所有软失败 fixture 应变绿。
+      for (const error of child.errors) {
+        errors.push(`${sanitizeToken(child.label, 24)}: ${error}`)
+      }
+    }
+  }
+
+  // 跨 child 检查只在两个 child 都通过记录级与契约校验后执行:child 本身不完整时,其
+  // 数据不可信,继续做跨 child 比较只会叠加噪音错误。
+  const bothOk = children.every((child) => child.ok)
+  if (bothOk) {
+    const [a, b] = children
+    const ma = a.manifest
+    const mb = b.manifest
+
+    // SC-B 身份绑定:headSha/schemaVersion 相等。
+    // exact(非 subset)的理由:subset 会让"两份各少 1 格但错位互补"这种形态漏过,
+    // 而身份绑定要防的正是"matrix 两份不是同一次提交/同一 schema"的整树错配。
+    // [M1 变异点:headSha 规则] [M2 变异点:schemaVersion 规则]
+    // (旧 M4 topology 相等规则已删除:P0 已把每 child topology 钉死为 "prod",
+    // 相等被更强规则吸收,见 validateChildContract。)
+    if (ma.headSha !== mb.headSha) {
+      errors.push(`跨 child 身份绑定失败: headSha 不一致(child-1=${headShaToken(ma.headSha)}, child-2=${headShaToken(mb.headSha)})`)
+    }
+    if (ma.schemaVersion !== mb.schemaVersion) {
+      errors.push(`跨 child 身份绑定失败: schemaVersion 不一致(child-1=${sanitizeToken(ma.schemaVersion, 20)}, child-2=${sanitizeToken(mb.schemaVersion, 20)})`)
+    }
+    // 旧 M3 kernel 并集规则已删除:每 child 的 kernelModes 已与 expectKernel 绑定
+    // (validateChildContract),且 dirs 入口已要求两 expectKernel 互异且恰为 {legacy,new}
+    // ——"两份都是 legacy"的 matrix 写错形态由绑定规则拦截,t-kernel 归 M24。
+
+    // SC-D:expectedCells 必须与权威重算 exact 一致(任意方向的幽灵格/缺格都红);
+    // 且 raw 数量/重复必须与重算一致——Set 会吞重复,D1:raw.length === 重算长度
+    // 且 Set(raw).size === raw.length 双断言。
+    // [M5 变异点:expectedCells 重算规则(删除本 for 块 → t-ghost/t-expectedcells-dup 应变绿)]
+    // [M23 变异点:expectedCells raw 长度/去重规则(删 rawOk 判断 → t-expectedcells-dup 应变绿)]
+    for (const child of children) {
+      const rawCells = child.manifest.expectedCells
+      const rawKeys = rawCells.map((cell) => cellKey(cell))
+      const recomputed = recomputeExpectedCells(child.manifest)
+      const rawOk = rawKeys.length === recomputed.size && new Set(rawKeys).size === rawKeys.length
+      if (!rawOk) {
+        errors.push(`${child.label}: manifest.expectedCells 数量/重复与权威重算不符(raw ${rawKeys.length} 项,重算 ${recomputed.size} 项;重复被 Set 吞并不得通过)`)
+      } else {
+        const actual = new Set(rawKeys)
+        const ghosts = [...actual].filter((key) => !recomputed.has(key))
+        const missing = [...recomputed].filter((key) => !actual.has(key))
+        if (ghosts.length > 0 || missing.length > 0) {
+          errors.push(`${child.label}: manifest.expectedCells 含幽灵格/缺格(${ghosts.slice(0, 5).map((key) => sanitizeToken(key, 60)).join(', ')}${ghosts.length > 5 ? ` +${ghosts.length - 5}` : ''}${missing.length ? ` / 缺:${missing.slice(0, 5).map((key) => sanitizeToken(key, 60)).join(', ')}` : ''})`)
+        }
+      }
+    }
+
+    // SC-C/SC-E:N_A 格必须与派生集合 exact 相等(多余/缺失都红)。
+    // [M6 变异点:N_A 派生集合规则(删除本 for 块)]
+    for (const child of children) {
+      const derived = deriveNaCells(child.manifest)
+      const observed = new Set(child.records.filter((record) => record.status === 'N_A').map((record) => record.name))
+      const extra = [...observed].filter((key) => !derived.has(key))
+      const missing = [...derived].filter((key) => !observed.has(key))
+      if (extra.length > 0 || missing.length > 0) {
+        errors.push(`${child.label}: N_A 格与派生集合不符(派生自 leaferSkippedScenarios×rendererModes∩leafer×kernelModes×topology; 多余=${extra.map((key) => sanitizeToken(key, 60)).join(',') || '无'}, 缺失=${missing.map((key) => sanitizeToken(key, 60)).join(',') || '无'})`)
+      }
+    }
+
+    // SC-E/SC-F:总数必须恰等于调用方声明的 expectTotal(矩阵漂移或 workflow 传错都红)。
+    // [M7 变异点:总数规则]
+    const mergedTotal = a.records.length + b.records.length
+    if (mergedTotal !== expectTotal) {
+      errors.push(`总格数不符: 实际 ${mergedTotal} 格,--expect-total=${expectTotal}(矩阵漂移(场景增删)或 workflow 传错)`)
+    }
+  }
+
+  const allCounts = children.map((child) => child.counts).filter(Boolean)
+  const counts = allCounts.length === 2
+    ? allCounts.reduce(
+        (acc, c) => ({ PASS: acc.PASS + c.PASS, RETRY_PASS: acc.RETRY_PASS + c.RETRY_PASS, FAIL: acc.FAIL + c.FAIL, N_A: acc.N_A + c.N_A }),
+        { PASS: 0, RETRY_PASS: 0, FAIL: 0, N_A: 0 },
+      )
+    : null
+  const total = bothOk ? children[0].records.length + children[1].records.length : null
+
+  return { ok: errors.length === 0, errors, children, counts, total }
+}
+
+const formatCliOutput = (result) => {
+  const lines = []
+  for (const child of result.children) {
+    // runId 已过 SAFE_NAME 白名单,是安全 token;path 一律不输出(D4)。
+    lines.push(`[ledger-aggregate] ${sanitizeToken(child.label, 24)}: run=${child.runId ?? '(未定位)'} ok=${child.ok}${child.counts ? ` PASS=${child.counts.PASS} RETRY_PASS=${child.counts.RETRY_PASS} FAIL=${child.counts.FAIL} N_A=${child.counts.N_A}` : ''}`)
+  }
+  if (result.counts) {
+    const { counts, total } = result
+    lines.push(`[ledger-aggregate] 合计: total=${total} PASS=${counts.PASS} RETRY_PASS=${counts.RETRY_PASS} FAIL=${counts.FAIL} N_A=${counts.N_A}`)
+  }
+  if (!result.ok) {
+    lines.push(`[ledger-aggregate] fail-closed — ${result.errors.length} 处问题:`)
+    for (const error of result.errors) lines.push(`  - ${error}`)
+    lines.push('[ledger-aggregate] 结果: fail(exit 1)')
+  } else {
+    lines.push('[ledger-aggregate] 结果: ok(exit 0)')
+  }
+  return lines.join('\n')
+}
+
+const USAGE = [
+  '用法: node scripts/e2e/ledger-aggregate.mjs --dir <kernel>=<路径> --dir <kernel>=<路径> --expect-total <正整数>',
+  '  --dir <kernel>=<路径>  恰好 2 个;kernel ∈ {legacy, new},两值各一次;',
+  '                        <路径> 是 artifact 解压目录,根必须直接含 manifest.json + ledger.jsonl',
+  '                        (canonical 布局——不要把含 runId 子目录的上级目录传进来)',
+  '  --expect-total  期望总格数(必填,无默认值)。nightly matrix = 场景数 × 2 renderer × 2 kernel',
+  '退出码: 0=通过 1=校验失败 2=用法/输入错误(含 manifest 结构非法) 3=校验器内部错误',
+].join('\n')
+
+const parseDirArg = (raw) => {
+  const eq = raw.indexOf('=')
+  if (eq <= 0) return { error: '--dir 值必须是 <kernel>=<路径>(如 --dir legacy=<路径>);kernel ∈ {legacy, new}' }
+  const kernel = raw.slice(0, eq)
+  const path = raw.slice(eq + 1)
+  if (kernel !== 'legacy' && kernel !== 'new') {
+    return { error: `--dir 的 kernel 必须是 legacy 或 new(收到 ${sanitizeToken(kernel, 20)})` }
+  }
+  if (path.length === 0) return { error: '--dir 的路径不能为空' }
+  return { path, expectKernel: kernel }
+}
+
+const parseArgs = (argv) => {
+  const dirs = []
+  let expectTotal = null
+  for (let index = 0; index < argv.length; index += 1) {
+    const arg = argv[index]
+    if (arg === '--dir') {
+      index += 1
+      if (index >= argv.length) return { error: '--dir 缺值' }
+      const parsed = parseDirArg(argv[index])
+      if (parsed.error) return parsed
+      dirs.push(parsed)
+    } else if (arg.startsWith('--dir=')) {
+      const parsed = parseDirArg(arg.slice('--dir='.length))
+      if (parsed.error) return parsed
+      dirs.push(parsed)
+    } else if (arg === '--expect-total') {
+      index += 1
+      if (index >= argv.length) return { error: '--expect-total 缺值' }
+      expectTotal = Number(argv[index])
+    } else if (arg.startsWith('--expect-total=')) {
+      expectTotal = Number(arg.slice('--expect-total='.length))
+    } else {
+      return { error: '未知参数(已拒绝,不回显)' }
+    }
+  }
+  // [M14a 变异点:CLI 侧必填/绑定校验(删这三个 return + 入口 throw 块 → 缺参/重复 kernel
+  // 走 aggregateLedgers 崩溃或 exit 1/3,而非约定 exit 2,t-cli-no-total / t-cli-bad-dirs /
+  // t-cli-bad-kernel-binding 应变红)]
+  if (dirs.length !== 2) return { error: `--dir 必须恰好 2 个,收到 ${dirs.length}` }
+  if (dirs[0].expectKernel === dirs[1].expectKernel) {
+    return { error: '两个 --dir 的 kernel 必须互不相同(legacy 与 new 各一次)' }
+  }
+  if (!Number.isInteger(expectTotal) || expectTotal <= 0) {
+    return { error: '--expect-total 必填且必须为正整数(无默认值,漏传必须报错)' }
+  }
+  return { dirs, expectTotal }
+}
+
+const isMainModule = () => {
+  try {
+    // 注意:不能拿 `file://${process.argv[1]}` 拼串比较——仓库路径含空格时(如
+    // "Project MivoCanvas")import.meta.url 是 URL 编码形式,拼串必然不等,main 块
+    // 会静默不执行(CLI 恒 exit 0)。必须 fileURLToPath 归一化后再比。
+    return Boolean(process.argv[1]) && fileURLToPath(import.meta.url) === resolve(process.argv[1])
+  } catch {
+    return false
+  }
+}
+
+if (isMainModule()) {
+  const parsed = parseArgs(process.argv.slice(2))
+  if (parsed.error) {
+    // 用法错误 = AggregateInputError 的 CLI 等价类别(SC-F:双入口错误类别一致)。
+    console.error(`[ledger-aggregate] ${parsed.error}`)
+    console.error(USAGE)
+    process.exit(2)
+  }
+  let result
+  try {
+    result = aggregateLedgers({ dirs: parsed.dirs, expectTotal: parsed.expectTotal })
+  } catch (err) {
+    if (err instanceof AggregateInputError) {
+      // 输入/schema 异常(含 manifest 结构非法,D2)→ exit 2;消息已是白名单化文本。
+      console.error(`[ledger-aggregate] ${sanitizeToken(err.message, 400)}`)
+      console.error(USAGE)
+      process.exit(2)
+    }
+    // 未知内部异常:自身崩溃不得洗绿(SC-K),但不回显 stack(可能含路径/输入内容,D4)。
+    console.error('[ledger-aggregate] 内部错误(细节已省略)')
+    process.exit(3)
+  }
+  console.log(formatCliOutput(result))
+  // [M15 变异点:CLI 退出码映射(改成恒 exit(0) → 全部红结果 spawn fixture 变绿,t-cli-bad-input / t-privacy / t-no-path 应变红)]
+  process.exit(result.ok ? 0 : 1)
+}
