+describe('D1 菜单「复制」补写哨兵', () => {
+  it('点击 copy → 内部剪贴板 + 系统剪贴板哨兵,两件都做', async () => {
+    clipboard = stubClipboard()
+    const copySelectedNodes = vi.fn()
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), imageNode('b')]), { copySelectedNodes }),
+    )
+
+    fire(groups, 'copy')
+    expect(copySelectedNodes).toHaveBeenCalledTimes(1)
+    // 补写是异步的(菜单点击没有 copy 事件可 setData),让微任务跑完再断言。
+    await Promise.resolve()
+    expect(clipboard.writeText).toHaveBeenCalledWith(CANVAS_CLIPBOARD_SENTINEL)
+  })
+
+  it('系统剪贴板不可用时,内部复制照做、不抛(哨兵只是增强)', () => {
+    const original = Object.getOwnPropertyDescriptor(navigator, 'clipboard')
+    Object.defineProperty(navigator, 'clipboard', { value: undefined, configurable: true })
+    try {
+      const copySelectedNodes = vi.fn()
+      const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a')]), { copySelectedNodes }))
+      expect(() => fire(groups, 'copy')).not.toThrow()
+      expect(copySelectedNodes).toHaveBeenCalledTimes(1)
+    } finally {
+      if (original) Object.defineProperty(navigator, 'clipboard', original)
+    }
+  })
+})
