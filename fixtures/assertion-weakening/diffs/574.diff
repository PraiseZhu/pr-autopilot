+/**
+ * manifest 契约检查(P0,每 child 钉死——不是只比两 child 相等):
+ *  - topology 必须恰为 "prod";
+ *  - rendererModes 去重后恰等于 {dom, leafer},raw 数组无重复;
+ *  - kernelModes raw 长度恰为 1,且值 === expectKernel(D3 绑定);
+ *  - selectedScenarios raw 逐位等于权威 scenarioOrder(同长度、同顺序、无重复);
+ *  - persist 必须恰为 "local"。
+ * 返回错误文案数组(空 = 通过)。此前的"跨 child 相等"版本(P0 漏洞)已删除:
+ * 两 child 各自谎报同一套非法值(如都报 topology=dev、rendererModes=[dom,bogus])
+ * 会被"相等"骗过——这正是 lead 实测的攻击形态。
+ */
+const validateChildContract = (manifest, expectKernel) => {
+  const errors = []
+  // [M18 变异点:topology 每 child 钉死 "prod"(删此 if → t-topology 应变绿)]
+  if (manifest.topology !== 'prod') {
+    errors.push(`topology 必须恰为 "prod"(收到 ${sanitizeToken(manifest.topology, 20)})`)
+  }
+  // [M19 变异点:rendererModes 钉死 {dom,leafer} 且无重复(删此 if → t-renderers-bogus/t-renderers-dup 应变绿)]
+  const renderers = manifest.rendererModes
+  const rendererSet = new Set(renderers)
+  if (renderers.length !== 2 || rendererSet.size !== renderers.length || !rendererSet.has('dom') || !rendererSet.has('leafer')) {
+    errors.push(`rendererModes 去重后必须恰为 {dom, leafer} 且无重复(收到 [${renderers.map((r) => sanitizeToken(r, 20)).join(', ')}])`)
+  }
+  // [M20 变异点:kernelModes 每 child 长度恰为 1(删此 if → t-kernel-len 应变绿)]
+  const kernels = manifest.kernelModes
+  if (kernels.length !== 1) {
+    errors.push(`kernelModes 长度必须恰为 1(收到 ${kernels.length} 个:[${kernels.map((k) => sanitizeToken(k, 20)).join(', ')}])`)
+    // [M24 变异点:kernelModes 与期望 kernel 绑定(删此 else-if → t-kernel 应变绿)]
+  } else if (kernels[0] !== expectKernel) {
+    errors.push(`kernelModes 与期望 kernel 不符(期望 ${sanitizeToken(expectKernel, 20)},收到 ${sanitizeToken(kernels[0], 20)})`)
