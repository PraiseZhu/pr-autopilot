+// SC-C4 / SC-C5 —— 哨兵识别的正反断言 + 补写路径的三条出口。
+//
+// 这里钉的是仲裁的**识别口径**:哨兵一旦漏判,粘贴就会让系统剪贴板里的旧截图
+// 赢过用户刚复制的画布节点(2026-07-31 那个 bug)。所以"什么算哨兵"必须锁死,
+// 尤其是空串 —— 它和"剪贴板本来就没文字"撞车,绝不能算。
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import {
+  CANVAS_CLIPBOARD_SENTINEL,
+  isCanvasClipboardSentinel,
+  writeCanvasClipboardSentinel,
+} from './canvasClipboardSentinel'
+
+const LEGACY_SENTINEL = 'Mivo Canvas 剪贴板占位 — 回到画布按 Ctrl/Cmd+V 粘贴'
+
+const stubClipboard = (clipboard: unknown) => {
+  const original = Object.getOwnPropertyDescriptor(navigator, 'clipboard')
+  Object.defineProperty(navigator, 'clipboard', { value: clipboard, configurable: true })
+  return () => {
+    if (original) Object.defineProperty(navigator, 'clipboard', original)
+    else Reflect.deleteProperty(navigator as unknown as Record<string, unknown>, 'clipboard')
+  }
+}
+
+let restoreClipboard: (() => void) | undefined
+
+afterEach(() => {
+  restoreClipboard?.()
+  restoreClipboard = undefined
+})
+
+describe('canvasClipboardSentinel', () => {
+  it('当前哨兵是零宽空格 —— 外部粘贴不吐可见文字,且不是空串', () => {
+    expect(CANVAS_CLIPBOARD_SENTINEL).toBe('\u200b')
+    expect(CANVAS_CLIPBOARD_SENTINEL.length).toBe(1)
+    // 反向:不能退化成空串(会与"剪贴板没文字"混淆)。
+    expect(CANVAS_CLIPBOARD_SENTINEL).not.toBe('')
+    // 反向:不能含任何可打印字符(本轮改动的目的就是不让用户看见)。
+    expect(/\S/u.test(CANVAS_CLIPBOARD_SENTINEL)).toBe(true) // ZWSP 不是 \s,见下
+    expect(CANVAS_CLIPBOARD_SENTINEL.codePointAt(0)).toBe(0x200b)
+    // 顺带钉住一条有用的性质:U+200B 规范上**不是** whitespace,所以 trim() 不吃它 ——
+    // 途经会 trim 的输入框也不会把哨兵洗掉。
+    expect(CANVAS_CLIPBOARD_SENTINEL.trim()).toBe(CANVAS_CLIPBOARD_SENTINEL)
+  })
+
+  it('SC-C4 认当前值,也认历史中文值(升级前复制、升级后粘贴那一次)', () => {
+    expect(isCanvasClipboardSentinel(CANVAS_CLIPBOARD_SENTINEL)).toBe(true)
+    expect(isCanvasClipboardSentinel(LEGACY_SENTINEL)).toBe(true)
+  })
+
+  it('SC-C5 其它任何文本都不算哨兵 —— 空串/空白/前后缀/undefined/null', () => {
+    expect(isCanvasClipboardSentinel('')).toBe(false)
+    expect(isCanvasClipboardSentinel(undefined)).toBe(false)
+    expect(isCanvasClipboardSentinel(null)).toBe(false)
+    expect(isCanvasClipboardSentinel(' ')).toBe(false)
+    expect(isCanvasClipboardSentinel('\n')).toBe(false)
+    expect(isCanvasClipboardSentinel('hello')).toBe(false)
+    // 全等比较:带前后缀的不算(否则用户复制的正文里夹一个零宽字符就会误判)。
+    expect(isCanvasClipboardSentinel(`${CANVAS_CLIPBOARD_SENTINEL}x`)).toBe(false)
+    expect(isCanvasClipboardSentinel(`x${CANVAS_CLIPBOARD_SENTINEL}`)).toBe(false)
+    expect(isCanvasClipboardSentinel(CANVAS_CLIPBOARD_SENTINEL.repeat(2))).toBe(false)
+    expect(isCanvasClipboardSentinel(`${LEGACY_SENTINEL} `)).toBe(false)
+  })
+
+  describe('writeCanvasClipboardSentinel(菜单复制路径的补写)', () => {
+    it('写入成功 → true,且写的是当前哨兵值', async () => {
+      const writeText = vi.fn(async () => undefined)
+      restoreClipboard = stubClipboard({ writeText })
+
+      await expect(writeCanvasClipboardSentinel()).resolves.toBe(true)
+      expect(writeText).toHaveBeenCalledWith(CANVAS_CLIPBOARD_SENTINEL)
+      // 反向:绝不写历史值。
+      expect(writeText).not.toHaveBeenCalledWith(LEGACY_SENTINEL)
+    })
+
+    it('浏览器没有 Clipboard API → false,不抛', async () => {
+      restoreClipboard = stubClipboard(undefined)
+      await expect(writeCanvasClipboardSentinel()).resolves.toBe(false)
+    })
+
+    it('写入被拒(无权限/失焦)→ false,不抛 —— 只退回补写之前的行为', async () => {
+      const writeText = vi.fn(async () => {
+        throw new Error('NotAllowedError')
+      })
+      restoreClipboard = stubClipboard({ writeText })
+
+      await expect(writeCanvasClipboardSentinel()).resolves.toBe(false)
+    })
+  })
+})
