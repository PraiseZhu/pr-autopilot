+    rewritten.push({ ...b.records[0], status: 'FAIL', message: 'a'.repeat(10000) + longMarker })
+    const lines = rewritten.map((record) => JSON.stringify(record))
+    lines.push(`X_${secretMsg}`)
+    writeFileSync(join(b.dir, 'ledger.jsonl'), `${lines.join('\n')}\n`)
+    const { code, stdout, stderr } = await runCli(['--dir', `legacy=${a.dir}`, '--dir', `new=${b.dir}`, '--expect-total', `${MATRIX_TOTAL}`])
+    expect(code).not.toBe(0)
