+// scripts/e2e/ledger-aggregate.mjs — #561 跨 child(matrix)ledger 汇总校验器。
+//
+// 保证等级(SC-M):本校验器只声称 T1——防疏忽/防漂移/防漏格/防 matrix 写错这类
+// 普通事故。ledger/manifest 是 runner 自产自写、由 CI 保管的中间产物,校验器与它们
+// 同源、无独立可信根,因此不构成安全边界;任何声称更高等级的措辞都是越权声明。
+//
+// 架构(SC-A):每个 child 的记录级校验 100% 复用 summarizeRun(ledger-summary.mjs,
+// #560 的 14 条规则:manifest/ledger 缺失与坏行、runId/schemaVersion/headSha 不符、
+// name↔四字段重算、未声明格、重复格、缺格、evidenceMissing、未知 status)。
+// 本文件只新增跨 child 检查(身份绑定/N_A 派生/expectedCells 重算/总数/终态/
+// 下载边界/外部输入边界)与 manifest 契约检查(topology/rendererModes/kernelModes/
+// selectedScenarios/persist 每 child 钉死——P0,2026-08-07),不出现第二份记录级校验
+// 逻辑——违反即 SC-A 失败(测试 SC-A 注入非法记录,断言错误文案来自 summarizeRun 原文)。
+//
+// 输入(SC-H):两个下载目录(--dir ×2,即两份 GitHub artifact 的解压目录)。
+// 校验器在目录内显式定位 runId(读 manifest.json 的 runId 字段,并与目录布局对账),
+// 禁止读 LATEST——LATEST 是单标量覆盖写文件,两份 artifact 解压到同一目录会互相
+// 覆盖,正是 #561 要下载两份 artifact、各自独立目录的原因;谁读 LATEST,谁就会在
+// matrix 场景下拿到错误 runId。
+//
+// 外部输入边界(SC-G):artifact 是外部输入。单文件大小上限(bounded JSON)、只
+// JSON.parse(不 eval)、不拼 shell、拒绝 symlink 与路径穿越。SAFE_NAME 白名单
+// (无分隔符、无 '..'、起始字符为字母数字)作用于 runId——它是唯一会被拼进构造
+// 路径(runDir(runId))的外部可控名字;校验器读取的两个文件是固定名字
+// (manifest.json/ledger.jsonl) join 到 dir,本身穿不出去;下载目录里其余顶层
+// 条目只是无关内容,条目数上限已防 readdir 炸弹。
+//
+// 下载布局(canonical,workflow 契约——#561 W5 D6 收敛,2026-08-07):
+//   唯一合法布局:--dir 指向「run 目录」本身,manifest.json 与 ledger.jsonl 必须
+//   直接位于该目录根(即 GitHub artifact 以 test-artifacts/e2e-runs/<runId> 的
+//   内容为根打包,解压后 manifest.json 在解压根)。禁止传含 runId 子目录的上级
+//   目录;校验器不做任何递归下探,找不到 manifest.json 直接 fail-closed(仅在
+//   错误提示里做单层"包了一层子目录"的定位帮助,不参与定位逻辑)。LATEST 永不
+//   读取。此前的布局 A/B/C 递归探查(含 MAX_DEPTH)已删除——布局由 workflow 完全
+//   控制,递归是过度设计。
+//
+// 依赖(SC-D7,2026-08-07 决策):本模块 import scenarios/index.mjs(取 scenarioOrder
+//   与 leaferSkippedScenarios——单一真相源),该模块传递依赖 canvas-export.mjs →
+//   pngjs(node_modules)。因此 aggregate job 必须先 npm ci 才能运行;node_modules
+//   就绪是运行前提,不以"纯 stdlib 脚本"自居。
+//
+// 暂存(staging)说明:校验器把下载目录里的 manifest/ledger 复制进本仓
+//   test-artifacts/e2e-runs/<runId>/ 后调 summarizeRun(记录级校验的单一 owner)。
+//   去掉 staging 需要给 ledger-summary.mjs 的 summarizeRun 增加外部 root/文件参数
+//   ——按 #561 W5 派工约束,未获 lead 授权不动该文件;此为已知残余(工作区副作用
+//   + lstat→copy 的极小 TOCTOU 窗口),workflow 接线前无害。
+import { copyFileSync, existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync } from 'node:fs'
+import { join, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { cellKey, ledgerPath, manifestPath, runDir } from './result-ledger.mjs'
+import { summarizeRun } from './ledger-summary.mjs'
+import { leaferSkippedScenarios, scenarioOrder } from './scenarios/index.mjs'
+
+// 运行期常量(SC-G 的边界值;真实 manifest ~6KB、真实 ledger ~18KB,上限留足量级)。
+const MAX_MANIFEST_BYTES = 1 * 1024 * 1024
+const MAX_LEDGER_BYTES = 10 * 1024 * 1024
+const MAX_TOP_ENTRIES = 64 // 下载目录顶层条目上限(canonical 布局合法顶层 = manifest/ledger/fragments ≤ 3)
+const MAX_ERRORS_PER_CHILD = 40 // 单 child 错误数上限(bounded 诊断,SC-J)
+// runId/目录名白名单:首字符字母数字,其余仅 [A-Za-z0-9._-],总长 ≤128——无分隔符、
+// 无 '..'(路径穿越在 staging/join 之前就被拦下)。
+const SAFE_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/
+// headSha 回显白名单:git SHA(7-40 位 hex)。不合规 → 整段省略,不回显原始内容(D4)。
+const HEAD_SHA_TOKEN = /^[0-9a-fA-F]{7,40}$/
+
+/** 输入契约违规(SC-F:双入口同类别——CLI 缺参 exit 2 与函数 throw 都是"调用方漏传"这一件事)。 */
+export class AggregateInputError extends Error {
+  constructor(message) {
+    super(message)
+    this.name = 'AggregateInputError'
+  }
+}
+
+/**
+ * 回显白名单化(D4):任何来自外部输入/路径的回显值都必须过这道关。
+ *  - 控制字符(C0 + DEL)替换为 '?'——换行/ANSI 注入被拆平,日志行无法被伪造;
+ *  - 超长截断;
+ *  - 原始 path 一律不输出(调用方只输出 label/runId 等白名单 token)。
+ */
+const sanitizeToken = (value, max = 60) => {
+  const text = String(value).replace(/[\u0000-\u001F\u007F]/g, '?')
+  return text.length <= max ? text : `${text.slice(0, max)}…`
+}
+
+const headShaToken = (sha) => (HEAD_SHA_TOKEN.test(String(sha)) ? String(sha) : '<headSha 非 hex,已省略>')
+
+/**
+ * summarizeRun 错误摘要消毒(SC-J/SC-L/D4):
+ *  - `manifest JSON 解析失败:<path>(<err.message>)` 与 `ledger 第 N 行 JSON 解析失败:<err.message>`
+ *    的 err.message 是 JSON.parse 抛出的,会原样回显输入内容片段——外部输入可能含敏感
+ *    数据,必须剥掉整个回显段,只保留前缀(路径/行号),换固定文案;
+ *  - summarizeRun 的错误正文含本仓暂存路径(manifest 缺失:<path> 等),同样剥掉;
+ *  - 其余错误走 sanitizeToken(控制字符剔除 + 截断),不吞错。
+ */
+// [M16 变异点:隐私消毒规则(改 return 为原样透传 → t-privacy/t-ledger-badline/t-no-path/t-ctl-name 应变红)]
+const sanitizeChildErrors = (runId, errors) => {
+  const stagedManifest = manifestPath(runId)
+  const stagedLedger = ledgerPath(runId)
+  return errors.map((error) => {
+    let text = String(error)
+    if (text.startsWith('manifest JSON 解析失败:')) {
+      const cut = text.indexOf('(')
+      text = cut > 0 ? `${text.slice(0, cut)}(内容已省略)` : text
+    }
+    if (/^ledger 第 \d+ 行 JSON 解析失败:/.test(text)) {
+      const cut = text.indexOf(':')
+      text = `${text.slice(0, cut)}(内容已省略)`
+    }
+    // 暂存路径是工作区内部路径,不对外回显(D4:不输出原始 path)。
+    text = text.split(stagedManifest).join('<manifest 路径已省略>').split(stagedLedger).join('<ledger 路径已省略>')
