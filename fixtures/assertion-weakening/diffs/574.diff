index 624a1b96..9cbdb8d1 100644
--- a/src/lib/imageNodeClipboard.ts
+++ b/src/lib/imageNodeClipboard.ts
@@ -1,10 +1,31 @@
-// Copy-as-PNG for image nodes (FigJam parity: right-click → Copy as PNG).
-// Rasterizes the node's VISIBLE content — imageCrop applied — to a PNG blob and
-// writes it to the system clipboard. Success/skip/failure all reported via
-// debugLogger (+ toast for the user-visible outcome).
+// Copy-as-PNG for image nodes (参考产品同名菜单项的对位实现).
+// Rasterizes the node's VISIBLE content — imageCrop + 镜像 + 旋转 全部应用 — to a
+// PNG blob and writes it to the system clipboard. Success/skip/failure all reported
+// via debugLogger (+ toast for the user-visible outcome).
+//
+// 几何全部委托给 imageClipboardGeometry(纯函数、可单测);本文件只负责解码位图、
+// 按计划 drawImage、编码、写剪贴板。
+//
+// 2026-08-05:
+//  - 补上旋转与镜像 —— 此前只应用 imageCrop,把图转 90°/翻转后复制,粘出来是没转
+//    没翻的原图(静默给错结果)。
+//  - 新增多选合成入口 copyImageNodesAsPng。
 
 import type { MivoCanvasNode } from '../types/mivoCanvas'
 import { isImportedAssetUrl, readImportedAssetFile } from './assetStorage'
+import {
+  CANVAS_MAX_BITMAP_SIDE,
+  planImageNodeRaster,
+  planMultiImageComposite,
+  type MultiImageEntry,
+  type SourceRect,
+} from './imageClipboardGeometry'
+import {
+  CANVAS_EXPORT_ERROR_CODES,
+  CANVAS_EXPORT_LIMITS,
+  CanvasExportError,
+  assertCanvasExportPixelBudget,
+} from './canvasExport'
 import { isDemoAssetUrl, renderDemoImageBlob } from './demoAssets'
 import { debugLogger } from '../store/debugLogStore'
 import { toastFeedback } from '../store/toastStore'
@@ -40,51 +61,211 @@ const decodeImage = (url: string) =>
     image.src = url
   })
 
+/** 复制为 PNG 的合格节点:必须是有资产的 image。
+ *
+ *  注意不能用 `imageAsset` capability 代替 —— task-placeholder 也持有该能力
+ *  (canvasNodeRegistry),但它是待生成占位、没有 assetUrl,栅格化必挂。 */
+export const isCopyablePngNode = (node: MivoCanvasNode | undefined): boolean =>
+  !!node && node.type === 'image' && !!node.assetUrl
+
+const clipboardWriteAvailable = () => typeof ClipboardItem !== 'undefined' && !!navigator.clipboard?.write
+
+/**
+ * 绕中心画一张(已裁剪的)源位图,按 crop → flip → rotate 的顺序。
+ * 顺序与渲染层一致,理由见 imageClipboardGeometry 头注释。
+ */
+const drawPlacement = (
+  context: CanvasRenderingContext2D,
+  image: HTMLImageElement,
+  placement: {
+    center: { x: number; y: number }
+    draw: { width: number; height: number }
+    source: SourceRect
+    rotation: number
+    flipH: boolean
+    flipV: boolean
+  },
+) => {
+  const { center, draw, source, rotation, flipH, flipV } = placement
+  context.save()
+  context.translate(center.x, center.y)
+  if (rotation) context.rotate((rotation * Math.PI) / 180)
+  if (flipH || flipV) context.scale(flipH ? -1 : 1, flipV ? -1 : 1)
+  context.drawImage(
+    image,
+    source.x,
+    source.y,
+    source.width,
+    source.height,
+    -draw.width / 2,
+    -draw.height / 2,
+    draw.width,
+    draw.height,
+  )
+  context.restore()
+}
+
+const createCanvas = (width: number, height: number) => {
+  const canvas = document.createElement('canvas')
+  canvas.width = width
+  canvas.height = height
+  const context = canvas.getContext('2d')
+  if (!context) throw new Error('2d context unavailable')
+  return { canvas, context }
+}
