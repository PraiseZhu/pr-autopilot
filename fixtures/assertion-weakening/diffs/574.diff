+  })
+
+  it('SC-B1 点击把整个选区按传入(图层)顺序交给 onCopyImagesAsPng', () => {
+    const onCopyImagesAsPng = vi.fn()
+    const nodes = [imageNode('bottom'), imageNode('middle'), imageNode('top')]
+    const groups = contextMenuGroupsFor(createRuntime(ctx(nodes), { onCopyImagesAsPng }))
+
+    fire(groups, 'copy-as-png')
+    expect(onCopyImagesAsPng).toHaveBeenCalledTimes(1)
+    expect(onCopyImagesAsPng.mock.calls[0][0].map((n: MivoCanvasNode) => n.id)).toEqual([
+      'bottom',
+      'middle',
+      'top',
+    ])
+  })
+
+  it('自成独立一组,紧跟 inspect 簇之后(= 落在「适应所选」下面,带分隔线)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), imageNode('b')]), { onFitSelection: vi.fn() }),
+    )
+    const groupIds = groups.map((g) => g.id)
+    expect(groupIds.indexOf('selection-export')).toBe(groupIds.indexOf('inspect') + 1)
+
+    // 这一组只装 copy-as-png 一项(不许顺手塞别的进来)。
+    const exportGroup = groups.find((g) => g.id === 'selection-export')
+    expect(exportGroup?.actions.map((a) => a.id)).toEqual(['copy-as-png'])
+
+    // 反向:它不在 inspect 簇里 —— 在里面就没有分隔线,与单图菜单观感不一致。
+    const inspectIds = groups.find((g) => g.id === 'inspect')?.actions.map((a) => a.id) ?? []
+    expect(inspectIds).not.toContain('copy-as-png')
+    // inspect 簇本身仍以 copy → fit-selection 收尾(证明只是搬出去,没打乱既有顺序)。
+    expect(inspectIds.slice(0, 2)).toEqual(['copy', 'fit-selection'])
+  })
+
+  it('没接 onCopyImagesAsPng 时点击不抛(可选链安全)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), imageNode('b')]), { onCopyImagesAsPng: undefined }),
+    )
+    expect(() => fire(groups, 'copy-as-png')).not.toThrow()
+  })
+
+  it('SC-B3 混入文本节点 → 不出现', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), node('t', 'text')])))
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('SC-B3 混入 task-placeholder → 不出现(它也持有 imageAsset 能力,但没有 assetUrl)', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), node('task', 'task-placeholder')])),
+    )
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('SC-B3 image 但缺 assetUrl → 不出现', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([imageNode('a'), node('empty', 'image')])),
+    )
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('SC-B3 混选 [image,text] → 整个 selection-export 组都不出现', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), node('t', 'text')])))
+    expect(groups.map((g) => g.id)).not.toContain('selection-export')
+  })
+
+  it('SC-B3 全是非图片(便签多选)→ 不出现', () => {
+    const groups = contextMenuGroupsFor(
+      createRuntime(ctx([node('n1', 'annotation'), node('n2', 'annotation')])),
+    )
+    expect(hasAction(groups, 'copy-as-png')).toBe(false)
+  })
+
+  it('单选图片仍只有一份 copy-as-png(来自 edit 簇,没被多选那项重复装配)', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a')])))
+    const matches = groups.flatMap((g) => g.actions.filter((a) => a.id === 'copy-as-png'))
+    expect(matches).toHaveLength(1)
+  })
+
+  it('SC-B4 多选时单选专属项仍不出现 —— 没有松动 kind!=="single" 早退', () => {
+    const groups = contextMenuGroupsFor(createRuntime(ctx([imageNode('a'), imageNode('b')])))
+    for (const id of [
+      'reset-crop',
+      'variations',
+      'generate-beside',
+      'add-edit-note',
+      'edit-with-prompt',
+      'select-area-edit',
+      'remove-background',
+      'view-details',
+    ]) {
+      expect(hasAction(groups, id)).toBe(false)
+    }
+    // 同一份菜单里 copy-as-png 确实在(证明上面的"不出现"不是整份菜单为空)。
+    expect(hasAction(groups, 'copy-as-png')).toBe(true)
+  })
+})
