diff --git a/cindyplugin/src/__tests__/correlateNewAssets.test.ts b/cindyplugin/src/__tests__/correlateNewAssets.test.ts
new file mode 100644
index 00000000..15e6a3a4
--- /dev/null
+++ b/cindyplugin/src/__tests__/correlateNewAssets.test.ts
@@ -0,0 +1,174 @@
+/**
+ * T1f cutover:`depositFlagOff.test.ts` 随 `DEPOSIT_ENABLED` 一并删除(那个文件的
+ * 前提——"flag 关时行为与现状逐字节一致"——随 flag 删除而消失),本文件迁移其中
+ * 两条与 flag 无关、仍需覆盖的行为:
+ *
+ *  ① `correlateNewAssets` 的接线本身(任务完成 → 画布出现新节点 → 真的调用
+ *     `recordArtifactDeposit` 双写)。`recordArtifactDeposit` 自身的双写行为已由
+ *     `depositOwned.test.ts` 覆盖,但"谁在什么时机调用它"只有这条测试锁着。
+ *  ② mask 门禁次序不变量(R8-H 边界):mask 请求必须在源图兑换**之前**被拒,否则
+ *     一个注定被拒的 mask 请求会先把字节寄存进宿主总仓、白烧配额。
+ *
+ * canvasStore 被替身掉:它在 node 环境求值需要 document(demoScenes 画 canvas),
+ * 而这两条测试都不关心画布内容本身。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+/**
+ * T1e 补测(P1-a/§3.3):`correlateNewAssets`/`correlatePlacedAttachments` 的
+ * 完成路径需要"画布出现新节点"这个可观测变化才能触发,原 mock 是固定空数组,
+ * 测不到这条路径。改成可变数组,测试可以在提交任务之后手动推入"新节点",模拟
+ * `correlateNewAssets` 的 500ms 轮询检测到它的那一刻。
+ */
+let mockCanvasNodes: Array<{ type: string; assetUrl?: string }> = []
+vi.mock('../../../src/store/canvasStore', () => ({
+  useCanvasStore: { getState: () => ({ nodes: mockCanvasNodes }) },
+}))
+
+import { cindyImageGenerationPort } from '../agent/cindyGenerationPort'
+import { peekDepositStoreForTests, resetDepositStoreForTests } from '../agent/depositStore'
+
+type Posted = Record<string, unknown>
+
+/**
+ * 双 spy 判据:只挡"发到宿主媒体总仓"的两个 kind(`deposit-media`/`release-media`)。
+ * **不能**用 `startsWith('deposit')` 前缀匹配——`recordArtifactDeposit` 写
+ * depositMap 会真的触发 `deposit-state-load`/`deposit-state-save`(depositStore
+ * 自己的状态持久化,走 electron-brain 的 `/kv` 槎,与"寄存进媒体总仓换指纹"是
+ * 两件完全不同的事),前缀匹配会把这两条正常的状态持久化误判成寄存请求。
+ */
+const isDepositOrReleaseKind = (message: Posted): boolean => {
+  const kind = String(message.kind)
+  return kind === 'deposit-media' || kind === 'release-media'
+}
+
+const posted: Posted[] = []
+const fetched: string[] = []
+const replyForNextRequest: Record<string, unknown> = { ok: false, message: '测试短路' }
+
+class FakeBroadcastChannel {
+  readonly name: string
+  private readonly listeners = new Set<(event: { data: unknown }) => void>()
+
+  constructor(name: string) {
+    this.name = name
+  }
+
+  addEventListener(_type: 'message', handler: (event: { data: unknown }) => void) {
+    this.listeners.add(handler)
+  }
+
+  removeEventListener(_type: 'message', handler: (event: { data: unknown }) => void) {
+    this.listeners.delete(handler)
+  }
+
+  postMessage(data: unknown) {
+    const message = data as Posted
+    posted.push(message)
+    // 回执延到下一个 microtask,不是同一 tick 内同步回:真实 BroadcastChannel 的
+    // postMessage 本就是异步派发(persist/bridge.ts 的 `send()`/`intervalId` 顺序
+    // 依赖这一点,同步假实现会撞 TDZ——已在 bridge.ts 修掉,这里保持拟真写法)。
+    const reply = { reqId: message.reqId, reply: true, ...replyForNextRequest }
+    queueMicrotask(() => {
+      for (const handler of Array.from(this.listeners)) handler({ data: reply })
+    })
+  }
+
+  close() {
+    this.listeners.clear()
+  }
+}
+
+beforeEach(() => {
+  posted.length = 0
+  fetched.length = 0
+  mockCanvasNodes = []
+  replyForNextRequest.ok = false
+  replyForNextRequest.message = '测试短路'
+  delete replyForNextRequest.hash
+  delete replyForNextRequest.ext
+  resetDepositStoreForTests()
+  vi.stubGlobal('BroadcastChannel', FakeBroadcastChannel)
+  vi.stubGlobal('window', {
+    setInterval: (fn: () => void, ms: number) => globalThis.setInterval(fn, ms),
+    clearInterval: (id: unknown) => globalThis.clearInterval(id as never),
+    setTimeout: (fn: () => void, ms: number) => globalThis.setTimeout(fn, ms),
+    clearTimeout: (id: unknown) => globalThis.clearTimeout(id as never),
+  })
+  vi.stubGlobal('fetch', async (input: unknown) => {
+    const url = String(input)
+    fetched.push(url)
+    if (url === '/kv') return { ok: true, json: async () => ({}) } as unknown as Response
+    return { ok: true, json: async () => ({}) } as unknown as Response
+  })
+  // node 环境本没有 FileReader,`blobToBase64`(cindyGenerationPort.ts 内部)用它把
+  // 产物 blob 转 base64,任务成功落图这条路径需要它。
+  vi.stubGlobal(
+    'FileReader',
+    class {
+      result: string | null = null
+      onload: (() => void) | null = null
+      onerror: (() => void) | null = null
+      readAsDataURL() {
+        this.result = 'data:image/png;base64,ZmFrZQ=='
+        queueMicrotask(() => this.onload?.())
+      }
+    },
+  )
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+describe('correlateNewAssets — 任务完成后画布出现新节点即触发 artifact 双写', () => {
+  it('任务成功落图后,recordArtifactDeposit 真的被调用:ledger 与 depositMap 都写入(from=artifact)', async () => {
+    const newAssetUrl = 'mivo-asset:generated-1'
+    const generatedHash = 'd'.repeat(32)
+    replyForNextRequest.ok = true
+    replyForNextRequest.hash = generatedHash
+    replyForNextRequest.ext = '.png'
+    vi.stubGlobal('fetch', async (input: unknown) => {
+      const url = String(input)
+      fetched.push(url)
+      if (url === '/kv') return { ok: true, json: async () => ({}) } as unknown as Response
+      return { ok: true, blob: async () => new Blob([new Uint8Array(4)]) } as unknown as Response
+    })
+
+    await cindyImageGenerationPort.submitGenerationTask({ prompt: '画一只猫', idempotencyKey: 'k5' })
+    await new Promise((resolve) => setTimeout(resolve, 20))
+    // correlateNewAssets 起轮询之前,画布上还是老样子(空)——现在推入"新落图的
+    // 节点",模拟任务完成后画布真的多出这一张图。
+    mockCanvasNodes = [{ type: 'image', assetUrl: newAssetUrl }]
+    // 轮询间隔 500ms,给足一次轮询周期的余量。
+    await new Promise((resolve) => setTimeout(resolve, 700))
+
+    expect(await import('../agent/mediaLedger').then((m) => m.lookupMedia(newAssetUrl))).toMatchObject({
+      hash: generatedHash,
+      ext: '.png',
+    })
+    expect(peekDepositStoreForTests()?.map[newAssetUrl]).toMatchObject({ hash: generatedHash, from: 'artifact' })
+    // 这是本地记账(AI 自己生成的产物),不是走寄存换来的——全程零 deposit/release 请求。
+    expect(posted.filter(isDepositOrReleaseKind)).toHaveLength(0)
+  })
+})
+
+describe('mask 门禁次序不变量(R8-H 边界,与 flag 无关)', () => {
+  it('mask 请求在源图兑换之前就被拒:抛 mask 文案而不是源图解析错误', async () => {
+    // 关键点:源图**故意不给 image/sourceAssetUrl 对应的真实字节**——次序正确时
+    // mask 检查在 resolveSourceEntry 之前就抛,根本不会走到源图兑换这一步。
+    const promise = cindyImageGenerationPort.submitEditTask({
+      prompt: '局部改',
+      image: new Blob([new Uint8Array(16)], { type: 'image/png' }),
+      sourceAssetUrl: 'mivo-asset:mask-source',
+      mask: new Blob([new Uint8Array(4)], { type: 'image/png' }),
+      idempotencyKey: 'k4',
+    })
+
+    await expect(promise).rejects.toThrow('局部重绘/框选修改(mask)在 Cindy 插件模式下暂不支持(后续版本接入)。')
+
+    // 次序正确时连源图兑换都没进 → 任何形态的寄存/改图请求都不该发出。
+    expect(posted.filter(isDepositOrReleaseKind)).toHaveLength(0)
+    expect(posted.filter((message) => message.kind === 'edit-image')).toHaveLength(0)
+  })
+})
