diff --git a/src/__tests__/editOnceWithForcedRetry.test.ts b/src/__tests__/editOnceWithForcedRetry.test.ts
new file mode 100644
index 00000000..2c3bfc5c
--- /dev/null
+++ b/src/__tests__/editOnceWithForcedRetry.test.ts
@@ -0,0 +1,107 @@
+/**
+ * T1e §1.3/§3.3:"edit 失败强制重寄重试"的原语契约测试(设计稿 §11-B:"任一改图
+ * 失败后允许一次强制重寄存重试",不精确分类失败原因,1 次上限、不循环)。
+ *
+ * flag-independent:`editOnceWithForcedRetry` 本身不读 `DEPOSIT_ENABLED`,直接
+ * 单测,不需要"手动翻转编译期常量再跑一遍"这种人工复核。
+ *
+ * 端到端跑在真实 main.js 上(depositTestHarness),换指纹那一步走真实
+ * `refingerprintDepositEntry`,不是对着替身自说自话。
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// cindyGenerationPort.ts 引入 useCanvasStore,它在 node 环境求值需要 document
+// (demoScenes 画 canvas)——本测试只关心 editOnceWithForcedRetry 这个 flag-
+// independent 纯逻辑原语,不关心画布内容,同 depositFlagOff.test.ts 的替身手法。
+vi.mock('../../../src/store/canvasStore', () => ({
+  useCanvasStore: { getState: () => ({ nodes: [] }) },
+}))
+
+import { editOnceWithForcedRetry } from '../agent/cindyGenerationPort'
+import { recordDeposit } from '../agent/depositStore'
+import type { PersistReply } from '../persist/bridge'
+import { blobOfBytes, createDepositHarness, teardownDepositHarness, FAKE_HASH, type DepositHarness } from './depositTestHarness'
+
+let harness: DepositHarness
+
+const okReply = (hash: string): PersistReply => ({ reqId: 'r', reply: true, ok: true, hash, ext: '.png' })
+const failReply = (message = '宿主拒绝'): PersistReply => ({ reqId: 'r', reply: true, ok: false, message })
+
+beforeEach(() => {
+  harness = createDepositHarness()
+})
+
+afterEach(() => {
+  teardownDepositHarness()
+})
+
+describe('editOnceWithForcedRetry — 首次成功', () => {
+  it('doRequest 首次即成功 → 直接返回,不触发换指纹(零 deposit_media 请求)', async () => {
+    const doRequest = vi.fn(async (hash: string) => okReply(hash))
+
+    const result = await editOnceWithForcedRetry('mivo-asset:1', blobOfBytes(32), doRequest, FAKE_HASH)
+
+    expect(result).toMatchObject({ ok: true, hash: FAKE_HASH })
+    expect(doRequest).toHaveBeenCalledTimes(1)
+    expect(doRequest).toHaveBeenCalledWith(FAKE_HASH)
+    expect(harness.hostRequests).toHaveLength(0)
+  })
+})
+
+describe('editOnceWithForcedRetry — 首次失败,强制重寄后重试 1 次', () => {
+  it('首次失败 → 换新指纹 → 用新 hash 重试一次 → 第二次成功', async () => {
+    await recordDeposit('mivo-asset:1', { hash: FAKE_HASH, ext: '.png', depositedAt: 1, from: 'deposit' })
+    const NEW_HASH = 'f'.repeat(32)
+    harness.setHostReply(() => ({ ok: true, hash: NEW_HASH, ext: '.png' }))
+
+    let call = 0
+    const doRequest = vi.fn(async (hash: string): Promise<PersistReply> => {
+      call += 1
+      return call === 1 ? failReply('内容审核失败') : okReply(hash)
+    })
+
+    const result = await editOnceWithForcedRetry('mivo-asset:1', blobOfBytes(32), doRequest, FAKE_HASH)
+
+    expect(result).toMatchObject({ ok: true, hash: NEW_HASH })
+    expect(doRequest).toHaveBeenCalledTimes(2)
+    expect(doRequest).toHaveBeenNthCalledWith(1, FAKE_HASH)
+    expect(doRequest).toHaveBeenNthCalledWith(2, NEW_HASH) // 第二次确实用了换出来的新指纹,不是重复旧 hash
+    expect(harness.hostRequests).toHaveLength(1) // 换指纹确实发生了一次真实寄存
+  })
+
+  it('首次失败 → 重试也失败 → 照常报错,不第二次重试(SC1b.7 自愈至多 1 轮)', async () => {
+    await recordDeposit('mivo-asset:1', { hash: FAKE_HASH, ext: '.png', depositedAt: 1, from: 'deposit' })
+    const NEW_HASH = 'a'.repeat(32)
+    harness.setHostReply(() => ({ ok: true, hash: NEW_HASH, ext: '.png' }))
+
+    const doRequest = vi.fn(async (): Promise<PersistReply> => failReply('还是失败'))
+
+    const result = await editOnceWithForcedRetry('mivo-asset:1', blobOfBytes(32), doRequest, FAKE_HASH)
+
+    expect(result).toMatchObject({ ok: false, message: '还是失败' })
+    expect(doRequest).toHaveBeenCalledTimes(2) // 恰好 2 次:首次 + 1 次重试,不是无限循环
+    expect(harness.hostRequests).toHaveLength(1) // 换指纹本身还是发生了(只是第二次业务请求仍失败)
+  })
+
+  it('首次失败但换指纹本身也失败(如寄存超限)→ 原样返回首次失败,不第二次尝试业务请求', async () => {
+    const doRequest = vi.fn(async (): Promise<PersistReply> => failReply('首次失败原因'))
+    // 源图超过 50MB 上限,refingerprintDepositEntry 内部的 depositBlob 会抛 TOO_LARGE。
+    const oversized = blobOfBytes(50 * 1024 * 1024 + 1)
+
+    const result = await editOnceWithForcedRetry('mivo-asset:1', oversized, doRequest, FAKE_HASH)
+
+    expect(result).toMatchObject({ ok: false, message: '首次失败原因' }) // 报的是首次失败,不是换指纹失败
+    expect(doRequest).toHaveBeenCalledTimes(1) // 换指纹失败就不再调 doRequest 第二次
+    expect(harness.hostRequests).toHaveLength(0) // 超限前置拦截,零寄存请求
+  })
+
+  it('没有 sourceAssetUrl/image(理论上不会发生的边界)→ 原样返回首次失败,不尝试换指纹', async () => {
+    const doRequest = vi.fn(async (): Promise<PersistReply> => failReply('首次失败原因'))
+
+    const result = await editOnceWithForcedRetry(undefined, undefined, doRequest, FAKE_HASH)
+
+    expect(result).toMatchObject({ ok: false, message: '首次失败原因' })
+    expect(doRequest).toHaveBeenCalledTimes(1)
+    expect(harness.hostRequests).toHaveLength(0)
+  })
+})
