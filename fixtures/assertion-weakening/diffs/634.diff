+    const gearRule = ruleOf(themeCss, '.plugin-settings-trigger')
+    const flameRule = ruleOf(themeCss, '.plugin-changelog-trigger')
+    const gearRight = Number(gearRule.match(/right:\s*(\d+)px/)?.[1] ?? NaN)
+    const flameRight = Number(flameRule.match(/right:\s*(\d+)px/)?.[1] ?? NaN)
+    const gearWidth = Number(gearRule.match(/width:\s*(\d+)px/)?.[1] ?? NaN)
+    expect(Number.isFinite(gearRight), '.plugin-settings-trigger 应有数值 right').toBe(true)
+    expect(Number.isFinite(flameRight), '.plugin-changelog-trigger 应有数值 right').toBe(true)
+    expect(Number.isFinite(gearWidth), '.plugin-settings-trigger 应有数值 width').toBe(true)
+    expect(flameRight, '公告按钮 right 应严格大于齿轮(视觉上在其左侧)').toBeGreaterThan(gearRight)
+    expect(flameRight - gearRight, '两按钮 right 差值 ≥ 齿轮实际宽度(不重叠)').toBeGreaterThanOrEqual(gearWidth)
+  })
