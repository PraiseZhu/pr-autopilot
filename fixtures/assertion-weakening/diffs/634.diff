@@ -0,0 +1,47 @@
+/**
+ * changelog 面板几何声明守卫的共享扫描形状。
+ *
+ * 两个消费方必须共用同一份实现(判据所有权,禁止各自内联再漂移):
+ *  · changelogAutoPopup.test.ts pop-sc3 ③ —— 扫「本 PR diff 的 added 行」;
+ *  · pluginChangelogEntry.test.tsx port-sc10 ② —— 扫「皮肤层 themeCss 当前文件」。
+ *
+ * 两个已实测的免疫形态(upstream-preview F1,本波修复):
+ *  1. **`+` 前缀免疫**:diff added 行带单个 `+` 前缀,旧形状 `(?:^|;)` 正则看不到
+ *     行首的 `position:`(前缀 `+` 挡在 `^` 与属性名之间)。修法:先逐行剥掉单个
+ *     `+` 再拼规则块;`+++` 文件头行一并跳过,不进扫描。
+ *  2. **块首位置免疫**:规则块首属性(选择器与 `{` 同行后紧跟的属性)前面没有分号,
+ *     旧形状 `(?:^|;)` 里 `^` 只匹配整个字符串开头(无 m),块首属性必然漏网。
+ *     修法:前导允许 `^`/`;`/`{` 三选,并开 `m` 使换行后的逐行属性也能命中。
+ *
+ * 反向变异(见 hardening-checklist 第 8 类)由两个测试文件各自的 describe 锁住:
+ * 退化回旧形状(无 m/无 `{` 前导、不剥 `+`)时,块首 position 与换行后
+ * display/place-items 的违规必须被放过 → 对应断言转红;纯皮肤声明保持绿。
+ */
+export const GEOMETRY_PROPS_RE =
+  /(?:^|;|\{)\s*(position|inset|top|right|bottom|left|display|place-items|width|height|padding|gap|border-radius|transform|margin|z-index)\s*:/gm
+
+/** `.changelog-backdrop` / `.changelog-panel` 的规则块(跨行,含块首)。 */
+export const CHANGELOG_RULE_RE = /\.changelog-(?:backdrop|panel)[^{}]*\{[^}]*\}/g
+
+/**
+ * diff 的 added 行:过滤 `+` 开头、跳过 `+++` 文件头,逐行剥离**单个** `+` 前缀。
+ * 剥离后的行才是 CSS 源文本,`^`/`;`/`{` 前导才能按 CSS 语义命中。
+ */
+export const diffAddedLines = (diff: string): string[] =>
+  diff
+    .split('\n')
+    .filter((line) => line.startsWith('+') && !line.startsWith('+++'))
+    .map((line) => line.replace(/^\+/, ''))
+
+/** 对一组规则块声明体按几何属性正则过滤,返回命中块。re 可注入用于退化对照。 */
+export const scanBlocksForGeometry = (
+  blocks: string[],
+  re: RegExp = GEOMETRY_PROPS_RE,
+): string[] => blocks.filter((block) => block.match(re) !== null)
+
+/** 扫 diff 的 added 行中新增的 changelog 规则块,返回含几何声明的块。 */
+export const scanAddedGeometryViolations = (diff: string, re: RegExp = GEOMETRY_PROPS_RE): string[] => {
+  const added = diffAddedLines(diff).join('\n')
+  const blocks = [...added.matchAll(CHANGELOG_RULE_RE)].map((match) => match[0])
+  return scanBlocksForGeometry(blocks, re)
+}
