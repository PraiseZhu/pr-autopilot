+// 从 CSS 文本提取某选择器的规则块;取不到返回空串(由调用方断言非空)。
+const ruleOf = (css: string, selector: string): string => {
+  const escaped = selector.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+  const match = css.match(new RegExp(`(?:^|\\n)${escaped} \\{([^}]*)\\}`))
+  return match?.[1] ?? ''
+}
+
+// 提取 themeCss 中选择器命中 selRe 的规则声明体列表
+const ruleBlocksOf = (css: string, selRe: RegExp): string[] => {
+  const blocks: string[] = []
+  const ruleRe = /([^{}]+)\{([^}]*)\}/g
+  let match: RegExpExecArray | null
+  while ((match = ruleRe.exec(css)) !== null) {
+    if (selRe.test(match[1])) blocks.push(match[2])
+  }
+  return blocks
+}
