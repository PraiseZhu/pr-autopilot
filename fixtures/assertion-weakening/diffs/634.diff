+// 重挂载竞态(审查席实测复现):PluginApp 每次重新挂载都会让 [hydrated] effect
+// 重跑一次 maybeShowChangelogAutoPopup。模块级「本会话已判定」标志保证一次
+// 会话只判一次——否则上一次判定写入的基线若尚未落盘(异步 IDB 写),重挂载后
+// rehydrate 把旧值合并回来,同一版本会弹两次。
+describe('重挂载竞态:一个会话只判一次,基线未落盘也不二次弹窗(渲染层)', () => {
+  beforeEach(async () => {
+    ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+    await renderEnv()
+  })
+  afterEach(teardownRender)
+
+  it('第一次判定已弹窗、基线写入未落盘时重挂载 → 不再第二次弹窗', async () => {
+    await seedPersisted({ lastRead: '', lastSeenVersion: 'A' })
+    // gate 住本次基线写入(strictIdbStateStorage.setItem 是 persist 落盘的
+    // 最后一道门),模拟真实 async IO 未落盘——审查席的复现手法。放行前先记下
+    // 原实现,gate 解除后仍走真实写入,不留悬空 promise。
+    let releaseWrite!: () => void
+    const gate = new Promise<void>((resolve) => {
+      releaseWrite = resolve
+    })
+    const originalSetItem = strictIdbStateStorage.setItem
+    vi.spyOn(strictIdbStateStorage, 'setItem').mockImplementation(async (name, value) => {
+      if (name === PERSIST_KEY) await gate
+      return originalSetItem(name, value)
+    })
+    try {
+      await mountPlugin()
+      await waitHydratedApp()
+      // 第一次判定:持久化 A ≠ env B → 弹窗;基线 'B' 的写入被 gate 住,尚未落盘。
+      expect(await waitFor(() => document.querySelector('.changelog-backdrop') !== null, 5_000)).toBe(true)
+
+      // 写入完成前 unmount + remount:重挂载走真实 hydration(rehydrate 无条件
+      // 重跑),IDB 里仍是旧基线 'A',未落盘的 'B' 覆盖不了它——内存基线回到 'A'。
+      act(() => root.unmount())
+      container.remove()
+      container = document.createElement('div')
+      document.body.appendChild(container)
+      root = createRoot(container)
+      await mountPlugin()
+      await waitHydratedApp()
+      // 模块级标志存在:本会话已判定,直接跳过,不二次弹窗。反向变异(去掉标志)
+      // 时,第二次判定读到 'A' ≠ 'B' 会再弹一次,本断言转红——恰好红这一条。
+      expect(document.querySelector('.changelog-backdrop'), '基线未落盘时重挂载不得二次弹窗').toBeNull()
+    } finally {
+      // 无论断言成败都放行被 gate 的写入并还原 spy:断言失败(反向变异)时若
+      // 把 gate 留在原位,后一用例的 seedPersisted 会挂死在同一个 gate 上,
+      // 让变异多红一条、掩盖「恰好红 1 条」的判定。
+      releaseWrite()
+      await flushPersistWrites()
+      vi.restoreAllMocks()
+    }
+  })
+})
