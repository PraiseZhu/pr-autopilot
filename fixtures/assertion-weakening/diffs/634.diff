+// @vitest-environment happy-dom
+//
+// port-sc7-persist-wired-both-hooks 集成用例(**不 mock usePluginHydration**):
+// changelogStore 的 persist 分区必须在两个装配点被显式接线——cindyplugin 的
+// usePluginHydration 与 src/app 的 useStoreHydration。本文件两侧各挂一个真实 hook,
+// 各自必须有独立的反向变异红。
+//
+// 时序设计(保证反向变异必红):
+// 1. 文件加载时 import changelogStore → persist 中间件**自动 rehydrate**(该分区无
+//    skipHydration)对空库跑一次,lastRead 停留默认空串;顶层 waitFor
+//    persist.hasHydrated() 确定性等它 settle——否则自动 rehydrate 的 getItem 排到
+//    预写之后就会把 lastRead 恢复出来,删掉装配点接线照样绿,变异将不红。
+// 2. beforeEach 用生产 strictIdbStateStorage(与 changelogStore 同一实例、无 auth
+//    命名空间——SC 要求的独立 IDB key 形态)预写 mivo-changelog-lastread 信封,
+//    回读校验真实落盘(防假成功)。
+// 3. 驱动真实 hook 到 hydrated=true → 断言 useChangelogStore.getState().lastRead
+//    正是预写值而非默认空串。预写之后唯一能读到它的路径就是装配点里那条
+//    rehydrate()。
+//
+// 反向变异:删 usePluginHydration 里那条 → 插件侧用例红、网页侧用例保持绿;
+// 删 useStoreHydration 里那条 → 反过来。两红互相独立,一条断言兼顾两边不算通过。
+//
+// lastSeenVersion 刻意不断言:该字段由 wave 2 的 pop-sc1 引入并承接,本 SC 断言它
+// 会与 pop-sc1 成环(执行期实证的死锁)。
+import 'fake-indexeddb/auto'
+import { act, useEffect } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+// ── 宿主桥桩(测试环境无宿主 IPC)────────────────────────────────────
+// 这些模块依赖 bridge.persistRequest,桩掉不影响本测试的唯一观测链:
+// hook 本体真实执行 → Promise.all → useChangelogStore.persist.rehydrate()
+// → changelogLastReadStorage(strictIdbStateStorage,真实)→ fake-indexeddb。
+vi.mock('../persist/persistSync', () => ({
+  restoreFromDiskIfEmpty: vi.fn(async () => 'empty'),
+  startAutoSave: vi.fn(),
+}))
+vi.mock('../agent/pendingWriteDrain', () => ({
+  drainPendingCanvasWrites: vi.fn(async () => ({
+    outcome: 'empty',
+    applied: 0,
+    rejected: 0,
+    expired: 0,
+    superseded: 0,
+    deferredByBinding: 0,
+    queueFull: false,
+  })),
+}))
+// useStoreHydration 侧:无宿主时 /api/auth/me 不可达;fetchMe 桩成已认证用户,让
+// auth.hydrate 走 'ok' 路径(Promise.all 才执行)。changelog 键走 strictIdbStateStorage
+// (无 auth 命名空间,插件侧刻意不调 authStore.hydrate),不受 uid 影响。
+const { fetchMeMock } = vi.hoisted(() => ({ fetchMeMock: vi.fn() }))
+vi.mock('../../../src/lib/authClient', () => ({
+  fetchMe: fetchMeMock,
+  AuthError: class AuthError extends Error {},
+}))
+// fire-and-forget 的 settle 会发网络请求,桩成 no-op
+vi.mock('../../../src/store/chatTaskReconcile', () => ({
+  reconcileExpiredChatTasks: vi.fn(async () => undefined),
+}))
+
+const {
+  strictIdbStateStorage,
+  __resetIdbPersist,
+  __resetIdbOperationalProbeForTests,
+} = await import('../../../src/lib/persistIdbStorage')
+const { __resetKernelDegradationForTests } = await import('../../../src/app/kernelMode')
+const { useChangelogStore } = await import('../../../src/store/changelogStore')
+const { usePluginHydration } = await import('../usePluginHydration')
+const { useStoreHydration } = await import('../../../src/app/useStoreHydration')
+
+const PERSIST_KEY = 'mivo-changelog-lastread'
+// 两侧刻意用**不同的** ISO:两个 describe 共享同一 store 实例与同一 IDB 库,
+// 上一条用例的接线 rehydrate 会把 lastRead 内存态留在自己的值上——若两侧同值,
+// 「预写后无接线读取」会被残留内存态撑成假绿(变异 2 假绿实测翻车)。值不同时
+// 残留值 ≠ 本侧断言值,删接线必红。
+const ISO_PLUGIN = '2026-08-11T10:00:00.000Z'
+const ISO_WEB = '2026-08-11T11:00:00.000Z'
+// 与生产 migrateLegacyLastRead / zustand persist 同款信封
+const envelopeFor = (iso: string): string => JSON.stringify({ state: { lastRead: iso }, version: 0 })
+
+const waitFor = async (predicate: () => boolean, timeoutMs: number, intervalMs = 25): Promise<boolean> => {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (predicate()) return true
+    await new Promise((resolve) => setTimeout(resolve, intervalMs))
+  }
+  return predicate()
+}
+
+// 自动 rehydrate 必须确定性地在预写之前 settle(见文件头注释)。
+await waitFor(() => useChangelogStore.persist.hasHydrated(), 5_000)
+expect(useChangelogStore.getState().lastRead).toBe('') // 前提自检:自动 rehydrate 读到的是空库
+
+const observed = { hydrated: false }
+
+function PluginHarness() {
+  const hydrated = usePluginHydration()
+  useEffect(() => {
+    observed.hydrated = hydrated
+  }, [hydrated])
+  return null
+}
+
+function StoreHarness() {
+  const hydrated = useStoreHydration()
+  useEffect(() => {
+    observed.hydrated = hydrated
+  }, [hydrated])
+  return null
+}
+
+/** 用生产 strictIdbStateStorage(与 changelogStore 同一实例)预写分区信封,
+ *  写后回读校验真实落盘(fake-indexeddb 下不会失败,但断言在就防假成功)。 */
+const seedPersistedLastRead = async (iso: string): Promise<void> => {
+  const envelope = envelopeFor(iso)
+  await strictIdbStateStorage.setItem(PERSIST_KEY, envelope)
+  expect(await strictIdbStateStorage.getItem(PERSIST_KEY)).toBe(envelope)
+}
+
+let container: HTMLDivElement | undefined
+let root: Root | undefined
+
+const mountHarness = async (harness: React.JSX.Element): Promise<void> => {
+  ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+  await act(async () => {
+    root!.render(harness)
+  })
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 0))
+  })
+}
+
+const teardown = (): void => {
+  act(() => root?.unmount())
+  container?.remove()
+  container = undefined
+  root = undefined
+}
+
+describe('port-sc7: usePluginHydration 装配点(插件侧水合门)', () => {
+  beforeEach(async () => {
+    await __resetIdbPersist()
+    __resetIdbOperationalProbeForTests()
+    __resetKernelDegradationForTests()
+    observed.hydrated = false
+  })
+  afterEach(teardown)
+
+  it('预写 lastRead → 真实 hook hydrated=true 后 lastRead 恢复为预写值', async () => {
+    await seedPersistedLastRead(ISO_PLUGIN)
+    await mountHarness(<PluginHarness />)
+    expect(await waitFor(() => observed.hydrated, 5_000)).toBe(true)
+    expect(useChangelogStore.getState().lastRead).toBe(ISO_PLUGIN)
+  })
+})
+
+describe('port-sc7: useStoreHydration 装配点(网页侧水合门,同构用例)', () => {
+  beforeEach(async () => {
+    await __resetIdbPersist()
+    __resetIdbOperationalProbeForTests()
+    __resetKernelDegradationForTests()
+    observed.hydrated = false
+    fetchMeMock.mockReset()
+    fetchMeMock.mockResolvedValue({ authenticated: true, user: { id: 'user-u', name: 'U' } })
+  })
+  afterEach(teardown)
+
+  it('预写 lastRead → auth ok 后真实 hook hydrated=true,lastRead 恢复为预写值', async () => {
+    await seedPersistedLastRead(ISO_WEB)
+    await mountHarness(<StoreHarness />)
+    expect(await waitFor(() => observed.hydrated, 10_000)).toBe(true)
+    expect(useChangelogStore.getState().lastRead).toBe(ISO_WEB)
+  })
+})
