+// @vitest-environment happy-dom
+//
+// changelog-port 需求⑤「插件版每次更新版本后自动弹更新公告」(优先级
+// p2-auto-popup,组 g3)的验收:
+//  · pop-sc1-version-injectable:版本由函数参数注入(默认实参取
+//    import.meta.env.VITE_MIVO_VERSION),持久化 lastSeenVersion 与 lastRead
+//    同一 persist 分区;
+//  · pop-sc2-first-install-silent:首装(持久化无 lastSeenVersion)静默写基线,
+//    不弹;
+//  · pop-sc3-reuse-panel-class-not-values:自动弹出复用 ChangelogPanel 与
+//    .changelog-panel 类,本 PR 对 src/App.css 零改动、不引入几何声明;
+//  · pop-sc4-two-states-independent(wave 4 验证组):lastRead(红点,比对
+//    updatedAt)与 lastSeenVersion(自动弹窗,比对包版本)同分区存储但互不读写
+//    ——改一个不影响另一个;同版本关闭后重新挂载不再弹。②③ 必须经
+//    maybeShowChangelogAutoPopup 真实路径观测(变异打点在弹窗代码上),store
+//    直设断言对变异不可见。
+//
+// 渲染侧:真实渲染 PluginApp(usePluginHydration 真实执行,外围 persistSync /
+// pendingWriteDrain / authClient 桩掉,与 pluginChangelogHydration.test.tsx
+// 同款装配),版本经 vi.stubEnv 注入 import.meta.env.VITE_MIVO_VERSION——
+// PluginApp 的自动弹窗接线调 maybeShowChangelogAutoPopup() 的默认实参,桩
+// env 即注入版本。不 mock useChangelogStore(生产 store + 真实 persist +
+// fake-indexeddb)。
+//
+// 水合侧:**不 mock 两个水合门 hook**,真实 rehydrate + fake-indexeddb 预写
+// (与 pluginChangelogHydration.test.tsx 同构),验 lastSeenVersion 随两个水合
+// 门存活,并含 partialize 写侧锚点(zustand persist 读侧是浅合并 persisted
+// 全部键,与 partialize 无关——「去掉 partialize 字段」的变异只能靠写侧断言
+// 转红)。
+//
+// 假绿防护(与 pluginChangelogHydration.test.tsx 同款教训):本文件多个 describe
+// 共享同一 store 实例与同一 fake IDB 库,清 IDB 不清内存——上一条用例的接线
+// rehydrate / setState 会把值留在内存,残留值会把「无接线/无字段仍通过」的
+// 用例撑成假绿。因此:① 每用例 beforeEach 清 IDB + 清内存(resetStore);
+// ② 水合侧插件/网页两侧刻意用**不同**的 lastRead ISO 与 lastSeenVersion 值,
+// 残留值 ≠ 本侧断言值,删接线必红。
+import 'fake-indexeddb/auto'
+import { execFileSync } from 'node:child_process'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { act, createElement, useEffect, type ReactElement } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { readGuardBaseFile, resolveGuardBase } from './mergeBaseGuard'
+import { CHANGELOG_RULE_RE, scanAddedGeometryViolations, scanBlocksForGeometry } from './changelogGeometryGuard'
+
+// happy-dom 环境下 Vite 会把 new URL(rel, import.meta.url) 静态转换成
+// http://localhost:3000/...(dev-server 资产 URL 模式),fileURLToPath 直接炸。
+// 改用 Node 原生 import.meta.dirname(测试文件自身目录)做相对路径。
+const here = (import.meta as unknown as { dirname: string }).dirname
+
+// ── 宿主桥桩(测试环境无宿主 IPC / 网络)────────────────────────────────────
+// 渲染 PluginApp 时 usePluginHydration 真实执行,其依赖的磁盘恢复 / 延迟写入
+// drain 是宿主能力,桩成 no-op;唯一观测链是 hydration → hydrated=true →
+// PluginApp 的自动弹窗 effect。网页侧 useStoreHydration 的 auth /me 与
+// fire-and-forget reconcile 同样桩掉(与 pluginChangelogHydration.test.tsx 同款)。
+vi.mock('../persist/persistSync', () => ({
+  restoreFromDiskIfEmpty: vi.fn(async () => 'empty'),
+  startAutoSave: vi.fn(),
+}))
+vi.mock('../agent/pendingWriteDrain', () => ({
+  drainPendingCanvasWrites: vi.fn(async () => ({
+    outcome: 'empty',
+    applied: 0,
+    rejected: 0,
+    expired: 0,
+    superseded: 0,
+    deferredByBinding: 0,
+    queueFull: false,
+  })),
+}))
+vi.mock('../../../src/canvas/MivoCanvas', () => ({
+  MivoCanvas: () => null,
+}))
+vi.mock('../../../src/app/ToastViewport', () => ({ ToastViewport: () => null }))
+vi.mock('../../../src/app/MediaLightbox', () => ({ MediaLightbox: () => null }))
+vi.mock('../../../src/app/DetailsTargetGuard', () => ({ DetailsTargetGuard: () => null }))
+vi.mock('../agent/depositMigration', () => ({
+  migrateLedgerIntoDepositStore: vi.fn(async () => ({ ok: true, skipped: true })),
+}))
+// 网页侧 useStoreHydration 依赖(auth /me + settle 网络请求)
+const { fetchMeMock } = vi.hoisted(() => ({ fetchMeMock: vi.fn() }))
+vi.mock('../../../src/lib/authClient', () => ({
+  fetchMe: fetchMeMock,
+  AuthError: class AuthError extends Error {},
+}))
+vi.mock('../../../src/store/chatTaskReconcile', () => ({
+  reconcileExpiredChatTasks: vi.fn(async () => undefined),
+}))
+// PluginApp 在 hydrated 后调用 loadChangelog()(fetch /changelog.json):stub 成
+// 空文档,避免真实网络请求与 toast 副作用。
+vi.stubGlobal(
+  'fetch',
+  vi.fn(async () => ({ ok: true, json: async () => ({}) })),
+)
+
+// 版本 env 桩**必须在 changelogAutoPopup.ts 求值之前生效**(模块作用域,而非用例
+// 体内)。原因:反向变异「把版本改成模块内直读 env」(pop-sc1 ③ 的变异)把 env
+// 读取移到模块加载期——若在用例体内才 stubEnv,变异下模块加载时 env 还是
+// undefined,行为用例(①②、pop-sc2)会跟着红,变异就红了多条而不是恰好红 ③。
+// 桩在 import 前 → 变异下模块捕获到的也是 'B',行为用例保持绿,只有 ③ 的
+// 源码级计数转红。所有渲染用例共用固定版本 'B',「不同版本」由预写的持久化值
+// 承担(seed 'A' + env 'B' → 弹;seed 'B' + env 'B' → 不弹;seed '' + env 'B' → 基线)。
+vi.stubEnv('VITE_MIVO_VERSION', 'B')
+
+const { PluginApp } = await import('../PluginApp')
+const { maybeShowChangelogAutoPopup, __resetChangelogAutoPopup } = await import('../changelogAutoPopup')
+const { selectHasUnreadChangelog, useChangelogStore } = await import('../../../src/store/changelogStore')
+const { usePluginHydration } = await import('../usePluginHydration')
+const { useStoreHydration } = await import('../../../src/app/useStoreHydration')
+const {
+  strictIdbStateStorage,
+  __resetIdbPersist,
+  __resetIdbOperationalProbeForTests,
+} = await import('../../../src/lib/persistIdbStorage')
+const { __resetKernelDegradationForTests } = await import('../../../src/app/kernelMode')
+
+const PERSIST_KEY = 'mivo-changelog-lastread'
+// pop-sc3 ②③ 的 git diff 断言基准在运行时解析,复用仓内 mergeBaseGuard 的三档
+// fail-closed 语义(与 depositBrain/cardManifest 同一份实现,禁止各自内联漂移):
+//  ① CI 且基准不可读 → throw(门禁在做不到本职时必须红,不许静默通过);
+//  ② 显式 MIVO_GUARD_BASE_SHA 指定但读不出 → 本地与 CI 都 throw(配置错误);
+//  ③ 仅本地、未显式指定且确实取不到 → warn + ctx.skip(跳过要看得见)。
+// 用例②走 readGuardBaseFile(读 base 处 App.css,与 HEAD 处 blob 逐字节比较——
+// diff base..HEAD 为空 ⟺ 两侧 blob 相同);用例③走 resolveGuardBase 再 git diff,
+// **不 catch git 错误**:显式坏 base 时 execFileSync 抛错,用例直接判红。
+const gitRaw = (args: string[]): string => execFileSync('git', args, { encoding: 'utf8' })
+const gitTrim = (args: string[]): string => gitRaw(args).trim()
+
+const waitFor = async (predicate: () => boolean, timeoutMs: number, intervalMs = 25): Promise<boolean> => {
+  const deadline = Date.now() + timeoutMs
+  while (Date.now() < deadline) {
+    if (predicate()) return true
+    await new Promise((resolve) => setTimeout(resolve, intervalMs))
+  }
+  return predicate()
+}
+
+// 自动 rehydrate(该分区无 skipHydration)在文件 import 时对空库跑一次,必须
+// 确定性地 settle 在预写之前——否则预写被自动 rehydrate 覆盖,「预写后无接线
+// 读取」会被假撑(与 pluginChangelogHydration.test.tsx 同款防假绿)。
+await waitFor(() => useChangelogStore.persist.hasHydrated(), 5_000)
+expect(useChangelogStore.getState().lastRead).toBe('')
+expect(useChangelogStore.getState().lastSeenVersion).toBe('')
+
+const resetStore = () => {
+  useChangelogStore.setState({ entries: [], updatedAt: '', loaded: false, lastRead: '', lastSeenVersion: '' })
+}
+
+/** 用生产 strictIdbStateStorage 预写分区信封,写后回读校验真实落盘(防假成功)。 */
+const seedPersisted = async (state: { lastRead: string; lastSeenVersion: string }): Promise<void> => {
+  const envelope = JSON.stringify({ state, version: 0 })
+  await strictIdbStateStorage.setItem(PERSIST_KEY, envelope)
+  expect(await strictIdbStateStorage.getItem(PERSIST_KEY)).toBe(envelope)
+}
+
+const flushPersistWrites = async (): Promise<void> => {
+  // persist 拦截 setState 后经 changelogLastReadStorage.setItem 写 + 回读比对
+  // 两跳 microtask,必须等它完全落定再预写/断言,否则 reset 的写会晚到覆盖。
+  await new Promise((resolve) => setTimeout(resolve, 0))
+}
+
+/** 从 setItem spy 的调用记录里取落盘信封(参数 1 是 zustand persist 信封串)。 */
+const persistedEnvelope = (call: [name: string, value: string]): { state: Record<string, unknown> } =>
+  JSON.parse(call[1]) as { state: Record<string, unknown> }
+
+// ── 渲染装配(真实 PluginApp + 真实 hydration)──────────────────────────────
+let container: HTMLDivElement
+let root: Root
+
+const mountPlugin = async (): Promise<void> => {
+  await act(async () => {
+    root.render(createElement(PluginApp))
+  })
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 0))
+  })
+}
+
+/** hydrated 完成 = 主内容(.mivo-app)挂载,之后自动弹窗 effect 已随提交跑完。 */
+const waitHydratedApp = async (): Promise<void> => {
+  expect(await waitFor(() => container.querySelector('.mivo-app') !== null, 5_000)).toBe(true)
+  await act(async () => {}) // flush effect 产生的 setState 提交
+}
+
+const teardownRender = (): void => {
+  // 注意:不调 vi.unstubAllEnvs —— env 桩是模块作用域的一个固定值(见顶部),
+  // 逐用例卸载会让后续用例的模块默认参读不到 'B'。
+  act(() => root?.unmount())
+  container?.remove()
+  document.querySelector('.changelog-backdrop')?.remove()
+}
+
+const renderEnv = async (): Promise<void> => {
+  vi.restoreAllMocks()
+  await __resetIdbPersist()
+  __resetIdbOperationalProbeForTests()
+  __resetKernelDegradationForTests()
+  __resetChangelogAutoPopup()
+  resetStore()
+  await flushPersistWrites()
+  container = document.createElement('div')
+  document.body.appendChild(container)
+  root = createRoot(container)
+}
+
+// ── 水合装配(真实 hook,仿 pluginChangelogHydration.test.tsx)────────────────
+const observed = { hydrated: false }
+
+function PluginHarness() {
+  const hydrated = usePluginHydration()
+  useEffect(() => {
+    observed.hydrated = hydrated
+  }, [hydrated])
+  return null
+}
+
+function StoreHarness() {
+  const hydrated = useStoreHydration()
+  useEffect(() => {
+    observed.hydrated = hydrated
+  }, [hydrated])
+  return null
+}
+
+let harnessContainer: HTMLDivElement | undefined
+let harnessRoot: Root | undefined
+
+const mountHarness = async (harness: ReactElement): Promise<void> => {
+  ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+  harnessContainer = document.createElement('div')
+  document.body.appendChild(harnessContainer)
+  harnessRoot = createRoot(harnessContainer)
+  await act(async () => {
+    harnessRoot!.render(harness)
+  })
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 0))
+  })
+}
+
+const teardownHarness = (): void => {
+  vi.restoreAllMocks()
+  act(() => harnessRoot?.unmount())
+  harnessContainer?.remove()
+  harnessContainer = undefined
+  harnessRoot = undefined
+}
+
+// ─────────────────────────────────────────────────────────────────────────
+describe('pop-sc1 版本比对(渲染层,stubEnv 注入版本)', () => {
+  beforeEach(async () => {
+    ;(globalThis as unknown as Record<string, unknown>).IS_REACT_ACT_ENVIRONMENT = true
+    await renderEnv()
+  })
+  afterEach(teardownRender)
+
+  it('① env B + 持久化里是 B → 不弹(不出现 .changelog-backdrop)', async () => {
+    await seedPersisted({ lastRead: '', lastSeenVersion: 'B' })
+    await mountPlugin()
+    await waitHydratedApp()
+    expect(document.querySelector('.changelog-backdrop'), '同版本不弹').toBeNull()
+    expect(useChangelogStore.getState().lastSeenVersion).toBe('B')
+  })
+
+  it('② env B + 持久化里是 A → 弹,且弹出后版本基线更新为 B', async () => {
+    await seedPersisted({ lastRead: '', lastSeenVersion: 'A' })
+    await mountPlugin()
+    await waitHydratedApp()
+    expect(await waitFor(() => document.querySelector('.changelog-backdrop') !== null, 5_000)).toBe(true)
+    // 弹出后基线更新为 'B'(env 版本)。**不做落盘信封断言**——落盘形态
+    // (partialize 含 lastSeenVersion)由 pop-sc1 ④ 的写侧锚点独占,这里若断
+    // 信封,「partialize 去掉该字段」的变异会让本条一起红,④ 的变异就红了两条,
+    // 违反「恰好红 1 条」。
+    expect(useChangelogStore.getState().lastSeenVersion).toBe('B')
+  })
