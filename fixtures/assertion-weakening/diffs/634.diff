+// 更新公告「自动弹窗」判定(changelog-port 需求⑤,优先级 p2-auto-popup)。
+//
+// 职责:hydration 完成后比对「当前版本」与持久化的 lastSeenVersion,返回是否
+// 该弹公告面板——真正的面板挂载由 PluginApp 的接线负责,与手动 Flame 入口
+// (openChangelog)共用同一个渲染入口与同一套关闭路径(backdrop pointerdown /
+// 面板内关闭按钮,pop-sc3-reuse-panel-class-not-values)。
+//
+// 版本由**函数参数注入**:默认实参取 import.meta.env.VITE_MIVO_VERSION
+// (cindyplugin/vite.config.ts 的 resolvePluginAppVersion——build 取 ghost.json
+// 的 version,serve 恒为 'cindy-plugin-dev')。模块内部除默认实参外不直接读
+// env:dev 下版本永不变化,本地弹一次之后再也不弹;单测里 env 也不是可靠的
+// 驱动手段。版本可注入之后,测试才能真的构造出「版本变了」这个条件
+// (pop-sc1-version-injectable;源码级门禁见 __tests__/changelogAutoPopup.test.ts
+// 的 import.meta.env 静态扫描)。
+import { useChangelogStore } from '../../src/store/changelogStore'
+import { debugLogger } from '../../src/store/debugLogStore'
+
+const SOURCE = 'Changelog'
+
+// 模块级「本会话已判定」标志。与 canvasWriteGate 的 hydrationComplete 同形态
+// (模块级状态跨组件挂载存活),但**没有**与之配对的 begin 复位:canvasWriteGate
+// 每轮 hydration 开始要复位,是因为它的判据是「本轮是否完成」;这里判据是
+// 「本会话是否已判定」,面板重新挂载(面板重开 / 热重载 / 宿主重挂)必须**继续**
+// 跳过——复位会重新打开竞态窗口。
+let autoPopupDecided = false
+
+/**
+ * 自动弹窗判定。返回 true = 应该弹面板(当前版本 ≠ 持久化的 lastSeenVersion);
+ * false = 不弹。
+ *
+ * 四条分支都记 Debug Log(docs/development-logging.md:「跳过不可用路径的操作
+ * 都必须写 Debug Log」)——本函数每次 hydration 后必跑一次,首装跳过与同版本
+ * 跳过若不留痕,「这次启动到底判了哪条分支」在诊断时无从查起(与
+ * usePluginHydration.ts 的 `disk restore: <mode>` 同一惯例:每次都记,不只记
+ * 异常分支)。
+ *
+ * · 首次安装(持久化没有 lastSeenVersion):静默把当前版本写入持久化作为基线,
+ *   不弹——首装弹「更新公告」没有意义,用户没有上一版可对比,第一次打开画布
+ *   就被全屏遮罩挡住是负体验(pop-sc2-first-install-silent);基线这一步不能省,
+ *   省了下次启动仍是空值,会在第二次启动时误弹。
+ * · 版本不同:弹,并立即把当前版本写进持久化——下次同版本启动不再弹。
+ * · 版本相同:不弹。
+ * · 本会话已判定过(模块级标志已置位):直接跳过,不重复判定。
+ */
+export const maybeShowChangelogAutoPopup = (
+  version: string = import.meta.env.VITE_MIVO_VERSION,
+): boolean => {
+  // 一个浏览器会话只判一次,置位在**入口**而不是判定之后。版本在运行时不会
+  // 变化(build 时由 vite.config.ts 的 resolvePluginAppVersion 注入,serve 恒为
+  // 'cindy-plugin-dev'),所以「判过就跳过」不会漏掉真实的版本变化。而组件局部
+  // 状态(usePluginHydration 的 useState)跨挂载不存活,PluginApp 每次重新挂载
+  // 都会让 [hydrated] effect 重跑一次本函数——若每次都重判,上一次判定写入的
+  // 基线(lastSeenVersion)在异步 IDB 写尚未落盘时(重挂载后 rehydrate 把旧值
+  // 合并回来),同一版本会弹两次。入口置位保证写入在途时的第二次挂载也跳过,
+  // 这正是竞态窗口。
+  if (autoPopupDecided) {
+    debugLogger.log(SOURCE, 'already decided this session, auto popup skipped')
+    return false
+  }
+  autoPopupDecided = true
+  const { lastSeenVersion } = useChangelogStore.getState()
+  if (lastSeenVersion === '') {
+    useChangelogStore.setState({ lastSeenVersion: version })
+    debugLogger.log(SOURCE, `first install: wrote baseline version "${version}", auto popup skipped`)
+    return false
+  }
+  if (lastSeenVersion !== version) {
+    useChangelogStore.setState({ lastSeenVersion: version })
+    debugLogger.log(SOURCE, `version changed "${lastSeenVersion}" -> "${version}", showing auto popup`)
+    return true
+  }
+  debugLogger.log(SOURCE, `version unchanged ("${version}"), auto popup skipped`)
+  return false
+}
+
+/**
+ * 仅供测试:模块级判定标志跨用例泄漏,每用例 beforeEach 归零(命名与导出风格
+ * 照 persistIdbStorage.ts 的 __resetIdbPersist)。
+ */
+export const __resetChangelogAutoPopup = (): void => {
+  autoPopupDecided = false
+}
