+// snapshotCursorStore.test — #509 per-canvas holder cleanup.
+//
+// The holder is a module-level only-grows Map (one bundle cursor per hydrated
+// canvas). deleteCanvasCursor is the deleteCanvas-path cleanup: the deleted
+// canvas's cursor must disappear while other canvases' cursors stay intact.
+
+import { afterEach, describe, expect, it } from 'vitest'
+import {
+  deleteCanvasCursor,
+  getCanvasCursor,
+  storeCanvasCursor,
+  __resetCanvasCursorStore,
+} from './snapshotCursorStore'
+import type { GetCanvasResponse } from '../../shared/persist-contract.ts'
+
+const fakeResponse = (id: string): GetCanvasResponse =>
+  ({
+    id,
+    contentVersion: 3,
+    sinceSeq: 7,
+    nodes: [{ id: 'n1', base: 'base-n1' }],
+    edges: [],
+    anchors: [],
+  }) as unknown as GetCanvasResponse
+
+afterEach(() => {
+  __resetCanvasCursorStore()
+})
+
+describe('deleteCanvasCursor (#509)', () => {
+  it('removes only the deleted canvas cursor; unrelated cursors survive', () => {
+    storeCanvasCursor(fakeResponse('canvas-a'))
+    storeCanvasCursor(fakeResponse('canvas-b'))
+    expect(getCanvasCursor('canvas-a')).toBeDefined()
+    expect(getCanvasCursor('canvas-b')).toBeDefined()
+
+    deleteCanvasCursor('canvas-a')
+
+    expect(getCanvasCursor('canvas-a')).toBeUndefined()
+    expect(getCanvasCursor('canvas-b')).toBeDefined()
+  })
+
+  it('is a safe no-op for a canvas that never stored a cursor', () => {
+    expect(() => deleteCanvasCursor('never-seen')).not.toThrow()
+    expect(getCanvasCursor('never-seen')).toBeUndefined()
+  })
+})
