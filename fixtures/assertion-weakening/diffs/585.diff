+// assetGc — #509 client-side imported-asset GC (P2-1 of the canvas-scale perf epic #517).
+//
+// Problem: deleteNode / deleteSelectedNodes only filter the node arrays; nothing ever
+// removes the referenced blobs from the `mivo-canvas-assets` IDB store, so import →
+// delete → re-import grows IDB monotonically (P2-0 bench: after-delete IDB bytes never
+// fall). deleteImportedAsset only serves explicit replace-image rollbacks.
+//
+// Model — idle-time orphan sweep with a grace window, aligned with the server store
+// (server/lib/assetStore.ts): the refcount is DERIVED from a full reference scan (a
+// reference table, never a stored counter — nothing can drift), and a zero-ref record
+// is first STAMPED (lastRefZeroAt), only physically deleted once the stamp outlives
+// ASSET_GRACE_PERIOD (7 days, same value as the server). A reference reappearing
+// during grace (undo / redo / paste / archive restore) clears the stamp.
+//
+// The reference surface (collectReferencedAssetUrls):
+// - every canvas document in the store (state.canvases — local persist mode keeps ALL
+//   canvases, including archived ones, fully materialized), node.assetUrl + image fills;
+// - the active-canvas mirrors (state.nodes) and the in-store node clipboard;
+// - BOTH history stacks — a deleted node sitting inside the 60-step undo window keeps
+//   its asset referenced, which is exactly the "undo must still resolve the asset"
+//   acceptance: eviction from the stacks (60 more edits, or a reload — history is not
+//   persisted) is what starts the grace clock, and the grace window bridges the rest;
+// - chat messages' generationContext.referenceAssetUrls (persisted; retry replays them).
+//
+// Safety gates (why deletes are hard to reach, in order):
+// 1. Only records owned by the CURRENT persist user are ever touched (FX-6 namespace);
+//    untagged legacy records are left for migrateUntaggedAssets to claim.
+// 2. A delete needs a mark from a PREVIOUS sweep to have aged past the grace window —
+//    a single sweep can never mark-and-delete in one pass.
+// 3. Before any physical delete, the sweep re-reads the PERSISTED canvas + chat blobs
+//    (cross-tab truth: another tab's flushed state) and resurrects instead of deleting
+//    when the blob still references the asset. If the blobs cannot be read or parsed,
+//    every delete is withheld (fail-closed) — marks are self-healing, deletes are not.
+// 4. Immediately before the commit, the sweep re-collects this tab's OWN live
+//    references one more time (R1-F1) — closing the TOCTOU window opened by the
+//    async reads above, so a paste/undo racing the sweep resurrects rather than
+//    loses its asset.
+// 5. applyAssetGcDecisions re-verifies each record inside the readwrite transaction
+//    (the client analogue of the server's deleteIfStillEligible under-lock re-check).
+//
+// Out of scope: mivo-sasset: (server refcount lifecycle, #313) and mivo-demo: (drawn
+// on demand, never stored) URLs — they are not IDB records, so the sweep never sees
+// them; the reference scan keeps raw strings and only ever queries mivo-asset: ids.
+
+import {
+  applyAssetGcDecisions,
+  importedAssetUrl,
+  readAssetGcIndex,
+} from './assetStorage'
+import { pruneImageMetricsForAssets } from './imageMetricsCache'
+import { debugLogger } from '../store/debugLogStore'
+
+const SOURCE = 'Asset GC'
+
+/** Grace window before an unreferenced asset's bytes are deleted — same 7 days as
+ *  server/lib/assetStore.ts ASSET_GRACE_PERIOD_MS (single-node undo + restore cover). */
+export const CLIENT_ASSET_GRACE_PERIOD_MS = 7 * 24 * 60 * 60 * 1000
+
+/** Structural node slice the reference scan needs (satisfied by MivoCanvasNode). */
+type RefNode = {
+  assetUrl?: string
+  fills?: Array<{ kind: string; assetUrl?: string }>
+}
+
+/** Structural canvas-store slice (satisfied by CanvasState). */
+export type AssetGcCanvasRefState = {
+  canvases: Record<string, { nodes: RefNode[] }>
+  nodes: RefNode[]
+  clipboardNodes: RefNode[]
+  historyPast: Array<{ nodes: RefNode[] }>
+  historyFuture: Array<{ nodes: RefNode[] }>
+}
+
+/** Structural chat-store slice (satisfied by ChatState). */
+export type AssetGcChatRefState = {
+  messagesByScene: Record<string, Array<{ generationContext?: { referenceAssetUrls?: string[] } }>>
+}
+
+export type AssetGcSweepOptions = {
+  /** Owner namespace — only records with userId === currentUserId are touched. */
+  currentUserId: string
+  getCanvasRefState: () => AssetGcCanvasRefState
+  getChatRefState: () => AssetGcChatRefState
+  /**
+   * Cross-tab truth for the delete phase: resolves to the reference set parsed from
+   * the PERSISTED canvas + chat blobs, or undefined when they cannot be read/parsed
+   * (→ every delete is withheld this pass). Only invoked when at least one record is
+   * delete-eligible, so the blob parse cost is never paid on mark/resurrect-only passes.
+   */
+  readPersistedBlobRefs: () => Promise<Set<string> | undefined>
+  now?: number
+  graceMs?: number
+}
+
+export type AssetGcSweepResult = {
+  /** #509 R1-F3: 'skipped' is distinct from a normal empty-store 'completed' pass —
+   *  it means the sweep never ran at all (e.g. persist mode gate), so a caller
+   *  reading `scanned: 0` can tell "verified empty" apart from "didn't look". */
+  status: 'completed' | 'failed' | 'skipped'
+  /** Records in the store (all owners). */
+  scanned: number
+  /** Records skipped because they belong to another user / are untagged. */
+  foreign: number
+  marked: number
+  resurrected: number
+  deleted: number
+  freedBytes: number
+  /** Delete-eligible records withheld because the persisted blobs were unreadable. */
+  deletesWithheld: number
+  /** Decisions dropped by the in-transaction re-verify (concurrent change). */
+  stale: number
+}
+
+const addNodeRefs = (nodes: RefNode[] | undefined, into: Set<string>) => {
+  if (!nodes) return
+  for (const node of nodes) {
+    if (node.assetUrl) into.add(node.assetUrl)
+    if (node.fills) {
+      for (const fill of node.fills) {
+        if (fill.kind === 'image' && fill.assetUrl) into.add(fill.assetUrl)
+      }
+    }
+  }
+}
+
+/**
+ * Collect every asset URL the app still references. Pure over the injected slices —
+ * unit tests feed literal state, the wiring feeds live store state. Keeps raw URL
+ * strings of every scheme (http/data/mivo-demo:/mivo-sasset: included); the sweep
+ * only ever asks membership for `mivo-asset:<id>` strings.
+ */
+export const collectReferencedAssetUrls = (
+  canvasState: AssetGcCanvasRefState,
+  chatState: AssetGcChatRefState,
+): Set<string> => {
+  const refs = new Set<string>()
+
+  for (const document of Object.values(canvasState.canvases || {})) {
+    addNodeRefs(document?.nodes, refs)
+  }
+  addNodeRefs(canvasState.nodes, refs)
+  addNodeRefs(canvasState.clipboardNodes, refs)
+  for (const snapshot of canvasState.historyPast || []) addNodeRefs(snapshot?.nodes, refs)
+  for (const snapshot of canvasState.historyFuture || []) addNodeRefs(snapshot?.nodes, refs)
+
+  for (const messages of Object.values(chatState.messagesByScene || {})) {
+    if (!messages) continue
+    for (const message of messages) {
+      for (const url of message?.generationContext?.referenceAssetUrls || []) {
+        if (url) refs.add(url)
+      }
+    }
+  }
+
+  return refs
+}
+
+/**
+ * Parse the persisted zustand blobs (canvas + chat envelopes: `{"state":{...}}`) into
+ * a reference set. Fail-closed by design: a null blob contributes nothing (fresh
+ * profile — this tab's in-memory refs already cover everything that exists), but a
+ * present-yet-unparseable blob, or one whose shape is not the expected envelope,
+ * returns undefined so the caller withholds every delete. Deleting on a mis-parse
+ * would be unrecoverable; skipping a pass is free.
+ */
+export const parsePersistedBlobRefs = (
+  canvasRaw: string | null,
+  chatRaw: string | null,
+): Set<string> | undefined => {
+  const canvasState: AssetGcCanvasRefState = {
+    canvases: {},
+    nodes: [],
+    clipboardNodes: [],
+    historyPast: [],
+    historyFuture: [],
+  }
+  const chatState: AssetGcChatRefState = { messagesByScene: {} }
+
+  if (canvasRaw !== null) {
+    try {
+      const parsed = JSON.parse(canvasRaw) as { state?: { canvases?: unknown } }
+      const canvases = parsed?.state?.canvases
+      if (!canvases || typeof canvases !== 'object' || Array.isArray(canvases)) return undefined
+      canvasState.canvases = canvases as AssetGcCanvasRefState['canvases']
+    } catch {
+      return undefined
+    }
+  }
+  if (chatRaw !== null) {
+    try {
+      const parsed = JSON.parse(chatRaw) as { state?: { messagesByScene?: unknown } }
+      const messagesByScene = parsed?.state?.messagesByScene
+      if (!messagesByScene || typeof messagesByScene !== 'object' || Array.isArray(messagesByScene)) {
+        return undefined
+      }
+      chatState.messagesByScene = messagesByScene as AssetGcChatRefState['messagesByScene']
+    } catch {
+      return undefined
+    }
+  }
+
+  return collectReferencedAssetUrls(canvasState, chatState)
+}
+
+/**
+ * Run one mark-and-sweep pass. Every outcome is logged (development-logging.md):
+ * a completed pass logs its counts, a pass that had to withhold deletes warns with
+ * the reason, and an exception logs an error and reports status 'failed'.
+ */
+export const runAssetGcSweep = async (options: AssetGcSweepOptions): Promise<AssetGcSweepResult> => {
+  const now = options.now ?? Date.now()
+  const graceMs = options.graceMs ?? CLIENT_ASSET_GRACE_PERIOD_MS
+  const result: AssetGcSweepResult = {
+    status: 'completed',
+    scanned: 0,
+    foreign: 0,
+    marked: 0,
+    resurrected: 0,
+    deleted: 0,
+    freedBytes: 0,
+    deletesWithheld: 0,
+    stale: 0,
+  }
+
+  try {
+    const index = await readAssetGcIndex()
+    result.scanned = index.length
+    if (index.length === 0) {
+      debugLogger.log(SOURCE, 'sweep completed: asset store is empty')
+      return result
+    }
+
+    const memRefs = collectReferencedAssetUrls(options.getCanvasRefState(), options.getChatRefState())
+
+    const markIds: string[] = []
+    const clearIds: string[] = []
+    const deleteCandidates: string[] = []
+    for (const entry of index) {
+      if (entry.userId !== options.currentUserId) {
+        // Another user's cache namespace (or an untagged pre-FX-6 record) — this
+        // sweep's reference scan cannot see their canvases, so it must never touch
+        // their records. Their own session sweeps them.
+        result.foreign += 1
+        continue
+      }
+      const referenced = memRefs.has(importedAssetUrl(entry.id))
+      if (referenced) {
+        if (entry.lastRefZeroAt !== undefined) clearIds.push(entry.id)
+        continue
+      }
+      if (entry.lastRefZeroAt === undefined) {
+        markIds.push(entry.id)
+      } else if (now - entry.lastRefZeroAt >= graceMs) {
+        deleteCandidates.push(entry.id)
+      }
+      // else: marked but still inside grace — leave the stamp untouched.
+    }
+
+    let deleteIds: string[] = []
+    if (deleteCandidates.length > 0) {
+      const blobRefs = await options.readPersistedBlobRefs()
+      if (blobRefs === undefined) {
+        // Fail-closed: without the persisted truth we cannot rule out another tab
+        // still referencing these assets. Withhold every delete; next pass retries.
+        result.deletesWithheld = deleteCandidates.length
+        debugLogger.warn(
+          SOURCE,
+          `sweep withheld ${deleteCandidates.length} grace-expired delete(s): persisted state unreadable (fail-closed)`,
+        )
+      } else {
+        for (const id of deleteCandidates) {
+          if (blobRefs.has(importedAssetUrl(id))) {
+            // The persisted blob (possibly another tab's flushed state) still
+            // references it — resurrect so a future orphaning restarts a FULL
+            // grace window instead of inheriting this long-expired stamp.
+            clearIds.push(id)
+          } else {
+            deleteIds.push(id)
+          }
+        }
+      }
+    }
+
+    // #509 R1-F1: re-collect THIS tab's live references immediately before the
+    // commit below — closes the TOCTOU window between the scans above (each of
+    // which awaited an async IDB/blob read, yielding the event loop) and the
+    // transaction. A paste / undo / drag-in that references one of these ids
+    // during that window must resurrect it, never let it fall through to delete.
+    // This narrows but does not fully close a cross-tab window bounded by the
+    // canvas/chat persist-write debounce (~800ms) — closing that fully would need
+    // a distributed lock spanning every tab's read-decide-write pipeline, not just
+    // this tab's own recheck.
+    if (deleteIds.length > 0) {
+      const freshMemRefs = collectReferencedAssetUrls(options.getCanvasRefState(), options.getChatRefState())
+      const stillEligible: string[] = []
+      for (const id of deleteIds) {
+        if (freshMemRefs.has(importedAssetUrl(id))) {
+          clearIds.push(id)
+        } else {
+          stillEligible.push(id)
+        }
+      }
+      deleteIds = stillEligible
+    }
+
+    const applied = await applyAssetGcDecisions({
+      markIds,
+      clearIds,
+      deleteIds,
+      now,
+      deleteEligibleBefore: now - graceMs,
+    })
+    result.marked = applied.marked
+    result.resurrected = applied.cleared
+    result.deleted = applied.deleted
+    result.freedBytes = applied.freedBytes
+    result.stale = applied.stale
+
+    if (applied.deletedIds.length > 0) {
+      // #509 R1-F1: prune exactly the ids ACTUALLY deleted (applied.deletedIds),
+      // never the candidate list — applyAssetGcDecisions' own in-transaction
+      // re-verify can drop any candidate into `stale` (e.g. a concurrent
+      // clearAssetsForUser or another tab's sweep touched the record between our
+      // recheck above and the transaction), and a stale (not-actually-deleted)
+      // asset must keep its cached natural size.
+      pruneImageMetricsForAssets(applied.deletedIds.map((id) => importedAssetUrl(id)))
+    }
+
+    debugLogger.log(
+      SOURCE,
+      `sweep completed: scanned ${result.scanned}, marked ${result.marked}, resurrected ${result.resurrected}, ` +
+        `deleted ${result.deleted} (${Math.round(result.freedBytes / 1024)} KiB), ` +
+        `withheld ${result.deletesWithheld}, foreign ${result.foreign}, stale ${result.stale}`,
+    )
+    return result
+  } catch (error) {
+    result.status = 'failed'
+    debugLogger.error(
+      SOURCE,
+      `sweep failed: ${error instanceof Error ? error.message : String(error)}`,
+    )
+    return result
+  }
+}
