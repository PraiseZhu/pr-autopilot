@@ -0,0 +1,423 @@
+// assetGc.test — #509 client asset GC acceptance anchors.
+//
+// The issue's two acceptance criteria are pinned here end-to-end against a real
+// (in-memory) IndexedDB, through the production import pipeline (saveImportedAsset)
+// and the production sweep (runAssetGcSweep → readAssetGcIndex/applyAssetGcDecisions):
+//   1. 导入 → 删 → (宽限/空闲) → IDB 记录回落(delete only after grace, with tests
+//      pinning both sides of the boundary);
+//   2. undo 恢复被删图片节点仍能取到资产 —— a deleted node sitting in the undo
+//      stacks keeps its asset referenced (never even marked), and a marked asset
+//      stays resolvable throughout the grace window.
+// Plus the safety gates: foreign-user records untouched, fail-closed delete
+// withholding when the persisted blobs are unreadable, cross-tab resurrect via the
+// persisted-blob reference set, and the no-mark-and-delete-in-one-pass invariant.
+
+import 'fake-indexeddb/auto'
+import { IDBFactory } from 'fake-indexeddb'
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest'
+
+vi.mock('./assetServiceMode', async (importActual) => {
+  const actual = await importActual<typeof import('./assetServiceMode')>()
+  return { ...actual, isAssetsServerMode: vi.fn(() => false) }
+})
+vi.mock('./assetService', () => ({
+  uploadAssetToServer: vi.fn(),
+  fetchServerAssetBlob: vi.fn(async () => null),
+}))
+vi.mock('../store/debugLogStore', () => ({
+  debugLogger: { log: vi.fn(), warn: vi.fn(), error: vi.fn() },
+}))
+const pruneImageMetricsForAssetsMock = vi.hoisted(() => vi.fn())
+vi.mock('./imageMetricsCache', () => ({ pruneImageMetricsForAssets: pruneImageMetricsForAssetsMock }))
+
+import {
+  CLIENT_ASSET_GRACE_PERIOD_MS,
+  collectReferencedAssetUrls,
+  parsePersistedBlobRefs,
+  runAssetGcSweep,
+  type AssetGcCanvasRefState,
+  type AssetGcChatRefState,
+} from './assetGc'
+import { applyAssetGcDecisions, readAssetGcIndex, resolveAssetUrl, saveImportedAsset } from './assetStorage'
+import { setPersistUserId, __resetPersistUserId } from './persistUserId'
+
+const mdFile = (name = 'note.md', content = 'hello world') =>
+  new File([content], name, { type: 'text/markdown' })
+
+const emptyCanvasState = (): AssetGcCanvasRefState => ({
+  canvases: {},
+  nodes: [],
+  clipboardNodes: [],
+  historyPast: [],
+  historyFuture: [],
+})
+const emptyChatState = (): AssetGcChatRefState => ({ messagesByScene: {} })
+
+/** Sweep with everything injectable; defaults model the common case (anonymous
+ *  user, empty persisted blobs → cross-tab truth confirms "unreferenced"). */
+const sweep = (overrides: Partial<Parameters<typeof runAssetGcSweep>[0]> & { now?: number } = {}) =>
+  runAssetGcSweep({
+    currentUserId: 'anonymous',
+    getCanvasRefState: emptyCanvasState,
+    getChatRefState: emptyChatState,
+    readPersistedBlobRefs: async () => new Set<string>(),
+    ...overrides,
+  })
+
+const T0 = 1_700_000_000_000
+const GRACE = CLIENT_ASSET_GRACE_PERIOD_MS
+
+describe('collectReferencedAssetUrls', () => {
+  it('collects node assetUrl + image fills across canvases, mirrors, clipboard, and BOTH history stacks', () => {
+    const canvasState: AssetGcCanvasRefState = {
+      canvases: {
+        a: { nodes: [{ assetUrl: 'mivo-asset:c1' }] },
+        b: { nodes: [{ fills: [{ kind: 'solid' }, { kind: 'image', assetUrl: 'mivo-asset:c2' }] }] },
+      },
+      nodes: [{ assetUrl: 'mivo-asset:active' }],
+      clipboardNodes: [{ assetUrl: 'mivo-asset:clip' }],
+      historyPast: [{ nodes: [{ assetUrl: 'mivo-asset:past' }] }],
+      historyFuture: [{ nodes: [{ assetUrl: 'mivo-asset:future' }] }],
+    }
+    const chatState: AssetGcChatRefState = {
+      messagesByScene: {
+        scene: [
+          { generationContext: { referenceAssetUrls: ['mivo-asset:chat1', ''] } },
+          {},
