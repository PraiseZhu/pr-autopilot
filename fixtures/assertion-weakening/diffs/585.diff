@@ -0,0 +1,194 @@
+// assetGcBoot.test — #509 wiring-layer coverage (R1 seat①-F2 / seat③-F2: this layer
+// shipped with zero dedicated tests). Every heavy dependency (canvasStore/chatStore/
+// canvasPersistConfig/chatPersistConfig/persistIdbStorage/kernelMode) is mocked — the
+// module under test is pure orchestration (which key to read, which gate to check,
+// which lock to take), and the policy it orchestrates (assetGc.ts) already has its
+// own direct-call test suite (assetGc.test.ts).
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const persistState = vi.hoisted(() => ({ isLocal: true }))
+const kernelState = vi.hoisted(() => ({ isLegacy: true }))
+const canvasState = vi.hoisted(() => ({ value: { canvases: {}, nodes: [] } as unknown }))
+const chatState = vi.hoisted(() => ({ value: { messagesByScene: {} } as unknown }))
+const strictRawGetItemMock = vi.hoisted(() => vi.fn())
+const debugLoggerMock = vi.hoisted(() => ({ log: vi.fn(), warn: vi.fn(), error: vi.fn() }))
+const runAssetGcSweepMock = vi.hoisted(() => vi.fn())
+
+vi.mock('../lib/persistMode', () => ({ get isLocalPersist() { return persistState.isLocal } }))
+vi.mock('./kernelMode', () => ({ isLegacyKernelEffective: () => kernelState.isLegacy }))
+vi.mock('../lib/persistIdbStorage', () => ({ strictRawGetItem: strictRawGetItemMock }))
+vi.mock('../kernel/docKernelPersistAdapter', () => ({ documentKey: (name: string) => `${name}:document` }))
+vi.mock('../lib/persistUserId', () => ({
+  getPersistUserId: () => 'test-user',
+  namespacedKey: (name: string) => `${name}:test-user`,
+}))
+vi.mock('../store/canvasPersistConfig', () => ({ canvasPersistOptions: { name: 'mivo-canvas-demo' } }))
+vi.mock('../store/chatPersistConfig', () => ({ chatPersistOptions: { name: 'mivo-chat-demo' } }))
+vi.mock('../store/canvasStore', () => ({ useCanvasStore: { getState: () => canvasState.value } }))
+vi.mock('../store/chatStore', () => ({ useChatStore: { getState: () => chatState.value } }))
+vi.mock('../store/debugLogStore', () => ({ debugLogger: debugLoggerMock }))
+vi.mock('../lib/assetGc', () => ({
+  CLIENT_ASSET_GRACE_PERIOD_MS: 7 * 24 * 60 * 60 * 1000,
+  parsePersistedBlobRefs: vi.fn(() => new Set()),
+  runAssetGcSweep: runAssetGcSweepMock,
+}))
+
+beforeEach(() => {
+  vi.resetModules()
+  persistState.isLocal = true
+  kernelState.isLegacy = true
+  strictRawGetItemMock.mockReset().mockResolvedValue(null)
+  debugLoggerMock.log.mockClear()
+  debugLoggerMock.warn.mockClear()
+  debugLoggerMock.error.mockClear()
+  runAssetGcSweepMock.mockReset().mockResolvedValue({
+    status: 'completed', scanned: 0, foreign: 0, marked: 0, resurrected: 0,
+    deleted: 0, freedBytes: 0, deletesWithheld: 0, stale: 0,
+  })
+})
+
+afterEach(() => {
+  vi.unstubAllGlobals()
+})
+
+describe('runAssetGcSweepNow — #509 R1(seat2)-F3: the isLocalPersist gate lives on the function itself', () => {
+  it('server/shadow persist mode: skips WITHOUT calling the policy layer, returns status=skipped, warns', async () => {
+    persistState.isLocal = false
+    const { runAssetGcSweepNow } = await import('./assetGcBoot')
+
+    const result = await runAssetGcSweepNow()
+
+    expect(result.status).toBe('skipped')
+    expect(result.scanned).toBe(0)
+    expect(runAssetGcSweepMock).not.toHaveBeenCalled()
+    expect(debugLoggerMock.warn).toHaveBeenCalledWith(
+      'Asset GC',
+      expect.stringContaining('persist mode is not local'),
+    )
+  })
+
+  it('local persist mode: delegates to the policy layer with the live store getters', async () => {
+    persistState.isLocal = true
+    canvasState.value = { canvases: { c1: { nodes: [] } }, nodes: [] }
+    const { runAssetGcSweepNow } = await import('./assetGcBoot')
+
+    await runAssetGcSweepNow({ graceMs: 1234, now: 5678 })
+
+    expect(runAssetGcSweepMock).toHaveBeenCalledTimes(1)
+    const call = runAssetGcSweepMock.mock.calls[0][0]
+    expect(call.currentUserId).toBe('test-user')
+    expect(call.graceMs).toBe(1234)
+    expect(call.now).toBe(5678)
+    expect(call.getCanvasRefState()).toBe(canvasState.value)
+    expect(call.getChatRefState()).toBe(chatState.value)
+  })
+
+  it('a caller bypassing scheduleAssetGcSweeps entirely (e.g. the E2E bridge) still gets the gate', async () => {
+    // This is the exact shape R1(seat2)-F3 named: window.__MIVO_E2E__.runAssetGcSweep
+    // calls this export directly, never through scheduleAssetGcSweeps.
+    persistState.isLocal = false
+    const { runAssetGcSweepNow } = await import('./assetGcBoot')
+
+    const result = await runAssetGcSweepNow({ graceMs: 0 })
+
+    expect(result.status).toBe('skipped')
+    expect(runAssetGcSweepMock).not.toHaveBeenCalled()
+  })
+})
+
+describe('readPersistedBlobRefs (via runAssetGcSweepNow → readPersistedBlobRefs option) — #509 R1(seat2)-F2', () => {
+  const capturedReader = async () => {
+    const { runAssetGcSweepNow } = await import('./assetGcBoot')
+    await runAssetGcSweepNow()
+    return runAssetGcSweepMock.mock.calls[0][0].readPersistedBlobRefs as () => Promise<Set<string> | undefined>
+  }
+
+  it('legacy kernel: reads the namespaced single-blob key for canvas', async () => {
+    kernelState.isLegacy = true
+    const readPersistedBlobRefs = await capturedReader()
+    strictRawGetItemMock.mockResolvedValue(null)
+
+    await readPersistedBlobRefs()
+
+    expect(strictRawGetItemMock).toHaveBeenCalledWith('mivo-canvas-demo:test-user')
+    expect(strictRawGetItemMock).toHaveBeenCalledWith('mivo-chat-demo:test-user')
+  })
+
+  it('new kernel: reads the document-domain split key for canvas (not the namespaced single blob)', async () => {
+    kernelState.isLegacy = false
+    const readPersistedBlobRefs = await capturedReader()
+    strictRawGetItemMock.mockResolvedValue(null)
+
+    await readPersistedBlobRefs()
+
+    expect(strictRawGetItemMock).toHaveBeenCalledWith('mivo-canvas-demo:document')
+    expect(strictRawGetItemMock).not.toHaveBeenCalledWith('mivo-canvas-demo:test-user')
+  })
+
+  it('#509 R1(seat2)-F2: strictRawGetItem throwing (a real IDB failure) is caught and returns undefined — never null/empty', async () => {
+    const readPersistedBlobRefs = await capturedReader()
+    strictRawGetItemMock.mockRejectedValue(new Error('IDB transaction failed'))
+
+    const refs = await readPersistedBlobRefs()
+
+    expect(refs).toBeUndefined()
+    expect(debugLoggerMock.warn).toHaveBeenCalledWith(
+      'Asset GC',
+      expect.stringContaining('persisted-blob read failed'),
+    )
+  })
+
+  it('a genuinely fresh profile (both keys null, no thrown error) resolves via parsePersistedBlobRefs, not swallowed as a failure', async () => {
+    const readPersistedBlobRefs = await capturedReader()
+    strictRawGetItemMock.mockResolvedValue(null)
+
+    const refs = await readPersistedBlobRefs()
+
+    expect(refs).toEqual(new Set())
+    expect(debugLoggerMock.warn).not.toHaveBeenCalledWith(
+      'Asset GC',
+      expect.stringContaining('persisted-blob read failed'),
+    )
+  })
+})
+
+describe('scheduleAssetGcSweeps — scheduling-level optimization, not the safety gate itself', () => {
+  it('server/shadow mode: does not set up timers, warns once', async () => {
+    vi.useFakeTimers()
+    persistState.isLocal = false
+    const { scheduleAssetGcSweeps } = await import('./assetGcBoot')
+
+    scheduleAssetGcSweeps()
+    await vi.runAllTimersAsync()
+
+    expect(runAssetGcSweepMock).not.toHaveBeenCalled()
+    expect(debugLoggerMock.warn).toHaveBeenCalledWith('Asset GC', expect.stringContaining('sweep disabled'))
+    vi.useRealTimers()
+  })
+
+  it('local mode: schedules and eventually calls the sweep', async () => {
+    vi.useFakeTimers()
+    persistState.isLocal = true
+    const { scheduleAssetGcSweeps } = await import('./assetGcBoot')
+
+    scheduleAssetGcSweeps()
+    await vi.advanceTimersByTimeAsync(21_000)
+
+    expect(runAssetGcSweepMock).toHaveBeenCalled()
+    vi.useRealTimers()
+  })
+
+  it('is idempotent: a second call does not schedule a second timer chain', async () => {
+    vi.useFakeTimers()
+    persistState.isLocal = true
+    const { scheduleAssetGcSweeps } = await import('./assetGcBoot')
+
+    scheduleAssetGcSweeps()
+    scheduleAssetGcSweeps()
+    await vi.advanceTimersByTimeAsync(21_000)
+
+    expect(runAssetGcSweepMock).toHaveBeenCalledTimes(1)
+    vi.useRealTimers()
+  })
+})
diff --git a/src/app/assetGcBoot.ts b/src/app/assetGcBoot.ts
new file mode 100644
index 00000000..e3e7ad3e
--- /dev/null
+++ b/src/app/assetGcBoot.ts
@@ -0,0 +1,183 @@
+// assetGcBoot — #509 wiring for the client asset GC sweep (policy: src/lib/assetGc.ts).
+//
+// App-shell glue: feeds the sweep live store state, the FX-6 user namespace, and the
+// persisted-blob reader (cross-tab truth for the delete phase), and schedules it off
+// the critical path (delayed boot pass + a periodic idle pass). Wired ONLY from the
+// web app's useStoreHydration success path — deliberately NOT from the Cindy plugin
+// (its sandbox owns a separate IndexedDB and never mounts chat; wiring it is a
+// follow-up once its archive-restore flow is covered) and NOT on the degraded /
+// persist-busy hydration paths (their in-memory state is the demo default, not the
+// user's truth — sweeping against it would mark everything; see the gates below).
+//
+// Mode gate: the sweep only ever runs in LOCAL persist mode. In server/shadow mode
+// canvas content hydrates lazily per scene, so state.canvases is an INCOMPLETE
+// reference surface — a scan there would misjudge assets of never-visited canvases.
+// Server-side asset GC is #313; local IDB assets referenced by server canvases wait
+// for it.
+
+import {
+  CLIENT_ASSET_GRACE_PERIOD_MS,
+  parsePersistedBlobRefs,
+  runAssetGcSweep,
+  type AssetGcSweepResult,
+} from '../lib/assetGc'
+import { strictRawGetItem } from '../lib/persistIdbStorage'
+import { documentKey } from '../kernel/docKernelPersistAdapter'
+import { isLegacyKernelEffective } from './kernelMode'
+import { isLocalPersist } from '../lib/persistMode'
+import { getPersistUserId, namespacedKey } from '../lib/persistUserId'
+import { canvasPersistOptions } from '../store/canvasPersistConfig'
+import { chatPersistOptions } from '../store/chatPersistConfig'
+import { useCanvasStore } from '../store/canvasStore'
+import { useChatStore } from '../store/chatStore'
+import { debugLogger } from '../store/debugLogStore'
+
+const SOURCE = 'Asset GC'
+
+/** First pass waits out the boot burst (hydration, first paint, demo draws). */
+const BOOT_SWEEP_DELAY_MS = 20_000
+/** Periodic re-pass — catches history-stack eviction during long sessions. */
+const SWEEP_INTERVAL_MS = 10 * 60_000
+/** Cross-tab mutual exclusion for the sweep (feature-detected; sweeps are also
+ *  individually safe without it thanks to the in-transaction re-verify). */
+const SWEEP_LOCK_NAME = 'mivo-asset-gc-sweep'
+
+/**
+ * Read the persisted canvas + chat blobs and parse their reference set. #509 R1-F2:
+ * uses `strictRawGetItem` (never falls back to localStorage / swallows an IDB
+ * failure into a silent `null`) — a genuine read failure must surface as an
+ * exception here, because a swallowed failure reading back exactly like "nothing
+ * persisted yet" would silently defeat the fail-closed guarantee below. The canvas
+ * key is resolved through the SAME kernel branch the app persists through (legacy:
+ * namespaced single blob / new: the document-domain key, which alone carries
+ * `canvases` — session only holds selection/tools, irrelevant to the reference
+ * scan), so the sweep always audits the bytes the app would actually rehydrate.
+ * Returns undefined when a blob is present but unreadable, or the read itself
+ * throws → the sweep withholds every delete this pass (fail-closed).
+ */
+const readPersistedBlobRefs = async (): Promise<Set<string> | undefined> => {
+  try {
+    const canvasKey = isLegacyKernelEffective()
+      ? namespacedKey(canvasPersistOptions.name)
+      : documentKey(canvasPersistOptions.name)
+    const [canvasRaw, chatRaw] = await Promise.all([
+      strictRawGetItem(canvasKey),
+      strictRawGetItem(namespacedKey(chatPersistOptions.name)),
+    ])
+    return parsePersistedBlobRefs(canvasRaw, chatRaw)
+  } catch (error) {
+    debugLogger.warn(
+      SOURCE,
+      `persisted-blob read failed (deletes will be withheld): ${error instanceof Error ? error.message : String(error)}`,
+    )
+    return undefined
+  }
+}
+
+export type RunAssetGcNowOptions = {
+  /** Override the grace window (bench/manual verification only). */
+  graceMs?: number
+  now?: number
+}
+
+const SKIPPED_NOT_LOCAL_RESULT: AssetGcSweepResult = {
+  status: 'skipped',
+  scanned: 0,
+  foreign: 0,
+  marked: 0,
+  resurrected: 0,
+  deleted: 0,
+  freedBytes: 0,
+  deletesWithheld: 0,
+  stale: 0,
+}
+
+/**
+ * Run one sweep against the live stores. Exported for the E2E/bench hook
+ * (window.__MIVO_E2E__.runAssetGcSweep) and used by the scheduler below.
+ *
+ * #509 R1-F3: the `isLocalPersist` gate lives HERE, not just in the scheduler —
+ * `scheduleAssetGcSweeps` below is one caller, but the E2E bridge calls this
+ * function directly, and any future caller would too. Gating only the scheduler
+ * left every other entry point free to run a sweep against an incomplete
+ * reference surface in server/shadow mode (canvas content there hydrates lazily
+ * per scene, so state.canvases never covers every canvas — see module header).
+ */
+export const runAssetGcSweepNow = (options: RunAssetGcNowOptions = {}): Promise<AssetGcSweepResult> => {
+  if (!isLocalPersist) {
+    debugLogger.warn(SOURCE, 'sweep skipped: persist mode is not local (server-side GC is #313)')
+    return Promise.resolve(SKIPPED_NOT_LOCAL_RESULT)
+  }
+  return runAssetGcSweep({
+    currentUserId: getPersistUserId(),
+    getCanvasRefState: () => useCanvasStore.getState(),
+    getChatRefState: () => useChatStore.getState(),
+    readPersistedBlobRefs,
+    graceMs: options.graceMs ?? CLIENT_ASSET_GRACE_PERIOD_MS,
+    now: options.now,
+  })
+}
+
+/** Serialize sweeps across tabs via Web Locks when available; ifAvailable means a
+ *  busy lock skips this pass instead of queueing behind another tab. */
+const runSweepExclusive = async (): Promise<void> => {
+  const locks = typeof navigator !== 'undefined' ? navigator.locks : undefined
+  if (locks?.request) {
+    await locks.request(SWEEP_LOCK_NAME, { ifAvailable: true }, async (lock) => {
+      if (!lock) {
+        debugLogger.log(SOURCE, 'sweep skipped: another tab holds the sweep lock')
+        return
+      }
+      await runAssetGcSweepNow()
+    })
+    return
+  }
+  await runAssetGcSweepNow()
+}
+
+/** Defer to browser idle time when available so the scan never competes with input. */
+const whenIdle = (run: () => void): void => {
+  if (typeof requestIdleCallback === 'function') {
+    requestIdleCallback(() => run(), { timeout: 30_000 })
+  } else {
+    setTimeout(run, 1_000)
+  }
+}
+
+let scheduled = false
+
+/**
+ * Schedule the recurring sweep. Called once from useStoreHydration's SUCCESS path —
+ * never from the degraded paths (see module header). Idempotent across calls.
+ */
+export const scheduleAssetGcSweeps = (): void => {
+  if (scheduled) return
+  scheduled = true
+
+  if (!isLocalPersist) {
+    // Server/shadow persist: incomplete local reference surface (see module header).
+    // This check is a scheduling-level optimization (skip setting up timers that
+    // would just warn every SWEEP_INTERVAL_MS) — the actual safety gate lives in
+    // runAssetGcSweepNow itself (#509 R1-F3), so any other caller is covered too.
+    debugLogger.warn(SOURCE, 'sweep disabled: persist mode is not local (server-side GC is #313)')
+    return
+  }
+
+  const pass = () => {
+    whenIdle(() => {
+      void runSweepExclusive().catch((error) => {
+        debugLogger.error(
+          SOURCE,
+          `scheduled sweep crashed: ${error instanceof Error ? error.message : String(error)}`,
+        )
+      })
+    })
+  }
+
+  setTimeout(pass, BOOT_SWEEP_DELAY_MS)
+  setInterval(pass, SWEEP_INTERVAL_MS)
+  debugLogger.log(
+    SOURCE,
+    `sweeps scheduled: first in ${BOOT_SWEEP_DELAY_MS / 1000}s, then every ${SWEEP_INTERVAL_MS / 60_000} min (grace ${CLIENT_ASSET_GRACE_PERIOD_MS / 86_400_000} d)`,
+  )
+}
