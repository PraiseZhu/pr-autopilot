+export type AssetGcIndexEntry = {
+  id: string
+  userId?: string
+  createdAt: number
+  lastRefZeroAt?: number
+  sizeBytes: number
+}
+
+/** #509: decisions the sweep wants applied. Each id is re-verified inside the
+ *  readwrite transaction before acting (see applyAssetGcDecisions). */
+export type AssetGcDecisions = {
+  /** Stamp lastRefZeroAt = now (only if the record exists and is unmarked). */
+  markIds: string[]
+  /** Clear lastRefZeroAt (resurrect — only if the record exists and is marked). */
+  clearIds: string[]
+  /** Physically delete (only if still marked and the mark is old enough). */
+  deleteIds: string[]
+  /** Timestamp written into fresh marks. */
+  now: number
+  /** A delete only applies while lastRefZeroAt <= this bound (grace re-check). */
+  deleteEligibleBefore: number
+}
+
+export type AssetGcApplyResult = {
+  marked: number
+  cleared: number
+  deleted: number
+  /** Sum of Blob.size over actually-deleted records. */
+  freedBytes: number
+  /** Decisions dropped by the in-transaction re-verify (record gone / state changed). */
+  stale: number
+  /** #509 R1-F1: the ids ACTUALLY deleted this call — a subset of decisions.deleteIds,
+   *  since the in-transaction re-verify above can drop any of them into `stale`. Callers
+   *  that key other cleanup off "what got deleted" (e.g. pruning a sibling cache) must
+   *  use this, not the candidate list they passed in. */
+  deletedIds: string[]
+}
+
