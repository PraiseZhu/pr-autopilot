+
+/**
+ * #509 client asset GC — apply sweep decisions in ONE readwrite transaction, with a
+ * per-record re-verify before every write (the client analogue of the server's
+ * deleteIfStillEligible "re-check under the lock"): between the index read and this
+ * apply, another tab's sweep or clearAssetsForUser may have changed a record, so
+ * every decision re-reads the record and only acts when the expected state still
+ * holds. Anything that no longer matches is counted into `stale` and skipped —
+ * a delete can never fire on a record whose mark was cleared in the meantime.
+ */
+export const applyAssetGcDecisions = async (decisions: AssetGcDecisions): Promise<AssetGcApplyResult> => {
+  const result: AssetGcApplyResult = { marked: 0, cleared: 0, deleted: 0, freedBytes: 0, stale: 0, deletedIds: [] }
+  if (typeof indexedDB === 'undefined' || indexedDB === null) return result
+  const total = decisions.markIds.length + decisions.clearIds.length + decisions.deleteIds.length
+  if (total === 0) return result
+
+  const db = await openAssetDb()
+  try {
+    await new Promise<void>((resolve, reject) => {
+      const tx = db.transaction(STORE_NAME, 'readwrite')
+      const store = tx.objectStore(STORE_NAME)
+
+      const process = (id: string, act: (rec: StoredAsset | undefined) => void) => {
+        const getReq = store.get(id) as IDBRequest<StoredAsset | undefined>
+        getReq.onsuccess = () => act(getReq.result)
+      }
