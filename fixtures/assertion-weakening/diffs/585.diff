+      for (const id of decisions.markIds) {
+        process(id, (rec) => {
+          if (!rec || rec.lastRefZeroAt !== undefined) {
+            result.stale += 1
+            return
+          }
+          store.put({ ...rec, lastRefZeroAt: decisions.now })
+          result.marked += 1
+        })
+      }
+      for (const id of decisions.clearIds) {
+        process(id, (rec) => {
+          if (!rec || rec.lastRefZeroAt === undefined) {
+            result.stale += 1
+            return
+          }
+          const rest: StoredAsset = { ...rec }
+          delete rest.lastRefZeroAt
+          store.put(rest)
+          result.cleared += 1
+        })
+      }
+      for (const id of decisions.deleteIds) {
+        process(id, (rec) => {
+          if (!rec || rec.lastRefZeroAt === undefined || rec.lastRefZeroAt > decisions.deleteEligibleBefore) {
+            result.stale += 1
+            return
+          }
+          store.delete(id)
+          result.deleted += 1
+          result.freedBytes += rec.blob?.size ?? 0
+          result.deletedIds.push(id)
+        })
+      }
+
+      tx.oncomplete = () => resolve()
+      tx.onerror = () => reject(tx.error)
+      tx.onabort = () => reject(tx.error ?? new Error('asset GC apply aborted'))
+    })
+  } finally {
+    db.close()
+  }
+  return result
+}
