+++ b/src/store/importBatchStamp.test.ts
@@ -0,0 +1,149 @@
+// importBatchId 在 store 层的落地(#297 T2a1):
+// 1. addImportedFileNode 把 metadata.importBatchId 原样写进节点(canvasAssetImport
+//    在这之前铸造,这里只验证 store 侧不丢字段);
+// 2. pasteClipboardAssets(Eagle 素材板粘贴,"内部资产板粘贴入口" [J4-④])同次粘贴
+//    的全部节点共享同一个新批次戳;
+// 3. pasteClipboardNodes(复制既有画布节点)不得伪造新的 importBatchId——有就原样
+//    保留,没有就仍然没有。
+//
+// 跑在真实 store 上,与 nodeCopyOffset.test.ts 同一套 hermetic 前置。
+import { describe, expect, it, vi } from 'vitest'
+
+vi.hoisted(() => {
+  const store = new Map<string, string>()
+  const memStorage = {
+    get length() {
+      return store.size
+    },
+    clear: () => store.clear(),
+    getItem: (k: string) => store.get(k) ?? null,
+    key: (i: number) => [...store.keys()][i] ?? null,
+    removeItem: (k: string) => {
+      store.delete(k)
+    },
+    setItem: (k: string, v: string) => {
+      store.set(k, String(v))
+    },
+  }
+  const g = globalThis as Record<string, unknown>
+  if (g.window === undefined) g.window = { localStorage: memStorage }
+  if (g.localStorage === undefined) g.localStorage = memStorage
+})
+
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+vi.mock('./remoteDebugReporter', () => ({
+  reportRemoteDebugEntry: () => {},
+}))
+
+import { useCanvasStore } from './canvasStore'
+import { normalizeCanvasNodes } from './canvasDocumentModel'
+import { IMPORT_BATCH_ID_PATTERN } from '../lib/importBatchId'
+import type { CanvasAssetClipboardItem } from '../app/assetLibraryModel'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+const seed = (nodes: MivoCanvasNode[], selected: string[] = []) => {
+  const base = useCanvasStore.getState()
+  const normalized = normalizeCanvasNodes(nodes)
+  useCanvasStore.setState(
+    {
+      ...base,
+      canvases: {
+        s: { title: 's', nodes: normalized, edges: [], tasks: [], selectedNodeId: selected[0], selectedNodeIds: selected },
+      },
+      sceneId: 's',
+      nodes: normalized,
+      edges: [],
+      tasks: [],
+      selectedNodeId: selected[0],
+      selectedNodeIds: selected,
+      historyPast: [],
+      historyFuture: [],
+      clipboardNodes: [],
+      clipboardAssets: [],
+    } as never,
+    true,
+  )
+}
+
+const img = (id: string, overrides: Partial<MivoCanvasNode> = {}): MivoCanvasNode =>
+  ({ id, type: 'image', title: id, x: 100, y: 100, width: 200, height: 150, status: 'ready', assetUrl: '/a.png', ...overrides }) as MivoCanvasNode
+
+const clipboardAsset = (id: string, url: string): CanvasAssetClipboardItem => ({
+  id,
+  sourceId: 'eagle',
+  name: `${id}.png`,
+  title: `${id}.png`,
+  url,
+  sourcePath: `/library/${id}.png`,
+})
+
+describe('addImportedFileNode — metadata.importBatchId 原样落到节点', () => {
+  it('落板节点携带调用方传入的 importBatchId', () => {
+    seed([])
+    useCanvasStore.getState().addImportedFileNode('image', '/imported.png', 'Imported', 'source', { x: 0, y: 0 }, {
+      importBatchId: 'ib-1700000000000-0-deadbeef',
+    })
+    const node = useCanvasStore.getState().nodes[0]
+    expect(node.importBatchId).toBe('ib-1700000000000-0-deadbeef')
+  })
+
+  it('未传 importBatchId 时节点该字段为 undefined(不自行铸造——那是 canvasAssetImport 的职责)', () => {
+    seed([])
+    useCanvasStore.getState().addImportedFileNode('image', '/imported.png', 'Imported', 'source', { x: 0, y: 0 })
+    expect(useCanvasStore.getState().nodes[0].importBatchId).toBeUndefined()
+  })
+})
+
+describe('pasteClipboardAssets — 同次粘贴共享同一新批次戳', () => {
+  it('两个 Eagle 素材同次粘贴,落地节点 importBatchId 全等且格式合法', () => {
+    seed([])
+    useCanvasStore.setState({
+      clipboardAssets: [clipboardAsset('e1', 'eagle://e1'), clipboardAsset('e2', 'eagle://e2')],
+    } as never)
+
+    useCanvasStore.getState().pasteClipboardAssets({ x: 0, y: 0 })
+
+    const nodes = useCanvasStore.getState().nodes
+    expect(nodes).toHaveLength(2)
+    expect(nodes[0].importBatchId).toMatch(IMPORT_BATCH_ID_PATTERN)
+    expect(nodes[0].importBatchId).toBe(nodes[1].importBatchId)
+  })
+
+  it('两次独立粘贴产出不同的批次戳(不是同一批)', () => {
+    seed([])
+    useCanvasStore.setState({ clipboardAssets: [clipboardAsset('e1', 'eagle://e1')] } as never)
+    useCanvasStore.getState().pasteClipboardAssets({ x: 0, y: 0 })
+    const firstBatch = useCanvasStore.getState().nodes[0].importBatchId
+
+    useCanvasStore.setState({ clipboardAssets: [clipboardAsset('e2', 'eagle://e2')] } as never)
+    useCanvasStore.getState().pasteClipboardAssets({ x: 200, y: 200 })
+    const nodes = useCanvasStore.getState().nodes
+    const secondBatch = nodes[nodes.length - 1].importBatchId
+
+    expect(secondBatch).not.toBe(firstBatch)
+  })
+})
+
+describe('pasteClipboardNodes — 复制既有节点不伪造新导入批次', () => {
+  it('复制"存量无批次线索"的节点 → 副本仍然没有 importBatchId', () => {
+    seed([img('a')], ['a'])
+    useCanvasStore.getState().copySelectedNodes()
+    useCanvasStore.getState().pasteClipboardNodes({ x: 500, y: 500 })
+
+    const clone = useCanvasStore.getState().nodes.find((node) => node.id !== 'a')
+    expect(clone).toBeDefined()
+    expect(clone!.importBatchId).toBeUndefined()
+  })
+
+  it('复制"带批次戳"的节点 → 副本原样保留源批次戳,不新造', () => {
+    seed([img('a', { importBatchId: 'ib-1700000000000-0-deadbeef' })], ['a'])
+    useCanvasStore.getState().copySelectedNodes()
+    useCanvasStore.getState().pasteClipboardNodes({ x: 500, y: 500 })
+
+    const clone = useCanvasStore.getState().nodes.find((node) => node.id !== 'a')
+    expect(clone).toBeDefined()
+    expect(clone!.importBatchId).toBe('ib-1700000000000-0-deadbeef')
+  })
+})
