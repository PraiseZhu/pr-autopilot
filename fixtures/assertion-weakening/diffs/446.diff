--- /dev/null
+++ b/src/lib/importBatchId.test.ts
@@ -0,0 +1,106 @@
+// importBatchId 契约测试(#297 T2a1,设计稿 §2.11-③ 全量)。
+//
+// 五类钉死:格式冻结 / 同批全等 / 同毫秒 seq 异 / 排序三分支 / 并列输出。
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import {
+  __resetImportBatchSessionForTest,
+  compareImportBatchIds,
+  createImportBatchId,
+  IMPORT_BATCH_ID_PATTERN,
+  isSameImportBatch,
+  parseImportBatchId,
+} from './importBatchId'
+
+beforeEach(() => {
+  __resetImportBatchSessionForTest()
+})
+
+describe('createImportBatchId — 格式冻结', () => {
+  it('匹配 ib-<epochMs>-<seq>-<nonce8>,epochMs 十进制不补零,nonce8 为 8 位小写 hex', () => {
+    const id = createImportBatchId()
+    expect(id).toMatch(IMPORT_BATCH_ID_PATTERN)
+    const parsed = parseImportBatchId(id)
+    expect(parsed).toBeDefined()
+    expect(Number.isInteger(parsed!.epochMs)).toBe(true)
+    expect(parsed!.nonce8).toMatch(/^[0-9a-f]{8}$/)
+  })
+
+  it('同一会话内 nonce8 恒定(所有批次共用)', () => {
+    const first = createImportBatchId()
+    const second = createImportBatchId()
+    expect(parseImportBatchId(first)!.nonce8).toBe(parseImportBatchId(second)!.nonce8)
+  })
+
+  it('格式不识别的字符串解析为 undefined(不宽松兜底)', () => {
+    expect(parseImportBatchId('not-a-batch-id')).toBeUndefined()
+    expect(parseImportBatchId('ib-123-1-XYZ12345')).toBeUndefined() // 大写不在 nonce8 字符集
+    expect(parseImportBatchId('ib-123-1-abcd')).toBeUndefined() // nonce8 长度不足
+  })
+})
+
+describe('createImportBatchId — 同毫秒两次导入 seq 必不同', () => {
+  it('同一 epochMs 下连续两次调用产出整串不同的批次戳', () => {
+    vi.useFakeTimers()
+    vi.setSystemTime(1_700_000_000_000)
+    try {
+      const first = createImportBatchId()
+      const second = createImportBatchId()
+      expect(parseImportBatchId(first)!.epochMs).toBe(parseImportBatchId(second)!.epochMs)
+      expect(parseImportBatchId(first)!.seq).not.toBe(parseImportBatchId(second)!.seq)
+      expect(first).not.toBe(second)
+    } finally {
+      vi.useRealTimers()
+    }
+  })
+})
+
+describe('isSameImportBatch — 同批判定 = 整串相等', () => {
+  it('两次调用同一批(同一次导入内)全等', () => {
+    const batchId = createImportBatchId()
+    // 同一次导入的多个节点共享同一个已铸造好的字符串,不是各自调用 createImportBatchId。
+    expect(isSameImportBatch(batchId, batchId)).toBe(true)
+  })
+
+  it('两次独立调用产出的不同批次戳判定为不同批', () => {
+    const a = createImportBatchId()
+    const b = createImportBatchId()
+    expect(isSameImportBatch(a, b)).toBe(false)
+  })
+
+  it('undefined(存量节点无字段)判定为不同批,不抛错', () => {
+    expect(isSameImportBatch(undefined, undefined)).toBe(false)
+    expect(isSameImportBatch(createImportBatchId(), undefined)).toBe(false)
+  })
+})
+
+describe('compareImportBatchIds — 排序契约三分支 + 并列', () => {
+  const idOf = (epochMs: number, seq: number, nonce8: string) => `ib-${epochMs}-${seq}-${nonce8}`
+
+  it('分支①:epochMs 不同 → 数值序,大者更近', () => {
+    expect(compareImportBatchIds(idOf(200, 0, 'aaaaaaaa'), idOf(100, 0, 'aaaaaaaa'))).toBe('newer')
+    expect(compareImportBatchIds(idOf(100, 0, 'aaaaaaaa'), idOf(200, 0, 'aaaaaaaa'))).toBe('older')
+  })
+
+  it('分支②:epochMs 相等且 nonce8 相同(同一会话)→ 比 seq,大者更近', () => {
+    expect(compareImportBatchIds(idOf(100, 5, 'aaaaaaaa'), idOf(100, 3, 'aaaaaaaa'))).toBe('newer')
+    expect(compareImportBatchIds(idOf(100, 3, 'aaaaaaaa'), idOf(100, 5, 'aaaaaaaa'))).toBe('older')
+  })
+
+  it('分支③(并列):epochMs 相等且 nonce8 不同(跨会话同毫秒)→ tie,不产生确定顺序', () => {
+    expect(compareImportBatchIds(idOf(100, 0, 'aaaaaaaa'), idOf(100, 0, 'bbbbbbbb'))).toBe('tie')
+    expect(compareImportBatchIds(idOf(100, 9, 'aaaaaaaa'), idOf(100, 0, 'bbbbbbbb'))).toBe('tie')
+  })
+
+  it('整串相等(同一批)也落在 nonce8 相同 + seq 相等的退化分支,判定为 tie', () => {
+    const id = idOf(100, 0, 'aaaaaaaa')
+    expect(compareImportBatchIds(id, id)).toBe('tie')
+  })
+
+  it('格式不识别时抛错,不静默返回 tie(fail-visible)', () => {
+    expect(() => compareImportBatchIds('garbage', idOf(100, 0, 'aaaaaaaa'))).toThrow()
+  })
+})
+
+afterEach(() => {
+  vi.useRealTimers()
+})
