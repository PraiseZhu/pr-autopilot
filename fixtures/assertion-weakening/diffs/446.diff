@@ -0,0 +1,108 @@
+// importBatchId —— 导入批次戳(#297 P3 T2a1「选中即批次」的数据层基石,设计稿
+// §2.11-③ / §3.2 carve-out)。
+//
+// 同一次拖拽/粘贴/URL 落图导入的所有节点共享同一个批次标识,供 Agent 在用户未
+// 选中任何节点、但存在"刚导入的这一批"这条批次线索时兜底(纪律文本见 ghost.json
+// canvas_snapshot 描述,T3c 落地)。本模块只负责生成与比较,不做任何"挑批次"的
+// 决策——那是 Agent 纪律,不是数据层职责。
+//
+// 格式冻结:`ib-<epochMs>-<seq>-<nonce8>`。三段各自的角色:
+// - epochMs:导入时刻毫秒时间戳,十进制不补零,天然给出"哪个更近"的主排序键;
+// - seq:会话内单调递增计数器,保证同一毫秒内的两次导入互不相同;
+// - nonce8:整个应用会话启动时生成一次、该会话所有批次共用的 8 位小写十六进制
+//   随机串——不同会话(不同浏览器标签/不同一次刷新)的 seq 序列域不可比较,
+//   nonce8 不同就是这件事的信号,而不是碰撞检测(4→8 位只是把碰撞压到工程可
+//   忽略,不保证绝对唯一,如实声明)。
+//
+// 同批判定 = 整串相等(不比较字段,严格字符串比较即可,写这个只是让调用方不用
+// 自己拼字符串比较逻辑)。
+
+const NONCE8_PATTERN = /^[0-9a-f]{8}$/
+export const IMPORT_BATCH_ID_PATTERN = /^ib-(\d+)-(\d+)-([0-9a-f]{8})$/
+
+export type ParsedImportBatchId = {
+  epochMs: number
+  seq: number
+  nonce8: string
+}
+
+/** 解析失败(格式不识别)返回 undefined——不做宽松兜底,调用方按"无批次线索"处理。 */
+export const parseImportBatchId = (value: string): ParsedImportBatchId | undefined => {
+  const match = IMPORT_BATCH_ID_PATTERN.exec(value)
+  if (!match) return undefined
+
+  const epochMs = Number(match[1])
+  const seq = Number(match[2])
+  if (!Number.isSafeInteger(epochMs) || !Number.isSafeInteger(seq)) return undefined
+
+  return { epochMs, seq, nonce8: match[3] }
+}
+
+const randomHex8 = (): string => {
+  if (typeof crypto !== 'undefined' && 'getRandomValues' in crypto) {
+    const bytes = crypto.getRandomValues(new Uint8Array(4))
+    return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0')).join('')
+  }
+  // 兜底(理论上现代运行时都有 crypto.getRandomValues):与仓内既有 id 生成器
+  // (nodeFactory.createGroupId 等)同款 Math.random 兜底,只是补足到 8 位十六进制。
+  return Math.random().toString(16).slice(2).padEnd(8, '0').slice(0, 8)
+}
+
+/** 会话 nonce:整个应用会话生命周期内只生成一次(模块级单例,随页面刷新重置)。 */
+let sessionNonce8: string | undefined
+
+/** 仅供测试重置会话状态(nonce + seq),不导出给业务代码调用。 */
+export const __resetImportBatchSessionForTest = (): void => {
+  sessionNonce8 = undefined
+  sessionSeq = 0
+}
+
+const getSessionNonce8 = (): string => {
+  if (!sessionNonce8) sessionNonce8 = randomHex8()
+  if (!NONCE8_PATTERN.test(sessionNonce8)) {
+    throw new Error(`importBatchId: session nonce8 生成结果不合法: ${sessionNonce8}`)
+  }
+  return sessionNonce8
+}
+
+/** 会话内单调递增计数器——保证同一毫秒内先后两次导入的批次戳整串不同。 */
+let sessionSeq = 0
+
+/** 每次调用铸造一个新批次戳。调用方负责"一次导入调用一次",不要在逐节点循环里调用。 */
+export const createImportBatchId = (): string => {
+  const epochMs = Date.now()
+  const seq = sessionSeq
+  sessionSeq += 1
+  return `ib-${epochMs}-${seq}-${getSessionNonce8()}`
+}
+
+/** 同批判定(设计稿 §2.11-③:"同批判定 = 整串相等")。 */
+export const isSameImportBatch = (a: string | undefined, b: string | undefined): boolean =>
+  Boolean(a) && a === b
+
+export type ImportBatchOrder = 'newer' | 'older' | 'tie'
+
+/**
+ * 排序契约(设计稿 §2.11-③):
+ * 1. 先比 epochMs 数值,大者更近;
+ * 2. epochMs 相等时,仅当 nonce8 相同(同一会话、同一 seq 序列域)才比较 seq 数值,大者更近;
+ * 3. epochMs 相等且 nonce8 不同(跨会话同毫秒,seq 不可比)——一律 'tie'(并列)。
+ *
+ * 'tie' 是契约里的第三种确定性结果,不是"无法判断"的降级:调用方(Agent 纪律)看到
+ * 'tie' 必须反问,不得自行挑选。格式不识别时抛错——这两个字符串按约定只应来自
+ * `createImportBatchId()` 或既有节点的存量字段,格式错误意味着上游已经违反了契约。
+ */
+export const compareImportBatchIds = (a: string, b: string): ImportBatchOrder => {
+  const parsedA = parseImportBatchId(a)
+  const parsedB = parseImportBatchId(b)
+  if (!parsedA || !parsedB) {
+    throw new Error('compareImportBatchIds: 入参不是合法的 importBatchId(格式 ib-<epochMs>-<seq>-<nonce8>)')
+  }
+
+  if (parsedA.epochMs !== parsedB.epochMs) {
+    return parsedA.epochMs > parsedB.epochMs ? 'newer' : 'older'
+  }
+  if (parsedA.nonce8 !== parsedB.nonce8) return 'tie'
+  if (parsedA.seq === parsedB.seq) return 'tie'
+  return parsedA.seq > parsedB.seq ? 'newer' : 'older'
+}
