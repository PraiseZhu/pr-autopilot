+// importBatchId 接线契约(#297 T2a1):同一次导入调用的全部节点共享同一个批次戳,
+// 独立的导入调用互不相同。与 canvasAssetImport.batch.test.ts(批量配额/伪 MIME)
+// 是两件事,分文件避免"批"(quota 的批)与"批次戳"(importBatchId 的批)混读。
+//
+// 单测跑在 node 环境,assetStorage / 尺寸测量 / 日志同款注入替身(与既有批量测试
+// 同一套 mock,行为不重复钉,只钉"批次戳怎么分配")。
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import type { AddImportedFileNode, AddImportedImage } from './canvasAssetImport'
+import { IMPORT_BATCH_ID_PATTERN } from './importBatchId'
+
+const savedFiles: string[] = []
+
+vi.mock('./assetStorage', () => ({
+  saveImportedAsset: vi.fn(async (file: File) => {
+    savedFiles.push(file.name)
+    return {
+      assetUrl: `imported:${file.name}`,
+      title: file.name,
+      name: file.name,
+      size: '10x10',
+      sizeBytes: file.size,
+      type: file.type,
+      dimensions: { width: 10, height: 10 },
+      sourceDimensions: { width: 10, height: 10 },
+    }
+  }),
+  deleteImportedAsset: vi.fn(async () => true),
+}))
+
+vi.mock('./imageSizing', () => ({
+  importedImageDisplaySize: () => ({ width: 100, height: 80 }),
+}))
+
+vi.mock('../store/debugLogStore', () => ({
+  debugLogger: { log: () => {}, warn: () => {}, error: () => {} },
+}))
+
+const {
+  importCanvasFileBatch,
+  importFileToCanvas,
+  importImageFileToCanvas,
+  importImageFilesToCanvas,
+} = await import('./canvasAssetImport')
+
+const PNG_SIGNATURE = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])
+const png = (name: string): File => new File([PNG_SIGNATURE], name, { type: 'image/png' })
+
+const position = { x: 0, y: 0 }
+
+type CapturedNodeCall = { assetUrl: string; importBatchId?: string }
+
+/** 捕获 addImportedFileNode 每次调用的 assetUrl + metadata.importBatchId。 */
+const captureFileNodeCalls = () => {
+  const calls: CapturedNodeCall[] = []
+  const fn: AddImportedFileNode = (_type, assetUrl, _title, _size, _position, metadata) => {
+    calls.push({ assetUrl, importBatchId: metadata?.importBatchId })
+  }
+  return { calls, fn }
+}
+
+/** 捕获 addImportedImage 每次调用的 assetUrl + metadata.importBatchId。 */
+const captureImageCalls = () => {
+  const calls: CapturedNodeCall[] = []
+  const fn: AddImportedImage = (assetUrl, _title, _size, _position, metadata) => {
+    calls.push({ assetUrl, importBatchId: metadata?.importBatchId })
+  }
+  return { calls, fn }
+}
+
+beforeEach(() => {
+  savedFiles.length = 0
+})
+
+describe('importCanvasFileBatch — 同批文件共享同一批次戳', () => {
+  it('三个文件落板,importBatchId 全等且格式合法', async () => {
+    const { calls, fn } = captureFileNodeCalls()
+    await importCanvasFileBatch([png('a.png'), png('b.png'), png('c.png')], position, fn)
+
+    expect(calls).toHaveLength(3)
+    const ids = calls.map((call) => call.importBatchId)
+    expect(ids[0]).toMatch(IMPORT_BATCH_ID_PATTERN)
+    expect(new Set(ids).size).toBe(1)
+  })
+
+  it('两次独立的批量导入调用产出不同的批次戳', async () => {
+    const first = captureFileNodeCalls()
+    await importCanvasFileBatch([png('a.png')], position, first.fn)
+    const second = captureFileNodeCalls()
+    await importCanvasFileBatch([png('b.png')], position, second.fn)
+
+    expect(first.calls[0].importBatchId).not.toBe(second.calls[0].importBatchId)
+  })
+})
+
+describe('importImageFilesToCanvas — 同批图片共享同一批次戳', () => {
+  it('多张图片同批导入,importBatchId 全等', async () => {
+    const { calls, fn } = captureImageCalls()
+    await importImageFilesToCanvas([png('a.png'), png('b.png'), png('c.png')], position, fn)
+
+    expect(calls).toHaveLength(3)
+    const ids = calls.map((call) => call.importBatchId)
+    expect(new Set(ids).size).toBe(1)
+    expect(ids[0]).toMatch(IMPORT_BATCH_ID_PATTERN)
+  })
+
+  it('两次独立调用产出不同的批次戳(不是同一批)', async () => {
+    const first = captureImageCalls()
+    await importImageFilesToCanvas([png('a.png')], position, first.fn)
+    const second = captureImageCalls()
+    await importImageFilesToCanvas([png('b.png')], position, second.fn)
+
+    expect(first.calls[0].importBatchId).not.toBe(second.calls[0].importBatchId)
+  })
+})
+
+describe('单文件入口 — 每次调用各自铸造一个批次(批次大小为一)', () => {
+  it('importFileToCanvas 两次独立调用产出不同批次戳', async () => {
+    const first = captureFileNodeCalls()
+    await importFileToCanvas({ file: png('a.png'), position, addImportedFileNode: first.fn })
+    const second = captureFileNodeCalls()
+    await importFileToCanvas({ file: png('b.png'), position, addImportedFileNode: second.fn })
+
+    expect(first.calls[0].importBatchId).toMatch(IMPORT_BATCH_ID_PATTERN)
+    expect(first.calls[0].importBatchId).not.toBe(second.calls[0].importBatchId)
+  })
+
+  it('importImageFileToCanvas 独立调用(未传 importBatchId)自行铸造', async () => {
+    const first = captureImageCalls()
+    await importImageFileToCanvas({ file: png('a.png'), position, addImportedImage: first.fn })
+    const second = captureImageCalls()
+    await importImageFileToCanvas({ file: png('b.png'), position, addImportedImage: second.fn })
+
+    expect(first.calls[0].importBatchId).toMatch(IMPORT_BATCH_ID_PATTERN)
+    expect(first.calls[0].importBatchId).not.toBe(second.calls[0].importBatchId)
+  })
+
+  it('importImageFileToCanvas 传入 importBatchId 时原样复用,不另铸新的', async () => {
+    const { calls, fn } = captureImageCalls()
+    await importImageFileToCanvas({
+      file: png('a.png'),
+      position,
+      addImportedImage: fn,
+      importBatchId: 'ib-1700000000000-0-deadbeef',
+    })
+
+    expect(calls[0].importBatchId).toBe('ib-1700000000000-0-deadbeef')
+  })
+})
