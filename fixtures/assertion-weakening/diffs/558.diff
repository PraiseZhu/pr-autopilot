+// scripts/e2e/result-ledger.test.mjs — buildLedgerRecord 终态/flaky 推导单测。
+//
+// 只测纯函数(buildLedgerRecord),不起 Playwright/子进程——这段逻辑是本 PR 里唯一
+// 有判断分支的部分(PASS/RETRY_PASS/FAIL/N_A 四态 + flaky 推导),错了会直接把
+// 「假绿」台账变成「假台账」,值得独立锁定。
+import { describe, it, expect } from 'vitest'
+import { buildLedgerRecord } from './result-ledger.mjs'
+
+const attempt = (overrides) => ({ attempt: 1, status: 'PASS', durationMs: 100, message: null, pageErrors: [], ...overrides })
+
+const cell = (attempts) =>
+  buildLedgerRecord({ scenario: 'debug', renderer: 'dom', kernel: 'legacy', topology: 'prod', attempts })
+
+describe('buildLedgerRecord', () => {
+  it('单次 attempt 且 PASS → 终态 PASS,retries=0,flaky=false', () => {
+    const record = cell([attempt({ status: 'PASS' })])
+    expect(record.status).toBe('PASS')
+    expect(record.retries).toBe(0)
+    expect(record.flaky).toBe(false)
+  })
+
+  it('单次 attempt 且 FAIL → 终态 FAIL,message 透传', () => {
+    const record = cell([attempt({ status: 'FAIL', message: 'boom' })])
+    expect(record.status).toBe('FAIL')
+    expect(record.message).toBe('boom')
+  })
+
+  it('attempt1 FAIL、attempt2 PASS → 终态 RETRY_PASS,retries=1,flaky=true(控制组对照见下一条)', () => {
+    const record = cell([
+      attempt({ attempt: 1, status: 'FAIL', message: 'transient' }),
+      attempt({ attempt: 2, status: 'PASS' }),
+    ])
+    expect(record.status).toBe('RETRY_PASS')
+    expect(record.retries).toBe(1)
+    expect(record.flaky).toBe(true)
+    expect(record.retryAttempts).toHaveLength(2)
+  })
+
+  it('控制组:全部 attempt 都是首次 PASS(单次)→ flaky=false,不与上一条混淆', () => {
+    const record = cell([attempt({ status: 'PASS' })])
+    expect(record.flaky).toBe(false)
+    expect(record.retries).toBe(0)
+  })
+
+  it('多次 attempt 全部 FAIL(重试耗尽)→ 终态 FAIL,不是 RETRY_PASS,flaky=false(稳定失败不是抖动)', () => {
+    const record = cell([
+      attempt({ attempt: 1, status: 'FAIL', message: 'first' }),
+      attempt({ attempt: 2, status: 'FAIL', message: 'second' }),
+    ])
+    expect(record.status).toBe('FAIL')
+    expect(record.flaky).toBe(false)
+    expect(record.retries).toBe(1)
+    expect(record.message).toBe('second')
+  })
+
+  it('最后一次 attempt 是 N_A(leafer-skip)→ 终态 N_A,不判 flaky', () => {
+    const record = cell([attempt({ status: 'N_A', message: 'leafer skip reason' })])
+    expect(record.status).toBe('N_A')
+    expect(record.flaky).toBe(false)
+  })
+
+  it('diagnostics.pageErrors 按 fingerprint 跨 attempt 去重,保留首次出现的条目', () => {
+    const record = cell([
+      attempt({ attempt: 1, status: 'FAIL', pageErrors: [{ message: 'setPointerCapture boom', fingerprint: 'abc123', url: 'http://x' }] }),
+      attempt({ attempt: 2, status: 'PASS', pageErrors: [{ message: 'setPointerCapture boom', fingerprint: 'abc123', url: 'http://x' }] }),
+    ])
+    expect(record.diagnostics.pageErrors).toHaveLength(1)
+    expect(record.diagnostics.pageErrors[0].fingerprint).toBe('abc123')
+  })
+
+  it('name 字段唯一定位一个「格」= scenario::renderer::kernel::topology', () => {
+    const record = cell([attempt({ status: 'PASS' })])
+    expect(record.name).toBe('debug::dom::legacy::prod')
+  })
+})
