diff --git a/scripts/e2e/result-ledger.mjs b/scripts/e2e/result-ledger.mjs
new file mode 100644
index 00000000..634626db
--- /dev/null
+++ b/scripts/e2e/result-ledger.mjs
@@ -0,0 +1,153 @@
+// scripts/e2e/result-ledger.mjs
+//
+// 每格测试结果台账——格式照抄 CTRF(Common Test Report Format,
+// github.com/ctrf-io/ctrf,MIT):每条记录带 name/status/duration/flaky/retries/
+// retryAttempts/message,与官方 CTRF 消费方(如 ctrf-io 的各类 reporter)同构。
+// 本仓的扩展:①「格」定位字段 {scenario,renderer,kernel,topology}(唯一定位一次
+// scenario×renderer×kernel×topology 的执行);②终态枚举改为
+// PASS/RETRY_PASS/FAIL/N_A(替换 CTRF 原生的小写 passed/failed/skipped/pending/other——
+// 本台账目前只喂给仓内 e2e-runner.mjs/e2e-smoke.mjs 自己读,不接 CTRF 官方生态工具,
+// 用更贴合本仓语境的枚举更直白;N_A 专用于 leafer-skip 等结构性不执行的格,不与
+// PASS 混淆);③ headSha + diagnostics.pageErrors(browser-error-guard.mjs 采集)。
+//
+// report-only:本模块不抛错、不影响任何 pass/fail 语义,只负责落盘,读写失败均静默
+// 降级(缺一条台账记录好于让台账写坏一次真实的 e2e 判定)。
+//
+// 两层文件:
+//  - ATTEMPT_FRAGMENT_PATH:单次 smoke.mjs 进程(= e2e-runner.mjs 的一次 attempt)的
+//    临时记录。resetAttemptFragments() 在进程刚启动时清空(每个 attempt 是全新进程,
+//    清空即隔离);进程内每跑完一个 scenario(PASS/FAIL)或判定 N_A 就 append 一行。
+//    e2e-runner.mjs 在子进程 close 后读它,合并进最终台账,随后该文件内容即可废弃
+//    (下一个 attempt 的子进程会在自己启动时再次清空)。
+//  - LEDGER_PATH:跨 attempt 累积的最终台账。e2e-runner.mjs 在某个「格」的重试循环
+//    结束后(成功或耗尽重试)写入一条汇总记录。
+
+import { appendFileSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs'
+import { dirname, resolve } from 'node:path'
+import { execFileSync } from 'node:child_process'
+
+const ARTIFACT_DIR = resolve(process.cwd(), 'test-artifacts')
+export const ATTEMPT_FRAGMENT_PATH = resolve(ARTIFACT_DIR, 'e2e-attempt-fragments.jsonl')
+export const LEDGER_PATH = resolve(ARTIFACT_DIR, 'e2e-result-ledger.jsonl')
+
+const ensureDir = (filePath) => {
+  const dir = dirname(filePath)
+  if (!existsSync(dir)) mkdirSync(dir, { recursive: true })
+}
+
+let cachedHeadSha
+export const getHeadSha = () => {
+  if (cachedHeadSha !== undefined) return cachedHeadSha
+  try {
+    cachedHeadSha = execFileSync('git', ['rev-parse', 'HEAD'], { encoding: 'utf8' }).trim()
+  } catch {
+    cachedHeadSha = null
+  }
+  return cachedHeadSha
+}
+
+/** 供当前 smoke.mjs 进程在最开始清空自己的 attempt 记录(每个 attempt = 一个全新进程)。 */
+export const resetAttemptFragments = () => {
+  ensureDir(ATTEMPT_FRAGMENT_PATH)
+  writeFileSync(ATTEMPT_FRAGMENT_PATH, '')
+}
+
+/** smoke.mjs 每跑完一个 scenario(PASS/FAIL/N_A)调用一次,append 一行 JSON。 */
+export const recordAttemptFragment = (fragment) => {
+  try {
+    ensureDir(ATTEMPT_FRAGMENT_PATH)
+    appendFileSync(ATTEMPT_FRAGMENT_PATH, `${JSON.stringify(fragment)}\n`)
+  } catch (err) {
+    // report-only:台账写失败不阻断真实的 e2e 判定,只打印诊断。
+    console.warn(`[result-ledger] recordAttemptFragment failed: ${err instanceof Error ? err.message : String(err)}`)
+  }
+}
+
+const readJsonlSafe = (path) => {
+  if (!existsSync(path)) return []
+  const raw = readFileSync(path, 'utf8')
+  return raw
+    .split('\n')
+    .map((line) => line.trim())
+    .filter(Boolean)
+    .map((line) => {
+      try {
+        return JSON.parse(line)
+      } catch {
+        return null // 单行坏了不拖垂全体——report-only,宁可丢一行不整体抛错
+      }
+    })
+    .filter(Boolean)
+}
+
+/** e2e-runner.mjs 在子进程 close 后读取本次 attempt 写下的 fragment(s)。 */
+export const readAttemptFragments = () => readJsonlSafe(ATTEMPT_FRAGMENT_PATH)
+
+/** e2e-runner.mjs 在某个「格」的重试循环结束后写入最终汇总记录。 */
+export const appendLedgerRecord = (record) => {
+  try {
+    ensureDir(LEDGER_PATH)
+    appendFileSync(LEDGER_PATH, `${JSON.stringify(record)}\n`)
+  } catch (err) {
+    console.warn(`[result-ledger] appendLedgerRecord failed: ${err instanceof Error ? err.message : String(err)}`)
+  }
+}
+
+/**
+ * 组装单个「格」的最终记录。attempts 是按尝试顺序排列的数组,每项形如
+ * { attempt, status, durationMs, message, pageErrors }(status ∈ PASS/FAIL/N_A,
+ * 单次 attempt 内不会是 RETRY_PASS——RETRY_PASS 只在跨 attempt 汇总时产生)。
+ *
+ * 终态规则:
+ *  - 最后一次 attempt 是 N_A(leafer-skip 等结构性不执行)→ 终态 N_A,不判 flaky。
+ *  - 只有一次 attempt → 终态就是那次的 PASS/FAIL。
+ *  - 多次 attempt 且其中至少一次 PASS → RETRY_PASS(flaky=true)。
+ *  - 多次 attempt 全部 FAIL(重试耗尽)→ FAIL(flaky=false——这是稳定失败,不是抖动)。
+ */
+export const buildLedgerRecord = ({ scenario, renderer, kernel, topology, attempts }) => {
+  const last = attempts[attempts.length - 1]
+  const retries = attempts.length - 1
+  const anyPassed = attempts.some((a) => a.status === 'PASS')
+  let status
+  if (last.status === 'N_A') {
+    status = 'N_A'
+  } else if (attempts.length === 1) {
+    status = last.status
+  } else {
+    status = anyPassed ? 'RETRY_PASS' : 'FAIL'
+  }
+  const flaky = retries > 0 && status === 'RETRY_PASS'
+
+  const pageErrorsByFingerprint = new Map()
+  for (const attempt of attempts) {
+    for (const pageError of attempt.pageErrors || []) {
+      if (!pageErrorsByFingerprint.has(pageError.fingerprint)) {
+        pageErrorsByFingerprint.set(pageError.fingerprint, pageError)
+      }
+    }
+  }
+
+  return {
+    name: `${scenario}::${renderer}::${kernel}::${topology}`,
+    scenario,
+    renderer,
+    kernel,
+    topology,
+    status,
+    durationMs: last.durationMs,
+    flaky,
+    retries,
+    retryAttempts: attempts.map((a) => ({
+      attempt: a.attempt,
+      status: a.status,
+      duration: a.durationMs,
+      message: a.message ?? null,
+    })),
+    message: status === 'FAIL' ? last.message ?? null : null,
+    headSha: getHeadSha(),
+    diagnostics: {
+      pageErrors: [...pageErrorsByFingerprint.values()],
+    },
+    recordedAt: new Date().toISOString(),
+  }
+}
