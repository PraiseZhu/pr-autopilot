diff --git a/scripts/e2e/browser-error-guard.mjs b/scripts/e2e/browser-error-guard.mjs
new file mode 100644
index 00000000..95726e93
--- /dev/null
+++ b/scripts/e2e/browser-error-guard.mjs
@@ -0,0 +1,80 @@
+// scripts/e2e/browser-error-guard.mjs
+//
+// 浏览器未捕获异常(page 'pageerror')的 context 级观测底座——report-only,不影响
+// pass/fail(不进 harness.mjs 的 errors[] 数组,不 throw,不阻断任何 scenario)。
+//
+// 挂载模式抄自 ordpool-space/cat21-indexer 的 browser-error-guard.ts
+// (MIT license,github.com/ordpool-space/cat21-indexer):监听挂在 BrowserContext 上
+// (`context.on('page', ...)`)而不是单个 Page,场景自建的 newPage()/newContext() 因此
+// 自动被覆盖——旧版 harness.mjs 的 page.on('pageerror') 只盯自己创建的那一个 page,
+// coordinate-probe.mjs 的 dpr2Context 与 migration.mjs 的 migrationContext 各自
+// browser.newContext()+newPage() 绕过了它,两处的未捕获异常一直没人在看。isOurApp
+// 过滤思路同源(滤掉 chrome-extension:// / about: 等第三方噪音,不算作 app 自身异常)。
+//
+// 去重用 WeakSet(思路借鉴 danmaku-anywhere 的 console-watcher.ts,但该仓 license 是
+// NOASSERTION——只借用"用 WeakSet 防重复挂载"这个思路,不拷贝其代码):
+// `context.on('page')` 的注册时机与对已存在页面的初始枚举(`context.pages()`)之间
+// 存在窗口,同一个 page 理论上可能被两条路径各挂一次监听;WeakSet 让 hookPageForErrors
+// 对同一 page 幂等,不管调用顺序如何。
+import { createHash } from 'node:crypto'
+
+const instrumentedPages = new WeakSet()
+
+// 当前 scenario 的共享 sink。同一 scenario 内可能有多个 context(主 context + 场景
+// 自建的 migrationContext/dpr2Context 等),它们都写进这同一个 sink,调用方不需要在
+// 每个 attachPageErrorObserver 调用点单独传数组。e2e-smoke.mjs 在每个 scenario 开跑前
+// resetPageErrorSink()、跑完(成功或失败)后 drainPageErrors()。
+let pageErrorSink = []
+
+const isOurApp = (page) => {
+  try {
+    const url = page.url()
+    return url.startsWith('http://') || url.startsWith('https://')
+  } catch {
+    return false
+  }
+}
+
+export const fingerprintMessage = (message) =>
+  createHash('sha256').update(String(message)).digest('hex').slice(0, 12)
+
+const hookPageForErrors = (page) => {
+  if (instrumentedPages.has(page)) return
+  instrumentedPages.add(page)
+  page.on('pageerror', (error) => {
+    const message = error?.message || String(error)
+    // 保留原有诊断行为:未捕获异常始终打到 stdout,便于失败时人工排查。
+    console.log(`[browser pageerror] ${message}`)
+    if (!isOurApp(page)) return
+    let url = null
+    try {
+      url = page.url()
+    } catch {
+      url = null
+    }
+    pageErrorSink.push({ message, fingerprint: fingerprintMessage(message), url })
+  })
+}
+
+/**
+ * 在 BrowserContext 上挂未捕获异常观测。调用时机:在该 context 上第一次 newPage()
+ * 之前(harness.mjs createSmokePage / migration.mjs / coordinate-probe.mjs 均在
+ * browser.newContext() 之后、newPage() 之前调用),保证首个 page 也被覆盖;同时
+ * 兜底枚举 context.pages() 覆盖任何已存在的页面,WeakSet 防重复挂载。
+ */
+export const attachPageErrorObserver = (context) => {
+  for (const page of context.pages()) hookPageForErrors(page)
+  context.on('page', (page) => hookPageForErrors(page))
+}
+
+/** e2e-smoke.mjs 在每个 scenario 开跑前调用,清空共享 sink。 */
+export const resetPageErrorSink = () => {
+  pageErrorSink = []
+}
+
+/** e2e-smoke.mjs 在每个 scenario 跑完(成功或失败)后调用,取走本 scenario 期间收集到的 pageerror。 */
+export const drainPageErrors = () => {
+  const drained = pageErrorSink
+  pageErrorSink = []
+  return drained
+}
