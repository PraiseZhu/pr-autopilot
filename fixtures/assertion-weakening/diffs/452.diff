--- /dev/null
+++ b/src/agent/mediaRefFormat.ts
@@ -0,0 +1,46 @@
+/**
+ * imageRef 的 ext 格式化/校验(#297 T3b1-fix SC-T3b1-fix.3,judge finding P1-B3)。
+ *
+ * 背景(dispatch 记录的已知陷阱):本仓 `ext` 有两套并存约定——`deposit_media` 回执
+ * 用 `.png`(带点,T0 冻结契约的形状),`saveMessage`/附件通道与部分存量账本用
+ * `png`(不带点,见 `depositFlagOff.test.ts` 同文件内两种夹具并存)。`depositMigration.ts`
+ * 的迁移器只校验 `typeof ext === 'string' && ext`,不要求带点——不带点的 ledger ext
+ * 会原样进 `depositMap`(`from:'ledger'`)。`agentBridge.ts` 的 imageRef 构造若原样
+ * 拼接该 ext,会产出 `cindy-media://blobs/<hash>png` 这种缺分隔点、宿主不识别的
+ * 非法 URI,却仍把该 id 标 `available`。
+ *
+ * 本模块是 imageRef 构造前 ext 校验/规范化的唯一入口:
+ *   - 带点且扩展名主体安全(字母数字)→ 原样接受;
+ *   - 不带点但主体本身安全(legacy 无点约定)→ 显式补点规范化;
+ *   - 空 / 含路径分隔符(`/`、`\`)/ 含 `..` / 主体不安全 → 拒绝(fail closed:调用方
+ *     必须把该 id 标 `unavailable`,不得原样拼出非法 URI 却标 `available`)。
+ */
+
+/** 扩展名主体(去掉可能存在的前导点后)必须是安全的字母数字串,长度封顶避免异常输入。 */
+const SAFE_EXT_BODY_RE = /^[a-zA-Z0-9]{1,16}$/
+
+export type ImageRefExtResult = { ok: true; ext: string } | { ok: false; reason: string }
+
+export const normalizeImageRefExt = (rawExt: unknown): ImageRefExtResult => {
+  if (typeof rawExt !== 'string' || !rawExt) {
+    return { ok: false, reason: 'ext 缺失或非字符串' }
+  }
+  if (rawExt.includes('/') || rawExt.includes('\\') || rawExt.includes('..')) {
+    return { ok: false, reason: `ext 含路径分隔符或上级引用,疑似路径注入:${rawExt}` }
+  }
+  const body = rawExt.startsWith('.') ? rawExt.slice(1) : rawExt
+  if (!SAFE_EXT_BODY_RE.test(body)) {
+    return { ok: false, reason: `ext 不是安全的字母数字扩展名:${rawExt}` }
+  }
+  return { ok: true, ext: `.${body}` }
+}
+
+/**
+ * imageRef(`cindy-media://blobs/<hash><ext>`)的唯一构造入口。ext 校验失败时返回
+ * `null`——调用方据此把该 id 判 `unavailable`(fail closed),不得退回到原样拼接。
+ */
+export const buildImageRef = (hash: string, rawExt: unknown): string | null => {
+  const extResult = normalizeImageRefExt(rawExt)
+  if (!extResult.ok) return null
+  return `cindy-media://blobs/${hash}${extResult.ext}`
+}
