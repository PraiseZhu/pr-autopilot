diff --git a/main.js b/main.js
index 7776974f..70f83455 100644
--- a/main.js
+++ b/main.js
@@ -493,8 +493,12 @@ const CARD_FAIL_PAD_TOP = 10
 const CARD_FAIL_PAD_BOTTOM = 8
 const CARD_FAIL_TITLE_H = 18
 const CARD_FAIL_SUB_GAP = 6
-const CARD_FAIL_SOURCE_H = 16 // 单行
-const CARD_FAIL_REASON_H = 32 // 2 行 × 16
+// 副文本行高 —— 下面 .mivo-card__sub 的 line-height 必须用它,不许写死字面量:
+// 源图/原因两个高度都是它的整数倍,行高改了而高度没跟着改,第二行就会被
+// overflow:hidden 静默切掉(正是本文件要修的那个 bug)。测试同时钉住行高与倍数。
+const CARD_FAIL_LINE_H = 16
+const CARD_FAIL_SOURCE_H = CARD_FAIL_LINE_H // 单行
+const CARD_FAIL_REASON_H = 2 * CARD_FAIL_LINE_H // 2 行
 const CARD_FAIL_META_H =
   CARD_FAIL_PAD_TOP + CARD_FAIL_TITLE_H + CARD_FAIL_SUB_GAP + CARD_FAIL_REASON_H + CARD_FAIL_PAD_BOTTOM
 const CARD_FAIL_META_WITH_SOURCE_H = CARD_FAIL_META_H + CARD_FAIL_SUB_GAP + CARD_FAIL_SOURCE_H
@@ -725,7 +729,7 @@ const CARD_STYLE = [
   '.mivo-card__meta{box-sizing:border-box;padding:' + CARD_FAIL_PAD_TOP + 'px 2px ' + CARD_FAIL_PAD_BOTTOM + 'px;',
   'overflow:hidden;color:var(--text-primary, #1a1a1a)}',
   '.mivo-card__title{margin:0;font-size:13px;font-weight:700;line-height:' + CARD_FAIL_TITLE_H + 'px}',
-  '.mivo-card__sub{margin:' + CARD_FAIL_SUB_GAP + 'px 0 0;font-size:12px;line-height:16px;opacity:.72;overflow:hidden}',
+  '.mivo-card__sub{margin:' + CARD_FAIL_SUB_GAP + 'px 0 0;font-size:12px;line-height:' + CARD_FAIL_LINE_H + 'px;opacity:.72;overflow:hidden}',
   // 源图行锁死单行:再长也只占 16px,不会把下面的失败原因顶出可见区。
   '.mivo-card__sub--source{height:' + CARD_FAIL_SOURCE_H + 'px;white-space:nowrap;text-overflow:ellipsis}',
   // 原因区固定 2 行:超长文案被裁的是原因的尾巴,而不是整行消失。
@@ -5587,6 +5591,7 @@ if (seam && typeof seam.expose === 'function') {
         padBottom: CARD_FAIL_PAD_BOTTOM,
         titleH: CARD_FAIL_TITLE_H,
         subGap: CARD_FAIL_SUB_GAP,
+        lineH: CARD_FAIL_LINE_H,
         sourceH: CARD_FAIL_SOURCE_H,
         reasonH: CARD_FAIL_REASON_H,
       },
