 })
+
+// ── r2-select 二轮对抗审查 Finding 1(MAJOR)返修 ─────────────────────────────
+//
+// 被修的缺口:仓内**唯一**走真实 installAgentBridge() 的 snapshot 用例(本文件上面
+// 那条「读动词不受闸门影响」)全部断言只有两行 —— ok:true + snapshot truthy。选中观测
+// 组的三个字段一个都没查。
+//
+// 三层同时假绿的场景:用户只选 target 图。若桥层重构把 selectedNodeCount 弄丢或常量
+// 覆盖(IDs 仍正确),则
+//   · T2a2 纯函数测试绿(直接测派生函数,不经桥)
+//   · T2b/T2c egress 测试绿(用伪造面板回包,自带正确 count)
+//   · 真实桥测试绿(只查 truthy)
+// 而生产 normalizeSelectionObservation 会判该组 invalid → **整组剔除 IDs** → agent 认
+// 不到用户选的那张图。owner 要的能力被打掉,CI 全绿。
+//
+// 生产代码当前没有误传(agentBridge.ts 原样传 page.snapshot),所以这是**门缺口**,
+// 不是已发生的 bug。
+describe('真实桥交接必须整组锁住选中观测组三字段(r2-select Finding 1)', () => {
+  const imageNode = (id: string) => ({
+    id,
+    type: 'image' as const,
+    title: id,
+    x: 0,
+    y: 0,
+    width: 100,
+    height: 100,
+    status: 'ready' as const,
+    assetUrl: `mivo-asset://${id}`,
+  })
+
+  it('target + decoy 两张图、只选 target → 桥回执精确含 target 一个 id、count=1、truncated 缺省;decoy 三条负向断言', async () => {
+    useCanvasStore.setState({
+      nodes: [imageNode('target'), imageNode('decoy')] as never,
+      selectedNodeIds: ['target'],
+    } as never)
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot')
+    const snapshot = reply?.snapshot as Record<string, unknown> | undefined
+    expect(snapshot).toBeTruthy()
+
+    // 正向:三个字段整组精确 —— 用 toEqual 而不是 toContain,后者抓不住「decoy 也混进来」。
+    expect(snapshot?.selectedImageNodeIds).toEqual(['target'])
+    expect(snapshot?.selectedNodeCount).toBe(1)
+    // 该字段的契约是「只允许 true 或缺省」,所以断缺省而不是断 falsy。
+    expect(snapshot?.selectedImageNodesTruncated).toBeUndefined()
+    expect(Object.prototype.hasOwnProperty.call(snapshot ?? {}, 'selectedImageNodesTruncated')).toBe(false)
+
+    // 负向三条(decoy 不得以任何形式渗进去):
+    const ids = snapshot?.selectedImageNodeIds as string[]
+    expect(ids).not.toContain('decoy')                                  // ① 不在 id 清单里
+    expect(snapshot?.selectedNodeCount).not.toBe(2)                     // ② 没被算进计数
+    expect(JSON.stringify(snapshot?.selectedImageNodesTruncated ?? null)).toBe('null') // ③ 没因它置 truncated
+
+    // F7:历史字段仍被剥离(派生字段才是真值来源),这条同时防「有人把剥离撤了当成修复」。
+    expect(snapshot?.selectedNodeIds).toEqual([])
+  })
+
+  it('选中图片数超上限(65 > MAX_SELECTED_IMAGE_NODE_IDS=64)→ truncated:true 且 id 清单长度恰好等于上限', async () => {
+    // 长度必须**恰好**等于上限:main.js 的 egress 校验有一条「truncated 为 true 但长度
+    // 不等于上限」判 invalid,只断 flag 不断长度会漏掉那条约束。
+    const ids = Array.from({ length: 65 }, (_, i) => `img-${i}`)
+    useCanvasStore.setState({
+      nodes: ids.map(imageNode) as never,
+      selectedNodeIds: ids,
+    } as never)
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot')
+    const snapshot = reply?.snapshot as Record<string, unknown> | undefined
+
+    expect(snapshot?.selectedImageNodesTruncated).toBe(true)
+    expect((snapshot?.selectedImageNodeIds as string[]).length).toBe(64)
+    expect(snapshot?.selectedNodeCount).toBe(65)
+  })
+
+  it('什么都没选中(作为输入,不是作为输出)→ 空清单 + count 0 + truncated 缺省', async () => {
+    useCanvasStore.setState({
+      nodes: [imageNode('target'), imageNode('decoy')] as never,
+      selectedNodeIds: [],
+    } as never)
+
+    const { ask } = wireBridge()
+    const reply = await ask('snapshot')
+    const snapshot = reply?.snapshot as Record<string, unknown> | undefined
+
+    expect(snapshot?.selectedImageNodeIds).toEqual([])
+    expect(snapshot?.selectedNodeCount).toBe(0)
+    expect(snapshot?.selectedImageNodesTruncated).toBeUndefined()
+  })
+})
