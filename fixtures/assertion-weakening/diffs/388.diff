diff --git a/src/__tests__/cardActionContinue.test.ts b/src/__tests__/cardActionContinue.test.ts
new file mode 100644
index 00000000..c194665b
--- /dev/null
+++ b/src/__tests__/cardActionContinue.test.ts
@@ -0,0 +1,522 @@
+/**
+ * 「基于这张图继续」协议测试(#297 P2)。
+ *
+ * 权威依据:_tmp/297-dispatch/round2-plan-v3.md P2 节 SC2.1-2.9,与手册 §4.11
+ * (发起 Agent 新回合:一次性点击票据、promptTemplate 双占位、mode:'continue')。
+ *
+ * 与 regen/restyle(#300)共用的部分 —— 级①伪事件过滤、级②记录校验(过期/损坏/
+ * 血缘/会话不匹配)、root-inflight 背压、幂等去重 —— 已由 cardActions.test.ts /
+ * cardActionConcurrency.test.ts 覆盖,这里只测 'continue' 分岔之后独有的行为:
+ * 按钮可见性、agent.run 调用契约、失败矩阵、并发、event 白名单与脱敏。
+ */
+import { describe, expect, it } from 'vitest'
+import { flushUntil } from './brainHarness'
+import {
+  boot,
+  clickAction,
+  coreFor,
+  filesOf,
+  generationRequests,
+  HASH,
+  markup,
+  ROOT_CALL_ID,
+  seedRootRecord,
+} from './cardActionHarness'
+import type { Booted } from './cardActionHarness'
+
+const cardsFor = (booted: Booted, callId: string) => booted.cards().filter((card) => card.callId === callId)
+const doneCardsFor = (booted: Booted, callId: string) => cardsFor(booted, callId).filter((card) => card.state === 'done')
+
+// #297 P2 返修:级②共享前置校验(corrupt/TTL/lineage/session/背压)的现场构造,
+// 与 cardActions.test.ts 的 envelope/seededFiles 同一份手搓落盘形状(wire shape),
+// 这里独立一份是因为那个文件的版本是局部常量,未对外导出。
+const CLOCK_START = 1_700_000_000_000
+const TTL_MS = 30 * 24 * 60 * 60 * 1000
+
+const seededFiles = (records: unknown[], done: string[] = [], attempted: string[] = []): Record<string, string> => ({
+  'card-actions/manifest.json': JSON.stringify({ version: 1, current: 'records-a.json', generation: 7 }),
+  'card-actions/records-a.json': JSON.stringify({ version: 1, records, done, attempted }),
+})
+
+const envelope = (overrides: {
+  recordId: string
+  callId?: string
+  core?: unknown
+  sessionId?: string
+  ownedHash?: string
+  rootCallId?: string
+  parentCallId?: string
+}): Record<string, unknown> => ({
+  callId: overrides.recordId,
+  core: coreFor(),
+  ownedHash: HASH,
+  ext: '.png',
+  ...overrides,
+})
+
+describe('P2 continue 按钮可见性(SC2.1/2.2)', () => {
+  it('done 卡且有合法 owned 指纹 → continue 出现在按钮行, allowlist 校验通过', async () => {
+    const booted = boot()
+    await seedRootRecord(booted)
+    const done = doneCardsFor(booted, ROOT_CALL_ID).pop()
+    const html = markup(done?.html)
+    expect(html).toContain('data-ghost-action="continue"')
+    expect(html).toContain('data-ghost-action="regen"')
+    expect(html).toContain('data-ghost-action="restyle"')
+    // continue 与 regen 一样是零输入动作,不带 data-ghost-prompt。
+    const continueBtn = html.slice(
+      html.indexOf('data-ghost-action="continue"'),
+      html.indexOf('</button>', html.indexOf('data-ghost-action="continue"')),
+    )
+    expect(continueBtn).not.toContain('data-ghost-prompt')
+  })
+
+  it('working / failed 卡零 continue 按钮(与 regen/restyle 同一条既有规则)', () => {
+    const handles = boot().brain.handles
+    for (const phase of ['working', 'failed'] as const) {
+      const version = handles.card.render({
+        phase,
+        actionable: true,
+        actions: ['regen', 'restyle', 'continue'],
+        reason: 'x',
+      })
+      expect(version.html).not.toContain('data-ghost-action')
+    }
+  })
+
+  it('无 owned 指纹(withMedia:false)→ 零 continue 按钮,但 regen/restyle 仍在', async () => {
+    const booted = boot({ withMedia: false })
+    await seedRootRecord(booted)
+    const done = doneCardsFor(booted, ROOT_CALL_ID).pop()
+    const html = markup(done?.html)
+    expect(html).not.toContain('data-ghost-action="continue"')
+    expect(html).toContain('data-ghost-action="regen"')
+    expect(html).toContain('data-ghost-action="restyle"')
+  })
+
+  it('actionId allowlist 恰为三值,且逐个匹配宿主字符集正则', () => {
+    const allow = boot().brain.handles.card.actionIds()
+    expect(allow.slice().sort()).toEqual(['continue', 'regen', 'restyle'])
+    for (const id of allow) expect(id).toMatch(/^[A-Za-z0-9_:-]{1,128}$/)
+  })
+})
+
+describe('P2 continue 成功路径:agent.run 调用契约(SC2.3/2.7/2.8)', () => {
+  it('有票立即调用 agent.run;模板恰一次两个占位;event 白名单恰三键;token 原样;无 trigger/sessionId', async () => {
+    const booted = boot()
+    await seedRootRecord(booted)
+    await clickAction(booted, {
+      actionId: 'continue',
+      spawnCallId: 'spawn-continue-ok',
+      userActionToken: 'tok-abc-123',
+    })
+
+    expect(booted.brain.agentRunCalls).toHaveLength(1)
+    const payload = booted.brain.agentRunCalls[0]
+    expect(payload.mode).toBe('continue')
+    expect(payload.userActionToken).toBe('tok-abc-123')
+    expect(payload).not.toHaveProperty('trigger')
+    expect(payload).not.toHaveProperty('sessionId')
+
+    const template = String(payload.promptTemplate)
+    expect(template.split('{{user_message}}')).toHaveLength(2) // 恰一次 = split 出两段
+    expect(template.split('{{event_json}}')).toHaveLength(2)
+
+    const event = payload.event as Record<string, unknown>
+    expect(Object.keys(event).sort()).toEqual(['actionId', 'artifactHash', 'spawnCallId'])
+    expect(event.artifactHash).toBe(HASH)
+    expect(event.spawnCallId).toBe('spawn-continue-ok')
+    expect(event.actionId).toBe('continue')
+
+    // userMessage 是固定产品文案,不拼接任何自由文本。
+    expect(payload.userMessage).toBe(booted.brain.handles.card.text('en', 'continueUserMessage'))
+  })
+
+  it("disposition 非 'queued'(created/resumed/active/forked,宿主冻结五值去掉 queued)→ 画「已发送」,不误画成「已排队」", async () => {
+    for (const disposition of ['created', 'resumed', 'active', 'forked']) {
+      const booted = boot({ agentRun: () => ({ ok: true, sessionId: 's', mode: 'continue', disposition }) })
+      await seedRootRecord(booted)
+      const spawnCallId = `spawn-disp-${disposition}`
+      await clickAction(booted, { actionId: 'continue', spawnCallId, userActionToken: 'tok' })
+      const done = doneCardsFor(booted, spawnCallId).pop()
+      expect(done?.html).toContain(booted.brain.handles.card.text('en', 'continueSent'))
+      expect(done?.html).not.toContain(booted.brain.handles.card.text('en', 'continueQueued'))
+    }
+  })
+
+  it("disposition:'queued' → 如实画「已排队」,不误画成「已完成/已发送」(SC2.5)", async () => {
+    const booted = boot({ agentRun: () => ({ ok: true, sessionId: 's', mode: 'continue', disposition: 'queued' }) })
+    await seedRootRecord(booted)
+    await clickAction(booted, { actionId: 'continue', spawnCallId: 'spawn-queued', userActionToken: 'tok' })
+    const done = doneCardsFor(booted, 'spawn-queued').pop()
+    expect(done?.html).toContain(booted.brain.handles.card.text('en', 'continueQueued'))
+    expect(done?.html).not.toContain(booted.brain.handles.card.text('en', 'continueSent'))
+  })
+
+  it('extra 未知字段前向兼容忽略,仍画「已发送」', async () => {
+    const booted = boot({
+      agentRun: () => ({ ok: true, sessionId: 's', mode: 'continue', disposition: 'resumed', future: { x: 1 } }),
+    })
+    await seedRootRecord(booted)
+    await clickAction(booted, { actionId: 'continue', spawnCallId: 'spawn-extra-field', userActionToken: 'tok' })
+    const done = doneCardsFor(booted, 'spawn-extra-field').pop()
+    expect(done?.html).toContain(booted.brain.handles.card.text('en', 'continueSent'))
+  })
+
+  it('成功后恰一次终版卡(working→done,不重复终版)', async () => {
+    const booted = boot()
+    await seedRootRecord(booted)
+    await clickAction(booted, { actionId: 'continue', spawnCallId: 'spawn-once', userActionToken: 'tok' })
+    expect(doneCardsFor(booted, 'spawn-once')).toHaveLength(1)
+  })
+
+  it('原卡(callId)不被追加渲染:continue 只画在 spawnCallId 自己的卡位上', async () => {
+    const booted = boot()
+    await seedRootRecord(booted)
+    const before = cardsFor(booted, ROOT_CALL_ID).length
+    await clickAction(booted, { actionId: 'continue', spawnCallId: 'spawn-untouched', userActionToken: 'tok' })
+    expect(cardsFor(booted, ROOT_CALL_ID)).toHaveLength(before)
+  })
+})
+
+describe('P2 continue 无一次性点击票据(SC2.4)', () => {
+  it('缺 userActionToken → 零调用 agent.run,恰一次失败卡带稳定码,原卡不动', async () => {
+    const booted = boot()
+    await seedRootRecord(booted)
+    const before = cardsFor(booted, ROOT_CALL_ID).length
+    await clickAction(booted, { actionId: 'continue', spawnCallId: 'spawn-no-ticket' })
+    expect(booted.brain.agentRunCalls).toHaveLength(0)
+    const failed = doneCardsFor(booted, 'spawn-no-ticket')
+    expect(failed).toHaveLength(1)
+    expect(failed[0].html).toContain(booted.brain.handles.card.text('en', 'errNoTicket'))
+    expect(cardsFor(booted, ROOT_CALL_ID)).toHaveLength(before)
+  })
+
+  it('空字符串票据同样按无票处理(不是"任意 falsy 之外都算有票"的漏判)', async () => {
+    const booted = boot()
+    await seedRootRecord(booted)
+    await clickAction(booted, { actionId: 'continue', spawnCallId: 'spawn-empty-ticket', userActionToken: '' })
