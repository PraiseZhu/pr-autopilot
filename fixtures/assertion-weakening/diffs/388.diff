+    await flushUntil(() => booted.brain.agentRunCalls.length === 1, { label: 'continue entered agent.run' })
+
+    await booted.brain.handles.handleCardAction({
+      type: 'card-action', actionId: 'regen', callId: ROOT_CALL_ID, spawnCallId: 'cross-regen-busy',
+    })
+    const regenBusy = doneCardsFor(booted, 'cross-regen-busy').pop()
+    expect(regenBusy?.html).toContain(booted.brain.handles.card.failureReason('en', 'actionBusy'))
+    expect(booted.brain.handles.cardAction.inflightCount()).toBe(1)
+
+    await booted.brain.handles.handleCardAction({
+      type: 'card-action', actionId: 'restyle', callId: ROOT_CALL_ID,
+      spawnCallId: 'cross-restyle-busy', prompt: 'watercolor',
+    })
+    const restyleBusy = doneCardsFor(booted, 'cross-restyle-busy').pop()
+    expect(restyleBusy?.html).toContain(booted.brain.handles.card.failureReason('en', 'actionBusy'))
+    expect(booted.brain.handles.cardAction.inflightCount()).toBe(1)
+
+    // working→done 落在同一 cardId 通道上,中间隔着卡片限速窗口(CARD_MIN_INTERVAL_MS)
+    // 的一次 clock.setTimeout,纯 flushUntil(不推时钟)等不到它 settle——真实回执已经
+    // 在下面 settle() 的首轮微任务冲刷里被 continueAgentRunBounded 接住并清掉了超时计时器
+    // (settled=true 发生在任何 clock.advance 之前),所以这里推时钟不会撞回 26 分钟超时。
+    finishContinue({ ok: true, sessionId: 's1', mode: 'continue', disposition: 'resumed' })
+    await booted.settle()
+    await first
+    expect(booted.brain.handles.cardAction.inflightCount()).toBe(0)
+
+    const before = generationRequests(booted).length
+    await clickAction(booted, { actionId: 'regen', spawnCallId: 'cross-regen-after' })
+    expect(generationRequests(booted).length).toBe(before + 1) // 名额已释放,新点击能真正进入生成
+  })
+})
