@@ -0,0 +1,87 @@
+/**
+ * 身份卡契约测试 — agent 槽(#297 P2 SC2.8)。
+ *
+ * 独立成文件而不是并进 cardManifest.test.ts:main.js / ghost.json 是本轮多 PR 的
+ * 高竞争面,新增断言另开文件能把 rebase 冲突面收敛到 ghost.json 本身(与
+ * notifyManifest.test.ts / sessionManifest.test.ts 同一惯例)。
+ *
+ * 覆盖 SC2.8「manifest 仅 slots 增 agent(不写 agent:{background:true})」:
+ *   - `agent` 进 slots,且保留之前既有的全部槽;
+ *   - **不声明顶层 `agent` 配置块**(那是 background 模式专属的更重权限,手册
+ *     §4.11 明文:只有清单额外声明 `agent:{background:true}` 时才可不用当次
+ *     点击票据;P2 全程走一次性票据流程,不申请这项权限);
+ *   - 工具数不变(P2 不增工具),守住 ≤16 running total;
+ *   - version 相对 merge-base 严格递增,原有槽一个不少。
+ */
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { readGuardBaseFile } from './mergeBaseGuard'
+
+const MANIFEST_PATH = fileURLToPath(new URL('../../ghost.json', import.meta.url))
+const MANIFEST_REPO_PATH = 'cindyplugin/ghost.json'
+// #297 R11a(subscribe 槽)发布时的槽位集合:agent 之前就存在的全部槽。
+const PRIOR_SLOTS = ['panel', 'fs', 'tool', 'cindy', 'skill', 'card', 'notify', 'subscribe']
+/** §六-1 的工具预算上限(宿主硬约束)。 */
+const TOOL_BUDGET = 16
+// running total:R3/P3-14/R5 三段落地后固定为 8;P2 不加工具。
+const EXPECTED_TOOL_COUNT = 8
+
+type Manifest = {
+  version: string
+  slots: string[]
+  tools: Array<{ name: string }>
+  agent?: unknown
+}
+
+const manifest = (): Manifest => JSON.parse(readFileSync(MANIFEST_PATH, 'utf8')) as Manifest
+
+const parseVersion = (value: string): number[] => {
+  expect(value).toMatch(/^\d+\.\d+\.\d+$/)
+  return value.split('.').map((part) => Number(part))
+}
+
+const compare = (left: number[], right: number[]): number => {
+  for (let i = 0; i < 3; i += 1) {
+    if (left[i] !== right[i]) return left[i] - right[i]
+  }
+  return 0
+}
+
+describe('ghost.json agent 槽契约(#297 P2)', () => {
+  it('保留既有全部槽并新增 agent', () => {
+    const slots = manifest().slots
+    expect(Array.isArray(slots)).toBe(true)
+    for (const slot of PRIOR_SLOTS) expect(slots).toContain(slot)
+    expect(slots).toContain('agent')
+    expect(new Set(slots).size).toBe(slots.length) // 不许重复声明
+  })
+
+  it('不声明顶层 agent 配置块:不申请 background 模式(手册 §4.11)', () => {
+    expect(manifest().agent).toBeUndefined()
+  })
+
+  it('工具数不变,守住 ≤16 running total', () => {
+    const tools = manifest().tools
+    expect(tools).toHaveLength(EXPECTED_TOOL_COUNT)
+    expect(tools.length).toBeLessThanOrEqual(TOOL_BUDGET)
+    expect(new Set(tools.map((tool) => tool.name)).size).toBe(tools.length)
+  })
+
+  // 与 cardManifest.test.ts 共用 mergeBaseGuard 的三档 fail-closed 语义
+  // (CI 判红 / 显式指定基线读不出判红 / 仅本地未指定才跳过)。
+  it('相对 merge-base 版本严格递增、槽位只增不减', (ctx) => {
+    const baseText = readGuardBaseFile(MANIFEST_REPO_PATH, 'agentManifest')
+    if (baseText === null) {
+      ctx.skip() // 只有本地取不到基线才走这里,且 mergeBaseGuard 已打印醒目横幅
+      return
+    }
+    const base = JSON.parse(baseText) as Manifest
+    if (JSON.stringify(base) === JSON.stringify(manifest())) {
+      // manifest 与 merge-base 逐字节一致 = 本分支根本没动它,增量语义无从谈起。
+      return
+    }
+    expect(compare(parseVersion(manifest().version), parseVersion(base.version))).toBeGreaterThan(0)
+    for (const slot of base.slots) expect(manifest().slots).toContain(slot)
+  })
+})
