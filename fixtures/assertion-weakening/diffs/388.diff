+    await seedRootRecord(seeded)
+
+    let finishContinue!: (value: unknown) => void
+    const booted = boot({
+      files: filesOf(seeded),
+      agentRun: () => new Promise((resolve) => { finishContinue = resolve }),
+    })
+    const first = booted.brain.handles.handleCardAction({
+      type: 'card-action',
+      actionId: 'continue',
+      callId: ROOT_CALL_ID,
+      spawnCallId: 'cross-continue-1',
+      userActionToken: 'token-1',
