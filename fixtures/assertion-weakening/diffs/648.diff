+  )
+}
+
+beforeEach(() => {
+  resetCanvasWriteGateForTests()
+  taskMocks.submitEditTask.mockReset().mockResolvedValue('t1')
+  taskMocks.submitGenerationTask.mockReset().mockResolvedValue('t1')
+  taskMocks.submitVariationsTask.mockReset().mockResolvedValue({ taskId: 't1', batchId: 'b1', count: 4 })
+  taskMocks.pollTask.mockReset().mockResolvedValue({
+    id: 't1',
