+vi.mock('../persist/bridge', () => ({ persistRequest: vi.fn() }))
+// 批次链路走真实 agentEditImage → generationFacade.generateImageEdit →
+// mivoTaskClient.submitEditTask/pollTask(与 generation.contract.test.ts 同构 mock 边界)。
+const taskMocks = vi.hoisted(() => ({
+  submitEditTask: vi.fn(),
+  submitGenerationTask: vi.fn(),
+  submitVariationsTask: vi.fn(),
+  pollTask: vi.fn(),
+  cancelTask: vi.fn(),
+  assetBlobForNode: vi.fn(),
+}))
+vi.mock('../../../src/lib/mivoTaskClient', () => ({
+  submitEditTask: taskMocks.submitEditTask,
+  submitGenerationTask: taskMocks.submitGenerationTask,
+  submitVariationsTask: taskMocks.submitVariationsTask,
+  pollTask: taskMocks.pollTask,
+  cancelTask: taskMocks.cancelTask,
+  taskPollIntervalMs: () => 0,
+  kindForFailedTask: () => 'upstream-error' as const,
+}))
+vi.mock('../../../src/lib/mivoImageClient', () => ({
+  assetBlobForNode: taskMocks.assetBlobForNode,
+  MivoImageRequestError: class MivoImageRequestError extends Error {
+    kind: string
+    constructor(message: string, kind: string) {
+      super(message)
+      this.name = 'MivoImageRequestError'
+      this.kind = kind
+    }
+  },
+}))
+vi.mock('../persist/persistSync', () => ({
+  flushPersistNow: async () => true,
+  restoreFromDiskIfEmpty: async () => 'skipped',
+  startAutoSave: () => {},
+}))
+
+import { channelConstructorFor, flushMicrotasks, loadBrain } from './brainHarness'
+import { installAgentBridge } from '../agent/agentBridge'
+import { useCanvasStore } from '../../../src/store/canvasStore'
+import {
+  beginCanvasHydration,
+  markCanvasHydrationComplete,
+  resetCanvasWriteGateForTests,
+} from '../../../src/agent/canvasWriteGate'
+
+const seedSource = () => {
+  const base = useCanvasStore.getState()
+  useCanvasStore.setState(
+    {
+      ...base,
+      canvases: {
+        scene: { title: 'scene', nodes: [{ id: 'img-a', type: 'image', title: 'A', x: 0, y: 0, width: 300, height: 200, status: 'ready', assetUrl: '/a.png' }], edges: [], tasks: [], selectedNodeId: undefined, selectedNodeIds: [] },
+      },
+      sceneId: 'scene',
+      nodes: [{ id: 'img-a', type: 'image', title: 'A', x: 0, y: 0, width: 300, height: 200, status: 'ready', assetUrl: '/a.png' }],
