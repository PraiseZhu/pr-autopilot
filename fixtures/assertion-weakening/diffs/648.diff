+
+type HostOut = { type?: string; ok?: boolean; code?: string; message?: string; result?: Record<string, unknown> }
+
+/**
+ * 跑两次公共 canvas_edit_image 工具调用(同 batchId),让 main.js 经 askPanel 把
+ * 参数投给真实 agent 桥的批次聚合器。返回:宿主出口消息(含 tool-result)、桥收到的
+ * edit 请求参数(全链透传证据)。
+ */
+const runPublicBatch = async (argsList: Array<Record<string, unknown>>, callIds: string[]) => {
+  const sent: HostOut[] = []
+  const brain = loadBrain({
+    panelPresent: () => true,
+    send: (payload) => {
+      sent.push(payload as HostOut)
+      return { ok: true }
+    },
+  })
+  await flushMicrotasks()
+  // 把真实 agent 桥挂到与 main.js 同一个 bus:公共工具经 askPanel 的请求真正到达
+  // 桥的批次聚合器(不是直发 BroadcastChannel 的旁路)。
+  const globals = globalThis as Record<string, unknown>
+  const previous = globals.BroadcastChannel
+  globals.BroadcastChannel = channelConstructorFor(brain.bus)
+  installAgentBridge()
+  globals.BroadcastChannel = previous
+  // 捕获桥收到的 edit 请求,验证 main.js 全链透传
+  const editRequests: Array<{ reqId: string; params: Record<string, unknown> }> = []
+  const probe = brain.bus.open('mivo-canvas-agent')
+  probe.onmessage = (event) => {
+    const data = event.data as
+      | { reqId?: string; verb?: string; reply?: boolean; params?: Record<string, unknown> }
+      | undefined
+    if (data && !data.reply && data.verb === 'edit' && typeof data.reqId === 'string') {
+      editRequests.push({ reqId: data.reqId, params: data.params ?? {} })
+    }
+  }
+  seedSource()
+  beginCanvasHydration()
+  markCanvasHydrationComplete()
+  const pendings = argsList.map((args, i) =>
+    brain.handles.handleToolCall({ tool: 'canvas_edit_image', callId: callIds[i], args }),
+  )
+  await Promise.all(pendings)
+  return { sent, editRequests }
+}
+
+describe('canvas_edit_image 公共工具全链透传进入批次聚合路径', () => {
+  it('两个带 batchId 的公共调用 → 聚合路径:一次预建、两个批次结果、各自回复自己的节点', async () => {
+    const { sent, editRequests } = await runPublicBatch(
+      [
+        { nodeId: 'img-a', prompt: 'pub-0', batchId: 'batch-pub', expectedCount: 2, sceneId: 'scene' },
+        { nodeId: 'img-a', prompt: 'pub-1', batchId: 'batch-pub', expectedCount: 2, sceneId: 'scene' },
+      ],
+      ['e2e-1', 'e2e-2'],
+    )
+    // 两个 tool-result 都成功
+    const results = sent.filter((m) => m.type === 'tool-result')
+    expect(results).toHaveLength(2)
+    results.forEach((r) => expect(r.ok).toBe(true))
+    const nodeIds = results.map((r) => (r.result as { nodeId?: string } | undefined)?.nodeId)
+    expect(nodeIds[0]).toBeTruthy()
+    expect(nodeIds[1]).toBeTruthy()
+    // main.js 全链透传:桥收到的 edit 请求带 batchId/expectedCount/sceneId
+    expect(editRequests).toHaveLength(2)
+    editRequests.forEach((r) => {
+      expect(r.params.batchId).toBe('batch-pub')
+      expect(r.params.expectedCount).toBe(2)
+      expect(r.params.sceneId).toBe('scene')
+    })
+    // 走的是聚合路径:两个结果节点都带批次身份,且各自回复各自的节点(ordinal 0/1)
+    const s = useCanvasStore.getState()
+    const batchResults = s.nodes.filter((n) => n.type === 'image' && n.aiWorkflow?.batchId === 'batch-pub')
+    expect(batchResults).toHaveLength(2)
+    expect(batchResults.map((r) => r.aiWorkflow?.ordinal).sort()).toEqual([0, 1])
+    const byOrdinal = (o: number) => batchResults.find((n) => n.aiWorkflow?.ordinal === o)
+    expect(nodeIds).toEqual([byOrdinal(0)?.id, byOrdinal(1)?.id])
+  })
+
+  it('公共调用不带批次字段 → 走单次路径:结果无批次身份(证明批次字段是进入批次路由的唯一开关)', async () => {
+    const { sent } = await runPublicBatch(
+      [
+        { nodeId: 'img-a', prompt: 'single-0' },
+        { nodeId: 'img-a', prompt: 'single-1' },
+      ],
+      ['e2e-3', 'e2e-4'],
+    )
+    const results = sent.filter((m) => m.type === 'tool-result')
+    expect(results).toHaveLength(2)
+    results.forEach((r) => expect(r.ok).toBe(true))
+    // 单次路径:新节点不带 batchId(各自独立生成,不是批次 slot)
+    const s = useCanvasStore.getState()
+    const withBatchId = s.nodes.filter((n) => n.aiWorkflow?.batchId !== undefined)
+    expect(withBatchId).toHaveLength(0)
+  })
+})
diff --git a/cindyplugin/src/agent/agentBridge.ts b/cindyplugin/src/agent/agentBridge.ts
index 1ba3b65b..848b28dc 100644
--- a/cindyplugin/src/agent/agentBridge.ts
+++ b/cindyplugin/src/agent/agentBridge.ts
@@ -15,6 +15,7 @@ import {
   agentUpdateNode,
   agentReadSnapshotPage,
 } from '../../../src/agent/canvasAgentVerbs'
+import type { AgentGenerateResult } from '../../../src/agent/canvasAgentVerbs'
 import { CanvasExportError } from '../../../src/lib/canvasExport'
 import {
   canvasWriteBlockReason,
@@ -37,6 +38,214 @@ import type { AiCanvasContextNode } from '../../../src/types/mivoCanvas'
 const CHANNEL_NAME = 'mivo-canvas-agent'
 const SOURCE = 'Cindy Plugin Agent Bridge'
 
+// ─── #297 编辑占位批次协调器(SC1)─────────────────────────────────────────────
+// 同一明确 batchId 的 2/3/4 个 edit 请求在调用共享 store action 前聚合 expectedCount
+// 与 ordinal;聚合完成(到员)后先 startDerivedImageBatch 预建全部 slot,再按聚合
+// 顺序把 ordinal 精确绑定给每个请求(经 generateImageEdit 的 replaceSlotId 原位替换)。
+//
+// 批次身份 = 显式凭证四元组(batchId+expectedCount+sceneId+sourceNodeId):首成员
+// 到达时整体冻结,后续任一成员与冻结身份不一致 → fail-closed 拒绝(INVALID_PARAMS),
+// 发生在任何画布 mutation/预建之前;绝不从位置、标题或 reqId 相等推断。
+//
+// 生命周期 pending → flushing → settled:批次注册从建组一直保留到终态 settle,
+// 期间同 batchId 的迟到/重放请求一律确定性拒绝(BATCH_CLOSED),不会产生重复的
+// batchId/ordinal slot 或任务提交。settled 记录带有限保留窗口(TTL + 容量上限,
+// 有界清理);窗口过后同一 batchId 可开启全新批次 —— 清理后重放语义:旧身份已
+// 遗忘,新批次 = 新身份,不会撞旧批次已各自终态的 slot。
+//
+// 缺员/超时 fail-closed:**预建前拒绝**整批(BATCH_TIMEOUT,消息带期望/实际计数),
+// 不预建任何占位 —— 结构性保证零 queued/generating 残留(不再出现「预建了
+// expectedCount 个 slot 却只为到场成员派活,缺员 ordinal 永远卡在 generating」)。
+type PendingBatchEdit = {
+  params: Record<string, unknown>
+  agentRequestTag: string
+  resolve: (outcome: AgentGenerateResult) => void
+  reject: (error: unknown) => void
+}
+type FrozenBatchIdentity = {
+  batchId: string
+  expectedCount: number
+  sceneId: string
+  sourceNodeId: string
+}
+type BatchLifecycle =
+  | { phase: 'pending'; identity: FrozenBatchIdentity; edits: PendingBatchEdit[]; timer?: ReturnType<typeof setTimeout> }
+  | { phase: 'flushing' }
+  | { phase: 'settled'; settledAt: number; outcome: 'completed' | 'rejected' }
+const batchLifecycles = new Map<string, BatchLifecycle>()
+const BATCH_AGGREGATE_TIMEOUT_MS = 8000
+// settled 身份保留窗口:覆盖「聚合 flush 后数秒内到达的迟到/重放成员」;窗口过后
+// 条目被裁剪,同 batchId 可开启全新批次(清理后重放语义见头注释)。
+const BATCH_SETTLED_RETENTION_MS = 5 * 60_000
+// 容量上限(有界清理):即使 TTL 内条目堆积(理论不可能,防御性),注册表也不无界增长。
+const BATCH_LIFECYCLE_MAX = 64
+
+/** 有界清理:过期 settled 条目按 TTL 裁剪;超容量时按 settledAt 从旧到新删 settled。 */
+const pruneSettledBatchLifecycles = (): void => {
+  const now = Date.now()
+  for (const [batchId, lifecycle] of batchLifecycles) {
+    if (lifecycle.phase === 'settled' && now - lifecycle.settledAt > BATCH_SETTLED_RETENTION_MS) {
+      batchLifecycles.delete(batchId)
+    }
+  }
+  if (batchLifecycles.size > BATCH_LIFECYCLE_MAX) {
+    const settled = [...batchLifecycles.entries()]
+      .filter((entry): entry is [string, Extract<BatchLifecycle, { phase: 'settled' }>] => entry[1].phase === 'settled')
+      .sort((a, b) => a[1].settledAt - b[1].settledAt)
+    for (const [batchId] of settled) {
+      if (batchLifecycles.size <= BATCH_LIFECYCLE_MAX) break
+      batchLifecycles.delete(batchId)
+    }
+  }
+}
+
+const rejectBatchGroup = (group: { edits: PendingBatchEdit[] }, code: string, message: string): void => {
+  group.edits.forEach((edit) => edit.reject(new AgentVerbError(code, message)))
+}
+
+const flushBatchGroup = async (group: Extract<BatchLifecycle, { phase: 'pending' }>): Promise<void> => {
+  // pending → flushing:批次注册保留(不再在 flush 时删条目),迟到的同 batchId
+  // 请求在 flushing/settled 期间被确定性拒绝(BATCH_CLOSED)。
+  batchLifecycles.set(group.identity.batchId, { phase: 'flushing' })
+  if (group.timer !== undefined) clearTimeout(group.timer)
+  const { identity, edits } = group
+  const present = edits.length
+  if (present < identity.expectedCount) {
+    // 缺员超时:**预建前拒绝**整批。不预建任何占位 → 结构性零 queued/generating
+    // 残留;timeout 信号明确(BATCH_TIMEOUT + 期望/实际计数),模型改用新 batchId 重试。
+    debugLogger.warn(
+      'Derived Batch',
+      `批次 ${identity.batchId} 缺员超时(期望 ${identity.expectedCount},实际聚合 ${present}),预建前拒绝整批,未创建任何占位`,
+    )
+    rejectBatchGroup(
+      group,
+      'BATCH_TIMEOUT',
+      `批次 ${identity.batchId} 聚合超时:期望 ${identity.expectedCount} 个 edit,实际聚合 ${present} 个,未执行任何修改;请用新 batchId 重试`,
+    )
+    batchLifecycles.set(identity.batchId, { phase: 'settled', settledAt: Date.now(), outcome: 'rejected' })
+    pruneSettledBatchLifecycles()
+    return
+  }
+  try {
+    const store = useCanvasStore.getState()
+    // 用冻结的 sceneId/sourceNodeId 预建(不重读 store.sceneId —— 聚合窗口内用户
+    // 切板不能把批次挪到另一块板上);源图存在性由共享层 startDerivedImageBatch 校验。
+    store.startDerivedImageBatch({
+      sceneId: identity.sceneId,
+      sourceNodeId: identity.sourceNodeId,
+      batchId: identity.batchId,
+      expectedCount: identity.expectedCount,
+    })
+    await Promise.all(
+      edits.map(async (edit, ordinal) => {
+        try {
+          const outcome = await agentEditImage({
+            ...edit.params,
+            sceneId: identity.sceneId,
+            derivedBatchId: identity.batchId,
+            expectedCount: identity.expectedCount,
+            ordinal,
+            agentRequestTag: edit.agentRequestTag,
+          })
+          edit.resolve(outcome)
+        } catch (error) {
+          edit.reject(error)
+        }
+      }),
+    )
+    batchLifecycles.set(identity.batchId, { phase: 'settled', settledAt: Date.now(), outcome: 'completed' })
+  } catch (error) {
+    // 预建失败(源图已删/画布已删等):整批拒绝,已收集请求各自拿到明确错误。
+    debugLogger.error(
+      'Derived Batch',
+      `批次 ${identity.batchId} 预建失败:${error instanceof Error ? error.message : String(error)}`,
+    )
+    rejectBatchGroup(
+      group,
+      'BATCH_PREBUILD_FAILED',
+      `批次 ${identity.batchId} 预建失败,未执行任何修改:${error instanceof Error ? error.message : String(error)}`,
+    )
+    batchLifecycles.set(identity.batchId, { phase: 'settled', settledAt: Date.now(), outcome: 'rejected' })
+  } finally {
+    pruneSettledBatchLifecycles()
+  }
+}
+
+const aggregateBatchEdit = (
+  params: Record<string, unknown>,
+  agentRequestTag: string,
+): Promise<AgentGenerateResult> =>
+  new Promise<AgentGenerateResult>((resolve, reject) => {
+    pruneSettledBatchLifecycles()
+    const batchId = typeof params.batchId === 'string' && params.batchId ? params.batchId : ''
+    const expectedCount = Number.isInteger(params.expectedCount) ? (params.expectedCount as number) : 0
+    if (!batchId || expectedCount < 2 || expectedCount > 4) {
+      reject(new AgentVerbError('INVALID_PARAMS', '批次 edit 必须携带非空 batchId 与 2-4 的 expectedCount'))
+      return
+    }
+    const sourceNodeId = typeof params.nodeId === 'string' && params.nodeId ? params.nodeId : ''
+    if (!sourceNodeId) {
+      reject(new AgentVerbError('INVALID_PARAMS', '批次 edit 必须携带非空 nodeId(源图)'))
+      return
+    }
+    const sceneId =
+      typeof params.sceneId === 'string' && params.sceneId ? params.sceneId : useCanvasStore.getState().sceneId
+    const existing = batchLifecycles.get(batchId)
+    if (!existing) {
+      // 首成员:整体冻结批次身份四元组(batchId+expectedCount+sceneId+sourceNodeId)。
+      const group: BatchLifecycle = {
+        phase: 'pending',
+        identity: { batchId, expectedCount, sceneId, sourceNodeId },
+        edits: [],
+      }
+      batchLifecycles.set(batchId, group)
+      const pending = group as Extract<BatchLifecycle, { phase: 'pending' }>
+      pending.edits.push({ params, agentRequestTag, resolve, reject })
+      pending.timer = setTimeout(() => {
+        void flushBatchGroup(pending)
+      }, BATCH_AGGREGATE_TIMEOUT_MS)
+      return
+    }
+    if (existing.phase !== 'pending') {
+      // flushing / settled:批次已开始执行或已结束,迟到/重放成员确定性拒绝。
+      debugLogger.warn(
+        'Derived Batch',
+        `批次 ${batchId} 已${existing.phase === 'flushing' ? '开始执行' : 'settle'},拒绝迟到/重放成员`,
+      )
+      reject(
+        new AgentVerbError('BATCH_CLOSED', `批次 ${batchId} 已开始执行或已结束,不接受迟到/重放成员(重试请用新 batchId)`),
+      )
+      return
+    }
+    // 批次身份冻结:后续成员必须与首成员冻结的四元组完全一致,任一不符 fail-closed
+    // 拒绝(在任何画布 mutation/预建之前),组本身不受影响、继续聚合。
+    const identity = existing.identity
