+describe('port-issue-2 未读红点定位契约:红点脱离 grid,Flame 保持居中', () => {
+  // 问题(用户实测):未读红点出现前按钮 display:grid + place-items:center,Flame
+  // 正好居中;红点作为第二个 grid 子元素触发 auto-placement 生成第二列隐式轨道,
+  // Flame 被挤到左列。修法:仅插件入口作用域下的红点 absolute(top/right 2px,
+  // pointer-events:none),脱离 grid 布局流 —— 判定口径与同文件既有用例一致,
+  // 读解析后的 CSS 源声明(happy-dom 下 getBoundingClientRect 恒 0,不量像素)。
+  beforeEach(() => {
+    globalThis.IS_REACT_ACT_ENVIRONMENT = true
+    resetStore()
+    renderPlugin()
+  })
+
+  afterEach(() => {
+    act(() => root.unmount())
+    container.remove()
+    document.querySelector('.changelog-backdrop')?.remove()
+  })
+
+  const scopedBadgeRule = () => ruleOf(themeCss, '.plugin-changelog-trigger .changelog-badge-dot')
+  const triggerRule = () => ruleOf(themeCss, '.plugin-changelog-trigger')
+  const bareBadgeRule = () => ruleOf(themeCss, '.changelog-badge-dot')
+
+  it('作用域红点规则声明 absolute + 右上角 + pointer-events: none(有红点时不参与布局)', () => {
+    const rule = scopedBadgeRule()
+    expect(rule, 'cindy-theme.css 必须有 .plugin-changelog-trigger .changelog-badge-dot 规则').not.toBe('')
+    expect(rule).toContain('position: absolute')
+    expect(rule).toContain('top: 2px')
+    expect(rule).toContain('right: 2px')
+    expect(rule).toContain('pointer-events: none')
+  })
+
+  it('按钮仍是绝对定位包含块:grid + place-items 居中 + 34×34,且无 grid-template-columns/grid-auto-flow', () => {
+    const rule = triggerRule()
+    expect(rule).toContain('position: absolute')
+    expect(rule).toContain('display: grid')
+    expect(rule).toContain('place-items: center')
+    expect(rule).toContain('width: 34px')
+    expect(rule).toContain('height: 34px')
+    // 无显式列/流向声明 → 只有单列隐式轨道;红点已 absolute 脱离流,唯一在流
+    // 子元素是 Flame,place-items:center 必然居中(加 grid-template-columns 或
+    // grid-auto-flow 会让红点重新成为可占位 item,此处必须红)
+    expect(rule).not.toMatch(/grid-template-columns|grid-auto-flow/)
+  })
+
+  it('定位只作用域插件入口:非作用域 .changelog-badge-dot(themeCss 皮肤层 / App.css)均无定位声明', () => {
+    // themeCss 的非作用域规则只许皮肤声明(background),不得夹带 position/top/right
+    const skin = bareBadgeRule()
+    expect(skin).not.toMatch(/\bposition\s*:|\btop\s*:|\bright\s*:/)
+    expect(skin).toContain('background: #e05545')
+    // App.css 网页版布局(justify-self: end 网格行)原样保留,不声明 position
+    const web = ruleOf(appCss, '.changelog-badge-dot')
+    expect(web).toContain('justify-self: end')
+    expect(web).not.toMatch(/\bposition\s*:/)
+  })
+
+  it('DOM 契约:两种状态下 Flame svg 都是 trigger 直接子元素;红点是 trigger 直接子元素且 aria-hidden', async () => {
+    const flameSvg = () => container.querySelector('.plugin-changelog-trigger svg') as SVGSVGElement
+    // 已读态:只有 Flame,无红点
+    await act(async () => {
+      useChangelogStore.setState({ loaded: true, updatedAt: '2026-08-10', lastRead: '2026-08-10' })
+    })
+    await act(async () => {})
+    let trigger = container.querySelector('.plugin-changelog-trigger') as HTMLElement
+    expect(flameSvg(), '已读态 Flame 应存在').not.toBeNull()
+    expect(trigger.querySelector('.changelog-badge-dot'), '已读态无红点').toBeNull()
+    // 未读态:Flame 仍在、红点出现且是 trigger 直接子元素(绝对定位的锚点)
+    await act(async () => {
+      useChangelogStore.setState({ loaded: true, updatedAt: '2026-08-10', lastRead: '' })
+    })
+    await act(async () => {})
+    trigger = container.querySelector('.plugin-changelog-trigger') as HTMLElement
+    expect(flameSvg(), '未读态 Flame 仍应在').not.toBeNull()
+    const dot = trigger.querySelector('.changelog-badge-dot') as HTMLElement
+    expect(dot, '未读态红点应存在').not.toBeNull()
+    expect(dot.parentElement, '红点必须是 trigger 直接子元素(锚定右上角的前提)').toBe(trigger)
+    expect(dot.getAttribute('aria-hidden'), '红点是纯装饰,aria-hidden 保持').toBe('true')
+  })
+})
+
