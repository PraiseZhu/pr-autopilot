@@ -0,0 +1,110 @@
+// shared/regionEditCapabilities.ts
+// 区域编辑「更多参数」+ BFF 提交链路的**单一能力真相源**(2026-08-12 R1 三审席②
+// ADV-E1):前端 regionEditParams.ts 的取值域与 server 侧 BFF 校验都从这里取,
+// 避免「前端白名单 6 档、BFF 跨模型宽集合 10 档」这类域漂移 —— 宽集合放行的值
+// 要么被静默夹成别的出图参数,要么被平台侧拒绝,用户都无从知晓。
+//
+// 取值来源:2026-08-11 对 Mivo 平台(aigc.xindong.com)的真实探测任务(详见
+// src/canvas/regionEditParams.ts 头注释):21:9 两模型实测可出图;NANO 的 8K
+// 平台侧判生成失败不放行;GPT 通道无 resolution 概念(只发 quality)。
+//
+// 本文件必须是纯模块:零依赖、零副作用,src 与 server 两侧都能 import。
+
+/** 走本能力契约的平台出图模型(其余模型走 llm-proxy 路径,域校验在各自路由)。 */
+export const REGION_EDIT_PLATFORM_MODELS = ['gpt-image-2', 'gemini-3-pro-image'] as const
+export type RegionEditPlatformModel = (typeof REGION_EDIT_PLATFORM_MODELS)[number]
+
+export type RegionEditModelCapabilities = {
+  /** imgRatio 合法档。GPT 平台侧 5 档 + 实测可用的 21:9 = 6 档;NANO 9 档 + 21:9 = 10 档。 */
+  ratios: readonly string[]
+  /** resolution 合法档。GPT 通道无 resolution 概念 → 空数组 = 任何显式值都非法。 */
+  resolutions: readonly string[]
+  /** quality 合法档。 */
+  qualities: readonly string[]
+  /** count(平台 n)合法整数区间。前端只提供 1/2/4,平台接受 1~4。 */
+  countMin: number
+  countMax: number
+}
+
+export const REGION_EDIT_CAPABILITIES: Record<RegionEditPlatformModel, RegionEditModelCapabilities> = {
+  'gpt-image-2': {
+    ratios: ['1:1', '2:3', '3:2', '16:9', '9:16', '21:9'],
+    resolutions: [],
+    qualities: ['low', 'medium', 'high'],
+    countMin: 1,
+    countMax: 4,
+  },
+  'gemini-3-pro-image': {
+    ratios: ['1:1', '16:9', '9:16', '4:3', '3:4', '2:3', '3:2', '4:5', '5:4', '21:9'],
+    resolutions: ['1K', '2K', '4K'],
+    qualities: ['low', 'medium', 'high'],
+    countMin: 1,
+    countMax: 4,
+  },
+}
+
+export type RegionEditCapabilityViolation = { field: string; message: string }
+
+/**
+ * 按目标模型 exact 校验外部提交参数。非平台模型(本契约未覆盖)一律放行 ——
+ * 它们的域校验在 llm-proxy 路径各自的逻辑里。空字符串视为「字段缺省」跳过。
+ * 非法值返回逐条违规(不抛错),调用方决定 4xx 还是 fail-closed。
+ */
+export const validateRegionEditCapabilities = (input: {
+  model: string
+  imgRatio?: unknown
+  resolution?: unknown
+  quality?: unknown
+  count?: unknown
+}): RegionEditCapabilityViolation[] => {
+  const caps = REGION_EDIT_CAPABILITIES[input.model as RegionEditPlatformModel]
+  if (!caps) return []
+  const violations: RegionEditCapabilityViolation[] = []
+
+  if (input.imgRatio !== undefined && input.imgRatio !== null && input.imgRatio !== '') {
+    const ratio = String(input.imgRatio)
+    if (!caps.ratios.includes(ratio)) {
+      violations.push({
+        field: 'imgRatio',
+        message: `imgRatio '${ratio}' is not supported for model ${input.model} (allowed: ${caps.ratios.join(', ')})`,
+      })
+    }
+  }
+
+  if (input.resolution !== undefined && input.resolution !== null && input.resolution !== '') {
+    const resolution = String(input.resolution)
+    if (caps.resolutions.length === 0) {
+      violations.push({
+        field: 'resolution',
+        message: `resolution is not supported for model ${input.model} (this channel uses quality instead)`,
+      })
+    } else if (!caps.resolutions.includes(resolution)) {
+      violations.push({
+        field: 'resolution',
+        message: `resolution '${resolution}' is not supported for model ${input.model} (allowed: ${caps.resolutions.join(', ')})`,
+      })
+    }
+  }
+
+  if (input.quality !== undefined && input.quality !== null && input.quality !== '') {
+    const quality = String(input.quality)
+    if (!caps.qualities.includes(quality)) {
+      violations.push({
+        field: 'quality',
+        message: `quality '${quality}' is not supported for model ${input.model} (allowed: ${caps.qualities.join(', ')})`,
+      })
+    }
+  }
+
+  if (input.count !== undefined && input.count !== null && input.count !== '') {
+    const parsed = typeof input.count === 'number' ? input.count : Number(String(input.count))
+    if (!Number.isInteger(parsed) || parsed < caps.countMin || parsed > caps.countMax) {
+      violations.push({
+        field: 'count',
+        message: `count must be an integer between ${caps.countMin} and ${caps.countMax} (got '${String(input.count)}')`,
+      })
+    }
+  }
+
+  return violations
+}
