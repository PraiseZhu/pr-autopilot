+    selectedNodeIds: [],
+  }
+}
+
+describe('「更多参数」端到端透传到 submitEditTask (ADV-A1)', () => {
+  beforeEach(() => {
+    useCanvasStore.setState({ ...baseState } as never, true)
+    taskClientSpies.submitEditTask.mockReset()
+    taskClientSpies.pollTask.mockReset()
+    taskClientSpies.cancelTask.mockReset()
+    inspectArtifactsSpy.mockReset()
+  })
+
+  const runWithPayload = async (payloadExtra: Record<string, unknown>, argsImgRatio = '1:1') => {
+    const source = imageNode({ id: 'src-1' })
+    useCanvasStore.setState({ ...baseState, ...seedCanvas('character-flow', [source]) } as never, true)
+    const { slotId } = prepareMaskEditPlaceholder('character-flow', source, 'p')
+    taskClientSpies.submitEditTask.mockResolvedValueOnce('task-1')
+    taskClientSpies.pollTask.mockResolvedValueOnce({
+      status: 'done',
+      progress: 100,
+      stage: 'done',
+      result: { images: [{ b64: 'aGk=', mimeType: 'image/png' }] },
+    })
+    inspectArtifactsSpy.mockReturnValue({ hasArtifact: false, components: [] })
+    await runMaskEditGeneration({
+      sceneId: 'character-flow',
+      source,
+      slotId,
+      resolvedAssetUrl: undefined,
+      payload: {
+        prompt: 'p',
+        sourceSize: { width: 200, height: 200 },
+        model: 'gemini-3-pro-image',
+        ...payloadExtra,
+      } as never,
+      imgRatio: argsImgRatio as never,
+      signal: new AbortController().signal,
+    })
+    return taskClientSpies.submitEditTask.mock.calls[0][0] as Record<string, unknown>
+  }
+
+  it('① payload.imgRatio 送达,且优先于外层 args.imgRatio(面板选择压过上游旧值)', async () => {
+    const req = await runWithPayload({ imgRatio: '16:9' }, '1:1')
+    expect(req.imgRatio).toBe('16:9')
+  })
+
+  it('payload 无 imgRatio 时回落 args(局部重绘等不走「更多参数」的路径)', async () => {
+    const req = await runWithPayload({}, '9:16')
+    expect(req.imgRatio).toBe('9:16')
+  })
+
+  it('② payload.resolution 送达(NANO 的精确分辨率档)', async () => {
+    const req = await runWithPayload({ imgRatio: '1:1', resolution: '4K' })
+    expect(req.resolution).toBe('4K')
