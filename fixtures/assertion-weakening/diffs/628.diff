+
+import { useCanvasStore } from './canvasStore'
+import { useChatStore } from './chatStore'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+const imageNode = (overrides: Partial<MivoCanvasNode> = {}): MivoCanvasNode => ({
+  id: 'n1',
