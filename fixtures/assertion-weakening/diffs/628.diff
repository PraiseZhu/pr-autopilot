+    expect(req.count).toBe(4)
+  })
+
+  it('缺省时不发 resolution/count 字段,与改造前同形(BFF 走存量 quality 换算与 n=1)', async () => {
+    const req = await runWithPayload({ imgRatio: '1:1' })
+    expect(req).not.toHaveProperty('resolution')
+    expect(req).not.toHaveProperty('count')
+  })
+
+  it('count=1 也不发字段(单张是缺省语义,发 n=1 与不发等价但徒增协议面)', async () => {
+    const req = await runWithPayload({ imgRatio: '1:1', count: 1 })
+    expect(req).not.toHaveProperty('count')
+  })
+})
