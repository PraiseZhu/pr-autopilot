+// shared/regionEditCapabilities.test.ts
+// 区域编辑能力表 + exact 校验器的纯函数契约(2026-08-12 ADV-E1)。
+// 端到端路径(路由 4xx)由 server/__tests__/c1a.test.ts 锁;这里锁纯函数本身,
+// 保证「前端取域」与「BFF 校验」共用同一张表的形状不漂移。
+import { describe, it, expect } from 'vitest'
+import {
+  REGION_EDIT_CAPABILITIES,
+  REGION_EDIT_PLATFORM_MODELS,
+  validateRegionEditCapabilities,
+} from './regionEditCapabilities'
+
+describe('REGION_EDIT_CAPABILITIES — 每模型 exact 域', () => {
+  it('两张表都只登记平台出图模型', () => {
+    expect(REGION_EDIT_PLATFORM_MODELS).toEqual(['gpt-image-2', 'gemini-3-pro-image'])
+    expect(Object.keys(REGION_EDIT_CAPABILITIES).sort()).toEqual(
+      [...REGION_EDIT_PLATFORM_MODELS].sort(),
+    )
+  })
+
+  it('GPT:6 档比例、无 resolution、三档 quality;NANO:10 档比例、1K/2K/4K、三档 quality', () => {
+    const gpt = REGION_EDIT_CAPABILITIES['gpt-image-2']
+    expect(gpt.ratios).toEqual(['1:1', '2:3', '3:2', '16:9', '9:16', '21:9'])
+    expect(gpt.resolutions).toEqual([])
+    expect(gpt.qualities).toEqual(['low', 'medium', 'high'])
+    expect([gpt.countMin, gpt.countMax]).toEqual([1, 4])
+
+    const nano = REGION_EDIT_CAPABILITIES['gemini-3-pro-image']
+    expect(nano.ratios).toHaveLength(10)
+    expect(nano.ratios).toContain('21:9') // 实测可出图
+    expect(nano.resolutions).toEqual(['1K', '2K', '4K'])
+    expect(nano.qualities).toEqual(['low', 'medium', 'high'])
+    expect([nano.countMin, nano.countMax]).toEqual([1, 4])
+  })
+
+  it('NANO 比例域是 GPT 的超集(4:3/3:4/4:5/5:4 是 NANO 独有)', () => {
+    const nano = new Set(REGION_EDIT_CAPABILITIES['gemini-3-pro-image'].ratios)
+    const gpt = new Set(REGION_EDIT_CAPABILITIES['gpt-image-2'].ratios)
+    for (const r of gpt) expect(nano.has(r)).toBe(true)
+    for (const r of ['4:3', '3:4', '4:5', '5:4']) expect(nano.has(r)).toBe(true)
+  })
+})
+
+describe('validateRegionEditCapabilities — exact 校验', () => {
+  it('合法输入零违规', () => {
+    expect(
+      validateRegionEditCapabilities({ model: 'gpt-image-2', imgRatio: '21:9', quality: 'high', count: 4 }),
+    ).toEqual([])
+    expect(
+      validateRegionEditCapabilities({ model: 'gemini-3-pro-image', imgRatio: '4:3', resolution: '4K', count: 2 }),
+    ).toEqual([])
+    // 空字符串 = 字段缺省,跳过
+    expect(validateRegionEditCapabilities({ model: 'gpt-image-2', imgRatio: '', resolution: '', count: '' })).toEqual([])
+  })
+
+  it('GPT 拒绝 NANO 独有比例(跨模型宽域内、前端域外)', () => {
+    const vs = validateRegionEditCapabilities({ model: 'gpt-image-2', imgRatio: '4:3' })
+    expect(vs).toHaveLength(1)
+    expect(vs[0].field).toBe('imgRatio')
+    expect(vs[0].message).toContain('4:3')
+    expect(vs[0].message).toContain('gpt-image-2')
+  })
+
+  it('GPT 拒绝任何 resolution(该通道无此概念)', () => {
+    const vs = validateRegionEditCapabilities({ model: 'gpt-image-2', resolution: '4K' })
+    expect(vs).toHaveLength(1)
+    expect(vs[0].field).toBe('resolution')
+  })
+
+  it('NANO 拒绝 8K;接受 1K/2K/4K', () => {
+    expect(validateRegionEditCapabilities({ model: 'gemini-3-pro-image', resolution: '8K' })[0].field).toBe('resolution')
+    expect(validateRegionEditCapabilities({ model: 'gemini-3-pro-image', resolution: '1K' })).toEqual([])
+  })
+
+  it('count 必须是 1~4 整数:2.9/0/7/abc 都违规,字符串数字 2 合法', () => {
+    for (const bad of [2.9, 0, 7, 'abc', '2.9', '']) {
