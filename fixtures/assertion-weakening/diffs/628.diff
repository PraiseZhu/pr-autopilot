+// src/store/commitGenerationResult.multiSlotBatch.test.ts
+// 集成契约:#628 多槽位(张数=占位数)与 main P1b #297 编辑占位批次契约**同时成立**。
+//
+// main 把 commitGenerationResult 拆到独立文件并新增 batch 契约(被替换 slot 带
+// batchId 时:heightLockedSizeForDimensions 高度锁定 + batchMetadata 批次身份继承);
+// #628 的多槽位能力(replaceSlotIds → 逐张替换 + 未消费额外槽清理)与之并存:
+//  - 多槽位 + 每槽都是 batch slot → 每张结果继承各自槽的 batch 身份(batchId/
+//    expectedCount/ordinal)且尺寸高度锁定;
+//  - 结果数 < 请求槽数 → 未消费额外槽清理(batch 槽同样被清)。
+import { describe, expect, it, vi, beforeEach } from 'vitest'
+
+vi.mock('../lib/demoImages', () => ({
+  createDemoImage: () => 'data:image/png;base64,mock-demo-image',
+}))
+vi.mock('../lib/assetStorage', () => ({
+  saveGeneratedAsset: vi.fn(async (_blob: Blob, name: string, type: string) => ({
+    assetUrl: 'mivo-asset://mock-asset',
+    name,
+    type,
+    sizeBytes: 1234,
+    hasTransparency: false,
+    size: '300x200',
+    sourceDimensions: { width: 300, height: 200 },
+  })),
+  saveImportedAsset: vi.fn(async () => ({ assetUrl: 'mivo-asset://mock-imported' })),
+  readImportedAssetFile: vi.fn(),
+}))
+vi.mock('./remoteDebugReporter', () => ({
+  reportRemoteDebugEntry: () => {},
+}))
+
+import { useCanvasStore } from './canvasStore'
+import { useChatStore } from './chatStore'
+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+const source = (overrides: Partial<MivoCanvasNode> = {}): MivoCanvasNode => ({
+  id: 'n1',
+  type: 'image',
+  title: 'Image',
+  x: 10,
+  y: 20,
+  width: 300,
+  height: 200,
+  status: 'ready',
+  assetUrl: '/a.png',
+  ...overrides,
+})
+
+const baseState = useCanvasStore.getState()
+
+const emptyDoc = (title: string, nodes: MivoCanvasNode[] = []) => ({
+  title,
+  nodes,
+  edges: [],
+  tasks: [],
+  selectedNodeId: undefined,
+  selectedNodeIds: [],
+})
+
+const seedScene = () => {
+  const doc = emptyDoc('scene-a', [source()])
+  useCanvasStore.setState(
+    {
+      ...baseState,
+      canvases: { 'scene-a': doc },
+      sceneId: 'scene-a',
+      nodes: doc.nodes,
+      edges: [],
+      tasks: [],
+      selectedNodeId: undefined,
+      selectedNodeIds: [],
+      historyPast: [],
+      historyFuture: [],
+    } as never,
+    true,
+  )
+}
+
+const resultImage = (index: number) => ({
+  blob: new Blob([`mock-image-bytes-${index}`], { type: 'image/png' }),
+  title: `Generated image ${index}`,
+  width: 300,
+  height: 200,
+})
+
+/** 造一个带 batch 身份的 batch slot(仿 startDerivedImageBatch 产出的槽)。 */
+const addBatchSlot = (batchId: string, expectedCount: number, ordinal: number): string => {
+  const id = useCanvasStore.getState().addAiSlotNode({ x: 330, y: 20 + ordinal * 220 }, { width: 200, height: 200 }, 'wait', {
+    sceneId: 'scene-a',
+  })
+  const state = useCanvasStore.getState()
+  const doc = state.canvases['scene-a']
+  useCanvasStore.setState({
+    ...state,
+    canvases: {
+      ...state.canvases,
+      'scene-a': {
+        ...doc,
+        nodes: doc.nodes.map((n) =>
+          n.id === id
+            ? ({
+                ...n,
+                locked: true,
+                aiWorkflow: {
+                  ...(n.aiWorkflow ?? {}),
+                  batchId,
+                  expectedCount,
+                  ordinal,
+                  status: 'generating',
+                },
+              } as MivoCanvasNode)
+            : n,
+        ),
+      },
