+import { describe, expect, it } from 'vitest'
+
+import { maskEditSlotPlanFor, resolutionBadgeForSize } from './maskEditSlotPlan'
+
+const BASE = { width: 320, height: 320 }
+const areaOf = (s: { width: number; height: number }) => s.width * s.height
+
+describe('maskEditSlotPlanFor — 张数', () => {
+  it('缺省 = 1 个占位(旧行为)', () => {
+    expect(maskEditSlotPlanFor({ baseSize: BASE }).count).toBe(1)
+  })
+
+  it('选几张就画几个框', () => {
+    expect(maskEditSlotPlanFor({ baseSize: BASE, count: 4 }).count).toBe(4)
+  })
+
+  it('夹到平台上限 4,不放行 5', () => {
+    expect(maskEditSlotPlanFor({ baseSize: BASE, count: 9 }).count).toBe(4)
+  })
+
+  it('非法输入(NaN/负数/小数/字符串)一律落回合法档', () => {
+    expect(maskEditSlotPlanFor({ baseSize: BASE, count: Number.NaN }).count).toBe(1)
+    expect(maskEditSlotPlanFor({ baseSize: BASE, count: -3 }).count).toBe(1)
+    expect(maskEditSlotPlanFor({ baseSize: BASE, count: 2.9 }).count).toBe(2)
+    expect(maskEditSlotPlanFor({ baseSize: BASE, count: '3' as unknown as number }).count).toBe(3)
+  })
+})
+
+describe('maskEditSlotPlanFor — 比例优先级', () => {
+  it('显式 imgRatio 优先于源图', () => {
+    const plan = maskEditSlotPlanFor({
+      baseSize: BASE,
+      imgRatio: '16:9',
+      sourceSize: { width: 1000, height: 1000 },
+    })
+    expect(plan.slotSize.width / plan.slotSize.height).toBeCloseTo(16 / 9, 1)
+  })
+
+  it('无 imgRatio 时跟源图比例——这是「保持原比例」的落点,不是恒定方形', () => {
+    const plan = maskEditSlotPlanFor({ baseSize: BASE, sourceSize: { width: 1264, height: 848 } })
+    expect(plan.slotSize.width / plan.slotSize.height).toBeCloseTo(1264 / 848, 1)
+    expect(plan.slotSize.width).toBeGreaterThan(plan.slotSize.height)
+  })
+
+  it('两者都没有才回退基准尺寸自身比例', () => {
+    const plan = maskEditSlotPlanFor({ baseSize: { width: 400, height: 200 } })
+    expect(plan.slotSize.width / plan.slotSize.height).toBeCloseTo(2, 1)
+  })
+})
+
+describe('maskEditSlotPlanFor — 画质分档', () => {
+  it('缺省档面积 = 基准面积', () => {
+    const plan = maskEditSlotPlanFor({ baseSize: BASE })
+    expect(areaOf(plan.slotSize)).toBeCloseTo(areaOf(BASE), -3)
+  })
+
+  it('高档比低档大,且 4K > 2K > 1K 单调', () => {
+    const a1k = areaOf(maskEditSlotPlanFor({ baseSize: BASE, resolution: '1K' }).slotSize)
+    const a2k = areaOf(maskEditSlotPlanFor({ baseSize: BASE, resolution: '2K' }).slotSize)
+    const a4k = areaOf(maskEditSlotPlanFor({ baseSize: BASE, resolution: '4K' }).slotSize)
+    expect(a2k).toBeGreaterThan(a1k)
+    expect(a4k).toBeGreaterThan(a2k)
+  })
+
+  it('GPT 的 quality 档与 NANO 的 resolution 档各自生效(两套参数不互相换算)', () => {
+    const byQuality = areaOf(maskEditSlotPlanFor({ baseSize: BASE, quality: 'high' }).slotSize)
+    const byResolution = areaOf(maskEditSlotPlanFor({ baseSize: BASE, resolution: '4K' }).slotSize)
+    // high 与 4K 恰好同系数,但走的是两条 key —— 断言的是「quality 也能分档」而非两者相等的必然性
+    expect(byQuality).toBeGreaterThan(areaOf(maskEditSlotPlanFor({ baseSize: BASE, quality: 'low' }).slotSize))
+    expect(byResolution).toBeGreaterThan(areaOf(maskEditSlotPlanFor({ baseSize: BASE, resolution: '1K' }).slotSize))
+  })
+
+  it('resolution 在场时优先于 quality(NANO 通道两个字段都可能带)', () => {
+    const plan = maskEditSlotPlanFor({ baseSize: BASE, resolution: '1K', quality: 'high' })
+    expect(areaOf(plan.slotSize)).toBeCloseTo(areaOf(BASE), -3)
+  })
+
+  it('等面积换算:同一档下横竖两个比例的面积相当(16:9 与 9:16 份量一致)', () => {
+    const land = areaOf(maskEditSlotPlanFor({ baseSize: BASE, imgRatio: '16:9' }).slotSize)
+    const port = areaOf(maskEditSlotPlanFor({ baseSize: BASE, imgRatio: '9:16' }).slotSize)
+    expect(land / port).toBeCloseTo(1, 1)
+  })
+})
+
+describe('resolutionBadgeForSize — 由结果尺寸反推档位', () => {
+  it('长边判据:2K 的 16:9 实出 2528x1696 判 2K', () => {
+    expect(resolutionBadgeForSize({ width: 2528, height: 1696 })).toBe('2K')
+  })
+
+  it('4K 档', () => {
+    expect(resolutionBadgeForSize({ width: 4096, height: 4096 })).toBe('4K')
+  })
+
+  it('1K 不打角标(低档无需标注)', () => {
+    expect(resolutionBadgeForSize({ width: 1024, height: 1024 })).toBeUndefined()
+  })
+
+  it('缺尺寸/非法尺寸不打角标', () => {
+    expect(resolutionBadgeForSize(undefined)).toBeUndefined()
+    expect(resolutionBadgeForSize({ width: 0, height: 100 })).toBeUndefined()
+  })
+
+  it('窄幅高清按长边判档,不因面积小而降档', () => {
+    // 2K 的 21:9 约 2528x1084:面积不到 2048² 的 65%,但长边够,仍是 2K
+    expect(resolutionBadgeForSize({ width: 2528, height: 1084 })).toBe('2K')
+  })
+})
diff --git a/src/canvas/maskEditSlotPlan.ts b/src/canvas/maskEditSlotPlan.ts
