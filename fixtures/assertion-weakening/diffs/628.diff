+import type { MivoCanvasNode } from '../types/mivoCanvas'
+
+/**
+ * 多占位替换的纯计算部分(owner 2026-08-11「张数=占位数」)。
+ *
+ * 从 documentSlice 提出来有两个理由:一是它是纯函数、可独立测;二是 documentSlice
+ * 在 main 上就已经 900 行、正好卡在结构守卫上限,任何新增都会越界。守卫要求
+ * 「拆分后入库」而不是上调 baseline,这里照办。
+ */
+
+/**
+ * 把两种占位入参收敛成统一的 id 列表:`replaceSlotIds` 优先,`replaceSlotId` 视作
+ * 单元素。下游一律按「第 i 张结果替换第 i 个 slot」处理,不再有单/多两套分支。
+ */
+export const resolveReplaceSlotIds = (input: {
+  replaceSlotId?: string
+  replaceSlotIds?: string[]
+}): string[] => input.replaceSlotIds ?? (input.replaceSlotId ? [input.replaceSlotId] : [])
+
+/**
+ * 在当前文档里查出这批 slot 节点。
+ *
+ * 语义差异是刻意的:**首个** slot 缺失 = 用户撤销了整次生成(旧语义,调用方据此
+ * 中止落图);**第 2..n 个**缺失只是那一张少个坑位,该张回落邻位摆放即可,不该
+ * 因此丢弃已经出好的图。返回值里用 undefined 占位保持下标对齐。
+ */
+export const findReplacementSlots = (
+  nodes: MivoCanvasNode[],
+  slotIds: string[],
+): { primary: MivoCanvasNode | undefined; extras: Array<MivoCanvasNode | undefined> } => {
+  const findSlot = (id: string): MivoCanvasNode | undefined =>
+    nodes.find((node) => node.id === id && node.type === 'ai-slot' && !node.hidden)
+  return {
+    primary: slotIds[0] ? findSlot(slotIds[0]) : undefined,
+    extras: slotIds.slice(1).map(findSlot),
+  }
+}
+
+/**
+ * 同批统一展示尺寸(owner 2026-08-11 实测反馈第 4 条:「同一批次的 4 个图片大小不一致」)。
+ *
+ * 旧实现首张走「等面积替换占位」、余量张走「资产自然尺寸邻位摆放」两套算法,同批出的
+ * 图在画布上大小参差,连 1K 与 2K 的档位差都被这份噪声淹没、肉眼分不出来。
+ * 现在首张定标、余量张逐字复用:同批必然同尺寸,不同画质档之间的差异才显现得出来。
+ *
+ * 首张自身怎么定标(2026-07-05 用户二次澄清,取代 #86 W2-F5「替换保留占���尺寸」契约):
+ * 所有生图占位符一律按目标比例 loading,替换时按结果图自然宽高比、与占位符**等面积**
+ * 落画布 —— edit 结果与源图同比例由生成本身保证,无需靠占位尺寸传递;结果无自然尺寸
+ * 信息时 equalAreaSizeForDimensions 内部回退占位尺寸。非占位摆放不变,仍用资产自然尺寸。
+ */
+export const batchDisplaySizeTracker = () => {
+  let size: { width: number; height: number } | undefined
+  return {
+    /** 首次调用记下 compute() 的结果,此后一律返回那一份。 */
+    resolve(compute: () => { width: number; height: number }): { width: number; height: number } {
+      if (!size) size = compute()
+      return size
+    },
+  }
+}
+
+/**
+ * 单张结果的兜底尺寸:优先跟随「它要替换的占位」或「源节点」,两者都没有才用图片
+ * 自身的像素尺寸,再没有就落节点类型的默认值。
+ *
+ * 抽出来是因为这段三级回退在 documentSlice 里读起来像噪声,而它其实是一条独立的
+ * 决策链 —— 「新节点该多大」在有占位时由占位定、无占位时由源图定。
+ */
+export const fallbackSizeForResult = (
+  replacingSlot: MivoCanvasNode | undefined,
+  currentSource: MivoCanvasNode | undefined,
+  image: { width?: number; height?: number },
+  defaultSize: { width: number; height: number },
+): { width: number; height: number } => {
+  const anchor = replacingSlot || currentSource
+  if (anchor) return { width: anchor.width, height: anchor.height }
+  return {
+    width: image.width || defaultSize.width,
+    height: image.height || defaultSize.height,
+  }
+}
+
+/**
+ * 清理未被结果消费的额外占位槽(PR #628 Greptile P1)。
+ *
+ * 请求多张但平台少回/部分下载失败时,「第 i 张结果替换第 i 个 slot」只消费前
+ * results.length 个 slot,末尾未消费的 extra slot 若不清掉会永久 loading。
+ *
+ * 删除条件:只删仍在场、type=ai-slot、index ≥ consumedExtras 的 slot;用户已删除
+ * 的 slot 不在场内自然跳过(第 2..n 个缺失只是少个坑位,不中断落图);相连 edges
+ * (from/to 指向被删 slot)同步移除,不留悬挂引用。无 stale 时原样返回入参。
+ */
+export const pruneUnconsumedReplacementSlots = <T extends { from: string; to: string }>(
+  extras: Array<MivoCanvasNode | undefined>,
+  consumedExtras: number,
+  nodes: MivoCanvasNode[],
+  edges: T[],
+): { nodes: MivoCanvasNode[]; edges: T[] } => {
+  const staleSlots = extras.slice(Math.max(0, consumedExtras)).filter((s): s is MivoCanvasNode => Boolean(s))
+  if (staleSlots.length === 0) return { nodes, edges }
+  const staleSlotIds = new Set(staleSlots.map((s) => s.id))
+  return {
+    nodes: nodes.filter((node) => !staleSlotIds.has(node.id)),
+    edges: edges.filter((edge) => !staleSlotIds.has(edge.from) && !staleSlotIds.has(edge.to)),
+  }
+}
