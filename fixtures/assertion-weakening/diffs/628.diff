index 00000000..8b26872d
--- /dev/null
+++ b/src/canvas/maskEditSlotPlan.ts
@@ -0,0 +1,123 @@
+import type { GenerationRatio, MivoImageQuality, MivoPlatformResolutionValue } from '../types/generation'
+
+/**
+ * 区域编辑占位符的排布计划(owner 2026-08-11 「更多参数」)。
+ *
+ * 取代 2026-07-05 的「一律 1:1 单占位」旧规。三件事:
+ *   ① 张数 → 占位个数(选 4 张就画 4 个框,不是画 1 个等 4 张挤进来)
+ *   ② 比例 → 占位框的形状(loading 期间就是目标形状,出图时不跳变)
+ *   ③ 画质 → 占位框的展示面积(4K 比 1K 大一圈,用户在画布上分得清哪批是高清)
+ *
+ * 纯函数、无副作用:输入参数与基准尺寸,输出占位数与单个占位的宽高。
+ * 调用方(maskEditGeneration)负责按这个计划真正建节点。
+ */
+
+/** 平台单批上限(NANO/GPT 双通道实测同为 4)。要更多得分批,不在本函数解决。 */
+const SLOT_COUNT_MAX = 4
+
+/**
+ * 画质档 → 占位面积缩放系数。
+ *
+ * 这不是真实像素比(1K→4K 的像素是 16 倍,照搬会让 4K 占位撑爆画布),而是**可分辨的
+ * 视觉分档**:相邻两档差 20% 左右,并排时一眼能看出高低,又不至于让高档挤走别的节点。
+ * resolution 与 quality 两套 key 并存,因为两个通道用的是不同参数(NANO 发 resolution、
+ * GPT 发 quality),这里按谁在场用谁,不做互相换算——换算本身就是错的(三档 quality
+ * 只能映射 1K/1K/2K,见 types/generation 的说明)。
+ */
+const TIER_SCALE: Record<string, number> = {
+  '1K': 1,
+  '2K': 1.2,
+  '4K': 1.45,
+  low: 1,
+  medium: 1.2,
+  high: 1.45,
+}
+
+/** 比例 id → 宽高比数值。GenerationRatio 全集,缺一个就会在下面回退到源图/方形。 */
+const RATIO_VALUE: Record<GenerationRatio, number> = {
+  '1:1': 1,
+  '3:2': 3 / 2,
+  '2:3': 2 / 3,
+  '16:9': 16 / 9,
+  '9:16': 9 / 16,
+  '4:3': 4 / 3,
+  '3:4': 3 / 4,
+  '21:9': 21 / 9,
+  '5:4': 5 / 4,
+  '4:5': 4 / 5,
+}
+
+export type MaskEditSlotPlanInput = {
+  /** 占位符基准尺寸(defaultSizeForNodeType('ai-slot')),缩放与比例都以它的面积为基准。 */
+  baseSize: { width: number; height: number }
+  count?: number
+  imgRatio?: GenerationRatio
+  /** 源图尺寸。imgRatio 缺席(=「保持原比例」)时占位跟它走。 */
+  sourceSize?: { width: number; height: number }
+  resolution?: MivoPlatformResolutionValue
+  quality?: MivoImageQuality
+}
+
+export type MaskEditSlotPlan = {
+  count: number
+  slotSize: { width: number; height: number }
+  /** 本次采用的画质缩放系数。产出它是为了让调用方把「为什么这个占位这么大」写进
+   *  Debug Log —— 占位尺寸是宽高比与画质档两个因素的乘积,只看结果尺寸排障时
+   *  分不清是哪一个造成的。 */
+  tierScale: number
+}
+
+/**
+ * 比例优先级:**显式 imgRatio > 源图比例 > 基准尺寸自身比例**。
+ *
+ * 中间那档是「保持原比例」的落点——用户没动比例时,占位框跟源图形状走而不是恒定方形。
+ * 这与提交链路的语义一致(那边也是「没选=按源图算」),两处必须同一口径,否则会出现
+ * 「占位是方的、出图是宽的」这种 loading 与结果对不上的跳变。
+ */
+const targetAspectFor = (input: MaskEditSlotPlanInput): number => {
+  if (input.imgRatio && RATIO_VALUE[input.imgRatio]) return RATIO_VALUE[input.imgRatio]
+  const source = input.sourceSize
+  if (source && source.width > 0 && source.height > 0) return source.width / source.height
+  return Math.max(1, input.baseSize.width) / Math.max(1, input.baseSize.height)
+}
+
+export const maskEditSlotPlanFor = (input: MaskEditSlotPlanInput): MaskEditSlotPlan => {
+  const rawCount = Number(input.count)
+  const count = Number.isFinite(rawCount) ? Math.min(SLOT_COUNT_MAX, Math.max(1, Math.trunc(rawCount))) : 1
+
+  // 画质缩放:resolution 在场用它,否则用 quality,都没有就是 1(旧行为)。
+  const tierKey = input.resolution ?? input.quality
+  const scale = (tierKey && TIER_SCALE[tierKey]) || 1
+
+  // 等面积换算:面积 = base 面积 × scale²,再按目标宽高比分配宽高。
+  // 用面积而不是直接缩宽度,是为了让不同比例的占位在画布上「份量」可比 ——
+  // 16:9 与 9:16 应该看起来一样大,只是躺着和立着的区别。
+  const aspect = targetAspectFor(input)
+  const baseArea = Math.max(1, input.baseSize.width * input.baseSize.height) * scale * scale
+  const width = Math.round(Math.sqrt(baseArea * aspect))
+  const height = Math.round(width / aspect)
+
+  return {
+    count,
+    slotSize: {
+      width: Math.max(1, width),
+      height: Math.max(1, height),
+    },
+    tierScale: scale,
+  }
+}
+
+/**
+ * 由结果图的实际尺寸反推分辨率档,供画布节点打角标。
+ *
+ * 判据用**长边像素**而不是面积:平台各档的实际输出不是严格的 1024/2048/4096 方形
+ * (改图会按比例给,如 2K 的 16:9 实出 2528×1696),长边最稳定。阈值取档位中值偏下,
+ * 让边界情况(比如 2K 的窄幅图)落进它该在的档而不是降一档。
+ */
+export const resolutionBadgeForSize = (size?: { width: number; height: number }): '2K' | '4K' | undefined => {
+  if (!size || size.width <= 0 || size.height <= 0) return undefined
+  const longEdge = Math.max(size.width, size.height)
+  if (longEdge >= 3600) return '4K'
+  if (longEdge >= 2000) return '2K'
+  return undefined
+}
diff --git a/src/canvas/regionEditParams.test.ts b/src/canvas/regionEditParams.test.ts
