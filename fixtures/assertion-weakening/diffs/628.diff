@@ -0,0 +1,186 @@
+// src/canvas/regionEditParams.ts
+// 区域编辑「更多参数」的取值模型:画质 / 比例 / 张数,按模型分档。
+//
+// 所有取值都来自 2026-08-11 对 Mivo 平台(aigc.xindong.com)的**实测**,不是文档推断
+// ——发真实任务、等出图、量首图像素得到的结论(多轮探测;具体任务数见平台后台记录,
+// 此处不承诺精确计数,F-G1):
+//
+//   NANO(gemini-3-pro-image)  resolution=1K → 1024²;4K → 4096²(实测);8K → 平台侧生成失败
+//                             ratio=21:9 → 1584x672;n=4 → 实回 3 张(平台不保证足量)
+//   GPT (gpt-image-2)         quality=high → 2880²;不带 quality → 2048²;low → 1024²
+//                             ratio=21:9 → 2352x1008;n=4 → 实回 4 张
+//
+// 合法域(比例/分辨率/张数)的**单一真相源**是 shared/regionEditCapabilities.ts:
+// BFF 校验与前端取值同表,避免「前端白名单 6 档、BFF 宽集合 10 档」的域漂移
+// (2026-08-12 R1 三审席② ADV-E1)。
+//
+// 两模型的画质**不是同一种参数**,刻意不统一文案:
+//   - NANO 走 `resolution`,是**精确尺寸承诺**(要 4K 给 4096²);
+//   - GPT  走 `quality`,是**质量意图**,像素由平台定(high 给 2880² 而非 4096²)。
+// 把 GPT 的 high 标成「4K」会虚标,Cindy 官方插件(xd-mivo)也是分开两套档位显示。
+//
+// 传输侧**不能**复用 quality 三档编码表达 NANO 的分辨率(2026-08-11 单测逮到):
+// 现有 BFF 换算表是 low→1K / medium→1K / high→2K,三档只映射出两种分辨率,且 high
+// 已被线上占用为 2K。若把 UI 的「4K」也编码成 high,用户选 4K 实际出 2K —— 同一个
+// 编码两处含义不同,是静默的功能欺骗。
+// 因此 NANO 侧新增独立字段 `resolution`(1K/2K/4K 原样直达平台),quality 字段仅
+// GPT 使用。两个字段互斥,由模型决定用哪个,BFF 侧据此组包。
+import type { GenerationRatio, MivoImageQuality, MivoPlatformResolutionValue } from '../types/generation'
+import { REGION_EDIT_CAPABILITIES } from '../../shared/regionEditCapabilities'
+import type { MaskEditModelId } from './imageMaskGeometry'
+
+/** NANO 专用:平台 `resolution` 档(8K 实测被平台判生成失败,不开放)。类型见 types/generation。 */
+export const regionEditResolutions = REGION_EDIT_CAPABILITIES['gemini-3-pro-image'].resolutions
+export type RegionEditResolution = MivoPlatformResolutionValue
+
+/** 比例的「保持原图」态:不发 imgRatio,输出尺寸跟随源图(区域编辑的历史默认行为)。 */
+export const REGION_EDIT_RATIO_SOURCE = 'source' as const
+export type RegionEditRatio = typeof REGION_EDIT_RATIO_SOURCE | GenerationRatio
+
+/** 张数:平台 n 字段。4 张实测 NANO 可能少回(见文件头),按实回数量落图。 */
+export const regionEditCounts = [1, 2, 4] as const
+export type RegionEditCount = (typeof regionEditCounts)[number]
+
+/**
+ * 画质在两个模型上是**两种不同的参数**,故用可辨识联合而不是一个 quality 字段:
+ *   NANO → { kind:'resolution', value:'1K'|'2K'|'4K' }  精确尺寸承诺,直达平台 resolution
+ *   GPT  → { kind:'quality',    value:'low'|'medium'|'high' }  质量意图,像素由平台定
+ * 这样「用户选的档」与「线上发出去的值」永远一一对应,不存在换算歧义。
+ */
+export type RegionEditQuality =
+  | { kind: 'resolution'; value: RegionEditResolution }
+  | { kind: 'quality'; value: MivoImageQuality }
+
+export type RegionEditParams = {
+  quality: RegionEditQuality
+  ratio: RegionEditRatio
+  count: RegionEditCount
+}
+
+/** 画质档在 UI 上的显示名(按模型分)。 */
+export type QualityOption = { value: RegionEditQuality; label: string; slow?: boolean }
+
+const nanoQuality = (value: RegionEditResolution): RegionEditQuality => ({ kind: 'resolution', value })
+const gptQuality = (value: MivoImageQuality): RegionEditQuality => ({ kind: 'quality', value })
+
+const NANO_QUALITIES: QualityOption[] = [
+  { value: nanoQuality('1K'), label: '1K' },
+  { value: nanoQuality('2K'), label: '2K' },
+  // 4K 实测 4096²,轮询明显更久 → 打慢标,BFF 侧另配更长超时。
+  { value: nanoQuality('4K'), label: '4K', slow: true },
+]
+
+const GPT_QUALITIES: QualityOption[] = [
+  { value: gptQuality('low'), label: '低' },
+  { value: gptQuality('medium'), label: '中' },
+  { value: gptQuality('high'), label: '高' },
+]
+
+// 比例域取 shared/regionEditCapabilities 的每模型 exact 表(BFF 校验同表,防漂移)。
+// NANO 平台侧 9 档 + 实测可用的 21:9 = 10 档;GPT 平台侧 5 档 + 21:9 = 6 档。
+const NANO_RATIOS = REGION_EDIT_CAPABILITIES['gemini-3-pro-image'].ratios as readonly GenerationRatio[]
+const GPT_RATIOS = REGION_EDIT_CAPABILITIES['gpt-image-2'].ratios as readonly GenerationRatio[]
+
+export const regionEditQualityOptions = (model: MaskEditModelId): QualityOption[] =>
+  model === 'gpt-image-2' ? GPT_QUALITIES : NANO_QUALITIES
+
+export const regionEditRatioOptions = (model: MaskEditModelId): readonly GenerationRatio[] =>
+  model === 'gpt-image-2' ? GPT_RATIOS : NANO_RATIOS
+
+/**
+ * 默认参数 = **今天的线上行为**,一个都不动时出图与改造前同形态:
+ *   NANO 今天发 quality='high',经 BFF 换算表 high→'2K' ⇒ 默认档 = 2K(**不是 4K**);
+ *   GPT  今天发 quality='medium' ⇒ 默认档 = 中。
+ * 比例保持原图、单张,都是改造前根本不存在的参数,默认即「不发」。
+ * 这条契约是「默认状态就是目前状态」的落点,改动它等于悄悄改变存量用户的出图结果
+ * (单测 regionEditParams.test.ts 对着 maskEditQualityFor 与换算表锁死)。
+ */
+export const regionEditDefaultParams = (model: MaskEditModelId): RegionEditParams => ({
+  quality: model === 'gpt-image-2' ? gptQuality('medium') : nanoQuality('2K'),
+  ratio: REGION_EDIT_RATIO_SOURCE,
+  count: 1,
+})
+
+/**
+ * 切换模型时把参数收敛到新模型的合法域:画质三档两模型都全,恒合法;比例可能越界
+ * (NANO 独有的 4:3/3:4/4:5/5:4 在 GPT 不存在)→ 回落「保持原图」而不是静默换一个
+ * 用户没选过的比例;张数与模型无关。
+ */
+export const clampRegionEditParams = (params: RegionEditParams, model: MaskEditModelId): RegionEditParams => {
+  const ratioOk =
+    params.ratio === REGION_EDIT_RATIO_SOURCE || regionEditRatioOptions(model).includes(params.ratio)
+  const ratio = ratioOk ? params.ratio : REGION_EDIT_RATIO_SOURCE
+  // 画质是分模型的两套参数(resolution vs quality):换了模型,旧档 kind 必然不匹配
+  // 新模型 → 回落该模型的默认档(NANO=2K / GPT=中),即「维持现状」那一档。
+  const kindOk = params.quality.kind === (model === 'gpt-image-2' ? 'quality' : 'resolution')
+  const quality = kindOk ? params.quality : regionEditDefaultParams(model).quality
+  // 无需收敛时**返回原对象**:调用方(useRegionEditParams 的模型切换 effect)靠引用
+  // 相等判断「这次要不要写状态 + 记 warn」,恒返回新对象会让它每次模型变更都误报。
+  if (ratioOk && kindOk) return params
+  return { ...params, ratio, quality }
+}
+
+/** 比例 id → 宽高比数值。用于「保持原比例」时从源图尺寸挑最近档。 */
+const RATIO_VALUE: Record<GenerationRatio, number> = {
+  '1:1': 1,
+  '3:2': 3 / 2,
+  '2:3': 2 / 3,
+  '16:9': 16 / 9,
+  '9:16': 9 / 16,
+  '4:3': 4 / 3,
+  '3:4': 3 / 4,
+  '21:9': 21 / 9,
+  '5:4': 5 / 4,
+  '4:5': 4 / 5,
+}
+
+/**
+ * 「保持原比例」的落地实现:从源图尺寸挑该模型可用档里最接近的一个。
+ *
+ * **不发 imgRatio 不等于跟随源图** —— 2026-08-11 实测:不带比例参数时平台一律出 1:1
+ * 正方形。所以「保持原比例」必须由前端算出具体档位发出去(R1 三审席③ UP-1 / 席② ADV-A1)。
+ *
+ * 距离用**对数**而非线性差:log 尺度下「放大 1.2 倍」与「缩小 1.2 倍」等距,挑出来的档
+ * 在视觉上才是真的最近。线性差会系统性偏向宽比例(16:9 与 1:1 的线性差 0.78,而 1:1 与
+ * 9:16 只差 0.44,同样是「差一档」却权重不同)。口径与 useMaskPointArmed 的同名实现一致
+ * (那份是 chat 生图路径的,档位集更窄;两处将来值得合并成单一真相源,不在本 PR 范围)。
+ *
+ * 档位集取**该模型的合法域**:NANO 10 档能挑到 4:3/5:4 这类接近方形的档,GPT 只有 6 档,
+ * 1264×848(1.49)在两个模型上分别落到 3:2(1.5)与 3:2 —— 恰好同档,但 4:3 源图在 NANO
+ * 会精确命中 4:3,在 GPT 只能落 3:2,这是模型能力差异不是 bug。
+ */
+export const closestRegionEditRatio = (
+  size: { width: number; height: number },
+  model: MaskEditModelId,
+): GenerationRatio => {
+  const options = regionEditRatioOptions(model)
+  const ratio = Math.max(1, size.width) / Math.max(1, size.height)
+  return options.reduce((best, candidate) =>
+    Math.abs(Math.log(ratio / RATIO_VALUE[candidate])) < Math.abs(Math.log(ratio / RATIO_VALUE[best]))
+      ? candidate
+      : best,
+  )
+}
+
+/**
+ * 提交时的实际比例:显式选了就用选的,「保持原比例」则从源图算最近档。
+ * 返回值恒为具体档位 —— 提交链路**永远发 imgRatio**,不再有「不发」这个分支。
+ */
+export const resolveRegionEditRatio = (
+  params: RegionEditParams,
+  model: MaskEditModelId,
+  sourceSize: { width: number; height: number },
+): GenerationRatio =>
+  params.ratio === REGION_EDIT_RATIO_SOURCE ? closestRegionEditRatio(sourceSize, model) : params.ratio
+
+const sameQuality = (a: RegionEditQuality, b: RegionEditQuality): boolean =>
+  a.kind === b.kind && a.value === b.value
+
+/** 触发按钮上的摘要文案:「保持原比例 · 2K · 1张」。 */
+export const regionEditParamsSummary = (params: RegionEditParams, model: MaskEditModelId): string => {
+  const quality = regionEditQualityOptions(model).find((q) => sameQuality(q.value, params.quality))
+  const ratio = params.ratio === REGION_EDIT_RATIO_SOURCE ? '保持原比例' : params.ratio
+  return [ratio, quality?.label ?? params.quality.value, `${params.count}张`].join(' · ')
+}
+
+export { sameQuality as isSameRegionEditQuality }
