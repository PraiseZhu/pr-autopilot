+    expect(nodes.find((n) => n.id === s2)?.type).toBe('image')
+    expect(nodes.find((n) => n.id === s3)?.type).toBe('image')
+    // 未消费的第 4 个 slot 必须消失 —— 否则永久 loading
+    expect(nodes.find((n) => n.id === s4)).toBeUndefined()
+    expect(aiSlotsIn()).toHaveLength(0)
+    expect(resultNodesIn()).toHaveLength(3)
+  })
+
+  it('边界:用户已删除某个额外 slot → 结果照常落位,不误删其余在场 slot,不抛错', async () => {
+    seedScene()
+    const s1 = addSlot(1)
+    const s2 = addSlot(2)
+    const s3 = addSlot(3)
+    const s4 = addSlot(4)
+    // 用户删掉了第 4 个 slot(生成完成前手动清理占位)
+    useCanvasStore.setState((state) => ({
+      canvases: { ...state.canvases, 'scene-a': { ...state.canvases['scene-a'], nodes: state.canvases['scene-a'].nodes.filter((n) => n.id !== s4) } },
+    }))
+
+    const created = await commitWith([s1, s2, s3, s4], 3)
+    expect(created).toHaveLength(3)
+
+    const nodes = useCanvasStore.getState().canvases['scene-a'].nodes
+    expect(nodes.find((n) => n.id === s1)?.type).toBe('image')
+    expect(nodes.find((n) => n.id === s2)?.type).toBe('image')
+    expect(nodes.find((n) => n.id === s3)?.type).toBe('image')
+    // 已删的 s4 不在场内,清理逻辑不得报错、也不得重建
+    expect(nodes.find((n) => n.id === s4)).toBeUndefined()
+    expect(aiSlotsIn()).toHaveLength(0)
+  })
+
+  it('结果数 == slot 数 → 全部消费,无 stale 清理(既有行为不变)', async () => {
+    seedScene()
+    const s1 = addSlot(1)
+    const s2 = addSlot(2)
+    const s3 = addSlot(3)
+    const s4 = addSlot(4)
+
+    const created = await commitWith([s1, s2, s3, s4], 4)
+    expect(created).toHaveLength(4)
+    const nodes = useCanvasStore.getState().canvases['scene-a'].nodes
+    expect(nodes.find((n) => n.id === s1)?.type).toBe('image')
+    expect(nodes.find((n) => n.id === s2)?.type).toBe('image')
+    expect(nodes.find((n) => n.id === s3)?.type).toBe('image')
+    expect(nodes.find((n) => n.id === s4)?.type).toBe('image')
+    expect(aiSlotsIn()).toHaveLength(0)
+  })
+
+  it('被清理 slot 的相连 edges 同步移除,不留悬挂引用', async () => {
+    seedScene()
+    const s1 = addSlot(1)
+    const s2 = addSlot(2)
+    const s3 = addSlot(3)
+    const s4 = addSlot(4)
+    // 给将未被消费的 s4 造一条 derivation edge(指向 s4),提交后必须被清掉
+    useCanvasStore.setState((state) => ({
+      canvases: {
+        ...state.canvases,
+        'scene-a': {
+          ...state.canvases['scene-a'],
+          edges: [...(state.canvases['scene-a'].edges || []), { id: 'e-to-s4', from: 'n1', to: s4, type: 'edit', prompt: 'x', createdAt: Date.now() }],
+        },
+      },
+    }))
+
+    const created = await commitWith([s1, s2, s3, s4], 3)
+    expect(created).toHaveLength(3)
+    const edges = useCanvasStore.getState().canvases['scene-a'].edges || []
+    expect(edges.find((e) => e.id === 'e-to-s4')).toBeUndefined()
+    // 指向被消费 slot 的 derivation edge 保留
+    expect(edges.some((e) => e.to === s1 && e.from === 'n1')).toBe(true)
+  })
+})
