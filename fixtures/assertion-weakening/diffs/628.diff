@@ -0,0 +1,175 @@
+import { describe, expect, it } from 'vitest'
+import { maskEditQualityFor } from './imageMaskGeometry'
+import {
+  REGION_EDIT_RATIO_SOURCE,
+  clampRegionEditParams,
+  closestRegionEditRatio,
+  regionEditDefaultParams,
+  regionEditParamsSummary,
+  regionEditQualityOptions,
+  regionEditRatioOptions,
+  resolveRegionEditRatio,
+} from './regionEditParams'
+
+describe('regionEditParams — 默认值必须等于改造前的线上行为', () => {
+  // 这两条是本次改动的核心安全网:面板加了参数入口后,用户「一个都不动」时
+  // 出图必须和加参数之前逐字节同形态。默认值一旦漂移 = 悄悄改变存量行为。
+  // NANO 今天发 quality='high',BFF 换算表 high→'2K' ⇒ 默认分辨率档必须是 2K。
+  // 这条曾在初版实现里写错(把 4K 也编码成 high,用户选 4K 实出 2K),由本测试逮到。
+  it('NANO 默认档 = 2K,且与线上 high→2K 的换算结果一致', () => {
+    const model = 'gemini-3-pro-image' as const
+    expect(maskEditQualityFor(model)).toBe('high') // 线上现值
+    expect(regionEditDefaultParams(model).quality).toEqual({ kind: 'resolution', value: '2K' })
+  })
+
+  it('GPT 默认档 = 中,与线上 medium 一致', () => {
+    const model = 'gpt-image-2' as const
+    expect(maskEditQualityFor(model)).toBe('medium') // 线上现值
+    expect(regionEditDefaultParams(model).quality).toEqual({ kind: 'quality', value: 'medium' })
+  })
+
+  it('NANO 的档位是 resolution 而非 quality —— 两者不可复用同一编码', () => {
+    // 防回归:三档 quality 只能映射出 1K/1K/2K 两种分辨率,表达不了 4K。
+    const opts = regionEditQualityOptions('gemini-3-pro-image')
+    expect(opts.every((o) => o.value.kind === 'resolution')).toBe(true)
+    expect(opts.map((o) => o.value.value)).toEqual(['1K', '2K', '4K'])
+    expect(regionEditQualityOptions('gpt-image-2').every((o) => o.value.kind === 'quality')).toBe(true)
+  })
+
+  it('两模型默认都是「保持原比例 + 单张」(改造前没有这两个参数)', () => {
+    for (const model of ['gemini-3-pro-image', 'gpt-image-2'] as const) {
+      const d = regionEditDefaultParams(model)
+      expect(d.ratio).toBe(REGION_EDIT_RATIO_SOURCE)
+      expect(d.count).toBe(1)
+    }
+  })
+})
+
+describe('regionEditParams — 分模型档位(实测值)', () => {
+  it('NANO 画质显示 1K/2K/4K,4K 打慢标', () => {
+    const opts = regionEditQualityOptions('gemini-3-pro-image')
+    expect(opts.map((o) => o.label)).toEqual(['1K', '2K', '4K'])
+    expect(opts.find((o) => o.label === '4K')?.slow).toBe(true)
+  })
+
+  it('GPT 画质显示 低/中/高,不打慢标(平台自定像素,high=2880² 非 4K)', () => {
+    const opts = regionEditQualityOptions('gpt-image-2')
+    expect(opts.map((o) => o.label)).toEqual(['低', '中', '高'])
+    expect(opts.some((o) => o.slow)).toBe(false)
+  })
+
+  it('两模型比例档数不同,但都含实测可用的 21:9', () => {
+    expect(regionEditRatioOptions('gemini-3-pro-image')).toHaveLength(10)
+    expect(regionEditRatioOptions('gpt-image-2')).toHaveLength(6)
+    expect(regionEditRatioOptions('gemini-3-pro-image')).toContain('21:9')
+    expect(regionEditRatioOptions('gpt-image-2')).toContain('21:9')
+  })
+
+  it('GPT 不支持 NANO 独有的 4:3 / 5:4 等档', () => {
+    const gpt = regionEditRatioOptions('gpt-image-2')
+    for (const r of ['4:3', '3:4', '4:5', '5:4'] as const) expect(gpt).not.toContain(r)
+  })
+})
+
+describe('clampRegionEditParams — 切模型时收敛非法比例', () => {
+  it('NANO 独有比例切到 GPT → 回落保持原比例(不静默换成用户没选过的比例)', () => {
+    const params = { quality: { kind: 'resolution', value: '4K' }, ratio: '4:3', count: 2 } as const
+    const next = clampRegionEditParams(params, 'gpt-image-2')
+    expect(next.ratio).toBe(REGION_EDIT_RATIO_SOURCE)
+    // 画质换算到 GPT 的默认档(resolution 档在 GPT 不存在),张数不受影响
+    expect(next.quality).toEqual({ kind: 'quality', value: 'medium' })
+    expect(next.count).toBe(2)
+  })
+
+  it('两模型共有的比例切模型后保留', () => {
+    const params = { quality: { kind: 'quality', value: 'low' }, ratio: '16:9', count: 1 } as const
+    expect(clampRegionEditParams(params, 'gpt-image-2').ratio).toBe('16:9')
+    expect(clampRegionEditParams(params, 'gemini-3-pro-image').ratio).toBe('16:9')
+  })
+
+  it('保持原比例态在任何模型下都合法', () => {
+    const params = { quality: { kind: 'quality', value: 'medium' }, ratio: REGION_EDIT_RATIO_SOURCE, count: 4 } as const
+    expect(clampRegionEditParams(params, 'gpt-image-2')).toEqual(params)
+  })
+})
+
+describe('regionEditParamsSummary — 触发按钮摘要', () => {
+  it('默认态显示「保持原比例 · 2K · 1张」(NANO)', () => {
+    const model = 'gemini-3-pro-image' as const
+    expect(regionEditParamsSummary(regionEditDefaultParams(model), model)).toBe('保持原比例 · 2K · 1张')
+  })
+
+  it('GPT 默认态显示「保持原比例 · 中 · 1张」', () => {
+    const model = 'gpt-image-2' as const
+    expect(regionEditParamsSummary(regionEditDefaultParams(model), model)).toBe('保持原比例 · 中 · 1张')
+  })
+
+  it('选了具体比例与多张时如实显示', () => {
