+          <MivoCanvas key={sceneId} onOpenDetails={handleOpenDetails} />
         </div>
       </div>
+      {lightboxTarget ? (
+        <DetailsTargetGuard
+          targetSceneId={lightboxTarget.sceneId}
+          targetNodeId={lightboxTarget.nodeId}
+          watchNodeExists={false}
+          onAutoClose={handleLightboxAutoClose}
+        />
+      ) : null}
+      {lightboxTarget && lightboxTarget.sceneId === sceneId ? (
+        <MediaLightbox nodeId={lightboxTarget.nodeId} onClose={() => setLightboxTarget(undefined)} />
+      ) : null}
       <ToastViewport />
     </main>
   )
