+import { useCallback, useState } from 'react'
 import { MivoCanvas } from '../../src/canvas/MivoCanvas'
 import { ToastViewport } from '../../src/app/ToastViewport'
+import { MediaLightbox } from '../../src/app/MediaLightbox'
+import { DetailsTargetGuard } from '../../src/app/DetailsTargetGuard'
+import { isMediaRenderKind, renderKindForNode } from '../../src/model/canvasNodeRegistry'
+import { debugLogger } from '../../src/store/debugLogStore'
 import { useCanvasStore } from '../../src/store/canvasStore'
 import { usePluginHydration } from './usePluginHydration'
 
@@ -14,10 +19,30 @@ import { usePluginHydration } from './usePluginHydration'
  * 布局类沿用 App.css:mivo-app + project-collapsed + ai-collapsed 正好是
  * "无侧栏、无 AI 面板、画布全铺"的形态;workspace/work-surface 是画布
  * 尺寸计算依赖的容器层级。
+ *
+ * 详情入口只接图片/视频的 MediaLightbox;其余类型在插件里没有
+ * InspectorPanel,双击时记 warn 跳过(主站才有完整详情弹窗)。
  */
 export function PluginApp() {
   const hydrated = usePluginHydration()
   const sceneId = useCanvasStore((state) => state.sceneId)
+  // 打开时刻锁定目标(场景 + 节点),不跟随后续选区变化漂移。
+  // 越界关闭(agent 切场景等)由 DetailsTargetGuard 观察并回调清空。
+  const [lightboxTarget, setLightboxTarget] = useState<{ sceneId: string; nodeId: string }>()
+  const handleLightboxAutoClose = useCallback(() => setLightboxTarget(undefined), [])
+
+  const handleOpenDetails = useCallback(() => {
+    // onOpenDetails 在 selectNode 之后触发,此刻 store 里的 selectedNodeId 即目标节点。
+    const state = useCanvasStore.getState()
+    const node = state.nodes.find((item) => item.id === state.selectedNodeId)
+
+    if (node && isMediaRenderKind(renderKindForNode(node))) {
+      setLightboxTarget({ sceneId: state.sceneId, nodeId: node.id })
+      return
+    }
+
+    debugLogger.warn('Lightbox', `Details skipped in plugin for node type: ${node?.type ?? 'unknown'}`)
+  }, [])
 
   if (!hydrated) {
     return <div className="canvas-boot-placeholder" aria-busy="true" data-hydrated="false" />
@@ -27,9 +52,20 @@ export function PluginApp() {
     <main className="mivo-app project-collapsed ai-collapsed">
       <div className="workspace">
