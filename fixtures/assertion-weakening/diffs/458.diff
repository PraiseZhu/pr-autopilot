 }
 
-/** 测试用:清空 single-flight 表。 */
+export type ReleaseResult = {
+  ok: boolean
+  /** `released:false` = 该指纹本就无引用,不是错误(设计稿 §4.10.1)。 */
+  released?: boolean
+  quotaUsedBytes?: number
+  quotaLimitBytes?: number
+  message?: string
+}
+
+// release 的 single-flight 键是 **hash**,与上面 deposit 的 assetUrl 键是两张独立
+// 的表(职责闭合选 A 案 [J4-③]:release 归本段,不与 T1b 的 pendingReleases 队列
+// 合并)。同一 hash 的并发释放请求只应产生一次 release_media 调用(设计稿
+// §4.10.6 顺序硬约束「同一 hash 的并发 release 走 single-flight 合并」)——三个
+// 接线点(LRU 淘汰前 / 换指纹 / sweep)在 T1e 接线时可能对同一 hash 并发触发,
+// 这里统一收口,调用方不需要各自实现合并。
+const releaseInflight = new Map<string, Promise<ReleaseResult>>()
+
+/**
+ * 释放一个寄存物指纹(设计稿 §4.10.1)。**不做重试**——失败原样如实返回,由调用方
+ * (T1b2 sweep / T1b3 补偿 / T1e 三接线点)决定要不要记入 `pendingReleases` 待重试
+ * 队列;本函数只负责"发一次 + 合并并发"这个原语职责。
+ */
+export const releaseHash = async (hash: string): Promise<ReleaseResult> => {
+  if (!HASH_RE.test(hash)) {
+    return { ok: false, message: '缺少合法的释放目标 hash' }
+  }
+  const existing = releaseInflight.get(hash)
+  if (existing) {
+    debugLogger.log(SOURCE, `release 合并并发请求:hash=${hash.slice(0, 8)} 已有释放在途(single-flight)`)
+    return existing
+  }
+  const pending = (async (): Promise<ReleaseResult> => {
+    const reply = await transport('release-media', { hash }, { retryMs: DEPOSIT_RETRY_MS, timeoutMs: DEPOSIT_TIMEOUT_MS })
+    if (!reply.ok) {
+      debugLogger.error(SOURCE, `release 失败:hash=${hash.slice(0, 8)} ${reply.message || '无原因'}`)
+      return { ok: false, message: reply.message }
+    }
+    debugLogger.log(
+      SOURCE,
+      `release 完成:hash=${hash.slice(0, 8)} released=${reply.released ? 'yes' : 'no(no-op)'}`,
+    )
+    return { ok: true, released: reply.released, quotaUsedBytes: reply.quotaUsedBytes, quotaLimitBytes: reply.quotaLimitBytes }
+  })()
+  releaseInflight.set(hash, pending)
+  try {
+    return await pending
+  } finally {
+    releaseInflight.delete(hash)
+  }
+}
+
+/** 测试用:清空 single-flight 表(deposit 与 release 两张)。 */
 export const resetDepositPortForTests = (): void => {
   inflight.clear()
+  releaseInflight.clear()
 }
