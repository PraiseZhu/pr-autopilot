+ * 由 depositPort.ts 的 releaseHash 判「ok:true 即成功」。
+ */
+function handleReleaseMedia(msg) {
+  if (completed.has(msg.reqId)) {
+    diagSkip(DIAG_SOURCE.release, 'release 请求重放: 已完成, 回放缓存回执(后续重发不再逐条记)', msg.reqId)
