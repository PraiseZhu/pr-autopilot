@@ -0,0 +1,185 @@
+/**
+ * release_media 电子脑侧契约测试(T1a 基建;设计稿 §4.10.1)。
+ *
+ * 覆盖:
+ *  - release_media 请求形状(kind/hash)、成功回执(released:true/false 均视为成功)、
+ *    结构化配额两数透传;
+ *  - hash 前置校验(缺失/不合法格式)→ 零 cindy.send;
+ *  - reqId 重放去重与在途忽略(同 deposit_media 语义,重发绝不变成重复释放);
+ *  - 宿主 ok:false → 透传 message,不带 code(宿主不为 release_media 提供稳定码,
+ *    与 deposit_media 同一条纪律,设计稿 §4.1/§11-③)。
+ *
+ * 断言跑在真实 cindyplugin/main.js 源码上,复用 #298 X0 的 brainHarness,不自建
+ * 一套替身协议(避免「替身与真源码漂移」)。
+ */
+import { describe, expect, it } from 'vitest'
+import { flushMicrotasks, loadBrain } from './brainHarness'
+import type { LoadBrainOptions, LoadedBrain } from './brainHarness'
+
+type HostReleaseReply = {
+  ok: boolean
+  released?: boolean
+  message?: string
+  quotaUsedBytes?: number
+  quotaLimitBytes?: number
+}
+
+const HASH = 'a'.repeat(32)
+
+/** 起一个电子脑,记下 release_media 宿主请求与经 persist channel 回给面板的回执。 */
+const releaseBrain = (
+  options: { reply?: (payload: unknown) => HostReleaseReply } & Omit<LoadBrainOptions, 'send'> = {},
+) => {
+  const hostRequests: Array<Record<string, unknown>> = []
+  const brain: LoadedBrain = loadBrain({
+    ...options,
+    panelPresent: () => false,
+    send: (payload) => {
+      const message = payload as Record<string, unknown>
+      if (message.kind === 'release_media') hostRequests.push(message)
+      return options.reply ? options.reply(payload) : { ok: true, released: true }
+    },
+  })
+  const replies: Array<Record<string, unknown>> = []
+  const panel = brain.bus.open('mivo-canvas-persist')
+  panel.onmessage = (event) => {
+    const data = event.data as Record<string, unknown>
+    if (data && data.reply) replies.push(data)
+  }
+  return { brain, hostRequests, replies, panel }
+}
+
+describe('release_media — 请求形状与成功回执', () => {
+  it('按宿主契约发 cindy-request(入参只有 hash),回执带 released', async () => {
+    const { brain, hostRequests, replies } = releaseBrain({
+      reply: () => ({ ok: true, released: true, quotaUsedBytes: 512, quotaLimitBytes: 1_073_741_824 }),
+    })
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: HASH })
+    await flushMicrotasks()
+
+    expect(hostRequests).toHaveLength(1)
+    expect(hostRequests[0]).toEqual({ type: 'cindy-request', kind: 'release_media', hash: HASH })
+    expect(replies).toHaveLength(1)
+    expect(replies[0]).toMatchObject({
+      reqId: 'r1',
+      ok: true,
+      released: true,
+      quotaUsedBytes: 512,
+      quotaLimitBytes: 1_073_741_824,
+    })
+  })
+
+  it('released:false 视为成功,不报错不重试(设计稿 §4.10.1:该指纹本就无引用)', async () => {
+    const { brain, hostRequests, replies } = releaseBrain({ reply: () => ({ ok: true, released: false }) })
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: HASH })
+    await flushMicrotasks()
+
+    expect(hostRequests).toHaveLength(1)
+    expect(replies[0]).toMatchObject({ reqId: 'r1', ok: true, released: false })
+  })
+})
+
+describe('release_media — hash 前置校验(零 cindy.send)', () => {
+  it('缺 hash → 前置拦截,不发请求,不带 code', async () => {
+    const { brain, hostRequests, replies } = releaseBrain()
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media' })
+    await flushMicrotasks()
+
+    expect(hostRequests).toHaveLength(0)
+    expect(replies[0]).toMatchObject({ reqId: 'r1', ok: false })
+    expect(replies[0].code).toBeUndefined()
+  })
+
+  it('hash 格式不合法(过短/非 hex)→ 前置拦截,不发请求', async () => {
+    const { brain, hostRequests, replies } = releaseBrain()
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: 'short' })
+    await flushMicrotasks()
+
+    expect(hostRequests).toHaveLength(0)
+    expect(replies[0]).toMatchObject({ reqId: 'r1', ok: false })
+  })
+})
+
+describe('release_media — 重发去重(重发绝不变成重复释放)', () => {
+  it('同 reqId 重放回放缓存回执,不再打宿主', async () => {
+    const { brain, hostRequests, replies } = releaseBrain()
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: HASH })
+    await flushMicrotasks()
+    expect(hostRequests).toHaveLength(1)
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: HASH })
+    await flushMicrotasks()
+
+    expect(hostRequests).toHaveLength(1) // 关键:没有第二次释放
+    expect(replies).toHaveLength(2)
+    expect(replies[1]).toMatchObject({ reqId: 'r1', ok: true, released: true })
+  })
+
+  it('在途重发被忽略:只释放一次、只回一次', async () => {
+    const gate: { release?: (reply: HostReleaseReply) => void } = {}
+    const { brain, hostRequests, replies } = releaseBrain({
+      reply: () =>
+        new Promise<HostReleaseReply>((resolve) => {
+          gate.release = resolve
+        }) as unknown as HostReleaseReply,
+    })
+
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: HASH })
+    await flushMicrotasks()
+    brain.handles.release.media({ reqId: 'r1', kind: 'release-media', hash: HASH })
+    await flushMicrotasks()
+
+    expect(hostRequests).toHaveLength(1)
+    expect(brain.handles.release.inflightCount()).toBe(1)
+    expect(replies).toHaveLength(0)
+
+    gate.release?.({ ok: true, released: true })
+    await flushMicrotasks()
+    expect(replies).toHaveLength(1)
+    expect(brain.handles.release.inflightCount()).toBe(0)
+  })
+})
+
+describe('release_media — 失败矩阵', () => {
+  it('宿主 ok:false → 透传 message,不带 code,不带 released', async () => {
