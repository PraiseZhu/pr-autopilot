+/**
+ * depositPort releaseHash 契约测试(T1a 基建;设计稿 §4.10.1/§4.10.5)。
+ *
+ * 覆盖:成功释放、released:false 视为成功、hash 前置校验(不合法格式零请求)、
+ * 同一 hash 并发 single-flight 合并为一次请求、失败如实返回不重试、失败后
+ * in-flight 表清空可重试。
+ *
+ * 端到端跑在真实 main.js 上(depositTestHarness 的双 spy 之二:hostReleaseRequests),
+ * 不是对着替身自说自话。
+ */
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { releaseHash } from '../agent/depositPort'
+import { createDepositHarness, teardownDepositHarness, FAKE_HASH, type DepositHarness } from './depositTestHarness'
+
+let harness: DepositHarness
+
+beforeEach(() => {
+  harness = createDepositHarness()
+})
+
+afterEach(() => {
+  teardownDepositHarness()
+})
+
+describe('releaseHash — 成功路径', () => {
+  it('成功释放 → ok:true,released 与配额两数原样透传', async () => {
+    harness.setHostReleaseReply(() => ({ ok: true, released: true, quotaUsedBytes: 100, quotaLimitBytes: 1_000 }))
+
+    await expect(releaseHash(FAKE_HASH)).resolves.toEqual({
+      ok: true,
+      released: true,
+      quotaUsedBytes: 100,
+      quotaLimitBytes: 1_000,
+    })
+    expect(harness.hostReleaseRequests).toHaveLength(1)
+    expect(harness.hostReleaseRequests[0]).toMatchObject({ hash: FAKE_HASH })
+  })
+
+  it('released:false 视为成功,不报错(设计稿 §4.10.1:该指纹本就无引用)', async () => {
+    harness.setHostReleaseReply(() => ({ ok: true, released: false }))
+
+    await expect(releaseHash(FAKE_HASH)).resolves.toMatchObject({ ok: true, released: false })
+  })
+})
+
+describe('releaseHash — hash 前置校验(零请求)', () => {
+  it('不合法 hash(过短)→ 前置拦截,ok:false,不发请求', async () => {
+    await expect(releaseHash('short')).resolves.toMatchObject({ ok: false })
+    expect(harness.hostReleaseRequests).toHaveLength(0)
+  })
+
+  it('空字符串 → 前置拦截,不发请求', async () => {
+    await expect(releaseHash('')).resolves.toMatchObject({ ok: false })
+    expect(harness.hostReleaseRequests).toHaveLength(0)
+  })
+})
+
+describe('releaseHash — single-flight(hash 级,与 deposit 的 assetUrl 级各自独立)', () => {
+  it('同一 hash 并发 3 次只发 1 次释放请求,三个调用拿同一结果', async () => {
+    const results = await Promise.all([releaseHash(FAKE_HASH), releaseHash(FAKE_HASH), releaseHash(FAKE_HASH)])
+
+    expect(harness.hostReleaseRequests).toHaveLength(1)
+    expect(results.every((result) => result.ok)).toBe(true)
+  })
+
+  it('不同 hash 并发各自发请求,互不合并', async () => {
+    const hashB = 'c'.repeat(32)
+    await Promise.all([releaseHash(FAKE_HASH), releaseHash(hashB)])
+
+    expect(harness.hostReleaseRequests).toHaveLength(2)
+    expect(harness.hostReleaseRequests.map((request) => request.hash).sort()).toEqual([FAKE_HASH, hashB].sort())
+  })
+
+  it('失败后 in-flight 表清空,下次可重试(不是永久合并)', async () => {
+    harness.setHostReleaseReply(() => ({ ok: false, message: 'boom' }))
+    await expect(releaseHash(FAKE_HASH)).resolves.toMatchObject({ ok: false, message: 'boom' })
+
+    harness.setHostReleaseReply(() => ({ ok: true, released: true }))
+    await expect(releaseHash(FAKE_HASH)).resolves.toMatchObject({ ok: true, released: true })
+    expect(harness.hostReleaseRequests).toHaveLength(2)
+  })
+})
+
+describe('releaseHash — 不做重试(职责闭合选 A 案:重试是上层调用方的事)', () => {
+  it('单次失败即返回,不内部重试', async () => {
+    harness.setHostReleaseReply(() => ({ ok: false, message: '宿主拒绝' }))
+
+    await expect(releaseHash(FAKE_HASH)).resolves.toEqual({ ok: false, message: '宿主拒绝' })
+    expect(harness.hostReleaseRequests).toHaveLength(1)
+  })
+})
