+    return
+  }
+  if (releaseInflight.has(msg.reqId)) {
+    diagSkip(DIAG_SOURCE.release, 'release 请求重发: 仍在途, 已忽略(后续重发不再逐条记)', msg.reqId)
+    return
+  }
+  releaseInflight.add(msg.reqId)
+  void (async () => {
+    let reply
+    try {
+      const hash = typeof msg.hash === 'string' ? msg.hash : ''
+      if (!MEDIA_HASH_RE.test(hash)) {
+        reply = { reqId: msg.reqId, reply: true, ok: false, message: '缺少合法的释放目标 hash' }
+        diagSkip(DIAG_SOURCE.release, 'release 前置拦截: hash 不合法, 未发请求')
+      } else {
+        const r = await hostSend({ type: 'cindy-request', kind: 'release_media', hash })
+        if (r && r.ok) {
+          reply = {
+            reqId: msg.reqId, reply: true, ok: true,
+            released: Boolean(r.released),
+            quotaUsedBytes: Number.isFinite(r.quotaUsedBytes) ? r.quotaUsedBytes : undefined,
+            quotaLimitBytes: Number.isFinite(r.quotaLimitBytes) ? r.quotaLimitBytes : undefined,
+          }
+          diagOk(DIAG_SOURCE.release, 'release 完成: hash=' + diagHash8(hash) + ' released=' + (reply.released ? 'yes' : 'no(no-op)'))
+        } else {
+          // 宿主不给稳定 errorCode(同 deposit_media,设计稿 §4.1/§11-③ 已解):失败分类
+          // 只能靠 message 文本,不透传 r.code(从来是 undefined)。
+          reply = { reqId: msg.reqId, reply: true, ok: false, message: (r && r.message) || 'release 失败' }
+          diagFail(DIAG_SOURCE.release, 'release 失败: 宿主回执不成功 ' + diagReason(reply.message))
+        }
+      }
+    } catch (error) {
+      reply = { reqId: msg.reqId, reply: true, ok: false, message: String((error && error.message) || error) }
