diff --git a/scripts/ci/cycle-guard.mjs b/scripts/ci/cycle-guard.mjs
new file mode 100644
index 00000000..ed598245
--- /dev/null
+++ b/scripts/ci/cycle-guard.mjs
@@ -0,0 +1,321 @@
+#!/usr/bin/env node
+// scripts/ci/cycle-guard.mjs — 值级循环依赖门禁(issue #413)。
+//
+// 为什么存在:issue #413 请求恢复夜巡"循环依赖检测"(此前用 madge,因供应链/维护成本
+// 移除)。scripts/codemap.mjs 已有零依赖 DFS 环检测,但边分类原是正则近似——同类问题
+// scripts/ci/structure-guard.mjs rule ④ 第三轮返修时已被 owner 拍板改走 TS AST(该文件
+// 头注释原文:"手写 lexer……是无底洞……AST 天然免疫字符串/模板/正则/注释全部边界")。
+// 本守卫复用同一先例:边分类走 TS compiler API,环检测复用 codemap.mjs 导出的
+// collectFiles/resolveImport/findCircles(不复制文件收集/路径解析/图算法三段逻辑)。
+// codemap.mjs 保留的正则近似只用于 SessionStart hook 展示(不能引入 node_modules 依赖),
+// 不是门禁真相源——门禁真相在本文件。
+//
+// 威胁模型:防的是"新增值级循环依赖"——模块在求值期(top-level)互相依赖对方尚未初始化
+// 完成的绑定,ESM 下表现为 TDZ/undefined 访问。已知存量环(见 cycle-guard.baseline.json)
+// 未逐条证明安全,只是被有意豁免;新增环一律 fail-closed。本守卫不防:刻意用字符串拼接
+// /运行时动态拼装路径绕过静态可分析性——那不是"循环依赖"问题,归 code review 管。
+//
+// 分类规则(TS AST,非正则近似;见 classifyFileSpecs):
+// - ImportDeclaration:importClause.isTypeOnly(整句 `import type ... from`)→ type-only;
+//   否则逐 binding 判定 —— default 绑定 / `* as ns` 命名空间绑定为值,NamedImports 逐
+//   specifier 的 isTypeOnly(TS 4.5+ inline `type` 修饰符),任一非 type → 该边值级;
+//   无 importClause(纯副作用 `import './x'`)→ 值级(模块仍被求值)。
+// - ExportDeclaration:isTypeOnly(整句 `export type ... from`,含 `export type * from`)
+//   → type-only;否则 exportClause 缺失(`export * from`)→ 值级,NamedExports 逐
+//   specifier 判定同 import。
+// - 动态 import():CallExpression(expression.kind===ImportKeyword)恒值级(运行时才发生
+//   的模块求值,如 `await import()` / `void import()`);类型位置(`typeof import('./x')`
+//   / `: import('./x').Foo` / 泛型参数里的 import())被 TS 解析器识别为 ImportTypeNode,
+//   是完全不同的 AST 节点,天然不会落进上面的 CallExpression 分支——按 type-only 计入
+//   全边图(供 allCycleCount 对照),不进值级图。这正是本仓 chatMaskEditFlow.ts /
+//   chatPersistSync.ts 的 `ChatStoreInstance` 类型刻意用来打破值级环的惯用法。
+// AST 天然免疫正则启发式的已知盲区:字符串字面量里出现 "from"/import 关键字文本、反引号
+// 模板字符串内嵌 import 语句等,词法边界由 TS parser 定义,不会被误判。
+//
+// 白名单:scripts/ci/cycle-guard.baseline.json,按环内文件集合匹配(与起点/方向/rotation
+// 无关)。两层标注见该文件 _kindSemantics。已豁免环若被后续重构修掉,常规运行会把对应
+// entry 列入 staleWhitelistEntries 提示可移除(不致 fail,单调收缩);`--update-baseline`
+// 可据此自动裁剪(仅裁剪,拒绝在存在未豁免新增环时执行——不做静默扩大豁免)。
+//
+// 统计口径(不做减法指标):allCycleCount 与 valueCycleCount 是两次独立 DFS 的独立测量值
+// (全边图 vs 值级图),不可比减——去掉 type-only 边后节点间可能仍有别的值级路径互通,
+// "全边环数 - 值级环数"不对应任何真实实体,故不作为字段输出。
+//
+// 退出码:0=当前值级环全部命中白名单(或压根没有新增);1=存在未豁免的新增值级环;
+// 2=运行错误(基线文件缺失/解析失败、扫描过程异常等)。本守卫是独立 CI/preflight 步骤,
+// 不继承 codemap.mjs 给 SessionStart hook 用的 5s 性能门预算。
+//
+// 用法:node scripts/ci/cycle-guard.mjs [--json] [--update-baseline]
+//   默认:人类可读文本到 stdout。
+//   --json:机读单行 JSON(allCycleCount/valueCycleCount/valueCycles/whitelistedCycles/
+//           nonWhitelistedCycles/staleWhitelistEntries)。
+//   --update-baseline:用当前检出重写 baseline entries(仅裁剪 stale 条目,不新增;若存在
+//           未豁免新增环则拒绝执行并 exit 2,提示先手动审查)。
+
+import { readFileSync, writeFileSync } from 'node:fs'
+import { join, dirname, resolve } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import ts from 'typescript'
+import { ROOT, collectFiles, resolveImport, findCircles } from '../codemap.mjs'
+
+const __dirname = dirname(fileURLToPath(import.meta.url))
+const BASELINE_PATH = join(__dirname, 'cycle-guard.baseline.json')
+
+// ── TS AST 边分类:一个文件的源码文本 → { allSpecs, valueSpecs }(相对 import specifier)──
+// 纯函数(不碰文件系统),便于 fixture 测试(issue #413 R2)。
+export function classifyFileSpecs(filePosixPath, content) {
+  const allSpecs = new Set()
+  const valueSpecs = new Set()
+  const isRelative = (s) => s.startsWith('./') || s.startsWith('../')
+  const addSpec = (text, isTypeOnly) => {
+    if (!isRelative(text)) return
+    allSpecs.add(text)
+    if (!isTypeOnly) valueSpecs.add(text)
+  }
+  const addFromStringLiteral = (node, isTypeOnly) => {
+    if (node && ts.isStringLiteral(node)) addSpec(node.text, isTypeOnly)
+  }
+
+  const sf = ts.createSourceFile(filePosixPath || 'scan.ts', content, ts.ScriptTarget.Latest, true)
+
+  function visit(node) {
+    if (ts.isImportDeclaration(node)) {
+      const clause = node.importClause
+      if (!clause) {
+        // 无 importClause = 纯副作用 import(`import './x'`)→ 模块仍被求值,值级。
+        addFromStringLiteral(node.moduleSpecifier, false)
+      } else if (clause.isTypeOnly) {
+        addFromStringLiteral(node.moduleSpecifier, true)
+      } else {
+        let anyValue = Boolean(clause.name) // default 绑定是值
+        const named = clause.namedBindings
+        if (named) {
+          if (ts.isNamespaceImport(named)) {
+            anyValue = true // `* as ns` 命名空间对象在运行时被引用
+          } else if (ts.isNamedImports(named)) {
+            for (const el of named.elements) {
+              if (!el.isTypeOnly) {
+                anyValue = true
+                break
+              }
+            }
+          }
+        }
+        addFromStringLiteral(node.moduleSpecifier, !anyValue)
+      }
+    } else if (ts.isExportDeclaration(node) && node.moduleSpecifier) {
+      if (node.isTypeOnly) {
+        addFromStringLiteral(node.moduleSpecifier, true)
+      } else {
+        const clause = node.exportClause
+        if (!clause) {
+          // `export * from './x'` — 值级重导出(可能带值)。
+          addFromStringLiteral(node.moduleSpecifier, false)
+        } else if (ts.isNamedExports(clause)) {
+          let anyValue = false
+          for (const el of clause.elements) {
+            if (!el.isTypeOnly) {
+              anyValue = true
+              break
+            }
+          }
+          addFromStringLiteral(node.moduleSpecifier, !anyValue)
+        } else {
+          // NamespaceExport(`export * as ns from './x'`)— 值级。
+          addFromStringLiteral(node.moduleSpecifier, false)
+        }
+      }
+    } else if (ts.isCallExpression(node) && node.expression.kind === ts.SyntaxKind.ImportKeyword) {
+      // 动态 import(...) —— 只有值位置才会解析成 CallExpression;类型位置的
+      // `typeof import()` / `: import()` 被解析器识别为 ImportTypeNode(见下方分支),
+      // 天然不会落进这里,不需要额外的"类型位置回溯判断"。
+      const arg = node.arguments && node.arguments[0]
+      addFromStringLiteral(arg, false)
+    } else if (ts.isImportTypeNode(node)) {
+      // `typeof import('./x')` / `: import('./x').Foo` / `Pick<import('./x').Foo, ...>` 等
+      // 类型位置惯用法(本仓 chatMaskEditFlow.ts/chatPersistSync.ts 的 ChatStoreInstance
+      // 类型故意用它打破值级环)。argument 是 LiteralTypeNode 包一层 StringLiteral。
+      const arg = node.argument
+      if (arg && ts.isLiteralTypeNode(arg) && ts.isStringLiteral(arg.literal)) {
+        addSpec(arg.literal.text, true)
+      }
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(sf)
+  return { allSpecs, valueSpecs }
+}
+
+// ── 构建全边图 + 值级图,复用 codemap.mjs 的文件收集/路径解析/DFS(不复制)──
+function buildGraphs() {
+  const files = collectFiles()
+  const adj = new Map()
+  const valueAdj = new Map()
+  for (const file of files) {
+    let content = ''
+    try {
+      content = readFileSync(join(ROOT, file), 'utf8')
+    } catch {
+      content = ''
+    }
+    const { allSpecs, valueSpecs } = classifyFileSpecs(file, content)
+    const resolved = new Set()
+    const resolvedValue = new Set()
+    for (const spec of allSpecs) {
+      const target = resolveImport(spec, file)
+      if (!target) continue
+      resolved.add(target)
+      if (valueSpecs.has(spec)) resolvedValue.add(target)
+    }
+    adj.set(file, [...resolved])
+    valueAdj.set(file, [...resolvedValue])
+  }
+  return {
+    allCycles: findCircles(adj),
+    valueCycles: findCircles(valueAdj),
+  }
+}
+
+// ── 白名单:环 → 节点集合 key,与起点/方向/rotation 无关 ──
+function canonicalNodes(ring) {
+  return [...new Set(ring)].sort()
+}
+function ringKey(ring) {
+  return canonicalNodes(ring).join('|')
+}
+
+function loadBaseline() {
+  const raw = readFileSync(BASELINE_PATH, 'utf8')
+  const parsed = JSON.parse(raw)
+  if (!Array.isArray(parsed.entries)) {
+    throw new Error(`${BASELINE_PATH} 缺少 entries 数组`)
+  }
+  for (const entry of parsed.entries) {
+    if (!Array.isArray(entry.nodes) || entry.nodes.length < 2) {
+      throw new Error(`${BASELINE_PATH} 存在 nodes 非法的 entry: ${JSON.stringify(entry)}`)
+    }
+    if (entry.kind !== 'accepted' && entry.kind !== 'baseline') {
+      throw new Error(`${BASELINE_PATH} 存在 kind 非法的 entry(只允许 accepted/baseline): ${JSON.stringify(entry)}`)
+    }
+  }
+  return parsed
+}
+
+// 判断一个值级环是否命中白名单,命中返回该白名单条目({nodes, kind, reason}),否则 null。
+// 导出供 fixture 测试直接验证(issue #413 SC-3)。
+export function matchWhitelist(entries, ring) {
+  const idx = new Map(entries.map((e) => [ringKey(e.nodes), e]))
+  return idx.get(ringKey(ring)) ?? null
+}
+
+// 生成机读/人读共用的判定结果。纯函数,便于 fixture 测试(issue #413)。
+export function evaluateCycles({ allCycles, valueCycles, baselineEntries }) {
+  const whitelistedCycles = []
+  const nonWhitelistedCycles = []
+  const matchedKeys = new Set()
+  for (const ring of valueCycles) {
+    const entry = matchWhitelist(baselineEntries, ring)
+    if (entry) {
+      whitelistedCycles.push({ nodes: canonicalNodes(ring), kind: entry.kind, reason: entry.reason })
+      matchedKeys.add(ringKey(entry.nodes))
+    } else {
+      nonWhitelistedCycles.push(canonicalNodes(ring))
+    }
+  }
+  const staleWhitelistEntries = baselineEntries
+    .filter((entry) => !matchedKeys.has(ringKey(entry.nodes)))
+    .map((entry) => ({ nodes: canonicalNodes(entry.nodes), kind: entry.kind }))
+  return {
+    allCycleCount: allCycles.length,
+    valueCycleCount: valueCycles.length,
+    valueCycles: valueCycles.map(canonicalNodes),
+    whitelistedCycles,
+    nonWhitelistedCycles,
+    staleWhitelistEntries,
+  }
+}
+
+function printHuman(result) {
+  const lines = []
+  lines.push(
+    `cycle-guard: 全边环 ${result.allCycleCount} 处(含 type-only 假环) / 值级环 ${result.valueCycleCount} 处`
+  )
+  lines.push(`  白名单命中: ${result.whitelistedCycles.length}`)
+  for (const c of result.whitelistedCycles) {
+    lines.push(`    - [${c.kind}] ${c.nodes.join(' , ')}`)
+  }
+  if (result.nonWhitelistedCycles.length) {
+    lines.push(`  ❌ 未豁免的新增值级环: ${result.nonWhitelistedCycles.length}`)
+    for (const nodes of result.nonWhitelistedCycles) {
+      lines.push(`    - ${nodes.join(' , ')}`)
+    }
+  } else {
+    lines.push('  ✅ 无未豁免的新增值级环')
+  }
+  if (result.staleWhitelistEntries.length) {
+    lines.push(`  ℹ️  ${result.staleWhitelistEntries.length} 条白名单条目已不对应任何当前值级环(可能已被重构修掉,可从 cycle-guard.baseline.json 移除):`)
+    for (const entry of result.staleWhitelistEntries) {
+      lines.push(`    - [${entry.kind}] ${entry.nodes.join(' , ')}`)
+    }
+  }
+  process.stdout.write(lines.join('\n') + '\n')
+}
+
+function updateBaseline(baseline, result) {
+  if (result.nonWhitelistedCycles.length > 0) {
+    process.stderr.write(
+      `cycle-guard: 存在 ${result.nonWhitelistedCycles.length} 处未豁免的新增值级环,拒绝 --update-baseline` +
+        '(该操作只裁剪已修掉的存量条目,不会静默豁免新问题——请先手动审查新增环)。\n'
+    )
+    return 2
+  }
+  const matchedKeys = new Set(result.whitelistedCycles.map((c) => ringKey(c.nodes)))
+  const kept = baseline.entries.filter((entry) => matchedKeys.has(ringKey(entry.nodes)))
+  const removed = baseline.entries.length - kept.length
+  const next = { ...baseline, entries: kept }
+  writeFileSync(BASELINE_PATH, JSON.stringify(next, null, 2) + '\n', 'utf8')
+  process.stderr.write(`cycle-guard: --update-baseline 完成,裁剪 ${removed} 条已不存在的白名单条目(保留 ${kept.length} 条)。\n`)
+  return 0
+}
+
+function main() {
+  const args = process.argv.slice(2)
+  const asJson = args.includes('--json')
+  const doUpdateBaseline = args.includes('--update-baseline')
+
+  let baseline
+  try {
+    baseline = loadBaseline()
+  } catch (e) {
+    process.stderr.write(`cycle-guard: 基线文件读取/解析失败 — ${e.message}\n`)
+    process.exit(2)
+  }
+
+  let allCycles, valueCycles
+  try {
+    ;({ allCycles, valueCycles } = buildGraphs())
+  } catch (e) {
+    process.stderr.write(`cycle-guard: 扫描过程异常 — ${e.message}\n${e.stack}\n`)
+    process.exit(2)
+  }
+
+  const result = evaluateCycles({ allCycles, valueCycles, baselineEntries: baseline.entries })
+
+  if (doUpdateBaseline) {
+    process.exit(updateBaseline(baseline, result))
+  }
+
+  if (asJson) {
+    process.stdout.write(JSON.stringify(result) + '\n')
+  } else {
+    printHuman(result)
+  }
+
+  process.exit(result.nonWhitelistedCycles.length > 0 ? 1 : 0)
+}
+
+// 仅在直接运行时跑(被 import 做 fixture 测试时不执行,避免污染 stdout / 触发 exit)。
+const __isMain = process.argv[1] && fileURLToPath(import.meta.url) === resolve(process.argv[1])
+if (__isMain) {
+  main()
+}
