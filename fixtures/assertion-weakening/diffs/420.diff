-  // #297 P2:userActionToken 是 'continue' 专属的一次性点击票据(手册 §4.11),
-  // 消费点在 runCardActionContinue(位于 cardActionPlan 与 handleCardAction 之间,
-  // 落在下面第一段切片的范围内)。
-  const CONSUMED_FIELDS = ['actionId', 'callId', 'prompt', 'sessionId', 'spawnCallId', 'type', 'userActionToken'].sort()
-
-  /**
-   * 事件字段在三处被读:handleCardAction(校验/路由)、cardActionPlan(取 prompt)、
-   * runCardActionContinue(取 userActionToken)。第一段切片按源码顺序天然覆盖后两者
-   * (cardActionPlan → runCardActionContinue → handleCardAction 依次声明)。
-   *
-   * 端标记必须精确匹配 `async function handleCardAction(`(带开括号)而不是裸前缀
-   * `async function handleCardAction` —— 后者是 `async function
-   * handleCardActionXxx` 的前缀子串,任何以 handleCardAction 开头命名的新函数都会
-   * 被误当作切片终点,静默漏扫一段消费面(#297 P2 复审踩过这个坑)。
-   */
-  const sliceSource = (marker: string, endMarker: string): string => {
-    const start = MAIN_JS.indexOf(marker)
-    expect(start).toBeGreaterThan(0)
-    return MAIN_JS.slice(start, MAIN_JS.indexOf(endMarker, start))
-  }
-  const consumerBody = (): string =>
-    sliceSource('function cardActionPlan(', 'async function handleCardAction(') +
-    sliceSource('async function handleCardAction(', 'cardActionInflight.delete(spawnCallId)')
