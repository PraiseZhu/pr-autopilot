-    expect(declared).not.toBeNull()
-    const allowlist = Array.from((declared as RegExpExecArray)[1].matchAll(/'([^']+)'/g), (m) => m[1])
-    expect(allowlist.slice().sort()).toEqual(CONSUMED_FIELDS)
-  })
-
