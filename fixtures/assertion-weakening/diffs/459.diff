diff --git a/src/__tests__/depositCrashCompensation.test.ts b/src/__tests__/depositCrashCompensation.test.ts
new file mode 100644
index 00000000..7a65daa2
--- /dev/null
+++ b/src/__tests__/depositCrashCompensation.test.ts
@@ -0,0 +1,117 @@
+/**
+ * 寄存成功记账失败的崩溃点补偿契约测试(T1b3;设计稿 SC1b.11/SC1b.7)。
+ *
+ * 覆盖:
+ *  - `resolveDepositEntry`(基础新寄存路径,T1a):`recordDeposit` 提交失败后
+ *    立即幂等 release 新 hash(避免配额孤儿),release 也失败则按 C 风险记账,
+ *    不循环重试;
+ *  - `refingerprintDepositEntry`(换指纹路径,T1b2/T1b3):提交失败按同一条路径
+ *    补偿(对象是这次新寄存出的 hash);
+ *  - SC1b.7"至多强制重寄 1 轮,再败终止不循环":寄存本身失败时不自动重试第二轮。
+ *
+ * 端到端跑在真实 main.js 上(depositTestHarness 双 spy),不是对着替身自说自话。
+ */
+import { afterEach, describe, expect, it } from 'vitest'
+import { DepositError, refingerprintDepositEntry, resolveDepositEntry } from '../agent/depositPort'
+import { recordDeposit, type DepositEntryDraft } from '../agent/depositStore'
+import { blobOfBytes, createDepositHarness, teardownDepositHarness, FAKE_HASH, type DepositHarness } from './depositTestHarness'
+
+let harness: DepositHarness
+
+const draft = (hash: string, depositedAt: number, from: 'deposit' | 'artifact' | 'ledger' = 'deposit'): DepositEntryDraft => ({
+  hash,
+  ext: '.png',
+  depositedAt,
+  from,
+})
+
+/** 所有 deposit/state-*.json 写盘一律失败——迫使 recordDeposit 的提交必然失败,
+ * 但读(load)不受影响(同 depositMigration.test.ts「中断恢复」的手法)。 */
+const withBrokenStateWrites = (): DepositHarness => createDepositHarness({ writeGuard: (request) => !request.path.startsWith('deposit/state-') })
+
+afterEach(() => {
+  teardownDepositHarness()
+})
+
+describe('resolveDepositEntry — SC1b.11 寄存成功但本地记账失败的补偿', () => {
+  it('提交失败 + hash 无其它引用 → 立即幂等 release 新 hash,避免配额孤儿', async () => {
+    harness = withBrokenStateWrites()
+    harness.setHostReleaseReply(() => ({ ok: true, released: true }))
+
+    await expect(resolveDepositEntry({ assetUrl: 'mivo-asset:1', blob: blobOfBytes(32) })).rejects.toBeInstanceOf(DepositError)
+
+    expect(harness.hostRequests).toHaveLength(1) // 寄存本身确实发生过(宿主已经真实占了配额)
+    expect(harness.hostReleaseRequests).toHaveLength(1) // 补偿性 release
+    expect(harness.hostReleaseRequests[0]).toMatchObject({ hash: FAKE_HASH })
+  })
+
+  it('release 也失败 → 按 owner 已接受的 C 风险记账,不循环重试第二次', async () => {
+    harness = withBrokenStateWrites()
+    harness.setHostReleaseReply(() => ({ ok: false, message: '宿主也拒绝' }))
+
+    await expect(resolveDepositEntry({ assetUrl: 'mivo-asset:1', blob: blobOfBytes(32) })).rejects.toBeInstanceOf(DepositError)
+
+    expect(harness.hostReleaseRequests).toHaveLength(1) // 尝试过恰好一次,没有自动重试
+  })
+
+  it('提交失败但 hash 恰好已被别的 assetUrl 合法持有(同字节 dedup)→ 零 release 请求', async () => {
+    harness = withBrokenStateWrites()
+    // 先用一条能正常落盘的会话预置一条已存在的映射,再切到写盘故障场景验证
+    // resolveDepositEntry 面对"同 hash 已有其它合法持有者"时不会误 release。
+    // 直接操纵内存态(不经提交)即可——这里只关心 resolveDepositEntry 读到的
+    // refcount 判断,不关心这条预置记录本身是否落盘。
+    await recordDeposit('mivo-asset:existing', draft(FAKE_HASH, 0, 'deposit'))
+    harness.setHostReply(() => ({ ok: true, hash: FAKE_HASH, ext: '.png' }))
+
+    await expect(resolveDepositEntry({ assetUrl: 'mivo-asset:1', blob: blobOfBytes(32) })).rejects.toBeInstanceOf(DepositError)
+
+    expect(harness.hostReleaseRequests).toHaveLength(0) // mivo-asset:existing 仍持有这个 hash,不能释放
+  })
+})
+
+describe('refingerprintDepositEntry — SC1b.11 换指纹时提交失败的补偿(对象是新 hash)', () => {
+  it('提交失败 → 补偿新寄存出的 hash,旧条目原样保留(提交从未真正替换它)', async () => {
+    // 先用一条正常会话把旧条目落盘,再切到写盘故障场景验证补偿路径。
+    const setup = createDepositHarness()
+    await recordDeposit('mivo-asset:1', draft(FAKE_HASH, 1, 'deposit'))
+    const disk = { ...Object.fromEntries(setup.brain.files) }
+    teardownDepositHarness()
+
+    harness = createDepositHarness({ files: disk, writeGuard: (request) => !request.path.startsWith('deposit/state-') })
+    const newHash = 'c'.repeat(32)
+    harness.setHostReply(() => ({ ok: true, hash: newHash, ext: '.png' }))
+    harness.setHostReleaseReply(() => ({ ok: true, released: true }))
+
+    await expect(refingerprintDepositEntry({ assetUrl: 'mivo-asset:1', blob: blobOfBytes(32) })).rejects.toBeInstanceOf(DepositError)
+
+    // 补偿对象是这次新寄存出的 hash,不是旧 hash——提交本身失败,旧条目从未被
+    // 换掉(mutateAndCommit 的 mutator 仍然会把新条目写进内存,但这里验证的是
+    // 对外可观察的补偿行为:release 的是新 hash)。
+    expect(harness.hostReleaseRequests).toHaveLength(1)
+    expect(harness.hostReleaseRequests[0]).toMatchObject({ hash: newHash })
+  })
+
+  it('T1x(owner 决策,demo 阶段砍掉自动回收):提交成功 → 新映射覆盖旧条目,旧 hash 绝不发起 release', async () => {
+    harness = createDepositHarness()
+    await recordDeposit('mivo-asset:1', draft(FAKE_HASH, 1, 'deposit'))
+    const newHash = 'd'.repeat(32)
+    harness.setHostReply(() => ({ ok: true, hash: newHash, ext: '.png' }))
+    harness.setHostReleaseReply(() => ({ ok: true, released: true })) // 即使宿主愿意释放,也不该被调用
+
+    const entry = await refingerprintDepositEntry({ assetUrl: 'mivo-asset:1', blob: blobOfBytes(32) })
+
+    expect(entry.hash).toBe(newHash)
+    expect(harness.hostReleaseRequests).toHaveLength(0) // 降范围核心断言:旧 hash 占宿主配额是已知代价,不发 release
+  })
+})
+
+describe('SC1b.7 — 自愈至多强制重寄 1 轮,再败终止不循环', () => {
+  it('寄存本身失败(宿主拒绝)→ 只发一次寄存请求,不自动重试第二轮', async () => {
+    harness = createDepositHarness()
+    harness.setHostReply(() => ({ ok: false, message: '宿主拒绝' }))
+
+    await expect(refingerprintDepositEntry({ assetUrl: 'mivo-asset:1', blob: blobOfBytes(32) })).rejects.toThrow()
+
+    expect(harness.hostRequests).toHaveLength(1) // 恰好一次,没有内部重试循环
+  })
+})
