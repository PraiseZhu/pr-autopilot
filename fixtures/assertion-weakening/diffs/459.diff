+/**
+ * 强制重新寄存一个 assetUrl(绕过缓存)——调用方(T1e 的"edit 失败强制重寄重试"
+ * 接线)已确认旧指纹在宿主侧失效。写入新映射即返回,**不释放旧 hash**(降范围,
+ * 见上)。提交失败按 SC1b.11 补偿这次新寄存出的 hash(与 `resolveDepositEntry`
+ * 同一条路径)。不做单独的 single-flight:调用方(T1e)负责"自愈至多 1 轮"的
+ * 重试次数控制(SC1b.7),这里只是被触发时执行的那个原语本身。
+ */
+export const refingerprintDepositEntry = async (input: {
+  assetUrl: string
+  blob: Blob
+  label?: string
+}): Promise<DepositEntryDraft> => {
+  const { assetUrl, blob, label } = input
+  const oldEntry = await lookupDeposit(assetUrl)
+  const receipt = await depositBlob(blob, label ?? DEPOSIT_LABEL)
+  const entry: DepositEntryDraft = {
+    hash: receipt.hash,
+    ext: receipt.ext,
+    bytes: receipt.bytes,
+    depositedAt: now(),
+    from: 'deposit',
+  }
+  const commit = await recordDeposit(assetUrl, entry)
+  if (!commit.ok) {
+    await compensateFailedDepositCommit(assetUrl, entry.hash)
+    throw new DepositError('DEPOSIT_FAILED', '换指纹记账失败,请重试。')
+  }
+  if (oldEntry && oldEntry.from === 'deposit' && oldEntry.hash !== entry.hash) {
+    debugLogger.log(
+      SOURCE,
+      `换指纹:旧 hash 不释放(自动回收已砍,占宿主配额是范围裁决已接受的代价):hash=${oldEntry.hash.slice(0, 8)}`,
+    )
+  }
+  return entry
+}
+
+// ── T1b3(降范围后保留):寄存成功记账失败的补偿(设计稿 SC1b.11)──
+
+/**
+ * SC1b.11:`recordDeposit` 的提交失败之后调用——宿主已经确实寄存成功(真实占了
+ * 配额),但本地映射没能落盘,不补救就是一份**配额孤儿**(§4.10.4)。若这个刚寄存
+ * 出来的 hash 此刻已无其它 assetUrl 引用,立即幂等 release 它;release 也失败 →
+ * `diagFail`(经 debugLogger.error)并按 owner 已接受的 C 风险记账——不重试、
+ * 不循环,如实记录残余风险。
+ *
+ * 无论 release 成功与否,这条失败的本地映射本身都不可信(`mutateAndCommit` 的
+ * mutator 已经把它写进内存,只是没能落盘)——用 `invalidateDeposit` 清掉,避免
+ * 下次 `lookupDeposit` 假命中一个已经被释放、或从未真正落盘过的指纹。这一步的
+ * 提交同样可能失败(持久化本身已经出问题),失败就留痕、不二次重试——诚实边界,
+ * 不假装能在持久化损坏的情况下还保证内存与磁盘完全一致。
+ *
+ * 安全性构造上成立(demo 降范围后唯一保留的 release 出口):这个 hash 从未写入
+ * 过 map(commit 失败),refcount 必为 0——零依赖 pendingReleases、零依赖租约。
+ */
+const compensateFailedDepositCommit = async (assetUrl: string, hash: string): Promise<void> => {
+  const state = await loadDepositStore()
+  if (depositHashRefCount(state, hash, assetUrl) > 0) {
+    debugLogger.log(SOURCE, `记账失败补偿:hash=${hash.slice(0, 8)} 仍被别的 assetUrl 引用,零 release`)
+  } else {
+    const result = await releaseHash(hash)
+    if (result.ok) {
+      debugLogger.warn(SOURCE, `记账失败补偿:已幂等 release 新 hash,避免配额孤儿 hash=${hash.slice(0, 8)}`)
+    } else {
+      debugLogger.error(
+        SOURCE,
+        `记账失败补偿:release 也失败,按 owner 已接受的 C 风险记账(配额孤儿)hash=${hash.slice(0, 8)} ${result.message || '无原因'}`,
+      )
+    }
+  }
+  await invalidateDeposit(assetUrl)
+}
