+/**
+ * 设置卡的渲染层:把 `settingsCard` 的 view model 刷到真实 DOM。**零判断** ——
+ * 「什么态显示什么」全在 settingsCard.ts,这里只搬运。
+ *
+ * 为什么单独成模块(第 2 轮审查):此前这段住在 `settings.js` 里,而 settings.js 是 ESM 且
+ * 模块顶层就 `card.start()`(一 import 就发 fetch),测试没法直接引它 —— 于是上一版在测试里
+ * **复刻**了这段的凭证卫生分支,再加一条「逐字对照生产文件字符串」的断言防漂移。审查方指出
+ * 那条锁法过紧:生产侧做等价重写(如换成三元表达式)会误红,而复刻体本身仍可能与生产体分叉。
+ * 提成模块后测试直接跑**生产这一份**,两个问题一起消失。
+ */
+import type { CardView } from './settingsCard'
+
+const BADGE_CLASS: Record<CardView['state'], string> = {
+  loading: 'is-pending',
+  validating: 'is-pending',
+  unconfigured: 'is-unconfigured',
+  connected: 'is-connected',
+  failed: 'is-failed',
+}
+
+/** 渲染一次。`doc` 可注入,便于测试挂在自己准备好的 document 上。 */
+export const renderSettingsCard = (view: CardView, doc: Document = document): void => {
+  const $ = (id: string) => doc.getElementById(id) as HTMLElement
+
+  $('badge').className = 'state-badge ' + BADGE_CLASS[view.state]
+  $('badge-text').textContent = view.badgeText
+  $('badge-icon').textContent = view.badgeIcon
+  $('badge-spinner').hidden = !view.badgeSpinner
+
+  $('key-row').hidden = !view.showInput
+  $('conn-row').hidden = !view.showDisconnect
+  $('conn-status').textContent = view.statusText
+
+  const input = $('key') as HTMLInputElement
+  input.disabled = view.inputDisabled
+  input.classList.toggle('is-error', view.inputError)
+  // 非可输入态一律清空输入框(SC-C5)。**准确说是哪几态**(第 3 轮审查指出此前注释与实现
+  // 不符):connected(showInput=false)与 validating(inputDisabled=true)会清;**failed 态不清**
+  // —— 它的输入框是可编辑的,用户刚贴进去的明文仍在这个 `<input type=password>` 的 value 里。
+  // 那不构成外泄(未持久化、未广播、未进日志、未回显,与任何普通密码框同级),但别把它写成
+  // 「三态都不带 key」。
+  if (!view.showInput || view.inputDisabled) input.value = ''
+
+  const primary = $('primary') as HTMLButtonElement
+  primary.hidden = !view.showPrimary
+  primary.textContent = view.primaryLabel
+  primary.disabled = view.primaryDisabled
+
+  $('disconnect').textContent = view.disconnectLabel
+
+  $('error-row').hidden = !view.errorText
+  $('error-text').textContent = view.errorText
+
+  if (view.focusInput) input.focus()
+}
