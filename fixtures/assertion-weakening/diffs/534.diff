+// @vitest-environment happy-dom
+/**
+ * 设置卡的 **computed-style 真断言** + render 层 DOM 行为(PR-C 第 1 轮审查 P1 返修)。
+ *
+ * 为什么单独一个文件:这些断言需要 DOM 环境(happy-dom),而 `mivoSettingsCard.test.ts` 里
+ * 的状态机断言是纯 node 的,合在一起会让整份用例白付 DOM 环境的启动代价。
+ *
+ * ⚠ 返修由来(记账,别再犯):上一版我在 `mivoSettingsCard.test.ts` 里写了「本仓单测环境的
+ * `getComputedStyle` 对外链 <style> 的类选择器返回空串,所以 R3 的尺寸不变量只能降级成源
+ * 文本断言」——**这句是错的**。本仓装的是 happy-dom(`devDependencies` 里没有 jsdom,我连
+ * 归因的仓都写错了),而 happy-dom 对类选择器正常级联。审查方还实测出那套源文本断言有可
+ * 复现的规避路径:在 <style> 末尾追加一条 `#primary { padding: 20px 40px }`(不落在
+ * `.btn-primary`/`.btn-pill` 块体内),R3「四按钮同尺寸同圆角」已破而全部用例照旧全绿。
+ * 所以这里改回按 R3 原本要求的 computed-style 断言 —— 它管的是「最终渲染出来是什么」,
+ * 不管你是用哪条选择器写坏的。源文本断言保留在另一文件里(骨架顺序、spinner 归属、a11y
+ * 属性那些结构性判据用源文本更直接),但**尺寸不变量以本文件为准**。
+ *
+ * 路径解析注意:happy-dom 下 `import.meta.url` 是 http URL,`fileURLToPath` 会抛
+ * `The URL must be of scheme file`,所以这里用 `process.cwd()` 拼仓库相对路径。
+ */
+import { beforeEach, describe, expect, it } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { renderSettingsCard } from '../settings/settingsView'
+import type { CardView } from '../settings/settingsCard'
+
+const PLUGIN_DIR = join(process.cwd(), 'cindyplugin')
+const HTML = readFileSync(join(PLUGIN_DIR, 'settings.html'), 'utf8')
+
+/** 把 settings.html 的 <style> 与 <body> 内容挂进当前 document(可选追加一段覆盖样式做变异)。 */
+const mount = (extraCss = '') => {
+  // ⚠ `matchAll` 抽**全部** <style> 块,不是第一个(第 2 轮审查 P1):上一版用单次 exec,
+  // 于是破坏性规则写进第二个 <style> 块时 R3 已破而 32 条用例照旧全绿 —— 抽取范围本身
+  // 成了规避面。同理 `<style[^>]*>` 而非 `<style>`:带属性(如 media="all")的块也要收。
+  const styles = [...HTML.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map((m) => m[1]).join('\n')
+  const body = /<body[^>]*>([\s\S]*?)<\/body>/.exec(HTML)?.[1] ?? ''
+  expect(styles.length).toBeGreaterThan(100) // 抽取失败就别静默跑成空断言
+  expect(body).toContain('id="badge"')
+  document.head.innerHTML = `<style>${styles}${extraCss}</style>`
+  // 剥掉 <script src>:happy-dom 会为它抛常态 NotSupportedError 噪声,而本文件只量样式与
+  // DOM 行为,不需要真加载模块(生产入口由 vite 重写,形态已在构建产物侧核过)。
+  document.body.innerHTML = body.replace(/<script[\s\S]*?<\/script>/g, '')
+  // ⚠ 把 <body> **标签自身的属性**也搬过来(第 3 轮审查):只取 innerHTML 会丢掉
+  // `<body style="margin:0;padding:12px 0">` 这类行内声明,于是写在 body 属性上的声明与
+  // CSS 自定义属性对 computed 断言完全不可见 —— 又是一条"取材范围即规避面"。
+  const bodyTag = /<body([^>]*)>/.exec(HTML)?.[1] ?? ''
+  for (const attr of bodyTag.matchAll(/([a-zA-Z-]+)\s*=\s*"([^"]*)"/g)) {
+    document.body.setAttribute(attr[1], attr[2])
+  }
+}
+
+const buttons = () => Array.from(document.querySelectorAll('button')) as HTMLElement[]
+const boxOf = (el: HTMLElement) => {
+  const s = getComputedStyle(el)
+  return { padding: s.padding, borderRadius: s.borderRadius, borderWidth: s.borderWidth }
+}
+
+beforeEach(() => {
+  document.head.innerHTML = ''
+  document.body.innerHTML = ''
+})
+
+describe('SC-C2/C13 R3 尺寸不变量:computed-style 断言(四按钮一个尺寸一个圆角)', () => {
+  it('自检:computed-style 在本环境确实可用(不是空串对空串的恒真断言)', () => {
+    mount()
+    const box = boxOf(buttons()[0])
+    // 这条是上面那段返修记账的机器证据:如果哪天换了测试环境导致 computed 又变空串,
+    // 本条先红,提示"下面那些相等断言此刻已退化成恒真",而不是让它们静默失效。
+    expect(box.padding).not.toBe('')
+    expect(box.borderRadius).not.toBe('')
+    expect(getComputedStyle(document.getElementById('badge') as HTMLElement).backgroundColor).not.toBe('')
+  })
+
+  it('保存/校验/重试/断开:computed padding、border-radius、border 宽度三项全相等', () => {
+    mount()
+    const boxes = buttons().map(boxOf)
+    expect(boxes.length).toBe(2) // #primary(保存/校验/重试 共用)+ #disconnect
+    // R3 反馈③ 的原话是"四按钮一个尺寸一个圆角大小"。文案换(保存→校验→重试)不换元素,
+    // 所以元素只有两个,断言的是这两个的盒模型完全一致。
+    expect(boxes[1]).toEqual(boxes[0])
+    expect(boxes[0].borderRadius).toContain('9999px') // pill
+  })
+
+  it('变异防线:任何选择器把某个按钮的尺寸改掉都会红(不只是改 .btn-* 块体)', () => {
+    // 审查方实测的规避路径:用 id 选择器绕过"变体类里不许写 padding"那条源文本断言。
+    mount('#primary { padding: 20px 40px; border-radius: 2px }')
+    const boxes = buttons().map(boxOf)
+    expect(boxes[1]).not.toEqual(boxes[0]) // 证明本文件的断言抓得住这条路径
+  })
+
+  it('转圈徽标在 badge 内、且 badge 有语义色背景;字号全部落在 9..14px', () => {
+    mount()
+    const badge = document.getElementById('badge') as HTMLElement
+    expect(badge.contains(document.getElementById('badge-spinner'))).toBe(true)
+    // 只查**卡片子树**:`html`/`body` 的字号在生产里由宿主注入基线决定(测试环境里是
+    // happy-dom 的 16px 默认值),不是本卡片的样式,拿它断言等于在测 happy-dom。
+    const card = document.querySelector('.mivo-card') as HTMLElement
+    for (const el of [card, ...(Array.from(card.querySelectorAll('*')) as HTMLElement[])]) {
+      const size = getComputedStyle(el).fontSize
+      if (!size || !size.endsWith('px')) continue
+      const px = Number.parseFloat(size)
+      if (!Number.isFinite(px) || px === 0) continue
+      expect(px).toBeGreaterThanOrEqual(9)
+      expect(px).toBeLessThanOrEqual(14)
+    }
+  })
+})
+
+// ── render 层:接线层的凭证卫生(此前零覆盖,审查记为 gap)────────────────────────
+// 跑的是**生产那一份** `renderSettingsCard`(第 2 轮审查:上一版在测试里复刻了这段逻辑,
+// 再用一条「逐字对照生产文件字符串」的断言防漂移 —— 审查方指出那条锁法过紧,生产侧做等价
+// 重写就会误红,而复刻体本身仍可能与生产体分叉。把 render 提成 settingsView.ts 之后,
+// 复刻与逐字断言一起删掉,测的就是真东西)。
+describe('SC-C5 render 层:非可输入态一律清空输入框(明文不在页面上留)', () => {
+  const viewOf = (patch: Partial<CardView>): CardView => ({
+    state: 'unconfigured',
+    badgeText: '未配置',
+    badgeIcon: '',
+    badgeSpinner: false,
+    showInput: true,
+    inputDisabled: false,
+    inputError: false,
+    primaryLabel: '保存',
+    primaryDisabled: false,
+    showPrimary: true,
+    showDisconnect: false,
+    disconnectLabel: '断开',
+    statusText: '',
+    errorText: '',
+    focusInput: false,
+    ...patch,
+  })
+
+  it('showInput=false 或 inputDisabled=true → value 被清空;可输入态保留用户正在打的字', () => {
+    mount()
+    const input = document.getElementById('key') as HTMLInputElement
+
+    input.value = 'mivo_secret_plain'
+    renderSettingsCard(viewOf({ state: 'connected', showInput: false, showDisconnect: true }), document)
+    expect(input.value).toBe('')
+
+    input.value = 'mivo_secret_plain'
+    renderSettingsCard(viewOf({ state: 'validating', inputDisabled: true }), document)
+    expect(input.value).toBe('')
+
+    input.value = 'mivo_half_typed'
+    renderSettingsCard(viewOf({ state: 'unconfigured' }), document)
+    expect(input.value).toBe('mivo_half_typed') // 别把用户打了一半的字擦掉
+  })
+
+  it('徽标类名随态切换、错误行只在有文案时出现(渲染契约的其余部分也跑生产实现)', () => {
+    mount()
+    renderSettingsCard(viewOf({ state: 'connected', badgeText: '已连接', badgeIcon: '✓', showInput: false, showDisconnect: true, statusText: '已连接(尾号 …a1b2)' }), document)
+    expect((document.getElementById('badge') as HTMLElement).className).toBe('state-badge is-connected')
+    expect((document.getElementById('error-row') as HTMLElement).hidden).toBe(true)
+    expect((document.getElementById('conn-status') as HTMLElement).textContent).toContain('尾号')
+
+    renderSettingsCard(viewOf({ state: 'failed', badgeText: '连接失败', badgeIcon: '✕', inputError: true, primaryLabel: '重试', errorText: 'Key 无效或已过期' }), document)
+    expect((document.getElementById('badge') as HTMLElement).className).toBe('state-badge is-failed')
+    expect((document.getElementById('error-row') as HTMLElement).hidden).toBe(false)
+    expect((document.getElementById('key') as HTMLElement).classList.contains('is-error')).toBe(true)
+  })
+})
