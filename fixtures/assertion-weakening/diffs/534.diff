+describe('SC-C3 零蓝紫:颜色与属性双白名单(反转判据,未知一律红)', () => {
+  // 前三轮的教训:靠正则枚举**违规**写法必然漏 —— R1 漏 id 选择器、R2 漏第二个 style 块、
+  // R3 漏 `rgb(65 124 221 / .9)` 空格语法 / 4 位 hex / `darkblue`。每次补一个,下一个还在。
+  //
+  // 也不能改用 computed 值判色相:**实测 happy-dom 不做颜色归一化** —— 声明 `darkblue`
+  // 读回来还是 `"darkblue"`,`#41CF` 还是 `"#41CF"`,`rgb(65 124 221 / 0.9)` 原样,
+  // 未解析的 `var()` 直接给空串。所以解析问题只会换个地方,不会消失。
+  //
+  // 改法是**反转判据**:卡片 CSS 里能出现的**属性名**与**颜色值**都走白名单,
+  // 任何没登记过的写法(不论什么语法)一律红。这样"我没想到的写法"从 fail-open 变成
+  // fail-closed —— 想加新颜色就得来这里登记一行并说明理由,顺手也就被 review 看见。
+  const ALLOWED_COLORS = new Set([
+    // 中性:全部靠继承与不透明度,不引入任何色相
+    'currentColor', 'inherit', 'transparent',
+    'rgba(128, 128, 128, 0.16)', // 徽标底(灰,未配置/进行中共用)
+    // 两个「亮暗同值」的语义色(Cindy --card-status-done / --error-flat)
+    '#2aae5b', 'rgba(42, 174, 91, 0.18)', // 已连接绿 + 其底色
+    '#ef4444', 'rgba(239, 68, 68, 0.18)', 'rgba(239, 68, 68, 0.45)', 'rgba(239, 68, 68, 0.1)', // 错误红 + 底/边
+    // 宿主 token + 中性回退值(回退值本身也在本白名单的色相自检覆盖内)
+    'var(--surface, #fff)',
+    'var(--border-default, #e4e4e0)',
+    'var(--accent-cta-bg-pure, #111111)',
+    'var(--accent-pure-cta-fg, #ffffff)',
+  ])
+  /** 卡片 CSS 里允许出现的属性名。新增属性必须来这里登记 —— 免得颜色藏在没人扫的属性里
+   *  (box-shadow / outline / fill / stroke / background-image 的渐变都能带颜色)。 */
+  const ALLOWED_PROPS = new Set([
+    'align-items', 'animation', 'background', 'border', 'border-color', 'border-radius',
+    'border-right-color', 'box-sizing', 'color', 'cursor', 'display', 'flex', 'font-family',
+    'font-size', 'font-weight', 'gap', 'height', 'justify-content', 'line-height', 'margin',
+    'text-decoration',
+    'margin-top', 'min-width', 'opacity', 'outline', 'padding', 'transform', 'white-space', 'width',
+  ])
+  /** 带颜色的属性:它们的值要逐个 token 过颜色白名单。 */
+  const COLOR_PROPS = new Set(['background', 'border', 'border-color', 'border-right-color', 'color', 'outline'])
+
+  /** 从 settings.html 抽出全部声明(全部 <style> 块 + 全部行内 style 属性)。 */
+  const declarations = (): Array<{ prop: string; value: string }> => {
+    const css = [...HTML.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/g)].map((m) => m[1]).join('\n')
+    const inline = [...HTML.matchAll(/\sstyle="([^"]*)"/g)].map((m) => m[1]).join(';')
+    // 只扫**大括号内部**(最内层块体)+ 行内属性 —— 否则 `.key-input:disabled` 这类伪类选择器
+    // 会被当成 `prop: value` 混进来。@keyframes / @media 的头不是块体,自动被排除,而它们
+    // 内部的声明照旧收得到(最内层块)。
+    const bodies = [...css.replace(/\/\*[\s\S]*?\*\//g, '').matchAll(/\{([^{}]*)\}/g)].map((m) => m[1])
+    const body = bodies.join(';') + ';' + inline
+    const out: Array<{ prop: string; value: string }> = []
+    for (const m of body.matchAll(/([a-zA-Z-]+)\s*:\s*([^;{}]+)/g)) {
+      const prop = m[1].trim().toLowerCase()
+      const value = m[2].trim()
+      if (!value) continue
+      out.push({ prop, value })
+    }
+    return out
+  }
+
+  it('抽取有效(非空、覆盖到已知的行内声明与第二类块)', () => {
+    const decls = declarations()
+    expect(decls.length).toBeGreaterThan(30) // 抽空了就别静默通过
+    expect(decls.some((d) => d.prop === 'margin' && d.value === '0')).toBe(true) // body 的行内 style
+    expect(decls.some((d) => d.prop === 'transform')).toBe(true) // @keyframes 内部的声明也进来了
+  })
+
+  it('每个属性名都在白名单里(新属性必须登记,免得颜色藏在没人扫的属性里)', () => {
+    const unknown = [...new Set(declarations().map((d) => d.prop))].filter((p) => !ALLOWED_PROPS.has(p))
+    expect(unknown).toEqual([])
+  })
+
+  it('卡片不得自己定义 CSS 自定义属性(只消费宿主 token,不改写)', () => {
+    // 第 3 轮审查的实测探针:在 `<body style="… --border-default: rgb(65 124 221)">` 上重定义
+    // 宿主 token,输入框与「断开」按钮就真渲染成 Focus Blue,而颜色白名单看的是 `var(...)`
+    // 整体、看不见被改掉的值。本卡片从来只**读** token(带中性回退值),一处也不定义,
+    // 所以这条直接禁掉定义 —— 比去追每个 var 的实际取值简单也更严。
+    const defined = declarations().filter((d) => d.prop.startsWith('--'))
+    expect(defined.map((d) => d.prop + ': ' + d.value)).toEqual([])
+  })
+
+  it('每个颜色 token 都在白名单里(任何未登记写法一律红,不论语法)', () => {
+    const offenders: string[] = []
+    for (const { prop, value } of declarations()) {
+      if (!COLOR_PROPS.has(prop)) continue
+      // 复合值(如 `1px solid currentColor`)按 token 切;`var(...)`/`rgba(...)` 整体保留。
+      for (const token of value.match(/(?:var|rgba?|hsla?|oklch|lab|lch|color-mix)\([^)]*\)|[^\s]+/g) ?? []) {
+        if (/^[\d.]+(px|em|rem|%)?$/.test(token)) continue // 宽度
+        if (['solid', 'dashed', 'dotted', 'none', '0'].includes(token)) continue // 线型
+        if (!ALLOWED_COLORS.has(token)) offenders.push(prop + ': ' + token)
+      }
+    }
+    expect(offenders).toEqual([])
+  })
+
+  it('白名单自身零蓝紫(色相 190°–290° 且饱和度 >0.12 即违规;含 var() 的回退值)', () => {
+    const hueOf = (r: number, g: number, b: number) => {
+      const [rr, gg, bb] = [r / 255, g / 255, b / 255]
+      const max = Math.max(rr, gg, bb)
+      const min = Math.min(rr, gg, bb)
+      if (max === min) return null
+      const d = max - min
+      let h = max === rr ? ((gg - bb) / d) % 6 : max === gg ? (bb - rr) / d + 2 : (rr - gg) / d + 4
+      h *= 60
+      return h < 0 ? h + 360 : h
+    }
+    const isBlueViolet = (h: number | null, sat: number) => h !== null && sat > 0.12 && h >= 190 && h <= 290
+    const check = (r: number, g: number, b: number, label: string) => {
+      const max = Math.max(r, g, b) / 255
+      const min = Math.min(r, g, b) / 255
+      const sat = max === 0 ? 0 : (max - min) / max
+      if (isBlueViolet(hueOf(r, g, b), sat)) return label
+      return null
+    }
+    const bad: string[] = []
+    for (const token of ALLOWED_COLORS) {
+      for (const m of token.matchAll(/#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})\b/g)) {
+        const hex = m[1].length === 3 ? m[1].replace(/./g, (c) => c + c) : m[1]
+        const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16))
+        const hit = check(r, g, b, token)
+        if (hit) bad.push(hit)
+      }
+      for (const m of token.matchAll(/rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)/g)) {
+        const hit = check(Number(m[1]), Number(m[2]), Number(m[3]), token)
+        if (hit) bad.push(hit)
+      }
+    }
+    expect(bad).toEqual([])
+    // 自检:探测器认得出 violet 与 Focus Blue(否则上面那条是恒真的)
+    for (const hex of ['#6957e8', '#417CDD']) {
+      const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16))
+      expect(check(r, g, b, hex)).toBe(hex)
+    }
+  })
+})
