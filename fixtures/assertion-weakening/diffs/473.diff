@@ -0,0 +1,52 @@
+/**
+ * 宿主 manifest 硬限守卫(#297,2026-08-04 事故驱动新增)。
+ *
+ * **为什么必须有这道门**:宿主装入时会校验 `tools[].description` 必须是 1–1024
+ * 字符的非空字符串,不过就整包拒装(`MANIFEST_INVALID`)。本仓此前**没有任何断言
+ * 检查这个长度**——于是出现过最恶劣的失败形状:**22 道 CI 全绿、插件却装不进去**。
+ *
+ * 实际事故:#297 两条列车(T2「选中可见」/ T3「看图」)原本是两条独立栈,各自的
+ * `canvas_snapshot.description` 分别 454 / 890 字符都在限内;线性化成一条链后两套
+ * 说明必须**并集**,合成后 1176 字符 —— 越限。合成时没人量长度,直到真机打包被宿主
+ * 拒了才暴露。这条测试就是把「宿主会拒」提前到 CI。
+ *
+ * 判据取宿主口径,不取"我们觉得够用"的宽松值:非空、≤1024。
+ */
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+
+/** 宿主装入校验的硬上限(见 ghost_forge_pack 的 MANIFEST_INVALID 文案)。 */
+const DESCRIPTION_MAX = 1024
+
+type Manifest = {
+  tools?: Array<{ name?: unknown; description?: unknown }>
+}
+
+const manifest = (): Manifest =>
+  JSON.parse(readFileSync(join(__dirname, '../../ghost.json'), 'utf8')) as Manifest
+
+describe('ghost.json 宿主 manifest 硬限', () => {
+  it('每个 tools[].description 都是 1–1024 字符的非空字符串(超限则宿主整包拒装)', () => {
+    const tools = manifest().tools
+    expect(Array.isArray(tools)).toBe(true)
+    expect(tools!.length).toBeGreaterThan(0)
+
+    // 逐个报名字与实测长度:越限时错误信息要能直接指出改哪一个,不能只说"有一个超了"。
+    const measured = tools!.map((tool) => ({
+      name: typeof tool.name === 'string' ? tool.name : '(name 非字符串)',
+      length: typeof tool.description === 'string' ? tool.description.length : -1,
+    }))
+    const bad = measured.filter((m) => m.length < 1 || m.length > DESCRIPTION_MAX)
+    expect(
+      bad,
+      `越限项(上限 ${DESCRIPTION_MAX}):${bad.map((m) => `${m.name}=${m.length}`).join(', ')}`,
+    ).toEqual([])
+  })
+
+  it('tools[].name 全部非空且互不重复', () => {
+    const names = (manifest().tools ?? []).map((tool) => tool.name)
+    expect(names.every((n) => typeof n === 'string' && n.length > 0)).toBe(true)
+    expect(new Set(names as string[]).size).toBe(names.length)
+  })
+})
