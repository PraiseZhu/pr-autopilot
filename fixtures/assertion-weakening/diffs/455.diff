@@ -0,0 +1,112 @@
+/**
+ * imageRef 的 hash 形状门(r2-vision 二轮审 BLOCKER 2 返修)。
+ *
+ * 被修的缺陷:`buildImageRef` 只校验 ext、**hash 原样插值**,而从来没有生产 callsite 的
+ * `deriveMediaFilePath` 反倒校验了 hash —— 走生产的那个不校验,不走生产的那个校验,正好
+ * 反了。存量账本是不可信输入(`depositMigration.ts` 原先只校验「非空字符串」),一个
+ * `{hash:'../../sensitive', ext:'.png'}` 就能产出 `cindy-media://blobs/../../sensitive.png`
+ * 并被 `agentBridge.ts:214` 的 else 分支之外标成 `available`;ghost 又教外部 agent 把 hash
+ * 原样代入落盘路径,于是 agent 的 Read 目标可能逃出 blobs 分片目录。
+ *
+ * ── 本文件证明什么、不证明什么(诚实边界)──
+ *
+ * r2-vision 要求的是 `recordMigration`→snapshot 端到端用例。本文件**没有**重建那套端到端
+ * 台子(真实 depositPort + 真实 main.js + 假宿主,见 agentBridgeMediaResolve.test.ts 的
+ * harness),而是用「单元断言 + 结构充分性断言」组合替代:
+ *
+ *   1. 单元层:非法 hash 一律拿不到 imageRef(`buildImageRef` 返 null);
+ *   2. 结构层:断言 `buildImageRef` 是 `cindy-media://blobs/` 在生产代码里的**唯一**构造
+ *      点 —— 这一条是让第 1 条从「必要」升级为「充分」的关键。少了它,第 1 条只能证明
+ *      「这个函数不产出非法引用」,证明不了「生产不会从别处产出非法引用」。
+ *   3. 迁移层:非法 hash 的存量条目不进 depositMap(纵深防御,不是主防线)。
+ *
+ * 这个替代是有代价的:它不覆盖「桥层拿到 null 之后是否真的落 unavailable/unknown」这一
+ * 跳 —— 那一跳由 agentBridgeMediaResolve.test.ts 已有的非法 ext 用例覆盖(同一 else
+ * 分支,与 hash 合法性无关)。如果将来那个 else 分支被改动,本文件抓不到。
+ */
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+
+import { buildImageRef, deriveMediaFilePath, normalizeImageRefHash } from '../agent/mediaRefFormat'
+
+const MEDIA_REF_FORMAT_PATH = fileURLToPath(new URL('../agent/mediaRefFormat.ts', import.meta.url))
+const AGENT_BRIDGE_PATH = fileURLToPath(new URL('../agent/agentBridge.ts', import.meta.url))
+
+/**
+ * 剥掉块注释与行注释,只留可执行代码。
+ *
+ * `//` 的行注释规则必须排除 `://` —— 否则 `cindy-media://blobs/...` 这个模板字面量本身
+ * 会被当成行注释起点整行删掉,断言就永远数到 0 个构造点而"全绿"。我写这条断言时正好
+ * 踩了一次:这类文本扫描的脆性,与本轮 r2-vision 抓的文本门假绿是同一个根因。
+ */
+const stripComments = (source: string): string =>
+  source.replace(/\/\*[\s\S]*?\*\//g, '').replace(/(^|[^:])\/\/.*$/gm, '$1')
+
+/** 32 位合法 hex(小写),以及它的大写形态——T0 契约要求两者都原样保留。 */
+const LOWER_HASH = 'ab'.repeat(16)
+const UPPER_HASH = LOWER_HASH.toUpperCase()
+
+const ILLEGAL_HASHES: Array<[string, unknown]> = [
+  ['路径上级引用(本次 BLOCKER 的原型)', '../../sensitive'],
+  ['含正斜杠', 'abcdef0123456789/etc/passwd'],
+  ['含反斜杠', 'abcdef0123456789\\windows'],
+  ['非 hex 字符', 'zzzzzzzzzzzzzzzz'],
+  ['15 位(短于下界 16)', 'a'.repeat(15)],
+  ['129 位(长于上界 128)', 'a'.repeat(129)],
+  ['空字符串', ''],
+  ['非字符串 · null', null],
+  ['非字符串 · 数字', 12345],
+  ['非字符串 · 对象', { hash: LOWER_HASH }],
+]
+
+describe('BLOCKER 2 · hash 形状门:非法 hash 一律拿不到 imageRef', () => {
+  it.each(ILLEGAL_HASHES)('buildImageRef 拒绝非法 hash(%s)', (_label, badHash) => {
+    // 关键:ext 是完全合法的 —— 证明拒绝来自 hash 校验本身,不是被 ext 门顺手挡住的。
+    expect(buildImageRef(badHash, '.png')).toBeNull()
+  })
+
+  it.each(ILLEGAL_HASHES)('deriveMediaFilePath 同样拒绝(两个入口复用同一套判据)', (_label, badHash) => {
+    const result = deriveMediaFilePath(badHash, '.png', '/root')
+    expect(result.ok).toBe(false)
+  })
+
+  it('合法 hex 原样保留大小写(T0 契约:不做大小写转换或格式再加工)', () => {
+    expect(buildImageRef(LOWER_HASH, '.png')).toBe(`cindy-media://blobs/${LOWER_HASH}.png`)
+    expect(buildImageRef(UPPER_HASH, '.png')).toBe(`cindy-media://blobs/${UPPER_HASH}.png`)
+    // 大小写混合也原样 —— 不归一成任何一侧。
+    const mixed = `${UPPER_HASH.slice(0, 8)}${LOWER_HASH.slice(8)}`
+    expect(buildImageRef(mixed, '.png')).toBe(`cindy-media://blobs/${mixed}.png`)
+  })
+
+  it('legacy 无点 ext 仍按既有约定补点(hash 门不得回归 ext 的既有行为)', () => {
+    expect(buildImageRef(LOWER_HASH, 'png')).toBe(`cindy-media://blobs/${LOWER_HASH}.png`)
+  })
+
+  it('normalizeImageRefHash 的 reason 说清了判据,不是空话', () => {
+    const bad = normalizeImageRefHash('../../sensitive')
+    expect(bad.ok).toBe(false)
+    if (!bad.ok) expect(bad.reason).toContain('16-128 位 hex')
+  })
+})
+
+describe('BLOCKER 2 · 结构充分性:buildImageRef 是唯一生产构造点', () => {
+  it('生产代码里 `cindy-media://blobs/` 的字符串拼接只出现在 buildImageRef 内', () => {
+    const source = readFileSync(MEDIA_REF_FORMAT_PATH, 'utf8')
+    // 去掉块注释与行注释,只看可执行代码 —— 注释里为了讲清缺陷会引用该前缀(本文件头部
+    // 与 mediaRefFormat.ts 头部都有),不能把注释当构造点。
+    const code = stripComments(source)
+    const hits = code.match(/cindy-media:\/\/blobs\//g) ?? []
+    expect(hits).toHaveLength(1)
+    // 且这一处必须落在 buildImageRef 的函数体里(用 hashResult.hash 而非裸 hash 插值,
+    // 即「已过校验的值」才允许进模板)。
+    expect(code).toContain('`cindy-media://blobs/${hashResult.hash}${extResult.ext}`')
+  })
+
+  it('agentBridge.ts 构造 available 引用时只经 buildImageRef,不自行拼前缀', () => {
+    const source = readFileSync(AGENT_BRIDGE_PATH, 'utf8')
+    const code = stripComments(source)
+    expect(code).toContain('buildImageRef(entry.hash, entry.ext)')
+    expect(code).not.toMatch(/cindy-media:\/\/blobs\//)
+  })
+})
