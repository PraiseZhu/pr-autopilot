+const HASH_RE = /^[a-f0-9]{16,128}$/i
+
+export type ImageRefHashResult = { ok: true; hash: string } | { ok: false; reason: string }
+
+/**
+ * hash 形状校验的唯一入口(与 `normalizeImageRefExt` 同级)。
+ *
+ * 为什么必须与 ext 同级(r2-vision 二轮审 BLOCKER 2):此前只有 ext 走校验,hash 在
+ * `buildImageRef` 里**原样插值**,而 `deriveMediaFilePath` 反倒校验了 hash——**走生产的
+ * 那个不校验,不走生产的那个校验,正好反了**。存量账本是不可信输入(`depositMigration.ts`
+ * 只校验 `typeof hash === 'string' && hash`),一个 `{hash:'../../sensitive'}` 就能产出
+ * `cindy-media://blobs/../../sensitive.png` 并被标成 `available`;ghost 又教外部 agent 把
+ * hash 原样代入落盘路径,于是 Read 目标可能逃出 blobs 分片目录。
+ *
+ * 教训记在这里:上一版把「路径形状」只想成了 ext 的问题(见 `normalizeImageRefExt` 里
+ * 对 `/`、`\`、`..` 的拦截),却漏了同一条路径里的另一个插值点。**同一个模板里的每个
