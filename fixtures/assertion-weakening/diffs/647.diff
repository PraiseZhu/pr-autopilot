+    expect(hasIntent(editIntents, 'type')).toBe(true)
+    expect(hasIntent(editIntents, 'aiWorkflow', 'batchId')).toBe(false)
+    // create 先于 replace 的顺序保证(同队列串行)
+    const createIdx = submitChange.mock.calls.findIndex(
+      (c) => (c[1] as { kind: string }).kind === 'create-node',
