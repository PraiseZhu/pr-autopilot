--- /dev/null
+++ b/src/store/derivedBatchCoordinator.ts
@@ -0,0 +1,200 @@
+// #297 编辑占位批次协调器(从 generationSlice 拆出的纯重构,行为零变化)。
+// 批次身份 = 显式凭证 batchId+expectedCount+ordinal;ordinal 按 batchId+ordinal 从文档查找,不推断。
+import type { StoreApi } from 'zustand'
+import { LocalizedKeyError } from '../lib/localizedKeyError'
+import type { AiWorkflowStatus, CanvasId, MivoCanvasNode } from '../types/mivoCanvas'
+import type { CanvasState } from './canvasStore'
+import { assertBatchTriplet } from './canvasStateTypes'
+import { AI_SLOT_GAP, centeredColumnPlacements } from './aiCanvasWorkflow'
+import { debugLogger } from './debugLogStore'
+import { makeNode } from './demoScenes'
+import { nodePrompt, normalizeCanvasNodes, patchCanvasDocument } from './canvasDocumentModel'
+import { createNodeId } from './nodeFactory'
+import { getSceneWrap } from '../lib/sceneWrapRegistry'
+
+/** 批次 slot 生成时用的模型(与 generationSlice 内单次生成同值)。 */
+const defaultMivoImageModel = 'gpt-image-2'
+
+/** 按持久化批次凭证找预建 slot(找不到返回 undefined → 调用方 fail-visible)。 */
+export const findBatchSlot = (doc: { nodes: MivoCanvasNode[] }, batchId: string, ordinal: number) =>
+  doc.nodes.find(
+    (node) =>
+      node.type === 'ai-slot' &&
+      !node.hidden &&
+      node.aiWorkflow?.batchId === batchId &&
+      node.aiWorkflow?.ordinal === ordinal,
+  )
+
+/** 把批次 slot 收敛为终态(failed/canceled):原位保留、清进度字段;
+ *  sourceDeleted 时同批仍 generating 的 slot 一并转 failed(SC13)。 */
+export const settleBatchSlotState = (
+  current: CanvasState,
+  targetSceneId: CanvasId,
+  options: {
+    slotId: string
+    batchId: string
+    status: 'failed' | 'canceled'
+    settleWholeBatch: boolean
+  },
+) => {
+  const targetDocument = current.canvases[targetSceneId]
+  if (!targetDocument) return {}
+  const nodes = targetDocument.nodes.map((node) => {
+    if (node.type !== 'ai-slot' || !node.aiWorkflow) return node
+    const inBatch = node.aiWorkflow.batchId === options.batchId
+    const isTarget = node.id === options.slotId
+    const stillGenerating =
+      node.status === 'generating' || node.aiWorkflow.status === 'generating' || node.aiWorkflow.status === 'queued'
+    const shouldSettle = isTarget || (options.settleWholeBatch && inBatch && stillGenerating)
+    if (!shouldSettle) return node
+    return {
+      ...node,
+      status: 'failed' as const,
+      aiWorkflow: {
+        ...node.aiWorkflow,
+        status: (isTarget ? options.status : 'failed') as AiWorkflowStatus,
+        progress: undefined,
+        stage: undefined,
+        startedAt: undefined,
+      },
+    }
+  })
+  return patchCanvasDocument(current, targetSceneId, { nodes })
+}
+
+/**
+ * 批次三元组校验 + ordinal 绑定 slot 的共用入口(generateImageEdit 与
+ * generateBesideNode 同一套 fail-closed 契约):要么齐全、要么全缺(单次 count=1),
+ * 部分缺失 fail-closed 并留痕;缺员 fail-visible(缺员不静默降级成单次生成)。
+ * 返回绑定到的预建 slot(单次路径 undefined)。
+ */
+export const bindBatchOrdinal = (
+  document: { nodes: MivoCanvasNode[] },
+  triplet: { derivedBatchId?: string; expectedCount?: number; ordinal?: number },
+): MivoCanvasNode | undefined => {
+  try {
+    assertBatchTriplet(triplet)
+  } catch (error) {
+    // fail-closed 拒绝也要留痕(否则「批次三元组部分缺失」在 Debug Log 里查不到根因)。
+    debugLogger.error(
+      'Derived Batch',
+      `批次三元组校验失败(derivedBatchId=${triplet.derivedBatchId},expectedCount=${triplet.expectedCount},ordinal=${triplet.ordinal}):${error instanceof Error ? error.message : String(error)}`,
+    )
+    throw error
+  }
+  const batchSlot =
+    triplet.derivedBatchId !== undefined
+      ? findBatchSlot(document, triplet.derivedBatchId, triplet.ordinal as number)
+      : undefined
+  // ordinal 精确绑定预建 slot;缺失 fail-visible(缺员不静默降级成单次生成)。
+  if (triplet.derivedBatchId !== undefined && !batchSlot) {
+    debugLogger.error(
+      'Derived Batch',
+      `批次 ${triplet.derivedBatchId} 的 ordinal ${triplet.ordinal} 没有预建 slot(先调用 startDerivedImageBatch)`,
+    )
+    throw new Error(
+      `批次 ${triplet.derivedBatchId} 的 ordinal ${triplet.ordinal} 没有预建 slot(先调用 startDerivedImageBatch)`,
+    )
+  }
+  if (batchSlot) {
+    debugLogger.log('Derived Batch', `ordinal ${triplet.ordinal} 绑定 slot ${batchSlot.id}(batchId=${triplet.derivedBatchId})`)
+  }
+  return batchSlot
+}
+
+export type DerivedBatchStartParams = {
+  sceneId?: CanvasId
+  sourceNodeId: string
+  batchId: string
+  expectedCount: number
+}
+
+/** startDerivedImageBatch action 的实现体(slice 只留委托行;set/get 参数化,行为不变)。 */
+export const startDerivedImageBatchImpl = (
+  set: StoreApi<CanvasState>['setState'],
+  get: StoreApi<CanvasState>['getState'],
+  params: DerivedBatchStartParams,
+): string[] => {
+  const targetSceneId = params.sceneId || get().sceneId
+  const state = get()
+  const document = state.canvases[targetSceneId]
+  if (!document) throw new LocalizedKeyError('chat.commit.canvasDeleted')
+  if (!params.batchId) throw new Error('批次必须携带非空 batchId')
+  if (!Number.isInteger(params.expectedCount) || params.expectedCount < 1 || params.expectedCount > 4) {
+    throw new Error(`批次 expectedCount 必须在 1-4 之间,收到 ${params.expectedCount}`)
+  }
+  const source = document.nodes.find(
+    (node) => node.id === params.sourceNodeId && node.type === 'image' && !node.hidden,
+  )
+  if (!source) throw new LocalizedKeyError('chat.commit.sourceDeleted')
+
+  const createdAt = Date.now()
+  const sourcePrompt = nodePrompt(source) || '基于当前参考图继续发散'
+  // #297:占位尺寸取源图尺寸,不走 defaultSizeForNodeType('ai-slot') 的 320×320。
+  const slotWidth = Math.round(source.width)
+  const slotHeight = Math.round(source.height)
+  // SC11:同批全部 slot 在预建时按 expectedCount 一次定位(列左缘固定、整列垂直居中)。
+  const placements = centeredColumnPlacements({
+    anchor: source,
+    count: params.expectedCount,
+    gap: AI_SLOT_GAP,
+    widths: Array.from({ length: params.expectedCount }, () => slotWidth),
+  })
+  const slots = placements.map((placement, ordinal) => {
+    const id = createNodeId('ai-slot')
+    return makeNode({
+      id,
+      type: 'ai-slot',
+      title: `编辑占位 ${ordinal + 1}/${params.expectedCount}`,
+      x: Math.round(placement.x),
+      y: Math.round(placement.y),
+      width: Math.round(placement.width),
+      height: Math.round(placement.height),
+      status: 'generating',
+      // SC14:批次 slot 锁定,UI 不允许移动/缩放/删除单个运行中 slot。
+      locked: true,
+      generation: {
+        prompt: sourcePrompt,
+        model: defaultMivoImageModel,
+        size: `${slotWidth}x${slotHeight}`,
+        taskId: `batch-${params.batchId}-${ordinal}`,
+        createdAt,
+      },
+      aiWorkflow: {
+        kind: 'slot',
+        status: 'generating',
+        operation: 'area-edit',
+        prompt: sourcePrompt,
+        sourceNodeIds: [source.id],
+        placement: 'right',
+        createdAt,
+        // SC9:批次身份凭证持久化到 slot(batchId 来自创建凭证,不从位置/标题/reqId 推断)。
+        batchId: params.batchId,
+        expectedCount: params.expectedCount,
+        ordinal,
+      },
+    })
+  })
+
+  // SC5:预建前活跃场景只 captureHistory 一次(占位/状态/替换不追加 history)。
+  if (targetSceneId === state.sceneId) {
+    get().captureHistory()
+  }
+  // SC8:预建全部 slot + 初始 generating 作为一次 scene-scoped mutation 提交,后续
+  // ordinal 的状态/替换/收敛沿同一 canvas 队列串行提交。
+  getSceneWrap()(targetSceneId, () => set((current) => {
+    const targetDocument = current.canvases[targetSceneId]
+    if (!targetDocument) return {}
+    return patchCanvasDocument(
+      current,
+      targetSceneId,
+      { nodes: normalizeCanvasNodes([...targetDocument.nodes, ...slots]) },
+      { history: false },
+    )
+  }))
+  debugLogger.log(
+    'Derived Batch',
+    `预建 ${params.expectedCount} 个编辑占位(batchId=${params.batchId},source=${source.id})`,
+  )
+  return slots.map((slot) => slot.id)
+}
