+    let maxConcurrent = 0
+    handle = await loadRuntimeModule({
+      local: false,
+      submitChangeImpl: async (canvasId, change) => {
+        void canvasId
+        if (change.kind === 'edit-node') {
+          inFlight += 1
+          maxConcurrent = Math.max(maxConcurrent, inFlight)
+          await new Promise((resolve) => setTimeout(resolve, 20))
+          inFlight -= 1
+        }
+        return { kind: 'accepted', cursor: 'cursor' as never }
+      },
+    })
+    useCanvasStore = handle.useCanvasStore
+    submitChange = handle.submitChange
+    resetQueue = handle.__resetCanvasSyncRuntimeQueue
+    baseState = useCanvasStore.getInitialState()
+
+    seed(seedCanvas(SCENE, [imageNode({ id: 'n1' })]))
+    const slotIds = useCanvasStore.getState().startDerivedImageBatch({
+      sceneId: SCENE,
+      sourceNodeId: 'n1',
+      batchId: 'batch-probe',
+      expectedCount: 2,
+    })
+    await flushSubmit()
+    submitChange.mockClear()
+
+    const p0 = useCanvasStore.getState().generateImageEdit('n1', 'prompt-edit', 'a cat', {
+      sceneId: SCENE,
+      derivedBatchId: 'batch-probe',
+      expectedCount: 2,
+      ordinal: 0,
+    })
+    const p1 = useCanvasStore.getState().generateImageEdit('n1', 'prompt-edit', 'a dog', {
+      sceneId: SCENE,
+      derivedBatchId: 'batch-probe',
+      expectedCount: 2,
+      ordinal: 1,
+    })
+    await Promise.all([p0, p1])
+    await new Promise((resolve) => setTimeout(resolve, 60))
+
+    const editNodeCalls = submitChange.mock.calls.filter((c) => (c[1] as { kind: string }).kind === 'edit-node')
