diff --git a/scripts/ci/e2e-wait-guard.mjs b/scripts/ci/e2e-wait-guard.mjs
new file mode 100644
index 00000000..4253183e
--- /dev/null
+++ b/scripts/ci/e2e-wait-guard.mjs
@@ -0,0 +1,155 @@
+#!/usr/bin/env node
+// e2e-wait-guard.mjs — `page.waitForFunction` 谓词返回 Promise 的静默失效守卫(守卫家族)。
+//
+// 为什么存在(2026-08-04):Playwright 的 `waitForFunction` **不 await** 谓词的返回值,
+// 它只判返回值的真假。async 谓词返回的是一个 Promise 对象 —— Promise 恒 truthy ——
+// 于是**第一次轮询就判真**,这个"等待"根本没在等。实测(chromium,timeout 1500ms):
+//   () => false                  → TimeoutError after 1505ms   ← 正常
+//   async () => false            → RESOLVED after 1ms          ← 静默失效
+//   () => Promise.resolve(false) → RESOLVED after 2ms          ← 静默失效
+// 落地当轮全仓有 19 处这种写法(scripts/e2e/ 下 7 个文件),其中 renderer-evidence.mjs
+// 的 waitForNodeRendered 是几乎所有场景共用的核心等待。表现是"看着在等其实没等":
+// 断言跑在状态未就绪的时刻,失败点漂到下游、报出与真实原因无关的错(#469 实测:残留
+// markup 节点 intercepts pointer events,却在 30s 后报成"点不到图片")。
+//
+// 正确写法:改用 `waitForAsyncPredicate`(scripts/e2e/wait-async-predicate.mjs)——
+// 它用 `page.evaluate` 轮询,而 `page.evaluate` **会** await 谓词返回的 Promise。
+// 谓词函数体一个字都不用改,只换调用壳。
+//
+// 威胁模型(不许超卖):本守卫按 AST 抓两类**字面可判**的形态 ——
+//   1. 谓词是 async 函数/箭头(`async () => …`、`async function () {}`);
+//   2. 谓词是非 async 箭头,但简洁体直接是 `Promise.…` / `new Promise(…)`,或简洁体是 `.then(` 链。
+// 它**不防**:谓词以标识符传入(`waitForFunction(myPred, …)`,需类型推导)、运行时
+// 拼装的函数、以及谓词内部同步返回一个来自别处的 Promise 变量。那几类要靠 review。
+// 反过来也不误报:sync 谓词内部出现 `await`(词法扫描会误判)在 AST 下天然不命中。
+//
+// 扫描范围:git tracked 的 .mjs / .js / .ts / .tsx,减去 EXCLUDES(每条带理由)。
+// 排除制而非白名单制 —— 新增文件默认**在**守卫视野内。
+//
+// 退出码:0=干净;1=有违规(逐条 file:line + 修法);2=运行错误(git 不可用/解析失败)。
+import { execFileSync } from 'node:child_process'
+import { readFileSync } from 'node:fs'
+import { fileURLToPath } from 'node:url'
+import ts from 'typescript'
+
+/** 排除目录/文件(每条必须带理由;不加理由的排除会在 review 里被打回)。 */
+export const EXCLUDES = [
+  { prefix: 'node_modules/', why: '第三方依赖,不属本仓代码' },
+  { prefix: 'dist/', why: '构建产物' },
+  // 本守卫与其单测自身要把违规形态当 fixture 写出来,整体豁免。
+  { prefix: 'scripts/ci/e2e-wait-guard', why: '守卫自身与其单测的 fixture' },
+]
+
+const SCAN_EXT = new Set(['.mjs', '.js', '.ts', '.tsx'])
+
+export const isExcluded = (path) => EXCLUDES.some((e) => path.startsWith(e.prefix))
+
+/** 谓词节点是否"返回 Promise"(两类字面可判形态,见文件头威胁模型)。 */
+const promiseReturningReason = (node) => {
+  const isFn = ts.isArrowFunction(node) || ts.isFunctionExpression(node) || ts.isFunctionDeclaration(node)
+  if (!isFn) return null
+  const isAsync = node.modifiers?.some((m) => m.kind === ts.SyntaxKind.AsyncKeyword)
+  if (isAsync) return 'async 谓词返回 Promise(恒 truthy)'
+  // 非 async 箭头:简洁体直接是 Promise.… / new Promise(…),或简洁体是 .then( 链
+  // (new Promise 那半是 Greptile 云端审查补上的漏口:`() => new Promise(...)` 同样恒 truthy)
+  const body = node.body
+  if (!body) return null
+  const text = body.getText?.() ?? ''
+  if (/^\s*(?:new\s+)?Promise\s*(?:\.|\()/.test(text)) return '谓词返回 Promise(恒 truthy)'
+  if (/\.then\s*\(/.test(text) && !ts.isBlock(body)) return '谓词简洁体返回 .then(…) 链(恒 truthy)'
+  return null
+}
+
+/**
+ * 扫一份源码,返回违规列表。纯函数,便于单测直接喂 fixture。
+ * @returns {{path:string,line:number,reason:string}[]}
+ */
+/**
+ * 按扩展名选解析模式。**不能一律用 ScriptKind.JS**:守卫自己声明 .ts/.tsx 在视野内,而 JS
+ * 模式下 TS 的表达式泛型(`new Set<string>()`)会被判语法错误 —— 配上 fail-closed 的抛错,
+ * 就把「解析器用错了模式」升级成 exit 2。实测:全仓 775 个 tracked .ts/.tsx 里 234 个(30%)
+ * 在 JS 模式下抛解析失败;换成按扩展名选模式后归零。当下没红纯属侥幸(CLI 有
+ * `text.includes('waitForFunction')` 前置过滤,唯一命中的 src/main.tsx 恰好不含表达式泛型),
+ * 但本 PR 自己就往 scripts/e2e/ 放了个 .ts —— 下一次编辑就是雷区(第 2 轮审查 F5)。
+ */
+const scriptKindFor = (path) =>
+  path.endsWith('.tsx') ? ts.ScriptKind.TSX : path.endsWith('.ts') ? ts.ScriptKind.TS : ts.ScriptKind.JS
+
+export const checkSource = (path, text) => {
+  const violations = []
+  const sf = ts.createSourceFile(path, text, ts.ScriptTarget.Latest, true, scriptKindFor(path))
+  // fail-closed:ts.createSourceFile 对语法错误**不抛**,只把诊断挂在 parseDiagnostics 上。
+  // 不显式检查的话,一份语法坏掉的源码会被静默判成"0 违规"——而 .mjs 既不过 tsc
+  // (tsconfig.node.json 只 include vite 配置)也不过 eslint(files 只有 **/*.{ts,tsx}),
+  // 于是没有任何一道门会发现它坏了。守卫自己变成静默漏检,正是它要治的病(单席审查 F3)。
+  if (sf.parseDiagnostics?.length) {
+    const first = sf.parseDiagnostics[0]
+    const { line } = sf.getLineAndCharacterOfPosition(first.start ?? 0)
+    throw new Error(
+      `解析失败(语法错误,无法可靠判定):${path}:${line + 1} ${ts.flattenDiagnosticMessageText(first.messageText, ' ')}`,
+    )
+  }
+  const visit = (node) => {
+    if (
+      ts.isCallExpression(node) &&
+      ts.isPropertyAccessExpression(node.expression) &&
+      node.expression.name.text === 'waitForFunction' &&
+      node.arguments.length > 0
+    ) {
+      const reason = promiseReturningReason(node.arguments[0])
+      if (reason) {
+        const { line } = sf.getLineAndCharacterOfPosition(node.arguments[0].getStart(sf))
+        violations.push({ path, line: line + 1, reason })
+      }
+    }
+    ts.forEachChild(node, visit)
+  }
+  visit(sf)
+  return violations
+}
+
+// ── CLI ───────────────────────────────────────────────────────────────────
+const isMain = process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]
+if (isMain) {
+  let files
+  try {
+    files = execFileSync('git', ['ls-files', '-z'], { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 })
+      .split('\0')
+      .filter(Boolean)
+      .filter((p) => SCAN_EXT.has(p.slice(p.lastIndexOf('.'))) && !isExcluded(p))
+  } catch (err) {
+    console.error(`[e2e-wait-guard] 运行错误:git ls-files 失败 —— ${err.message}`)
+    process.exit(2)
+  }
+
+  const all = []
+  for (const path of files) {
+    let text
+    try {
+      text = readFileSync(path, 'utf8')
+    } catch (err) {
+      // fail-closed:读不到就是运行错误,不静默跳过(跳过等于给漏检发免罪符)
+      console.error(`[e2e-wait-guard] 运行错误:读取 ${path} 失败 —— ${err.message}`)
+      process.exit(2)
+    }
+    if (!text.includes('waitForFunction')) continue
+    try {
+      all.push(...checkSource(path, text))
+    } catch (err) {
+      console.error(`[e2e-wait-guard] 运行错误:解析 ${path} 失败 —— ${err.message}`)
+      process.exit(2)
+    }
+  }
+
+  if (all.length === 0) {
+    console.log(`[e2e-wait-guard] OK — ${files.length} 个文件扫描,0 处 waitForFunction 谓词返回 Promise`)
+    process.exit(0)
+  }
+  console.error(`[e2e-wait-guard] FAIL — ${all.length} 处 waitForFunction 谓词返回 Promise(等待静默失效):`)
+  for (const v of all) console.error(`  ${v.path}:${v.line}  ${v.reason}`)
+  console.error('')
+  console.error('  修法:改用 waitForAsyncPredicate(scripts/e2e/wait-async-predicate.mjs),')
+  console.error('       谓词函数体不用动 —— 它用 page.evaluate 轮询,evaluate 会 await 返回的 Promise。')
+  console.error('       如果谓词本来不需要 async,把 async 去掉即可(sync 谓词 waitForFunction 是正确的)。')
+  process.exit(1)
+}
diff --git a/scripts/ci/e2e-wait-guard.test.mjs b/scripts/ci/e2e-wait-guard.test.mjs
new file mode 100644
index 00000000..7d5cd7ae
--- /dev/null
+++ b/scripts/ci/e2e-wait-guard.test.mjs
@@ -0,0 +1,108 @@
+// e2e-wait-guard 守卫单测(vitest,随 test:unit / required gate 跑)。
+//
+// 覆盖:两类会命中的形态(async 谓词 / 返回 Promise 的简洁体)、不该误报的形态
+// (sync 谓词、谓词内部嵌套 async 回调)、以及**已声明不承诺**的盲区(标识符谓词、
+// block 体里 .then)——盲区用断言钉住,是为了让「以后有人扩大承诺」时必须同时改测试,
+// 而不是让盲区悄悄被当成"守住了"。
+// fixture 里的违规写法是被测样本,本文件与守卫本体在扫描中整体豁免(见 EXCLUDES)。
+import { describe, expect, it } from 'vitest'
+import { EXCLUDES, checkSource, isExcluded } from './e2e-wait-guard.mjs'
+
+const P = 'scripts/e2e/scenarios/fixture.mjs'
+
+describe('e2e-wait-guard', () => {
+  it('命中:async 箭头谓词', () => {
+    const v = checkSource(P, 'await page.waitForFunction(async (x) => x > 1, 2)')
+    expect(v).toHaveLength(1)
+    expect(v[0].reason).toContain('async 谓词')
+  })
+
+  it('命中:async function 表达式谓词', () => {
+    expect(checkSource(P, 'await page.waitForFunction(async function () { return true })')).toHaveLength(1)
+  })
+
+  it('命中:非 async 但简洁体直接返回 Promise', () => {
+    expect(checkSource(P, 'await page.waitForFunction(() => Promise.resolve(false))')).toHaveLength(1)
+    expect(checkSource(P, 'await page.waitForFunction(() => readIt().then((v) => v === 1))')).toHaveLength(1)
+    // new Promise(...) 简洁体同样恒 truthy(Greptile 云端审查补上的漏口)
+    expect(checkSource(P, 'await page.waitForFunction(() => new Promise((r) => setTimeout(r, 10)))')).toHaveLength(1)
+    expect(checkSource(P, 'await page.waitForFunction(() => Promise.all([a, b]))')).toHaveLength(1)
+  })
+
+  it('不误报:sync 谓词(waitForFunction 的正确用法)', () => {
+    expect(checkSource(P, 'await page.waitForFunction(() => document.title === "x")')).toHaveLength(0)
+    expect(checkSource(P, 'await page.waitForFunction(function () { return window.ready })')).toHaveLength(0)
+  })
+
+  it('不误报:sync 谓词内部嵌套 async 回调(词法扫描会误判,AST 不会)', () => {
+    const src = 'await page.waitForFunction(() => { register(async () => { await x() }); return window.done })'
+    expect(checkSource(P, src)).toHaveLength(0)
+  })
+
+  it('不误报:替代原语 waitForAsyncPredicate 的 async 谓词是正确用法', () => {
+    const src = 'await waitForAsyncPredicate(page, async (s) => (await load(s)).ok, spec, { label: "x" })'
+    expect(checkSource(P, src)).toHaveLength(0)
+  })
+
+  it('行号指向谓词所在行(多行调用形态)', () => {
+    const src = ['// head', 'await page.waitForFunction(', '  async ({ a }) => a,', '  { a: 1 },', ')'].join('\n')
+    const v = checkSource(P, src)
+    expect(v).toHaveLength(1)
+    expect(v[0].line).toBe(3)
+  })
+
+  it('一份源码里多处各自记账', () => {
+    const src = 'await page.waitForFunction(async () => 1)\nawait page.waitForFunction(async () => 2)\nawait page.waitForFunction(() => 3)'
+    expect(checkSource(P, src)).toHaveLength(2)
+  })
+
+  it('解析模式按扩展名选:.ts/.tsx 的表达式泛型不得被当成语法错误(fail-closed 不许假红)', () => {
+    // 第 2 轮审查 F5:守卫声明 .ts/.tsx 在视野内,但一律用 ScriptKind.JS 解析 —— JS 模式下
+    // `new Set<string>()` 是语法错误,配上 F3 的抛错就把「解析器用错模式」升级成 exit 2。
+    // 实测当时全仓 775 个 tracked .ts/.tsx 有 234 个(30%)会抛。对这一整类文件,守卫只能崩、
+    // 永远报不出违规 —— fail-open 换成了假红,同样是没守住。
+    const tsSrc = 'const s = new Set<string>()\nawait page.waitForFunction(async () => s.size > 0)\n'
+    expect(() => checkSource('scripts/e2e/helper.ts', tsSrc)).not.toThrow()
+    expect(checkSource('scripts/e2e/helper.ts', tsSrc)).toHaveLength(1)
+    const tsxSrc = 'const m = new Map<string, number>()\nconst El = () => <div>{m.size}</div>\nawait page.waitForFunction(async () => m.size > 0)\n'
+    expect(() => checkSource('src/a.tsx', tsxSrc)).not.toThrow()
+    expect(checkSource('src/a.tsx', tsxSrc)).toHaveLength(1)
+  })
+
+  it('fail-closed:源码语法坏掉时必须抛错(→CLI exit 2),不得静默判 0 违规', () => {
+    // ts.createSourceFile 对语法错误**不抛**,只挂 parseDiagnostics —— 不显式检查就会把
+    // 一份坏掉的源码判成"干净"。而 .mjs 既不过 tsc 也不过 eslint,没有第二道门兜着,
+    // 守卫自己就成了静默漏检(单席审查 F3)。这两种形态实测都会让后面真实的违规被吞掉。
+    for (const [name, src] of [
+      ['未闭合模板串', 'const a = `unclosed\nawait page.waitForFunction(async () => 1)\n'],
+      ['未闭合块注释', '/* unclosed\nawait page.waitForFunction(async () => 1)\n'],
+    ]) {
+      expect(() => checkSource(P, src), name).toThrow(/解析失败/)
+    }
+    // 反向对照:语法正确的源码不因本检查误抛
+    expect(() => checkSource(P, 'await page.waitForFunction(() => true)')).not.toThrow()
+  })
+
+  it('声明的盲区(不承诺拦):谓词以标识符传入 / block 体里 .then', () => {
+    // 需类型推导才知道 myPred 是不是 async —— 文件头威胁模型已声明不承诺
+    expect(checkSource(P, 'await page.waitForFunction(myPred, arg)')).toHaveLength(0)
+    // block 体:返回值可能是 sync 的,.then 只是副作用调用 —— 不做启发式猜测
+    expect(checkSource(P, 'await page.waitForFunction(() => { poll().then(noop); return window.ok })')).toHaveLength(0)
+  })
+
+  it('按方法名匹配:任何 receiver 的 .waitForFunction 都在视野内(frame/locator 亦然)', () => {
+    expect(checkSource(P, 'await frame.waitForFunction(async () => 1)')).toHaveLength(1)
+  })
+
+  it('排除清单:每条都带理由,且前缀匹配生效', () => {
+    expect(EXCLUDES.length).toBeGreaterThan(0)
+    for (const e of EXCLUDES) {
+      expect(typeof e.prefix).toBe('string')
+      expect(e.prefix.length).toBeGreaterThan(0)
+      expect(e.why, e.prefix).toBeTruthy()
+    }
+    expect(isExcluded('node_modules/pkg/a.mjs')).toBe(true)
+    expect(isExcluded('scripts/ci/e2e-wait-guard.test.mjs')).toBe(true)
+    expect(isExcluded('scripts/e2e/scenarios/mask.mjs')).toBe(false)
+  })
+})
