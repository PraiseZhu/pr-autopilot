index 00000000..d1b312ff
--- /dev/null
+++ b/scripts/e2e/wait-async-predicate.mjs
@@ -0,0 +1,120 @@
+// wait-async-predicate — 谓词需要 await 的等待原语。
+//
+// 为什么不能用 page.waitForFunction:它**不 await** 谓词的返回值,只判真假。async
+// 谓词返回的是 Promise 对象,而 Promise 恒 truthy —— 于是第一次轮询就判真,这个
+// "等待"根本没在等。实测(chromium,timeout 1500ms):
+//   () => false                  → TimeoutError after 1505ms   ← 正常
+//   async () => false            → RESOLVED after 1ms          ← 静默失效
+//   () => Promise.resolve(false) → RESOLVED after 2ms          ← 静默失效
+// 后果不是"等待变短"这么轻:断言会跑在状态未就绪的时刻,失败点漂到下游、报出与真实
+// 原因无关的错(#469 实测:残留 markup 节点 intercepts pointer events,却在 30s 后
+// 报成"点不到图片")。这类失效由 scripts/ci/e2e-wait-guard.mjs 机器拦截。
+//
+// 本原语改用 page.evaluate 轮询 —— evaluate **会** await 谓词返回的 Promise,所以
+// 谓词函数体一个字都不用改,只换调用壳。
+//
+// **超时是硬期限**:除了两次求值之间检查期限,单次 page.evaluate 本身也与剩余期限
+// race。这一条是返修补上的(2026-08-04 单席审查 F1):初版只在两次求值之间检查,而
+// page.evaluate 自己没有超时,于是「谓词里的 await 永不 settle」(dev 拓扑下 Vite 转换
+// 卡住 → `await import(moduleSpec)` 挂住;`await navigator.clipboard.readText()` 挂住;
+// 页面主线程被长任务冻结)会让整个等待挂死 —— 从「30s 带 label 的报错」退化成「CI 撞
+// job 级 timeout 被无诊断 kill」,恰恰是本原语要消灭的静默形态。
+//
+// 与 waitForFunction 的语义差异(调用方需知情;这份清单必须与实现同步,不许自称完整
+// 却漏项 —— 初版漏了第 4、5 条):
+//   1. 返回**序列化后的值**(evaluate 语义),不是 JSHandle;
+//   2. 超时抛的是带 label 与末次读数的普通 Error,不是 Playwright TimeoutError;
+//   3. 轮询由本进程驱动(默认 100ms),不是页面内 rAF —— 适合等 store/DOM 的稳定态,
+//      不适合逐帧采样;
+//   4. **导航会让它直接失败**:执行上下文被 page.goto/reload 销毁时 page.evaluate 直接
+//      reject("Execution context was destroyed"),而 waitForFunction 会在新上下文重试。
+//      所以不要把本原语紧跟在导航之后 —— 要等导航后的状态,先 waitForLoadState/
+//      waitForSelector 让上下文稳定,再用它;
+//   5. 超时放弃的那次 evaluate **仍可能在后台完成**:我们不再等它,但它稍后若失败会以
+//      `console.warn` 打出来(不吞 —— 那条迟到的错误可能正是最有指向性的一句),它对页面的
+//      副作用也不会被撤销,所以谓词应保持只读,不要在谓词里改 store;
+//   6. **timeout 必须为正数**:Playwright 的 `timeout: 0` 表示"禁用超时",本原语直接报错 ——
+//      无期限的等待正是它要消灭的东西。
+//
+// 谓词在页面上下文执行,与 evaluate 同规则:只能收可序列化参数(arg),不能闭包捕获
+// Node 侧变量。
+//
+// 契约由 wait-async-predicate.contract.test.ts 钉住(假 page,不启浏览器)。
+
+/** 单次求值超期的哨兵(不可能与谓词的真实返回值相等)。 */
+const EXPIRED = Symbol('wait-async-predicate:expired')
+
+export const waitForAsyncPredicate = async (
+  page,
+  predicate,
+  arg,
+  { timeout = 30000, interval = 100, label } = {},
+) => {
+  const what = label ?? '(未命名条件)'
+  // timeout<=0 直接报错,不沿用 Playwright「0 = 禁用超时」的语义:本原语存在的理由就是
+  // 「等待失败必须在硬期限内发生」,一个无期限的等待正是它要消灭的东西(第 2 轮审查带出的
+  // 语义差异,当前无调用方传 0)。也不静默当成「一次都不求值」——那是最难查的行为。
+  if (!(timeout > 0)) {
+    throw new Error(`waitForAsyncPredicate: timeout 必须为正数(收到 ${timeout});本原语不支持无期限等待`)
+  }
+  const deadline = Date.now() + timeout
+  let last
+  let everEvaluated = false
+
+  for (;;) {
+    const remaining = deadline - Date.now()
+    if (remaining <= 0) {
+      throw new Error(
+        everEvaluated
+          ? `waitForAsyncPredicate 超时(${timeout}ms):${what} —— 谓词末次返回 ${JSON.stringify(last)}`
+          : `waitForAsyncPredicate 超时(${timeout}ms):${what} —— 谓词一次都没求值完`,
+      )
+    }
+
+    // 谓词自身抛错不吞:让它原样冒出去(页面报错/模块 import 失败属真故障,不是"还没到")。
+    const pending = page.evaluate(predicate, arg)
+    let timer
+    let value
+    try {
+      value = await Promise.race([
+        pending,
+        new Promise((resolve) => {
+          timer = setTimeout(() => resolve(EXPIRED), remaining)
+        }),
+      ])
+    } finally {
+      // 必须放 finally:谓词 reject 时 await 直接抛,写在 await 之后的 clearTimeout 会被跳过,
+      // 那个定时器就一直挂着 —— 实测「谓词立即抛错 + timeout 30000」时错误 1ms 就抛出,但
+      // 进程要等满 30s 才退出。scenario 是 e2e-runner spawn 的子进程且 runner 没有 per-scenario
+      // timeout,于是每个走这条路径失败的场景都会在打印完错误后再挂满 timeout 才退,多个叠加
+      // 会把 job 推向 job 级 timeout —— 又是「撞 job timeout 被无诊断 kill」换了个形状。
+      // (第 2 轮审查 F4;谓词抛错正是最常见的失败路径,不是边角。)
+      clearTimeout(timer)
+    }
+
+    if (value === EXPIRED) {
+      // 放弃这次求值:它可能永远不 settle,也可能稍后才 reject。不能让它变成
+      // unhandledRejection 把整个 runner 带下去,但也不能把它**完全**丢掉 —— 迟到的那条
+      // 错误可能正是最有指向性的一句(例如导航场景的 "Execution context was destroyed",
+      // 见上方语义差异第 4 条)。所以降级成 warn 打出来,不吞。
+      void Promise.resolve(pending).catch((err) => {
+        console.warn(
+          `[waitForAsyncPredicate] 已放弃的求值稍后失败了(${what}):${err instanceof Error ? err.message : String(err)}`,
+        )
+      })
+      throw new Error(
+        `waitForAsyncPredicate 超时(${timeout}ms):${what} —— 单次 page.evaluate 未在期限内返回` +
+          `(页面卡死、或谓词里的 await 永不 settle;末次已知返回 ${JSON.stringify(last)})`,
+      )
+    }
+
+    everEvaluated = true
+    if (value) return value
+    last = value
+
+    const left = deadline - Date.now()
+    // 期限已到 → 回到循环开头统一抛超时,不在这里复写一份文案。
+    if (left <= 0) continue
+    await new Promise((resolve) => setTimeout(resolve, Math.min(interval, left)))
+  }
+}
