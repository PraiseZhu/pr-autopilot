diff --git a/scripts/e2e/wait-async-predicate.contract.test.ts b/scripts/e2e/wait-async-predicate.contract.test.ts
new file mode 100644
index 00000000..f2645ec0
--- /dev/null
+++ b/scripts/e2e/wait-async-predicate.contract.test.ts
@@ -0,0 +1,129 @@
+// scripts/e2e/wait-async-predicate.contract.test.ts
+// waitForAsyncPredicate 的诚实性契约测试(单席审查 F1 返修补上)。
+//
+// 为什么需要:本原语是 19 处等待的共同壳,其中 renderer-evidence 的 waitForNodeRendered
+// 被十几个场景共用。初版把「超时」只实现成两次求值之间的检查,而 page.evaluate 自己没有
+// 超时 —— 单次求值挂住(谓词里的 await 永不 settle、页面主线程冻结)就永远不返回,等待从
+// 「带 label 的报错」退化成「挂到 job 级 timeout 被无诊断 kill」。那正是本原语要消灭的
+// 静默形态,却在原语自己身上复现了一遍;没有契约测试是它能一路走到评审的直接原因。
+//
+// 锁住四条(不启真浏览器:假 page 即可 —— 本原语与浏览器的唯一接触面就是 page.evaluate):
+//   ① 谓词为真 → 返回**序列化后的值**(evaluate 语义,不是 JSHandle);
+//   ② 谓词恒假 → 在期限内抛错,消息带 label 与末次读数;
+//   ③ 谓词抛错 → 原样冒出去,不被当成"还没到"而继续轮询;
+//   ④ **单次 page.evaluate 永不 settle → 仍必须在期限内抛错**(硬期限;这条是 F1 本体)。
+import { describe, expect, it } from 'vitest'
+import { waitForAsyncPredicate } from './wait-async-predicate.mjs'
+
+type FakePage = { evaluate: (...args: unknown[]) => unknown; calls: number }
+
+/** 按调用次数给出返回值的假 page;values 用尽后重复最后一个。 */
+const pageReturning = (...values: unknown[]): FakePage => {
+  const page = {
+    calls: 0,
+    evaluate: async () => {
+      const v = values[Math.min(page.calls, values.length - 1)]
+      page.calls += 1
+      if (v instanceof Error) throw v
+      return v
+    },
+  }
+  return page as FakePage
+}
+
+describe('waitForAsyncPredicate 契约', () => {
+  it('① 谓词为真 → 返回该值本身(序列化语义)', async () => {
+    const page = pageReturning(false, false, { ok: 1 })
+    const got = await waitForAsyncPredicate(page as never, () => null, undefined, {
+      timeout: 2000,
+      interval: 1,
+      label: '测试:第三次才为真',
+    })
+    expect(got).toEqual({ ok: 1 })
+    expect(page.calls).toBe(3)
+  })
+
+  it('② 谓词恒假 → 期限内抛错,消息带 label 与末次读数', async () => {
+    const page = pageReturning(0)
+    const started = Date.now()
+    await expect(
+      waitForAsyncPredicate(page as never, () => null, undefined, {
+        timeout: 150,
+        interval: 10,
+        label: '测试:恒假',
+      }),
+    ).rejects.toThrow(/测试:恒假/)
+    expect(Date.now() - started).toBeLessThan(1500)
+    // 末次读数必须如实带出,否则超时信息退化成"不知道当时是什么"
+    const err = await waitForAsyncPredicate(page as never, () => null, undefined, {
+      timeout: 60,
+      interval: 10,
+      label: 'x',
+    }).catch((e: Error) => e)
+    expect((err as Error).message).toContain('谓词末次返回 0')
+  })
+
+  it('③ 谓词抛错 → 原样冒出,不被当成"还没到"继续轮询', async () => {
+    const boom = new Error('页面炸了:模块 import 失败')
+    const page = pageReturning(boom)
+    await expect(
+      waitForAsyncPredicate(page as never, () => null, undefined, { timeout: 5000, interval: 10, label: 'y' }),
+    ).rejects.toThrow('页面炸了:模块 import 失败')
+    // 只求值一次就冒出去,没有把真故障当"未就绪"反复重试到超时
+    expect(page.calls).toBe(1)
+  })
+
+  it('④ 单次 page.evaluate 永不 settle → 仍在期限内抛错(硬期限,F1 本体)', async () => {
+    // 反向变异检验点:把实现里 evaluate 与剩余期限的 race 去掉,本例必挂住 → 变红。
+    const page = { calls: 0, evaluate: () => new Promise(() => {}) } as unknown as FakePage
+    const started = Date.now()
+    const err = await waitForAsyncPredicate(page as never, () => null, undefined, {
+      timeout: 120,
+      interval: 10,
+      label: '测试:evaluate 挂住',
+    }).catch((e: Error) => e)
+    const elapsed = Date.now() - started
+    expect(err).toBeInstanceOf(Error)
+    expect((err as Error).message).toContain('单次 page.evaluate 未在期限内返回')
+    expect((err as Error).message).toContain('测试:evaluate 挂住')
+    expect(elapsed).toBeLessThan(1500)
+  })
+
+  it('⑤ 谓词抛错后不得残留定时器(否则进程要挂满 timeout 才退出)', async () => {
+    // 第 2 轮审查 F4:clearTimeout 原本写在 await 之后,谓词 reject 时被跳过 —— 实测错误 1ms
+    // 抛出、进程 30s 后才退。scenario 是 e2e-runner spawn 的子进程且 runner 无 per-scenario
+    // timeout,于是失败场景会在打印完错误后再挂满 timeout,多个叠加把 job 推向 job 级 timeout。
+    const before = process.getActiveResourcesInfo().filter((r) => r === 'Timeout').length
+    const page = { calls: 0, evaluate: async () => { throw new Error('页面炸了') } } as unknown as FakePage
+    await expect(
+      waitForAsyncPredicate(page as never, () => null, undefined, { timeout: 30000, label: '测试:谓词抛错' }),
+    ).rejects.toThrow('页面炸了')
+    const after = process.getActiveResourcesInfo().filter((r) => r === 'Timeout').length
+    expect(after, '谓词抛错路径必须已 clearTimeout(反向变异:把 finally 去掉本条必红)').toBeLessThanOrEqual(before)
+  })
+
+  it('⑥ timeout 非正数 → 立刻报错,不沿用 Playwright「0=禁用超时」语义', async () => {
+    for (const bad of [0, -1, Number.NaN]) {
+      await expect(
+        waitForAsyncPredicate(pageReturning(true) as never, () => null, undefined, { timeout: bad, label: 'x' }),
+      ).rejects.toThrow(/timeout 必须为正数/)
+    }
+  })
+
+  it('④b 被放弃的求值稍后 reject 不得变成 unhandledRejection', async () => {
+    let rejectLater: ((e: Error) => void) | undefined
+    const page = {
+      calls: 0,
+      evaluate: () =>
+        new Promise((_resolve, reject) => {
+          rejectLater = reject
+        }),
+    } as unknown as FakePage
+    await expect(
+      waitForAsyncPredicate(page as never, () => null, undefined, { timeout: 60, interval: 10, label: 'z' }),
+    ).rejects.toThrow('单次 page.evaluate 未在期限内返回')
+    // 放弃之后那次求值才 reject —— 实现必须已经挂上吞错回调
+    rejectLater?.(new Error('迟到的失败'))
+    await new Promise((resolve) => setTimeout(resolve, 20))
+  })
+})
diff --git a/scripts/e2e/wait-async-predicate.mjs b/scripts/e2e/wait-async-predicate.mjs
