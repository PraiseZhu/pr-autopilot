{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-autopilot/consensus-artifact/v1",
  "title": "共识 artifact（计划 §1.1b ⑩ 第二段 hash）",
  "type": "object",
  "required": [
    "schema_version", "review_input_hash", "base_sha", "candidate_sha",
    "canonical_findings", "verdict_hashes", "consensus_artifact_hash",
    "created_at", "gate_result", "round"
  ],
  "properties": {
    "schema_version": { "const": "v3" },
    "review_input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "round": {
      "type": "integer", "minimum": 1,
      "description": "issue #9 SC-B: PASS consensus artifact 的序号（不是审查尝试次数）。首个可 PASS 的共识永远是 1、parent_artifact_hash=null；round>=2 必须携带 round-1 的完整可信 parent。入 consensus_artifact_hash（consensus-gate.mjs 的 recomputeArtifactHash）。"
    },
    "canonical_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["canonical_key", "origins", "primary_face", "severity", "anchor", "status"],
        "properties": {
          "canonical_key": { "type": "string" },
          "origins": {
            "type": "array",
            "minItems": 1,
            "$comment": "审②-F2: 保留全部 origins，每个 origin 的 finding 都必须由其本人 close（conjunct② 全量断言）",
            "items": {
              "type": "object",
              "required": ["reviewer", "finding_id"],
              "properties": {
                "reviewer": { "enum": ["claude-adversarial", "codex-adversarial", "upstream-preview"] },
                "finding_id": { "type": "string" }
              }
            }
          },
          "primary_face": { "type": "string" },
          "severity": { "type": "string" },
          "anchor": { "type": "string" },
          "invariant": { "type": "string", "minLength": 1, "maxLength": 120, "description": "SC-B1: 冻结自首个 origin 提供的值（consensus-gate.mjs），suggestion 级 finding 可不带。" },
          "family_key": {
            "type": "string", "pattern": "^fk1-[0-9a-f]{64}$",
            "description": "D1: 跨 reviewer/跨 candidate 的内容派生身份，从冻结后的 invariant 归一化文本 sha256 派生（consensus-gate.mjs 的 familyKeyOf）——下游分组/校验的唯一合法依据，不是 family_id。suggestion 级 finding（无 invariant）可不带。"
          },
          "origin_family_ids": {
            "type": "array",
            "description": "D1: 各 origin 自己的本地归组标签（供人工回溯，不参与任何机器分组判定）。",
            "items": {
              "type": "object",
              "required": ["reviewer", "family_id"],
              "properties": {
                "reviewer": { "enum": ["claude-adversarial", "codex-adversarial", "upstream-preview"] },
                "family_id": { "type": "string", "minLength": 1 }
              }
            }
          },
          "status": { "enum": ["open", "closed"] }
        }
      }
    },
    "verdict_hashes": {
      "type": "object",
      "required": ["claude-adversarial", "codex-adversarial", "upstream-preview"],
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "consensus_artifact_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "created_at": { "type": "string" },
    "gate_result": { "enum": ["pass", "fail"] },
    "fail_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
