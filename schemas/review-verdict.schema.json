{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pr-autopilot/review-verdict/v2",
  "title": "三审 reviewer 机器 verdict（计划 §1.1b ⑨；v2 增 anchor_paths 机器字段）",
  "type": "object",
  "required": [
    "schema_version", "reviewer", "run_status", "round",
    "base_sha", "candidate_sha", "review_input_hash",
    "faces", "findings", "gate_checks", "verdict", "closed_finding_ids"
  ],
  "properties": {
    "schema_version": { "const": "v2" },
    "reviewer": { "enum": ["claude-adversarial", "codex-adversarial", "upstream-preview"] },
    "run_status": { "enum": ["ok", "degraded"] },
    "round": { "type": "integer", "minimum": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "review_input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "faces": {
      "type": "array",
      "minItems": 1,
      "$comment": "角色级覆盖约束（对抗席恰好七面、第三席必填 faces/gates、fail 与 APPROVED 互斥等跨字段规则）由 verdict-validate.mjs 强制——JSON Schema 表达不了，以 validator 为准（审②-F1）",
      "items": {
        "type": "object",
        "required": ["face", "result", "evidence"],
        "properties": {
          "face": { "enum": ["A", "B", "C", "D", "E", "F", "G"] },
          "result": { "enum": ["pass", "fail", "n_a"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "primary_face", "severity", "anchor", "anchor_paths", "evidence", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "primary_face": { "enum": ["A", "B", "C", "D", "E", "F", "G", "taxonomy_gap"] },
          "related_faces": { "type": "array", "items": { "enum": ["A", "B", "C", "D", "E", "F", "G"] } },
          "severity": { "enum": ["blocker", "major", "suggestion"] },
          "anchor": { "type": "string", "minLength": 1, "description": "人读锚点（自由文本，不进机器分组）" },
          "anchor_paths": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "机器字段: 该 finding 涉及的仓库相对精确文件路径（POSIX，非目录）。纯证据锚点——用于分组/hub 判定输入，**绝不是写入许可**（2026-08-02 anchor_paths 三用途拆分: 证据可能落在只读症状文件，真正要改的文件可能根本不在证据里）。formal 校验在 verdict-validate（拒绝绝对/./../反斜杠/尾斜杠/NUL）"
          },
          "scope_note": { "type": "string", "description": "跨面/宽范围说明（自由文本，不进冲突图）" },
          "evidence": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "closed"] }
        }
      },
      "$comment": "D2: write_paths/allowed_paths 禁止出现在 finding 上（additionalProperties:false 结构性拒绝 + verdict-validate.mjs 显式校验双重把关）——写入许可只能由脚本从 SC kind 推导，lead/AI 不得自报。"
    },
    "gate_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate_id", "result", "evidence"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "n_a"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": { "enum": ["APPROVED", "REQUIRES_CHANGES"] },
    "closed_finding_ids": { "type": "array", "items": { "type": "string" } },
    "arbitration_reason": { "type": "string" }
  }
}
